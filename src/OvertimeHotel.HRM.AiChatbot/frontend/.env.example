NEXT_PUBLIC_LANGGRAPH_API_URL=http://localhost:2024
LANGCHAIN_API_KEY=
LANGGRAPH_INGESTION_ASSISTANT_ID=ingestion_graph
LANGGRAPH_RETRIEVAL_ASSISTANT_ID=retrieval_graph

LANGCHAIN_TRACING_V2=true

LANGCHAIN_PROJECT="pdf-chatbot"

# Địa chỉ Web Admin, dùng để hỏi "người cầm vé này được đọc/nạp tài liệu nào".
# Chỉ đọc từ biến môi trường phía máy chủ, KHÔNG đặt tiền tố NEXT_PUBLIC_: giá trị
# này không cần và không được lộ ra trình duyệt.
# Bỏ trống thì chatbot chỉ đọc được tài liệu dùng chung (scope = all) và không nạp
# được tệp — vẫn hỏi đáp bình thường, chỉ là phạm vi hẹp nhất.
WEBADMIN_API_URL=http://localhost:5065