# ==========================================
# CẤU HÌNH AI API - GOOGLE GEMINI (MIỄN PHÍ)
# ==========================================
AI_API_KEY=your_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# ==========================================
# HOẶC CẤU HÌNH OPENAI
# ==========================================
# OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# SUPABASE VECTOR DATABASE (TÙY CHỌN)
# ==========================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# LANGCHAIN TRACING (TÙY CHỌN)
# ==========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=ai-agent-pdf-chatbot

# ==========================================
# CẦU DỮ LIỆU SANG WEB ADMIN (TÙY CHỌN)
# ==========================================
# Địa chỉ Web Admin để xin số liệu báo cáo tổng hợp. Chỉ đọc từ biến môi trường
# này, KHÔNG bao giờ lấy từ tham số do trình duyệt gửi lên — nếu lấy từ đó, kẻ
# tấn công có thể trỏ máy chủ này tới một địa chỉ nội bộ kèm vé dữ liệu thật.
# Bỏ trống thì tính năng hỏi số liệu tự tắt, phần hỏi đáp tài liệu vẫn chạy.
DATA_API_URL=http://localhost:5065