<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:models="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             xmlns:controls="clr-namespace:OvertimeHotel.HRM.MobileApp.Views.Controls"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.ManagerHomePage"
             x:DataType="vm:ManagerHomeViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#1E3A8A">
            <ScrollView>
                <VerticalStackLayout x:Name="pageBody" Spacing="16" Padding="20,16,20,32">

                    <!-- ═══ KHỐI 1 · THANH TIÊU ĐỀ & NÚT LÀM MỚI ═══ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                        <controls:ProfileHeaderBar x:Name="profileHeaderBar"
                                                   Grid.Column="0"
                                                   Opacity="0" />

                        <!-- Nút hành động nhanh: Làm mới dữ liệu điều hành -->
                        <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 22"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#E2E8F0"
                                    WidthRequest="40"
                                    HeightRequest="40">
                                <Border.Shadow>
                                    <Shadow Brush="#64748B" Offset="0,2" Radius="6" Opacity="0.08" />
                                </Border.Shadow>
                                <Label Text="🔄"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Button BackgroundColor="Transparent"
                                    Command="{Binding RefreshCommand}"
                                    WidthRequest="40"
                                    HeightRequest="40" />
                        </Grid>
                    </Grid>

                    <!-- ═══ KHỐI 2 · THẺ PHẠM VI QUẢN LÝ (Executive Navy & Gold Bento Hero Card) ═══ -->
                    <Border x:Name="managerScopeCard"
                            Opacity="0"
                            StrokeShape="RoundRectangle 22"
                            Stroke="#D4AF37"
                            StrokeThickness="1.5"
                            BackgroundColor="#1E3A8A"
                            Padding="20,18">
                        <Border.Shadow>
                            <Shadow Brush="#1E3A8A" Offset="0,8" Radius="18" Opacity="0.28" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="14">
                            <!-- Tiêu đề thẻ và huy hiệu Trưởng bộ phận -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 24"
                                        Stroke="#D4AF37"
                                        StrokeThickness="1.5"
                                        BackgroundColor="#FFFBEB"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        VerticalOptions="Center">
                                    <Label Text="👑"
                                           TextColor="#B45309"
                                           FontSize="24"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="BẢNG ĐIỀU HÀNH BỘ PHẬN"
                                           TextColor="#FDE047"
                                           FontSize="12"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.8" />
                                    <Label Text="{Binding CommandScope}"
                                           TextColor="#FFFFFF"
                                           FontSize="16"
                                           FontFamily="SegoeUIBold"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#D4AF37"
                                        StrokeThickness="1"
                                        BackgroundColor="#312E81"
                                        Padding="8,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding DepartmentCode}"
                                           TextColor="#FDE047"
                                           FontSize="11"
                                           FontFamily="SegoeUIBold" />
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#312E81" />

                            <!-- Dải 3 thông số quyền hạn & quân số -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="VAI TRÒ"
                                           TextColor="#93C5FD"
                                           FontSize="8.5"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.6" />
                                    <Label Text="{Binding CommandRole}"
                                           TextColor="#FFFFFF"
                                           FontSize="12"
                                           FontFamily="SegoeUIBold"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="THẨM QUYỀN"
                                           TextColor="#93C5FD"
                                           FontSize="8.5"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.6" />
                                    <Label Text="{Binding PermissionLabel}"
                                           TextColor="#4ADE80"
                                           FontSize="12"
                                           FontFamily="SegoeUIBold"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="QUÂN SỐ"
                                           TextColor="#93C5FD"
                                           FontSize="8.5"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.6" />
                                    <Label Text="{Binding DepartmentStaffCountText}"
                                           TextColor="#FDE047"
                                           FontSize="12"
                                           FontFamily="SegoeUIBold"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ═══ KHỐI 3 · BẢN ĐỒ GPS GIÁM SÁT HIỆN DIỆN & ĐỒNG HỒ THẬT ═══ -->
                    <controls:LocationClockPanel x:Name="locationClockPanel"
                                                Opacity="0" />

                    <!-- ═══ KHỐI 4 · CA TRỰC ĐIỀU HÀNH CỦA BẠN (TRƯỞNG BỘ PHẬN) ═══ -->
                    <Border x:Name="shiftTimelineCard"
                            Opacity="0"
                            StrokeShape="RoundRectangle 20"
                            Stroke="#1E3A8A"
                            StrokeThickness="1.5"
                            BackgroundColor="#FFFFFF"
                            Padding="18">
                        <Border.Shadow>
                            <Shadow Brush="#1E3A8A" Offset="0,6" Radius="16" Opacity="0.08" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="CA TRỰC ĐIỀU HÀNH CỦA BẠN"
                                       TextColor="#1E3A8A"
                                       FontSize="12"
                                       FontFamily="SegoeUIBold"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="#D4AF37"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFBEB"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding NightBadgeText}"
                                           TextColor="#B45309"
                                           FontSize="10"
                                           FontFamily="SegoeUIBold" />
                                </Border>
                            </Grid>

                            <!-- Dải giờ trực: điểm bắt đầu ─────────── điểm kết thúc -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{Binding ShiftTimeText}"
                                       TextColor="#1E3A8A"
                                       FontSize="18"
                                       FontFamily="SegoeUIBold"
                                       VerticalOptions="Center" />

                                <BoxView Grid.Column="1"
                                         HeightRequest="2"
                                         Color="#D4AF37"
                                         VerticalOptions="Center"
                                         Margin="4,0" />

                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#EFF6FF"
                                        Stroke="#BFDBFE"
                                        Padding="8,3"
                                        VerticalOptions="Center">
                                    <Label Text="ĐANG VẬN HÀNH"
                                           TextColor="#1E3A8A"
                                           FontSize="9"
                                           FontFamily="SegoeUIBold" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding ShiftTaskText}"
                                   TextColor="#475569"
                                   FontSize="12.5"
                                   FontFamily="SegoeUI" />

                            <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,2" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 16"
                                        Stroke="#D4AF37"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFBEB"
                                        Padding="10,3"
                                        VerticalOptions="Center">
                                    <Label Text="★ VẬN HÀNH 24/7"
                                           TextColor="#B45309"
                                           FontSize="9"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.6" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Giám sát ca trực 24/7, đôn đốc kỷ luật và xử lý phát sinh tại bộ phận."
                                       TextColor="#64748B"
                                       FontSize="11"
                                       FontFamily="SegoeUI"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ═══ KHỐI 5 · NHẮC NHỞ DUYỆT ĐƠN KHẨN CẤP (High-Priority Executive Alert) ═══ -->
                    <!-- Trạng thái 1: Có đơn đang chờ duyệt -->
                    <Border x:Name="urgentApprovalCard"
                            IsVisible="{Binding HasPendingLeaves}"
                            StrokeShape="RoundRectangle 18"
                            Stroke="#F59E0B"
                            StrokeThickness="1.5"
                            BackgroundColor="#FFFBEB"
                            Padding="16,14">
                        <Border.Shadow>
                            <Shadow Brush="#D97706" Offset="0,6" Radius="14" Opacity="0.18" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="#FEF3C7"
                                    Stroke="Transparent"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="⚡"
                                       TextColor="#D97706"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="ĐƠN TỪ CẦN DUYỆT GẤP (CẤP 1)"
                                       TextColor="#B45309"
                                       FontSize="10"
                                       FontFamily="SegoeUIBold"
                                       CharacterSpacing="0.8" />
                                <Label Text="{Binding UrgentApproveButtonText}"
                                       TextColor="#78350F"
                                       FontSize="13"
                                       FontFamily="SegoeUIBold" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="DUYỆT NGAY"
                                    Command="{Binding ApproveCommand}"
                                    BackgroundColor="#1E3A8A"
                                    TextColor="#FFFFFF"
                                    FontFamily="SegoeUIBold"
                                    FontSize="11"
                                    CornerRadius="10"
                                    Padding="14,0"
                                    HeightRequest="36"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Trạng thái 2: Không có đơn chờ duyệt (Vận hành ổn định) -->
                    <Border x:Name="allReviewedCard"
                            IsVisible="{Binding HasNoPendingLeaves}"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#10B981"
                            StrokeThickness="1"
                            BackgroundColor="#F0FDF4"
                            Padding="16,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#DCFCE7"
                                    Stroke="Transparent"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    VerticalOptions="Center">
                                <Label Text="✓"
                                       TextColor="#059669"
                                       FontSize="18"
                                       FontFamily="SegoeUIBold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="VẬN HÀNH ỔN ĐỊNH"
                                       TextColor="#047857"
                                       FontSize="10"
                                       FontFamily="SegoeUIBold"
                                       CharacterSpacing="0.8" />
                                <Label Text="Tất cả đơn từ trong bộ phận đã được phê duyệt đầy đủ."
                                       TextColor="#065F46"
                                       FontSize="12"
                                       FontFamily="SegoeUI" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- ═══ KHỐI 4 · THỐNG KÊ QUÂN SỐ VẬN HÀNH BỘ PHẬN HÔM NAY ═══ -->
                    <Grid x:Name="statsGrid"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="10"
                          Opacity="0">
                        <controls:StatTile Grid.Column="0"
                                           Caption="Đang trong ca"
                                           Value="{Binding WorkingStaffCountText}"
                                           SubCaption="{Binding WorkingStatusSubText}"
                                           ValueColor="#059669" />
                        <controls:StatTile Grid.Column="1"
                                           Caption="Đi trễ hôm nay"
                                           Value="{Binding LateStaffCountText}"
                                           SubCaption="{Binding LateStatusSubText}"
                                           ValueColor="#DC2626" />
                        <controls:StatTile Grid.Column="2"
                                           Caption="Nghỉ phép"
                                           Value="{Binding OnLeaveStaffCountText}"
                                           SubCaption="{Binding OnLeaveStatusSubText}"
                                           ValueColor="#D97706" />
                    </Grid>

                    <!-- ═══ KHỐI 5 · BẢNG GIÁM SÁT NHÂN SỰ BỘ PHẬN HÔM NAY ═══ -->
                    <VerticalStackLayout x:Name="staffRosterCard" Spacing="10" Opacity="0">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="GIÁM SÁT NHÂN SỰ BỘ PHẬN HÔM NAY"
                                   TextColor="#1E3A8A"
                                   FontSize="12"
                                   FontFamily="SegoeUIBold"
                                   CharacterSpacing="0.5"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding DepartmentCode, StringFormat='Tổ ca {0}'}"
                                   TextColor="#64748B"
                                   FontSize="11"
                                   FontFamily="SegoeUIBold"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Khung tìm kiếm nhân viên trong bộ phận -->
                        <Border Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="#FFFFFF"
                                Padding="12,4">
                            <Border.Shadow>
                                <Shadow Brush="#64748B" Offset="0,2" Radius="6" Opacity="0.05" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🔍" FontSize="16" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Placeholder="Tìm nhân viên trong ca (tên, mã NV)..."
                                       Text="{Binding SearchKeyword}"
                                       TextColor="#0F172A"
                                       PlaceholderColor="#94A3B8"
                                       FontSize="13"
                                       FontFamily="SegoeUI"
                                       ClearButtonVisibility="WhileEditing"
                                       ReturnCommand="{Binding SearchStaffCommand}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="2"
                                        Text="Tìm"
                                        Command="{Binding SearchStaffCommand}"
                                        BackgroundColor="#1E3A8A"
                                        TextColor="#FFFFFF"
                                        FontFamily="SegoeUIBold"
                                        FontSize="11"
                                        HeightRequest="30"
                                        Padding="12,0"
                                        CornerRadius="8"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Dòng tóm tắt kết quả lọc nhân sự -->
                        <Label Text="{Binding StaffFilterResultText}"
                               TextColor="#64748B"
                               FontSize="11"
                               FontFamily="SegoeUI"
                               Margin="2,0,0,0" />

                        <!-- Danh sách nhân viên trong ca của bộ phận -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredDepartmentStaff}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:HrStaffLookupItem">
                                    <Border Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="#FFFFFF"
                                            Padding="12,10">
                                        <Border.Shadow>
                                            <Shadow Brush="#64748B" Offset="0,2" Radius="6" Opacity="0.05" />
                                        </Border.Shadow>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                            <!-- Avatar chữ cái viết tắt -->
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 20"
                                                    Stroke="#CBD5E1"
                                                    BackgroundColor="#EFF6FF"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding AvatarInitial}"
                                                       TextColor="#1E3A8A"
                                                       FontFamily="SegoeUIBold"
                                                       FontSize="14"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <!-- Họ tên, Chức vụ và Chi tiết ca trực -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding FullName}"
                                                           TextColor="#0F172A"
                                                           FontFamily="SegoeUIBold"
                                                           FontSize="13" />
                                                    <Border StrokeShape="RoundRectangle 6"
                                                            BackgroundColor="#F1F5F9"
                                                            Padding="5,1"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding StaffCode}"
                                                               TextColor="#475569"
                                                               FontFamily="SegoeUIBold"
                                                               FontSize="9.5" />
                                                    </Border>
                                                </HorizontalStackLayout>

                                                <Label Text="{Binding Position}"
                                                       TextColor="#64748B"
                                                       FontFamily="SegoeUI"
                                                       FontSize="11" />

                                                <HorizontalStackLayout Spacing="6" Margin="0,2,0,0" VerticalOptions="Center">
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            BackgroundColor="{Binding StatusBgColor}"
                                                            Padding="6,1">
                                                        <Label Text="{Binding WorkStatus}"
                                                               TextColor="{Binding StatusColor}"
                                                               FontFamily="SegoeUIBold"
                                                               FontSize="9" />
                                                    </Border>
                                                    <Label Text="{Binding WorkStatusDetail}"
                                                           TextColor="#94A3B8"
                                                           FontFamily="SegoeUI"
                                                           FontSize="10"
                                                           LineBreakMode="TailTruncation" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                <!-- ═══ KHỐI 7 · LƯỚI CHỨC NĂNG ĐIỀU HÀNH BỘ PHẬN ═══ -->
                <Label x:Name="featuresHeader"
                       Text="CHỨC NĂNG ĐIỀU HÀNH BỘ PHẬN"
                       TextColor="#1E3A8A"
                       FontSize="12"
                       FontFamily="SegoeUIBold"
                       Opacity="0" />

                <Grid x:Name="featuresGrid"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12"
                      Opacity="0">
                    <controls:FeatureTile Grid.Row="0" Grid.Column="0"
                                          Icon="✅"
                                          Title="Đơn từ" IsVisible="{Binding CanViewLeave}"
                                          Description="Nghỉ phép, đổi ca"
                                          ActionText="Duyệt Ngay"
                                          ActionColor="#16A34A"
                                          TappedCommand="{Binding ApproveCommand}" />
                    <controls:FeatureTile Grid.Row="0" Grid.Column="1"
                                          Icon="📅"
                                          Title="Lịch Ca Bộ Phận" IsVisible="{Binding CanAssignShifts}"
                                          Description="Xếp ca 24/7 nhân sự"
                                          ActionText="Xem Lịch"
                                          TappedCommand="{Binding FeatureCommand}"
                                          CommandParameter="Lịch Ca Bộ Phận" />
                    <controls:FeatureTile Grid.Row="1" Grid.Column="0"
                                          Icon="📊"
                                          Title="Báo Cáo Công" IsVisible="{Binding CanViewDepartmentAttendance}"
                                          Description="Đối soát quẹt thẻ theo ca"
                                          ActionText="Xem Báo Cáo"
                                          TappedCommand="{Binding FeatureCommand}"
                                          CommandParameter="Báo Cáo Công" />
                    <controls:FeatureTile Grid.Row="1" Grid.Column="1"
                                          Icon="👤"
                                          Title="Hồ Sơ Quản Lý"
                                          Description="Hồ sơ, phòng ban &amp; quyền"
                                          ActionText="Xem Hồ Sơ"
                                          TappedCommand="{Binding ProfileCommand}" />
                </Grid>

                <controls:FeatureTile Icon="📋"
                                      Title="Công &amp; nghỉ phép"
                                      Description="Công thực tế và phép hưởng lương theo tháng"
                                      ActionText="Xem bảng công"
                                      IsVisible="{Binding CanViewAttendanceSummary}"
                                      TappedCommand="{Binding AttendanceSummaryCommand}" />


                    <!-- ═══ THÔNG TIN PHIÊN BẢN HỆ THỐNG ═══ -->
                    <Label x:Name="footerLabel"
                           Text="The OverTime Hotel Mobile App v1.0 · Trung Tâm Điều Hành Quản Lý"
                           TextColor="#94A3B8"
                           FontSize="10"
                           FontFamily="SegoeUI"
                           HorizontalOptions="Center"
                           Margin="0,4,0,0"
                           Opacity="0" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>


        <!-- Popup thông báo dùng chung, phủ toàn màn hình -->
        <controls:LuxuryPopup x:Name="popup" ZIndex="999" />
    </Grid>

</ContentPage>
