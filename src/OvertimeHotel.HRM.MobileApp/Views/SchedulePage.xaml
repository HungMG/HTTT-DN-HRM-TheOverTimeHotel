<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:models="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.SchedulePage"
             x:DataType="vm:ScheduleViewModel"
             Title="Lịch Ca 24/7" BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="SegoeUI" />
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="SegoeUIBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BackgroundColor" Value="#EFF6FF" />
            <Setter Property="TextColor" Value="#1E3A8A" />
        </Style>
    </ContentPage.Resources>

    <!-- KHÔNG dùng RowSpacing và KHÔNG đặt Padding trên: banner demo hàng 0 luôn ẩn
         (IsDemoMode = false) nhưng Grid vẫn chừa khoảng cách giữa các hàng, và Padding
         trên cộng dồn với SafeArea mà Shell đã tự dành sẵn — cả hai cùng sinh khoảng
         trống ngay trên header. Đo trên AVD API 35: trang chủ nhân viên bắt đầu ở
         ~82 px, trang này trước khi sửa ở ~120 px. Khoảng cách giữa các khối khai
         bằng Margin trực tiếp trên từng phần tử, đầu trang sát mép trên như trang chủ. -->
    <Grid x:Name="scheduleGrid" RowDefinitions="Auto,Auto,*" Padding="16,0,16,0">

        <Border Grid.Row="0" IsVisible="{Binding IsDemoMode}" StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B" BackgroundColor="#FEF3C7" Padding="12,8" Margin="0,0,0,8">
            <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu" TextColor="#B45309" FontFamily="SegoeUIBold" />
        </Border>

        <Grid x:Name="headerBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              VerticalOptions="Center" Margin="0,0,0,12">
            <Button Text="←" Clicked="OnBackClicked" WidthRequest="44" CornerRadius="22" Padding="0"
                    FontSize="20" SemanticProperties.Description="Quay lại" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                <Label Text="Lịch Ca 24/7" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                <Label Text="Lịch trực của bạn" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="↻" FontSize="22" WidthRequest="44" Padding="0"
                    Command="{Binding RefreshCommand}" SemanticProperties.Description="Tải lại lịch phân ca" />
        </Grid>

        <!-- SKELETON SHIMMER khi đang tải (quy chuẩn §2: cấm ActivityIndicator) -->
        <VerticalStackLayout x:Name="skeletonLayout" Grid.Row="2" Spacing="12" IsVisible="{Binding IsLoading}" VerticalOptions="End">
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="90" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="90" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="2" IsVisible="{Binding HasData}" IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}" RefreshColor="#1E3A8A">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,12,0,0">

                    <!-- Điều hướng tuần: đặt TRONG danh sách để dùng chung một vùng cuộn -->
                    <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 14" Padding="4"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="44,*,44" RowDefinitions="Auto,Auto">
                            <Button Text="‹" FontSize="24" Padding="0" Command="{Binding PreviousWeekCommand}"
                                    BackgroundColor="Transparent" SemanticProperties.Description="Tuần trước" />
                            <Label Grid.Column="1" Text="{Binding PeriodText}" FontFamily="SegoeUIBold" FontSize="16"
                                   TextColor="#1E3A8A" VerticalOptions="Center" HorizontalOptions="Center" />
                            <Button Grid.Column="2" Text="›" FontSize="24" Padding="0" Command="{Binding NextWeekCommand}"
                                    BackgroundColor="Transparent" SemanticProperties.Description="Tuần sau" />
                            <Button Grid.Row="1" Grid.ColumnSpan="3" Text="Về tuần hiện tại" BackgroundColor="Transparent"
                                    Command="{Binding CurrentWeekCommand}" />
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#1E3A8A" Stroke="#1E3A8A" StrokeShape="RoundRectangle 18" Padding="20"
                            Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="LỊCH TRỰC TRONG TUẦN" TextColor="#DBEAFE" FontFamily="SegoeUIBold"
                                   FontSize="11" CharacterSpacing="1" />
                            <Label Text="{Binding PeriodText}" FontFamily="SegoeUIBold" FontSize="24" TextColor="White" />
                            <Label Text="Ca đêm bắt đầu trước 06:00 được tính thêm 30% phụ cấp." TextColor="#DBEAFE" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout x:Name="daysHost" Spacing="0" />

                    <Label IsVisible="{Binding IsEmpty}"
                           Text="{Binding EmptyText}"
                           Padding="20,28"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Lịch do quản lý phân. Muốn đổi ca, liên hệ trực tiếp quản lý ca."
                           FontSize="11" HorizontalTextAlignment="Center" Margin="8,16,8,24" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding HasError}" VerticalOptions="End" Spacing="14" Padding="16">
            <Label Text="Chưa tải được lịch phân ca" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" HorizontalTextAlignment="Center" />
            <Button Text="Thử lại" Command="{Binding RefreshCommand}" BackgroundColor="#1E3A8A" TextColor="White" />
            <Button Text="Đăng nhập lại" IsVisible="{Binding RequiresLogin}" Command="{Binding LoginCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>