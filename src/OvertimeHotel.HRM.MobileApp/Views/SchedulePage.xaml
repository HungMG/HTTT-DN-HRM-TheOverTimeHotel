<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:models="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.SchedulePage"
             x:DataType="vm:ScheduleViewModel"
             Title="Lịch Ca 24/7" BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="SegoeUI" />
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="SegoeUIBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BackgroundColor" Value="#EFF6FF" />
            <Setter Property="TextColor" Value="#1E3A8A" />
        </Style>
    </ContentPage.Resources>

    <!-- KHÔNG dùng RowSpacing và KHÔNG đặt Padding trên: banner demo hàng 0 luôn ẩn
         (IsDemoMode = false) nhưng Grid vẫn chừa khoảng cách giữa các hàng, và Padding
         trên cộng dồn với SafeArea mà Shell đã tự dành sẵn — cả hai cùng sinh khoảng
         trống ngay trên header. Đo trên AVD API 35: trang chủ nhân viên bắt đầu ở
         ~82 px, trang này trước khi sửa ở ~120 px. Khoảng cách giữa các khối khai
         bằng Margin trực tiếp trên từng phần tử, đầu trang sát mép trên như trang chủ. -->
    <Grid x:Name="scheduleGrid" RowDefinitions="Auto,Auto,*" Padding="16,0,16,0">

        <Border Grid.Row="0" IsVisible="{Binding IsDemoMode}" StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B" BackgroundColor="#FEF3C7" Padding="12,8" Margin="0,0,0,8">
            <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu" TextColor="#B45309" FontFamily="SegoeUIBold" />
        </Border>

        <Grid x:Name="headerBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              VerticalOptions="Center" Margin="0,0,0,12">
            <Button Text="←" Clicked="OnBackClicked" WidthRequest="44" CornerRadius="22" Padding="0"
                    FontSize="20" SemanticProperties.Description="Quay lại" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                <Label Text="Lịch Ca 24/7" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                <Label Text="Lịch trực của bạn" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="↻" FontSize="22" WidthRequest="44" Padding="0"
                    Command="{Binding RefreshCommand}" SemanticProperties.Description="Tải lại lịch phân ca" />
        </Grid>

        <!-- SKELETON SHIMMER khi đang tải (quy chuẩn §2: cấm ActivityIndicator) -->
        <VerticalStackLayout x:Name="skeletonLayout" Grid.Row="2" Spacing="12" IsVisible="{Binding IsLoading}" VerticalOptions="End">
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="90" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="90" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="2" IsVisible="{Binding HasData}" IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}" RefreshColor="#1E3A8A">
            <ScrollView>
                <VerticalStackLayout Spacing="0" Padding="0,12,0,0">

                    <Border Stroke="#E2E8F0" BackgroundColor="White" StrokeShape="RoundRectangle 22" Padding="14" Margin="0,0,0,18">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="44,*,44">
                                <Button Text="‹" FontSize="24" Padding="0" BackgroundColor="Transparent" Command="{Binding PreviousMonthCommand}" SemanticProperties.Description="Tháng trước" />
                                <Label Grid.Column="1" Text="{Binding MonthText}" FontFamily="SegoeUIBold" FontSize="20" TextColor="#1E3A8A" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Button Grid.Column="2" Text="›" FontSize="24" Padding="0" BackgroundColor="Transparent" Command="{Binding NextMonthCommand}" SemanticProperties.Description="Tháng sau" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                <Label Text="T2" HorizontalOptions="Center" /><Label Grid.Column="1" Text="T3" HorizontalOptions="Center" />
                                <Label Grid.Column="2" Text="T4" HorizontalOptions="Center" /><Label Grid.Column="3" Text="T5" HorizontalOptions="Center" />
                                <Label Grid.Column="4" Text="T6" HorizontalOptions="Center" /><Label Grid.Column="5" Text="T7" HorizontalOptions="Center" />
                                <Label Grid.Column="6" Text="CN" HorizontalOptions="Center" />
                            </Grid>
                            <Grid x:Name="calendarGrid" ColumnDefinitions="*,*,*,*,*,*,*" RowSpacing="2" />
                            <HorizontalStackLayout Spacing="16">
                                <Label Text="●  Có ca làm" TextColor="#1E3A8A" FontSize="11" />
                                <Label Text="Số đỏ: Có sự kiện" TextColor="#DC2626" FontSize="11" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                        <Label Text="{Binding SelectionText}" FontFamily="SegoeUIBold" FontSize="17" TextColor="#0F172A" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Xem tuần" Command="{Binding ShowWeekCommand}" SemanticProperties.Description="Xem ca cả tuần của ngày đã chọn" />
                    </Grid>
                    <Grid ColumnDefinitions="44,*,44" IsVisible="{Binding ShowWeek}" Margin="0,0,0,12">
                        <Button Text="‹" FontSize="24" Padding="0" Command="{Binding PreviousWeekCommand}" SemanticProperties.Description="Tuần trước" />
                        <Label Grid.Column="1" Text="{Binding PeriodText}" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="SegoeUIBold" />
                        <Button Grid.Column="2" Text="›" FontSize="24" Padding="0" Command="{Binding NextWeekCommand}" SemanticProperties.Description="Tuần sau" />
                    </Grid>

                    <Label IsVisible="{Binding EventLoadFailed}" Text="Không tải được lịch sự kiện. Kéo xuống để thử lại." TextColor="#B45309" Margin="0,0,0,12" />
                    <VerticalStackLayout x:Name="daysHost" Spacing="0" />

                    <Label IsVisible="{Binding IsEmpty}"
                           Text="{Binding EmptyText}"
                           Padding="20,28"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Lịch do quản lý phân. Muốn đổi ca, liên hệ trực tiếp quản lý ca."
                           FontSize="11" HorizontalTextAlignment="Center" Margin="8,16,8,24" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding HasError}" VerticalOptions="End" Spacing="14" Padding="16">
            <Label Text="Chưa tải được lịch phân ca" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A"
                   HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" HorizontalTextAlignment="Center" />
            <Button Text="Thử lại" Command="{Binding RefreshCommand}" BackgroundColor="#1E3A8A" TextColor="White" />
            <Button Text="Đăng nhập lại" IsVisible="{Binding RequiresLogin}" Command="{Binding LoginCommand}" />
        </VerticalStackLayout>
        <Grid x:Name="detailOverlay" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#990F172A" Padding="12,24" ZIndex="100">
            <Border Stroke="#D4AF37" StrokeThickness="1" StrokeShape="RoundRectangle 22" BackgroundColor="White" Padding="20" VerticalOptions="Center">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                    <Label x:Name="detailTitle" FontFamily="SegoeUIBold" FontSize="19" TextColor="#0F172A" />
                    <ScrollView Grid.Row="1" MaximumHeightRequest="320"><VerticalStackLayout x:Name="detailContent" Spacing="10" /></ScrollView>
                    <Button Grid.Row="2" Text="Đóng" Clicked="OnCloseDetailClicked" BackgroundColor="#1E3A8A" TextColor="White" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>