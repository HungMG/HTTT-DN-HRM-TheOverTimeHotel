<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:controls="clr-namespace:OvertimeHotel.HRM.MobileApp.Views.Controls"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.EmployeeHomePage"
             x:DataType="vm:EmployeeHomeViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>

        <ScrollView>
            <VerticalStackLayout x:Name="pageBody" Spacing="16" Padding="20,0,20,32">

                <!-- ═══ KHỐI 1 · THANH TIÊU ĐỀ ═══ -->
                <controls:ProfileHeaderBar x:Name="profileHeaderBar"
                                           Opacity="0" />

                <!-- ═══ KHỐI 2 · ĐỒNG HỒ THẬT & BẢN ĐỒ GPS ═══ -->
                <controls:LocationClockPanel x:Name="locationClockPanel"
                                            Opacity="0" />

                <!-- ═══ KHỐI 3 · HỐI LỊCH TRỰC HÔM NAY (chỉ ca của chính mình) ═══ -->
                <Border x:Name="shiftTimelineCard"
                        Opacity="0"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#1E3A8A"
                        StrokeThickness="2"
                        BackgroundColor="#FFFFFF"
                        Padding="18">
                    <Border.Shadow>
                        <Shadow Brush="#1E3A8A" Offset="0,6" Radius="16" Opacity="0.10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="LỊCH LÀM HÔM NAY"
                                   TextColor="#1E3A8A"
                                   FontSize="12"
                                   FontFamily="SegoeUIBold"
                                   CharacterSpacing="1"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    x:Name="nightBadgeBorder"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="#D4AF37"
                                    StrokeThickness="1"
                                    BackgroundColor="#FFFBEB"
                                    Padding="8,3"
                                    VerticalOptions="Center">
                                <Label x:Name="lblNightBadge"
                                       Text="Ca Làm Việc"
                                       TextColor="#B45309"
                                       FontSize="10"
                                       FontFamily="SegoeUIBold" />
                            </Border>
                        </Grid>

                        <!-- Dải giờ trực: điểm bắt đầu ─────────── điểm kết thúc -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   x:Name="lblTimelineStart"
                                   Text="--:--"
                                   TextColor="#1E3A8A"
                                   FontSize="22"
                                   FontFamily="SegoeUIBold"
                                   VerticalOptions="Center" />

                            <BoxView Grid.Column="1"
                                     HeightRequest="3"
                                     Color="#D4AF37"
                                     VerticalOptions="Center"
                                     Margin="4,0" />

                            <Label Grid.Column="2"
                                   x:Name="lblTimelineEnd"
                                   Text="--:--"
                                   TextColor="#1E3A8A"
                                   FontSize="22"
                                   FontFamily="SegoeUIBold"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Label x:Name="lblTimelineShiftName"
                               Text="Đang tải ca làm việc..."
                               TextColor="#475569"
                               FontSize="13"
                               FontFamily="SegoeUI" />

                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,2" />

                        <!-- Nhắc nhở: chỉ hiện ca của chính mình, không lộ lịch người khác -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="#BFDBFE"
                                    StrokeThickness="1"
                                    BackgroundColor="#EFF6FF"
                                    Padding="10,3"
                                    VerticalOptions="Center">
                                <Label Text="★ CA CỦA TÔI"
                                       TextColor="#1E3A8A"
                                       FontSize="9"
                                       FontFamily="SegoeUIBold"
                                       CharacterSpacing="0.8" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="Lịch trực của các đồng nghiệp cùng ca do quản lý phân, liên hệ quản lý để xem chi tiết."
                                   TextColor="#64748B"
                                   FontSize="11"
                                   FontFamily="SegoeUI"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ KHỐI 4 · CHỈ SỐ THÁNG NÀY ═══ -->
                <Grid x:Name="statsGrid"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="10"
                      Opacity="0">
                    <controls:StatTile Grid.Column="0"
                                       Caption="Ngày công"
                                       Value="22"
                                       SubCaption="công thực tế" />
                    <controls:StatTile Grid.Column="1"
                                       Caption="Ca trực đêm"
                                       Value="8"
                                       SubCaption="+30% phụ cấp"
                                       ValueColor="#D4AF37" />
                    <controls:StatTile Grid.Column="2"
                                       Caption="Đơn của bạn"
                                       Value="0"
                                       SubCaption="chờ duyệt"
                                       ValueColor="#059669" />
                </Grid>

                <!-- ═══ KHỐI 5 · LƯỚI CHỨC NĂNG ═══ -->
                <!--
                    Khối chức năng đã được gỡ khỏi trang chủ nhánh NHÂN VIÊN
                    (2026-10-10). Các thao tác chuyển xuống tầng điều hướng:
                      · Lịch Ca 24/7   -> nút trên header tab Chấm Công
                      · Phiếu Lương    -> nút trong trang "Công & nghỉ phép"
                      · Đơn Điện Tử   -> nút trong trang "Công & nghỉ phép"
                      · Hồ Sơ          -> tab Cài Đặt > Thông tin cá nhân
                    Các ViewModel HomeViewModelBase.ProfileCommand /
                    FeatureCommand / AttendanceSummaryCommand vẫn giữ nguyên vì
                    nhánh Quản lý và Nhân sự còn dùng tới.
                -->

                <Label x:Name="footerLabel"
                       Text="The OverTime Hotel Mobile App v1.0 (.NET MAUI 10) · Supabase Cloud"
                       TextColor="#94A3B8"
                       FontSize="10"
                       FontFamily="SegoeUI"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0"
                       Opacity="0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Popup thông báo dùng chung, phủ toàn màn hình -->
        <controls:LuxuryPopup x:Name="popup" ZIndex="999" />

    </Grid>

</ContentPage>
