<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.HrStatisticsPage"
             x:DataType="vm:HrStatisticsViewModel" BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="16" BackgroundColor="White">
            <Button Text="‹ Quay lại" Command="{Binding BackCommand}" BackgroundColor="Transparent" TextColor="#1E3A8A" />
            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                <Label Text="THỐNG KÊ NHÂN SỰ" FontAttributes="Bold" TextColor="#0F172A" />
                <Label Text="{Binding SelectedPeriod}" TextColor="#64748B" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="{Binding LastUpdatedText}" FontSize="10" TextColor="#64748B" />
        </Grid>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <ScrollView><VerticalStackLayout Spacing="14" Padding="20">
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="#B91C1C" />
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="16"><VerticalStackLayout Spacing="6">
                    <Label Text="NHÂN SỰ CUỐI KỲ" FontAttributes="Bold" TextColor="#1E3A8A" />
                    <Label Text="{Binding Summary}" FontSize="18" TextColor="#0F172A" />
                </VerticalStackLayout></Border>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="16"><VerticalStackLayout Spacing="6">
                    <Label Text="CƠ CẤU PHÒNG BAN" FontAttributes="Bold" TextColor="#1E3A8A" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Departments}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:StatisticGroup"><Label Text="{Binding Display}" TextColor="#0F172A" /></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
                </VerticalStackLayout></Border>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="16"><VerticalStackLayout Spacing="6">
                    <Label Text="TRÌNH ĐỘ" FontAttributes="Bold" TextColor="#1E3A8A" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Education}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:StatisticGroup"><Label Text="{Binding Display}" TextColor="#0F172A" /></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
                    <Label Text="THÂM NIÊN" FontAttributes="Bold" TextColor="#1E3A8A" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tenure}"><BindableLayout.ItemTemplate><DataTemplate x:DataType="vm:StatisticGroup"><Label Text="{Binding Display}" TextColor="#0F172A" /></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout>
                </VerticalStackLayout></Border>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="16"><VerticalStackLayout Spacing="6">
                    <Label Text="CHUYÊN CẦN" FontAttributes="Bold" TextColor="#1E3A8A" /><Label Text="{Binding Attendance}" TextColor="#0F172A" />
                </VerticalStackLayout></Border>
                <Border Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" BackgroundColor="White" Padding="16"><VerticalStackLayout Spacing="6">
                    <Label Text="QUỸ LƯƠNG" FontAttributes="Bold" TextColor="#1E3A8A" /><Label Text="{Binding Payroll}" TextColor="#0F172A" />
                </VerticalStackLayout></Border>
            </VerticalStackLayout></ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
