<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:m="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             xmlns:converters="clr-namespace:OvertimeHotel.HRM.MobileApp.Converters"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.LeaveApprovalPage"
             x:DataType="vm:LeaveApprovalViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToGeometryConverter x:Key="StringToGeometryConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Padding="16,12,16,16">

        <!-- 0. DEMO MODE BANNER -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsDemoMode}"
                StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B"
                BackgroundColor="#FEF3C7"
                Padding="12,6"
                Margin="0,0,0,8">
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                <Label Text="CHẾ ĐỘ DEMO — Sử dụng dữ liệu mẫu độc lập trong bộ nhớ"
                       TextColor="#B45309"
                       FontFamily="SegoeUIBold"
                       FontSize="12"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- 1. HEADER BAR CHUYÊN NGHIỆP CÓ BADGE SỐ ĐƠN CHỜ DUYỆT -->
        <Grid x:Name="headerBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center" Margin="0,4,0,12">
            <Button Grid.Column="0"
                    Text="←"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="Quay lại trang chủ"
                    FontFamily="SegoeUIBold"
                    FontSize="18"
                    BackgroundColor="#EFF6FF"
                    TextColor="#1E3A8A"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0" />

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0,0,0">
                <Label Text="{Binding RoleDisplayName}"
                       TextColor="#0F172A"
                       FontFamily="SegoeUIBold"
                       FontSize="16"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding DeptDisplayName}"
                       TextColor="#64748B"
                       FontFamily="SegoeUI"
                       FontSize="11" />
            </VerticalStackLayout>

            <!-- Badge đếm số đơn chờ duyệt -->
            <Border Grid.Column="2"
                    StrokeShape="RoundRectangle 16"
                    Stroke="#F59E0B"
                    BackgroundColor="#FEF3C7"
                    Padding="10,4"
                    VerticalOptions="Center">
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="⏳" FontSize="12" VerticalOptions="Center" />
                    <Label Text="{Binding PendingCount, StringFormat='{0} Chờ'}"
                           TextColor="#B45309"
                           FontFamily="SegoeUIBold"
                           FontSize="12"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 2. SEGMENTED TAB CONTROL: CHỜ DUYỆT / ĐÃ XỬ LÝ -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 12"
                Stroke="#E2E8F0"
                BackgroundColor="#E2E8F0"
                Padding="3"
                Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,*">
                <!-- Tab Chờ duyệt -->
                <Button Grid.Column="0"
                        Text="Chờ Duyệt"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="CHO_DUYET"
                        FontFamily="SegoeUIBold"
                        FontSize="13"
                        HeightRequest="44"
                        CornerRadius="9">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsPendingTabSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1E3A8A" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsPendingTabSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="#475569" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Tab Đã xử lý -->
                <Button Grid.Column="1"
                        Text="Đã Xử Lý"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="DA_XU_LY"
                        FontFamily="SegoeUIBold"
                        FontSize="13"
                        HeightRequest="44"
                        CornerRadius="9">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsReviewedTabSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="#1E3A8A" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IsReviewedTabSelected}" Value="False">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="#475569" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- 3. TIÊU ĐỀ BỘ LỌC PHÒNG BAN: TÁCH HÀNG ĐỘC LẬP CHO HR & ADMIN (KHÔNG LÀM CO GIÃN ĐỘ DÀI TRIGGER BÊN DƯỚI) -->
        <Label Grid.Row="3"
               Text="Phòng ban"
               FontFamily="SegoeUIBold"
               FontSize="13"
               TextColor="#334155"
               IsVisible="{Binding CanFilterDepartments}"
               Margin="0,0,0,6" />

        <!-- 4. TRIGGER BOX CHỌN PHÒNG BAN: CHIỀU CAO CỐ ĐỊNH 48DP ĐỘC LẬP MỌI ĐIỆN THOẠI -->
        <Border Grid.Row="4"
                x:Name="triggerBorder"
                Stroke="#CBD5E1" StrokeShape="RoundRectangle 12"
                BackgroundColor="#FFFFFF" Padding="14,0"
                HeightRequest="48"
                Margin="0,0,0,12"
                IsVisible="{Binding CanFilterDepartments}"
                IsEnabled="{Binding IsDepartmentPickerEnabled}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleDepartmentDropdownCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Icon phòng ban đang chọn: Navy sang trọng -->
                <Border Grid.Column="0"
                        WidthRequest="32" HeightRequest="32"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#EFF6FF"
                        Stroke="#DBEAFE"
                        StrokeThickness="1"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Path Data="{Binding SelectedDepartment.PathData, Converter={StaticResource StringToGeometryConverter}}"
                          Stroke="#1E3A8A"
                          StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          Aspect="Uniform"
                          WidthRequest="16" HeightRequest="16"
                          HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Tên phòng ban đang chọn -->
                <Label Grid.Column="1"
                       Text="{Binding SelectedDepartment.TenPhongBan}"
                       FontFamily="SegoeUIBold" FontSize="14" TextColor="#1E3A8A"
                       LineBreakMode="TailTruncation" VerticalOptions="Center" />

                <!-- Mũi tên Chevron xoay chuyển trạng thái bằng Animation -->
                <Border x:Name="chevronBorder"
                        Grid.Column="2"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#F1F5F9"
                        WidthRequest="26" HeightRequest="26"
                        Padding="0" VerticalOptions="Center">
                    <Label Text="▼"
                           FontSize="9" TextColor="#64748B" FontFamily="SegoeUIBold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- BACKDROP BẮT CHẠM NGOÀI: TỰ ĐỘNG THU GỌN DROPDOWN KHI CHẠM RA NGOÀI -->
        <BoxView x:Name="dropdownBackdrop"
                 Grid.Row="0" Grid.RowSpan="8"
                 Color="Transparent"
                 IsVisible="False"
                 ZIndex="150">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseDepartmentDropdownCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- FLOATING OVERLAY DROPDOWN CARD: NEO TRỰC TIẾP THEO ROW 4 (48dp + 6dp gap = Margin 54dp), 100% THỐNG NHẤT MỌI MÁY -->
        <Border x:Name="dropdownCard"
                Grid.Row="4" Grid.RowSpan="4"
                VerticalOptions="Start"
                Margin="0,54,0,0"
                ZIndex="200"
                Opacity="0"
                TranslationY="-6"
                InputTransparent="True"
                Stroke="#CBD5E1" StrokeShape="RoundRectangle 14"
                BackgroundColor="#FFFFFF"
                Padding="6,6">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Offset="0,8" Radius="20" Opacity="0.18" />
            </Border.Shadow>
            <!-- Thanh cuộn giới hạn chiều cao tối đa 240dp để dễ cuộn xem các phòng ban -->
            <ScrollView MaximumHeightRequest="240"
                        VerticalScrollBarVisibility="Always">
                <VerticalStackLayout Spacing="3"
                                     BindableLayout.ItemsSource="{Binding DepartmentOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:DepartmentOption">
                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    BackgroundColor="Transparent"
                                    Padding="10,8"
                                    Margin="0,1">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:LeaveApprovalViewModel}}, Path=SelectedDepartment}"
                                                 Value="{Binding .}">
                                        <Setter Property="BackgroundColor" Value="#EFF6FF" />
                                        <Setter Property="Stroke" Value="#BFDBFE" />
                                        <Setter Property="StrokeThickness" Value="1" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LeaveApprovalViewModel}}, Path=SelectDepartmentCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <Border Grid.Column="0"
                                            WidthRequest="32" HeightRequest="32"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#EFF6FF"
                                            Stroke="#DBEAFE"
                                            StrokeThickness="1"
                                            VerticalOptions="Center" HorizontalOptions="Center">
                                        <Path Data="{Binding PathData, Converter={StaticResource StringToGeometryConverter}}"
                                              Stroke="#1E3A8A"
                                              StrokeThickness="1.8"
                                              StrokeLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Aspect="Uniform"
                                              WidthRequest="16" HeightRequest="16"
                                              HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding TenPhongBan}"
                                           FontFamily="SegoeUI" FontSize="13" TextColor="#0F172A"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:LeaveApprovalViewModel}}, Path=SelectedDepartment}"
                                                         Value="{Binding .}">
                                                <Setter Property="FontFamily" Value="SegoeUIBold" />
                                                <Setter Property="TextColor" Value="#1E3A8A" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="2" Text="✓"
                                           FontSize="13" TextColor="#1E3A8A" FontFamily="SegoeUIBold"
                                           VerticalOptions="Center" IsVisible="False">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:LeaveApprovalViewModel}}, Path=SelectedDepartment}"
                                                         Value="{Binding .}">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Request type chips combine with the selected department and status. -->
        <ScrollView Grid.Row="5" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,6">
            <HorizontalStackLayout Spacing="8">
                <!-- Chip: Tất cả -->
                <!-- Chip: Tất cả -->
                <Button Text="Tất Cả"
                        Command="{Binding FilterTypeCommand}"
                        CommandParameter="ALL"
                        HeightRequest="44"
                        Padding="14,0"
                        CornerRadius="18"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        BackgroundColor="#FFFFFF"
                        TextColor="#475569"
                        BorderColor="#CBD5E1"
                        BorderWidth="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="ALL">
                            <Setter Property="BackgroundColor" Value="#1E3A8A" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Chip: Phép năm (1) -->
                <Button Text="Phép Năm"
                        Command="{Binding FilterTypeCommand}"
                        CommandParameter="1"
                        HeightRequest="44"
                        Padding="14,0"
                        CornerRadius="18"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        BackgroundColor="#FFFFFF"
                        TextColor="#475569"
                        BorderColor="#CBD5E1"
                        BorderWidth="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="1">
                            <Setter Property="BackgroundColor" Value="#047857" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Chip: Nghỉ ốm (2) -->
                <Button Text="Nghỉ Ốm"
                        Command="{Binding FilterTypeCommand}"
                        CommandParameter="2"
                        HeightRequest="44"
                        Padding="14,0"
                        CornerRadius="18"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        BackgroundColor="#FFFFFF"
                        TextColor="#475569"
                        BorderColor="#CBD5E1"
                        BorderWidth="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="2">
                            <Setter Property="BackgroundColor" Value="#C2410C" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Chip: Thai sản (3) -->
                <Button Text="Thai Sản"
                        Command="{Binding FilterTypeCommand}"
                        CommandParameter="3"
                        HeightRequest="44"
                        Padding="14,0"
                        CornerRadius="18"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        BackgroundColor="#FFFFFF"
                        TextColor="#475569"
                        BorderColor="#CBD5E1"
                        BorderWidth="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="3">
                            <Setter Property="BackgroundColor" Value="#4338CA" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Chip: Việc riêng (4) -->
                <Button Text="Việc Riêng"
                        Command="{Binding FilterTypeCommand}"
                        CommandParameter="4"
                        HeightRequest="44"
                        Padding="14,0"
                        CornerRadius="18"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        BackgroundColor="#FFFFFF"
                        TextColor="#475569"
                        BorderColor="#CBD5E1"
                        BorderWidth="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="4">
                            <Setter Property="BackgroundColor" Value="#475569" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Chip: Thôi việc (5) -->
                <Button Text="Thôi Việc"
                        Command="{Binding FilterTypeCommand}"
                        CommandParameter="5"
                        HeightRequest="44"
                        Padding="14,0"
                        CornerRadius="18"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        BackgroundColor="#FFFFFF"
                        TextColor="#475569"
                        BorderColor="#CBD5E1"
                        BorderWidth="1">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="5">
                            <Setter Property="BackgroundColor" Value="#BE123C" />
                            <Setter Property="TextColor" Value="#FFFFFF" />
                            <Setter Property="BorderWidth" Value="0" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="6" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <Label Text="{Binding ResultsSummary}" TextColor="#475569"
                   FontFamily="SegoeUI" FontSize="12" VerticalOptions="Center"
                   MaxLines="2" LineBreakMode="WordWrap" />
            <Button Grid.Column="1" Text="Bỏ lọc" Command="{Binding ResetFiltersCommand}"
                    IsVisible="{Binding HasFilters}"
                    FontFamily="SegoeUIBold" FontSize="12" TextColor="#1E3A8A"
                    BackgroundColor="#EFF6FF" CornerRadius="10"
                    MinimumHeightRequest="48" MinimumWidthRequest="88" Padding="12,0"
                    SemanticProperties.Description="Bỏ lọc phòng ban và loại đơn" />
        </Grid>

        <!-- Virtualized list, pull to refresh and incremental pages. -->
        <RefreshView Grid.Row="7"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#1E3A8A">
            <Grid>
                <!-- DANH SÁCH CARD ĐƠN TỪ -->
                <CollectionView ItemsSource="{Binding FilteredRequests}"
                                IsVisible="{Binding IsListVisible}"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                                SelectionMode="None"
                                Margin="0,0,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:LeaveRequestItem">
                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="#E2E8F0"
                                    BackgroundColor="#FFFFFF"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Border.Shadow>
                                    <Shadow Brush="#64748B" Offset="0,4" Radius="10" Opacity="0.06" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LeaveApprovalViewModel}}, Path=ViewDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="10">
                                    <!-- HÀNG 1: AVATAR + THÔNG TIN NV + TRẠNG THÁI -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <!-- Avatar Initials -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 22"
                                                Stroke="{Binding TypeColor}"
                                                StrokeThickness="1.5"
                                                BackgroundColor="{Binding TypeBgColor}"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Initials}"
                                                   TextColor="{Binding TypeColor}"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Tên & Chức vụ -->
                                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                            <Label Text="{Binding TenNhanVien}"
                                                   TextColor="#0F172A"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="15" />
                                            <Label Text="{Binding TenPhongBan, StringFormat='{0}'}"
                                                   TextColor="#64748B"
                                                   FontFamily="SegoeUI"
                                                   FontSize="11" />
                                            <Label Text="{Binding TenChucVu, StringFormat='Chức vụ: {0}'}"
                                                   TextColor="#94A3B8"
                                                   FontFamily="SegoeUI"
                                                   FontSize="10" />
                                        </VerticalStackLayout>

                                        <!-- Badge Trạng thái -->
                                        <Border Grid.Column="2"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{Binding StatusBgColor}"
                                                Padding="8,3"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding StatusText}"
                                                   TextColor="{Binding StatusColor}"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="11" />
                                        </Border>
                                    </Grid>

                                    <!-- HÀNG 2: BADGE LOẠI ĐƠN & CHẾ ĐỘ HƯỞNG LƯƠNG -->
                                    <HorizontalStackLayout Spacing="6">
                                        <Border StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{Binding TypeBgColor}"
                                                Padding="8,3">
                                            <Label Text="{Binding TenLoaiDon}"
                                                   TextColor="{Binding TypeColor}"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="11" />
                                        </Border>

                                        <Border StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{Binding SalaryBadgeBg}"
                                                Padding="8,3">
                                            <Label Text="{Binding SalaryBadgeText}"
                                                   TextColor="{Binding SalaryBadgeTextColor}"
                                                   FontFamily="SegoeUI"
                                                   FontSize="10" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- HÀNG 3: KHOẢNG THỜI GIAN & TỔNG SỐ NGÀY -->
                                    <Grid ColumnDefinitions="*,Auto" BackgroundColor="#F8FAFC" Padding="10,6" Margin="0,2">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <Label Text="📅" FontSize="12" VerticalOptions="Center" />
                                            <Label Text="{Binding PeriodDisplay}"
                                                   TextColor="#334155"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="12"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="#CBD5E1"
                                                BackgroundColor="#FFFFFF"
                                                Padding="8,2"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding SoNgayNghiDisplay}"
                                                   TextColor="#1E3A8A"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="11" />
                                        </Border>
                                    </Grid>

                                    <!-- HÀNG 4: LÝ DO TÓM TẮT -->
                                    <Label Text="{Binding LyDo, StringFormat='💬 &quot;{0}&quot;'}"
                                           TextColor="#475569"
                                           FontFamily="SegoeUI"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />

                                    <!-- HÀNG 5: NGÀY GỬI & LINK CHI TIẾT -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding NgayGuiDisplay, StringFormat='Gửi lúc: {0}'}"
                                               TextColor="#94A3B8"
                                               FontFamily="SegoeUI"
                                               FontSize="11"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="1"
                                               Text="Chi tiết ➔"
                                               TextColor="#1E3A8A"
                                               FontFamily="SegoeUIBold"
                                               FontSize="12"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <VerticalStackLayout IsVisible="{Binding HasMore}" Spacing="8" Padding="0,4,0,16">
                            <Label Text="{Binding LoadMoreError}" IsVisible="{Binding HasLoadMoreError}"
                                   TextColor="#B91C1C" FontFamily="SegoeUI" FontSize="13"
                                   HorizontalTextAlignment="Center" />
                            <!--
                                Nút tải thêm đã tự khoá theo CanLoadMore nên "đang tải
                                thêm" phải hiện ra bằng một nhãn chuyển động nhịp thở
                                chứ không dùng vòng tròn xoay (quy chuẩn §2): spinner ở
                                giữa chân danh sách khiến người dùng nghĩ trang bị treo.
                            -->
                            <Label x:Name="loadMoreLabel"
                                   Text="Đang tải thêm đơn…"
                                   IsVisible="{Binding IsLoadingMore}"
                                   TextColor="#1E3A8A"
                                   FontFamily="SegoeUIBold"
                                   FontSize="13"
                                   CharacterSpacing="1.2"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,4,0,0" />
                            <Button Text="Tải thêm đơn" Command="{Binding LoadMoreCommand}"
                                    IsEnabled="{Binding CanLoadMore}"
                                    FontFamily="SegoeUIBold" FontSize="13" TextColor="#1E3A8A"
                                    BackgroundColor="#EFF6FF" CornerRadius="12"
                                    MinimumHeightRequest="48"
                                    SemanticProperties.Description="Tải thêm đơn phù hợp với bộ lọc hiện tại" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>

                <!-- EMPTY STATE (KHI KHÔNG CÓ ĐƠN NÀO) -->
                <VerticalStackLayout IsVisible="{Binding HasNoData}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="32">
                    <Label Text="📋" FontSize="56" HorizontalOptions="Center" />
                    <Label Text="Hiện Không Có Đơn Nào"
                           TextColor="#0F172A"
                           FontFamily="SegoeUIBold"
                           FontSize="18"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyMessage}"
                           TextColor="#64748B"
                           FontFamily="SegoeUI"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                    <Button Text="Bỏ lọc" Command="{Binding ResetFiltersCommand}"
                            IsVisible="{Binding HasFilters}" BackgroundColor="#EFF6FF"
                            TextColor="#1E3A8A" FontFamily="SegoeUIBold" FontSize="13"
                            CornerRadius="10" MinimumHeightRequest="48" Padding="20,0" />
                    <Button Text="🔄 Làm Mới"
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="#1E3A8A"
                            TextColor="#FFFFFF"
                            FontFamily="SegoeUIBold"
                            FontSize="13"
                            CornerRadius="10"
                            HeightRequest="44"
                            WidthRequest="140"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>

                <!-- ERROR STATE (KHI CÓ LỖI KẾT NỐI HOẶC THẨM QUYỀN) -->
                <VerticalStackLayout IsVisible="{Binding HasError}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="32">
                    <Label Text="⚠️" FontSize="56" HorizontalOptions="Center" />
                    <Label Text="Không Thể Tải Dữ Liệu"
                           TextColor="#DC2626"
                           FontFamily="SegoeUIBold"
                           FontSize="18"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#64748B"
                           FontFamily="SegoeUI"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           HorizontalOptions="Center" />
                    <Button Text="🔄 Thử Lại"
                            Command="{Binding RetryCommand}"
                            BackgroundColor="#1E3A8A"
                            TextColor="#FFFFFF"
                            FontFamily="SegoeUIBold"
                            FontSize="13"
                            CornerRadius="10"
                            HeightRequest="44"
                            WidthRequest="140"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>

                <!--
                     SKELETON SHIMMER khi đang tải (quy chuẩn §2: cấm ActivityIndicator).
                     Ba khối xám mô phỏng đúng thẻ đơn bên trên — avatar tròn, dòng tên
                     và chức vụ, hàng badge — để quản lý thấy trước bố cục trang thay
                     vì nhìn một vòng tròn xoay ở giữa màn hình.
                 -->
                <VerticalStackLayout x:Name="skeletonLayout" IsVisible="{Binding IsLoading}"
                                     Spacing="12" Padding="16,0" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0"
                            BackgroundColor="#FFFFFF" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 22" Stroke="#E2E8F0"
                                        BackgroundColor="#F1F5F9"
                                        WidthRequest="44" HeightRequest="44" />
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <BoxView HeightRequest="14" WidthRequest="140" Color="#E2E8F0" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="10" WidthRequest="110" Color="#F1F5F9" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="10" WidthRequest="90" Color="#F1F5F9" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#F1F5F9"
                                        WidthRequest="62" HeightRequest="20" VerticalOptions="Start" />
                            </Grid>
                            <BoxView HeightRequest="22" Color="#F1F5F9" />
                        </VerticalStackLayout>
                    </Border>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0"
                            BackgroundColor="#FFFFFF" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 22" Stroke="#E2E8F0"
                                        BackgroundColor="#F1F5F9"
                                        WidthRequest="44" HeightRequest="44" />
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <BoxView HeightRequest="14" WidthRequest="120" Color="#E2E8F0" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="10" WidthRequest="130" Color="#F1F5F9" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="10" WidthRequest="80" Color="#F1F5F9" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#F1F5F9"
                                        WidthRequest="62" HeightRequest="20" VerticalOptions="Start" />
                            </Grid>
                            <BoxView HeightRequest="22" Color="#F1F5F9" />
                        </VerticalStackLayout>
                    </Border>
                    <Border StrokeShape="RoundRectangle 16" Stroke="#E2E8F0"
                            BackgroundColor="#FFFFFF" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 22" Stroke="#E2E8F0"
                                        BackgroundColor="#F1F5F9"
                                        WidthRequest="44" HeightRequest="44" />
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <BoxView HeightRequest="14" WidthRequest="150" Color="#E2E8F0" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="10" WidthRequest="100" Color="#F1F5F9" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="10" WidthRequest="95" Color="#F1F5F9" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#F1F5F9"
                                        WidthRequest="62" HeightRequest="20" VerticalOptions="Start" />
                            </Grid>
                            <BoxView HeightRequest="22" Color="#F1F5F9" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </RefreshView>
    </Grid>

</ContentPage>
