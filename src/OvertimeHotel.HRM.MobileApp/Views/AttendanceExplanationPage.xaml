<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:dto="clr-namespace:OvertimeHotel.HRM.Core.DTOs;assembly=OvertimeHotel.HRM.Core"
             xmlns:controls="clr-namespace:OvertimeHotel.HRM.MobileApp.Views.Controls"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.AttendanceExplanationPage"
             x:DataType="vm:AttendanceExplanationViewModel"
             Title="Giải Trình Chấm Công"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="16,12,16,0">

        <!-- ==================== BANNER DEMO ==================== -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsDemoMode}"
                StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B"
                BackgroundColor="#FEF3C7"
                Padding="12,8"
                Margin="0,0,0,12">
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu"
                       TextColor="#B45309"
                       FontFamily="SegoeUIBold"
                       FontSize="11"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,14">
            <Button Grid.Column="0"
                    Text="←"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="#EFF6FF"
                    TextColor="#1E3A8A"
                    Command="{Binding BackCommand}"
                    SemanticProperties.Description="Quay lại" />

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="GIẢI TRÌNH CHẤM CÔNG"
                       FontFamily="SegoeUIBold"
                       FontSize="16"
                       TextColor="#0F172A" />
                <Label Text="Quên quẹt thẻ · Đối soát giờ làm · Phê duyệt 2 cấp"
                       FontFamily="SegoeUI"
                       FontSize="11"
                       TextColor="#64748B" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="↻"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="#EFF6FF"
                    TextColor="#1E3A8A"
                    Command="{Binding RefreshCommand}"
                    SemanticProperties.Description="Tải lại" />
        </Grid>

        <!-- ==================== TAB CHUYỂN ĐỔI ==================== -->
        <Border Grid.Row="2"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="#FFFFFF"
                Padding="4"
                Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        Text="Lập giải trình"
                        Command="{Binding SwitchModeCommand}"
                        CommandParameter="create"
                        BackgroundColor="{Binding CreateTabBackground}"
                        TextColor="{Binding CreateTabColor}"
                        CornerRadius="8"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        HeightRequest="38" />

                <Button Grid.Column="1"
                        Text="{Binding HistoryTabTitle}"
                        Command="{Binding SwitchModeCommand}"
                        CommandParameter="history"
                        BackgroundColor="{Binding HistoryTabBackground}"
                        TextColor="{Binding HistoryTabColor}"
                        CornerRadius="8"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        HeightRequest="38" />
            </Grid>
        </Border>

        <Border Grid.Row="3" IsVisible="{Binding HasError}" Margin="0,0,0,12" Padding="12"
                Stroke="#FCA5A5" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 12">
            <Label Text="{Binding ErrorMessage}" TextColor="#991B1B" FontSize="13" />
        </Border>

        <!-- ==================== SKELETON SHIMMER KHI ĐANG TẢI ==================== -->
        <VerticalStackLayout x:Name="skeletonLayout"
                             Grid.Row="4"
                             IsVisible="{Binding IsLoading}"
                             Spacing="12"
                             Margin="0,8">
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="120" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="150" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- ==================== TAB 1: FORM LẬP GIẢI TRÌNH ==================== -->
        <ScrollView Grid.Row="4"
                    IsVisible="{Binding IsCreateMode}"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="14" Padding="0,0,0,24">

                <!-- BANNER QUY TRÌNH DUYỆT 2 CẤP TINH GỌN -->
                <Border Stroke="#FDE68A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#FFFBEB"
                        Padding="12,10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="🛡️" FontSize="13" VerticalOptions="Center" />
                                <Label Text="QUY TRÌNH PHÊ DUYỆT 2 CẤP"
                                       FontFamily="SegoeUIBold"
                                       FontSize="11"
                                       TextColor="#92400E"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="2"
                                    BackgroundColor="#FEF3C7"
                                    Stroke="#F59E0B"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6,2">
                                <Label Text="Chuẩn 5★"
                                       FontSize="9"
                                       FontFamily="SegoeUIBold"
                                       TextColor="#B45309" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,*,Auto,*" ColumnSpacing="4" Margin="0,2,0,0">
                            <!-- Bước 1 -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#FDE68A"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6,6">
                                <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                    <Label Text="1. Nộp đơn" FontSize="10" FontFamily="SegoeUIBold" TextColor="#B45309" HorizontalOptions="Center" />
                                    <Label Text="Nhân sự" FontSize="9" TextColor="#78350F" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- Mũi tên 1 -->
                            <Label Grid.Column="1" Text="➔" FontSize="10" TextColor="#D97706" VerticalOptions="Center" />
                            <!-- Bước 2 -->
                            <Border Grid.Column="2"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#FDE68A"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6,6">
                                <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                    <Label Text="2. C1: Quản lý" FontSize="10" FontFamily="SegoeUIBold" TextColor="#B45309" HorizontalOptions="Center" />
                                    <Label Text="Xác minh" FontSize="9" TextColor="#78350F" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- Mũi tên 2 -->
                            <Label Grid.Column="3" Text="➔" FontSize="10" TextColor="#D97706" VerticalOptions="Center" />
                            <!-- Bước 3 -->
                            <Border Grid.Column="4"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#FDE68A"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6,6">
                                <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                    <Label Text="3. C2: HR" FontSize="10" FontFamily="SegoeUIBold" TextColor="#B45309" HorizontalOptions="Center" />
                                    <Label Text="Chốt công" FontSize="9" TextColor="#78350F" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 1. CHỌN CA LÀM VIỆC CẦN GIẢI TRÌNH -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="BƯỚC 1: CHỌN CA TRỰC CẦN GIẢI TRÌNH *"
                               FontFamily="SegoeUIBold"
                               FontSize="11"
                               CharacterSpacing="0.8"
                               TextColor="#1E3A8A" />
                        <Label Grid.Column="1"
                               Text="(45 ngày gần nhất)"
                               FontSize="10"
                               TextColor="#94A3B8" />
                    </Grid>

                    <!-- TRIGGER BOX -->
                    <Border Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#FFFFFF"
                            Padding="14,0"
                            HeightRequest="48">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleShiftDropdownCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    WidthRequest="30" HeightRequest="30"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#EFF6FF"
                                    Stroke="#DBEAFE"
                                    StrokeThickness="1"
                                    VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="📅" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="{Binding SelectedShiftDisplayText}"
                                   FontFamily="SegoeUIBold" FontSize="13" TextColor="#1E3A8A"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center" />

                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#F1F5F9"
                                    WidthRequest="26" HeightRequest="26"
                                    Padding="0" VerticalOptions="Center">
                                <Label Text="▼"
                                       FontSize="9" TextColor="#64748B" FontFamily="SegoeUIBold"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- DROPDOWN THẺ NỔI DƯỚI TRIGGER BOX -->
                    <Border IsVisible="{Binding IsShiftDropdownOpen}"
                            Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="#FFFFFF"
                            Padding="6"
                            Margin="0,2,0,4">
                        <Border.Shadow>
                            <Shadow Brush="#0F172A" Offset="0,6" Radius="16" Opacity="0.12" />
                        </Border.Shadow>
                        <ScrollView MaximumHeightRequest="220" VerticalScrollBarVisibility="Always">
                            <VerticalStackLayout Spacing="3"
                                                 BindableLayout.ItemsSource="{Binding EligibleShifts}">
                                <BindableLayout.EmptyView>
                                    <Label Text="Không có ca trực nào trong 45 ngày qua"
                                           TextColor="#94A3B8"
                                           FontSize="12"
                                           FontFamily="SegoeUI"
                                           HorizontalOptions="Center"
                                           Margin="16" />
                                </BindableLayout.EmptyView>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:EligibleShiftDto">
                                        <Border StrokeShape="RoundRectangle 10"
                                                Stroke="Transparent"
                                                BackgroundColor="Transparent"
                                                Padding="12,10"
                                                Margin="0,1">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceExplanationViewModel}}, Path=SelectShiftCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding TenCa}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" />
                                                    <Label Text="{Binding NgayLamViec, StringFormat='Ngày: {0:dd/MM/yyyy}'}" FontFamily="SegoeUI" FontSize="11" TextColor="#64748B" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="#EFF6FF"
                                                        Padding="8,4"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding GioCaText}"
                                                           FontFamily="SegoeUIBold" FontSize="11" TextColor="#1E3A8A" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>
                </VerticalStackLayout>

                <!-- THẺ CHI TIẾT ĐỐI CHIẾU GIỜ THỰC TẾ CỦA CA ĐƯỢC CHỌN -->
                <Border IsVisible="{Binding HasSelectedShift}"
                        BackgroundColor="#FFFFFF"
                        Stroke="#D4AF37"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#0F172A" Offset="0,2" Radius="8" Opacity="0.06" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Border BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeShape="RoundRectangle 6" Padding="6,2">
                                    <Label Text="Ca trực chọn" FontSize="10" FontFamily="SegoeUIBold" TextColor="#1E3A8A" />
                                </Border>
                                <Label Text="{Binding SelectedShift.TenCa}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="13"
                                       TextColor="#0F172A"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedShiftDateText}"
                                   FontFamily="SegoeUIBold"
                                   FontSize="11"
                                   TextColor="#1E3A8A"
                                   VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding SelectedShiftStartText}"
                               TextColor="#64748B" FontSize="11" FontFamily="SegoeUI" />

                        <!-- Hộp đối chiếu dữ liệu vân tay máy quét -->
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12,10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="DỮ LIỆU ĐỐI SOÁT THỰC TẾ TRÊN MÁY CHẤM CÔNG"
                                       FontSize="9.5"
                                       FontFamily="SegoeUIBold"
                                       TextColor="#64748B"
                                       CharacterSpacing="0.5" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Check-in thực tế:" FontSize="10" TextColor="#64748B" FontFamily="SegoeUI" />
                                            <Label Text="{Binding GioVaoThucTeDisplayText}" FontSize="12" FontFamily="SegoeUIBold" TextColor="#0F172A" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Check-out thực tế:" FontSize="10" TextColor="#64748B" FontFamily="SegoeUI" />
                                            <Label Text="{Binding GioRaThucTeDisplayText}" FontSize="12" FontFamily="SegoeUIBold" TextColor="#0F172A" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. GIỜ ĐỀ XUẤT ĐIỀU CHỈNH -->
                <Label Text="BƯỚC 2: GIỜ ĐỀ XUẤT ĐIỀU CHỈNH GHI NHẬN CÔNG"
                       FontFamily="SegoeUIBold"
                       FontSize="11"
                       CharacterSpacing="0.8"
                       TextColor="#1E3A8A" />

                <!-- 2.1 Giờ vào đề xuất -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#0F172A" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleGioVaoCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Bổ sung / sửa Giờ vào"
                                       FontFamily="SegoeUIBold"
                                       FontSize="13"
                                       TextColor="#0F172A" />
                                <Label Text="Bật khi cần cập nhật giờ bắt đầu làm việc"
                                       FontSize="10"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>

                            <!-- Toggle Pill Giờ vào -->
                            <Border Grid.Column="1"
                                    WidthRequest="68"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="2,2"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleGioVaoCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseGioVao}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1E3A8A" />
                                        <Setter Property="Stroke" Value="#D4AF37" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseGioVao}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#E2E8F0" />
                                        <Setter Property="Stroke" Value="#CBD5E1" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid VerticalOptions="Center" HorizontalOptions="Fill">
                                    <!-- Khi BẬT -->
                                    <Label Text="BẬT"
                                           IsVisible="{Binding UseGioVao}"
                                           TextColor="#FFFFFF"
                                           FontFamily="SegoeUIBold"
                                           FontSize="10"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                    <Border IsVisible="{Binding UseGioVao}"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#D4AF37"
                                            StrokeThickness="1"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                        <Label Text="✓"
                                               TextColor="#D4AF37"
                                               FontFamily="SegoeUIBold"
                                               FontSize="11"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Khi TẮT -->
                                    <Border IsVisible="{Binding IsGioVaoOff}"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#64748B"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Label Text="✕"
                                               TextColor="#FFFFFF"
                                               FontFamily="SegoeUIBold"
                                               FontSize="10"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="TẮT"
                                           IsVisible="{Binding IsGioVaoOff}"
                                           TextColor="#64748B"
                                           FontFamily="SegoeUIBold"
                                           FontSize="10"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Margin="0,0,8,0" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Khung chọn giờ vào -->
                        <Border IsVisible="{Binding UseGioVao}"
                                BackgroundColor="#F0FDF4"
                                Stroke="#22C55E"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🕒" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding GioDeXuatVaoDisplayText}"
                                           FontFamily="SegoeUIBold"
                                           FontSize="17"
                                           TextColor="#15803D" />
                                    <Label Text="Giờ vào đề xuất ghi nhận công"
                                           FontSize="10"
                                           TextColor="#166534"
                                           FontFamily="SegoeUI" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#86EFAC"
                                        BackgroundColor="#FFFFFF"
                                        Padding="10,6"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="Đổi giờ ▾"
                                               FontFamily="SegoeUIBold"
                                               FontSize="11"
                                               TextColor="#15803D"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <TimePicker Time="{Binding GioDeXuatVaoTime}"
                                                    Opacity="0.01"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 2.2 Giờ ra đề xuất -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <Border.Shadow>
                        <Shadow Brush="#0F172A" Offset="0,2" Radius="6" Opacity="0.04" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleGioRaCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Bổ sung / sửa Giờ ra"
                                       FontFamily="SegoeUIBold"
                                       FontSize="13"
                                       TextColor="#0F172A" />
                                <Label Text="Bật khi cần cập nhật giờ kết thúc ca làm"
                                       FontSize="10"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>

                            <!-- Toggle Pill Giờ ra -->
                            <Border Grid.Column="1"
                                    WidthRequest="68"
                                    HeightRequest="32"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="2,2"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleGioRaCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseGioRa}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#1E3A8A" />
                                        <Setter Property="Stroke" Value="#D4AF37" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding UseGioRa}" Value="False">
                                        <Setter Property="BackgroundColor" Value="#E2E8F0" />
                                        <Setter Property="Stroke" Value="#CBD5E1" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid VerticalOptions="Center" HorizontalOptions="Fill">
                                    <!-- Khi BẬT -->
                                    <Label Text="BẬT"
                                           IsVisible="{Binding UseGioRa}"
                                           TextColor="#FFFFFF"
                                           FontFamily="SegoeUIBold"
                                           FontSize="10"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                    <Border IsVisible="{Binding UseGioRa}"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#FFFFFF"
                                            Stroke="#D4AF37"
                                            StrokeThickness="1"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                        <Label Text="✓"
                                               TextColor="#D4AF37"
                                               FontFamily="SegoeUIBold"
                                               FontSize="11"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Khi TẮT -->
                                    <Border IsVisible="{Binding IsGioRaOff}"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#64748B"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Label Text="✕"
                                               TextColor="#FFFFFF"
                                               FontFamily="SegoeUIBold"
                                               FontSize="10"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="TẮT"
                                           IsVisible="{Binding IsGioRaOff}"
                                           TextColor="#64748B"
                                           FontFamily="SegoeUIBold"
                                           FontSize="10"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Margin="0,0,8,0" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Khung chọn giờ ra -->
                        <Border IsVisible="{Binding UseGioRa}"
                                BackgroundColor="#F0FDF4"
                                Stroke="#22C55E"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="🕒" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding GioDeXuatRaDisplayText}"
                                           FontFamily="SegoeUIBold"
                                           FontSize="17"
                                           TextColor="#15803D" />
                                    <Label Text="Giờ ra đề xuất ghi nhận công"
                                           FontSize="10"
                                           TextColor="#166534"
                                           FontFamily="SegoeUI" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#86EFAC"
                                        BackgroundColor="#FFFFFF"
                                        Padding="10,6"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="Đổi giờ ▾"
                                               FontFamily="SegoeUIBold"
                                               FontSize="11"
                                               TextColor="#15803D"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <TimePicker Time="{Binding GioDeXuatRaTime}"
                                                    Opacity="0.01"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. LÝ DO GIẢI TRÌNH -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="BƯỚC 3: LÝ DO GIẢI TRÌNH *"
                               FontFamily="SegoeUIBold"
                               FontSize="11"
                               CharacterSpacing="0.8"
                               TextColor="#1E3A8A" />
                        <Label Grid.Column="1"
                               Text="{Binding LyDoLengthText}"
                               FontSize="10"
                               TextColor="#94A3B8" />
                    </Grid>

                    <!-- Chip gợi ý lý do nhanh -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,2,0,4">
                        <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ReasonSuggestions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border StrokeShape="RoundRectangle 16"
                                            Stroke="#BFDBFE"
                                            StrokeThickness="1"
                                            BackgroundColor="#EFF6FF"
                                            Padding="12,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceExplanationViewModel}}, Path=SelectReasonSuggestionCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}"
                                               FontSize="11"
                                               FontFamily="SegoeUIBold"
                                               TextColor="#1E3A8A" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#CBD5E1"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8">
                        <Border.Shadow>
                            <Shadow Brush="#0F172A" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <Editor Text="{Binding LyDo}"
                                Placeholder="Nhập chi tiết lý do quên quẹt thẻ, sai giờ vào/ra..."
                                PlaceholderColor="#94A3B8"
                                MaxLength="500"
                                HeightRequest="80"
                                FontSize="13"
                                TextColor="#0F172A" />
                    </Border>
                </VerticalStackLayout>

                <!-- 4. MINH CHỨNG BỔ SUNG -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="BƯỚC 4: MINH CHỨNG / NGƯỜI XÁC NHẬN"
                               FontFamily="SegoeUIBold"
                               FontSize="11"
                               CharacterSpacing="0.8"
                               TextColor="#64748B" />
                        <Label Grid.Column="1"
                               Text="{Binding MinhChungLengthText}"
                               FontSize="10"
                               TextColor="#94A3B8" />
                    </Grid>
                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#CBD5E1"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8">
                        <Border.Shadow>
                            <Shadow Brush="#0F172A" Offset="0,2" Radius="6" Opacity="0.04" />
                        </Border.Shadow>
                        <Editor Text="{Binding MinhChung}"
                                Placeholder="Ví dụ: Giám sát ca Nguyễn Văn A đã xác nhận lúc 14:05, kiểm tra camera sảnh..."
                                PlaceholderColor="#94A3B8"
                                MaxLength="500"
                                HeightRequest="60"
                                FontSize="13"
                                TextColor="#0F172A" />
                    </Border>
                </VerticalStackLayout>

                <!-- NÚT GỬI GIẢI TRÌNH -->
                <Button Text="✈   GỬI GIẢI TRÌNH CHẤM CÔNG"
                        Command="{Binding SubmitCommand}"
                        BackgroundColor="#1E3A8A"
                        TextColor="#FFFFFF"
                        CornerRadius="14"
                        FontFamily="SegoeUIBold"
                        FontSize="13"
                        HeightRequest="50"
                        Margin="0,10,0,16" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== TAB 2: LỊCH SỬ GIẢI TRÌNH ==================== -->
        <ScrollView Grid.Row="4"
                    IsVisible="{Binding IsHistoryMode}"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="12" Padding="0,0,0,24">

                <!-- Trạng thái trống -->
                <Border IsVisible="{Binding IsEmpty}"
                        BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 16"
                        Padding="24"
                        Margin="0,8">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📭" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="Chưa có giải trình chấm công nào"
                               FontFamily="SegoeUIBold"
                               FontSize="14"
                               TextColor="#334155"
                               HorizontalOptions="Center" />
                        <Label Text="Chuyển sang tab 'Lập giải trình' để gửi yêu cầu mới."
                               FontSize="11"
                               TextColor="#64748B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Danh sách giải trình chuẩn 2 cấp như WebAdmin -->
                <CollectionView ItemsSource="{Binding MyExplanations}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:AttendanceExplanationItemDto">
                            <Border BackgroundColor="#FFFFFF"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <Border.Shadow>
                                    <Shadow Brush="#0F172A" Offset="0,2" Radius="6" Opacity="0.04" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">

                                    <!-- Hàng 1: Mã giải trình + Ca + Badge trạng thái 5★ -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding MaGiaiTrinh, StringFormat='#{0}'}"
                                                       FontFamily="SegoeUIBold"
                                                       FontSize="13"
                                                       TextColor="#1E3A8A" />
                                                <Label Text="·" FontSize="13" TextColor="#CBD5E1" />
                                                <Label Text="{Binding TenCa}"
                                                       FontFamily="SegoeUIBold"
                                                       FontSize="13"
                                                       TextColor="#0F172A" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding NgayLamViec, StringFormat='Ngày: {0:dd/MM/yyyy}'}"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding StatusBadgeBgColor}"
                                                Stroke="{Binding StatusBadgeBorderColor}"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,4"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding StatusBadgeText}"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="10"
                                                   TextColor="{Binding StatusBadgeTextColor}" />
                                        </Border>
                                    </Grid>

                                    <!-- Hàng 2: Đối chiếu giờ vào / ra (Khung so sánh như WebAdmin) -->
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="10,8">
                                        <VerticalStackLayout Spacing="6">
                                            <!-- Check-in so sánh -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                <Label Grid.Column="0" Text="Check-in:" FontSize="10.5" TextColor="#64748B" FontFamily="SegoeUI" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding GioVaoThucTeDisplay}" TextDecorations="Strikethrough" FontSize="11" TextColor="#94A3B8" HorizontalOptions="End" VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                                    <Label Text="➔" FontSize="10" TextColor="#D4AF37" VerticalOptions="Center" />
                                                    <Label Text="{Binding GioDeXuatVaoDisplay}" FontSize="12" FontFamily="SegoeUIBold" TextColor="#1E3A8A" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <!-- Check-out so sánh -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                <Label Grid.Column="0" Text="Check-out:" FontSize="10.5" TextColor="#64748B" FontFamily="SegoeUI" VerticalOptions="Center" />
                                                <Label Grid.Column="1" Text="{Binding GioRaThucTeDisplay}" TextDecorations="Strikethrough" FontSize="11" TextColor="#94A3B8" HorizontalOptions="End" VerticalOptions="Center" />
                                                <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                                    <Label Text="➔" FontSize="10" TextColor="#D4AF37" VerticalOptions="Center" />
                                                    <Label Text="{Binding GioDeXuatRaDisplay}" FontSize="12" FontFamily="SegoeUIBold" TextColor="#1E3A8A" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Hàng 3: Lý do & Minh chứng -->
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding LyDo, StringFormat='Lý do: {0}'}"
                                               FontSize="11.5"
                                               TextColor="#334155"
                                               LineHeight="1.2" />

                                        <Border IsVisible="{Binding HasMinhChung}"
                                                BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,5">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="📎" FontSize="10" VerticalOptions="Center" />
                                                <Label Text="{Binding MinhChung, StringFormat='Minh chứng: {0}'}"
                                                       FontSize="10.5"
                                                       TextColor="#64748B"
                                                       LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Hàng 4: QUY TRÌNH DUYỆT 2 CẤP TRỰC QUAN (Interactive 2-Tier Stepper) -->
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10,8">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="TIẾN TRÌNH XÉT DUYỆT 2 CẤP"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="9.5"
                                                   TextColor="#64748B"
                                                   CharacterSpacing="0.5" />

                                            <!-- CẤP 1: QUẢN LÝ BỘ PHẬN -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Start">
                                                <Border Grid.Column="0"
                                                        WidthRequest="22" HeightRequest="22"
                                                        StrokeShape="RoundRectangle 11"
                                                        BackgroundColor="{Binding ManagerStepIconBg}"
                                                        Stroke="Transparent"
                                                        VerticalOptions="Start">
                                                    <Label Text="{Binding ManagerStepIcon}"
                                                           FontSize="11"
                                                           FontFamily="SegoeUIBold"
                                                           TextColor="{Binding ManagerStepIconColor}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding ManagerStepTitle}"
                                                           FontFamily="SegoeUIBold"
                                                           FontSize="11"
                                                           TextColor="#0F172A" />
                                                    <Label Text="{Binding ManagerStepSubtitle}"
                                                           FontSize="10"
                                                           TextColor="#64748B" />

                                                    <!-- Ý kiến Quản lý nếu có -->
                                                    <Border IsVisible="{Binding HasYKienQuanLy}"
                                                            BackgroundColor="#FFFBEB"
                                                            Stroke="#FDE68A"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="8,4"
                                                            Margin="0,2,0,0">
                                                        <Label Text="{Binding YKienQuanLy, StringFormat='“{0}”'}"
                                                               FontSize="10"
                                                               FontAttributes="Italic"
                                                               TextColor="#92400E" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>

                                            <!-- ĐƯỜNG KẺ NỐI DỌC GIỮA 2 CẤP -->
                                            <BoxView WidthRequest="2"
                                                     HeightRequest="10"
                                                     Color="#CBD5E1"
                                                     HorizontalOptions="Start"
                                                     Margin="10,0,0,0" />

                                            <!-- CẤP 2: PHÒNG NHÂN SỰ (HR) -->
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Start">
                                                <Border Grid.Column="0"
                                                        WidthRequest="22" HeightRequest="22"
                                                        StrokeShape="RoundRectangle 11"
                                                        BackgroundColor="{Binding HrStepIconBg}"
                                                        Stroke="Transparent"
                                                        VerticalOptions="Start">
                                                    <Label Text="{Binding HrStepIcon}"
                                                           FontSize="11"
                                                           FontFamily="SegoeUIBold"
                                                           TextColor="{Binding HrStepIconColor}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding HrStepTitle}"
                                                           FontFamily="SegoeUIBold"
                                                           FontSize="11"
                                                           TextColor="#0F172A" />
                                                    <Label Text="{Binding HrStepSubtitle}"
                                                           FontSize="10"
                                                           TextColor="#64748B" />

                                                    <!-- Ý kiến HR nếu có -->
                                                    <Border IsVisible="{Binding HasYKienHr}"
                                                            BackgroundColor="#F0FDF4"
                                                            Stroke="#BBF7D0"
                                                            StrokeShape="RoundRectangle 6"
                                                            Padding="8,4"
                                                            Margin="0,2,0,0">
                                                        <Label Text="{Binding YKienHr, StringFormat='“{0}”'}"
                                                               FontSize="10"
                                                               FontAttributes="Italic"
                                                               TextColor="#166534" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Hàng 5: Gửi lúc + Nút Rút (khi còn CHO_QUAN_LY) -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding NgayGuiDisplay, StringFormat='Gửi lúc: {0}'}"
                                               FontSize="10"
                                               TextColor="#94A3B8"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Text="Rút giải trình"
                                                IsVisible="{Binding CanWithdraw}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceExplanationViewModel}}, Path=WithdrawCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FEF2F2"
                                                TextColor="#DC2626"
                                                BorderColor="#FCA5A5"
                                                BorderWidth="1"
                                                CornerRadius="8"
                                                FontSize="10.5"
                                                FontFamily="SegoeUIBold"
                                                HeightRequest="28"
                                                Padding="10,0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <controls:LuxuryPopup x:Name="popup" ZIndex="999" />

    </Grid>

</ContentPage>
