<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:dto="clr-namespace:OvertimeHotel.HRM.Core.DTOs;assembly=OvertimeHotel.HRM.Core"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.AttendanceExplanationPage"
             x:DataType="vm:AttendanceExplanationViewModel"
             Title="Giải Trình Chấm Công"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,12,16,0">

        <!-- ==================== BANNER DEMO ==================== -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsDemoMode}"
                StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B"
                BackgroundColor="#FEF3C7"
                Padding="12,8"
                Margin="0,0,0,12">
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu"
                       TextColor="#B45309"
                       FontFamily="SegoeUIBold"
                       FontSize="11"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
            <Button Grid.Column="0"
                    Text="←"
                    FontSize="20"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="#EFF6FF"
                    TextColor="#1E3A8A"
                    Command="{Binding BackCommand}"
                    SemanticProperties.Description="Quay lại" />

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="GIẢI TRÌNH CHẤM CÔNG"
                       FontFamily="SegoeUIBold"
                       FontSize="16"
                       TextColor="#0F172A" />
                <Label Text="Quên quẹt thẻ · Sai lệch giờ vào / ra"
                       FontFamily="SegoeUI"
                       FontSize="11"
                       TextColor="#64748B" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="↻"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="#EFF6FF"
                    TextColor="#1E3A8A"
                    Command="{Binding RefreshCommand}"
                    SemanticProperties.Description="Tải lại" />
        </Grid>

        <!-- ==================== TAB CHUYỂN ĐỔI ==================== -->
        <Border Grid.Row="2"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="#FFFFFF"
                Padding="4"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0"
                        Text="Lập giải trình"
                        Command="{Binding SwitchModeCommand}"
                        CommandParameter="create"
                        BackgroundColor="{Binding CreateTabBackground}"
                        TextColor="{Binding CreateTabColor}"
                        CornerRadius="8"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        HeightRequest="38" />

                <Button Grid.Column="1"
                        Text="Lịch sử giải trình"
                        Command="{Binding SwitchModeCommand}"
                        CommandParameter="history"
                        BackgroundColor="{Binding HistoryTabBackground}"
                        TextColor="{Binding HistoryTabColor}"
                        CornerRadius="8"
                        FontFamily="SegoeUIBold"
                        FontSize="12"
                        HeightRequest="38" />
            </Grid>
        </Border>

        <!-- ==================== SKELETON SHIMMER KHI ĐANG TẢI ==================== -->
        <VerticalStackLayout x:Name="skeletonLayout"
                             Grid.Row="3"
                             IsVisible="{Binding IsLoading}"
                             Spacing="12"
                             Margin="0,8">
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="120" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <BoxView HeightRequest="16" WidthRequest="150" Color="#E2E8F0" HorizontalOptions="Start" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                    <BoxView HeightRequest="13" Color="#F1F5F9" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- ==================== TAB 1: FORM LẬP GIẢI TRÌNH ==================== -->
        <ScrollView Grid.Row="3"
                    IsVisible="{Binding IsCreateMode}"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,24">

                <!-- 1. Chọn ca làm việc -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="CHỌN CA TRỰC CẦN GIẢI TRÌNH"
                           FontFamily="SegoeUIBold"
                           FontSize="11"
                           CharacterSpacing="1"
                           TextColor="#94A3B8" />

                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,4">
                        <Picker ItemsSource="{Binding EligibleShifts}"
                                SelectedItem="{Binding SelectedShift}"
                                ItemDisplayBinding="{Binding TenCa}"
                                Title="-- Chọn ca trực trong 45 ngày qua --"
                                TextColor="#0F172A"
                                FontFamily="SegoeUIBold"
                                FontSize="13" />
                    </Border>
                </VerticalStackLayout>

                <!-- Chi tiết ca được chọn -->
                <Border IsVisible="{Binding HasSelectedShift}"
                        BackgroundColor="#EFF6FF"
                        Stroke="#BFDBFE"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,10">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding SelectedShift.TenCa}"
                                   FontFamily="SegoeUIBold"
                                   FontSize="13"
                                   TextColor="#1E3A8A" />
                            <Label Grid.Column="1"
                                   Text="{Binding SelectedShiftDateText}"
                                   FontFamily="SegoeUIBold"
                                   FontSize="11"
                                   TextColor="#1E3A8A" />
                        </Grid>
                        <Label Text="{Binding SelectedShiftStartText}"
                               TextColor="#475569" FontSize="11" FontFamily="SegoeUI" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Giờ vào đề xuất -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Bổ sung / sửa Giờ vào"
                                       FontFamily="SegoeUIBold"
                                       FontSize="13"
                                       TextColor="#0F172A" />
                                <Label Text="Bật khi cần cập nhật giờ bắt đầu làm"
                                       FontSize="10"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding UseGioVao}"
                                    OnColor="#1E3A8A"
                                    ThumbColor="#FFFFFF" />
                        </Grid>

                        <TimePicker IsVisible="{Binding UseGioVao}"
                                    Time="{Binding GioDeXuatVaoTime}"
                                    TextColor="#1E3A8A"
                                    FontFamily="SegoeUIBold"
                                    FontSize="16" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Giờ ra đề xuất -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Bổ sung / sửa Giờ ra"
                                       FontFamily="SegoeUIBold"
                                       FontSize="13"
                                       TextColor="#0F172A" />
                                <Label Text="Bật khi cần cập nhật giờ kết thúc ca"
                                       FontSize="10"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding UseGioRa}"
                                    OnColor="#1E3A8A"
                                    ThumbColor="#FFFFFF" />
                        </Grid>

                        <TimePicker IsVisible="{Binding UseGioRa}"
                                    Time="{Binding GioDeXuatRaTime}"
                                    TextColor="#1E3A8A"
                                    FontFamily="SegoeUIBold"
                                    FontSize="16" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4. Lý do giải trình -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="LÝ DO GIẢI TRÌNH *"
                               FontFamily="SegoeUIBold"
                               FontSize="11"
                               CharacterSpacing="1"
                               TextColor="#94A3B8" />
                        <Label Grid.Column="1"
                               Text="{Binding LyDoLengthText}"
                               FontSize="10"
                               TextColor="#94A3B8" />
                    </Grid>
                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Editor Text="{Binding LyDo}"
                                Placeholder="Nhập chi tiết lý do quên quẹt thẻ, sai giờ vào/ra..."
                                MaxLength="500"
                                HeightRequest="80"
                                FontSize="13"
                                TextColor="#0F172A" />
                    </Border>
                </VerticalStackLayout>

                <!-- 5. Minh chứng bổ sung -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="MINH CHỨNG / NGƯỜI XÁC NHẬN"
                               FontFamily="SegoeUIBold"
                               FontSize="11"
                               CharacterSpacing="1"
                               TextColor="#94A3B8" />
                        <Label Grid.Column="1"
                               Text="{Binding MinhChungLengthText}"
                               FontSize="10"
                               TextColor="#94A3B8" />
                    </Grid>
                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12">
                        <Editor Text="{Binding MinhChung}"
                                Placeholder="Ví dụ: Giám sát A đã xác nhận lúc 14:05, tin nhắn zalo..."
                                MaxLength="500"
                                HeightRequest="60"
                                FontSize="13"
                                TextColor="#0F172A" />
                    </Border>
                </VerticalStackLayout>

                <!-- Nút gửi giải trình -->
                <Button Text="GỬI GIẢI TRÌNH"
                        Command="{Binding SubmitCommand}"
                        BackgroundColor="#1E3A8A"
                        TextColor="#FFFFFF"
                        CornerRadius="14"
                        FontFamily="SegoeUIBold"
                        FontSize="14"
                        HeightRequest="48"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== TAB 2: LỊCH SỬ GIẢI TRÌNH ==================== -->
        <ScrollView Grid.Row="3"
                    IsVisible="{Binding IsHistoryMode}"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="12" Padding="0,0,0,24">

                <!-- Trạng thái trống -->
                <Border IsVisible="{Binding IsEmpty}"
                        BackgroundColor="#FFFFFF"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 16"
                        Padding="24"
                        Margin="0,8">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📭" FontSize="36" HorizontalOptions="Center" />
                        <Label Text="Chưa có giải trình chấm công nào"
                               FontFamily="SegoeUIBold"
                               FontSize="14"
                               TextColor="#334155"
                               HorizontalOptions="Center" />
                        <Label Text="Chuyển sang tab 'Lập giải trình' để gửi yêu cầu mới."
                               FontSize="11"
                               TextColor="#64748B"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Danh sách giải trình -->
                <CollectionView ItemsSource="{Binding MyExplanations}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:AttendanceExplanationItemDto">
                            <Border BackgroundColor="#FFFFFF"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="8">
                                    <!-- Hàng 1: Ca + Badge trạng thái -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding TenCa}"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="13"
                                                   TextColor="#0F172A" />
                                            <Label Text="{Binding NgayLamViec, StringFormat='Ngày: {0:dd/MM/yyyy}'}"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                BackgroundColor="#EFF6FF"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="8,3"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding TrangThaiLabel}"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="10"
                                                   TextColor="#1E3A8A" />
                                        </Border>
                                    </Grid>

                                    <!-- Hàng 2: Giờ đề xuất -->
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,6">
                                        <Grid ColumnDefinitions="*,*">
                                            <Label Grid.Column="0"
                                                   Text="{Binding GioDeXuatVao, StringFormat='Vào ĐX: {0:HH\\:mm}'}"
                                                   FontSize="11"
                                                   FontFamily="SegoeUIBold"
                                                   TextColor="#047857" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding GioDeXuatRa, StringFormat='Ra ĐX: {0:HH\\:mm}'}"
                                                   FontSize="11"
                                                   FontFamily="SegoeUIBold"
                                                   TextColor="#047857" />
                                        </Grid>
                                    </Border>

                                    <!-- Hàng 3: Lý do & Minh chứng -->
                                    <Label Text="{Binding LyDo, StringFormat='Lý do: {0}'}"
                                           FontSize="11"
                                           TextColor="#475569"
                                           MaxLines="2" />

                                    <!-- Hàng 4: Ý kiến Quản lý / HR nếu có -->
                                    <Border IsVisible="{Binding HasYKienQuanLy}"
                                            BackgroundColor="#FFFBEB"
                                            Stroke="#FDE68A"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,5">
                                        <Label Text="{Binding YKienQuanLy, StringFormat='Quản lý: {0}'}"
                                               FontSize="10"
                                               TextColor="#92400E" />
                                    </Border>

                                    <!-- Hàng 5: Gửi lúc + Nút Rút (khi còn CHO_QUAN_LY) -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding NgayGui, StringFormat='Gửi: {0:HH\\:mm dd/MM}'}"
                                               FontSize="10"
                                               TextColor="#94A3B8"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="1"
                                                Text="Rút giải trình"
                                                IsVisible="{Binding CanWithdraw}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceExplanationViewModel}}, Path=WithdrawCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FEF2F2"
                                                TextColor="#DC2626"
                                                BorderColor="#FCA5A5"
                                                BorderWidth="1"
                                                CornerRadius="8"
                                                FontSize="10"
                                                FontFamily="SegoeUIBold"
                                                HeightRequest="28"
                                                Padding="10,0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
