<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- 1. NỘI DUNG CHÍNH CỦA TRANG PROFILE -->
        <ScrollView>
            <VerticalStackLayout x:Name="pageBody" Spacing="16" Padding="20,0,20,32">

                <!-- HEADER: NÚT QUAY LẠI & TIÊU ĐỀ (trang push từ tab Cài Đặt) -->
                <Grid x:Name="profileHeader" Opacity="0" ColumnDefinitions="Auto,*" VerticalOptions="Center" Margin="0,2,0,8">
                    <Button Grid.Column="0"
                            Text="← Quay Lại"
                            Clicked="OnBackButtonClicked"
                            FontFamily="SegoeUIBold"
                            FontSize="12"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1E3A8A"
                            BorderColor="#BFDBFE"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="36"
                            Padding="12,0" />

                    <Label Grid.Column="1"
                           Text="Thông Tin Cá Nhân"
                           FontFamily="SegoeUIBold"
                           FontSize="18"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>

                <!-- THẺ 1: HỒ SƠ & THÔNG TIN CÁ NHÂN (IDENTITY CARD) -->
                <Border x:Name="identityCard"
                        Opacity="0"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        BackgroundColor="#FFFFFF"
                        Padding="20,24">
                    <Border.Shadow>
                        <Shadow Brush="#64748B" Offset="0,6" Radius="16" Opacity="0.07" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- AVATAR TRÒN + HỌ TÊN + VAI TRÒ -->
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <!-- Avatar chữ cái đầu -->
                            <Border StrokeShape="RoundRectangle 36"
                                    Stroke="#D4AF37"
                                    StrokeThickness="2.5"
                                    BackgroundColor="#1E3A8A"
                                    WidthRequest="72"
                                    HeightRequest="72"
                                    HorizontalOptions="Center">
                                <Border.Shadow>
                                    <Shadow Brush="#1E3A8A" Offset="0,4" Radius="12" Opacity="0.25" />
                                </Border.Shadow>
                                <Label Text="{Binding AvatarLetter}"
                                       TextColor="#FDE047"
                                       FontSize="30"
                                       FontFamily="SegoeUIBold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Text="{Binding FullName}"
                                   TextColor="#0F172A"
                                   FontFamily="SegoeUIBold"
                                   FontSize="20"
                                   HorizontalOptions="Center" />

                            <Border StrokeShape="RoundRectangle 10"
                                    Stroke="#BFDBFE"
                                    BackgroundColor="#EFF6FF"
                                    Padding="12,3"
                                    HorizontalOptions="Center">
                                <Label Text="{Binding RoleName}"
                                       TextColor="#1E3A8A"
                                       FontFamily="SegoeUIBold"
                                       FontSize="11"
                                       CharacterSpacing="1" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- ĐƯỜNG KẺ PHÂN CÁCH MỜ -->
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4" />

                        <!-- DANH SÁCH CHI TIẾT THÔNG TIN -->
                        <VerticalStackLayout Spacing="12">
                            <!-- Phòng ban -->
                            <Grid ColumnDefinitions="32,Auto,*">
                                <Label Grid.Column="0" Text="🏢" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Phòng Ban:" TextColor="#64748B" FontFamily="SegoeUI" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding DepartmentName}" TextColor="#0F172A" FontFamily="SegoeUIBold" FontSize="13" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>

                            <!-- Chức vụ -->
                            <Grid ColumnDefinitions="32,Auto,*">
                                <Label Grid.Column="0" Text="🏷️" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Chức Vụ:" TextColor="#64748B" FontFamily="SegoeUI" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding PositionName}" TextColor="#0F172A" FontFamily="SegoeUIBold" FontSize="13" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>

                            <!-- Mã nhân viên -->
                            <Grid ColumnDefinitions="32,Auto,*">
                                <Label Grid.Column="0" Text="🆔" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Mã Nhân Viên:" TextColor="#64748B" FontFamily="SegoeUI" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding EmployeeId, StringFormat='NV-{0:D3}'}" TextColor="#1E3A8A" FontFamily="SegoeUIBold" FontSize="13" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>

                            <!-- Tên đăng nhập -->
                            <Grid ColumnDefinitions="32,Auto,*">
                                <Label Grid.Column="0" Text="👤" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Tài Khoản:" TextColor="#64748B" FontFamily="SegoeUI" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Username, StringFormat='@{0}'}" TextColor="#475569" FontFamily="SegoeUI" FontSize="13" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>

                            <!-- Email -->
                            <Grid ColumnDefinitions="32,Auto,*">
                                <Label Grid.Column="0" Text="📧" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Email công vụ:" TextColor="#64748B" FontFamily="SegoeUI" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Email}" TextColor="#0F172A" FontFamily="SegoeUI" FontSize="12" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>

                            <!-- Điện thoại -->
                            <Grid ColumnDefinitions="32,Auto,*">
                                <Label Grid.Column="0" Text="📞" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Điện Thoại:" TextColor="#64748B" FontFamily="SegoeUI" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding Phone}" TextColor="#0F172A" FontFamily="SegoeUIBold" FontSize="13" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Margin="0,16,0,0" Text="Chỉnh sửa thông tin" Clicked="OnEditContactClicked" FontFamily="SegoeUIBold" FontSize="15" HeightRequest="50" BackgroundColor="#1E3A8A" TextColor="White" BorderColor="#D4AF37" BorderWidth="1" CornerRadius="12" />
                <Label x:Name="profileStatus" FontSize="14" TextColor="#166534" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="contactOverlay" IsVisible="False" BackgroundColor="#990F172A" ZIndex="999">
            <ScrollView VerticalOptions="Center" MaximumHeightRequest="650">
                <Border StrokeShape="RoundRectangle 20" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="20,24" HorizontalOptions="Fill" VerticalOptions="Center" Margin="20,16">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Chỉnh sửa thông tin" FontFamily="SegoeUIBold" FontSize="17" TextColor="#1E3A8A" />
                        <Label Text="Thay đổi thông tin liên hệ của bạn." FontFamily="SegoeUI" FontSize="14" TextColor="#475569" />
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Số điện thoại *" FontFamily="SegoeUIBold" FontSize="14" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0">
                                <Entry x:Name="phoneEntry" SemanticProperties.Description="Số điện thoại" Placeholder="Nhập số điện thoại" PlaceholderColor="#64748B" TextColor="#0F172A" FontSize="16" HeightRequest="50" Keyboard="Telephone" MaxLength="20" IsEnabled="False" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email cá nhân" FontFamily="SegoeUIBold" FontSize="14" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0">
                                <Entry x:Name="personalEmailEntry" SemanticProperties.Description="Email cá nhân" Placeholder="Không bắt buộc" PlaceholderColor="#64748B" TextColor="#0F172A" FontSize="16" HeightRequest="50" Keyboard="Email" MaxLength="100" IsEnabled="False" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Địa chỉ" FontFamily="SegoeUIBold" FontSize="14" TextColor="#334155" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="12,0">
                                <Entry x:Name="addressEntry" SemanticProperties.Description="Địa chỉ" Placeholder="Không bắt buộc" PlaceholderColor="#64748B" TextColor="#0F172A" FontSize="16" HeightRequest="50" MaxLength="255" IsEnabled="False" />
                            </Border>
                        </VerticalStackLayout>
                        <Label x:Name="contactStatus" Text="Đang tải thông tin liên hệ..." FontSize="14" TextColor="#475569" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="cancelContactButton" Grid.Column="0" Text="Hủy" Clicked="OnCancelContactClicked" FontFamily="SegoeUIBold" FontSize="15" HeightRequest="50" BackgroundColor="#EFF6FF" TextColor="#1E3A8A" CornerRadius="12" />
                            <Button x:Name="saveContactButton" Grid.Column="1" Text="Lưu thay đổi" Clicked="OnSaveContactClicked" IsEnabled="False" FontFamily="SegoeUIBold" FontSize="15" HeightRequest="50" BackgroundColor="#1E3A8A" TextColor="White" BorderColor="#D4AF37" BorderWidth="1" CornerRadius="12" />
                        </Grid>
                        <Button x:Name="reloadContactButton" Text="Tải lại thông tin" Clicked="OnReloadContactClicked" IsVisible="False" HeightRequest="48" BackgroundColor="#EFF6FF" TextColor="#1E3A8A" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>
