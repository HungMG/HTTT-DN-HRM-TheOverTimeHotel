<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:m="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.AttendanceSummaryPage"
             x:DataType="vm:AttendanceSummaryViewModel"
             Title="Công &amp; nghỉ phép" BackgroundColor="#F8FAFC" Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="SegoeUI" />
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="SegoeUIBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BackgroundColor" Value="#EFF6FF" />
            <Setter Property="TextColor" Value="#1E3A8A" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="summaryGrid" RowDefinitions="Auto,Auto,Auto,*" Padding="16,12,16,0" RowSpacing="12">
        <Border Grid.Row="0" IsVisible="{Binding IsDemoMode}" StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B" BackgroundColor="#FEF3C7" Padding="12,8">
            <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu" TextColor="#B45309" FontFamily="SegoeUIBold" />
        </Border>

        <Grid x:Name="headerBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Text="←" Clicked="OnBackClicked" WidthRequest="44" CornerRadius="22" Padding="0"
                    FontSize="20" SemanticProperties.Description="Quay lại" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                <Label Text="Công &amp; nghỉ phép" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                <Label Text="{Binding EmployeeName}" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="↻" FontSize="22" WidthRequest="44" Padding="0"
                    Command="{Binding RefreshCommand}" SemanticProperties.Description="Tải lại bảng công" />
        </Grid>

        <Border Grid.Row="2" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 14" Padding="4">
            <Grid ColumnDefinitions="44,*,44" RowDefinitions="Auto,Auto">
                <Button Text="‹" FontSize="24" Padding="0" Command="{Binding PreviousMonthCommand}"
                        BackgroundColor="Transparent" SemanticProperties.Description="Tháng trước" />
                <Label Grid.Column="1" Text="{Binding PeriodText}" FontFamily="SegoeUIBold" FontSize="16"
                       TextColor="#1E3A8A" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Grid.Column="2" Text="›" FontSize="24" Padding="0" Command="{Binding NextMonthCommand}"
                        BackgroundColor="Transparent" SemanticProperties.Description="Tháng sau" />
                <Button Grid.Row="1" Grid.ColumnSpan="3" Text="Về tháng hiện tại" BackgroundColor="Transparent"
                        Command="{Binding CurrentMonthCommand}" />
            </Grid>
        </Border>

        <RefreshView Grid.Row="3" IsVisible="{Binding HasData}" IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}" RefreshColor="#1E3A8A">
            <CollectionView ItemsSource="{Binding Days}" SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12" Padding="0,0,0,12">
                        <Border BackgroundColor="#1E3A8A" Stroke="#1E3A8A" StrokeShape="RoundRectangle 18" Padding="20">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="NGÀY CÔNG TÍNH LƯƠNG" TextColor="#DBEAFE" FontFamily="SegoeUIBold" FontSize="11" CharacterSpacing="1" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding TotalText}" FontFamily="SegoeUIBold" FontSize="40" TextColor="White" />
                                    <Label Text="ngày" TextColor="#DBEAFE" VerticalOptions="End" Margin="0,0,0,8" />
                                </HorizontalStackLayout>
                                <Label Text="Công thực tế + phép hưởng lương, mỗi ngày tính một lần." TextColor="#DBEAFE" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border Stroke="#E2E8F0" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="10,14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding WorkedText}" FontSize="24" FontFamily="SegoeUIBold" TextColor="#1E3A8A" />
                                    <Label Text="Công thực tế" FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Stroke="#A7F3D0" BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 14" Padding="10,14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding PaidLeaveText}" FontSize="24" FontFamily="SegoeUIBold" TextColor="#047857" />
                                    <Label Text="Công từ phép" FontSize="11" TextColor="#047857" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" Stroke="#E2E8F0" BackgroundColor="White" StrokeShape="RoundRectangle 14" Padding="10,14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding ScheduledText}" FontSize="24" FontFamily="SegoeUIBold" TextColor="#0F172A" />
                                    <Label Text="Ngày có ca" FontSize="11" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="Tạm tính theo lịch và đơn đã duyệt của cả tháng, gồm cả ngày sắp tới. Chưa phải bảng lương đã chốt." LineHeight="1.3" />
                        <Border IsVisible="{Binding HasReviewDays}" Stroke="#FCD34D" BackgroundColor="#FFFBEB"
                                StrokeShape="RoundRectangle 12" Padding="12">
                            <Label Text="{Binding ReviewText}" TextColor="#92400E" />
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Tất cả ngày" Command="{Binding FilterCommand}" CommandParameter="all"
                                    BackgroundColor="{Binding AllFilterBackground}" TextColor="{Binding AllFilterColor}"
                                    BorderColor="#E2E8F0" BorderWidth="1" />
                            <Button Grid.Column="1" Text="Có đơn phép" Command="{Binding FilterCommand}" CommandParameter="leave"
                                    BackgroundColor="{Binding LeaveFilterBackground}" TextColor="{Binding LeaveFilterColor}"
                                    BorderColor="#E2E8F0" BorderWidth="1" />
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,28" Spacing="10">
                        <Label Text="Chưa có dữ liệu" FontFamily="SegoeUIBold" FontSize="16" TextColor="#334155" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AttendanceDayItem">
                        <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16"
                                Padding="16" Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DateText}" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                                        <Label Text="{Binding Weekday}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{Binding StatusBackground}"
                                            StrokeShape="RoundRectangle 10" Padding="10,6" VerticalOptions="Center">
                                        <Label Text="{Binding CreditText}" FontFamily="SegoeUIBold" TextColor="{Binding StatusColor}" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding StatusText}" FontFamily="SegoeUIBold" TextColor="{Binding StatusColor}" />
                                <Label Text="{Binding ShiftText}" />
                                <Border IsVisible="{Binding HasLeave}" BackgroundColor="#F8FAFC" Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 10" Padding="12">
                                    <Label Text="{Binding LeaveText}" TextColor="#334155" LineHeight="1.3" />
                                </Border>
                                <Label Text="{Binding Explanation}" FontSize="11" />
                                <Label IsVisible="{Binding NeedsReview}" Text="Cần đối chiếu đơn phép với chấm công."
                                       TextColor="#B45309" FontFamily="SegoeUIBold" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Label Text="Phép hưởng lương không phát sinh giờ OT hoặc giờ làm ca đêm."
                           FontSize="11" HorizontalTextAlignment="Center" Margin="8,8,8,24" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="3" IsVisible="{Binding IsLoading}" VerticalOptions="Center" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#1E3A8A" />
            <Label Text="Đang đối chiếu công và nghỉ phép…" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="3" IsVisible="{Binding HasError}" VerticalOptions="Center" Spacing="14" Padding="16">
            <Label Text="Chưa tải được bảng công" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" HorizontalTextAlignment="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" HorizontalTextAlignment="Center" />
            <Button Text="Thử lại" Command="{Binding RefreshCommand}" BackgroundColor="#1E3A8A" TextColor="White" />
            <Button Text="Đăng nhập lại" IsVisible="{Binding RequiresLogin}" Command="{Binding LoginCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
