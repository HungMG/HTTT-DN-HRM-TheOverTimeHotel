<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.Controls.StatTile">

    <Border x:Name="tileBorder"
            StrokeShape="RoundRectangle 14"
            Stroke="#E2E8F0"
            StrokeThickness="1"
            BackgroundColor="#FFFFFF"
            Padding="12,10">
        <Border.Shadow>
            <Shadow Brush="#64748B" Offset="0,4" Radius="8" Opacity="0.06" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
            <Label x:Name="lblCaption"
                   Text="Chỉ số"
                   TextColor="#64748B"
                   FontSize="11"
                   FontFamily="SegoeUI"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="lblValue"
                   Text="0"
                   TextColor="#1E3A8A"
                   FontSize="20"
                   FontFamily="SegoeUIBold"
                   HorizontalOptions="Center" />
            <Label x:Name="lblSubCaption"
                   Text=""
                   TextColor="#94A3B8"
                   FontSize="9"
                   FontFamily="SegoeUI"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Border>

</ContentView>