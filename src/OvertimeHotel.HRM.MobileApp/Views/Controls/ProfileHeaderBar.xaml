<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.Controls.ProfileHeaderBar">

    <Grid>

        <VerticalStackLayout Spacing="3">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Image Source="brand_mark_light.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       Aspect="AspectFit"
                       VerticalOptions="Center"
                       SemanticProperties.Description="Huy hiệu The OverTime Hotel" />
                <Label Text="THE OVERTIME HOTEL 5★"
                       TextColor="#1E3A8A"
                       FontSize="11"
                       FontFamily="SegoeUIBold"
                       CharacterSpacing="1"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label x:Name="lblGreeting"
                   Text="Xin chào!"
                   TextColor="#0F172A"
                   FontSize="20"
                   FontFamily="SegoeUIBold"
                   LineBreakMode="TailTruncation" />

            <Label x:Name="lblRoleDepartment"
                   Text="The OverTime Hotel"
                   TextColor="#64748B"
                   FontSize="12"
                   FontFamily="SegoeUI"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
    </Grid>

</ContentView>