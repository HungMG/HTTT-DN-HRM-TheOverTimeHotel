<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.Controls.FeatureTile">

    <Border x:Name="tileBorder"
            StrokeShape="RoundRectangle 16"
            Stroke="#E2E8F0"
            StrokeThickness="1"
            BackgroundColor="#FFFFFF"
            Padding="14">
        <Border.Shadow>
            <Shadow Brush="#64748B" Offset="0,4" Radius="10" Opacity="0.06" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="8">
            <Label x:Name="lblIcon"
                   Text="★"
                   FontSize="24"
                   HorizontalOptions="Start" />

            <Label x:Name="lblTitle"
                   Text="Chức năng"
                   TextColor="#0F172A"
                   FontSize="14"
                   FontFamily="SegoeUIBold" />

            <Label x:Name="lblDescription"
                   Text="Mô tả ngắn"
                   TextColor="#64748B"
                   FontSize="11"
                   FontFamily="SegoeUI" />

            <Button x:Name="btnAction"
                    Text="MỞ"
                    Clicked="OnActionClicked"
                    BackgroundColor="#1E3A8A"
                    TextColor="#FFFFFF"
                    FontFamily="SegoeUIBold"
                    FontSize="11"
                    HeightRequest="32"
                    CornerRadius="8"
                    HorizontalOptions="Start" />
        </VerticalStackLayout>
    </Border>

</ContentView>