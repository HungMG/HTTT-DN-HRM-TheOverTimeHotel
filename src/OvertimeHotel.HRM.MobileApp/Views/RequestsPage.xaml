<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:m="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.RequestsPage"
             x:DataType="vm:RequestsViewModel"
             Title="Đơn Từ"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,12,16,0">

        <!-- ==================== BANNER CHẾ ĐỘ DEMO ==================== -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsDemoMode}"
                StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B"
                BackgroundColor="#FEF3C7"
                Padding="12,8"
                Margin="0,0,0,12">
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="⚠️" FontSize="14" VerticalOptions="Center" />
                <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu"
                       TextColor="#B45309"
                       FontFamily="SegoeUIBold"
                       FontSize="11"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- ==================== HEADER ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                <Label Text="ĐƠN TỪ &amp; YÊU CẦU"
                       FontFamily="SegoeUIBold"
                       FontSize="18"
                       TextColor="#0F172A" />
                <Label Text="Tạo và theo dõi tiến độ duyệt đơn trực tuyến"
                       FontFamily="SegoeUI"
                       FontSize="11"
                       TextColor="#64748B" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="↻"
                    FontSize="22"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    Padding="0"
                    BackgroundColor="#EFF6FF"
                    TextColor="#1E3A8A"
                    Command="{Binding RefreshCommand}"
                    SemanticProperties.Description="Tải lại danh sách đơn" />
        </Grid>

        <!-- ==================== NỘI DUNG CUỘN CHÍNH ==================== -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#1E3A8A">
            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="16" Padding="0,0,0,24">

                    <!-- KHỐI 1: TẠO YÊU CẦU MỚI -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="TẠO YÊU CẦU MỚI"
                               FontFamily="SegoeUIBold"
                               FontSize="11"
                               CharacterSpacing="1"
                               TextColor="#94A3B8" />

                        <!-- Nút 1: Nghỉ phép (Đang hoạt động) -->
                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CreateLeaveCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="#1E3A8A" Offset="0,2" Radius="8" Opacity="0.04" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#EFF6FF"
                                        Stroke="#BFDBFE"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">
                                    <Label Text="📝"
                                           FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Nghỉ Phép"
                                           FontFamily="SegoeUIBold"
                                           FontSize="13"
                                           TextColor="#1E3A8A" />
                                    <Label Text="Phép năm, ốm đau, thai sản, việc riêng"
                                           FontFamily="SegoeUI"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontFamily="SegoeUIBold"
                                       FontSize="20"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Nút 2: Giải trình chấm công (Hoàn thành ở Giai đoạn 3) -->
                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CreateExplanationCommand}" />
                            </Border.GestureRecognizers>
                            <Border.Shadow>
                                <Shadow Brush="#92400E" Offset="0,2" Radius="8" Opacity="0.04" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#FFFBEB"
                                        Stroke="#FDE68A"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">
                                    <Label Text="⏰"
                                           FontSize="18"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Giải Trình Chấm Công"
                                           FontFamily="SegoeUIBold"
                                           FontSize="13"
                                           TextColor="#92400E" />
                                    <Label Text="Quên quẹt thẻ, sai giờ vào / ra"
                                           FontFamily="SegoeUI"
                                           FontSize="11"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontFamily="SegoeUIBold"
                                       FontSize="20"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>                        
                    </VerticalStackLayout>

                    <!-- KHỐI 2: ĐƠN GẦN ĐÂY -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="ĐƠN GẦN ĐÂY"
                                   FontFamily="SegoeUIBold"
                                   FontSize="11"
                                   CharacterSpacing="1"
                                   TextColor="#94A3B8"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasPendingRequests}"
                                    BackgroundColor="#EFF6FF"
                                    Stroke="#BFDBFE"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8,2">
                                <Label Text="{Binding PendingCount, StringFormat='{0} đơn chờ'}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="10"
                                       TextColor="#1E3A8A" />
                            </Border>
                        </Grid>

                        <!-- SKELETON SHIMMER KHI ĐANG TẢI (Quy chuẩn UI §2: cấm ActivityIndicator) -->
                        <VerticalStackLayout x:Name="skeletonLayout"
                                             IsVisible="{Binding IsLoading}"
                                             Spacing="10"
                                             Margin="0,4">
                            <Border Stroke="#E2E8F0"
                                    BackgroundColor="#FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <BoxView Grid.Column="0" HeightRequest="14" WidthRequest="130" Color="#E2E8F0" HorizontalOptions="Start" />
                                        <BoxView Grid.Column="1" HeightRequest="14" WidthRequest="64" Color="#F1F5F9" />
                                    </Grid>
                                    <BoxView HeightRequest="12" WidthRequest="180" Color="#F1F5F9" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="12" Color="#F1F5F9" />
                                    <BoxView HeightRequest="10" WidthRequest="100" Color="#F8FAFC" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Stroke="#E2E8F0"
                                    BackgroundColor="#FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <BoxView Grid.Column="0" HeightRequest="14" WidthRequest="150" Color="#E2E8F0" HorizontalOptions="Start" />
                                        <BoxView Grid.Column="1" HeightRequest="14" WidthRequest="64" Color="#F1F5F9" />
                                    </Grid>
                                    <BoxView HeightRequest="12" WidthRequest="160" Color="#F1F5F9" HorizontalOptions="Start" />
                                    <BoxView HeightRequest="12" Color="#F1F5F9" />
                                    <BoxView HeightRequest="10" WidthRequest="110" Color="#F8FAFC" HorizontalOptions="Start" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Thông báo lỗi nếu có -->
                        <Border IsVisible="{Binding HasError}"
                                BackgroundColor="#FEF2F2"
                                Stroke="#FCA5A5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10"
                                Margin="0,4">
                            <Label Text="{Binding ErrorMessage}"
                                   FontFamily="SegoeUI"
                                   FontSize="12"
                                   TextColor="#991B1B"
                                   HorizontalOptions="Center" />
                        </Border>

                        <!-- Trạng thái trống (Empty View) -->
                        <Border IsVisible="{Binding IsEmpty}"
                                BackgroundColor="#FFFFFF"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Padding="24"
                                Margin="0,4">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="📭"
                                       FontSize="36"
                                       HorizontalOptions="Center" />
                                <Label Text="Chưa có đơn từ nào gần đây"
                                       FontFamily="SegoeUIBold"
                                       FontSize="14"
                                       TextColor="#334155"
                                       HorizontalOptions="Center" />
                                <Label Text="Nhấn 'Nghỉ Phép' ở trên để nộp đơn mới."
                                       FontFamily="SegoeUI"
                                       FontSize="11"
                                       TextColor="#64748B"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Danh sách đơn gần đây -->
                        <CollectionView ItemsSource="{Binding RecentRequests}"
                                        SelectionMode="None"
                                        IsVisible="{Binding HasRequests}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="m:LeaveRequestItem">
                                    <Border BackgroundColor="#FFFFFF"
                                            Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="14"
                                            Margin="0,0,0,10">
                                        <Border.Shadow>
                                            <Shadow Brush="#0F172A" Offset="0,2" Radius="6" Opacity="0.03" />
                                        </Border.Shadow>
                                        <VerticalStackLayout Spacing="8">
                                            <!-- Hàng 1: Loại đơn + Badge trạng thái -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="{Binding TenLoaiDon}"
                                                       FontFamily="SegoeUIBold"
                                                       FontSize="13"
                                                       TextColor="#0F172A"
                                                       VerticalOptions="Center" />
                                                <Border Grid.Column="1"
                                                        BackgroundColor="{Binding StatusBgColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="8,3"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding StatusText}"
                                                           FontFamily="SegoeUIBold"
                                                           FontSize="10"
                                                           TextColor="{Binding StatusColor}" />
                                                </Border>
                                            </Grid>

                                            <!-- Hàng 2: Khoảng thời gian + Số ngày -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                    <Label Text="📅" FontSize="11" VerticalOptions="Center" />
                                                    <Label Text="{Binding PeriodDisplay}"
                                                           FontFamily="SegoeUI"
                                                           FontSize="12"
                                                           TextColor="#334155"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Border Grid.Column="1"
                                                        BackgroundColor="#EFF6FF"
                                                        Stroke="#DBEAFE"
                                                        StrokeThickness="1"
                                                        StrokeShape="RoundRectangle 8"
                                                        Padding="6,2"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding SoNgayNghiDisplay}"
                                                           FontFamily="SegoeUIBold"
                                                           FontSize="10"
                                                           TextColor="#1E3A8A" />
                                                </Border>
                                            </Grid>

                                            <!-- Hàng 3: Lý do nộp đơn -->
                                            <Label Text="{Binding LyDo}"
                                                   FontFamily="SegoeUI"
                                                   FontSize="11"
                                                   TextColor="#64748B"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />

                                            <!-- Hàng 4: Phản hồi duyệt (nếu có) -->
                                            <Border IsVisible="{Binding HasPhanHoi}"
                                                    BackgroundColor="#F8FAFC"
                                                    Stroke="#E2E8F0"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="10,6">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding PhanHoiTitle}"
                                                           FontFamily="SegoeUIBold"
                                                           FontSize="9"
                                                           TextColor="#475569" />
                                                    <Label Text="{Binding PhanHoiDuyet}"
                                                           FontFamily="SegoeUI"
                                                           FontSize="11"
                                                           TextColor="#0F172A" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- Hàng 5: Thời điểm gửi + Nút rút đơn (khi còn CHO_DUYET) -->
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                <Label Grid.Column="0"
                                                       Text="{Binding NgayGuiDisplay, StringFormat='Gửi lúc: {0}'}"
                                                       FontFamily="SegoeUI"
                                                       FontSize="10"
                                                       TextColor="#94A3B8"
                                                       VerticalOptions="Center" />
                                                <Button Grid.Column="1"
                                                        Text="Rút đơn"
                                                        IsVisible="{Binding CanWithdraw}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RequestsViewModel}}, Path=WithdrawCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#FEF2F2"
                                                        TextColor="#DC2626"
                                                        BorderColor="#FCA5A5"
                                                        BorderWidth="1"
                                                        CornerRadius="8"
                                                        FontSize="11"
                                                        FontFamily="SegoeUIBold"
                                                        HeightRequest="30"
                                                        Padding="12,0"
                                                        VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

    </Grid>

</ContentPage>
