<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:models="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             xmlns:controls="clr-namespace:OvertimeHotel.HRM.MobileApp.Views.Controls"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.AdminHomePage"
             x:DataType="vm:AdminHomeViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}"
                     RefreshColor="#1E3A8A">
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="20,16,20,32">

                    <!-- ═══ KHỐI 1 · THANH TIÊU ĐỀ & CHUÔNG THÔNG BÁO ═══ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,4">
                        <controls:ProfileHeaderBar x:Name="profileHeaderBar" Grid.Column="0" />

                        <!-- Nút Chuông Thông Báo với Badge -->
                        <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 22"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#E2E8F0"
                                    WidthRequest="40"
                                    HeightRequest="40">
                                <Label Text="🔔"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Border StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#B91C1C"
                                    Stroke="Transparent"
                                    WidthRequest="16"
                                    HeightRequest="16"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="0,0,2,0">
                                <Label Text="1"
                                       TextColor="#FFFFFF"
                                       FontSize="9"
                                       FontFamily="SegoeUIBold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ═══ KHỐI 2 · THẺ PHẠM VI QUẢN TRỊ (HERO NAVY + GOLD) ═══ -->
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="#D4AF37"
                            StrokeThickness="1.5"
                            BackgroundColor="#0B1B4D"
                            Padding="18">
                        <Border.Shadow>
                            <Shadow Brush="#0B1B4D" Offset="0,6" Radius="16" Opacity="0.25" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 24"
                                        Stroke="#D4AF37"
                                        StrokeThickness="1.5"
                                        BackgroundColor="#FFFBEB"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        VerticalOptions="Center">
                                    <Label Text="🛡️"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="BẢNG ĐIỀU HÀNH TỔNG QUẢN LÝ"
                                           TextColor="#FDE047"
                                           FontSize="13"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.8" />
                                    <Label Text="{Binding PermissionLabel}"
                                           TextColor="#93C5FD"
                                           FontSize="10"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.8" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#1E3A8A" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="QUYỀN HẠN"
                                           TextColor="#93C5FD"
                                           FontSize="9"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.8" />
                                    <Label Text="{Binding CommandRole}"
                                           TextColor="#FFFFFF"
                                           FontSize="14"
                                           FontFamily="SegoeUIBold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="PHẠM VI GIÁM SÁT"
                                           TextColor="#93C5FD"
                                           FontSize="9"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.8" />
                                    <Label Text="{Binding CommandScope}"
                                           TextColor="#FFFFFF"
                                           FontSize="14"
                                           FontFamily="SegoeUIBold" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ═══ KHỐI 3 · QUÂN SỐ TOÀN KHÁCH SẠN & TỶ LỆ HIỆN DIỆN HÔM NAY ═══ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Grid.Column="0"
                               Text="QUÂN SỐ &amp; HIỆN DIỆN HÔM NAY"
                               TextColor="#1E3A8A"
                               FontSize="12"
                               FontFamily="SegoeUIBold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding LastUpdatedText}"
                               TextColor="#94A3B8"
                               FontSize="11"
                               FontFamily="SegoeUI"
                               VerticalOptions="Center" />
                    </Grid>

                    <Border Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#FFFFFF"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#0B1B4D" Offset="0,4" Radius="10" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="14">
                            <!-- Hàng Tỷ lệ chính & Trạng thái -->
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="TỶ LỆ CÓ MẶT TOÀN KHÁCH SẠN"
                                           TextColor="#64748B"
                                           FontSize="10"
                                           FontFamily="SegoeUIBold"
                                           CharacterSpacing="0.5" />
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="End">
                                        <Label Text="{Binding AttendanceRateText}"
                                               TextColor="{Binding WorkforceHealthColor}"
                                               FontSize="28"
                                               FontFamily="SegoeUIBold" />
                                        <Label Text="đang trực ca"
                                               TextColor="#64748B"
                                               FontSize="12"
                                               FontFamily="SegoeUI"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{Binding WorkforceHealthBgColor}"
                                        Stroke="Transparent"
                                        Padding="10,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding WorkforceHealthStatus}"
                                           TextColor="{Binding WorkforceHealthColor}"
                                           FontSize="10"
                                           FontFamily="SegoeUIBold" />
                                </Border>
                            </Grid>

                            <!-- Thanh Progress Bar hiện diện -->
                            <ProgressBar Progress="{Binding AttendanceProgress}"
                                         ProgressColor="{Binding WorkforceHealthColor}"
                                         HeightRequest="6" />

                            <!-- 3 Ô Chỉ số Tổng quan -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Tổng quân số" TextColor="#64748B" FontSize="10" FontFamily="SegoeUI" />
                                        <Label Text="{Binding TotalStaffCount}" TextColor="#0F172A" FontSize="18" FontFamily="SegoeUIBold" />
                                        <Label Text="Nhân sự" TextColor="#94A3B8" FontSize="9" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#F0FDF4"
                                        Stroke="#DCFCE7"
                                        Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Đang trực ca" TextColor="#15803D" FontSize="10" FontFamily="SegoeUIBold" />
                                        <Label Text="{Binding PresentStaffCount}" TextColor="#15803D" FontSize="18" FontFamily="SegoeUIBold" />
                                        <Label Text="Có mặt" TextColor="#16A34A" FontSize="9" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#FEF3C7"
                                        Stroke="#FDE68A"
                                        Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Nghỉ phép" TextColor="#B45309" FontSize="10" FontFamily="SegoeUIBold" />
                                        <Label Text="{Binding OnLeaveStaffCount}" TextColor="#B45309" FontSize="18" FontFamily="SegoeUIBold" />
                                        <Label Text="Đã duyệt" TextColor="#D97706" FontSize="9" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <!-- Phân bổ theo 3 khối trọng điểm -->
                            <Label Text="TỶ LỆ LẤP ĐẦY THEO KHỐI VẬN HÀNH"
                                   TextColor="#1E3A8A"
                                   FontSize="11"
                                   FontFamily="SegoeUIBold"
                                   CharacterSpacing="0.4" />

                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding DepartmentClusters}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:AdminDepartmentWorkforceItem">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding Icon}" FontSize="16" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                <Label Text="{Binding ClusterName}" TextColor="#0F172A" FontSize="12" FontFamily="SegoeUIBold" />
                                                <Label Text="{Binding DepartmentScope}" TextColor="#64748B" FontSize="10" FontFamily="SegoeUI" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding RateText}" TextColor="{Binding StatusColor}" FontSize="12" FontFamily="SegoeUIBold" HorizontalTextAlignment="End" />
                                                <Label Text="{Binding RatioText}" TextColor="#94A3B8" FontSize="10" HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ═══ KHỐI 4 · TIẾN ĐỘ QUỸ LƯƠNG & KHÓA SỔ KỲ LƯƠNG (PRD 02 & 05) ═══ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0" IsVisible="{Binding CanViewPayroll}">
                        <Label Grid.Column="0"
                               Text="QUỸ LƯƠNG 5 THÁNG GẦN ĐÂY"
                               TextColor="#1E3A8A"
                               FontSize="12"
                               FontFamily="SegoeUIBold"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="Thẩm quyền BOD"
                               TextColor="#D4AF37"
                               FontSize="11"
                               FontFamily="SegoeUIBold"
                               VerticalOptions="Center" />
                    </Grid>

                    <Border Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#FFFFFF"
                            Padding="16" IsVisible="{Binding CanViewPayroll}">
                        <Border.Shadow>
                            <Shadow Brush="#0B1B4D" Offset="0,4" Radius="10" Opacity="0.04" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                           

                            <!-- Danh sách quỹ lương 5 tháng gần đây -->
                            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RecentMonthsPayroll}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:AdminRecentMonthPayrollItem">
                                        <Border Stroke="#F1F5F9"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="#F8FAFC"
                                                Padding="12,10">
                                            <VerticalStackLayout Spacing="6">
                                                <!-- Hàng 1: Tháng + Badge trạng thái -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                        <Label Text="📅" FontSize="12" VerticalOptions="Center" />
                                                        <Label Text="{Binding MonthName}"
                                                               TextColor="#0F172A"
                                                               FontSize="13"
                                                               FontFamily="SegoeUIBold"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                    <Border Grid.Column="1"
                                                            StrokeShape="RoundRectangle 6"
                                                            BackgroundColor="{Binding StatusBgColor}"
                                                            Stroke="Transparent"
                                                            Padding="8,2"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding StatusText}"
                                                               TextColor="{Binding StatusTextColor}"
                                                               FontSize="10"
                                                               FontFamily="SegoeUIBold" />
                                                    </Border>
                                                </Grid>

                                                <!-- Hàng 2: Tổng chi trả & Số phiếu -->
                                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding TotalPayoutText}"
                                                           TextColor="#1E3A8A"
                                                           FontSize="15"
                                                           FontFamily="SegoeUIBold" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding SubtitleText}"
                                                           TextColor="#64748B"
                                                           FontSize="11"
                                                           FontFamily="SegoeUI"
                                                           VerticalOptions="Center" />
                                                </Grid>

                                                <!-- Hàng 3: Thanh so sánh trực quan -->
                                                <ProgressBar Progress="{Binding BarProgress}"
                                                             ProgressColor="{Binding BarColor}"
                                                             HeightRequest="4" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ═══ KHỐI 5 · SỰ KIỆN TRỌNG ĐIỂM & TASK FORCE (PRD 02 Mục 9.0) ═══ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Grid.Column="0"
                               Text="SỰ KIỆN TRỌNG ĐIỂM &amp; TASK FORCE"
                               TextColor="#1E3A8A"
                               FontSize="12"
                               FontFamily="SegoeUIBold"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#EFF6FF"
                                Stroke="Transparent"
                                Padding="8,2"
                                VerticalOptions="Center">
                            <Label Text="{Binding ActiveEventsCountText}"
                                   TextColor="#1D4ED8"
                                   FontSize="10"
                                   FontFamily="SegoeUIBold" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding HasHotelEvents}" Spacing="10" BindableLayout.ItemsSource="{Binding HotelEvents}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AdminHotelEventItem">
                                <Border Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="#FFFFFF"
                                        Padding="14">
                                    <Border.Shadow>
                                        <Shadow Brush="#0B1B4D" Offset="0,4" Radius="10" Opacity="0.04" />
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Header thẻ sự kiện: Loại hình + Trạng thái -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{Binding TypeBgColor}"
                                                    Padding="6,2">
                                                <Label Text="{Binding EventType}"
                                                       TextColor="{Binding TypeTextColor}"
                                                       FontSize="9"
                                                       FontFamily="SegoeUIBold" />
                                            </Border>
                                            <Border Grid.Column="2"
                                                    StrokeShape="RoundRectangle 6"
                                                    BackgroundColor="{Binding StatusBgColor}"
                                                    Padding="6,2">
                                                <Label Text="{Binding StatusText}"
                                                       TextColor="{Binding StatusTextColor}"
                                                       FontSize="9"
                                                       FontFamily="SegoeUIBold" />
                                            </Border>
                                        </Grid>

                                        <!-- Tên sự kiện & Địa điểm -->
                                        <Label Text="{Binding EventName}"
                                               TextColor="#0F172A"
                                               FontSize="13"
                                               FontFamily="SegoeUIBold"
                                               LineBreakMode="WordWrap" />

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="📍" FontSize="11" />
                                            <Label Text="{Binding Location}" TextColor="#475569" FontSize="11" FontFamily="SegoeUI" />
                                            <Label Text="·" TextColor="#CBD5E1" FontSize="11" />
                                            <Label Text="{Binding TimeRangeText}" TextColor="#64748B" FontSize="11" FontFamily="SegoeUI" />
                                        </HorizontalStackLayout>

                                        <!-- Chỉ số điều phối Task Force -->
                                        <Border StrokeShape="RoundRectangle 10"
                                                BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                Padding="10,6">
                                            <Grid ColumnDefinitions="*,*">
                                                <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                                    <Label Text="👥" FontSize="11" />
                                                    <Label Text="{Binding ExpectedGuests, StringFormat='Quy mô: {0} khách'}"
                                                           TextColor="#475569"
                                                           FontSize="11"
                                                           FontFamily="SegoeUIBold" />
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                                                    <Label Text="⚡" FontSize="11" />
                                                    <Label Text="{Binding TaskForceStaffCount, StringFormat='Task Force: {0} NS'}"
                                                           TextColor="#1E3A8A"
                                                           FontSize="11"
                                                           FontFamily="SegoeUIBold" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>

                                        <Label Text="{Binding TaskForceDetail}"
                                               TextColor="#64748B"
                                               FontSize="11"
                                               FontFamily="SegoeUI"
                                               LineBreakMode="WordWrap" />

                                        <!-- Nút xem chi tiết sự kiện -->
                                        <Button Text="Xem chi tiết điều động Task Force"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminHomeViewModel}}, Path=OpenEventDetailCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F1F5F9"
                                                TextColor="#1E3A8A"
                                                BorderColor="#CBD5E1"
                                                BorderWidth="1"
                                                FontFamily="SegoeUIBold"
                                                FontSize="11"
                                                HeightRequest="36"
                                                CornerRadius="8" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Thẻ trạng thái trung thực khi không có sự kiện tiệc/hội nghị lớn trong DB (Phương án A) -->
                    <Border IsVisible="{Binding HasNoHotelEvents}"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#FFFFFF"
                            Padding="16">
                        <Border.Shadow>
                            <Shadow Brush="#0B1B4D" Offset="0,4" Radius="10" Opacity="0.04" />
                        </Border.Shadow>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 20"
                                    BackgroundColor="#F0FDF4"
                                    Stroke="#DCFCE7"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    VerticalOptions="Center">
                                <Label Text="📋" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="Hôm nay không có sự kiện tiệc / hội nghị lớn"
                                       TextColor="#0F172A"
                                       FontSize="13"
                                       FontFamily="SegoeUIBold"
                                       LineBreakMode="WordWrap" />
                                <Label Text="Toàn bộ nhân sự các khối đang tập trung phục vụ vận hành thường nhật."
                                       TextColor="#64748B"
                                       FontSize="11"
                                       FontFamily="SegoeUI"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>                   

                    <!-- ═══ KHỐI 7 · HOẠT ĐỘNG GẦN ĐÂY (AUDIT LOG SNIPPET) ═══ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Grid.Column="0"
                               Text="HOẠT ĐỘNG GẦN ĐÂY"
                               TextColor="#1E3A8A"
                               FontSize="12"
                               FontFamily="SegoeUIBold"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Xem tất cả >"
                                Command="{Binding OpenAuditLogsCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#1E3A8A"
                                FontSize="12"
                                FontFamily="SegoeUIBold"
                                HeightRequest="32"
                                Padding="4,0" />
                    </Grid>

                    <Border Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#FFFFFF"
                            Padding="14">
                        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding RecentActivities}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AdminAuditLogItem">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 6"
                                                BackgroundColor="{Binding BadgeColor}"
                                                Padding="6,2"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding ActionName}"
                                                   TextColor="{Binding BadgeTextColor}"
                                                   FontSize="10"
                                                   FontFamily="SegoeUIBold" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Description}"
                                                   TextColor="#0F172A"
                                                   FontSize="12"
                                                   FontFamily="SegoeUI"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding FormattedTime}"
                                                   TextColor="#94A3B8"
                                                   FontSize="10"
                                                   FontFamily="SegoeUI" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ═══ KHỐI 8 · CẦU NỐI QUẢN TRỊ TRÊN MÁY TÍNH (DESKTOP BRIDGE) ═══ -->
                    <Border Stroke="#CBD5E1"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#F1F5F9"
                            Padding="16"
                            Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="🖥️" FontSize="14" />
                                <Label Text="TÁC VỤ QUẢN TRỊ TRÊN MÁY TÍNH"
                                       TextColor="#1E3A8A"
                                       FontSize="12"
                                       FontFamily="SegoeUIBold" />
                            </HorizontalStackLayout>
                            <Label Text="Các tác vụ cấu hình lương 4 nhóm, phân quyền 17 mã chức năng và sao lưu/khôi phục dữ liệu cần thực hiện trên máy tính để đảm bảo an toàn."
                                   TextColor="#475569"
                                   FontSize="12"
                                   FontFamily="SegoeUI"
                                   LineBreakMode="WordWrap" />
                            <Button Text="Mở thông tin cổng Web Admin"
                                    Command="{Binding OpenDesktopWebCommand}"
                                    BackgroundColor="#1E3A8A"
                                    TextColor="#FFFFFF"
                                    FontFamily="SegoeUIBold"
                                    FontSize="12"
                                    HeightRequest="38"
                                    CornerRadius="10"
                                    HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Popup thông báo chung -->
        <controls:LuxuryPopup x:Name="popup" ZIndex="999" />
    </Grid>

</ContentPage>
