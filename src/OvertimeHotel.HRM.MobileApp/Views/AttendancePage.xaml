<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:models="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.AttendancePage"
             x:DataType="vm:AttendanceViewModel"
             x:Name="attendancePage"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- ==================== NỘI DUNG CHÍNH ==================== -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="pageBody" Spacing="16" Padding="20,0,20,32">

                <!-- HEADER: TIÊU ĐỀ & HUY HIỆU KHÁCH SẠN -->
                <Grid x:Name="pageHeader" Opacity="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Chấm Công"
                           FontFamily="SegoeUIBold"
                           FontSize="18"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Image Grid.Column="1"
                           Source="brand_mark_light.png"
                           WidthRequest="28"
                           HeightRequest="28"
                           Aspect="AspectFit"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Huy hiệu The OverTime Hotel" />
                </Grid>

                <!-- SKELETON SHIMMER KHI ĐANG TẢI (thay cho ActivityIndicator) -->
                <VerticalStackLayout x:Name="skeletonLayout" Spacing="14" IsVisible="{Binding IsLoading}">
                    <Border StrokeShape="RoundRectangle 20" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <BoxView HeightRequest="14" WidthRequest="120" Color="#E2E8F0" HorizontalOptions="Start" />
                            <BoxView HeightRequest="30" WidthRequest="200" Color="#E2E8F0" HorizontalOptions="Start" />
                            <BoxView HeightRequest="14" WidthRequest="160" Color="#E2E8F0" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <Border StrokeShape="RoundRectangle 20" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <BoxView HeightRequest="56" Color="#E2E8F0" />
                            <BoxView HeightRequest="14" WidthRequest="180" Color="#E2E8F0" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border StrokeShape="RoundRectangle 20" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="18">
                        <VerticalStackLayout Spacing="10">
                            <BoxView HeightRequest="12" Color="#E2E8F0" />
                            <BoxView HeightRequest="12" Color="#E2E8F0" />
                            <BoxView HeightRequest="12" Color="#E2E8F0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== LỐI TẮT NHANH 2 CỘT (LỊCH CA & PHIẾU LƯƠNG) ==================== -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Lịch ca 24/7 -->
                    <Border Grid.Column="0"
                            Stroke="#1E3A8A"
                            BackgroundColor="#1E3A8A"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScheduleTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="📅"
                                       FontSize="18"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Text="LỊCH CA 24/7"
                                   FontFamily="SegoeUIBold"
                                   FontSize="13"
                                   TextColor="#FFFFFF" />
                            <Label Text="Xem ca theo tuần"
                                   FontFamily="SegoeUI"
                                   FontSize="10"
                                   TextColor="#DBEAFE" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Phiếu Lương -->
                    <Border Grid.Column="1"
                            Stroke="#1E3A8A"
                            BackgroundColor="#1E3A8A"
                            StrokeShape="RoundRectangle 16"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPayslipTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="💰"
                                       FontSize="18"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Text="PHIẾU LƯƠNG"
                                   FontFamily="SegoeUIBold"
                                   FontSize="13"
                                   TextColor="#FFFFFF" />
                            <Label Text="Thu nhập hàng tháng"
                                   FontFamily="SegoeUI"
                                   FontSize="10"
                                   TextColor="#DBEAFE" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ============ THẺ CA LÀM VIỆC & QUẸT THẺ HỢP NHẤT (HERO CARD) ============ -->
                <Border x:Name="shiftCard"
                        Opacity="0"
                        IsVisible="{Binding HasShiftToday}"
                        StrokeShape="RoundRectangle 22"
                        Stroke="#D4AF37"
                        StrokeThickness="1.5"
                        BackgroundColor="#FFFFFF"
                        Padding="18,18,18,16">
                    <VerticalStackLayout Spacing="14">

                        <!-- Hàng tiêu đề ca & huy hiệu trạng thái -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding ShiftName}"
                                   FontFamily="SegoeUIBold"
                                   FontSize="16"
                                   TextColor="#0F172A"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding StatusBgColor}"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="12,5"
                                    VerticalOptions="Center">
                                <Label Text="{Binding StatusText}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="10"
                                       CharacterSpacing="1.2"
                                       TextColor="{Binding StatusTextColor}" />
                            </Border>
                        </Grid>

                        <!-- Khung giờ ca -->
                        <Label Text="{Binding ShiftTimeText}"
                               FontFamily="SegoeUIBold"
                               FontSize="26"
                               TextColor="#1E3A8A"
                               HorizontalOptions="Center" />

                        <!-- Khung sự kiện trong ca (nếu có) -->
                        <Border IsVisible="{Binding HasEventToday}"
                                Stroke="#FDE047"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#FEFCE8"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="★"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding EventTitle}"
                                           FontFamily="SegoeUIBold"
                                           FontSize="13"
                                           TextColor="#854D0E" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding EventRoleText}"
                                               FontFamily="SegoeUI"
                                               FontSize="11"
                                               TextColor="#A16207" />
                                        <Label Grid.Column="1"
                                               Text="{Binding EventHoursText}"
                                               FontFamily="SegoeUIBold"
                                               FontSize="11"
                                               TextColor="#B45309" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Hai ô giờ vào / giờ ra -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="14,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="VÀO CA" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="1.2" TextColor="#94A3B8" HorizontalOptions="Center" />
                                    <Label Text="{Binding CheckInTimeText}" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="14,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="RA CA" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="1.2" TextColor="#94A3B8" HorizontalOptions="Center" />
                                    <Label Text="{Binding CheckOutTimeText}" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Ba chỉ số đối soát: đi trễ / về sớm / OT -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="ĐI TRỄ" FontFamily="SegoeUI" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center" />
                                <Label Text="{Binding PhutDiTreText}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#B45309" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="VỀ SỚM" FontFamily="SegoeUI" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center" />
                                <Label Text="{Binding PhutVeSomText}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#1D4ED8" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="LÀM THÊM" FontFamily="SegoeUI" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center" />
                                <Label Text="{Binding GioOtText}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#059669" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Vùng nút quẹt thẻ tích hợp -->
                        <VerticalStackLayout Spacing="8">
                            <Button x:Name="btnPunch"
                                    Text="{Binding ActionButtonText}"
                                    Clicked="OnPunchClicked"
                                    FontFamily="SegoeUIBold"
                                    FontSize="16"
                                    CharacterSpacing="1.5"
                                    TextColor="White"
                                    BackgroundColor="{Binding ActionButtonColor}"
                                    BorderWidth="0"
                                    CornerRadius="16"
                                    HeightRequest="56"
                                    IsEnabled="{Binding CanPunchCard}" />

                            <Label x:Name="lblPunchHint"
                                   Text="Chạm để quẹt thẻ vào ca"
                                   FontFamily="SegoeUI"
                                   FontSize="11"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ THÔNG BÁO KHÔNG CÓ CA ============ -->
                <Border x:Name="noShiftCard"
                        Opacity="0"
                        IsVisible="{Binding HasNoShiftToday}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#E2E8F0"
                        BackgroundColor="#FFFFFF"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="○" FontFamily="SegoeUIBold" FontSize="30" TextColor="#94A3B8" HorizontalOptions="Center" />
                        <Label Text="{Binding ShiftName}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#0F172A" HorizontalOptions="Center" />
                        <Label Text="{Binding ShiftTimeText}" FontFamily="SegoeUI" FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ THANH TIÊU ĐỀ LỊCH SỬ CHẤM CÔNG VÀ NÚT THU GỌN / MỞ RỘNG ============ -->
                <Grid Margin="0,8,0,2" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📅" FontSize="14" VerticalOptions="Center" />
                        <Label Text="LỊCH SỬ CHẤM CÔNG" FontFamily="SegoeUIBold" FontSize="13" TextColor="#1E3A8A" CharacterSpacing="0.8" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Nút bấm Thu gọn / Mở rộng -->
                    <Border Grid.Column="1" Stroke="#BFDBFE" BackgroundColor="#EFF6FF" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="10,5" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleHistoryCollapseCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="{Binding CollapseToggleText}" FontFamily="SegoeUIBold" FontSize="11" TextColor="#1E3A8A" VerticalOptions="Center" />
                            <Label Text="{Binding CollapseToggleIcon}" FontSize="10" TextColor="#1E3A8A" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- ============ CHẾ ĐỘ THU GỌN: CHỈ HIỂN THỊ CA NGÀY HÔM NAY ============ -->
                <Border x:Name="todayCard"
                        Opacity="0"
                        IsVisible="{Binding IsHistoryCollapsed}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#E2E8F0"
                        BackgroundColor="#FFFFFF"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="Hôm nay" FontFamily="SegoeUIBold" FontSize="14" TextColor="#0F172A" />
                                <Label Text="•" TextColor="#94A3B8" FontSize="13" />
                                <Label Text="{Binding TodayDateText}" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Badge trạng thái ca hôm nay -->
                            <Border Grid.Column="1" BackgroundColor="{Binding TodayRecord.TrangThaiBgColor}"
                                    Stroke="Transparent" StrokeShape="RoundRectangle 10" Padding="8,3" VerticalOptions="Center">
                                <Label Text="{Binding TodayRecord.TrangThaiText}" FontFamily="SegoeUIBold"
                                       FontSize="11" TextColor="{Binding TodayRecord.TrangThaiTextColor}" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Tên ca và giờ quẹt thẻ thực tế hôm nay -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TodayRecord.TenCa}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" />
                                <Label Text="Ca làm việc hôm nay" FontSize="11" TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="8,4">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="VÀO CA" FontSize="9" TextColor="#64748B" FontFamily="SegoeUIBold" />
                                    <Label Text="{Binding TodayRecord.CheckInText}" FontSize="12" TextColor="#0F172A" FontFamily="SegoeUIBold" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="8,4">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="RA CA" FontSize="9" TextColor="#64748B" FontFamily="SegoeUIBold" />
                                    <Label Text="{Binding TodayRecord.CheckOutText}" FontSize="12" TextColor="#0F172A" FontFamily="SegoeUIBold" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Chạm để xem chi tiết giờ quẹt thẻ popup -->
                        <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 10" Padding="10,7" Margin="0,2,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowDetailCommand}" CommandParameter="{Binding TodayRecord}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Xem chi tiết thời gian &amp; đối soát giờ công"
                                       FontSize="11" TextColor="#1E3A8A" FontFamily="SegoeUIBold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="›" FontSize="14" TextColor="#1E3A8A" FontFamily="SegoeUIBold" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Nút mở rộng xem toàn bộ tháng -->
                        <Button Text="▼ Mở rộng xem toàn bộ lịch sử tháng"
                                Command="{Binding ToggleHistoryCollapseCommand}"
                                BackgroundColor="#EFF6FF" TextColor="#1E3A8A" FontFamily="SegoeUIBold"
                                FontSize="12" CornerRadius="12" HeightRequest="40" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ LỊCH SỬ CHẤM CÔNG THÁNG (KHI MỞ RỘNG) ============ -->
                <Grid x:Name="historySection" Opacity="0" IsVisible="{Binding IsHistoryExpanded}"
                      ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                    <Button Grid.Column="0"
                            Text="‹"
                            Clicked="OnPreviousMonthClicked"
                            FontFamily="SegoeUIBold"
                            FontSize="18"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1E3A8A"
                            BorderColor="#BFDBFE"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="34"
                            WidthRequest="38" />

                    <Label Grid.Column="1"
                           Text="{Binding MonthLabel}"
                           FontFamily="SegoeUIBold"
                           FontSize="14"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Button Grid.Column="2"
                            Text="›"
                            Clicked="OnNextMonthClicked"
                            FontFamily="SegoeUIBold"
                            FontSize="18"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1E3A8A"
                            BorderColor="#BFDBFE"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="34"
                            WidthRequest="38" />
                </Grid>

                <Border x:Name="historyCard"
                        Opacity="0"
                        IsVisible="{Binding IsHistoryExpanded}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#E2E8F0"
                        BackgroundColor="#FFFFFF">
                    <VerticalStackLayout>
                        <!-- BỘ LỌC TRẠNG THÁI: 4 nút chia đều, kèm số ngày khớp.
                             BindableLayout chèn từng Border vào Grid theo thứ tự nên mỗi
                             nút tự khai báo Grid.Column qua thuộc tính ColumnIndex. -->
                        <Grid ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="6"
                              Padding="12,12,12,6"
                              BindableLayout.ItemsSource="{Binding StatusFilters}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AttendanceStatusFilter">
                                    <Border Grid.Column="{Binding ColumnIndex}"
                                            BackgroundColor="{Binding BackgroundColor}"
                                            Stroke="{Binding BorderColor}"
                                            StrokeThickness="{Binding BorderWidth}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="4,7">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceViewModel}}, Path=FilterStatusCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="{Binding NameFontFamily}"
                                                   FontSize="10"
                                                   CharacterSpacing="0.4"
                                                   TextColor="{Binding TextColor}"
                                                   HorizontalOptions="Center"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Count}"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="16"
                                                   TextColor="{Binding CountColor}"
                                                   HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <CollectionView ItemsSource="{Binding MonthlyRecords}"
                                    IsVisible="{Binding HasMonthlyRecords}"
                                    SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:AttendanceRecord">
                                    <Border BackgroundColor="Transparent"
                                            Stroke="#F1F5F9"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Margin="10,3"
                                            Padding="12,9">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceViewModel}}, Path=ShowDetailCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0"
                                                   Text="📅"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />

                                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                <Label Text="{Binding NgayLamViec}"
                                                       FontFamily="SegoeUIBold"
                                                       FontSize="13"
                                                       TextColor="#0F172A" />
                                                <Label Text="{Binding TenCa}"
                                                       FontFamily="SegoeUI"
                                                       FontSize="11"
                                                       TextColor="#64748B"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="2"
                                                    BackgroundColor="{Binding TrangThaiBgColor}"
                                                    Stroke="Transparent"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    Padding="8,3"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding TrangThaiText}"
                                                       FontFamily="SegoeUIBold"
                                                       FontSize="10"
                                                       CharacterSpacing="0.4"
                                                       TextColor="{Binding TrangThaiTextColor}" />
                                            </Border>

                                            <Label Grid.Column="3"
                                                   Text="›"
                                                   FontFamily="SegoeUIBold"
                                                   FontSize="18"
                                                   TextColor="#94A3B8"
                                                   VerticalOptions="Center"
                                                   Margin="2,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="{Binding HistoryEmptyMessage}"
                               IsVisible="{Binding HasNoMonthlyRecords}"
                               FontFamily="SegoeUI"
                               FontSize="12"
                               TextColor="#94A3B8"
                               Padding="16,24"
                               HorizontalOptions="Center" />

                        <!-- Nút thu gọn lại chế độ chỉ hiện hôm nay -->
                        <Button Text="▲ Thu gọn danh sách (Chỉ hiện hôm nay)"
                                Command="{Binding ToggleHistoryCollapseCommand}"
                                BackgroundColor="#F8FAFC" TextColor="#1E3A8A" FontFamily="SegoeUIBold"
                                FontSize="12" CornerRadius="12" HeightRequest="40" Margin="12,6,12,12" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== CUSTOM MODAL POPUP (không dùng DisplayAlert) ==================== -->
        <Grid x:Name="popupOverlay"
              Grid.Row="0"
              IsVisible="{Binding IsPopupVisible}"
              InputTransparent="True"
              Opacity="0"
              BackgroundColor="#660F172A">
            <Border x:Name="popupCard"
                    WidthRequest="290"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="#FFFFFF"
                    Stroke="{Binding PopupBorderColor}"
                    StrokeThickness="1.5"
                    Padding="22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <Border x:Name="popupIconBox"
                            WidthRequest="54"
                            HeightRequest="54"
                            BackgroundColor="{Binding PopupIconBgColor}"
                            Stroke="{Binding PopupBorderColor}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 27"
                            HorizontalOptions="Center">
                        <Label Text="{Binding PopupIconText}"
                               FontFamily="SegoeUIBold"
                               FontSize="24"
                               TextColor="{Binding PopupIconTextColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="{Binding PopupTitle}"
                           FontFamily="SegoeUIBold"
                           FontSize="19"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding PopupMessage}"
                           FontFamily="SegoeUI"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="#475569"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Button Text="{Binding PopupButtonText}"
                            Clicked="OnPopupConfirmClicked"
                            FontFamily="SegoeUIBold"
                            FontSize="13"
                            CharacterSpacing="1.2"
                            TextColor="White"
                            BackgroundColor="#1E3A8A"
                            BorderColor="#D4AF37"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="48"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== POPUP XEM CHI TIẾT GIỜ CHẤM CÔNG ==================== -->
        <Grid x:Name="detailPopupOverlay"
              Grid.Row="0"
              IsVisible="{Binding IsDetailPopupVisible}"
              InputTransparent="True"
              Opacity="0"
              BackgroundColor="#660F172A">
            <Border x:Name="detailPopupCard"
                    WidthRequest="310"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="#FFFFFF"
                    Stroke="#D4AF37"
                    StrokeThickness="1.5"
                    Padding="22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <!-- Biểu tượng -->
                    <Border WidthRequest="52"
                            HeightRequest="52"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 26"
                            HorizontalOptions="Center">
                        <Label Text="📋"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Tiêu đề & Ngày/Ca -->
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Chi Tiết Giờ Chấm Công"
                               FontFamily="SegoeUIBold"
                               FontSize="17"
                               TextColor="#0F172A"
                               HorizontalOptions="Center" />
                        <Label FontFamily="SegoeUI"
                               FontSize="12"
                               TextColor="#64748B"
                               HorizontalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SelectedRecord.NgayLamViec}" FontAttributes="Bold" TextColor="#1E3A8A" />
                                    <Span Text="  ·  " />
                                    <Span Text="{Binding SelectedRecord.TenCa}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Huy hiệu trạng thái -->
                    <Border BackgroundColor="{Binding SelectedRecord.TrangThaiBgColor}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,5"
                            HorizontalOptions="Center">
                        <Label Text="{Binding SelectedRecord.TrangThaiText}"
                               FontFamily="SegoeUIBold"
                               FontSize="10"
                               CharacterSpacing="0.6"
                               TextColor="{Binding SelectedRecord.TrangThaiTextColor}" />
                    </Border>

                    <!-- Khung giờ Vào - Ra -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Giờ vào -->
                        <Border Grid.Column="0"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,12">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="GIỜ VÀO"
                                       FontFamily="SegoeUIBold"
                                       FontSize="10"
                                       CharacterSpacing="0.8"
                                       TextColor="#059669"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.CheckInText}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#0F172A"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Giờ ra -->
                        <Border Grid.Column="1"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,12">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="GIỜ RA"
                                       FontFamily="SegoeUIBold"
                                       FontSize="10"
                                       CharacterSpacing="0.8"
                                       TextColor="#DC2626"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.CheckOutText}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#0F172A"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Khung thông số phụ: Đi trễ, Về sớm, Giờ OT -->
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,10">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                <Label Text="ĐI TRỄ" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="0.5" TextColor="#64748B" HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.PhutDiTreText}" FontFamily="SegoeUIBold" FontSize="11" TextColor="#D97706" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                <Label Text="VỀ SỚM" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="0.5" TextColor="#64748B" HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.PhutVeSomText}" FontFamily="SegoeUIBold" FontSize="11" TextColor="#D97706" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                <Label Text="LÀM THÊM" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="0.5" TextColor="#64748B" HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.GioOtText}" FontFamily="SegoeUIBold" FontSize="11" TextColor="#2563EB" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Nút Đóng -->
                    <Button Text="ĐÓNG"
                            Clicked="OnCloseDetailPopupClicked"
                            FontFamily="SegoeUIBold"
                            FontSize="13"
                            CharacterSpacing="1.2"
                            TextColor="White"
                            BackgroundColor="#1E3A8A"
                            BorderColor="#D4AF37"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="46"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>