<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:models="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.AttendancePage"
             x:DataType="vm:AttendanceViewModel"
             x:Name="attendancePage"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- ==================== NỘI DUNG CHÍNH ==================== -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout x:Name="pageBody" Spacing="16" Padding="20,0,20,32">

                <!-- HEADER: TIÊU ĐỀ & HUY HIỆU KHÁCH SẠN -->
                <Grid x:Name="pageHeader" Opacity="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Grid.Column="0"
                           Text="Chấm Công"
                           FontFamily="SegoeUIBold"
                           FontSize="18"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

                    <Image Grid.Column="1"
                           Source="brand_mark_light.png"
                           WidthRequest="28"
                           HeightRequest="28"
                           Aspect="AspectFit"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Huy hiệu The OverTime Hotel" />
                </Grid>

                <!-- SKELETON SHIMMER KHI ĐANG TẢI (thay cho ActivityIndicator) -->
                <VerticalStackLayout x:Name="skeletonLayout" Spacing="14" IsVisible="{Binding IsLoading}">
                    <Border StrokeShape="RoundRectangle 20" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <BoxView HeightRequest="14" WidthRequest="120" Color="#E2E8F0" HorizontalOptions="Start" />
                            <BoxView HeightRequest="30" WidthRequest="200" Color="#E2E8F0" HorizontalOptions="Start" />
                            <BoxView HeightRequest="14" WidthRequest="160" Color="#E2E8F0" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>
                    <Border StrokeShape="RoundRectangle 20" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="18">
                        <VerticalStackLayout Spacing="12">
                            <BoxView HeightRequest="56" Color="#E2E8F0" />
                            <BoxView HeightRequest="14" WidthRequest="180" Color="#E2E8F0" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border StrokeShape="RoundRectangle 20" Stroke="#E2E8F0" BackgroundColor="#FFFFFF" Padding="18">
                        <VerticalStackLayout Spacing="10">
                            <BoxView HeightRequest="12" Color="#E2E8F0" />
                            <BoxView HeightRequest="12" Color="#E2E8F0" />
                            <BoxView HeightRequest="12" Color="#E2E8F0" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ==================== LỐI TẮT NHANH 3 CỘT (LỊCH CA, BẢNG CÔNG, PHIẾU LƯƠNG) ==================== -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <!-- Lịch ca 24/7 -->
                    <Border Grid.Column="0"
                            Stroke="#1E3A8A"
                            BackgroundColor="#1E3A8A"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnScheduleTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="📅"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontFamily="SegoeUIBold"
                                       FontSize="16"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Text="LỊCH CA 24/7"
                                   FontFamily="SegoeUIBold"
                                   FontSize="11"
                                   TextColor="#FFFFFF" />
                            <Label Text="Xem ca tuần"
                                   FontFamily="SegoeUI"
                                   FontSize="9"
                                   TextColor="#DBEAFE" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Bảng công tháng -->
                    <Border Grid.Column="1"
                            Stroke="#1E3A8A"
                            BackgroundColor="#1E3A8A"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttendanceSummaryTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="📊"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontFamily="SegoeUIBold"
                                       FontSize="16"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Text="BẢNG CÔNG"
                                   FontFamily="SegoeUIBold"
                                   FontSize="11"
                                   TextColor="#FFFFFF" />
                            <Label Text="Theo tháng"
                                   FontFamily="SegoeUI"
                                   FontSize="9"
                                   TextColor="#DBEAFE" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Phiếu Lương -->
                    <Border Grid.Column="2"
                            Stroke="#1E3A8A"
                            BackgroundColor="#1E3A8A"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPayslipTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="💰"
                                       FontSize="16"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="›"
                                       FontFamily="SegoeUIBold"
                                       FontSize="16"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Label Text="PHIẾU LƯƠNG"
                                   FontFamily="SegoeUIBold"
                                   FontSize="11"
                                   TextColor="#FFFFFF" />
                            <Label Text="Thu nhập tháng"
                                   FontFamily="SegoeUI"
                                   FontSize="9"
                                   TextColor="#DBEAFE" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ============ THẺ CA LÀM VIỆC & QUẸT THẺ HỢP NHẤT (HERO CARD) ============ -->
                <Border x:Name="shiftCard"
                        Opacity="0"
                        IsVisible="{Binding HasShiftToday}"
                        StrokeShape="RoundRectangle 22"
                        Stroke="#D4AF37"
                        StrokeThickness="1.5"
                        BackgroundColor="#FFFFFF"
                        Padding="18,18,18,16">
                    <VerticalStackLayout Spacing="14">

                        <!-- Hàng tiêu đề ca & huy hiệu trạng thái -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding ShiftName}"
                                   FontFamily="SegoeUIBold"
                                   FontSize="16"
                                   TextColor="#0F172A"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    BackgroundColor="{Binding StatusBgColor}"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="12,5"
                                    VerticalOptions="Center">
                                <Label Text="{Binding StatusText}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="10"
                                       CharacterSpacing="1.2"
                                       TextColor="{Binding StatusTextColor}" />
                            </Border>
                        </Grid>

                        <!-- Khung giờ ca -->
                        <Label Text="{Binding ShiftTimeText}"
                               FontFamily="SegoeUIBold"
                               FontSize="26"
                               TextColor="#1E3A8A"
                               HorizontalOptions="Center" />

                        <!-- Khung sự kiện trong ca (nếu có) -->
                        <Border IsVisible="{Binding HasEventToday}"
                                Stroke="#FDE047"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#FEFCE8"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="★"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#D4AF37"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding EventTitle}"
                                           FontFamily="SegoeUIBold"
                                           FontSize="13"
                                           TextColor="#854D0E" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding EventRoleText}"
                                               FontFamily="SegoeUI"
                                               FontSize="11"
                                               TextColor="#A16207" />
                                        <Label Grid.Column="1"
                                               Text="{Binding EventHoursText}"
                                               FontFamily="SegoeUIBold"
                                               FontSize="11"
                                               TextColor="#B45309" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Hai ô giờ vào / giờ ra -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 16" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="14,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="VÀO CA" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="1.2" TextColor="#94A3B8" HorizontalOptions="Center" />
                                    <Label Text="{Binding CheckInTimeText}" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 16" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="14,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="RA CA" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="1.2" TextColor="#94A3B8" HorizontalOptions="Center" />
                                    <Label Text="{Binding CheckOutTimeText}" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Ba chỉ số đối soát: đi trễ / về sớm / OT -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="ĐI TRỄ" FontFamily="SegoeUI" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center" />
                                <Label Text="{Binding PhutDiTreText}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#B45309" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="VỀ SỚM" FontFamily="SegoeUI" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center" />
                                <Label Text="{Binding PhutVeSomText}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#1D4ED8" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="LÀM THÊM" FontFamily="SegoeUI" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center" />
                                <Label Text="{Binding GioOtText}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#059669" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Vùng nút quẹt thẻ tích hợp -->
                        <VerticalStackLayout Spacing="8">
                            <Button x:Name="btnPunch"
                                    Text="{Binding ActionButtonText}"
                                    Clicked="OnPunchClicked"
                                    FontFamily="SegoeUIBold"
                                    FontSize="16"
                                    CharacterSpacing="1.5"
                                    TextColor="White"
                                    BackgroundColor="{Binding ActionButtonColor}"
                                    BorderWidth="0"
                                    CornerRadius="16"
                                    HeightRequest="56"
                                    IsEnabled="{Binding CanPunchCard}" />

                            <Label x:Name="lblPunchHint"
                                   Text="Chạm để quẹt thẻ vào ca"
                                   FontFamily="SegoeUI"
                                   FontSize="11"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ THÔNG BÁO KHÔNG CÓ CA ============ -->
                <Border x:Name="noShiftCard"
                        Opacity="0"
                        IsVisible="{Binding HasNoShiftToday}"
                        StrokeShape="RoundRectangle 20"
                        Stroke="#E2E8F0"
                        BackgroundColor="#FFFFFF"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="○" FontFamily="SegoeUIBold" FontSize="30" TextColor="#94A3B8" HorizontalOptions="Center" />
                        <Label Text="{Binding ShiftName}" FontFamily="SegoeUIBold" FontSize="15" TextColor="#0F172A" HorizontalOptions="Center" />
                        <Label Text="{Binding ShiftTimeText}" FontFamily="SegoeUI" FontSize="12" TextColor="#64748B" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== CUSTOM MODAL POPUP (không dùng DisplayAlert) ==================== -->
        <Grid x:Name="popupOverlay"
              Grid.Row="0"
              IsVisible="{Binding IsPopupVisible}"
              InputTransparent="True"
              Opacity="0"
              BackgroundColor="#660F172A">
            <Border x:Name="popupCard"
                    WidthRequest="290"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="#FFFFFF"
                    Stroke="{Binding PopupBorderColor}"
                    StrokeThickness="1.5"
                    Padding="22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <Border x:Name="popupIconBox"
                            WidthRequest="54"
                            HeightRequest="54"
                            BackgroundColor="{Binding PopupIconBgColor}"
                            Stroke="{Binding PopupBorderColor}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 27"
                            HorizontalOptions="Center">
                        <Label Text="{Binding PopupIconText}"
                               FontFamily="SegoeUIBold"
                               FontSize="24"
                               TextColor="{Binding PopupIconTextColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="{Binding PopupTitle}"
                           FontFamily="SegoeUIBold"
                           FontSize="19"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding PopupMessage}"
                           FontFamily="SegoeUI"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="#475569"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Button Text="{Binding PopupButtonText}"
                            Clicked="OnPopupConfirmClicked"
                            FontFamily="SegoeUIBold"
                            FontSize="13"
                            CharacterSpacing="1.2"
                            TextColor="White"
                            BackgroundColor="#1E3A8A"
                            BorderColor="#D4AF37"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="48"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== POPUP XEM CHI TIẾT GIỜ CHẤM CÔNG ==================== -->
        <Grid x:Name="detailPopupOverlay"
              Grid.Row="0"
              IsVisible="{Binding IsDetailPopupVisible}"
              InputTransparent="True"
              Opacity="0"
              BackgroundColor="#660F172A">
            <Border x:Name="detailPopupCard"
                    WidthRequest="310"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="#FFFFFF"
                    Stroke="#D4AF37"
                    StrokeThickness="1.5"
                    Padding="22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                <VerticalStackLayout Spacing="14">

                    <!-- Biểu tượng -->
                    <Border WidthRequest="52"
                            HeightRequest="52"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 26"
                            HorizontalOptions="Center">
                        <Label Text="📋"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Tiêu đề & Ngày/Ca -->
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Chi Tiết Giờ Chấm Công"
                               FontFamily="SegoeUIBold"
                               FontSize="17"
                               TextColor="#0F172A"
                               HorizontalOptions="Center" />
                        <Label FontFamily="SegoeUI"
                               FontSize="12"
                               TextColor="#64748B"
                               HorizontalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SelectedRecord.NgayLamViec}" FontAttributes="Bold" TextColor="#1E3A8A" />
                                    <Span Text="  ·  " />
                                    <Span Text="{Binding SelectedRecord.TenCa}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Huy hiệu trạng thái -->
                    <Border BackgroundColor="{Binding SelectedRecord.TrangThaiBgColor}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,5"
                            HorizontalOptions="Center">
                        <Label Text="{Binding SelectedRecord.TrangThaiText}"
                               FontFamily="SegoeUIBold"
                               FontSize="10"
                               CharacterSpacing="0.6"
                               TextColor="{Binding SelectedRecord.TrangThaiTextColor}" />
                    </Border>

                    <!-- Khung giờ Vào - Ra -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Giờ vào -->
                        <Border Grid.Column="0"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,12">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="GIỜ VÀO"
                                       FontFamily="SegoeUIBold"
                                       FontSize="10"
                                       CharacterSpacing="0.8"
                                       TextColor="#059669"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.CheckInText}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#0F172A"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Giờ ra -->
                        <Border Grid.Column="1"
                                BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="10,12">
                            <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                <Label Text="GIỜ RA"
                                       FontFamily="SegoeUIBold"
                                       FontSize="10"
                                       CharacterSpacing="0.8"
                                       TextColor="#DC2626"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.CheckOutText}"
                                       FontFamily="SegoeUIBold"
                                       FontSize="18"
                                       TextColor="#0F172A"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Khung thông số phụ: Đi trễ, Về sớm, Giờ OT -->
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="10,10">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                <Label Text="ĐI TRỄ" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="0.5" TextColor="#64748B" HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.PhutDiTreText}" FontFamily="SegoeUIBold" FontSize="11" TextColor="#D97706" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                <Label Text="VỀ SỚM" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="0.5" TextColor="#64748B" HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.PhutVeSomText}" FontFamily="SegoeUIBold" FontSize="11" TextColor="#D97706" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                <Label Text="LÀM THÊM" FontFamily="SegoeUIBold" FontSize="9" CharacterSpacing="0.5" TextColor="#64748B" HorizontalOptions="Center" />
                                <Label Text="{Binding SelectedRecord.GioOtText}" FontFamily="SegoeUIBold" FontSize="11" TextColor="#2563EB" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Nút Đóng -->
                    <Button Text="ĐÓNG"
                            Clicked="OnCloseDetailPopupClicked"
                            FontFamily="SegoeUIBold"
                            FontSize="13"
                            CharacterSpacing="1.2"
                            TextColor="White"
                            BackgroundColor="#1E3A8A"
                            BorderColor="#D4AF37"
                            BorderWidth="1"
                            CornerRadius="14"
                            HeightRequest="46"
                            Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>