<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:controls="clr-namespace:OvertimeHotel.HRM.MobileApp.Views.Controls"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="0">

                <!-- ════════ DẢI ĐẦU NAVY: nhận diện thương hiệu khách sạn ════════ -->
                <Border x:Name="brandHeader"
                        Stroke="Transparent"
                        StrokeThickness="0"
                        BackgroundColor="#0B1B4D"
                        Padding="24,52,24,46"
                        StrokeShape="RoundRectangle 36">
                    <Border.Shadow>
                        <Shadow Brush="#020817" Offset="0,6" Radius="18" Opacity="0.22" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                        <!--
                            Bộ dấu của khách sạn, nền TRONG SUỐT (app_icon.png do
                            scripts/generate_mobile_brand_icons.py sinh, cùng bộ
                            sinh ra icon launcher). Nhờ vậy đĩa kem + vành kim tự
                            nổi lên trên dải #0B1B4D: không còn ô xanh nào đè lên
                            icon, và cũng không cần khung bo tròn để cắt — hình
                            tròn đã nằm sẵn trong ảnh. Không Stroke, không Shadow.
                        -->
                        <Image Source="app_icon.png"
                               Aspect="AspectFit"
                               WidthRequest="156"
                               HeightRequest="156"
                               HorizontalOptions="Center"
                               SemanticProperties.Description="Biểu trưng ứng dụng The OverTime Hotel" />

                        <Label Text="THE OVERTIME HOTEL"
                               TextColor="#FFFFFF"
                               FontFamily="SegoeUIBold"
                               FontSize="22"
                               CharacterSpacing="1.4"
                               HorizontalOptions="Center" />

                        <Label Text="Hệ Thống Quản Lý Nhân Sự &amp; Tiền Lương"
                               TextColor="#93C5FD"
                               FontSize="12"
                               FontFamily="SegoeUI"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- ════════ THẺ ĐĂNG NHẬP nổi lên trên nền sáng ════════ -->
                <Border x:Name="formCardBorder"
                        Margin="18,-24,18,0"
                        StrokeShape="RoundRectangle 26"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        BackgroundColor="#FFFFFF"
                        Padding="22,24,22,24">
                    <Border.Shadow>
                        <Shadow Brush="#020817" Offset="0,6" Radius="24" Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="ĐĂNG NHẬP HỆ THỐNG"
                                   TextColor="#0F172A"
                                   FontSize="19"
                                   FontFamily="SegoeUIBold"
                                   HorizontalOptions="Center" />
                            <Label Text="Sử dụng tài khoản do khách sạn cấp để bắt đầu ca làm việc."
                                   TextColor="#64748B"
                                   FontSize="12"
                                   FontFamily="SegoeUI"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Skeleton shimmer thay cho vòng tròn xoay (quy chuẩn §2) -->
                        <Grid>
                            <VerticalStackLayout x:Name="skeletonLayout" Spacing="16" IsVisible="{Binding IsLoading}">
                                <Border StrokeShape="RoundRectangle 8" BackgroundColor="#E2E8F0" HeightRequest="14" WidthRequest="160" HorizontalOptions="Start" />
                                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F1F5F9" HeightRequest="48" />

                                <Border StrokeShape="RoundRectangle 8" BackgroundColor="#E2E8F0" HeightRequest="14" WidthRequest="100" HorizontalOptions="Start" />
                                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F1F5F9" HeightRequest="48" />

                                <Border StrokeShape="RoundRectangle 14" BackgroundColor="#CBD5E1" HeightRequest="52" />

                                <Label Text="Đang xác thực bảo mật Supabase..."
                                       TextColor="#64748B"
                                       FontSize="12"
                                       FontFamily="SegoeUI"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsNotLoading}">

                                <!-- Ô nhập tài khoản -->
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Tài khoản / Mã nhân viên"
                                           TextColor="#1E293B"
                                           FontSize="13"
                                           FontFamily="SegoeUIBold" />
                                    <Border StrokeShape="RoundRectangle 12"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#F8FAFC"
                                            Padding="14,0">
                                        <Entry Text="{Binding Username}"
                                               Placeholder="Nhập tên đăng nhập hoặc mã NV"
                                               PlaceholderColor="#94A3B8"
                                               TextColor="#0F172A"
                                               FontFamily="SegoeUI"
                                               FontSize="14"
                                               HeightRequest="48"
                                               ReturnType="Next"
                                               ClearButtonVisibility="WhileEditing" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Ô nhập mật khẩu -->
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Mật khẩu"
                                           TextColor="#1E293B"
                                           FontSize="13"
                                           FontFamily="SegoeUIBold" />
                                    <Border StrokeShape="RoundRectangle 12"
                                            Stroke="#CBD5E1"
                                            StrokeThickness="1"
                                            BackgroundColor="#F8FAFC"
                                            Padding="14,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Entry Grid.Column="0"
                                                   Text="{Binding Password}"
                                                   IsPassword="{Binding IsPasswordHidden}"
                                                   Placeholder="Nhập mật khẩu"
                                                   PlaceholderColor="#94A3B8"
                                                   TextColor="#0F172A"
                                                   FontFamily="SegoeUI"
                                                   FontSize="14"
                                                   HeightRequest="48"
                                                   ReturnType="Done"
                                                   ReturnCommand="{Binding LoginCommand}" />
                                            <Button Grid.Column="1"
                                                    Text="👁"
                                                    Command="{Binding TogglePasswordCommand}"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#64748B"
                                                    FontSize="14"
                                                    Padding="0"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Ghi nhớ đăng nhập & trạng thái CSDL -->
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding RememberMe}"
                                              Color="#1E3A8A"
                                              VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Ghi nhớ đăng nhập"
                                           TextColor="#475569"
                                           FontFamily="SegoeUI"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2"
                                           Text="● Supabase Online"
                                           TextColor="#059669"
                                           FontFamily="SegoeUIBold"
                                           FontSize="11"
                                           VerticalOptions="Center" />
                                </Grid>

                                <!-- Nút đăng nhập chính: navy đậm + viền vàng kim -->
                                <Button x:Name="btnLoginMain"
                                        Text="ĐĂNG NHẬP"
                                        Command="{Binding LoginCommand}"
                                        BackgroundColor="#1E3A8A"
                                        TextColor="#FFFFFF"
                                        FontFamily="SegoeUIBold"
                                        FontSize="14"
                                        CornerRadius="14"
                                        HeightRequest="52"
                                        BorderColor="#D4AF37"
                                        BorderWidth="1.5">
                                    <Button.Shadow>
                                        <Shadow Brush="#1E3A8A" Offset="0,4" Radius="12" Opacity="0.3" />
                                    </Button.Shadow>
                                </Button>

                                <!-- Xác thực sinh trắc học -->
                                <Button x:Name="btnBiometric"
                                        Text="Đăng Nhập FaceID / Vân Tay"
                                        Command="{Binding BiometricLoginCommand}"
                                        BackgroundColor="#FFFFFF"
                                        TextColor="#1E3A8A"
                                        FontFamily="SegoeUIBold"
                                        FontSize="13"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        BorderColor="#1E3A8A"
                                        BorderWidth="1.5" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Gợi ý tài khoản mẫu: một dòng chữ nhỏ, không chiếm chỗ như 3 chip cũ.
                     Nội dung phải khớp bộ seed trong DemoAuthService, nếu không người dùng
                     gõ đúng theo hướng dẫn vẫn bị từ chối. -->
                <VerticalStackLayout x:Name="accountHintSection" Spacing="4" Margin="24,16,24,0" HorizontalOptions="Center">
                    <Label Text="TÀI KHOẢN MẪU ĐỒ ÁN"
                           TextColor="#94A3B8"
                           FontFamily="SegoeUIBold"
                           FontSize="9"
                           CharacterSpacing="0.9"
                           HorizontalOptions="Center" />
                    <Label Text="Nhân viên: employee / emp123"
                           TextColor="#64748B"
                           FontFamily="SegoeUI"
                           FontSize="11"
                           HorizontalOptions="Center" />
                    <Label Text="Quản lý: manager / manager123"
                           TextColor="#64748B"
                           FontFamily="SegoeUI"
                           FontSize="11"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Label Text="The OverTime Hotel · Hệ thống HRM 5★"
                       TextColor="#CBD5E1"
                       FontSize="10"
                       FontFamily="SegoeUI"
                       HorizontalOptions="Center"
                       Margin="0,20,0,28" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Popup lỗi dùng chung, phủ toàn màn hình -->
        <controls:LuxuryPopup x:Name="popup" ZIndex="999" />

    </Grid>

</ContentPage>