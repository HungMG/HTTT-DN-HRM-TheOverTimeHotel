<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:m="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.PayslipPage"
             x:DataType="vm:PayslipViewModel"
             Title="Phiếu Lương" BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="SegoeUI" />
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="SegoeUIBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BackgroundColor" Value="#1E3A8A" />
            <Setter Property="TextColor" Value="#FFFFFF" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="payslipGrid" RowDefinitions="Auto,Auto,*" Padding="16,8,16,16">

        <!-- BANNER DEMO -->
        <Border Grid.Row="0" IsVisible="{Binding IsDemoMode}" StrokeShape="RoundRectangle 10"
                Stroke="#F59E0B" BackgroundColor="#FEF3C7" Padding="12,8" Margin="0,0,0,10">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="★" TextColor="#B45309" FontSize="14" VerticalOptions="Center" />
                <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu" TextColor="#B45309" FontFamily="SegoeUIBold" FontSize="12" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- THANH HEADER ĐIỀU HƯỚNG SANG TRỌNG -->
        <Grid x:Name="headerBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              VerticalOptions="Center" Margin="0,0,0,14">
            <Button Text="←" Clicked="OnBackClicked" WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                    FontSize="18" BackgroundColor="#FFFFFF" BorderColor="#E2E8F0" BorderWidth="1" TextColor="#1E3A8A"
                    SemanticProperties.Description="Quay lại" />

            <!-- Tiêu đề khi ở danh sách phiếu lương -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"
                                 IsVisible="{Binding IsListHeaderVisible}">
                <Label Text="Phiếu Lương Điện Tử" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                <Label Text="{Binding EmployeeName}" LineBreakMode="TailTruncation" TextColor="#64748B" FontSize="12" />
            </VerticalStackLayout>

            <!-- Tiêu đề khi xem chi tiết phiếu lương -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"
                                 IsVisible="{Binding HasDetail}">
                <Label Text="Chi Tiết Thu Nhập" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding DetailPeriodText}" LineBreakMode="TailTruncation" TextColor="#1E3A8A" FontFamily="SegoeUIBold" FontSize="12" />
                    <Label Text="•" TextColor="#CBD5E1" FontSize="12" />
                    <Label Text="{Binding DetailSlipIdText}" TextColor="#64748B" FontSize="12" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Nút Tải lại khi ở danh sách -->
            <Button Grid.Column="2" Text="↻" FontSize="18" WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0"
                    BackgroundColor="#FFFFFF" BorderColor="#E2E8F0" BorderWidth="1" TextColor="#1E3A8A"
                    IsVisible="{Binding IsListHeaderVisible}"
                    Command="{Binding RefreshCommand}" SemanticProperties.Description="Tải lại phiếu lương" />

            <!-- Khung giữ cân bằng bố cục khi đang xem chi tiết (đã gỡ nút ✕ theo yêu cầu) -->
            <ContentView Grid.Column="2" WidthRequest="42" HeightRequest="42"
                         IsVisible="{Binding HasDetail}" InputTransparent="True" />
        </Grid>

        <!-- NỘI DUNG CHÍNH -->
        <Grid Grid.Row="2">

            <!-- ═══ SKELETON SHIMMER KHI TẢI DỮ LIỆU ═══ -->
            <VerticalStackLayout x:Name="skeletonLayout" Spacing="12" IsVisible="{Binding IsLoading}" VerticalOptions="Start">
                <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20" Padding="18,16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <BoxView WidthRequest="42" HeightRequest="42" CornerRadius="21" Color="#E2E8F0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <BoxView HeightRequest="16" WidthRequest="130" Color="#E2E8F0" HorizontalOptions="Start" />
                                <BoxView HeightRequest="12" WidthRequest="90" Color="#F1F5F9" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="2" WidthRequest="70" HeightRequest="24" CornerRadius="8" Color="#F1F5F9" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="6">
                                <BoxView HeightRequest="10" WidthRequest="80" Color="#F1F5F9" />
                                <BoxView HeightRequest="24" WidthRequest="140" Color="#E2E8F0" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" WidthRequest="85" HeightRequest="32" CornerRadius="10" Color="#F1F5F9" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20" Padding="18,16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <BoxView WidthRequest="42" HeightRequest="42" CornerRadius="21" Color="#E2E8F0" />
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <BoxView HeightRequest="16" WidthRequest="130" Color="#E2E8F0" HorizontalOptions="Start" />
                                <BoxView HeightRequest="12" WidthRequest="90" Color="#F1F5F9" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="2" WidthRequest="70" HeightRequest="24" CornerRadius="8" Color="#F1F5F9" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="6">
                                <BoxView HeightRequest="10" WidthRequest="80" Color="#F1F5F9" />
                                <BoxView HeightRequest="24" WidthRequest="140" Color="#E2E8F0" />
                            </VerticalStackLayout>
                            <BoxView Grid.Column="1" WidthRequest="85" HeightRequest="32" CornerRadius="10" Color="#F1F5F9" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ═══ DANH SÁCH PHIẾU LƯƠNG LUXURY STATEMENT CARDS ═══ -->
            <RefreshView IsVisible="{Binding HasListVisible}" IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}" RefreshColor="#1E3A8A">
                <CollectionView ItemsSource="{Binding Payslips}" SelectionMode="None">
                    <CollectionView.Header>
                        <!-- Banner hướng dẫn 5 sao -->
                        <Border StrokeThickness="0" BackgroundColor="#EFF6FF" StrokeShape="RoundRectangle 14"
                                Padding="14,10" Margin="0,0,0,14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Border WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="#DBEAFE" StrokeThickness="0"
                                        VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="ℹ" FontSize="13" TextColor="#1E3A8A" FontFamily="SegoeUIBold"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Chạm vào một phiếu để xem bảng quyết toán chi tiết lương 2 tầng Gross - Net."
                                       FontSize="12" TextColor="#1E40AF" VerticalOptions="Center" LineHeight="1.3" />
                            </Grid>
                        </Border>
                    </CollectionView.Header>

                    <!-- Khối hiển thị khi chưa có phiếu lương (Empty View) -->
                    <CollectionView.EmptyView>
                        <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20"
                                Padding="24,36" Margin="0,12">
                            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                                <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32"
                                        BackgroundColor="#F1F5F9" Stroke="#E2E8F0" StrokeThickness="1"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="📄" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="Chưa có phiếu lương" FontFamily="SegoeUIBold" FontSize="17"
                                       TextColor="#0F172A" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding EmptyText}" FontSize="12" TextColor="#64748B"
                                       HorizontalTextAlignment="Center" LineHeight="1.4" />
                                <Button Text="↻ Làm mới dữ liệu" Command="{Binding RefreshCommand}"
                                        BackgroundColor="#EFF6FF" TextColor="#1E3A8A" FontFamily="SegoeUIBold"
                                        FontSize="13" CornerRadius="12" WidthRequest="180" HeightRequest="44"
                                        Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </CollectionView.EmptyView>

                    <!-- Template từng thẻ phiếu lương Luxury Statement Card -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:PayslipRowItem">
                            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20"
                                    Padding="18,16" Margin="0,0,0,14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PayslipViewModel}}, Path=SelectPayslipCommand}"
                                        CommandParameter="{Binding MaPhieuLuong}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="10">
                                    <!-- Hàng 1: Icon nhận diện 5★ + Kỳ lương + Huy hiệu trạng thái -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <!-- Biểu tượng tiền tệ / tài chính hoàng gia -->
                                        <Border WidthRequest="42" HeightRequest="42" StrokeShape="RoundRectangle 21"
                                                BackgroundColor="#FEF3C7" Stroke="#FDE68A" StrokeThickness="1"
                                                VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label Text="💰" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <!-- Kỳ lương & ngày công -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding PeriodText}" FontFamily="SegoeUIBold"
                                                   FontSize="16" TextColor="#0F172A" />
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="{Binding WorkDayText}" FontSize="11" TextColor="#64748B" />
                                                <Label Text="•" FontSize="11" TextColor="#CBD5E1" />
                                                <Label Text="{Binding SlipIdText}" FontSize="11" TextColor="#64748B" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Huy hiệu trạng thái duyệt / khóa sổ -->
                                        <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="{Binding StatusBackground}"
                                                StrokeShape="RoundRectangle 10" Padding="10,5" VerticalOptions="Center">
                                            <Label Text="{Binding StatusText}" FontFamily="SegoeUIBold" FontSize="11"
                                                   TextColor="{Binding StatusColor}" />
                                        </Border>
                                    </Grid>

                                    <!-- Đường phân cách tinh tế -->
                                    <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2" />

                                    <!-- Hàng 2: Tóm tắt 2 tầng Thu nhập Gross & Khấu trừ -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Border BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Tổng thu nhập" FontSize="10" TextColor="#047857" FontFamily="SegoeUIBold" />
                                                <Label Text="{Binding EarnedText}" FontSize="12" TextColor="#065F46" FontFamily="SegoeUIBold" />
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Column="1" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Tổng khấu trừ" FontSize="10" TextColor="#DC2626" FontFamily="SegoeUIBold" />
                                                <Label Text="{Binding DeductionText}" FontSize="12" TextColor="#991B1B" FontFamily="SegoeUIBold" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Hàng 3: Thực nhận (Net) to bản + Nút Xem chi tiết -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center" Margin="0,2,0,0">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="THỰC NHẬN (NET)" FontSize="10" FontFamily="SegoeUIBold"
                                                   TextColor="#64748B" CharacterSpacing="0.8" />
                                            <Label Text="{Binding NetText}" FontFamily="SegoeUIBold"
                                                   FontSize="22" TextColor="#1E3A8A" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 12" Padding="12,8" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="Chi tiết" FontFamily="SegoeUIBold" FontSize="12" TextColor="#1E3A8A" VerticalOptions="Center" />
                                                <Label Text="›" FontFamily="SegoeUIBold" FontSize="14" TextColor="#1E3A8A" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <Label Text="Phiếu lương được cấp quyền bảo mật theo tài khoản cá nhân · The OverTime Hotel"
                               FontSize="11" HorizontalTextAlignment="Center" TextColor="#94A3B8" Margin="8,8,8,24" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <!-- ═══ MÀN HÌNH CHI TIẾT PHIẾU LƯƠNG REDESIGN (2 TẦNG GROSS - NET) ═══ -->
            <ScrollView IsVisible="{Binding HasDetail}" VerticalScrollBarVisibility="Never" Padding="0,0,0,24">
                <VerticalStackLayout Spacing="14">

                    <!-- SKELETON KHI ĐANG TẢI CHI TIẾT TỪNG DÒNG -->
                    <Border IsVisible="{Binding IsDetailLoading}" Stroke="#BFDBFE" BackgroundColor="#EFF6FF"
                            StrokeShape="RoundRectangle 12" Padding="12,10">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Đang cập nhật các dòng thu chi..." TextColor="#1E3A8A" FontFamily="SegoeUIBold" FontSize="12" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 1. HERO CARD: LƯƠNG THỰC NHẬN (NET) SANG TRỌNG 5★ (TÔNG MÀU NHẸ NHÀNG, DỊU MẮT) -->
                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 22" Padding="20,18">
                        <VerticalStackLayout Spacing="12">
                            <!-- Tiêu đề thẻ & huy hiệu sao vàng -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="THE OVERTIME HOTEL" TextColor="#B45309" FontFamily="SegoeUIBold"
                                               FontSize="11" CharacterSpacing="1.2" />
                                        <Label Text="★★★★★" TextColor="#D4AF37" FontSize="10" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding DetailDepartmentRole}" TextColor="#64748B" FontSize="11" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{Binding DetailStatusBackground}"
                                        StrokeShape="RoundRectangle 12" Padding="10,5" VerticalOptions="Start">
                                    <Label Text="{Binding DetailStatusText}" FontFamily="SegoeUIBold"
                                           FontSize="11" TextColor="{Binding DetailStatusColor}" />
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2,0,2" />

                            <!-- Số tiền Thực Nhận (Net) nổi bật -->
                            <VerticalStackLayout Spacing="3">
                                <Label Text="LƯƠNG THỰC NHẬN (NET)" TextColor="#64748B" FontFamily="SegoeUIBold"
                                       FontSize="11" CharacterSpacing="1" />
                                <Label Text="{Binding DetailNetText}" FontFamily="SegoeUIBold"
                                       FontSize="30" TextColor="#1E3A8A" />
                                <Label Text="{Binding DetailNetInWords}" TextColor="#64748B"
                                       FontSize="11" FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- Tóm tắt 3 chỉ số theo phong cách thẻ pastel dịu mắt (Gross - Trừ - Công) -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                <Border StrokeThickness="1" Stroke="#BBF7D0" BackgroundColor="#F0FDF4"
                                        StrokeShape="RoundRectangle 12" Padding="8,8">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="TỔNG GROSS" FontSize="9" TextColor="#15803D" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding DetailGrossText}" FontSize="12" TextColor="#166534" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="1" Stroke="#FECACA" BackgroundColor="#FEF2F2"
                                        StrokeShape="RoundRectangle 12" Padding="8,8">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="KHẤU TRỪ" FontSize="9" TextColor="#DC2626" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding DetailDeductionMinusText}" FontSize="12" TextColor="#B91C1C" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" StrokeThickness="1" Stroke="#BFDBFE" BackgroundColor="#EFF6FF"
                                        StrokeShape="RoundRectangle 12" Padding="8,8">
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="CÔNG THỰC TẾ" FontSize="9" TextColor="#1D4ED8" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding DetailWorkDayBadge}" FontSize="12" TextColor="#1E40AF" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2. THÔNG SỐ ĐỊNH MỨC & CÔNG LAO ĐỘNG -->
                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="📋" FontSize="13" VerticalOptions="Center" />
                                <Label Text="ĐỊNH MỨC THEO HỢP ĐỒNG LAO ĐỘNG" FontFamily="SegoeUIBold"
                                       FontSize="11" TextColor="#1E3A8A" CharacterSpacing="0.8" />
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Lương cơ bản" FontSize="11" TextColor="#64748B" />
                                        <Label Text="{Binding DetailBaseSalaryText}" FontFamily="SegoeUIBold"
                                               FontSize="13" TextColor="#0F172A" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Công thực tế" FontSize="11" TextColor="#64748B" />
                                        <Label Text="{Binding DetailWorkDayText}" FontFamily="SegoeUIBold"
                                               FontSize="13" TextColor="#0F172A" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Đơn giá ngày" FontSize="11" TextColor="#64748B" />
                                        <Label Text="{Binding DetailDailyRateText}" FontFamily="SegoeUIBold"
                                               FontSize="13" TextColor="#0F172A" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. TẦNG 1: CÁC KHOẢN THU NHẬP (GROSS) -->
                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#ECFDF5" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2">
                                        <Label Text="+" FontFamily="SegoeUIBold" TextColor="#047857" FontSize="12" />
                                    </Border>
                                    <Label Text="THU NHẬP (GROSS)" FontFamily="SegoeUIBold"
                                           FontSize="12" TextColor="#047857" CharacterSpacing="0.5" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailGrossTotalText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Lương theo ngày công thực tế -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Lương ngày công thực tế" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" />
                                    <Label Text="{Binding DetailWageFormulaText}" FontSize="11" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailWageSalaryText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                            </Grid>

                            <!-- Tiền làm thêm giờ (OT) nếu có -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding DetailHasOvertimeSalary}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Tiền làm thêm giờ (OT)" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" />
                                    <Label Text="Đã tính theo hệ số tăng ca ca đêm / ngày nghỉ" FontSize="11" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailOvertimeSalaryText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                            </Grid>

                            <!-- Các khoản phụ cấp và thưởng từ database -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomeItems}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:PayslipItemRowItem">
                                        <VerticalStackLayout Spacing="10">
                                            <BoxView HeightRequest="1" Color="#F1F5F9" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Label Text="{Binding Name}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A"
                                                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                                                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{Binding BadgeBackgroundColor}"
                                                                StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                                            <Label Text="{Binding BadgeText}" FontFamily="SegoeUIBold"
                                                                   FontSize="10" TextColor="{Binding BadgeTextColor}" />
                                                        </Border>
                                                    </Grid>
                                                    <Label Text="{Binding Note}" FontSize="11" TextColor="#64748B"
                                                           IsVisible="{Binding HasNote}" LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="SegoeUIBold"
                                                       FontSize="14" TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Thanh chốt Gross Tầng 1 -->
                            <Border StrokeThickness="0" BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 12" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tổng Thu Nhập Gross Tầng 1" FontFamily="SegoeUIBold" FontSize="12" TextColor="#047857" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DetailGrossTotalText}" FontFamily="SegoeUIBold"
                                           FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. TẦNG 2: CÁC KHOẢN KHẤU TRỪ -->
                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#FEF2F2" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2">
                                        <Label Text="−" FontFamily="SegoeUIBold" TextColor="#DC2626" FontSize="12" />
                                    </Border>
                                    <Label Text="CÁC KHOẢN KHẤU TRỪ" FontFamily="SegoeUIBold"
                                           FontSize="12" TextColor="#DC2626" CharacterSpacing="0.5" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailTotalDeductionText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#DC2626" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Thông báo nếu không có khoản khấu trừ -->
                            <Label Text="Kỳ này không phát sinh khoản khấu trừ nào."
                                   FontSize="12" TextColor="#64748B" FontAttributes="Italic"
                                   IsVisible="{Binding HasNoDeductions}" />

                            <!-- Danh sách các khoản khấu trừ (Bảo hiểm 10.5%, Phạt kỷ luật, Thuế TNCN...) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DeductionItems}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:PayslipItemRowItem">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Label Text="{Binding Name}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A"
                                                               VerticalOptions="Center" LineBreakMode="WordWrap" />
                                                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{Binding BadgeBackgroundColor}"
                                                                StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                                            <Label Text="{Binding BadgeText}" FontFamily="SegoeUIBold"
                                                                   FontSize="10" TextColor="{Binding BadgeTextColor}" />
                                                        </Border>
                                                    </Grid>
                                                    <Label Text="{Binding Note}" FontSize="11" TextColor="#64748B"
                                                           IsVisible="{Binding HasNote}" LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="SegoeUIBold"
                                                       FontSize="14" TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="#F1F5F9" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Thanh chốt Khấu trừ Tầng 2 -->
                            <Border StrokeThickness="0" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 12" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tổng Khấu Trừ Tầng 2" FontFamily="SegoeUIBold" FontSize="12" TextColor="#DC2626" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DetailTotalDeductionText}" FontFamily="SegoeUIBold"
                                           FontSize="14" TextColor="#DC2626" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 5. BẤT BIẾN CÂN BẰNG & QUYẾT TOÁN 2 TẦNG -->
                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 18" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="⚖" FontSize="14" VerticalOptions="Center" />
                                <Label Text="CÔNG THỨC QUYẾT TOÁN 2 TẦNG" FontFamily="SegoeUIBold"
                                       FontSize="11" TextColor="#334155" CharacterSpacing="0.8" />
                            </HorizontalStackLayout>

                            <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" Padding="12,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Thực Nhận (Net) = Tổng Gross − Tổng Khấu Trừ"
                                           FontFamily="SegoeUIBold" FontSize="12" TextColor="#1E3A8A" />
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding DetailFormulaNet}" FontFamily="SegoeUIBold" FontSize="14" TextColor="#0F172A" />
                                        <Label Text="=" FontSize="13" TextColor="#64748B" />
                                        <Label Text="{Binding DetailFormulaGross}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#047857" />
                                        <Label Text="−" FontSize="13" TextColor="#64748B" />
                                        <Label Text="{Binding DetailFormulaDeduction}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#DC2626" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Label Text="✔" TextColor="#047857" FontFamily="SegoeUIBold" FontSize="12" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Bất biến cân bằng 100% · Đã khóa sổ &amp; phát hành chính thức"
                                       FontSize="11" TextColor="#047857" FontFamily="SegoeUIBold"
                                       LineBreakMode="WordWrap" VerticalOptions="Center" />
                            </Grid>

                            <Label Text="Phiếu lương điện tử được bảo mật và xác thực bởi Ban Giám Đốc và Bộ phận Kế toán The OverTime Hotel."
                                   FontSize="10" TextColor="#94A3B8" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- NÚT QUAY LẠI DANH SÁCH -->
                    <Button Text="← Quay lại danh sách phiếu lương" Command="{Binding CloseDetailCommand}"
                            BackgroundColor="#1E3A8A" TextColor="#FFFFFF" HeightRequest="48"
                            CornerRadius="14" Margin="0,4,0,16" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- ═══ THÔNG BÁO LỖI NẾU KHÔNG TẢI ĐƯỢC ═══ -->
            <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="End"
                                 Spacing="14" Padding="16">
                <Border Stroke="#FECACA" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 18" Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Chưa tải được phiếu lương" FontFamily="SegoeUIBold" FontSize="16"
                               TextColor="#991B1B" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" FontSize="12" HorizontalTextAlignment="Center" />
                        <Button Text="Thử lại" Command="{Binding RefreshCommand}" BackgroundColor="#1E3A8A" TextColor="White" />
                        <Button Text="Đăng nhập lại" IsVisible="{Binding RequiresLogin}" Command="{Binding LoginCommand}" BackgroundColor="#EFF6FF" TextColor="#1E3A8A" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
