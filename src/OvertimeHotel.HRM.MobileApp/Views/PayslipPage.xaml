<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertimeHotel.HRM.MobileApp.ViewModels"
             xmlns:m="clr-namespace:OvertimeHotel.HRM.MobileApp.Models"
             x:Class="OvertimeHotel.HRM.MobileApp.Views.PayslipPage"
             x:DataType="vm:PayslipViewModel"
             Title="Phiếu Lương" BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False" Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="SegoeUI" />
            <Setter Property="TextColor" Value="#64748B" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="SegoeUIBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BackgroundColor" Value="#EFF6FF" />
            <Setter Property="TextColor" Value="#1E3A8A" />
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="payslipGrid" RowDefinitions="Auto,Auto,*" Padding="16,0,16,0">

        <!-- BANNER DEMO -->
        <Border Grid.Row="0" IsVisible="{Binding IsDemoMode}" StrokeShape="RoundRectangle 8"
                Stroke="#F59E0B" BackgroundColor="#FEF3C7" Padding="12,8" Margin="0,0,0,8">
            <Label Text="CHẾ ĐỘ DEMO · Dữ liệu mẫu" TextColor="#B45309" FontFamily="SegoeUIBold" />
        </Border>

        <!-- THANH HEADER ĐIỀU HƯỚNG -->
        <Grid x:Name="headerBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
              VerticalOptions="Center" Margin="0,0,0,12">
            <Button Text="←" Clicked="OnBackClicked" WidthRequest="44" CornerRadius="22" Padding="0"
                    FontSize="20" SemanticProperties.Description="Quay lại" />

            <!-- Tiêu đề khi ở danh sách phiếu lương -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"
                                 IsVisible="{Binding HasListVisible}">
                <Label Text="Phiếu Lương" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                <Label Text="{Binding EmployeeName}" LineBreakMode="TailTruncation" TextColor="#64748B" FontSize="12" />
            </VerticalStackLayout>

            <!-- Tiêu đề khi xem chi tiết phiếu lương -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2"
                                 IsVisible="{Binding HasDetail}">
                <Label Text="Chi Tiết Phiếu Lương" FontFamily="SegoeUIBold" FontSize="18" TextColor="#0F172A" />
                <Label Text="{Binding DetailPeriodText}" LineBreakMode="TailTruncation" TextColor="#1E3A8A" FontFamily="SegoeUIBold" FontSize="12" />
            </VerticalStackLayout>

            <!-- Nút Tải lại khi ở danh sách -->
            <Button Grid.Column="2" Text="↻" FontSize="22" WidthRequest="44" Padding="0"
                    IsVisible="{Binding HasListVisible}"
                    Command="{Binding RefreshCommand}" SemanticProperties.Description="Tải lại phiếu lương" />

            <!-- Nút Đóng chi tiết khi đang xem chi tiết -->
            <Button Grid.Column="2" Text="✕" FontSize="16" WidthRequest="44" Padding="0"
                    IsVisible="{Binding HasDetail}"
                    Command="{Binding CloseDetailCommand}"
                    BackgroundColor="#F1F5F9" TextColor="#475569"
                    SemanticProperties.Description="Đóng chi tiết phiếu lương" />
        </Grid>

        <!-- NỘI DUNG CHÍNH -->
        <Grid Grid.Row="2">

            <!-- ═══ SKELETON SHIMMER KHI TẢI DANH SÁCH ═══ -->
            <VerticalStackLayout x:Name="skeletonLayout" Spacing="12" IsVisible="{Binding IsLoading}" VerticalOptions="Start">
                <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <BoxView HeightRequest="16" WidthRequest="120" Color="#E2E8F0" HorizontalOptions="Start" />
                        <BoxView HeightRequest="26" WidthRequest="160" Color="#F1F5F9" HorizontalOptions="Start" />
                        <BoxView HeightRequest="13" Color="#F1F5F9" />
                    </VerticalStackLayout>
                </Border>
                <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <BoxView HeightRequest="16" WidthRequest="120" Color="#E2E8F0" HorizontalOptions="Start" />
                        <BoxView HeightRequest="26" WidthRequest="160" Color="#F1F5F9" HorizontalOptions="Start" />
                        <BoxView HeightRequest="13" Color="#F1F5F9" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ═══ DANH SÁCH PHIẾU LƯƠNG ═══ -->
            <RefreshView IsVisible="{Binding HasListVisible}" IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}" RefreshColor="#1E3A8A">
                <CollectionView ItemsSource="{Binding Payslips}" SelectionMode="None">
                    <CollectionView.Header>
                        <Label Text="Chạm vào một phiếu để xem chi tiết lương 2 tầng Gross - Net."
                               LineHeight="1.3" Margin="0,4,0,12" />
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20,28" Spacing="10">
                            <Label Text="Chưa có phiếu lương" FontFamily="SegoeUIBold" FontSize="16"
                                   TextColor="#334155" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding EmptyText}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:PayslipRowItem">
                            <Border Stroke="#E2E8F0" BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 16"
                                    Padding="16" Margin="0,0,0,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PayslipViewModel}}, Path=SelectPayslipCommand}"
                                        CommandParameter="{Binding MaPhieuLuong}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding PeriodText}" FontFamily="SegoeUIBold"
                                                   FontSize="17" TextColor="#0F172A" />
                                            <Label Text="{Binding WorkDayText}" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{Binding StatusBackground}"
                                                StrokeShape="RoundRectangle 10" Padding="10,6" VerticalOptions="Center">
                                            <Label Text="{Binding StatusText}" FontFamily="SegoeUIBold"
                                                   TextColor="{Binding StatusColor}" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="Thực nhận (Net)" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding NetText}" FontFamily="SegoeUIBold"
                                               FontSize="20" TextColor="#1E3A8A" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <Label Text="Chỉ hiển thị phiếu lương của chính bạn sau khi đã duyệt và khóa sổ."
                               FontSize="11" HorizontalTextAlignment="Center" Margin="8,8,8,24" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <!-- ═══ MÀN HÌNH CHI TIẾT PHIẾU LƯƠNG REDESIGN (2 TẦNG GROSS - NET) ═══ -->
            <ScrollView IsVisible="{Binding HasDetail}" VerticalScrollBarVisibility="Never" Padding="0,0,0,24">
                <VerticalStackLayout Spacing="14">

                    <!-- SKELETON KHI ĐANG TẢI CHI TIẾT TỪNG DÒNG -->
                    <Border IsVisible="{Binding IsDetailLoading}" Stroke="#BFDBFE" BackgroundColor="#EFF6FF"
                            StrokeShape="RoundRectangle 12" Padding="12,10">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="Đang cập nhật các dòng thu chi..." TextColor="#1E3A8A" FontFamily="SegoeUIBold" FontSize="12" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 1. HERO CARD: LƯƠNG THỰC NHẬN (NET) SANG TRỌNG 5★ -->
                    <Border BackgroundColor="#0B1B4D" Stroke="#1E3A8A" StrokeThickness="1"
                            StrokeShape="RoundRectangle 20" Padding="20,18">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="THE OVERTIME HOTEL" TextColor="#F59E0B" FontFamily="SegoeUIBold"
                                               FontSize="11" CharacterSpacing="1.2" />
                                        <Label Text="★★★★★" TextColor="#F59E0B" FontSize="10" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding DetailDepartmentRole}" TextColor="#93C5FD" FontSize="11" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{Binding DetailStatusBackground}"
                                        StrokeShape="RoundRectangle 12" Padding="10,5" VerticalOptions="Start">
                                    <Label Text="{Binding DetailStatusText}" FontFamily="SegoeUIBold"
                                           FontSize="11" TextColor="{Binding DetailStatusColor}" />
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#1E3A8A" Margin="0,2,0,2" />

                            <VerticalStackLayout Spacing="4">
                                <Label Text="LƯƠNG THỰC NHẬN (NET)" TextColor="#93C5FD" FontFamily="SegoeUIBold"
                                       FontSize="11" CharacterSpacing="1" />
                                <Label Text="{Binding DetailNetText}" FontFamily="SegoeUIBold"
                                       FontSize="32" TextColor="#FFFFFF" />
                                <Label Text="{Binding DetailNetInWords}" TextColor="#E2E8F0"
                                       FontSize="11" FontAttributes="Italic" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- Tóm tắt 3 chỉ số Gross - Trừ - Công -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,6,0,0">
                                <Border StrokeThickness="0" BackgroundColor="#064E3B" StrokeShape="RoundRectangle 10" Padding="8,6">
                                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                        <Label Text="TỔNG GROSS" FontSize="9" TextColor="#A7F3D0" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding DetailGrossText}" FontSize="11" TextColor="#FFFFFF" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#7F1D1D" StrokeShape="RoundRectangle 10" Padding="8,6">
                                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                        <Label Text="KHẤU TRỪ" FontSize="9" TextColor="#FECACA" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding DetailDeductionMinusText}" FontSize="11" TextColor="#FFFFFF" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#1E3A8A" StrokeShape="RoundRectangle 10" Padding="8,6">
                                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                        <Label Text="CÔNG THỰC TẾ" FontSize="9" TextColor="#BFDBFE" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding DetailWorkDayBadge}" FontSize="11" TextColor="#FFFFFF" FontFamily="SegoeUIBold" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 2. THÔNG SỐ ĐỊNH MỨC & CÔNG LAO ĐỘNG -->
                    <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ĐỊNH MỨC THEO HỢP ĐỒNG LAO ĐỘNG" FontFamily="SegoeUIBold"
                                   FontSize="11" TextColor="#475569" CharacterSpacing="0.8" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Lương cơ bản" FontSize="11" TextColor="#64748B" />
                                    <Label Text="{Binding DetailBaseSalaryText}" FontFamily="SegoeUIBold"
                                           FontSize="13" TextColor="#0F172A" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Công thực tế" FontSize="11" TextColor="#64748B" />
                                    <Label Text="{Binding DetailWorkDayText}" FontFamily="SegoeUIBold"
                                           FontSize="13" TextColor="#0F172A" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Đơn giá ngày" FontSize="11" TextColor="#64748B" />
                                    <Label Text="{Binding DetailDailyRateText}" FontFamily="SegoeUIBold"
                                           FontSize="13" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3. TẦNG 1: CÁC KHOẢN THU NHẬP (GROSS) -->
                    <Border BackgroundColor="#FFFFFF" Stroke="#A7F3D0" StrokeThickness="1"
                            StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#ECFDF5" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2">
                                        <Label Text="+" FontFamily="SegoeUIBold" TextColor="#047857" FontSize="12" />
                                    </Border>
                                    <Label Text="THU NHẬP (GROSS)" FontFamily="SegoeUIBold"
                                           FontSize="12" TextColor="#047857" CharacterSpacing="0.5" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailGrossTotalText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Lương theo ngày công thực tế -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Lương ngày công thực tế" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" />
                                    <Label Text="{Binding DetailWageFormulaText}" FontSize="11" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailWageSalaryText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                            </Grid>

                            <!-- Tiền làm thêm giờ (OT) nếu có -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding DetailHasOvertimeSalary}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Tiền làm thêm giờ (OT)" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" />
                                    <Label Text="Đã tính theo hệ số tăng ca ca đêm / ngày nghỉ" FontSize="11" TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailOvertimeSalaryText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                            </Grid>

                            <!-- Các khoản phụ cấp và thưởng từ database -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding IncomeItems}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:PayslipItemRowItem">
                                        <VerticalStackLayout Spacing="10">
                                            <BoxView HeightRequest="1" Color="#F1F5F9" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding Name}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" />
                                                        <Border StrokeThickness="0" BackgroundColor="{Binding BadgeBackgroundColor}"
                                                                StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                                            <Label Text="{Binding BadgeText}" FontFamily="SegoeUIBold"
                                                                   FontSize="10" TextColor="{Binding BadgeTextColor}" />
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding Note}" FontSize="11" TextColor="#64748B"
                                                           IsVisible="{Binding HasNote}" LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="SegoeUIBold"
                                                       FontSize="14" TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Thanh chốt Gross -->
                            <Border StrokeThickness="0" BackgroundColor="#ECFDF5" StrokeShape="RoundRectangle 10" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tổng Thu Nhập Gross Tầng 1" FontFamily="SegoeUIBold" FontSize="12" TextColor="#047857" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DetailGrossTotalText}" FontFamily="SegoeUIBold"
                                           FontSize="14" TextColor="#047857" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 4. TẦNG 2: CÁC KHOẢN KHẤU TRỪ -->
                    <Border BackgroundColor="#FFFFFF" Stroke="#FECACA" StrokeThickness="1"
                            StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border BackgroundColor="#FEF2F2" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2">
                                        <Label Text="−" FontFamily="SegoeUIBold" TextColor="#DC2626" FontSize="12" />
                                    </Border>
                                    <Label Text="CÁC KHOẢN KHẤU TRỪ" FontFamily="SegoeUIBold"
                                           FontSize="12" TextColor="#DC2626" CharacterSpacing="0.5" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DetailTotalDeductionText}" FontFamily="SegoeUIBold"
                                       FontSize="14" TextColor="#DC2626" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Thông báo nếu không có khoản khấu trừ -->
                            <Label Text="Kỳ này không phát sinh khoản khấu trừ nào."
                                   FontSize="12" TextColor="#64748B" FontAttributes="Italic"
                                   IsVisible="{Binding HasNoDeductions}" />

                            <!-- Danh sách các khoản khấu trừ (Bảo hiểm, Phạt kỷ luật, Thuế TNCN...) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DeductionItems}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:PayslipItemRowItem">
                                        <VerticalStackLayout Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding Name}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" />
                                                        <Border StrokeThickness="0" BackgroundColor="{Binding BadgeBackgroundColor}"
                                                                StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                                            <Label Text="{Binding BadgeText}" FontFamily="SegoeUIBold"
                                                                   FontSize="10" TextColor="{Binding BadgeTextColor}" />
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding Note}" FontSize="11" TextColor="#64748B"
                                                           IsVisible="{Binding HasNote}" LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding AmountText}" FontFamily="SegoeUIBold"
                                                       FontSize="14" TextColor="{Binding AmountColor}" VerticalOptions="Center" />
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="#F1F5F9" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- Thanh chốt Khấu trừ -->
                            <Border StrokeThickness="0" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 10" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Tổng Khấu Trừ Tầng 2" FontFamily="SegoeUIBold" FontSize="12" TextColor="#DC2626" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DetailTotalDeductionText}" FontFamily="SegoeUIBold"
                                           FontSize="14" TextColor="#DC2626" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 5. BẤT BIẾN CÂN BẰNG & QUYẾT TOÁN 2 TẦNG -->
                    <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 16" Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="⚖" FontSize="14" VerticalOptions="Center" />
                                <Label Text="CÔNG THỨC QUYẾT TOÁN 2 TẦNG" FontFamily="SegoeUIBold"
                                       FontSize="11" TextColor="#334155" CharacterSpacing="0.8" />
                            </HorizontalStackLayout>

                            <Border BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" Padding="12,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Thực Nhận (Net) = Tổng Gross − Tổng Khấu Trừ"
                                           FontFamily="SegoeUIBold" FontSize="12" TextColor="#1E3A8A" />
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding DetailFormulaNet}" FontFamily="SegoeUIBold" FontSize="14" TextColor="#0F172A" />
                                        <Label Text="=" FontSize="13" TextColor="#64748B" />
                                        <Label Text="{Binding DetailFormulaGross}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#047857" />
                                        <Label Text="−" FontSize="13" TextColor="#64748B" />
                                        <Label Text="{Binding DetailFormulaDeduction}" FontFamily="SegoeUIBold" FontSize="13" TextColor="#DC2626" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <HorizontalStackLayout Spacing="6">
                                <Label Text="✔" TextColor="#047857" FontFamily="SegoeUIBold" FontSize="12" />
                                <Label Text="Bất biến cân bằng 100% · Đã khóa sổ &amp; phát hành chính thức"
                                       FontSize="11" TextColor="#047857" FontFamily="SegoeUIBold" />
                            </HorizontalStackLayout>

                            <Label Text="Phiếu lương điện tử được bảo mật và xác thực bởi Ban Giám Đốc và Bộ phận Kế toán The OverTime Hotel."
                                   FontSize="10" TextColor="#94A3B8" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- NÚT QUAY LẠI DANH SÁCH -->
                    <Button Text="← Quay lại danh sách phiếu lương" Command="{Binding CloseDetailCommand}"
                            BackgroundColor="#EFF6FF" TextColor="#1E3A8A" Margin="0,4,0,16" />

                </VerticalStackLayout>
            </ScrollView>

            <!-- ═══ THÔNG BÁO LỖI NẾU KHÔNG TẢI ĐƯỢC ═══ -->
            <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="End"
                                 Spacing="14" Padding="16">
                <Label Text="Chưa tải được phiếu lương" FontFamily="SegoeUIBold" FontSize="18"
                       TextColor="#0F172A" HorizontalTextAlignment="Center" />
                <Label Text="{Binding ErrorMessage}" TextColor="#B91C1C" HorizontalTextAlignment="Center" />
                <Button Text="Thử lại" Command="{Binding RefreshCommand}" BackgroundColor="#1E3A8A" TextColor="White" />
                <Button Text="Đăng nhập lại" IsVisible="{Binding RequiresLogin}" Command="{Binding LoginCommand}" />
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
