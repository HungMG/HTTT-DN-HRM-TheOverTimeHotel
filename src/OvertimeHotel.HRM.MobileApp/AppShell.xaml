<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="OvertimeHotel.HRM.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:OvertimeHotel.HRM.MobileApp.Views"
    Title="The OverTime Hotel HRM">

    <ShellContent
        Title="Khởi Động"
        ContentTemplate="{DataTemplate views:IntroPage}"
        Route="IntroPage" />

    <ShellContent
        Title="Đăng Nhập"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Hai nhánh sau đăng nhập là hai trang riêng biệt, không dùng chung khung giao diện -->
    <ShellContent
        Title="Trang Chủ Nhân Viên"
        ContentTemplate="{DataTemplate views:EmployeeHomePage}"
        Route="EmployeeHomePage" />

    <ShellContent
        Title="Trang Chủ Quản Lý"
        ContentTemplate="{DataTemplate views:ManagerHomePage}"
        Route="ManagerHomePage" />

    <ShellContent
        Title="Hồ Sơ"
        ContentTemplate="{DataTemplate views:ProfilePage}"
        Route="ProfilePage" />

    <ShellContent
        Title="Chấm Công"
        ContentTemplate="{DataTemplate views:AttendancePage}"
        Route="AttendancePage" />

</Shell>