<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>OvertimeHotel.HRM.MobileApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>OvertimeHotel.HRM.MobileApp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.overtimehotel.hrm.mobileapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!--
			LocalApiServer=true: build vẫn đóng gói đầy đủ như bản phát hành (không
			đụng lỗi SIGABRT "No assemblies found" chỉ có ở Debug), nhưng bật symbol DEBUG
			để ApiConfig trỏ về http://10.0.2.2:5065 và Android cho phép cleartext.
			Dùng khi cần thử app trên emulator với WebAdmin chạy ở máy dev.
			Không bật mặc định — bản build thường vẫn khoá cứng https:// production.
			Lệnh: dotnet build -c Release -p:LocalApiServer=true
		-->
		<DefineConstants Condition="'$(LocalApiServer)' == 'true'">$(DefineConstants);DEBUG</DefineConstants>

		<!--
			DemoMode=true: chạy App trên bộ nhớ cục bộ (DemoAuthService,
			DemoLeaveApprovalService, DemoAttendanceService) — không gọi Supabase/Cloud.
			Dùng để thuyết trình offline hoặc kiểm thử giao diện khi máy dev không
			truy cập được API. KHÔNG bật cho bản phát hành.
			Lệnh: dotnet build -c Release -p:DemoMode=true
		-->
		<DefineConstants Condition="'$(DemoMode)' == 'true'">$(DefineConstants);DEMO</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon (PNG: Resizetizer 10.0.110 trên Linux ném MAUIR0004 khi đọc SVG) -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F0F6FF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F0F6FF" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiImage Update="Resources\Images\login_bg_luxury.png" Resize="False" />

		<!-- Logo thương hiệu hiển thị TRONG app (thay ngôi sao ★ ở LoginPage,
		     IntroPage, AttendancePage, LocationClockPanel).
		     BaseSize="128,128" khớp với kích thước file sinh ra ở
		     scripts/generate_mobile_brand_icons.py (INAPP_BASE) — nhờ vậy
		     Resizetizer xuất đúng bản theo từng mật độ mdpi→xxxhdpi, thay vì
		     phóng to một bản 96px duy nhất trên máy màn hình 4×. -->
		<MauiImage Update="Resources\Images\brand_mark_light.png" Resize="True" BaseSize="128,128" />
		<MauiImage Update="Resources\Images\brand_mark_navy.png" Resize="True" BaseSize="128,128" />

		<!-- Bộ dấu tròn cho dải navy ở LoginPage (Source="app_icon.png").
		     KHÔNG phải bản sao của AppIcon\appicon.png: launcher cần nền navy
		     tràn viền cho adaptive-icon, nhưng bản đó đặt lên dải #0B1B4D sẽ
		     thành ô xanh đè lên icon. File này do
		     scripts/generate_mobile_brand_icons.py sinh với nền trong suốt.
		     MauiIcon chỉ là đầu vào cho launcher lúc build, KHÔNG đăng ký vào
		     MauiImage nên XAML không gọi được — vì vậy phải có file riêng ở
		     Resources\Images.
		     BaseSize="156,156" đúng bằng kích thước hiển thị trên LoginPage nên
		     Resizetizer xuất đúng bản theo từng mật độ, không phóng một bản
		     512px duy nhất trên máy màn hình 4×. -->
		<MauiImage Update="Resources\Images\app_icon.png" Resize="True" BaseSize="156,156" />

		<!-- Icon thanh tab của AppShell. Shell.Content.Icon nhận ImageSource nên
		     không dùng được ký tự emoji trong AppShell.xaml.cs — phải có PNG riêng.
		     BaseSize="32,32" khớp kích thước tab ở mdpi; Resizetizer xuất đúng bản
		     theo từng mật độ nên không phóng một bản 96px duy nhất trên máy 4×.
		     Tất cả do scripts/generate_mobile_brand_icons.py sinh ra. -->
		<MauiImage Update="Resources\Images\tab_home.png" Resize="True" BaseSize="32,32" />
		<MauiImage Update="Resources\Images\tab_manager.png" Resize="True" BaseSize="32,32" />
		<MauiImage Update="Resources\Images\tab_profile.png" Resize="True" BaseSize="32,32" />
		<MauiImage Update="Resources\Images\tab_attendance.png" Resize="True" BaseSize="32,32" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- Bản đồ tương tác cho cổng Nhân viên. LƯU Ý: trên Android, control này LUÔN render
		     qua Google Play Services (không phải OpenStreetMap) nên BẮT BUỘC phải khai báo
		     meta-data com.google.android.geo.API_KEY trong Platforms/Android/AndroidManifest.xml.
 Thiếu key sẽ ra màn hình xám trống, không có ô báo lỗi. -->
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\OvertimeHotel.HRM.Core\OvertimeHotel.HRM.Core.csproj" />
	</ItemGroup>

</Project>
