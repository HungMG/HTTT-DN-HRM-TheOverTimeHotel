  // Xác thực vị trí quẹt thẻ (PRD 4.1).
  //
  // Hai giá trị toạ độ dưới đây là SỐ MẪU của trung tâm TP.HCM, KHÔNG phải vị trí
  // thật của khách sạn — phải thay bằng toạ độ thực trước khi dùng. Cách lấy:
  // mở Google Maps, bấm chuột phải đúng chỗ khách sạn, chọn toạ độ hiện ra, định
  // dạng "vĩ độ, kinh độ" (ví dụ 10.776889, 106.700806).
  //
  // Bán kính tính bằng MÉT. Để sai thì hoặc chặn nhầm toàn bộ nhân viên (quá
  // nhỏ), hoặc cho phép quẹt thẻ từ ngoài đường (quá lớn).
  "CheckIn": {
    "HotelLatitude": 10.776889,
    "HotelLongitude": 106.700806,
    "RadiusMeters": 100,
    "WifiSsid": "OverTimeHotel_Staff"
  }
