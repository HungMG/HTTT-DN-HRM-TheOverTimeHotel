@model UserProfileViewModel
@{
    ViewData["Title"] = "Thông Tin Cá Nhân & Tài Khoản";
}

<div class="container-fluid py-3">
    <!-- BREADCRUMB -->
    <nav aria-label="Điều hướng">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door"></i> Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hồ sơ cá nhân &amp; Đổi mật khẩu</li>
        </ol>
    </nav>

    <!-- HEADER TITLE -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge @(Model.RoleName == "Admin" ? "bg-danger" : Model.RoleName == "HR" ? "bg-primary" : "bg-warning text-dark") px-3 py-1 rounded-pill">
                    <i class="bi @(Model.RoleName == "Admin" ? "bi-shield-shaded" : "bi-person-badge") me-1"></i>Vai trò: @Model.RoleName
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                    <i class="bi bi-check-circle-fill me-1"></i>Tài khoản hoạt động
                </span>
            </div>
            <h1 class="h2 fw-bold text-dark font-serif mb-0">Hồ Sơ Cá Nhân &amp; Tài Khoản</h1>
            <p class="text-muted small mb-0">Xem thông tin định danh nhân sự và chủ động cập nhật mật khẩu đăng nhập cá nhân.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại Dashboard
        </a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <strong>@successMessage</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT TRÁI: THÔNG TIN NHÂN SỰ & TÀI KHOẢN -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold text-dark mb-0 font-serif">
                        <i class="bi bi-person-vcard text-primary me-2"></i>Thông Tin Nhân Sự
                    </h5>
                    <span class="badge bg-light text-secondary border">Mã: NV-@Model.EmployeeId</span>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 64px; height: 64px;">
                            @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-1 font-serif">@Model.FullName</h4>
                            <div class="text-muted small">
                                <span class="fw-semibold text-primary">@Model.Position</span> &bull; <span>@Model.Department</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Tên đăng nhập</label>
                            <div class="fw-bold text-dark"><i class="bi bi-at me-1 text-muted"></i>@Model.Username</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Hộp thư Email</label>
                            <div class="fw-bold text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@Model.Email</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Số điện thoại</label>
                            <div class="fw-bold text-dark"><i class="bi bi-telephone me-1 text-muted"></i>@(string.IsNullOrEmpty(Model.Phone) ? "Chưa cập nhật" : Model.Phone)</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="text-muted small d-block">Ngày vào làm</label>
                            <div class="fw-bold text-dark"><i class="bi bi-calendar-event me-1 text-muted"></i>@Model.StartDate.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="col-12">
                            <label class="text-muted small d-block">Địa chỉ lưu trú</label>
                            <div class="fw-bold text-dark"><i class="bi bi-geo-alt me-1 text-muted"></i>@Model.Address</div>
                        </div>
                    </div>

                    <div class="mt-4 p-3 bg-light rounded-3 border">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check text-success fs-5"></i>
                                <div>
                                    <strong class="d-block small text-dark">Bảo mật tài khoản</strong>
                                    <small class="text-muted">Mật khẩu được mã hóa SHA-256 một chiều trên CSDL Supabase.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM ĐỔI MẬT KHẨU -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold text-dark mb-0 font-serif">
                        <i class="bi bi-key-fill text-warning me-2"></i>Đổi Mật Khẩu Cá Nhân
                    </h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted small mb-4">
                        Để đảm bảo an toàn cho dữ liệu khách sạn, bạn nên đặt mật khẩu có ít nhất 6 ký tự kết hợp chữ hoa, chữ thường và chữ số.
                    </p>

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.CurrentPassword" class="form-label small fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                <input asp-for="ChangePassword.CurrentPassword" class="form-control" type="password" placeholder="Nhập mật khẩu hiện tại" required />
                            </div>
                            <span asp-validation-for="ChangePassword.CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChangePassword.NewPassword" class="form-label small fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="ChangePassword.NewPassword" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" required />
                            </div>
                            <span asp-validation-for="ChangePassword.NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ChangePassword.ConfirmPassword" class="form-label small fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-shield-check"></i></span>
                                <input asp-for="ChangePassword.ConfirmPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu mới" required />
                            </div>
                            <span asp-validation-for="ChangePassword.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                                <i class="bi bi-check2 me-1"></i>Lưu Mật Khẩu Mới
                            </button>
                            <button type="reset" class="btn btn-light rounded-pill px-3">Hủy</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
