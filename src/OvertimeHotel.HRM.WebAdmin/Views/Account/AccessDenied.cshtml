@{
    ViewData["Title"] = "Không Có Quyền Truy Cập · The OverTime Hotel";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6 text-center">
            <div class="card shadow-sm border-0 p-4 p-md-5 rounded-4">
                <div class="mb-3">
                    <div class="d-inline-flex p-3 rounded-circle bg-danger-subtle text-danger fs-1">
                        <i class="bi bi-shield-x"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-2">Quyền Truy Cập Bị Từ Chối (403)</h2>
                <p class="text-muted mb-4">
                    Tài khoản của bạn không có đủ thẩm quyền để truy cập trang này. Cổng Web Admin được phân quyền nghiêm ngặt dành riêng cho <strong>Quản trị viên (Admin)</strong> và <strong>Chuyên viên Nhân sự (HR)</strong>.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">
                        <i class="bi bi-house-door me-1"></i> Trang Chủ
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-danger px-4">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng Xuất
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
