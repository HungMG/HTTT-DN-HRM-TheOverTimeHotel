@model OvertimeHotel.HRM.WebAdmin.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng Nhập Quản Trị · The OverTime Hotel";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Google Fonts: Be Vietnam Pro & Fraunces (đồng bộ với hệ chữ của Web Admin) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,600&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --brand-primary: #0F172A;
            --brand-navy: #1E3A8A;
            --brand-gold: #D4AF37;
            --brand-gold-dark: #B8860B;
            --brand-gold-light: #FDE047;
            --surface-bg: #F8FAFC;
        }

        body {
            font-family: var(--font-sans, 'Be Vietnam Pro', sans-serif);
            background-color: #0B1325;
            color: #1E293B;
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
        }

        /* =====================================================================
           🎬 HIỆU ỨNG VÀO TRANG LOGIN ĐẲNG CẤP & SỐNG ĐỘNG (CINEMATIC STAGE ENTRANCE)
           ===================================================================== */

        /* CỘT TRÁI: SHOWCASE KHÁCH SẠN LƯỚT TỪ TRÁI VÀO */
        .hotel-showcase {
            position: relative;
            flex: 1.15;
            display: flex;
            flex-direction: column;
            /* space-between + gap: gap là khoảng cách TỐI THIỂU, nên ở màn hình thấp
               hai khối vẫn không dính vào nhau, còn ở màn hình cao khoảng hở giữa
               chính là không gian để ảnh sân thượng lộ ra. */
            justify-content: space-between;
            gap: 2.5rem;
            padding: 3.25rem 3.5rem;
            color: #FFFFFF;
            overflow: hidden;
            isolation: isolate;
            animation: showcaseCinematicEnter 0.95s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        /* Ảnh nền tách riêng thành một lớp riêng để chạy hiệu ứng Ken Burns
           (zoom chậm 32 giây) mà không kéo theo phần chữ ở trên. Chỉ dùng
           transform nên nằm trên composition layer của GPU, không layout pass. */
        .showcase-photo {
            position: absolute;
            inset: -4%;
            background-image: url('https://images.unsplash.com/photo-1445019980597-93fa8acb246c?auto=format&fit=crop&w=1600&q=85');
            background-size: cover;
            background-position: 50% 58%;
            z-index: 0;
            will-change: transform;
            animation: showcaseKenBurns 32s ease-in-out infinite alternate;
        }

        @@keyframes showcaseKenBurns {
            0% { transform: scale(1.04) translate3d(0, 0, 0); }
            100% { transform: scale(1.17) translate3d(-1.8%, -1.4%, 0); }
        }

        @@keyframes showcaseCinematicEnter {
            0% {
                opacity: 0;
                transform: translateX(-60px) scale(0.94);
                filter: blur(12px);
            }
            100% {
                opacity: 1;
                transform: translateX(0) scale(1);
                filter: blur(0);
            }
        }

        /* Quả cầu hào quang vàng kim thở nhẹ nhàng */
        .hotel-showcase::after {
            content: '';
            position: absolute;
            bottom: 5%;
            left: 15%;
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, rgba(253, 224, 71, 0.22) 0%, rgba(212, 175, 55, 0.12) 45%, transparent 70%);
            border-radius: 50%;
            filter: blur(45px);
            animation: ambientAuraFloat 12s ease-in-out infinite alternate;
            pointer-events: none;
            z-index: 1;
        }

        @@keyframes ambientAuraFloat {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(35px, -30px) scale(1.25); }
        }

        .hotel-showcase::before {
            content: '';
            position: absolute;
            inset: 0;
            /* Gradient toán dối: giữa màn hình để hở ảnh ra (nơi có trời & sân thượng
               đẹp nhất), dồn dập dần về mép trái + đáy để chữ trắng luôn đủ tương
           phản. Không dùng backdrop-filter nữa vì nó làm nhòe luôn phần ảnh đẹp. */
            background:
                linear-gradient(100deg, rgba(9, 15, 32, 0.86) 0%, rgba(11, 20, 40, 0.55) 34%, rgba(11, 20, 40, 0.18) 62%, rgba(11, 20, 40, 0.10) 100%),
                linear-gradient(0deg, rgba(9, 15, 32, 0.92) 0%, rgba(9, 15, 32, 0.55) 22%, rgba(9, 15, 32, 0) 52%);
            z-index: 1;
        }

        .showcase-content {
            position: relative;
            z-index: 2;
        }

        /* Khối dưới: thụt nhẹ vào trong để tạo phân cấp thị giác với khối tiêu đề */
        .showcase-content--bottom {
            padding-left: 0.5rem;
        }

        .brand-title {
            font-family: var(--font-display, 'Fraunces', serif);
            font-size: 3.3rem;
            font-weight: 700;
            line-height: 1.15;
            color: #FFFFFF;
            margin-top: 1.5rem;
            text-shadow: 0 4px 25px rgba(0, 0, 0, 0.6);
            animation: elemCinematicIn 0.75s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
        }

        .brand-title span {
            color: var(--brand-gold);
            font-style: italic;
        }

        .showcase-glass-card {
            background: rgba(9, 15, 32, 0.42);
            border: 1px solid rgba(253, 224, 71, 0.32);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-radius: 20px;
            padding: 1.6rem 1.8rem;
            max-width: 520px;
            box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.5), 0 0 25px rgba(212, 175, 55, 0.18);
            position: relative;
            overflow: hidden;
            animation: elemCinematicIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.38s both;
            transition: transform 0.35s ease, box-shadow 0.35s ease;
        }

        /* Dải sáng vàng kim quét ngang đầu thẻ khi rê chuột — chi tiết " ánh đèn
           hành lang khách sạn" rất hợp thương hiệu, chỉ dùng transform nên mượt. */
        .showcase-glass-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 60%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--brand-gold-light), transparent);
            transition: left 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .showcase-glass-card:hover::before {
            left: 100%;
        }

        .showcase-glass-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.55);
        }

        /* CỘT PHẢI: FORM ĐĂNG NHẬP TRƯỢT TỪ PHẢI VÀO */
        .login-panel {
            flex: 0.85;
            background: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 4rem;
            position: relative;
            box-shadow: -15px 0 35px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            animation: panelCinematicEnter 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;
        }

        @@keyframes panelCinematicEnter {
            0% {
                opacity: 0;
                transform: translateX(60px);
                filter: blur(12px);
            }
            100% {
                opacity: 1;
                transform: translateX(0);
                filter: blur(0);
            }
        }

        /* Quả cầu hào quang xanh navy & vàng thở nhẹ góc form */
        .login-panel::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 280px;
            height: 280px;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.18) 0%, rgba(30, 58, 138, 0.12) 50%, transparent 70%);
            border-radius: 50%;
            filter: blur(35px);
            animation: ambientAuraFloat 10s ease-in-out infinite alternate-reverse;
            pointer-events: none;
            z-index: 0;
        }

        .login-box {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
        }

        .hotel-emblem {
            width: 106px;
            height: 106px;
            padding: 3px;
            overflow: hidden;
            background: #F8FAFC;
            border: 2px solid var(--brand-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.45), 0 12px 26px rgba(30, 58, 138, 0.35);
            margin-bottom: 1.25rem;
            animation: emblemPopEntrance 0.85s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
        }

        /* Dải niềm tin nhỏ ngay dưới logo: phá vỡ mặt bằng trắng phẳng của panel
           và đưa thêm một tầng thông tin trước khi tới form. */
        .login-trust-strip {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.25rem;
            margin-bottom: 1.75rem;
            padding: 0.65rem 0.5rem;
            border-radius: 12px;
            background: linear-gradient(120deg, rgba(30, 58, 138, 0.05), rgba(212, 175, 55, 0.09));
            border: 1px solid rgba(226, 232, 240, 0.9);
            animation: elemCinematicIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
        }

        .login-trust-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.74rem;
            font-weight: 600;
            color: #475569;
            white-space: nowrap;
        }

        .login-trust-item i {
            font-size: 0.9rem;
            color: var(--brand-gold-dark);
        }

        .login-trust-sep {
            width: 1px;
            height: 18px;
            background: #E2E8F0;
        }

        /* =====================================================================
           🔔 HỘP THÔNG BÁO KÍNH SANG TRỌNG — thay cho alert() thô của trình duyệt
           ===================================================================== */
        .hotel-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 1060;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: rgba(9, 15, 32, 0.62);
            -webkit-backdrop-filter: blur(6px);
            backdrop-filter: blur(6px);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.28s;
        }

        .hotel-modal-backdrop.is-open {
            opacity: 1;
            visibility: visible;
        }

        .hotel-modal-card {
            position: relative;
            width: 100%;
            max-width: 400px;
            padding: 2rem 1.75rem 1.5rem;
            border-radius: 24px;
            background: #FFFFFF;
            border: 1px solid rgba(212, 175, 55, 0.55);
            box-shadow: 0 30px 70px -12px rgba(9, 15, 32, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.6) inset;
            text-align: center;
            transform: translateY(18px) scale(0.94);
            opacity: 0;
            transition: transform 0.34s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.28s ease;
        }

        .hotel-modal-backdrop.is-open .hotel-modal-card {
            transform: translateY(0) scale(1);
            opacity: 1;
        }

        .hotel-modal-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 1.1rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #B45309;
            background: linear-gradient(135deg, #FEF3C7, #FDE68A);
            box-shadow: 0 0 0 6px rgba(212, 175, 55, 0.12);
        }

        .hotel-modal-card h5 {
            font-family: var(--font-display, 'Fraunces', serif);
            font-weight: 700;
            color: #0F172A;
            margin-bottom: 0.5rem;
        }

        .hotel-modal-card p {
            color: #475569;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .hotel-emblem img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

        @@keyframes emblemPopEntrance {
            0% {
                opacity: 0;
                transform: scale(0.35) translateY(-35px) rotate(-15deg);
                filter: blur(8px);
            }
            68% {
                opacity: 1;
                transform: scale(1.1) translateY(2px) rotate(2deg);
                filter: blur(0);
            }
            100% {
                opacity: 1;
                transform: scale(1) translateY(0) rotate(0);
            }
        }

        /* STAGGERED POP-UP TỪNG PHẦN TỬ TRONG FORM */
        .login-box h3 {
            animation: elemCinematicIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.26s both;
        }

        .login-box p.text-muted {
            animation: elemCinematicIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.32s both;
        }

        .login-box form > div:nth-of-type(1) {
            animation: elemCinematicIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.38s both;
        }

        .login-box form > div:nth-of-type(2) {
            animation: elemCinematicIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.44s both;
        }

        .login-box form > div:nth-of-type(3) {
            animation: elemCinematicIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.50s both;
        }

        .login-box form > div:nth-of-type(4),
        .login-box .btn-hotel-primary {
            animation: elemCinematicIn 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.56s both;
        }

        .login-box .border-top {
            animation: elemCinematicIn 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.62s both;
        }

        @@keyframes elemCinematicIn {
            0% {
                opacity: 0;
                transform: translateY(24px) scale(0.96);
                filter: blur(5px);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        .form-floating > .form-control {
            border-radius: 12px;
            border: 1.5px solid #E2E8F0;
            padding-left: 2.8rem;
            font-size: 0.95rem;
            transition: all 0.25s ease;
        }

        .form-floating > .form-control:focus {
            border-color: var(--brand-navy);
            box-shadow: 0 0 0 4px rgba(30, 58, 138, 0.12);
            transform: translateY(-1px);
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94A3B8;
            font-size: 1.15rem;
            z-index: 5;
            transition: color 0.25s ease;
        }

        .form-control:focus ~ .input-icon,
        .position-relative:focus-within .input-icon {
            color: var(--brand-navy);
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #64748B;
            cursor: pointer;
            z-index: 5;
            padding: 4px;
            transition: transform 0.2s ease, color 0.2s ease;
        }

        .password-toggle:hover {
            color: var(--brand-navy);
            transform: translateY(-50%) scale(1.15);
        }

        /* =====================================================================
           ✨ HIỆU ỨNG NÚT NỔI BỒNG BỀNH KHI ĐỊNH NHẤN & KHI NHẤN (3D FLOATING BUTTON)
           ===================================================================== */
        .btn-hotel-primary {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%);
            border: 1.5px solid rgba(212, 175, 55, 0.5);
            color: #FFFFFF;
            padding: 0.95rem 1.8rem;
            border-radius: 14px;
            font-weight: 700;
            font-size: 1.02rem;
            letter-spacing: 0.6px;
            cursor: pointer;
            will-change: transform, box-shadow;
            box-shadow: 0 6px 18px -2px rgba(15, 23, 42, 0.35),
                        0 2px 8px -1px rgba(212, 175, 55, 0.2);
            /* Đường cong đàn hồi vật lý lò xo (Spring Physics) */
            transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1),
                        box-shadow 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                        background 0.3s ease,
                        border-color 0.3s ease;
        }

        /* Dải sáng ánh kim lướt qua mặt nút từ react-bits/SpecularButton */
        .btn-hotel-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -130%;
            width: 80%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), rgba(253, 224, 71, 0.4), transparent);
            transform: skewX(-25deg);
            transition: left 0.75s ease;
            pointer-events: none;
        }

        /* KHI ĐỊNH NHẤN (HOVER): Nút nổi bồng bềnh lên cao với bóng đổ sâu */
        .btn-hotel-primary:hover,
        .btn-hotel-primary:focus-visible {
            color: #FFFFFF;
            transform: translateY(-6px) scale(1.028);
            background: linear-gradient(135deg, #2563EB 0%, #1E3A8A 55%, #0F172A 100%);
            border-color: var(--brand-gold-light);
            box-shadow: 0 18px 36px -4px rgba(30, 58, 138, 0.6),
                        0 10px 20px -2px rgba(212, 175, 55, 0.4),
                        0 0 25px rgba(253, 224, 71, 0.3);
        }

        .btn-hotel-primary:hover::before {
            left: 150%;
        }

        /* KHI NHẤN CHUỘT (PRESS/ACTIVE): Nút tiếp tục nổi phồng lên cao đàn hồi (Floating Lift) */
        .btn-hotel-primary:active {
            transform: translateY(-8px) scale(1.05) !important;
            border-color: #FFFFFF !important;
            box-shadow: 0 24px 44px -4px rgba(30, 58, 138, 0.75),
                        0 14px 28px -2px rgba(212, 175, 55, 0.55),
                        0 0 35px rgba(253, 224, 71, 0.5) !important;
            transition: transform 0.16s cubic-bezier(0.2, 0.9, 0.3, 1),
                        box-shadow 0.16s ease !important;
        }

        /* CHIPS DEMO TÀI KHOẢN: CŨNG NỔI LÊN KHI ĐỊNH NHẤN VÀ NHẤN */
        .demo-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            border: 1.5px solid #E2E8F0;
            background: #F8FAFC;
            color: #475569;
            will-change: transform, box-shadow;
            transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1),
                        box-shadow 0.28s ease,
                        border-color 0.25s ease,
                        background 0.25s ease;
        }

        .demo-chip:hover {
            transform: translateY(-4px) scale(1.03);
            background: #FFFFFF;
            box-shadow: 0 10px 20px -2px rgba(15, 23, 42, 0.12);
        }

        .demo-chip:active {
            transform: translateY(-6px) scale(1.06) !important;
            box-shadow: 0 14px 26px -2px rgba(30, 58, 138, 0.25) !important;
        }

        .demo-chip.admin-chip { border-left: 3.5px solid #DC2626; }
        .demo-chip.hr-chip { border-left: 3.5px solid #2563EB; }
        .demo-chip.mgr-chip { border-left: 3.5px solid #D97706; }
        .demo-chip.emp-chip { border-left: 3.5px solid #16A34A; }
        .demo-chip.it-chip { border-left: 3.5px solid #7C3AED; }

        .demo-chip.admin-chip:hover { border-color: #F87171; color: #DC2626; }
        .demo-chip.hr-chip:hover { border-color: #60A5FA; color: #2563EB; }
        .demo-chip.mgr-chip:hover { border-color: #FBBF24; color: #D97706; }
        .demo-chip.emp-chip:hover { border-color: #4ADE80; color: #16A34A; }
        .demo-chip.it-chip:hover { border-color: #A78BFA; color: #7C3AED; }

        /* GỢN SÓNG ÁNH SÁNG SLOW-MO KHI NHẤN NÚT (SLOW-MO RIPPLE) */
        .hotel-login-ripple {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            transform: scale(0);
            opacity: 0.85;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 0%, rgba(253, 224, 71, 0.5) 45%, rgba(212, 175, 55, 0) 75%);
            animation: loginRippleExpand 0.65s cubic-bezier(0.2, 1, 0.3, 1) forwards;
            z-index: 10;
        }

        @@keyframes loginRippleExpand {
            0% { transform: scale(0); opacity: 0.85; }
            100% { transform: scale(3.8); opacity: 0; }
        }

        /* HIỆU ỨNG BLURTEXT: CHỮ TRƯỢT TỪ MỜ MỜ HIỆN RÕ SẮC NÉT */
        @@keyframes blurTextFloatUp {
            0% {
                opacity: 0;
                filter: blur(10px);
                transform: translateY(14px);
            }
            60% {
                opacity: 0.75;
                filter: blur(2px);
            }
            100% {
                opacity: 1;
                filter: blur(0px);
                transform: translateY(0);
            }
        }

        .blur-word {
            display: inline-block;
            animation: blurTextFloatUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
            will-change: transform, filter, opacity;
            white-space: pre;
        }

        .blur-line {
            animation: blurTextFloatUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
            will-change: transform, filter, opacity;
        }

        /* =====================================================================
           🌟 DẢI CHÀO MỪNG (WELCOME RIBBON) — điểm nhấn chuyển động chính
           của trang, chạy ngay khi vừa mở web trước khi đăng nhập.
           ===================================================================== */
        .welcome-ribbon {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 9px 20px 9px 14px;
            margin-bottom: 1.5rem;
            border-radius: 50px;
            background: linear-gradient(100deg, rgba(212, 175, 55, 0.22), rgba(30, 58, 138, 0.28));
            border: 1px solid rgba(253, 224, 71, 0.42);
            box-shadow: 0 10px 28px -8px rgba(0, 0, 0, 0.55);
            overflow: hidden;
            animation: welcomeRibbonIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
            will-change: transform, opacity;
        }

        /* Quầng sáng trượt qua dải — loop vô hạn, chỉ dùng transform (GPU) */
        .welcome-ribbon::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: -60%;
            width: 45%;
            background: linear-gradient(100deg, transparent, rgba(253, 224, 71, 0.32), transparent);
            transform: skewX(-22deg);
            animation: welcomeRibbonSheen 4.2s cubic-bezier(0.4, 0, 0.2, 1) 1.4s infinite;
            pointer-events: none;
        }

        @@keyframes welcomeRibbonIn {
            0% {
                opacity: 0;
                transform: translateY(-18px) scale(0.94);
                filter: blur(8px);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        @@keyframes welcomeRibbonSheen {
            0% { left: -60%; }
            55%, 100% { left: 125%; }
        }

        .welcome-ribbon-icon {
            position: relative;
            width: 30px;
            height: 30px;
            flex: 0 0 30px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            color: #0F172A;
            background: linear-gradient(135deg, var(--brand-gold-light), var(--brand-gold-dark));
            box-shadow: 0 0 0 1px rgba(253, 224, 71, 0.5), 0 4px 12px -2px rgba(212, 175, 55, 0.6);
            animation: welcomeStarPulse 2.6s ease-in-out infinite;
        }

        @@keyframes welcomeStarPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.12); }
        }

        .welcome-ribbon-copy {
            position: relative;
            display: flex;
            flex-direction: column;
            line-height: 1.25;
        }

        .welcome-ribbon-copy small {
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            color: var(--brand-gold-light);
        }

        .welcome-ribbon-copy strong {
            font-size: 0.9rem;
            font-weight: 700;
            color: #FFFFFF;
        }

        /* Ô "đang trực tuyến" nhấp nháy cùng nhịp với ngôi sao */
        .welcome-live {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #4ADE80;
            box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.7);
            animation: welcomeLivePing 2.4s ease-out infinite;
        }

        @@keyframes welcomeLivePing {
            0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.65); }
            70% { box-shadow: 0 0 0 9px rgba(74, 222, 128, 0); }
            100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
        }

        /* Đường kẻ trang trí dưới tiêu đề — vàng kim chạy dài */
        .showcase-rule {
            position: relative;
            width: 168px;
            height: 2px;
            margin-top: 1.6rem;
            background: linear-gradient(90deg, var(--brand-gold), rgba(212, 175, 55, 0));
            border-radius: 2px;
            animation: showcaseRuleGrow 1s cubic-bezier(0.16, 1, 0.3, 1) 0.42s both;
        }

        /* text-white-50 (opacity .5) bị loá trên vùng núi sáng, nên mô tả dùng
           trắng đục gần như đặc kèm bóng đổ mảnh để luôn đọc rõ. */
        .showcase-lead {
            color: rgba(255, 255, 255, 0.92);
            text-shadow: 0 2px 14px rgba(9, 15, 32, 0.75);
            max-width: 480px;
        }

        @@keyframes showcaseRuleGrow {
            0% { transform: scaleX(0); transform-origin: left center; opacity: 0; }
            100% { transform: scaleX(1); transform-origin: left center; opacity: 1; }
        }

        @@media (max-width: 991px) {
            .login-wrapper {
                flex-direction: column;
            }
            .hotel-showcase {
                padding: 2.25rem 1.5rem;
                flex: none;
                min-height: 300px;
                justify-content: center;
            }
            /* Ở màn hình hẹp ảnh gần như không còn vai trò trang trí, dồn tối
               hơn để chữ dễ đọc thay vì để lộ ảnh mờ */
            .hotel-showcase::before {
                background:
                    linear-gradient(180deg, rgba(9, 15, 32, 0.62) 0%, rgba(11, 20, 40, 0.80) 45%, rgba(9, 15, 32, 0.94) 100%);
            }
            .welcome-ribbon {
                margin-bottom: 1.15rem;
            }
            .showcase-rule {
                margin-top: 1.1rem;
            }
            .brand-title {
                font-size: 2.2rem;
            }
            .showcase-glass-card,
            .showcase-content--bottom {
                display: none;
            }
            .login-panel {
                padding: 2.5rem 1.5rem;
            }
            .login-trust-strip {
                gap: 0.85rem;
                margin-bottom: 1.5rem;
            }
        }

        /* Màn hình rất hẹp: bỏ dải niềm tin cho khỏi chật, chỉ giữ biểu tượng */
        @@media (max-width: 575px) {
            .login-trust-item {
                font-size: 0.68rem;
            }
            .login-trust-sep {
                height: 14px;
            }
            .hotel-emblem {
                width: 88px;
                height: 88px;
            }
        }
    </style>
</head>
<body>

<div class="login-wrapper">
    <!-- CỘT TRÁI: SHOWCASE HÌNH ẢNH KHÁCH SẠN 5 SAO THƯỢNG LƯU -->
    <div class="hotel-showcase">
        <!-- Ảnh nền tách lớp riêng để chạy hiệu ứng Ken Burns không kéo theo chữ -->
        <div class="showcase-photo" role="img" aria-label="Sân thượng khách sạn The OverTime lúc hoàng hôn"></div>

        <div class="showcase-content">
            <!-- Dải chào mừng: điểm nhấn chuyển động đầu tiên khi vừa mở web -->
            <div class="welcome-ribbon">
                <span class="welcome-ribbon-icon"><i class="bi bi-stars"></i></span>
                <span class="welcome-ribbon-copy">
                    <small>Xin chào quý khách · Khách sạn 5★</small>
                    <strong>Cổng Quản Trị Nhân Sự</strong>
                </span>
                <span class="welcome-live" aria-hidden="true"></span>
            </div>

            <h1 class="brand-title" id="showcaseBrandTitle">
                The OverTime<br /><span>Hotel &amp; Resort</span>
            </h1>
            <div class="showcase-rule" aria-hidden="true"></div>
            <p class="showcase-lead mt-2 fs-5 blur-line" style="animation-delay: 0.25s;">
                Cổng quản trị thông tin nhân sự và điều hành tiền lương tự động 24/7
            </p>
        </div>

        <div class="showcase-content showcase-content--bottom">
            <div class="showcase-glass-card">
                <div class="d-flex align-items-center mb-3">
                    <div class="text-warning fs-5 me-2">
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <span class="small" style="color: rgba(255, 255, 255, 0.78);">Vận hành liên tục 24 giờ / 7 ngày</span>
                </div>
                <h6 class="fw-bold text-white mb-2">Hệ Thống Quản Trị Nhân Sự Cấp Cao (HRM Enterprise)</h6>
                <p class="small mb-0" style="color: rgba(255, 255, 255, 0.78);">
                    Phân tách cổng quản trị máy chủ (Web Admin) và ứng dụng di động (.NET MAUI App) kết nối đồng bộ cơ sở dữ liệu Supabase Cloud.
                </p>
            </div>
            <div class="mt-4 text-white-50 small">
                &copy; 2026 The OverTime Hotel HRM · Phiên bản .NET 10 &amp; Supabase Cloud
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: FORM ĐĂNG NHẬP SANG TRỌNG -->
    <div class="login-panel">
        <div class="login-box">
            <!-- Logo & Insignia -->
            <div class="text-center mb-4">
                <div class="hotel-emblem mx-auto">
                    <img src="~/images/the-overtime-hotels-logo.png" asp-append-version="true" alt="The OverTime Hotels" />
                </div>
                <h3 class="fw-bold text-dark mb-1" id="loginHeaderTitle" style="font-family: var(--font-display, 'Fraunces', serif);">
                    Đăng Nhập Quản Trị
                </h3>
                <p class="text-muted small blur-line" style="animation-delay: 0.15s;">
                    Nhập thông tin tài khoản được cấp để truy cập hệ thống
                </p>
            </div>

            <!-- Dải niềm tin: bảo mật · Supabase · .NET 10 -->
            <div class="login-trust-strip">
                <span class="login-trust-item"><i class="bi bi-shield-check"></i> Kết nối mã hóa</span>
                <span class="login-trust-sep" aria-hidden="true"></span>
                <span class="login-trust-item"><i class="bi bi-cloud-check"></i> Supabase Cloud</span>
                <span class="login-trust-sep" aria-hidden="true"></span>
                <span class="login-trust-item"><i class="bi bi-cpu"></i> .NET 10</span>
            </div>

            <!-- THÔNG BÁO LỖI NẾU CÓ -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3 border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                        <div class="small" asp-validation-summary="All"></div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- THÔNG BÁO CHẶN PHÂN QUYỀN -->
            @if (ViewBag.RoleNotice != null)
            {
                <div class="alert alert-warning alert-dismissible fade show p-3 mb-4 border-0 shadow-sm" role="alert">
                    <div class="d-flex">
                        <i class="bi bi-phone text-warning fs-3 me-3"></i>
                        <div>
                            <h6 class="alert-heading fw-bold mb-1">Hướng Dẫn Phân Quyền Vai Trò</h6>
                            <p class="small mb-0 text-dark">@ViewBag.RoleNotice</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- FORM ĐĂNG NHẬP -->
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="position-relative mb-3">
                    <i class="bi bi-person input-icon"></i>
                    <div class="form-floating">
                        <input asp-for="Username" id="usernameInput" class="form-control" placeholder="Tên đăng nhập" required autocomplete="username" />
                        <label asp-for="Username" style="padding-left: 2.8rem;">Tên đăng nhập</label>
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="position-relative mb-3">
                    <i class="bi bi-shield-lock input-icon"></i>
                    <div class="form-floating">
                        <input asp-for="Password" id="passwordInput" class="form-control" placeholder="Mật khẩu" required autocomplete="current-password" />
                        <label asp-for="Password" style="padding-left: 2.8rem;">Mật khẩu</label>
                    </div>
                    <span class="password-toggle" id="togglePasswordBtn" title="Hiện/Ẩn mật khẩu">
                        <i class="bi bi-eye" id="togglePasswordIcon"></i>
                    </span>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberCheck">
                        <label class="form-check-label small text-muted" for="rememberCheck">
                            Ghi nhớ 7 ngày
                        </label>
                    </div>
                    <a href="#" id="forgotPasswordLink" class="small text-decoration-none text-primary fw-semibold">
                        Quên mật khẩu?
                    </a>
                </div>

                <!-- NÚT NỔI 3D BỒNG BỀNH ĐĂNG NHẬP HỆ THỐNG -->
                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-hotel-primary" id="loginSubmitBtn">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Đăng Nhập Hệ Thống
                    </button>
                </div>
            </form>

            <!-- KHU VỰC TÀI KHOẢN DEMO -->
            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: 0.5px; font-size: 0.75rem;">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Tài khoản Demo nhanh:
                    </span>
                    <span class="badge bg-light text-secondary border font-monospace">Click để điền</span>
                </div>
                <div class="alert alert-info py-2 px-3 small border-0 mb-3" style="font-size: 0.8rem; background-color: #f0f9ff; color: #0369a1;">
                    <i class="bi bi-info-circle-fill me-1 text-info"></i> Chọn <strong>IT (Bảo)</strong> để quản lý tài khoản, phân quyền và sao lưu.
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="demo-chip admin-chip" onclick="fillAccount('admin', 'Admin@123')">
                        <i class="bi bi-shield-shaded text-danger"></i> Admin (Cường)
                    </button>
                    <button type="button" class="demo-chip it-chip" onclick="fillAccount('it_bao', 'Overtime@2026')">
                        <i class="bi bi-terminal-fill" style="color: #7C3AED;"></i> IT (Bảo)
                    </button>
                    <button type="button" class="demo-chip hr-chip" onclick="fillAccount('hr_sang', 'Hr@123')">
                        <i class="bi bi-person-badge text-primary"></i> HR (Sang)
                    </button>
                    <button type="button" class="demo-chip mgr-chip" onclick="fillAccount('mgr_long', 'Manager@123')">
                        <i class="bi bi-person-workspace text-warning"></i> Manager (Long)
                    </button>
                    <button type="button" class="demo-chip mgr-chip" onclick="fillAccount('emp_bao', 'Emp@123')">
                        <i class="bi bi-person-workspace text-warning"></i> Manager (Bảo)
                    </button>
                    <button type="button" class="demo-chip emp-chip" onclick="fillAccount('emp_linh', 'Overtime@2026')">
                        <i class="bi bi-person text-success"></i> Employee (Linh)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- HỘP THÔNG BÁO KÍNH SANG TRỌNG (thay cho alert() thô của trình duyệt) -->
<div class="hotel-modal-backdrop" id="hotelModalBackdrop" role="dialog" aria-modal="true" aria-labelledby="hotelModalTitle" aria-hidden="true">
    <div class="hotel-modal-card">
        <div class="hotel-modal-icon"><i class="bi bi-key"></i></div>
        <h5 id="hotelModalTitle">Quên mật khẩu</h5>
        <p>Vui lòng liên hệ <b>Quản trị viên (Admin)</b> hoặc <b>Chuyên viên Nhân sự</b> để được cấp lại mật khẩu.</p>
        <button type="button" class="btn btn-hotel-primary w-100" id="hotelModalClose">
            <i class="bi bi-check2 me-2"></i>Đã hiểu
        </button>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // 1. Tách từng từ làm hiệu ứng BlurText (từ mờ lướt lên rõ)
    function triggerBlurText(elId) {
        const el = document.getElementById(elId);
        if (!el) return;

        const nodes = Array.from(el.childNodes);
        el.innerHTML = '';
        let wordIndex = 0;

        nodes.forEach(function (node) {
            if (node.nodeType === Node.TEXT_NODE) {
                const words = node.textContent.split(/(\s+)/);
                words.forEach(function (w) {
                    if (w.trim().length > 0) {
                        const span = document.createElement('span');
                        span.className = 'blur-word';
                        span.style.animationDelay = (0.05 + wordIndex * 0.05).toFixed(2) + 's';
                        span.textContent = w;
                        el.appendChild(span);
                        wordIndex++;
                    } else if (w.length > 0) {
                        el.appendChild(document.createTextNode(w));
                    }
                });
            } else if (node.nodeName === 'BR') {
                el.appendChild(document.createElement('br'));
            } else {
                const wrapper = document.createElement('span');
                wrapper.className = 'blur-word';
                wrapper.style.animationDelay = (0.05 + wordIndex * 0.05).toFixed(2) + 's';
                wrapper.appendChild(node.cloneNode(true));
                el.appendChild(wrapper);
                wordIndex++;
            }
        });
    }

    // Chạy BlurText cho cả tiêu đề Showcase lẫn tiêu đề Đăng Nhập
    document.addEventListener('DOMContentLoaded', function () {
        triggerBlurText('showcaseBrandTitle');
        triggerBlurText('loginHeaderTitle');
    });

    // 2. Hiệu ứng gợn sóng ánh sáng hoàng gia khi nhấn chuột vào nút nổi
    document.addEventListener('pointerdown', function (e) {
        const btn = e.target.closest('.btn-hotel-primary, .demo-chip');
        if (!btn) return;

        const rect = btn.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height) * 1.4;
        const x = e.clientX - rect.left - size / 2;
        const y = e.clientY - rect.top - size / 2;

        const ripple = document.createElement('span');
        ripple.className = 'hotel-login-ripple';
        ripple.style.width = size + 'px';
        ripple.style.height = size + 'px';
        ripple.style.left = x + 'px';
        ripple.style.top = y + 'px';

        btn.appendChild(ripple);
        setTimeout(function () {
            if (ripple.parentNode) ripple.parentNode.removeChild(ripple);
        }, 650);
    }, { passive: true });

    // 3. Hàm bật/tắt hiển thị mật khẩu
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const passwordInput = document.getElementById('passwordInput');
    const toggleIcon = document.getElementById('togglePasswordIcon');

    if (toggleBtn && passwordInput && toggleIcon) {
        toggleBtn.addEventListener('click', function () {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            toggleIcon.classList.toggle('bi-eye');
            toggleIcon.classList.toggle('bi-eye-slash');
        });
    }

    // 5. Hàm tự động điền tài khoản test nhanh
    function fillAccount(username, password) {
        const usernameField = document.getElementById('usernameInput');
        const passwordField = document.getElementById('passwordInput');

        usernameField.value = username;
        passwordField.value = password;
        usernameField.focus();

        // Gợi sóng nhấp nháy trên hai ô vừa điền để người dùng thấy rõ thay đổi
        [usernameField, passwordField].forEach(function (input) {
            input.style.transition = 'none';
            input.style.borderColor = '#D4AF37';
            input.style.boxShadow = '0 0 0 4px rgba(212, 175, 55, 0.18)';
            requestAnimationFrame(function () {
                input.style.transition = 'border-color 0.5s ease, box-shadow 0.5s ease';
                input.style.borderColor = '';
                input.style.boxShadow = '';
            });
        });
    }

    // 6. Hộp thoại kính sang trọng — thay cho alert() thô của trình duyệt
    const modalBackdrop = document.getElementById('hotelModalBackdrop');
    const modalCloseBtn = document.getElementById('hotelModalClose');
    const forgotLink = document.getElementById('forgotPasswordLink');

    function openHotelModal() {
        modalBackdrop.classList.add('is-open');
        modalBackdrop.setAttribute('aria-hidden', 'false');

        // Chưa focus được ngay: backdrop đang chuyển visibility trong 0.28s mà
        // phần tử visibility:hidden thì trình duyệt không cho nhận focus.
        // Chờ hiệu ứng mờ (opacity) chạy xong rồi mới chuyển tiêu điểm vào nút.
        function grabFocus(e) {
            if (e.propertyName !== 'opacity') return;
            modalBackdrop.removeEventListener('transitionend', grabFocus);
            modalCloseBtn.focus();
        }
        modalBackdrop.addEventListener('transitionend', grabFocus);
    }

    function closeHotelModal() {
        modalBackdrop.classList.remove('is-open');
        modalBackdrop.setAttribute('aria-hidden', 'true');
        forgotLink.focus();
    }

    forgotLink.addEventListener('click', function (e) {
        e.preventDefault();
        openHotelModal();
    });

    modalCloseBtn.addEventListener('click', closeHotelModal);

    // Click ra ngoài thẻ thì đóng, giống hành vi của hộp thoại phổ biến
    modalBackdrop.addEventListener('click', function (e) {
        if (e.target === modalBackdrop) closeHotelModal();
    });

    // Bấm phím Esc để thoát
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && modalBackdrop.classList.contains('is-open')) {
            closeHotelModal();
        }
    });
</script>

</body>
</html>
