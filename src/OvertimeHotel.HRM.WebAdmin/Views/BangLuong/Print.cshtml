@model OvertimeHotel.HRM.WebAdmin.Models.PhieuLuongDetailViewModel
@{
    Layout = null; // Mẫu in độc lập không kèm layout admin shell
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu lương · @Model.HoTen · Tháng @Model.Thang:D2/@Model.Nam</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Fraunces:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, sans-serif;
            color: #1e293b;
            background: #f8fafc;
            padding: 30px 15px;
        }
        .payslip-sheet {
            max-width: 820px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #e2e8f0;
        }
        .hotel-brand-title {
            font-family: 'Fraunces', serif;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.02em;
        }
        .table-payslip th, .table-payslip td {
            padding: 0.6rem 0.75rem;
            border-color: #e2e8f0;
            font-size: 0.88rem;
        }
        .table-payslip th {
            background-color: #f8fafc;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
        }
        .font-num {
            font-variant-numeric: tabular-nums;
        }
        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .payslip-sheet {
                box-shadow: none;
                border: none;
                padding: 10px 0;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- THANH CÔNG CỤ IN NỔI TRÊN WEB (ẨN KHI IN THẬT) -->
    <div class="no-print d-flex justify-content-center gap-2 mb-4">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-printer me-1"></i> In phiếu lương ngay
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-x-lg me-1"></i> Đóng
        </button>
    </div>

    <!-- KHUNG IN CHUẨN QUESTPDF / A4 THEO PRD 05 -->
    <div class="payslip-sheet printable-payslip">

        <!-- HEADER: LOGO, TÊN KHÁCH SẠN VÀ THÔNG TIN PHIẾU LƯƠNG -->
        <div class="row align-items-center pb-3 mb-3 border-bottom border-2">
            <div class="col-7">
                <div class="d-flex align-items-center gap-3">
                    <img src="~/images/the-overtime-hotels-logo.png" alt="Logo" style="height: 52px;" onerror="this.style.display='none'" />
                    <div>
                        <div class="hotel-brand-title fs-4">The OverTime Hotel</div>
                        <div class="small text-muted">Hệ thống Khách sạn &amp; Nghỉ dưỡng 5★ cao cấp</div>
                        <div class="small text-muted" style="font-size: 0.75rem;">Địa chỉ: 123 Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh</div>
                    </div>
                </div>
            </div>
            <div class="col-5 text-end">
                <h4 class="fw-bold mb-1 text-primary text-uppercase">Phiếu Lương Tháng @Model.Thang:D2/@Model.Nam</h4>
                <div class="small text-muted">Số phiếu: <strong>#PL-@Model.Thang:D2@Model.Nam-@Model.MaNvFormatted</strong></div>
                <div class="small text-muted">Kỳ: @Model.TuNgay.ToString("dd/MM/yyyy") &rarr; @Model.DenNgay.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <!-- THÔNG TIN NHÂN SỰ -->
        <div class="bg-light rounded-3 p-3 mb-4">
            <div class="row g-2 small">
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Họ và tên:</span> <strong class="text-dark">@Model.HoTen</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Mã nhân viên:</span> <strong class="text-dark font-monospace">@Model.MaNvFormatted</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Phòng ban:</span> <strong class="text-dark">@Model.PhongBan</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Chức vụ:</span> <strong class="text-dark">@Model.ChucVu</strong>
                </div>

                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Lương cơ bản HĐLĐ:</span> <strong class="font-num text-primary">@Model.LuongCoBan.ToString("N0") đ</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Số ngày công chuẩn:</span> <strong>26 ngày</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Ngày công thực tế:</span> <strong class="text-success font-num">@Model.NgayCongThucTe.ToString("N1") ngày</strong>
                </div>
                <div class="col-sm-6 col-md-3">
                    <span class="text-muted">Trạng thái:</span> <strong class="text-success">Đã đối soát</strong>
                </div>
            </div>
        </div>

        <!-- 1. BẢNG THU NHẬP (GROSS) - TẦNG 1 -->
        <div class="mb-4">
            <h6 class="fw-bold text-success text-uppercase mb-2 d-flex align-items-center gap-1">
                <i class="bi bi-plus-circle"></i> Bảng 1: Các Khoản Thu Nhập (Gross)
            </h6>
            <table class="table table-bordered table-payslip mb-0">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 40%;">Khoản mục</th>
                        <th style="width: 35%;">Công thức / Diễn giải</th>
                        <th style="width: 20%;" class="text-end">Số tiền (VNĐ)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td class="fw-semibold">Lương ngày công thực tế</td>
                        <td class="text-muted small">(@Model.LuongCoBan.ToString("N0") / 26) x @Model.NgayCongThucTe.ToString("N1")</td>
                        <td class="text-end font-num">@Model.TienLuongCong.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td class="fw-semibold">Tiền làm thêm giờ (OT)</td>
                        <td class="text-muted small">
                            @if (Model.OvertimeItems.Count > 0)
                            {
                                @string.Join("; ", Model.OvertimeItems.Select(o => $"{o.TenKhoan}: {o.GhiChu}"))
                            }
                            else
                            {
                                <span>Không phát sinh</span>
                            }
                        </td>
                        <td class="text-end font-num">@Model.TienTangCa.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td class="fw-semibold">Phụ cấp ca đêm (30%)</td>
                        <td class="text-muted small">@(Model.NightShiftItem?.GhiChu ?? "Không phát sinh ca đêm")</td>
                        <td class="text-end font-num">@Model.TienCaDem.ToString("N0")</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td class="fw-semibold">Phụ cấp ăn ca</td>
                        <td class="text-muted small">@(Model.MealAllowanceItem?.GhiChu ?? "30.000đ/ngày công thực tế (Miễn thuế TNCN)")</td>
                        <td class="text-end font-num">@Model.TienAnCa.ToString("N0")</td>
                    </tr>
                    @if (Model.OtherAllowances.Count > 0)
                    {
                        <tr>
                            <td>5</td>
                            <td class="fw-semibold">Phụ cấp chức vụ &amp; điều hành</td>
                            <td class="text-muted small">@string.Join("; ", Model.OtherAllowances.Select(o => o.TenKhoan))</td>
                            <td class="text-end font-num">@Model.OtherAllowances.Sum(o => o.SoTien).ToString("N0")</td>
                        </tr>
                    }
                    @if (Model.EventAllowances.Count > 0)
                    {
                        <tr>
                            <td>6</td>
                            <td class="fw-semibold">Thưởng Sự kiện / Dự án khách sạn</td>
                            <td class="text-muted small">@string.Join("; ", Model.EventAllowances.Select(e => e.TenKhoan))</td>
                            <td class="text-end font-num">@Model.EventAllowances.Sum(e => e.SoTien).ToString("N0")</td>
                        </tr>
                    }
                    @if (Model.BonusItems.Count > 0)
                    {
                        <tr>
                            <td>7</td>
                            <td class="fw-semibold">Tiền thưởng khác &amp; Phí phục vụ (Service Charge)</td>
                            <td class="text-muted small">@string.Join("; ", Model.BonusItems.Select(b => b.TenKhoan))</td>
                            <td class="text-end font-num">@Model.BonusItems.Sum(b => b.SoTien).ToString("N0")</td>
                        </tr>
                    }
                    <tr class="table-success fw-bold">
                        <td colspan="3" class="text-uppercase text-success">TỔNG THU NHẬP (GROSS)</td>
                        <td class="text-end font-num text-success fs-6">@Model.TongGross.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- 2. BẢNG KHẤU TRỪ - TẦNG 2 -->
        <div class="mb-4">
            <h6 class="fw-bold text-danger text-uppercase mb-2 d-flex align-items-center gap-1">
                <i class="bi bi-dash-circle"></i> Bảng 2: Các Khoản Khấu Trừ
            </h6>
            <table class="table table-bordered table-payslip mb-0">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 40%;">Khoản mục</th>
                        <th style="width: 35%;">Công thức / Tỷ lệ</th>
                        <th style="width: 20%;" class="text-end">Số tiền (VNĐ)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td class="fw-semibold">Bảo hiểm xã hội (BHXH)</td>
                        <td class="text-muted small">8.0% x Lương cơ bản</td>
                        <td class="text-end font-num">@(Model.Insurance?.TienBhxh.ToString("N0") ?? "0")</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td class="fw-semibold">Bảo hiểm y tế (BHYT)</td>
                        <td class="text-muted small">1.5% x Lương cơ bản</td>
                        <td class="text-end font-num">@(Model.Insurance?.TienBhyt.ToString("N0") ?? "0")</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td class="fw-semibold">Bảo hiểm thất nghiệp (BHTN)</td>
                        <td class="text-muted small">1.0% x Lương cơ bản</td>
                        <td class="text-end font-num">@(Model.Insurance?.TienBhtn.ToString("N0") ?? "0")</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td class="fw-semibold">Thuế thu nhập cá nhân (TNCN)</td>
                        <td class="text-muted small">Biểu thuế lũy tiến từng phần sau trừ gia cảnh 11tr</td>
                        <td class="text-end font-num">@Model.TienThue.ToString("N0")</td>
                    </tr>
                    @if (Model.Violations.Count > 0)
                    {
                        <tr>
                            <td>5</td>
                            <td class="fw-semibold text-danger">Phạt vi phạm kỷ luật &amp; chấm công</td>
                            <td class="text-muted small">@string.Join("; ", Model.Violations.Select(v => v.LyDoChiTiet))</td>
                            <td class="text-end font-num text-danger">@Model.TongTienPhat.ToString("N0")</td>
                        </tr>
                    }
                    @if (Model.AdvanceItems.Count > 0)
                    {
                        <tr>
                            <td>6</td>
                            <td class="fw-semibold">Khấu trừ khác</td>
                            <td class="text-muted small">@string.Join("; ", Model.AdvanceItems.Select(a => a.TenKhoan))</td>
                            <td class="text-end font-num">@Model.AdvanceItems.Sum(a => a.SoTien).ToString("N0")</td>
                        </tr>
                    }
                    <tr class="table-danger fw-bold">
                        <td colspan="3" class="text-uppercase text-danger">TỔNG KHẤU TRỪ</td>
                        <td class="text-end font-num text-danger fs-6">@Model.TongKhauTru.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- DÒNG TỔNG KẾT: LƯƠNG NET THỰC NHẬN CHUẨN PRD 05 -->
        <div class="border border-2 border-dark rounded-3 p-3 bg-light mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fs-5 fw-bold text-uppercase text-dark">LƯƠNG THỰC NHẬN (NET):</span>
                <span class="fs-3 fw-bold font-num text-primary">@Model.ThucNhan.ToString("N0") VNĐ</span>
            </div>
            <div class="fst-italic text-muted">
                Số tiền viết bằng chữ: <strong class="text-dark">@Model.ThucNhanBangChu</strong>
            </div>
            <div class="small text-muted mt-2 border-top pt-2 d-flex justify-content-between">
                <span>(Net = Tổng Gross @Model.TongGross.ToString("N0") đ − Tổng Khấu Trừ @Model.TongKhauTru.ToString("N0") đ)</span>
                <span class="text-success fw-semibold"><i class="bi bi-shield-check"></i> Khớp số học 100%</span>
            </div>
        </div>

        <!-- PHẦN KÝ TÊN XÁC NHẬN CHUẨN KẾ TOÁN DOANH NGHIỆP -->
        <div class="row text-center mt-5 pt-3">
            <div class="col-4">
                <div class="fw-bold mb-1">Người lập phiếu</div>
                <div class="small text-muted mb-5">(Ký, họ tên)</div>
                <div class="fw-semibold text-dark mt-4">Phòng Nhân sự</div>
            </div>
            <div class="col-4">
                <div class="fw-bold mb-1">Kế toán trưởng</div>
                <div class="small text-muted mb-5">(Ký, họ tên)</div>
                <div class="fw-semibold text-dark mt-4">Kế toán Tiền lương</div>
            </div>
            <div class="col-4">
                <div class="fw-bold mb-1">Người lao động</div>
                <div class="small text-muted mb-5">(Ký, xác nhận)</div>
                <div class="fw-semibold text-dark mt-4">@Model.HoTen</div>
            </div>
        </div>

        <div class="text-center text-muted small mt-4 pt-3 border-top" style="font-size: 0.72rem;">
            Phiếu lương này được phát hành tự động từ Hệ thống Quản trị Nhân sự The OverTime Hotel &bull; Mọi thắc mắc đối chiếu vui lòng liên hệ Phòng Nhân sự trong vòng 03 ngày làm việc.
        </div>

    </div>

</body>
</html>
