@model OvertimeHotel.HRM.WebAdmin.Models.PhieuLuongDetailViewModel
@{
    ViewData["Title"] = $"Phiếu lương · {Model.HoTen} ({Model.MaNvFormatted}) · T{Model.Thang:D2}/{Model.Nam}";
}

<link rel="stylesheet" href="~/css/payroll.css" asp-append-version="true" />
<div class="container-fluid px-3 px-md-4 py-3 payroll-workspace">

    <!-- THANH ĐIỀU HƯỚNG & HÀNH ĐỘNG -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" asp-route-thang="@Model.Thang" asp-route-nam="@Model.Nam" class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <div class="d-flex align-items-center gap-2 text-muted small">
                    <span class="badge bg-dark rounded-pill">@Model.MaNvFormatted</span>
                    <span>@Model.PhongBan</span>
                    <span>&bull;</span>
                    <span>@Model.ChucVu</span>
                </div>
                <h2 class="h3 fw-bold mb-0 text-dark">
                    Phiếu lương chi tiết: @Model.HoTen
                </h2>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="Print" asp-route-id="@Model.MaPhieuLuong" target="_blank" class="btn btn-dark rounded-pill px-3 shadow-sm">
                <i class="bi bi-printer me-1"></i> In phiếu lương / PDF
            </a>

            @if (Model.CanEdit)
            {
                <form method="post" asp-action="RecalculateEmployee" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MaPhieuLuong" />
                    <button type="submit" class="btn btn-outline-primary rounded-pill px-3 shadow-xs" onclick="return confirm('Tính lại toàn bộ số liệu công, tăng ca và khấu trừ của nhân viên này?');">
                        <i class="bi bi-arrow-clockwise me-1"></i> Tính lại phiếu này
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- THÂN PHIẾU LƯƠNG: dùng chung với popup nhiều tab ở trang danh sách -->
    <div class="payslip-detail-body">
        <partial name="_PayslipDetailBody" model="Model" />
    </div>

</div>

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
