@model OvertimeHotel.HRM.WebAdmin.Models.PhieuLuongDetailViewModel
@{
    // Thân phiếu lương dùng chung cho cả trang riêng (/BangLuong/Detail) và popup nhiều tab
    // ở trang danh sách. Nhờ vậy hai nơi không bao giờ lệch số liệu.
    var tabBase = $"payslip-tab-{Model.MaPhieuLuong}";
}

<!-- THÔNG BÁO FLASH MESSAGE -->
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div>@Model.SuccessMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<!-- HÀNG TAB: chuyển tab tại chỗ, không nạp lại trang (Zero Full-Page Reload) -->
<div class="payslip-tabs" role="tablist" aria-label="Các phần của phiếu lương">
    <button type="button" class="payslip-tab is-active" role="tab" aria-selected="true"
            data-payslip-tab="tongquan" aria-controls="@tabBase-tongquan">
        <i class="bi bi-clipboard-data" aria-hidden="true"></i> Tổng quan
    </button>
    <button type="button" class="payslip-tab" role="tab" aria-selected="false" tabindex="-1"
            data-payslip-tab="thunhap" aria-controls="@tabBase-thunhap">
        <i class="bi bi-plus-circle" aria-hidden="true"></i> Thu nhập
        <span class="payslip-tab-amount text-success">@Model.TongGross.ToString("N0")</span>
    </button>
    <button type="button" class="payslip-tab" role="tab" aria-selected="false" tabindex="-1"
            data-payslip-tab="khautru" aria-controls="@tabBase-khautru">
        <i class="bi bi-dash-circle" aria-hidden="true"></i> Khấu trừ
        <span class="payslip-tab-amount text-danger">@Model.TongKhauTru.ToString("N0")</span>
    </button>
    <button type="button" class="payslip-tab" role="tab" aria-selected="false" tabindex="-1"
            data-payslip-tab="dieuchinh" aria-controls="@tabBase-dieuchinh">
        <i class="bi bi-sliders" aria-hidden="true"></i> Điều chỉnh
    </button>
</div>

<div class="payslip-tab-panes">

    <!-- ===== TAB 1: TỔNG QUAN ===== -->
    <section class="payslip-pane is-active" id="@tabBase-tongquan" role="tabpanel" tabindex="0">
        <!-- BANNER TỔNG QUAN HỒ SƠ & BẤT BIẾN CÂN BẰNG -->
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center">
                    <div class="col-md-3">
                        <div class="small text-muted">Kỳ chi trả</div>
                        <div class="fw-bold fs-5 text-dark">Tháng @Model.Thang.ToString("D2")/@Model.Nam</div>
                        <div class="small text-muted">(@Model.TuNgay.ToString("dd/MM/yyyy") - @Model.DenNgay.ToString("dd/MM/yyyy"))</div>
                    </div>
                    <div class="col-md-3">
                        <div class="small text-muted">Lương cơ bản theo HĐLĐ</div>
                        <div class="fw-bold fs-5 font-monospace text-primary">@Model.LuongCoBan.ToString("N0") đ</div>
                        <div class="small text-muted">Đơn giá ngày: @((Model.LuongCoBan / 26).ToString("N0")) đ/ngày</div>
                    </div>
                    <div class="col-md-3">
                        <div class="small text-muted">Ngày công thực tế</div>
                        <div class="fw-bold fs-5 text-success">@Model.NgayCongThucTe.ToString("N1") <span class="fs-6 fw-normal text-muted">/ 26 ngày chuẩn</span></div>
                        <div class="small text-muted">Tính từ ca check-in &amp; phép duyệt</div>
                    </div>
                    <div class="col-md-3">
                        <div class="small text-muted">Trạng thái khóa sổ</div>
                        <div>
                            <span class="badge @(Model.IsLocked ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-1">
                                @(Model.IsLocked ? "Đã khóa sổ (Bất biến)" : "Bản nháp (Được phép sửa)")
                            </span>
                        </div>
                        @if (Model.IsBalanced)
                        {
                            <div class="small text-success mt-1 fw-semibold">
                                <i class="bi bi-check2-circle me-1"></i> Bất biến cân bằng 100%
                            </div>
                        }
                        else
                        {
                            <div class="small text-danger mt-1 fw-semibold">
                                <i class="bi bi-exclamation-diamond-fill me-1"></i> Lệch số học
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG TỔNG HỢP NGÀY CÔNG, TĂNG CA & KỶ LUẬT LAO ĐỘNG -->
        <div class="card border-0 shadow-sm rounded-4 mb-3">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <div class="fw-bold text-dark small text-uppercase tracking-wider d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-check text-primary"></i>
                        <span>Tổng hợp Ngày công, Tăng ca &amp; Kỷ luật lao động</span>
                    </div>
                    <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1 small">
                        Chuẩn tháng: @Model.CongChuan ngày
                    </span>
                </div>
                <div class="row g-2">
                    <!-- 1. Ngày công -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="p-2.5 rounded-3 bg-light border h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="small text-muted fw-semibold">1. Ngày công</span>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Tính lương: @Model.NgayCongThucTe.ToString("N1")</span>
                            </div>
                            <div class="h5 fw-bold text-dark my-1">
                                @Model.NgayDiLam.ToString("N1") <small class="fs-6 fw-normal text-muted">ngày làm thực tế</small>
                            </div>
                            <div class="small text-muted" style="font-size: 0.78rem;">
                                Phép có lương: <strong class="text-success">@Model.NgayNghiPhep.ToString("N1")</strong> ngày
                            </div>
                        </div>
                    </div>

                    <!-- 2. Giờ tăng ca (OT) -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="p-2.5 rounded-3 bg-light border h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="small text-muted fw-semibold">2. Tăng ca (OT)</span>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">@Model.TongGioOt.ToString("N1") giờ</span>
                            </div>
                            <div class="h5 fw-bold text-primary my-1">
                                @Model.TongGioOt.ToString("N1") <small class="fs-6 fw-normal text-muted">giờ</small>
                            </div>
                            <div class="small text-muted" style="font-size: 0.78rem;">
                                Thường: <strong>@Model.GioOtThuong.ToString("N1")h</strong> &bull; Nghỉ: <strong>@Model.GioOtCuoiTuan.ToString("N1")h</strong> &bull; Lễ: <strong>@Model.GioOtNgayLe.ToString("N1")h</strong>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Nghỉ & Bỏ ca -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="p-2.5 rounded-3 bg-light border h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="small text-muted fw-semibold">3. Nghỉ &amp; Bỏ ca</span>
                                @if (Model.SoCaBo > 0)
                                {
                                    <span class="badge bg-danger rounded-pill">Bỏ @Model.SoCaBo ca</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">Không bỏ ca</span>
                                }
                            </div>
                            <div class="h5 fw-bold @(Model.SoCaBo > 0 ? "text-danger" : "text-dark") my-1">
                                @(Model.NgayNghiKhongLuong + Model.SoCaBo) <small class="fs-6 fw-normal text-muted">buổi vắng</small>
                            </div>
                            <div class="small text-muted" style="font-size: 0.78rem;">
                                Không lương: <strong>@Model.NgayNghiKhongLuong</strong> ng &bull; Bỏ ca: <strong class="@(Model.SoCaBo > 0 ? "text-danger" : "text-dark")">@Model.SoCaBo</strong> ca
                            </div>
                        </div>
                    </div>

                    <!-- 4. Kỷ luật Chấm công -->
                    <div class="col-sm-6 col-lg-3">
                        <div class="p-2.5 rounded-3 bg-light border h-100">
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="small text-muted fw-semibold">4. Kỷ luật giờ giấc</span>
                                @if (Model.SoLanDiMuon > 0 || Model.SoLanVeSom > 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill">Phạt @Model.TongTienPhat.ToString("N0")đ</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Đúng giờ 100%</span>
                                }
                            </div>
                            <div class="h5 fw-bold @(Model.SoLanDiMuon > 0 ? "text-danger" : "text-success") my-1">
                                @Model.SoLanDiMuon <small class="fs-6 fw-normal text-muted">lần trễ (@Model.TongPhutDiMuon p)</small>
                            </div>
                            <div class="small text-muted" style="font-size: 0.78rem;">
                                Về sớm: <strong>@Model.SoLanVeSom</strong> lần (@Model.TongPhutVeSom p)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CÔNG THỨC 2 TẦNG THU GỌN: GROSS − KHẤU TRỪ = NET -->
        <div class="payroll-net-card rounded-4 overflow-hidden">
            <div class="p-3 p-md-4 text-white">
                <div class="row align-items-center g-3">
                    <div class="col-lg-6">
                        <div class="text-uppercase small tracking-wider text-warning fw-bold mb-1">
                            <i class="bi bi-gem me-1"></i> The OverTime Hotel · Lương Thực Nhận (Net)
                        </div>
                        <div class="h2 font-monospace fw-bold mb-2 text-white">
                            @Model.ThucNhan.ToString("N0") <span class="fs-4 fw-normal text-white-50">VNĐ</span>
                        </div>
                        <div class="text-white-50 fst-italic">
                            Viết bằng chữ: <strong>@Model.ThucNhanBangChu</strong>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="row g-2">
                            <div class="col-12">
                                <div class="payroll-net-line">
                                    <span class="text-white-50">Tổng Gross (Tầng 1)</span>
                                    <span class="font-monospace fw-bold text-white">@Model.TongGross.ToString("N0") đ</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="payroll-net-line">
                                    <span class="text-white-50">Tổng khấu trừ (Tầng 2)</span>
                                    <span class="font-monospace fw-bold text-white">− @Model.TongKhauTru.ToString("N0") đ</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-semibold">
                                    Net = Gross (@Model.TongGross.ToString("N0")) − Khấu trừ (@Model.TongKhauTru.ToString("N0"))
                                </span>
                            </div>
                            @if (Model.EventAllowances.Count > 0)
                            {
                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-2 small text-warning bg-white bg-opacity-10 rounded-pill px-3 py-1.5 border border-warning border-opacity-25">
                                        <i class="bi bi-stars"></i>
                                        <span>Gồm <strong>@Model.EventAllowances.Sum(e => e.SoTien).ToString("N0") đ</strong> tiền sự kiện theo quyết toán đã lưu</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== TAB 2: THU NHẬP (TẦNG 1 — GROSS) ===== -->
    <section class="payslip-pane" id="@tabBase-thunhap" role="tabpanel" tabindex="0" hidden>
        <div class="payroll-payslip-card">
            <div class="payroll-tier-header payroll-tier-income">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-plus-circle-fill fs-5"></i>
                    <span>TẦNG 1: TỔNG THU NHẬP (GROSS)</span>
                </span>
                <span class="fs-5 font-monospace fw-bold">@Model.TongGross.ToString("N0") đ</span>
            </div>

            <div class="p-3 p-md-4">
                <!-- 1. Lương ngày công thực tế -->
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <div class="fw-semibold text-dark">1. Lương ngày công thực tế</div>
                        <div class="small text-muted">(@Model.LuongCoBan.ToString("N0") / 26) x @Model.NgayCongThucTe.ToString("N1") ngày</div>
                    </div>
                    <div class="font-monospace fw-bold fs-6 text-dark">@Model.TienLuongCong.ToString("N0") đ</div>
                </div>

                <!-- 2. Tiền tăng ca (OT) -->
                <div class="py-2 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold text-dark">2. Tiền làm thêm giờ (OT)</div>
                            <div class="small text-muted">Đơn giá giờ: @((Model.LuongCoBan / (26 * 8)).ToString("N0")) đ/h</div>
                        </div>
                        <div class="font-monospace fw-bold fs-6 text-dark">@Model.TienTangCa.ToString("N0") đ</div>
                    </div>
                    @if (Model.OvertimeItems.Count > 0)
                    {
                        <div class="bg-light rounded-3 p-2 mt-2 small">
                            @foreach (var ot in Model.OvertimeItems)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1">
                                    <span class="text-muted">&bull; @ot.TenKhoan (@ot.GhiChu)</span>
                                    <span class="font-monospace fw-semibold">@ot.SoTien.ToString("N0") đ</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 3. Phụ cấp ca đêm (30%) -->
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <div class="fw-semibold text-dark">3. Phụ cấp ca đêm (30%)</div>
                        <div class="small text-muted">@(Model.NightShiftItem?.GhiChu ?? "Không phát sinh ca đêm")</div>
                    </div>
                    <div class="font-monospace fw-bold fs-6 text-dark">@Model.TienCaDem.ToString("N0") đ</div>
                </div>

                <!-- 4. Phụ cấp ăn ca (Khoản miễn thuế TNCN) -->
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div>
                        <div class="fw-semibold text-dark d-flex align-items-center gap-2">
                            <span>4. Phụ cấp ăn ca</span>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill" style="font-size: 0.65rem;">Miễn thuế TNCN</span>
                        </div>
                        <div class="small text-muted">@(Model.MealAllowanceItem?.GhiChu ?? "30.000đ/ngày công")</div>
                    </div>
                    <div class="font-monospace fw-bold fs-6 text-dark">@Model.TienAnCa.ToString("N0") đ</div>
                </div>

                <!-- 5. Phụ cấp chức vụ / trách nhiệm / độc hại -->
                @if (Model.OtherAllowances.Count > 0)
                {
                    <div class="py-2 border-bottom">
                        <div class="fw-semibold text-dark mb-1">5. Phụ cấp chức danh &amp; vị trí</div>
                        <div class="bg-light rounded-3 p-2 small">
                            @foreach (var pc in Model.OtherAllowances)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1">
                                    <span class="text-muted">&bull; @pc.TenKhoan @(!string.IsNullOrEmpty(pc.GhiChu) ? $"({pc.GhiChu})" : "")</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="font-monospace fw-semibold">@pc.SoTien.ToString("N0") đ</span>
                                        @if (Model.CanEdit && pc.CanDelete)
                                        {
                                            <form method="post" asp-action="DeleteAdjust" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="chiTietId" value="@pc.MaChiTiet" />
                                                <input type="hidden" name="phieuLuongId" value="@Model.MaPhieuLuong" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Detail", "BangLuong", new { id = Model.MaPhieuLuong })" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa dòng điều chỉnh" onclick="return confirm('Xóa dòng điều chỉnh này?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- 6. Tiền sự kiện theo quyết toán đã lưu -->
                <div class="py-2.5 border-bottom">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="fw-semibold text-dark d-flex align-items-center gap-2 flex-wrap">
                                <span>6. Thù lao Sự kiện khách sạn (5★ Event Service)</span>
                                <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1" style="font-size: 0.7rem;">
                                    <i class="bi bi-stars text-warning me-1"></i>Theo quyết toán đã lưu
                                </span>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">Chịu thuế TNCN</span>
                            </div>
                            <div class="small text-muted mt-1">
                                Khoản cộng thêm cho thời gian tham gia sự kiện trong ca trực. Số tiền và hệ số được lưu khi nghiệm thu; thay đổi cấu hình sau đó không làm tính lại khoản đã chốt.
                                @if (Model.EventAllowances.Count > 0)
                                { <span class="d-block">Khoản đã kết chuyển vào phiếu lương. Khóa sổ kỳ lương không xác nhận đã chuyển khoản cho nhân viên.</span> }
                            </div>
                        </div>
                        <div class="font-monospace fw-bold fs-6 @(Model.EventAllowances.Count > 0 ? "text-primary" : "text-muted")">
                            @Model.EventAllowances.Sum(e => e.SoTien).ToString("N0") đ
                        </div>
                    </div>
                    @if (Model.EventAllowances.Count > 0)
                    {
                        <div class="bg-light rounded-3 p-2.5 mt-2 small border border-slate-subtle">
                            @foreach (var ev in Model.EventAllowances)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1.5 border-bottom border-light-subtle last-border-0">
                                    <div class="d-flex align-items-start gap-2">
                                        <div class="rounded-circle bg-warning bg-opacity-15 text-warning-emphasis d-flex align-items-center justify-content-center p-1 mt-0.5" style="width: 22px; height: 22px; font-size: 0.75rem;">
                                            <i class="bi bi-calendar2-event-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@ev.TenKhoan</div>
                                            <div class="small text-muted">@(string.IsNullOrWhiteSpace(ev.GhiChu) ? "Quyết toán thù lao sự kiện hoàn thành" : ev.GhiChu)</div>
                                        </div>
                                    </div>
                                    <div class="text-end ps-2">
                                        <span class="font-monospace fw-bold text-dark">@ev.SoTien.ToString("N0") đ</span>
                                        <div class="small text-gold-dark fw-semibold" style="font-size: 0.7rem;">Đã lưu khi quyết toán</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted py-1 fst-italic">
                            <i class="bi bi-info-circle me-1"></i>Không phát sinh giờ phân công sự kiện trong kỳ lương này.
                        </div>
                    }
                </div>

                <!-- 7. Tiền thưởng (Incentives / Service Charge) -->
                <div class="py-2">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="fw-semibold text-dark">7. Tiền thưởng khác &amp; Phí phục vụ</div>
                        <div class="font-monospace fw-bold fs-6 text-dark">@Model.BonusItems.Sum(b => b.SoTien).ToString("N0") đ</div>
                    </div>
                    @if (Model.BonusItems.Count > 0)
                    {
                        <div class="bg-light rounded-3 p-2 mt-2 small">
                            @foreach (var bn in Model.BonusItems)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1">
                                    <span class="text-muted">&bull; @bn.TenKhoan @(!string.IsNullOrEmpty(bn.GhiChu) ? $"({bn.GhiChu})" : "")</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="font-monospace fw-semibold">@bn.SoTien.ToString("N0") đ</span>
                                        @if (Model.CanEdit && bn.CanDelete)
                                        {
                                            <form method="post" asp-action="DeleteAdjust" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="chiTietId" value="@bn.MaChiTiet" />
                                                <input type="hidden" name="phieuLuongId" value="@Model.MaPhieuLuong" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Detail", "BangLuong", new { id = Model.MaPhieuLuong })" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa dòng điều chỉnh" onclick="return confirm('Xóa khoản thưởng này?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                <span class="fw-bold text-success">TỔNG THU NHẬP GROSS</span>
                <span class="font-monospace fw-bold fs-5 text-success">@Model.TongGross.ToString("N0") đ</span>
            </div>
        </div>
    </section>

    <!-- ===== TAB 3: KHẤU TRỪ (TẦNG 2) ===== -->
    <section class="payslip-pane" id="@tabBase-khautru" role="tabpanel" tabindex="0" hidden>
        <div class="payroll-payslip-card">
            <div class="payroll-tier-header payroll-tier-deduction">
                <span class="d-flex align-items-center gap-2">
                    <i class="bi bi-dash-circle-fill fs-5"></i>
                    <span>TẦNG 2: TỔNG KHẤU TRỪ</span>
                </span>
                <span class="fs-5 font-monospace fw-bold">@Model.TongKhauTru.ToString("N0") đ</span>
            </div>

            <div class="p-3 p-md-4">
                <!-- 1. Bảo hiểm bắt buộc 10.5% -->
                <div class="py-2 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold text-dark">1. Bảo hiểm bắt buộc (10.5%)</div>
                            <div class="small text-muted">Trừ vào lương người lao động theo Luật BHXH</div>
                        </div>
                        <div class="font-monospace fw-bold fs-6 text-danger">@Model.TongBaoHiem.ToString("N0") đ</div>
                    </div>
                    @if (Model.Insurance != null)
                    {
                        <div class="bg-light rounded-3 p-2 mt-2 small">
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">&bull; BHXH (8.0%)</span>
                                <span class="font-monospace">@Model.Insurance.TienBhxh.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">&bull; BHYT (1.5%)</span>
                                <span class="font-monospace">@Model.Insurance.TienBhyt.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">&bull; BHTN (1.0%)</span>
                                <span class="font-monospace">@Model.Insurance.TienBhtn.ToString("N0") đ</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- 2. Phạt vi phạm chấm công -->
                <div class="py-2 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold text-dark">2. Phạt vi phạm kỷ luật &amp; chấm công</div>
                            <div class="small text-muted">Tự động từ dữ liệu quẹt thẻ máy chấm công</div>
                        </div>
                        <div class="font-monospace fw-bold fs-6 text-danger">@Model.TongTienPhat.ToString("N0") đ</div>
                    </div>
                    @if (Model.Violations.Count > 0)
                    {
                        <div class="bg-light rounded-3 p-2 mt-2 small">
                            @foreach (var vp in Model.Violations)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1">
                                    <span class="text-danger">&bull; @vp.LyDoChiTiet</span>
                                    <span class="font-monospace fw-semibold text-danger">@vp.SoTienTru.ToString("N0") đ</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 3. Thuế TNCN lũy tiến từng phần -->
                <div class="py-2 border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold text-dark">3. Thuế thu nhập cá nhân (TNCN)</div>
                            <div class="small text-muted">Khấu trừ theo biểu lũy tiến từng phần của Nhà nước</div>
                        </div>
                        <div class="font-monospace fw-bold fs-6 text-danger">@Model.TienThue.ToString("N0") đ</div>
                    </div>
                    @if (Model.Tax != null)
                    {
                        <div class="bg-light rounded-3 p-2 mt-2 small">
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">&bull; Thu nhập chịu thuế:</span>
                                <span class="font-monospace">@Model.Tax.ThuNhapChiuThue.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">&bull; Giảm trừ bản thân:</span>
                                <span class="font-monospace">@Model.Tax.GiamTruBanThan.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">&bull; Thu nhập tính thuế:</span>
                                <span class="font-monospace fw-bold">@Model.Tax.ThuNhapTinhThue.ToString("N0") đ</span>
                            </div>
                        </div>
                    }
                </div>

                <!-- 4. Tạm ứng lương / Khoản trừ khác -->
                @if (Model.AdvanceItems.Count > 0)
                {
                    <div class="py-2">
                        <div class="fw-semibold text-dark mb-1">4. Khấu trừ khác</div>
                        <div class="bg-light rounded-3 p-2 small">
                            @foreach (var ad in Model.AdvanceItems)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1">
                                    <span class="text-muted">&bull; @ad.TenKhoan (@ad.GhiChu)</span>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="font-monospace fw-semibold text-danger">@ad.SoTien.ToString("N0") đ</span>
                                        @if (Model.CanEdit && ad.CanDelete)
                                        {
                                            <form method="post" asp-action="DeleteAdjust" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="chiTietId" value="@ad.MaChiTiet" />
                                                <input type="hidden" name="phieuLuongId" value="@Model.MaPhieuLuong" />
                                                <input type="hidden" name="returnUrl" value="@Url.Action("Detail", "BangLuong", new { id = Model.MaPhieuLuong })" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Xóa dòng khấu trừ" onclick="return confirm('Xóa dòng khấu trừ này?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center">
                <span class="fw-bold text-danger">TỔNG KHẤU TRỪ</span>
                <span class="font-monospace fw-bold fs-5 text-danger">@Model.TongKhauTru.ToString("N0") đ</span>
            </div>
        </div>
    </section>

    <!-- ===== TAB 4: ĐIỀU CHỈNH ===== -->
    <section class="payslip-pane" id="@tabBase-dieuchinh" role="tabpanel" tabindex="0" hidden>
        @if (Model.CanEdit)
        {
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-pencil-square text-primary"></i> HR điều chỉnh &amp; sửa sai sót thủ công
                        </h5>
                        <p class="text-muted small mb-0 mt-1">
                            Nếu phát hiện sai sót chấm công, thiếu phụ cấp sự kiện hoặc cần thưởng đột xuất / khấu trừ khác, HR có thể bổ sung trực tiếp tại đây. Hệ thống sẽ tự động cập nhật lại toàn bộ Gross, Khấu trừ, Thuế TNCN và Thực nhận Net.
                        </p>
                    </div>
                    <div>
                        <form method="post" asp-action="RecalculateEmployee" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.MaPhieuLuong" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Detail", "BangLuong", new { id = Model.MaPhieuLuong })" />
                            <button type="submit" class="btn btn-outline-primary rounded-pill px-3 btn-sm shadow-xs" onclick="return confirm('Tính lại toàn bộ số liệu công, tăng ca và sự kiện của nhân viên này?');">
                                <i class="bi bi-arrow-clockwise me-1"></i> Tính lại phiếu này
                            </button>
                        </form>
                    </div>
                </div>
                <div class="card-body p-3 p-md-4">
                    <form method="post" asp-action="Adjust" class="row g-3 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaPhieuLuong" value="@Model.MaPhieuLuong" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("Detail", "BangLuong", new { id = Model.MaPhieuLuong })" />

                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Loại khoản điều chỉnh <span class="text-danger">*</span></label>
                            <select name="LoaiKhoan" class="form-select rounded-3">
                                <option value="PHU_CAP">Phụ cấp (Cộng vào Gross)</option>
                                <option value="THUONG">Tiền thưởng (Cộng vào Gross)</option>
                                <option value="KHAU_TRU">Khấu trừ khác (Trừ vào Net)</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Tên khoản <span class="text-danger">*</span></label>
                            <input type="text" name="TenKhoan" class="form-control rounded-3" placeholder="Ví dụ: Thưởng đột xuất phục vụ VIP" required maxlength="150" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">Số tiền (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="SoTien" class="form-control rounded-3" placeholder="500000" min="1000" step="1000" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Ghi chú diễn giải</label>
                            <input type="text" name="GhiChu" class="form-control rounded-3" placeholder="Lý do bổ sung..." maxlength="255" />
                        </div>

                        <div class="col-md-1">
                            <button type="submit" class="btn btn-primary rounded-3 w-100">
                                <i class="bi bi-plus-lg"></i> Thêm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
        else if (!Model.IsLocked)
        {
            <div class="alert alert-light border rounded-4 d-flex align-items-center gap-3 mb-0 shadow-2xs">
                <div class="text-primary fs-3"><i class="bi bi-shield-check"></i></div>
                <div>
                    <div class="fw-semibold text-dark">Chế độ xem thẩm định (Quản trị viên / Ban Giám Đốc)</div>
                    <div class="small text-muted">
                        Phiếu lương đang ở giai đoạn rà soát. Chức năng sửa đổi và thêm khoản điều chỉnh được phân quyền riêng cho <strong>Chuyên viên Nhân sự (HR)</strong> trước khi gửi duyệt.
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success border-0 rounded-4 d-flex align-items-center gap-3 mb-0">
                <div class="fs-3 text-success"><i class="bi bi-lock-fill"></i></div>
                <div>
                    <div class="fw-semibold text-dark">Phiếu lương đã khóa sổ</div>
                    <div class="small text-muted">Dữ liệu tài chính đã đóng băng, không thể điều chỉnh thêm.</div>
                </div>
            </div>
        }
    </section>
</div>
