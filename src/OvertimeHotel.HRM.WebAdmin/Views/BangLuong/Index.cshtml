@model OvertimeHotel.HRM.WebAdmin.Models.BangLuongIndexViewModel
@{
    // Nhãn kỳ lương dùng chung cho topbar, đầu trang và thẻ chờ: số tháng luôn 2 chữ số.
    var periodLabel = $"tháng {Model.SelectedThang:D2}/{Model.SelectedNam}";
    ViewData["Title"] = $"Bảng tính lương Tháng {Model.SelectedThang:D2}/{Model.SelectedNam}";
    var status = Model.CurrentPeriod?.TrangThai ?? "MO";
}

<div class="container-fluid px-3 px-md-4 py-3">

    <!-- THÔNG BÁO FLASH MESSAGE -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@Model.SuccessMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- 1. ĐẦU TRANG: MỘT TIÊU ĐỀ DUY NHẤT + BỘ CHỌN KỲ LƯƠNG -->
    <div class="payroll-page-head">
        <div>
            <div class="payroll-eyebrow">
                <i class="bi bi-cash-stack"></i>
                <span>Tiền lương &amp; Phúc lợi 5★</span>
                <span>Kỳ @periodLabel</span>
            </div>
            <h2 class="payroll-page-title">Bảng tính lương @periodLabel</h2>
        </div>

        <!-- FORM CHỌN THÁNG/NĂM -->
        <form method="get" asp-action="Index" class="payroll-period-form">
            <div class="input-group input-group-sm px-2 py-1 flex-nowrap">
                <span class="input-group-text bg-transparent border-0 text-muted">
                    <i class="bi bi-calendar3"></i>
                </span>

                <select name="thang" class="form-select form-select-sm border-0 fw-semibold flex-shrink-0" style="width: 125px; min-width: 125px;">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.SelectedThang)">Tháng @m</option>
                    }
                </select>

                <select name="nam" class="form-select form-select-sm border-0 fw-semibold flex-shrink-0" style="width: 135px; min-width: 135px; padding-right: 32px;">
                    @for (int y = 2025; y <= 2027; y++)
                    {
                        <option value="@y" selected="@(y == Model.SelectedNam)">Năm @y</option>
                    }
                </select>

                <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3 flex-shrink-0">Xem</button>
            </div>
        </form>
    </div>

    <!-- 2. STEPPER TIẾN TRÌNH KỲ LƯƠNG + THANH TRẠNG THÁI -->
    @{
        // Vị trí hiện tại trên tiến trình 5 bước. Bị từ chối thì dừng ngay ở bước HR kiểm tra.
        var currentStep = status switch
        {
            "MO" => 1,
            "NHAP" or "TU_CHOI" => 2,
            "CHO_DUYET" => 3,
            "DA_DUYET" => 4,
            "KHOA_SO" => 5,
            _ => 1
        };

        var steps = new (string Title, string Desc)[]
        {
            ("Chạy tính", "Tổng hợp công, OT, phụ cấp"),
            ("HR kiểm tra", "Đối chiếu & gửi duyệt"),
            ("GĐ phê duyệt", "Ban Giám Đốc xem xét"),
            ("Khóa sổ", "Đóng băng dữ liệu tài chính"),
            ("Gửi phiếu", "Phát phiếu tới App nhân viên")
        };
    }

    <div class="payroll-stepper" role="list" aria-label="Tiến trình xử lý kỳ lương">
        @for (int i = 0; i < steps.Length; i++)
        {
            var stepNumber = i + 1;
            var isStep5Done = stepNumber == 5 && status == "KHOA_SO" && Model.ArePayslipsPublished;
            var isActive = stepNumber == currentStep && !isStep5Done;
            var isRejectedStep = status == "TU_CHOI" && stepNumber == currentStep;
            var isCompleted = (stepNumber < currentStep || isStep5Done) && !(status == "TU_CHOI" && stepNumber >= currentStep);
            var stateClass = isRejectedStep ? "rejected" : (isActive ? "active" : (isCompleted ? "completed" : ""));
            var iconClass = isRejectedStep ? "bi-x-lg" : (isCompleted ? "bi-check-lg" : stepNumber.ToString());

            <div class="payroll-step @stateClass" role="listitem"
                 aria-current="@(isActive ? "step" : null)"
                 title="@steps[i].Title — @steps[i].Desc">
                <span class="payroll-step-circle">
                    @if (iconClass.StartsWith("bi-"))
                    {
                        <i class="bi @iconClass"></i>
                    }
                    else
                    {
                        @iconClass
                    }
                </span>
                <span class="payroll-step-info">
                    <span class="payroll-step-title">@steps[i].Title</span>
                    <span class="payroll-step-desc">@steps[i].Desc</span>
                </span>
            </div>

            @if (i < steps.Length - 1)
            {
                <span class="payroll-step-line @(stepNumber < currentStep || isStep5Done ? "completed" : "")" aria-hidden="true"></span>
            }
        }
    </div>

    <div class="payroll-status-bar">
        <div class="payroll-status-meta">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge @(status == "TU_CHOI" ? "bg-danger" : (status == "CHO_DUYET" ? "bg-warning text-dark" : (status == "DA_DUYET" ? "bg-primary" : (status == "KHOA_SO" ? "bg-success" : "bg-secondary")))) rounded-pill px-3 py-1">
                    @(status switch
                    {
                        "NHAP" => "Bản nháp HR đang kiểm tra",
                        "CHO_DUYET" => "Đang chờ Ban Giám Đốc duyệt",
                        "DA_DUYET" => "Ban Giám Đốc đã phê duyệt",
                        "TU_CHOI" => "Bị từ chối duyệt",
                        "KHOA_SO" => "Đã khóa sổ tài chính",
                        _ => "Kỳ lương mở (Chưa tính)"
                    })
                </span>

                @if (Model.IsHR)
                {
                    <span class="badge bg-primary bg-opacity-75 rounded-pill px-2 py-1">
                        <i class="bi bi-person-badge me-1"></i>Vai trò: HR (Kiểm tra &amp; Gửi duyệt)
                    </span>
                }
                else if (Model.IsAdminOrBoss)
                {
                    <span class="badge bg-danger bg-opacity-75 rounded-pill px-2 py-1">
                        <i class="bi bi-shield-shaded me-1"></i>Vai trò: Sếp / Ban Giám Đốc (Phê duyệt)
                    </span>
                }

                @if (Model.CurrentPeriod?.NgayGuiDuyet.HasValue == true)
                {
                    <span class="small text-muted">
                        <i class="bi bi-clock me-1"></i>Gửi: @Model.CurrentPeriod.NgayGuiDuyet.Value.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm") bởi <strong>@Model.CurrentPeriod.NguoiGuiDuyet</strong>
                    </span>
                }
            </div>

            @if (status == "TU_CHOI")
            {
                <div class="mt-2 text-danger fw-semibold">
                    <i class="bi bi-x-circle-fill me-1"></i>
                    Lý do từ chối: <em>"@Model.CurrentPeriod?.LyDoTuChoi"</em>
                </div>
                <div class="small text-muted">Bởi: @Model.CurrentPeriod?.NguoiDuyet vào lúc @Model.CurrentPeriod?.NgayDuyet?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")</div>
                @if (Model.IsHR)
                {
                    <div class="small text-primary mt-1 fw-semibold">
                        <i class="bi bi-pencil-square me-1"></i>Bộ phận HR vui lòng rà soát lại sai sót, sửa số liệu rồi bấm <strong>"Gửi duyệt lại cho Sếp"</strong> bên phải.
                    </div>
                }
            }
            else if (status == "DA_DUYET")
            {
                <div class="small text-muted mt-1">
                    Phê duyệt bởi: <strong>@Model.CurrentPeriod?.NguoiDuyet</strong> vào lúc @Model.CurrentPeriod?.NgayDuyet?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm"). Sẵn sàng để Sếp khóa bảng lương.
                </div>
            }
            else if (status == "KHOA_SO")
            {
                <div class="small text-muted mt-1">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i>Khóa sổ an toàn bởi: <strong>@Model.CurrentPeriod?.NguoiKhoaSo</strong> vào lúc @Model.CurrentPeriod?.NgayKhoaSo?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm"). Dữ liệu tài chính đã đóng băng.
                    @if (Model.ArePayslipsPublished)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 ms-1">
                            <i class="bi bi-phone-fill me-1"></i>Phiếu lương đã gửi tới App nhân viên
                        </span>
                    }
                </div>
            }
            else if (status == "CHO_DUYET")
            {
                @if (Model.IsAdminOrBoss)
                {
                    <div class="small text-dark fw-semibold mt-1">
                        <i class="bi bi-bell-fill text-warning me-1"></i>Bảng lương đã được bộ phận HR gửi duyệt. Ban Giám Đốc / Sếp vui lòng xem xét tổng hợp và bấm <strong>"Phê duyệt"</strong> hoặc <strong>"Từ chối"</strong> bên phải.
                    </div>
                }
                else
                {
                    <div class="small text-muted mt-1">
                        <i class="bi bi-hourglass-split text-warning me-1"></i>Bảng lương đã gửi duyệt thành công. Đang chờ Ban Giám Đốc (Sếp / Admin) xem xét và phê duyệt (Bước 3).
                    </div>
                }
            }
            else
            {
                @if (Model.IsAdminOrBoss)
                {
                    <div class="small text-muted mt-1">
                        <i class="bi bi-info-circle me-1"></i>Tài khoản Quản trị viên: Bảng lương đang ở <strong>Bước 2: HR kiểm tra &amp; Gửi duyệt</strong>. Chờ tài khoản HR rà soát đối chiếu và bấm "Gửi duyệt".
                    </div>
                }
                else
                {
                    <div class="small text-muted mt-1">
                        Tài khoản HR: Vui lòng kiểm tra kỹ số liệu công, tăng ca, phụ cấp, thưởng và khấu trừ của nhân viên, đối chiếu sai sót rồi bấm <strong>"Gửi duyệt cho Sếp"</strong>.
                    </div>
                }
            }
        </div>

        <!-- CÁC NÚT HÀNH ĐỘNG THEO QUYỀN VÀ TRẠNG THÁI -->
        <div class="payroll-status-actions">

                    <!-- HÀNH ĐỘNG TÍNH LƯƠNG NHÁP (CHO HR HOẶC ADMIN KHI CẦN TÍNH) -->
                    @if (Model.CanCalculate)
                    {
                        <form method="post" asp-action="Calculate" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="thang" value="@Model.SelectedThang" />
                            <input type="hidden" name="nam" value="@Model.SelectedNam" />
                            <button type="submit" class="btn btn-outline-dark rounded-pill px-3 shadow-xs" onclick="return confirm('Chạy tính toán tự động sẽ làm mới số liệu công, phụ cấp và thưởng của kỳ lương này. Tiếp tục?');">
                                <i class="bi bi-arrow-repeat me-1"></i>
                                @(Model.Items.Count > 0 ? "Tính lại bảng lương" : "Chạy tính tự động")
                            </button>
                        </form>
                    }

                    <!-- HÀNH ĐỘNG GỬI DUYỆT (CHỈ DÀNH RIÊNG CHO TÀI KHOẢN HR) -->
                    @if (Model.CanSubmitApproval)
                    {
                        <form method="post" asp-action="SubmitApproval" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maKyLuong" value="@Model.CurrentPeriod!.MaKyLuong" />
                            <input type="hidden" name="thang" value="@Model.SelectedThang" />
                            <input type="hidden" name="nam" value="@Model.SelectedNam" />
                            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="return confirm('Xác nhận HR đã kiểm tra, đối chiếu kỹ bảng lương và gửi Ban Giám Đốc phê duyệt?');">
                                <i class="bi bi-send-check-fill me-1"></i> @(status == "TU_CHOI" ? "Gửi duyệt lại cho Sếp" : "Gửi duyệt cho Sếp")
                            </button>
                        </form>
                    }

                    <!-- HÀNH ĐỘNG SẾP DUYỆT HOẶC TỪ CHỐI (CHỈ DÀNH RIÊNG CHO SẾP / ADMIN) -->
                    @if (Model.CanApprove)
                    {
                        <form method="post" asp-action="Approve" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maKyLuong" value="@Model.CurrentPeriod!.MaKyLuong" />
                            <input type="hidden" name="thang" value="@Model.SelectedThang" />
                            <input type="hidden" name="nam" value="@Model.SelectedNam" />
                            <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm" onclick="return confirm('Bạn có chắc chắn muốn PHÊ DUYỆT bảng lương tháng này không?');">
                                <i class="bi bi-check2-circle me-1"></i> Phê duyệt bảng lương
                            </button>
                        </form>

                        <button type="button" class="btn btn-outline-danger rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#rejectPayrollModal">
                            <i class="bi bi-x-circle me-1"></i> Từ chối duyệt...
                        </button>
                    }
                    else if (status == "CHO_DUYET" && Model.IsHR && !Model.IsAdminOrBoss)
                    {
                        <!-- THÔNG BÁO CHO HR KHI Ở BƯỚC 3 -->
                        <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning rounded-pill px-3 py-2 small">
                            <i class="bi bi-hourglass-split me-1"></i> Chờ Ban Giám Đốc phê duyệt
                        </span>
                    }

                    <!-- HÀNH ĐỘNG KHÓA BẢNG LƯƠNG (SAU KHI DUYỆT - DÀNH CHO SẾP) -->
                    @if (Model.CanLock)
                    {
                        <form method="post" asp-action="Lock" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maKyLuong" value="@Model.CurrentPeriod!.MaKyLuong" />
                            <input type="hidden" name="thang" value="@Model.SelectedThang" />
                            <input type="hidden" name="nam" value="@Model.SelectedNam" />
                            <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm" onclick="return confirm('CẢNH BÁO: Khóa sổ bảng lương sẽ đóng băng vĩnh viễn dữ liệu tài chính của kỳ lương này. Tiếp tục?');">
                                <i class="bi bi-lock-fill me-1"></i> Khóa bảng lương
                            </button>
                        </form>
                    }

                    <!-- HÀNH ĐỘNG SAU KHI KHÓA: GỬI PHIẾU LƯƠNG & XUẤT FILE CHUYỂN KHOẢN -->
                    @if (Model.CanPublishAndExport)
                    {
                        <form method="post" asp-action="Publish" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maKyLuong" value="@Model.CurrentPeriod!.MaKyLuong" />
                            <input type="hidden" name="thang" value="@Model.SelectedThang" />
                            <input type="hidden" name="nam" value="@Model.SelectedNam" />
                            <button type="submit" class="btn btn-primary rounded-pill px-3 shadow-sm" onclick="return confirm('Gửi phiếu lương chính thức cho tất cả nhân viên trong kỳ?');">
                                <i class="bi bi-send-check-fill me-1"></i> @(Model.ArePayslipsPublished ? "Gửi lại phiếu tới App" : "Gửi phiếu tới App")
                            </button>
                        </form>

                        <a asp-action="ExportBankTransfer" asp-route-maKyLuong="@Model.CurrentPeriod!.MaKyLuong" class="btn btn-success rounded-pill px-3 shadow-sm">
                            <i class="bi bi-file-earmark-excel-fill me-1"></i> Xuất file chuyển khoản (.CSV)
                        </a>
                    }
        </div>
    </div>

    @if (Model.ShowPayrollData)
    {
        <!-- 3. THẺ THỐNG KÊ TÀI CHÍNH (KPI) — số đếm lại mềm mại mỗi lần lọc danh sách -->
        <div class="row g-3 mb-4" data-payroll-kpi>
            <div class="col-sm-6 col-xl-3">
                <div class="payroll-kpi-card border-start border-4 border-primary">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="payroll-kpi-title">Tổng nhân sự</div>
                            <div class="payroll-kpi-value text-primary" data-count-to="@Model.TotalEmployees">@Model.TotalEmployees <span class="fs-6 text-muted fw-normal">người</span></div>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                            <i class="bi bi-people-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="payroll-kpi-card border-start border-4 border-success">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="payroll-kpi-title">Tổng quỹ Gross (Tầng 1)</div>
                            <div class="payroll-kpi-value text-success" data-count-to="@Model.TotalGross.ToString("N0")">@Model.TotalGross.ToString("N0") <span class="fs-6 text-muted fw-normal">đ</span></div>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                            <i class="bi bi-graph-up-arrow fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="payroll-kpi-card border-start border-4 border-danger">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="payroll-kpi-title">Tổng khấu trừ (Tầng 2)</div>
                            <div class="payroll-kpi-value text-danger" data-count-to="@Model.TotalDeductions.ToString("N0")">@Model.TotalDeductions.ToString("N0") <span class="fs-6 text-muted fw-normal">đ</span></div>
                        </div>
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                            <i class="bi bi-shield-slash-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="payroll-kpi-card border-start border-4 border-warning">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="payroll-kpi-title">Thực chi Net (Thực nhận)</div>
                            <div class="payroll-kpi-value text-dark" data-count-to="@Model.TotalNet.ToString("N0")">@Model.TotalNet.ToString("N0") <span class="fs-6 text-muted fw-normal">đ</span></div>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                            <i class="bi bi-wallet-fill fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    <!-- 4. DANH SÁCH BẢNG LƯƠNG NHÂN VIÊN -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <!-- HEADER BẢNG VỚI BỘ LỌC TÌM KIẾM -->
        <div class="card-header bg-white p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <h5 class="fw-bold mb-0 text-dark">Bảng chi tiết lương nhân viên</h5>
                <span class="badge bg-light text-dark rounded-pill" data-payroll-count>@Model.Items.Count nhân viên</span>
            </div>

            <!-- TÌM KIẾM & LỌC THEO PHÒNG BAN: chọn xong tự nạp lại CHỈ danh sách bên dưới -->
            <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 flex-wrap" data-payroll-filter-form>
                <input type="hidden" name="thang" value="@Model.SelectedThang" />
                <input type="hidden" name="nam" value="@Model.SelectedNam" />

                <select name="department" class="form-select form-select-sm rounded-pill" style="width: 170px;" onchange="this.form.requestSubmit()">
                    <option value="">-- Tất cả bộ phận --</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept" selected="@(dept == Model.DepartmentFilter)">@dept</option>
                    }
                </select>

                <div class="input-group input-group-sm rounded-pill border overflow-hidden" style="width: 240px;">
                    <span class="input-group-text bg-white border-0 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control form-control-sm border-0 ps-1" placeholder="Gõ rồi Enter để tìm..." />
                </div>

                <a asp-action="Index" asp-route-thang="@Model.SelectedThang" asp-route-nam="@Model.SelectedNam"
                   class="btn btn-sm btn-outline-secondary rounded-pill @(string.IsNullOrEmpty(Model.SearchKeyword) && string.IsNullOrEmpty(Model.DepartmentFilter) ? "d-none" : "")"
                   data-payroll-clear title="Xóa bộ lọc">
                    <i class="bi bi-x-circle"></i>
                </a>
            </form>
        </div>

        <!-- BẢNG DỮ LIỆU: VÙNG NẠP TẠI CHỖ — lọc/tìm kiếm chỉ đổi đúng khối này,
             header, bộ lọc và các thẻ KPI phía trên giữ nguyên, không reload trang. -->
        <div class="payroll-list-region" data-payroll-list>
            <div class="payroll-list-loading" data-payroll-loading hidden aria-hidden="true">
                <div class="payslip-skeleton payslip-skeleton-row"></div>
                <div class="payslip-skeleton payslip-skeleton-row"></div>
                <div class="payslip-skeleton payslip-skeleton-row"></div>
                <div class="payslip-skeleton payslip-skeleton-row"></div>
                <div class="payslip-skeleton payslip-skeleton-row"></div>
            </div>
            <div class="table-responsive" data-payroll-results>
            <table class="table table-hover align-middle mb-0 text-nowrap payroll-grid">
                <thead class="table-light text-muted small text-uppercase" style="font-size: 0.75rem;">
                    <tr>
                        <th class="ps-4">Nhân viên</th>
                        <th>Phòng ban / Chức vụ</th>
                        <th class="text-end">Công &amp; Lương công</th>
                        <th class="text-end">Tăng ca (OT)</th>
                        <th class="text-end">Phụ cấp</th>
                        <th class="text-end">Thưởng</th>
                        <th class="text-end fw-bold text-success">Tổng Gross</th>
                        <th class="text-end fw-bold text-danger">Khấu trừ</th>
                        <th class="text-end fw-bold text-dark pe-3">Lương Net</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">
                                <div class="mb-2"><i class="bi bi-inbox fs-1 text-muted"></i></div>
                                <div>Chưa có dữ liệu bảng lương cho kỳ <strong>@periodLabel</strong>.</div>
                                @if (Model.CanCalculate)
                                {
                                    <div class="mt-3">
                                        <form method="post" asp-action="Calculate">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="thang" value="@Model.SelectedThang" />
                                            <input type="hidden" name="nam" value="@Model.SelectedNam" />
                                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                                <i class="bi bi-calculator me-1"></i> Chạy tính lương kỳ này ngay
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in Model.Items)
                        {
                            <tr class="payroll-table-row" style="cursor: pointer;"
                                data-payslip-id="@row.MaPhieuLuong"
                                data-payslip-name="@row.HoTen"
                                data-payslip-code="@row.MaNvFormatted"
                                data-payslip-dept="@row.PhongBan"
                                data-payslip-role="@row.ChucVu"
                                data-payslip-print="@Url.Action("Print", "BangLuong", new { id = row.MaPhieuLuong })"
                                title="Nhấn để xem chi tiết phiếu lương">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center text-primary fw-bold" style="width: 34px; height: 34px; font-size: 0.8rem;">
                                            @row.HoTen.Split(' ').Last().Substring(0, 1)
                                        </div>
                                        <div>
                                            <a asp-action="Detail" asp-route-id="@row.MaPhieuLuong" class="fw-semibold text-dark text-decoration-none" data-payslip-id="@row.MaPhieuLuong">
                                                @row.HoTen
                                            </a>
                                            <div class="small text-muted font-monospace" style="font-size: 0.75rem;">@row.MaNvFormatted</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold small text-dark">@row.PhongBan</div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">@row.ChucVu</div>
                                </td>
                                <td class="text-end payroll-stack">
                                    <div class="font-monospace fw-semibold">@row.TienLuongCong.ToString("N0")</div>
                                    <div class="small text-muted" style="font-size: 0.72rem;">
                                        <span class="badge bg-light text-dark rounded-pill">@row.NgayCongThucTe.ToString("N1") công</span>
                                        <span class="ms-1">CB @row.LuongCoBan.ToString("N0")</span>
                                    </div>
                                </td>
                                <td class="text-end font-monospace">
                                    @(row.TienTangCa > 0 ? row.TienTangCa.ToString("N0") : "-")
                                </td>
                                <td class="text-end font-monospace">@row.TongPhuCap.ToString("N0")</td>
                                <td class="text-end font-monospace">
                                    @(row.TongThuong > 0 ? row.TongThuong.ToString("N0") : "-")
                                </td>
                                <td class="text-end font-monospace fw-bold text-success">@row.TongGross.ToString("N0")</td>
                                <td class="text-end font-monospace fw-bold text-danger">@row.TongKhauTru.ToString("N0")</td>
                                <td class="text-end font-monospace fw-bold fs-6 text-dark pe-3">@row.ThucNhan.ToString("N0")</td>
                                <td class="text-center">
                                    <span class="badge @(row.TrangThai == "DA_THANH_TOAN" ? "bg-success" : (row.TrangThai == "DA_DUYET" ? "bg-primary" : (row.TrangThai == "CHO_DUYET" ? "bg-warning text-dark" : "bg-secondary"))) rounded-pill small">
                                        @(row.TrangThai switch
                                        {
                                            "NHAP" => "Nháp",
                                            "CHO_DUYET" => "Chờ duyệt",
                                            "DA_DUYET" => "Đã duyệt",
                                            "DA_THANH_TOAN" => "Đã gửi App",
                                            _ => row.TrangThai
                                        })
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Print" asp-route-id="@row.MaPhieuLuong" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5" title="In phiếu lương / Xuất PDF" onclick="event.stopPropagation();">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        </div>
    </div>
    }
    else
    {
        <!-- MÀN HÌNH CHỜ HR KIỂM TRA & GỬI DUYỆT (DÀNH CHO TÀI KHOẢN ADMIN/SẾP) -->
        <div class="payroll-waiting-card my-4">
            <div class="payroll-waiting-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <h4 class="mb-2">Bảng lương kỳ @periodLabel đang được bộ phận HR rà soát</h4>
            <p>
                Theo quy trình nghiệp vụ khách sạn, bộ phận <strong>Nhân sự (HR)</strong> đang tiến hành rà soát dữ liệu chấm công, đối chiếu các khoản phụ cấp, tăng ca và sửa sai sót nội bộ.
                <br />
                Toàn bộ dữ liệu bảng lương chi tiết và quỹ chi trả sẽ <strong>tự động hiển thị tại đây</strong> ngay sau khi HR hoàn tất đối chiếu và bấm <strong>"Gửi duyệt cho Sếp"</strong>.
            </p>
            <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                    <i class="bi bi-person-badge me-1 text-primary"></i> Bộ phận phụ trách: <strong>Nhân sự (HR)</strong>
                </span>
                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">
                    <i class="bi bi-shield-check me-1 text-success"></i> Trạng thái hiện tại: <strong>@(status == "TU_CHOI" ? "Đã trả về HR sửa sai sót" : "Bản nháp đang kiểm tra")</strong>
                </span>
            </div>
        </div>
    }
</div>

<!-- MODAL SẾP TỪ CHỐI DUYỆT BẢNG LƯƠNG -->
@if (Model.CanApprove && Model.CurrentPeriod != null)
{
    <div class="modal fade" id="rejectPayrollModal" tabindex="-1" aria-labelledby="rejectPayrollModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form method="post" asp-action="Reject">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MaKyLuong" value="@Model.CurrentPeriod.MaKyLuong" />
                    <input type="hidden" name="thang" value="@Model.SelectedThang" />
                    <input type="hidden" name="nam" value="@Model.SelectedNam" />

                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="rejectPayrollModalLabel">
                            <i class="bi bi-exclamation-triangle-fill"></i> Từ chối duyệt bảng lương
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body py-3">
                        <p class="text-muted small">
                            Bảng lương sẽ được hoàn trả về cho bộ phận Nhân sự (HR) để kiểm tra, đối chiếu lại công thức hoặc bổ sung dữ liệu chấm công / phụ cấp.
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Lý do từ chối <span class="text-danger">*</span></label>
                            <textarea name="LyDo" class="form-control rounded-3" rows="4" placeholder="Ví dụ: Cần đối chiếu lại số giờ tăng ca của bộ phận Lễ tân ngày 15/09..." required minlength="5" maxlength="500"></textarea>
                            <div class="form-text">Ghi rõ sai sót hoặc chỉ dẫn để HR chỉnh sửa chính xác.</div>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i class="bi bi-x-circle me-1"></i> Xác nhận từ chối
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- POPUP CHI TIẾT PHIẾU LƯƠNG NHIỀU TAB: nạp tại chỗ, không rời trang danh sách -->
<div class="modal fade" id="payslipDetailModal" tabindex="-1" aria-labelledby="payslipDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable modal-dialog-payslip">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header payslip-modal-header border-bottom-0 py-3">
                <div class="payslip-modal-identity d-flex align-items-center gap-3 min-w-0">
                    <span class="payslip-modal-avatar" data-payslip-avatar aria-hidden="true"></span>
                    <div class="min-w-0">
                        <div class="d-flex align-items-center gap-2 text-white-50 small flex-wrap">
                            <span class="badge bg-light text-dark rounded-pill" data-payslip-code>—</span>
                            <span data-payslip-dept></span>
                            <span data-payslip-role></span>
                        </div>
                        <h5 class="modal-title fw-bold text-white mb-0 text-truncate" id="payslipDetailModalLabel" data-payslip-name>
                            Chi tiết phiếu lương
                        </h5>
                    </div>
                </div>
                <div class="payslip-modal-actions d-flex align-items-center">
                    <button type="button" class="btn btn-sm btn-light rounded-pill px-3 d-none" data-payslip-print>
                        <i class="bi bi-printer me-1"></i> In / PDF
                    </button>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
            </div>

            <div class="modal-body p-3 p-md-4">
                <!-- Vùng nạp tại chỗ: chỉ khối này hiện skeleton, header popup giữ nguyên -->
                <div class="payslip-modal-loading" data-payslip-loading hidden aria-hidden="true">
                    <div class="payslip-skeleton payslip-skeleton-tabs"></div>
                    <div class="payslip-skeleton payslip-skeleton-title"></div>
                    <div class="payslip-skeleton payslip-skeleton-row"></div>
                    <div class="payslip-skeleton payslip-skeleton-row"></div>
                    <div class="payslip-skeleton payslip-skeleton-row"></div>
                </div>
                <div class="payslip-modal-error alert alert-danger rounded-4 d-none" role="alert" data-payslip-error></div>
                <div class="payslip-detail-body" data-payslip-body></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/payroll.js" asp-append-version="true"></script>
}
