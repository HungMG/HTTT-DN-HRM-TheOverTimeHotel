@model OvertimeHotel.HRM.WebAdmin.Models.NhanVienFormViewModel
@{
    ViewData["Title"] = "Sửa hồ sơ nhân viên";
}
<div class="container py-4">
    <div class="mb-4"><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Danh sách nhân viên</a><h1 class="h2 fw-bold mt-3">Sửa hồ sơ nhân viên</h1><p class="text-muted">Cập nhật hồ sơ NV-@Model.Employee.MaNhanVien.</p></div>
    <form asp-action="Edit" asp-route-id="@Model.Employee.MaNhanVien" method="post" class="card border-0 shadow-sm"><div class="card-body p-4"><partial name="_EmployeeForm" model="Model" /></div><div class="card-footer bg-white border-0 p-4 pt-0"><button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Lưu thay đổi</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
