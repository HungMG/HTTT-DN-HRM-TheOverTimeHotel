@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider EmployeeDeleteProtection
@model OvertimeHotel.HRM.WebAdmin.Models.NhanVienIndexViewModel
@{
    Func<int, string> pageUrl = page => Url.Action("Index", new
    {
        keyword = Model.Keyword,
        departmentId = Model.DepartmentId,
        positionId = Model.PositionId,
        status = Model.Status,
        contractFilter = Model.ContractFilter,
        page,
        pageSize = Model.PageSize
    }) ?? "#";

    var startItem = Model.TotalFilteredEmployees == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1;
    var endItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalFilteredEmployees);
    var firstPage = Math.Max(1, Model.PageNumber - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

<div data-catalog-results id="employeeTableContainer" class="employee-table-container">
    <!-- HIDDEN BADGE VALUE ĐỂ CATALOG.JS TỰ ĐỒNG BỘ SỐ LƯỢNG TRÊN TOOLBAR -->
    <span class="d-none" data-catalog-count>
        <i class="bi bi-people-fill me-1"></i> @Model.TotalFilteredEmployees nhân sự
    </span>

    <!-- BẢNG DANH SÁCH NHÂN SỰ -->
    <div class="table-responsive">
        <table class="table catalog-table table-hover align-middle mb-0" data-export-table="Danh_Sach_Nhan_Vien">
            <thead>
                <tr>
                    <th style="width: 90px" class="text-center">Mã NV</th>
                    <th>Nhân sự</th>
                    <th>Phòng ban / Chức vụ</th>
                    <th>Liên hệ</th>
                    <th>Tài khoản</th>
                    <th style="width: 140px">Trạng thái</th>
                    <th class="text-end" style="width: 180px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Employees.Count == 0)
            {
                <tr>
                    <td colspan="7" class="catalog-empty">
                        <div class="catalog-empty-state py-5 text-center">
                            <div class="catalog-empty-icon mb-3">
                                <i class="bi bi-people text-muted opacity-50" style="font-size: 3rem;"></i>
                            </div>
                            <h4 class="fw-bold font-serif text-dark">Không tìm thấy hồ sơ nhân sự phù hợp</h4>
                            <p class="text-muted small">Không có nhân sự nào khớp với từ khóa tìm kiếm hoặc bộ lọc hiện tại.</p>
                            <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                                <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" onclick="resetEmployeeFilters()">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
                                </button>
                                <button type="button" class="btn btn-hotel-primary btn-sm px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#createEmployeeModal">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm nhân viên mới
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Employees)
                {
                    var employee = item.Employee;
                    <tr class="employee-row" style="cursor: pointer;" onclick="if (!event.target.closest('a, button, form, select, input')) openEmployeeProfile(@employee.MaNhanVien)">
                        <td class="text-center font-monospace small fw-bold text-muted">
                            <span class="badge bg-light text-secondary border px-2 py-1 font-monospace">NV-@employee.MaNhanVien</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0"
                                     style="width: 38px; height: 38px; font-size: 0.88rem; border: 2px solid #d4af37; background: linear-gradient(135deg, #1e3a8a, #2563eb) !important;">
                                    @(employee.Ten.Length > 0 ? employee.Ten.Substring(0, 1).ToUpper() : "N")
                                </div>
                                <div>
                                    <a href="javascript:void(0)" onclick="openEmployeeProfile(@employee.MaNhanVien); event.stopPropagation();"
                                       class="d-block text-dark fw-bold fs-6 font-serif text-decoration-none employee-name-link">
                                        @employee.HoTen
                                    </a>
                                    <small class="text-muted">@(employee.GioiTinh switch { "NAM" => "Nam", "NU" => "Nữ", "KHAC" => "Khác", _ => "Chưa cập nhật" }) &bull; Sinh: @(employee.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@(employee.PhongBan?.TenPhongBan ?? "Chưa phân phòng")</div>
                            <span class="badge bg-light text-primary border rounded-pill px-2 py-1 small">
                                @(employee.ChucVu?.TenChucVu ?? "Chưa phân chức vụ")
                            </span>
                        </td>
                        <td>
                            <div class="small text-dark"><i class="bi bi-envelope me-1 text-muted"></i>@employee.EmailCongVu</div>
                            <small class="text-muted font-monospace"><i class="bi bi-telephone me-1 text-muted"></i>@employee.DienThoai</small>
                        </td>
                        <td>
                            @switch (item.AccountStatus)
                            {
                                case "DA_CAP":
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-3 py-1">Đã cấp</span>
                                    break;
                                case "CHO_CAP":
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">Chờ cấp</span>
                                    break;
                                case "TU_CHOI":
                                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle rounded-pill px-3 py-1">Từ chối</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">Chưa cấp</span>
                                    break;
                            }
                        </td>
                        <td>
                            @switch (employee.TrangThai)
                            {
                                case "DANG_LAM":
                                    @if (item.ContractState == "DA_HET_HAN")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-1" title="Hợp đồng lao động đã hết hạn - Cần gia hạn HĐ hoặc làm thủ tục thôi việc">
                                            <i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i>Chờ gia hạn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đang làm
                                        </span>
                                    }
                                    break;
                                case "NGHI_PHEP":
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-clock-history me-1"></i>Tạm nghỉ
                                    </span>
                                    break;
                                default:
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-x-circle me-1"></i>Đã nghỉ
                                    </span>
                                    break;
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@employee.MaNhanVien" onclick="event.stopPropagation();" class="btn btn-sm btn-light border rounded-circle me-1 text-secondary" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;" title="Chỉnh sửa hồ sơ">
                                <i class="bi bi-pencil"></i>
                            </a>
                            @if (employee.TrangThai == "DA_THOI_VIEC")
                            {
                                <button type="button" class="btn btn-sm btn-light border rounded-circle text-danger"
                                        style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;"
                                        data-employee-delete-name="@employee.HoTen"
                                        data-employee-delete-token="@OvertimeHotel.HRM.WebAdmin.Services.EmployeeDeletionService.CreateConfirmationToken(EmployeeDeleteProtection, employee.MaNhanVien)"
                                        data-employee-delete-url="@Url.Action("DeletePermanently", "NhanVien", new { id = employee.MaNhanVien })"
                                        title="Xóa vĩnh viễn" aria-label="Xóa vĩnh viễn nhân viên @employee.HoTen" aria-haspopup="dialog">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            }
                            else
                            {
                                <form asp-action="Delete" asp-route-id="@employee.MaNhanVien" method="post" class="d-inline" onclick="event.stopPropagation();" onsubmit="return confirm('Bạn có chắc chắn muốn ẩn hồ sơ @employee.HoTen khỏi danh sách?');">
                                    <button type="submit" class="btn btn-sm btn-light border rounded-circle text-danger" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;" title="Ẩn hồ sơ" aria-label="Ẩn hồ sơ nhân viên @employee.HoTen">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <!-- 5-STAR EXECUTIVE LUXURY FOOTER & IN-PLACE PAGINATION -->
    <div class="catalog-table-footer d-flex flex-wrap justify-content-between align-items-center gap-3 p-3 border-top bg-white">
        <!-- 1. RECORD RANGE COUNTER -->
        <div class="d-flex align-items-center gap-2">
            <span class="catalog-badge py-1 px-3 d-inline-flex align-items-center" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 999px; font-size: 0.82rem; color: #475569;">
                <i class="bi bi-people-fill text-primary me-2"></i>
                <span>Hiển thị <strong class="text-dark">@startItem – @endItem</strong> trong tổng số <strong class="text-dark">@Model.TotalFilteredEmployees</strong> nhân sự</span>
                @if (Model.TotalFilteredEmployees < Model.TotalEmployees)
                {
                    <span class="text-muted ms-1">(Lọc từ @Model.TotalEmployees)</span>
                }
            </span>
        </div>

        <!-- 2. PAGE SIZE SELECTOR & PAGINATION CONTROLS -->
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small fw-semibold text-nowrap"><i class="bi bi-list-ol me-1"></i>Hiển thị:</span>
                <select class="form-select form-select-sm rounded-pill px-3 py-1 fw-semibold text-dark shadow-none"
                        style="width: auto; border: 1.5px solid #cbd5e1; font-size: 0.82rem; cursor: pointer; background-color: #f8fafc;"
                        onchange="changeEmployeePageSize(this.value)" aria-label="Số bản ghi mỗi trang">
                    <option value="10" selected="@(Model.PageSize == 10)">10 / trang</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20 / trang</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 / trang</option>
                </select>
            </div>

            <!-- PAGINATION PILLS -->
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Phân trang nhân viên">
                    <ul class="pagination pagination-sm mb-0 align-items-center gap-1">
                        <!-- PREV BUTTON -->
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 py-1 fw-semibold border text-decoration-none d-flex align-items-center gap-1 shadow-sm"
                               href="@pageUrl(Math.Max(1, Model.PageNumber - 1))"
                               onclick="goToEmployeePage(@Math.Max(1, Model.PageNumber - 1), event)"
                               style="font-size: 0.82rem; color: @(Model.PageNumber <= 1 ? "#94a3b8" : "#1e3a8a"); background: @(Model.PageNumber <= 1 ? "#f8fafc" : "#ffffff"); border-color: #e2e8f0 !important;"
                               aria-label="Trang trước">
                                <i class="bi bi-chevron-left"></i>
                                <span class="d-none d-sm-inline">Trước</span>
                            </a>
                        </li>

                        @if (firstPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link rounded-circle d-flex align-items-center justify-content-center border fw-semibold shadow-sm"
                                   style="width: 32px; height: 32px; font-size: 0.82rem; color: #334155; background: #ffffff; border-color: #e2e8f0 !important;"
                                   href="@pageUrl(1)"
                                   onclick="goToEmployeePage(1, event)">1</a>
                            </li>
                            @if (firstPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link border-0 text-muted px-1">…</span></li>
                            }
                        }

                        @for (var pageIndex = firstPage; pageIndex <= lastPage; pageIndex++)
                        {
                            var isCurrent = pageIndex == Model.PageNumber;
                            <li class="page-item @(isCurrent ? "active" : "")">
                                <a class="page-link rounded-circle d-flex align-items-center justify-content-center fw-bold border shadow-sm"
                                   style="width: 32px; height: 32px; font-size: 0.82rem;
                                          @(isCurrent ? "background: linear-gradient(135deg, #0f172a, #1e3a8a) !important; color: #ffffff !important; border-color: #d4af37 !important; box-shadow: 0 4px 10px rgba(30, 58, 138, 0.25);" : "background: #ffffff; color: #334155; border-color: #e2e8f0 !important;")"
                                   href="@pageUrl(pageIndex)"
                                   onclick="goToEmployeePage(@pageIndex, event)">
                                    @pageIndex
                                </a>
                            </li>
                        }

                        @if (lastPage < Model.TotalPages)
                        {
                            @if (lastPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link border-0 text-muted px-1">…</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link rounded-circle d-flex align-items-center justify-content-center border fw-semibold shadow-sm"
                                   style="width: 32px; height: 32px; font-size: 0.82rem; color: #334155; background: #ffffff; border-color: #e2e8f0 !important;"
                                   href="@pageUrl(Model.TotalPages)"
                                   onclick="goToEmployeePage(@Model.TotalPages, event)">@Model.TotalPages</a>
                            </li>
                        }

                        <!-- NEXT BUTTON -->
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 py-1 fw-semibold border text-decoration-none d-flex align-items-center gap-1 shadow-sm"
                               href="@pageUrl(Math.Min(Model.TotalPages, Model.PageNumber + 1))"
                               onclick="goToEmployeePage(@Math.Min(Model.TotalPages, Model.PageNumber + 1), event)"
                               style="font-size: 0.82rem; color: @(Model.PageNumber >= Model.TotalPages ? "#94a3b8" : "#1e3a8a"); background: @(Model.PageNumber >= Model.TotalPages ? "#f8fafc" : "#ffffff"); border-color: #e2e8f0 !important;"
                               aria-label="Trang sau">
                                <span class="d-none d-sm-inline">Sau</span>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
