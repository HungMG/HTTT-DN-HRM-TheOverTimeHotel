@model OvertimeHotel.HRM.WebAdmin.Models.NhanVienIndexViewModel
@{
    ViewData["Title"] = "Hồ sơ nhân viên · The OverTime Hotel";
    Func<int, string> pageUrl = page => Url.Action("Index", new
    {
        keyword = Model.Keyword,
        departmentId = Model.DepartmentId,
        status = Model.Status,
        contractFilter = Model.ContractFilter,
        page,
        pageSize = Model.PageSize
    }) ?? "#";
    var firstPage = Math.Max(1, Model.PageNumber - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

<div class="catalog-page employee-workspace">
    <partial name="_CatalogAlerts" />

    <!-- 3 MINI KPI SUMMARY STATS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-people-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tổng nhân sự</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.TotalEmployees">@Model.TotalEmployees</span> <small>nhân sự</small></h3>
                    <p class="catalog-kpi-desc">Hồ sơ hiện có trong hệ thống khách sạn</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-person-check-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Đang làm việc</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.WorkingEmployees">@Model.WorkingEmployees</span> <small>người</small></h3>
                    <p class="catalog-kpi-desc">Nhân sự đang hoạt động và đảm nhận công việc</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--deduction shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-building"></i></div>
                <div>
                    <span class="catalog-kpi-label">Phòng ban hoạt động</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.DepartmentOptions.Count">@Model.DepartmentOptions.Count</span> <small>phòng</small></h3>
                    <p class="catalog-kpi-desc">Đơn vị đang hoạt động trong hotel</p>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE WORKSPACE CARD -->
    <section class="catalog-card shadow-sm">
        <div class="catalog-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
            <form method="get" class="catalog-filter-form d-flex flex-wrap gap-2 flex-grow-1 align-items-center">
                <div class="catalog-search-wrapper" style="min-width: 240px; flex: 2;">
                    <i class="bi bi-search catalog-search-icon" aria-hidden="true"></i>
                    <input name="keyword" value="@Model.Keyword" class="form-control catalog-search" placeholder="Tìm theo tên, email hoặc số điện thoại..." aria-label="Tìm kiếm nhân viên" />
                    <span class="catalog-search-shortcut" aria-label="Tìm kiếm" title="Tìm kiếm">
                        <i class="bi bi-search"></i>
                    </span>
                </div>
                
                <div style="min-width: 170px; flex: 1;">
                    <select name="departmentId" asp-items="Model.DepartmentOptions" class="form-select">
                        <option value="">-- Tất cả phòng ban --</option>
                    </select>
                </div>

                <div style="min-width: 140px;">
                    <select name="status" class="form-select">
                        <option value="">-- Trạng thái --</option>
                        <option value="DANG_LAM" selected="@(Model.Status == "DANG_LAM")">Đang làm</option>
                        <option value="NGHI_PHEP" selected="@(Model.Status == "NGHI_PHEP")">Tạm nghỉ</option>
                        <option value="DA_THOI_VIEC" selected="@(Model.Status == "DA_THOI_VIEC")">Đã nghỉ việc</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-hotel-primary text-nowrap"><i class="bi bi-search me-1"></i>Lọc hồ sơ</button>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || Model.DepartmentId.HasValue || !string.IsNullOrWhiteSpace(Model.Status))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                }
            </form>

            <div class="catalog-toolbar-actions d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-hotel-primary rounded-3 px-3 fw-semibold catalog-action-btn" data-bs-toggle="modal" data-bs-target="#createEmployeeModal">
                    <i class="bi bi-plus-lg me-1"></i> Thêm nhân viên
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-export="NhanVien" title="Xuất danh sách ra file CSV mở bằng Excel">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Xuất CSV
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-print title="In danh sách nhân sự chuẩn A4">
                    <i class="bi bi-printer text-primary me-1"></i> In danh sách
                </button>
                <span class="catalog-badge" data-catalog-count>
                    <i class="bi bi-people-fill me-1"></i> @Model.TotalFilteredEmployees nhân sự
                </span>
            </div>
        </div>

        <!-- EMPLOYEE DATA TABLE & IN-PLACE PAGINATION PARTIAL -->
        <partial name="_EmployeeTablePartial" model="Model" />
    </section>
</div>

<!-- MODAL THÊM NHÂN VIÊN MỚI -->
<div class="modal fade" id="createEmployeeModal" tabindex="-1" aria-labelledby="createEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-bottom py-3 px-4">
                <div>
                    <div class="text-uppercase small text-primary fw-bold">Hồ sơ nhân sự khách sạn</div>
                    <h2 class="modal-title h5 mb-0 font-serif" id="createEmployeeModalLabel">Thêm Nhân Viên Mới</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="Create" method="post" class="d-flex flex-column overflow-hidden">
                @Html.AntiForgeryToken()
                <div class="modal-body overflow-auto p-4">
                    <partial name="_EmployeeForm" model="Model.CreateEmployeeForm" />
                </div>
                <div class="modal-footer flex-shrink-0 bg-light border-top py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i>Lưu hồ sơ nhân viên
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL XEM HỒ SƠ NHÂN VIÊN CHI TIẾT (4 TABS LUXURY) -->
<div class="modal fade" id="employeeProfileModal" tabindex="-1" aria-labelledby="employeeProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-bottom py-3 px-4 bg-white">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-person-badge-fill fs-5"></i>
                    </div>
                    <div>
                        <div class="text-uppercase text-primary fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">The OverTime Hotel &bull; Hồ Sơ Điện Tử 5★</div>
                        <h5 class="modal-title mb-0 fw-bold font-serif text-dark" id="employeeProfileModalLabel">Chi Tiết Hồ Sơ Nhân Sự</h5>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4 bg-white" id="employeeProfileModalBody">
                <!-- Nội dung nạp động AJAX /NhanVien/ProfileModal/{id} -->
            </div>
            <div class="modal-footer bg-light border-top py-2 px-4 d-flex justify-content-between align-items-center">
                <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i>Dữ liệu đồng bộ trực tiếp Supabase Cloud</small>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEmployeeProfile(id) {
        const modalEl = document.getElementById('employeeProfileModal');
        const modalBody = document.getElementById('employeeProfileModalBody');
        if (!modalEl || !modalBody) return;

        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();

        // Khung xương Skeleton Shimmer sang trọng 5 sao (Tuyệt đối không dùng ActivityIndicator)
        modalBody.innerHTML = `
            <div class="p-2">
                <div class="d-flex align-items-center gap-3 p-4 rounded-4 mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);">
                    <div class="rounded-4 bg-white bg-opacity-25" style="width: 76px; height: 76px; animation: hotelPulse 1.2s infinite ease-in-out;"></div>
                    <div class="flex-grow-1">
                        <div class="rounded-pill bg-white bg-opacity-25 mb-2" style="width: 45%; height: 22px; animation: hotelPulse 1.2s infinite ease-in-out;"></div>
                        <div class="rounded-pill bg-white bg-opacity-15" style="width: 65%; height: 16px; animation: hotelPulse 1.2s infinite ease-in-out;"></div>
                    </div>
                </div>
                <div class="d-flex gap-2 mb-4 pb-2 border-bottom">
                    <div class="rounded-pill bg-light border" style="width: 150px; height: 38px; animation: hotelPulse 1.2s infinite ease-in-out;"></div>
                    <div class="rounded-pill bg-light border" style="width: 150px; height: 38px; animation: hotelPulse 1.2s infinite ease-in-out;"></div>
                    <div class="rounded-pill bg-light border" style="width: 150px; height: 38px; animation: hotelPulse 1.2s infinite ease-in-out;"></div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6"><div class="rounded-4 bg-light border p-4" style="height: 180px; animation: hotelPulse 1.2s infinite ease-in-out;"></div></div>
                    <div class="col-md-6"><div class="rounded-4 bg-light border p-4" style="height: 180px; animation: hotelPulse 1.2s infinite ease-in-out;"></div></div>
                </div>
            </div>
            <style>
                @@keyframes hotelPulse {
                    0%, 100% { opacity: 0.45; }
                    50% { opacity: 0.9; }
                }
            </style>
        `;

        fetch('/NhanVien/ProfileModal/' + id)
            .then(res => {
                if (!res.ok) throw new Error('Không thể tải thông tin nhân viên (Mã lỗi ' + res.status + ')');
                return res.text();
            })
            .then(html => {
                modalBody.innerHTML = html;
                if (window.HotelMotion && window.HotelMotion.applyEntrance) {
                    window.HotelMotion.applyEntrance(modalBody);
                }
            })
            .catch(err => {
                modalBody.innerHTML = `
                    <div class="alert alert-danger rounded-4 p-4 text-center my-3 border-0 shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill fs-2 text-danger d-block mb-2"></i>
                        <h6 class="fw-bold">Lỗi tải dữ liệu hồ sơ</h6>
                        <p class="small text-muted mb-0">${err.message}</p>
                    </div>
                `;
            });
    }

    // =========================================================================
    // ZERO FULL-PAGE RELOAD IN-PLACE PAGINATION & FILTERING (TARGETED ISOLATION)
    // =========================================================================
    function loadEmployeeTable(params = {}, shouldPushState = true) {
        const container = document.getElementById('employeeTableContainer');
        if (!container) return;

        // Xây dựng URL mục tiêu từ URL hiện tại
        const url = new URL(window.location.href);

        // Đọc giá trị từ form lọc hiện tại nếu có
        const form = document.querySelector('.catalog-toolbar form[method="get"]');
        if (form) {
            const formData = new FormData(form);
            for (const [key, val] of formData.entries()) {
                const trimmed = (val || '').toString().trim();
                if (trimmed) {
                    url.searchParams.set(key, trimmed);
                } else {
                    url.searchParams.delete(key);
                }
            }
        }

        // Cập nhật các tham số phân trang / tùy chỉnh
        for (const [k, v] of Object.entries(params)) {
            if (v !== null && v !== undefined && v !== '') {
                url.searchParams.set(k, v);
            } else {
                url.searchParams.delete(k);
            }
        }

        // Hiệu ứng nạp dữ liệu tại chỗ (Targeted Loading Isolation - Không reload trang)
        container.style.transition = 'opacity 0.2s ease';
        container.style.opacity = '0.45';
        container.style.pointerEvents = 'none';

        const fetchUrl = new URL(url.toString());
        fetchUrl.searchParams.set('isPartial', 'true');

        fetch(fetchUrl.toString(), {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'text/html'
            }
        })
        .then(res => {
            if (!res.ok) throw new Error('Lỗi cập nhật danh sách nhân viên (Mã lỗi ' + res.status + ')');
            return res.text();
        })
        .then(html => {
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;
            const newContainer = tempDiv.querySelector('#employeeTableContainer') || tempDiv.firstElementChild;
            if (newContainer && container) {
                container.outerHTML = newContainer.outerHTML;
            }

            // Đồng bộ URL mà không reload trang web
            if (shouldPushState) {
                window.history.pushState({ path: url.toString() }, '', url.toString());
            }

            // Cập nhật số lượng hiển thị trên toolbar
            const toolbarCount = document.querySelector('.catalog-toolbar [data-catalog-count]');
            const newBadge = document.querySelector('#employeeTableContainer [data-catalog-count]');
            if (toolbarCount && newBadge) {
                toolbarCount.innerHTML = newBadge.innerHTML;
            }

            // Kích hoạt hiệu ứng xuất hiện mượt mà
            if (window.HotelMotion && window.HotelMotion.applyEntrance) {
                const updatedContainer = document.getElementById('employeeTableContainer');
                if (updatedContainer) window.HotelMotion.applyEntrance(updatedContainer);
            }
        })
        .catch(err => {
            console.error('Lỗi nạp bảng nhân sự:', err);
            const currentContainer = document.getElementById('employeeTableContainer');
            if (currentContainer) {
                currentContainer.style.opacity = '1';
                currentContainer.style.pointerEvents = 'auto';
            }
        });
    }

    function goToEmployeePage(page, event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        loadEmployeeTable({ page: page });
    }

    function changeEmployeePageSize(pageSize) {
        loadEmployeeTable({ page: 1, pageSize: pageSize });
    }

    function resetEmployeeFilters() {
        const form = document.querySelector('.catalog-toolbar form[method="get"]');
        if (form) {
            form.reset();
            form.querySelectorAll('input, select').forEach(c => c.value = '');
        }
        loadEmployeeTable({ keyword: '', departmentId: '', status: '', page: 1 });
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Chặn submit mặc định của form để không bị reload toàn trang
        const form = document.querySelector('.catalog-toolbar form[method="get"]');
        if (form) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                loadEmployeeTable({ page: 1 });
            });
        }

        // Hỗ trợ nút Back / Forward trên trình duyệt
        window.addEventListener('popstate', () => {
            loadEmployeeTable({}, false);
        });
    });
</script>
}


