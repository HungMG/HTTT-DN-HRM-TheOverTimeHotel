@model OvertimeHotel.HRM.WebAdmin.Models.NhanVienIndexViewModel
@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <div class="text-uppercase small text-primary fw-bold">TSK-15 · Nhân sự</div>
            <h1 class="h2 fw-bold mb-1">Hồ sơ nhân viên</h1>
            <p class="text-muted mb-0">Quản lý thông tin cá nhân, liên hệ và phân công nhân sự.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEmployeeModal"><i class="bi bi-person-plus me-1"></i>Thêm nhân viên</button>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert"><i class="bi bi-check-circle me-2"></i>@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle me-2"></i>@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Tổng nhân viên</div><div class="fs-3 fw-bold">@Model.TotalEmployees</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Đang làm việc</div><div class="fs-3 fw-bold text-success">@Model.WorkingEmployees</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Phòng ban đang dùng</div><div class="fs-3 fw-bold text-primary">@Model.DepartmentOptions.Count</div></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="text-muted small">Quản lý HĐLĐ</div><div class="fs-3 fw-bold text-dark"><a asp-controller="HopDong" asp-action="Index" class="text-decoration-none">Mở trang <i class="bi bi-arrow-up-right fs-5"></i></a></div></div></div></div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-lg-4"><label class="form-label small fw-semibold">Tìm kiếm</label><input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tên, email hoặc số điện thoại" /></div>
                <div class="col-md-4 col-lg-2"><label class="form-label small fw-semibold">Phòng ban</label><select name="departmentId" asp-items="Model.DepartmentOptions" class="form-select"><option value="">Tất cả</option></select></div>
                <div class="col-md-4 col-lg-2"><label class="form-label small fw-semibold">Trạng thái</label><select name="status" class="form-select"><option value="">Tất cả</option><option value="DANG_LAM" selected="@(Model.Status == "DANG_LAM")">Đang làm</option><option value="NGHI_VIEC" selected="@(Model.Status == "NGHI_VIEC")">Nghỉ việc</option></select></div>
                <div class="col-md-6 col-lg-1"><button class="btn btn-primary w-100" title="Lọc"><i class="bi bi-funnel"></i></button></div>
                <div class="col-md-6 col-lg-1"><a asp-action="Index" class="btn btn-outline-secondary w-100" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a></div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Nhân viên</th><th>Phòng ban / Chức vụ</th><th>Liên hệ</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Employees)
                {
                    var employee = item.Employee;
                    <tr>
                        <td><div class="fw-semibold">@employee.HoTen</div><small class="text-muted">NV-@employee.MaNhanVien · @employee.GioiTinh</small></td>
                        <td><div>@employee.PhongBan?.TenPhongBan</div><small class="text-muted">@employee.ChucVu?.TenChucVu</small></td>
                        <td><div>@employee.Email</div><small class="text-muted">@employee.DienThoai</small></td>
                        <td><span class="badge text-bg-@(employee.TrangThai == "DANG_LAM" ? "success" : "secondary")">@(employee.TrangThai == "DANG_LAM" ? "Đang làm" : "Nghỉ việc")</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@employee.MaNhanVien" class="btn btn-sm btn-outline-primary" title="Sửa hồ sơ"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@employee.MaNhanVien" method="post" class="d-inline" onsubmit="return confirm('Xóa hồ sơ nhân viên này?');"><button class="btn btn-sm btn-outline-danger" title="Xóa hồ sơ"><i class="bi bi-trash"></i></button></form>
                        </td>
                    </tr>
                }
                @if (Model.Employees.Count == 0)
                { <tr><td colspan="5" class="text-center text-muted py-5">Không tìm thấy hồ sơ phù hợp với bộ lọc.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createEmployeeModal" tabindex="-1" aria-labelledby="createEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><div><div class="text-uppercase small text-primary fw-bold">Hồ sơ nhân sự</div><h2 class="modal-title h5 mb-0" id="createEmployeeModalLabel">Thêm nhân viên</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <form asp-action="Create" method="post" class="d-flex flex-column overflow-hidden">
                <div class="modal-body overflow-auto"><partial name="_EmployeeForm" model="Model.CreateEmployeeForm" /></div>
                <div class="modal-footer flex-shrink-0 bg-white"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Hủy</button><button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Lưu hồ sơ</button></div>
            </form>
        </div>
    </div>
</div>
