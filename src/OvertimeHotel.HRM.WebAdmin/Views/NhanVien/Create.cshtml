@model OvertimeHotel.HRM.WebAdmin.Models.NhanVienFormViewModel
@{ ViewData["Title"] = "Hoàn thiện hồ sơ nhân viên"; }
<section class="catalog-card p-4">
    <h1 class="h4 mb-3">Hoàn thiện hồ sơ nhân viên</h1>
    <form asp-action="Create" method="post">
        <partial name="_EmployeeForm" model="Model" />
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Lưu hồ sơ</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </form>
</section>
