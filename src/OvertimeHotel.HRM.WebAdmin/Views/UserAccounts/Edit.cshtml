@model EditAccountViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
    var isCurrentAccount = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentAccountId)
        && currentAccountId == Model.AccountId;
}

<div class="container-fluid py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
        <h2 class="fw-bold mt-2 mb-1">Chỉnh sửa tài khoản</h2>
        <p class="text-muted mb-0">Cập nhật tên đăng nhập, vai trò hoặc đặt lại mật khẩu.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            <form asp-action="Edit" asp-route-id="@Model.AccountId" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="AccountId" type="hidden" />
                <input asp-for="EmployeeId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="account-avatar account-avatar-lg">@(Model.EmployeeName.Length > 0 ? Model.EmployeeName[..1].ToUpperInvariant() : "N")</div>
                            <div>
                                <h5 class="fw-bold mb-1">@Model.EmployeeName</h5>
                                <div class="text-muted">@Model.EmployeeEmail</div>
                                <span class="badge @(Model.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") mt-2">
                                    @(Model.IsActive ? "Đang hoạt động" : "Đã bị khóa")
                                </span>
                                @if (isCurrentAccount)
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis mt-2">Tài khoản của bạn</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                        <h5 class="fw-bold mb-0"><i class="bi bi-sliders me-2 text-primary"></i>Thông tin tài khoản</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label fw-semibold"></label>
                                <input asp-for="Username" class="form-control" autocomplete="off" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RoleId" class="form-label fw-semibold"></label>
                                @if (isCurrentAccount)
                                {
                                    <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select" disabled></select>
                                    <input asp-for="RoleId" type="hidden" />
                                    <div class="form-text">Không thể tự thay đổi vai trò đang đăng nhập.</div>
                                }
                                else
                                {
                                    <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select"></select>
                                }
                                <span asp-validation-for="RoleId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                        <h5 class="fw-bold mb-0"><i class="bi bi-shield-lock me-2 text-warning"></i>Đặt lại mật khẩu</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted small">Để trống cả hai ô nếu muốn giữ nguyên mật khẩu hiện tại.</p>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
