@model CreateAccountViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="account-workspace account-workspace--bleed account-form-workspace">
    <header class="account-command-bar account-reveal">
        <a asp-action="Index" class="account-icon-action" aria-label="Quay lại danh sách"><i class="bi bi-arrow-left"></i></a>
        <div class="account-command-copy">
            <div class="account-eyebrow"><span class="account-live-dot"></span> New identity / TSK-13</div>
            <h1>Tạo <span>tài khoản mới</span></h1>
            <p>Liên kết nhân viên với một identity và thiết lập kênh quyền truy cập.</p>
        </div>
        <div class="account-step-indicator" aria-label="Tiến trình cấu hình">
            <span class="is-active">1</span><i></i><span class="is-active">2</span><i></i><span>3</span>
        </div>
    </header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="account-popup-stack" aria-live="assertive">
            <div class="account-popup account-popup--danger" data-account-toast role="alert">
                <div class="account-popup-icon"><i class="bi bi-exclamation-lg"></i></div>
                <div class="account-popup-copy"><small>Chưa thể tạo tài khoản</small><strong>Vui lòng kiểm tra và sửa các trường được đánh dấu bên dưới.</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        </div>
    }

    <form asp-action="Create" method="post" class="account-inspector-layout account-reveal">
        @Html.AntiForgeryToken()
        <div class="account-form-main">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <section class="inspector-card">
                <div class="inspector-card-heading">
                    <span class="inspector-index">01</span>
                    <div><small>Source object</small><h2>Nhân viên &amp; vai trò</h2></div>
                    <i class="bi bi-person-badge"></i>
                </div>
                <div class="inspector-card-body">
                    <div class="account-form-grid account-form-grid--7-5">
                        <div class="account-field">
                            <label asp-for="EmployeeId"><span>Nhân viên liên kết</span><small>Required</small></label>
                            <div class="account-select-wrap">
                                <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions">
                                    <option value="">Chọn nhân viên chưa có tài khoản</option>
                                </select>
                                <i class="bi bi-chevron-expand"></i>
                            </div>
                            <span asp-validation-for="EmployeeId" class="account-field-error"></span>
                            @if (Model.EmployeeOptions.Count == 0)
                            {
                                <div class="account-field-hint account-field-hint--warning"><i class="bi bi-info-circle"></i>Tất cả nhân viên đã có tài khoản.</div>
                            }
                        </div>
                        <div class="account-field">
                            <label asp-for="RoleId"><span>Role channel</span><small>RBAC</small></label>
                            <div class="account-select-wrap">
                                <select asp-for="RoleId" asp-items="Model.RoleOptions">
                                    <option value="">Chọn vai trò</option>
                                </select>
                                <i class="bi bi-chevron-expand"></i>
                            </div>
                            <span asp-validation-for="RoleId" class="account-field-error"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="inspector-card">
                <div class="inspector-card-heading">
                    <span class="inspector-index">02</span>
                    <div><small>Authentication properties</small><h2>Thông tin đăng nhập</h2></div>
                    <i class="bi bi-key"></i>
                </div>
                <div class="inspector-card-body">
                    <div class="account-form-grid">
                        <div class="account-field account-field--full">
                            <label asp-for="Username"><span>Tên đăng nhập</span><small>Unique</small></label>
                            <div class="account-input-wrap">
                                <i class="bi bi-at"></i>
                                <input asp-for="Username" autocomplete="off" placeholder="Ví dụ: nv.nguyenvana" />
                            </div>
                            <span asp-validation-for="Username" class="account-field-error"></span>
                        </div>
                        <div class="account-field">
                            <label asp-for="Password"><span>Mật khẩu</span><small>Min 8</small></label>
                            <div class="account-input-wrap account-password-wrap">
                                <i class="bi bi-lock"></i>
                                <input asp-for="Password" autocomplete="new-password" />
                                <button type="button" class="password-visibility" aria-label="Hiện hoặc ẩn mật khẩu"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="Password" class="account-field-error"></span>
                        </div>
                        <div class="account-field">
                            <label asp-for="ConfirmPassword"><span>Xác nhận mật khẩu</span><small>Match</small></label>
                            <div class="account-input-wrap account-password-wrap">
                                <i class="bi bi-shield-lock"></i>
                                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                                <button type="button" class="password-visibility" aria-label="Hiện hoặc ẩn mật khẩu"><i class="bi bi-eye"></i></button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="account-field-error"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="inspector-card inspector-card--compact">
                <div class="inspector-card-body">
                    <div class="account-switch-row">
                        <div>
                            <span class="state-chip state-chip--active"><i></i> Playback state</span>
                            <strong>Kích hoạt ngay sau khi tạo</strong>
                            <small>Identity có thể đăng nhập ngay khi được lưu.</small>
                        </div>
                        <label class="account-switch">
                            <input asp-for="IsActive" />
                            <span></span>
                        </label>
                    </div>
                </div>
            </section>

            <div class="account-form-actions">
                <a asp-action="Index">Hủy</a>
                <button type="submit" disabled="@(Model.EmployeeOptions.Count == 0)"><i class="bi bi-plus-lg"></i>Tạo identity</button>
            </div>
        </div>

        <aside class="account-preview-panel">
            <div class="account-panel-heading">
                <div><span>Inspector</span><strong>Access preview</strong></div>
                <i class="bi bi-stars"></i>
            </div>
            <div class="identity-preview">
                <div class="identity-preview-orbit"><span><i class="bi bi-person"></i></span></div>
                <small>New identity</small>
                <strong id="identityNamePreview">Chưa chọn nhân viên</strong>
                <span id="rolePreview" class="role-chip role-chip--employee"><i></i>Chưa cấp vai trò</span>
            </div>
            <div class="permission-stack">
                <div><i class="bi bi-check2"></i><span>Đăng nhập hệ thống</span><small>Enabled</small></div>
                <div><i class="bi bi-check2"></i><span>Cookie bảo mật</span><small>8 hours</small></div>
                <div><i class="bi bi-diagram-3"></i><span>Phạm vi quyền</span><small>Theo role</small></div>
            </div>
            <div class="preview-note"><i class="bi bi-lightning-charge-fill"></i><span>Quyền truy cập được áp dụng ngay khi identity được tạo.</span></div>
        </aside>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const employee = document.getElementById('EmployeeId');
            const role = document.getElementById('RoleId');
            const namePreview = document.getElementById('identityNamePreview');
            const rolePreview = document.getElementById('rolePreview');

            const syncPreview = () => {
                namePreview.textContent = employee?.selectedOptions[0]?.text || 'Chưa chọn nhân viên';
                const roleName = role?.selectedOptions[0]?.text || 'Chưa cấp vai trò';
                rolePreview.className = `role-chip role-chip--${roleName.toLowerCase() === 'admin' ? 'admin' : roleName.toLowerCase() === 'hr' ? 'hr' : roleName.toLowerCase() === 'manager' ? 'manager' : 'employee'}`;
                rolePreview.innerHTML = `<i></i>${roleName}`;
            };

            employee?.addEventListener('change', syncPreview);
            role?.addEventListener('change', syncPreview);
            syncPreview();

            document.querySelectorAll('.password-visibility').forEach(button => {
                button.addEventListener('click', () => {
                    const input = button.parentElement.querySelector('input');
                    input.type = input.type === 'password' ? 'text' : 'password';
                    button.querySelector('i').className = input.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
                });
            });
        })();
    </script>
}
