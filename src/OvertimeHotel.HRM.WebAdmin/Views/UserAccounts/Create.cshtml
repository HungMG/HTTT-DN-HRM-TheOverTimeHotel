@model CreateAccountViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<div class="container-fluid py-3">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
        <h2 class="fw-bold mt-2 mb-1">Tạo tài khoản mới</h2>
        <p class="text-muted mb-0">Liên kết một nhân viên chưa có tài khoản và cấp vai trò truy cập phù hợp.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                        <h5 class="fw-bold mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Nhân viên &amp; vai trò</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-md-7">
                                <label asp-for="EmployeeId" class="form-label fw-semibold"></label>
                                <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="form-select">
                                    <option value="">-- Chọn nhân viên chưa có tài khoản --</option>
                                </select>
                                <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                                @if (Model.EmployeeOptions.Count == 0)
                                {
                                    <div class="form-text text-warning"><i class="bi bi-info-circle me-1"></i>Tất cả nhân viên hiện đã có tài khoản.</div>
                                }
                            </div>
                            <div class="col-md-5">
                                <label asp-for="RoleId" class="form-label fw-semibold"></label>
                                <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select">
                                    <option value="">-- Chọn vai trò --</option>
                                </select>
                                <span asp-validation-for="RoleId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 px-4 pt-4 pb-2">
                        <h5 class="fw-bold mb-0"><i class="bi bi-key me-2 text-warning"></i>Thông tin đăng nhập</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="Username" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-at"></i></span>
                                    <input asp-for="Username" class="form-control" autocomplete="off" placeholder="Ví dụ: nv.nguyenvana" />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-semibold"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                                <div class="form-text">Tối thiểu 8 ký tự.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4" disabled="@(Model.EmployeeOptions.Count == 0)">
                        <i class="bi bi-check-lg me-1"></i>Tạo tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
