@model AccountIndexViewModel
@{
    string? VietnameseAuditValue(string? value) => value?
        .Replace("Vai trò: Admin", "Vai trò: Quản trị viên")
        .Replace("Vai trò: HR", "Vai trò: Nhân sự")
        .Replace("Vai trò: Manager", "Vai trò: Quản lý")
        .Replace("Vai trò: Employee", "Vai trò: Nhân viên");
    var firstPage = Math.Max(1, Model.AuditPageNumber - 2);
    var lastPage = Math.Min(Model.TotalAuditPages, Model.AuditPageNumber + 2);
}

@if (!Model.AuditLogAvailable)
{
    <div class="account-audit-unavailable p-4 text-center rounded-4 bg-white border shadow-sm">
        <i class="bi bi-database-exclamation fs-1 text-warning mb-2 d-block"></i>
        <div class="fw-bold text-dark">Chưa tải được nhật ký quản trị</div>
        <small class="text-muted">Kiểm tra kết nối CSDL hoặc chạy migration tạo bảng nhật ký.</small>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.AuditDateValidationMessage))
    {
        <div class="alert alert-warning border-0 rounded-3 p-2.5 mb-3 small d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-circle text-warning"></i>
            <span>@Model.AuditDateValidationMessage</span>
        </div>
    }
    @if (Model.AuditLogs.Count == 0)
    {
        <div class="p-5 text-center bg-white rounded-4 border shadow-sm my-2" data-account-audit-empty>
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-journal-text fs-3 text-muted"></i>
            </div>
            <div class="fw-bold text-dark small mb-1">
                @(Model.AuditFrom.HasValue || Model.AuditTo.HasValue ? "Không có nhật ký trong khoảng ngày đã chọn." : "Chưa có thao tác quản trị nào được ghi nhận.")
            </div>
            <small class="text-muted">Hệ thống sẽ tự động ghi lại lịch sử các lần cấp phát, khóa và phân quyền tài khoản.</small>
        </div>
    }
    <div class="account-audit-list d-flex flex-column gap-3" data-account-audit-list>
        @foreach (var log in Model.AuditLogs)
        {
            var actionClass = log.ActionCode switch
            {
                "CREATE_ACCOUNT" => "is-create",
                "LOCK_ACCOUNT" => "is-lock",
                "UNLOCK_ACCOUNT" => "is-unlock",
                "RESET_PASSWORD" => "is-password",
                _ => "is-update"
            };
            var actionColor = log.ActionCode switch
            {
                "CREATE_ACCOUNT" => "#16a34a",
                "LOCK_ACCOUNT" => "#dc2626",
                "UNLOCK_ACCOUNT" => "#2563eb",
                "RESET_PASSWORD" => "#d97706",
                _ => "#4f46e5"
            };
            var actionBg = log.ActionCode switch
            {
                "CREATE_ACCOUNT" => "rgba(22, 163, 74, 0.1)",
                "LOCK_ACCOUNT" => "rgba(220, 38, 38, 0.1)",
                "UNLOCK_ACCOUNT" => "rgba(37, 99, 235, 0.1)",
                "RESET_PASSWORD" => "rgba(217, 119, 6, 0.1)",
                _ => "rgba(79, 70, 229, 0.1)"
            };
            var actionIcon = log.ActionCode switch
            {
                "CREATE_ACCOUNT" => "bi-person-plus-fill",
                "LOCK_ACCOUNT" => "bi-person-lock",
                "UNLOCK_ACCOUNT" => "bi-person-check-fill",
                "RESET_PASSWORD" => "bi-key-fill",
                _ => "bi-sliders2"
            };
            var vietnamTime = log.OccurredAt.ToOffset(TimeSpan.FromHours(7));

            <article class="account-audit-item @actionClass card border-0 shadow-sm rounded-4 bg-white p-3.5 px-4 mb-3 transition-all hover-lift" style="display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 18px;">
                <!-- ICON HÀNH ĐỘNG -->
                <div class="account-audit-icon rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 46px; height: 46px; background-color: @actionBg; color: @actionColor; font-size: 1.15rem;">
                    <i class="bi @actionIcon"></i>
                </div>

                <!-- NỘI DUNG CHI TIẾT -->
                <div class="account-audit-content min-w-0">
                    <div class="account-audit-meta d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background-color: @actionBg; color: @actionColor; font-size: 0.78rem;">
                            @log.ActionName
                        </span>
                        <time class="text-muted small d-flex align-items-center gap-1.5 font-monospace" style="font-size: 0.76rem;" datetime="@log.OccurredAt.ToString("O")">
                            <i class="bi bi-clock"></i> @vietnamTime.ToString("dd/MM/yyyy · HH:mm")
                        </time>
                    </div>

                    <p class="mb-2.5 text-dark fw-semibold" style="font-size: 0.88rem; line-height: 1.5;">@log.Description</p>

                    <div class="account-audit-subject d-flex flex-wrap align-items-center justify-content-between gap-3 p-2.5 px-3 rounded-3 bg-light border small text-muted">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="d-inline-flex align-items-center gap-1.5 text-dark fw-medium" style="font-size: 0.8rem;">
                                <i class="bi bi-person-gear text-primary fs-6"></i>
                                <span class="text-muted small">Người thực hiện:</span> <strong class="text-dark">@log.ActorName</strong>
                            </span>
                            <i class="bi bi-arrow-right text-muted opacity-50 mx-1"></i>
                            <span class="d-inline-flex align-items-center gap-1.5 text-dark fw-bold font-monospace" style="font-size: 0.8rem;">
                                <span class="text-muted small fw-normal font-sans">Tác động:</span>
                                <span class="badge bg-white text-dark border px-2 py-1 rounded-2 shadow-2xs">@@@log.TargetUsername.TrimStart('@')</span>
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                        {
                            <span class="font-monospace text-muted d-inline-flex align-items-center gap-1" style="font-size: 0.74rem;">
                                <i class="bi bi-hdd-network text-secondary"></i> IP: @log.IpAddress
                            </span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(log.Reason))
                    {
                        <div class="account-audit-reason mt-2.5 p-2.5 px-3 rounded-3 bg-warning bg-opacity-10 border border-warning-subtle text-dark d-flex align-items-start gap-2" style="font-size: 0.82rem; line-height: 1.5;">
                            <i class="bi bi-chat-quote-fill text-warning flex-shrink-0 mt-0.5 fs-6"></i>
                            <div><b>Lý do ghi nhận:</b> @log.Reason</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(log.OldValue) || !string.IsNullOrWhiteSpace(log.NewValue))
                    {
                        <details class="account-audit-change mt-2.5">
                            <summary class="cursor-pointer text-primary fw-semibold d-inline-flex align-items-center gap-1.5 py-1" style="cursor: pointer; font-size: 0.8rem;">
                                <i class="bi bi-clock-history"></i> Xem chi tiết dữ liệu thay đổi
                            </summary>
                            <div class="mt-2.5 p-3 rounded-3 bg-light border row g-3 align-items-center" style="font-size: 0.82rem;">
                                <div class="col-md-5 col-12">
                                    <div class="p-2.5 rounded-3 bg-danger bg-opacity-10 border border-danger-subtle text-danger-emphasis">
                                        <span class="badge bg-danger text-white rounded-pill px-2 py-0.5 mb-1.5" style="font-size: 0.68rem;">Dữ liệu trước</span>
                                        <div class="fw-semibold">@(VietnameseAuditValue(log.OldValue) ?? "—")</div>
                                    </div>
                                </div>
                                <div class="col-md-2 col-12 text-center text-muted">
                                    <i class="bi bi-arrow-right fs-4 d-none d-md-inline-block"></i>
                                    <i class="bi bi-arrow-down fs-4 d-md-none"></i>
                                </div>
                                <div class="col-md-5 col-12">
                                    <div class="p-2.5 rounded-3 bg-success bg-opacity-10 border border-success-subtle text-success-emphasis">
                                        <span class="badge bg-success text-white rounded-pill px-2 py-0.5 mb-1.5" style="font-size: 0.68rem;">Dữ liệu sau</span>
                                        <div class="fw-semibold">@(VietnameseAuditValue(log.NewValue) ?? "—")</div>
                                    </div>
                                </div>
                            </div>
                        </details>
                    }
                </div>
            </article>
        }
    </div>
    @if (Model.TotalAuditPages > 1)
    {
        <nav class="account-pagination account-audit-pagination mt-4 d-flex justify-content-center" aria-label="Phân trang nhật ký quản trị">
            <div class="account-pagination-actions d-inline-flex align-items-center gap-1 bg-white p-1 rounded-pill border shadow-sm">
                <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" data-account-audit-page="@(Model.AuditPageNumber - 1)" disabled="@(Model.AuditPageNumber == 1)" aria-label="Trang trước">
                    <i class="bi bi-chevron-left" style="font-size: 0.75rem;"></i>
                </button>
                @for (var auditPageIndex = firstPage; auditPageIndex <= lastPage; auditPageIndex++)
                {
                    <button type="button" data-account-audit-page="@auditPageIndex" class="btn btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center @(auditPageIndex == Model.AuditPageNumber ? "btn-primary text-white fw-bold shadow-sm" : "btn-light text-secondary")" style="width: 30px; height: 30px; font-size: 0.78rem;" aria-current="@(auditPageIndex == Model.AuditPageNumber ? "page" : null)">
                        @auditPageIndex
                    </button>
                }
                <button type="button" class="btn btn-sm btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" data-account-audit-page="@(Model.AuditPageNumber + 1)" disabled="@(Model.AuditPageNumber == Model.TotalAuditPages)" aria-label="Trang sau">
                    <i class="bi bi-chevron-right" style="font-size: 0.75rem;"></i>
                </button>
            </div>
        </nav>
    }
}
