@model AccountIndexViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Quản trị tài khoản";
    var currentAccountId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId)
        ? parsedId
        : 0;
}

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4">
        <div>
            <div class="text-primary fw-semibold small text-uppercase mb-1">TSK-13 · Quản trị hệ thống</div>
            <h2 class="fw-bold mb-1">Tài khoản &amp; phân quyền</h2>
            <p class="text-muted mb-0">Quản lý thông tin đăng nhập, trạng thái và vai trò RBAC của nhân sự khách sạn.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i>Tạo tài khoản
        </a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    @if (ViewBag.ErrorMessage is string viewBagError)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>@viewBagError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="account-stat-icon bg-primary-subtle text-primary"><i class="bi bi-people-fill"></i></span>
                    <div><div class="text-muted small">Tổng tài khoản</div><div class="fs-3 fw-bold">@Model.TotalAccounts</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="account-stat-icon bg-success-subtle text-success"><i class="bi bi-person-check-fill"></i></span>
                    <div><div class="text-muted small">Đang hoạt động</div><div class="fs-3 fw-bold">@Model.ActiveAccounts</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="account-stat-icon bg-danger-subtle text-danger"><i class="bi bi-person-lock"></i></span>
                    <div><div class="text-muted small">Đang bị khóa</div><div class="fs-3 fw-bold">@Model.LockedAccounts</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="account-stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-shield-fill-check"></i></span>
                    <div><div class="text-muted small">Quản trị viên</div><div class="fs-3 fw-bold">@Model.AdminAccounts</div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-lg-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label asp-for="Keyword" class="form-label fw-semibold">Tìm kiếm</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input asp-for="Keyword" class="form-control" placeholder="Tên đăng nhập, họ tên hoặc email..." />
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label asp-for="RoleId" class="form-label fw-semibold">Vai trò</label>
                    <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select">
                        <option value="">Tất cả vai trò</option>
                    </select>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label asp-for="IsActive" class="form-label fw-semibold">Trạng thái</label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="true">Hoạt động</option>
                        <option value="false">Đã khóa</option>
                    </select>
                </div>
                <div class="col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark flex-grow-1"><i class="bi bi-funnel me-1"></i>Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-3 p-lg-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="bi bi-person-vcard me-2 text-primary"></i>Danh sách tài khoản</h5>
            <span class="badge text-bg-light border">@Model.Accounts.Count kết quả</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nhân viên</th>
                        <th>Tài khoản</th>
                        <th>Đơn vị công tác</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Accounts.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-person-x display-5 text-secondary"></i>
                                <div class="fw-semibold mt-2">Không tìm thấy tài khoản phù hợp</div>
                                <div class="text-muted small">Hãy thay đổi điều kiện tìm kiếm hoặc tạo tài khoản mới.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var account in Model.Accounts)
                        {
                            var roleBadge = account.RoleName switch
                            {
                                "Admin" => "text-bg-danger",
                                "HR" => "text-bg-primary",
                                "Manager" => "text-bg-warning",
                                _ => "text-bg-secondary"
                            };
                            var isCurrentAccount = account.AccountId == currentAccountId;
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="account-avatar">@(account.EmployeeName.Length > 0 ? account.EmployeeName[..1].ToUpperInvariant() : "N")</div>
                                        <div>
                                            <div class="fw-semibold">@account.EmployeeName</div>
                                            <div class="small text-muted">@account.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <code class="text-dark">@account.Username</code>
                                    @if (isCurrentAccount)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis ms-1">Bạn</span>
                                    }
                                </td>
                                <td>
                                    <div class="small fw-semibold">@account.Position</div>
                                    <div class="small text-muted">@account.Department</div>
                                </td>
                                <td><span class="badge @roleBadge px-3 py-2">@account.RoleName</span></td>
                                <td>
                                    @if (account.IsActive)
                                    {
                                        <span class="text-success fw-semibold small"><i class="bi bi-check-circle-fill me-1"></i>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold small"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@account.AccountId" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@account.AccountId" method="post"
                                              onsubmit="return confirm('@(account.IsActive ? "Khóa tài khoản này?" : "Mở khóa tài khoản này?")');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm @(account.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(account.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")"
                                                    disabled="@isCurrentAccount">
                                                <i class="bi @(account.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
