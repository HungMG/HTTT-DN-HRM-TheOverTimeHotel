@model AccountIndexViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Quản trị tài khoản";
    var currentAccountId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId)
        ? parsedId
        : 0;
}

<div class="account-workspace account-workspace--bleed">
    <header class="account-command-bar account-reveal">
        <div class="account-product-mark" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>
        <div class="account-command-copy">
            <div class="account-eyebrow"><span class="account-live-dot"></span> TSK-13 · Access workspace</div>
            <h1>Tài khoản <span>&amp; phân quyền</span></h1>
            <p>Điều phối danh tính, trạng thái và vai trò truy cập của toàn bộ nhân sự.</p>
        </div>
        <div class="account-command-actions">
            <div class="account-environment-pill" title="Môi trường quản trị">
                <i class="bi bi-shield-check"></i>
                <span>RBAC</span>
                <strong>Live</strong>
            </div>
            <a asp-action="Create" class="account-primary-action">
                <i class="bi bi-plus-lg"></i><span>Tạo tài khoản</span>
            </a>
        </div>
    </header>

    <div class="account-popup-stack" aria-live="polite" aria-atomic="true">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="account-popup account-popup--success" data-account-toast role="status">
                <div class="account-popup-icon"><i class="bi bi-check2"></i></div>
                <div class="account-popup-copy"><small>Thao tác thành công</small><strong>@successMessage</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="account-popup account-popup--danger" data-account-toast role="alert">
                <div class="account-popup-icon"><i class="bi bi-exclamation-lg"></i></div>
                <div class="account-popup-copy"><small>Không thể thực hiện</small><strong>@errorMessage</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
        @if (ViewBag.ErrorMessage is string viewBagError)
        {
            <div class="account-popup account-popup--danger" data-account-toast role="alert">
                <div class="account-popup-icon"><i class="bi bi-database-exclamation"></i></div>
                <div class="account-popup-copy"><small>Lỗi dữ liệu</small><strong>@viewBagError</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
    </div>

    <section class="account-stat-grid account-reveal" aria-label="Tổng quan tài khoản">
        <article class="motion-stat motion-stat--violet">
            <div class="motion-stat-top"><span>01 / Total identities</span><i class="bi bi-people"></i></div>
            <div class="motion-stat-value">@Model.TotalAccounts</div>
            <div class="motion-stat-label">Tổng tài khoản</div>
            <div class="motion-stat-track"><span style="width: 100%"></span></div>
        </article>
        <article class="motion-stat motion-stat--green">
            <div class="motion-stat-top"><span>02 / Active layer</span><i class="bi bi-play-fill"></i></div>
            <div class="motion-stat-value">@Model.ActiveAccounts</div>
            <div class="motion-stat-label">Đang hoạt động</div>
            <div class="motion-stat-track"><span style="width: @(Model.TotalAccounts > 0 ? Math.Round(Model.ActiveAccounts * 100d / Model.TotalAccounts) : 0)%"></span></div>
        </article>
        <article class="motion-stat motion-stat--red">
            <div class="motion-stat-top"><span>03 / Locked layer</span><i class="bi bi-pause-fill"></i></div>
            <div class="motion-stat-value">@Model.LockedAccounts</div>
            <div class="motion-stat-label">Đang bị khóa</div>
            <div class="motion-stat-track"><span style="width: @(Model.TotalAccounts > 0 ? Math.Round(Model.LockedAccounts * 100d / Model.TotalAccounts) : 0)%"></span></div>
        </article>
        <article class="motion-stat motion-stat--amber">
            <div class="motion-stat-top"><span>04 / Privileged</span><i class="bi bi-key"></i></div>
            <div class="motion-stat-value">@Model.AdminAccounts</div>
            <div class="motion-stat-label">Quản trị viên</div>
            <div class="motion-stat-track"><span style="width: @(Model.TotalAccounts > 0 ? Math.Round(Model.AdminAccounts * 100d / Model.TotalAccounts) : 0)%"></span></div>
        </article>
    </section>

    <section class="account-editor-grid account-reveal">
        <aside class="account-outline-panel">
            <div class="account-panel-heading">
                <div><span>Outline</span><strong>Bộ lọc truy cập</strong></div>
                <i class="bi bi-sliders2"></i>
            </div>
            <form method="get" asp-action="Index" class="account-filter-form">
                <div class="account-field">
                    <label asp-for="Keyword"><span>Search</span><small>⌘ K</small></label>
                    <div class="account-input-wrap">
                        <i class="bi bi-search"></i>
                        <input asp-for="Keyword" placeholder="Tên, email, tài khoản..." />
                    </div>
                </div>
                <div class="account-field">
                    <label asp-for="RoleId"><span>Role channel</span><small>RBAC</small></label>
                    <div class="account-select-wrap">
                        <select asp-for="RoleId" asp-items="Model.RoleOptions">
                            <option value="">Tất cả vai trò</option>
                        </select>
                        <i class="bi bi-chevron-expand"></i>
                    </div>
                </div>
                <div class="account-field">
                    <label asp-for="IsActive"><span>Playback state</span><small>Status</small></label>
                    <div class="account-select-wrap">
                        <select asp-for="IsActive">
                            <option value="">Tất cả trạng thái</option>
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Đã khóa</option>
                        </select>
                        <i class="bi bi-chevron-expand"></i>
                    </div>
                </div>
                <div class="account-filter-actions">
                    <button type="submit"><i class="bi bi-funnel-fill"></i> Áp dụng</button>
                    <a asp-action="Index" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>

            <div class="account-role-legend">
                <div class="account-panel-heading account-panel-heading--compact">
                    <div><span>Channels</span><strong>Chú thích vai trò</strong></div>
                </div>
                <div class="role-legend-item"><span class="role-swatch role-swatch--admin"></span><span>Admin</span><small>Toàn quyền</small></div>
                <div class="role-legend-item"><span class="role-swatch role-swatch--hr"></span><span>HR</span><small>Nhân sự</small></div>
                <div class="role-legend-item"><span class="role-swatch role-swatch--manager"></span><span>Manager</span><small>Điều phối</small></div>
                <div class="role-legend-item"><span class="role-swatch role-swatch--employee"></span><span>Employee</span><small>Cá nhân</small></div>
            </div>
        </aside>

        <div class="account-sequence-panel">
            <div class="account-sequence-toolbar">
                <div class="sequence-title">
                    <span class="sequence-play"><i class="bi bi-play-fill"></i></span>
                    <div><small>Sequence / Staff access</small><strong>Danh sách tài khoản</strong></div>
                </div>
                <div class="sequence-meta">
                    <span><i class="bi bi-record-circle"></i> @Model.Accounts.Count kết quả</span>
                    <span class="sequence-time">00:@Model.TotalAccounts.ToString("00")</span>
                </div>
            </div>

            <div class="account-ruler" aria-hidden="true">
                <span>00</span><span>05</span><span>10</span><span>15</span><span>20</span><span>25</span>
            </div>

            <div class="account-table-wrap">
                <table class="account-table">
                    <thead>
                        <tr>
                            <th>Identity</th>
                            <th>Username</th>
                            <th>Workspace</th>
                            <th>Role</th>
                            <th>State</th>
                            <th><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Accounts.Count == 0)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="account-empty-state">
                                        <div><i class="bi bi-person-x"></i></div>
                                        <strong>Không có identity phù hợp</strong>
                                        <span>Thử thay đổi bộ lọc hoặc tạo một tài khoản mới.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var rowIndex = 0;
                            @foreach (var account in Model.Accounts)
                            {
                                rowIndex++;
                                var roleClass = account.RoleName switch
                                {
                                    "Admin" => "role-chip--admin",
                                    "HR" => "role-chip--hr",
                                    "Manager" => "role-chip--manager",
                                    _ => "role-chip--employee"
                                };
                                var isCurrentAccount = account.AccountId == currentAccountId;
                                <tr class="@(!account.IsActive ? "is-locked" : null)" style="--row-delay: @(rowIndex * 35)ms">
                                    <td>
                                        <div class="account-identity">
                                            <div class="account-avatar">@(account.EmployeeName.Length > 0 ? account.EmployeeName[..1].ToUpperInvariant() : "N")</div>
                                            <div>
                                                <strong>@account.EmployeeName</strong>
                                                <span>@account.Email</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="account-username"><i class="bi bi-code-slash"></i>@account.Username</div>
                                        @if (isCurrentAccount)
                                        {
                                            <span class="account-you-chip">Current</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="account-work-unit"><strong>@account.Position</strong><span>@account.Department</span></div>
                                    </td>
                                    <td><span class="role-chip @roleClass"><i></i>@account.RoleName</span></td>
                                    <td>
                                        <span class="state-chip @(account.IsActive ? "state-chip--active" : "state-chip--locked")">
                                            <i></i>@(account.IsActive ? "Running" : "Paused")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="account-row-actions">
                                            <a asp-action="Edit" asp-route-id="@account.AccountId" title="Chỉnh sửa"><i class="bi bi-sliders"></i></a>
                                            <form asp-action="ToggleStatus" asp-route-id="@account.AccountId" method="post"
                                                  class="account-toggle-form"
                                                  data-account-name="@account.EmployeeName"
                                                  data-account-mode="@(account.IsActive ? "lock" : "unlock")">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="@(account.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")" disabled="@isCurrentAccount">
                                                    <i class="bi @(account.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<dialog class="account-confirm-dialog" data-account-confirm>
    <div class="account-confirm-card">
        <button type="button" class="account-confirm-close" data-account-confirm-cancel aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
        <div class="account-confirm-icon"><i class="bi bi-person-lock"></i></div>
        <small>TSK-13 · Xác nhận thao tác</small>
        <h2 data-account-confirm-title>Khóa tài khoản?</h2>
        <p data-account-confirm-message>Người dùng sẽ không thể đăng nhập cho đến khi tài khoản được mở khóa.</p>
        <div class="account-confirm-target"><i class="bi bi-person"></i><span data-account-confirm-name>Tài khoản</span></div>
        <div class="account-confirm-actions">
            <button type="button" data-account-confirm-cancel>Hủy bỏ</button>
            <button type="button" data-account-confirm-submit><i class="bi bi-check2"></i><span>Xác nhận</span></button>
        </div>
    </div>
</dialog>
