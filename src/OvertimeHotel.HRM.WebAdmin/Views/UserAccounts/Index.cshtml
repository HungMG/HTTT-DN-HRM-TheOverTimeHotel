@model AccountIndexViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Quản trị tài khoản";
}

<div class="account-workspace account-workspace--bleed" data-account-workspace data-status-filter="@(Model.IsActive.HasValue ? Model.IsActive.Value.ToString().ToLowerInvariant() : string.Empty)" data-audit-from="@(Model.AuditFrom?.ToString("yyyy-MM-dd"))" data-audit-to="@(Model.AuditTo?.ToString("yyyy-MM-dd"))">
    <header class="account-command-bar account-reveal">
        <div class="account-product-mark" aria-hidden="true">
            <span></span><span></span><span></span>
        </div>
        <div class="account-command-copy">
            <div class="account-eyebrow"><span class="account-live-dot"></span> Không gian quản trị</div>
            <h1>Tài khoản <span>&amp; phân quyền</span></h1>
            <p>Điều phối danh tính, trạng thái và vai trò truy cập của toàn bộ nhân sự.</p>
        </div>
        <div class="account-command-actions">
            <div class="account-environment-pill" title="Môi trường quản trị">
                <i class="bi bi-shield-check"></i>
                <span>RBAC</span>
                <strong>Trực tuyến</strong>
            </div>
            <a asp-action="Create" class="account-primary-action">
                <i class="bi bi-plus-lg"></i><span>Tạo tài khoản</span>
            </a>
        </div>
    </header>

    <div class="account-popup-stack" aria-live="polite" aria-atomic="true">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="account-popup account-popup--success" data-account-toast role="status">
                <div class="account-popup-icon"><i class="bi bi-check2"></i></div>
                <div class="account-popup-copy"><small>Thao tác thành công</small><strong>@successMessage</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="account-popup account-popup--danger" data-account-toast role="alert">
                <div class="account-popup-icon"><i class="bi bi-exclamation-lg"></i></div>
                <div class="account-popup-copy"><small>Không thể thực hiện</small><strong>@errorMessage</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
        @if (ViewBag.ErrorMessage is string viewBagError)
        {
            <div class="account-popup account-popup--danger" data-account-toast role="alert">
                <div class="account-popup-icon"><i class="bi bi-database-exclamation"></i></div>
                <div class="account-popup-copy"><small>Lỗi dữ liệu</small><strong>@viewBagError</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
    </div>

    <section class="account-stat-grid account-reveal" aria-label="Tổng quan tài khoản">
        <article class="motion-stat motion-stat--violet">
            <div class="motion-stat-top"><span>01 / Tổng tài khoản</span><i class="bi bi-people"></i></div>
            <div class="motion-stat-value" data-account-total>@Model.TotalAccounts</div>
            <div class="motion-stat-label">Tổng tài khoản</div>
            <div class="motion-stat-track"><span style="width: 100%"></span></div>
        </article>
        <article class="motion-stat motion-stat--green">
            <div class="motion-stat-top"><span>02 / Đang hoạt động</span><i class="bi bi-play-fill"></i></div>
            <div class="motion-stat-value" data-account-active>@Model.ActiveAccounts</div>
            <div class="motion-stat-label">Đang hoạt động</div>
            <div class="motion-stat-track"><span data-account-active-track style="width: @(Model.TotalAccounts > 0 ? Math.Round(Model.ActiveAccounts * 100d / Model.TotalAccounts) : 0)%"></span></div>
        </article>
        <article class="motion-stat motion-stat--red">
            <div class="motion-stat-top"><span>03 / Đang bị khóa</span><i class="bi bi-pause-fill"></i></div>
            <div class="motion-stat-value" data-account-locked>@Model.LockedAccounts</div>
            <div class="motion-stat-label">Đang bị khóa</div>
            <div class="motion-stat-track"><span data-account-locked-track style="width: @(Model.TotalAccounts > 0 ? Math.Round(Model.LockedAccounts * 100d / Model.TotalAccounts) : 0)%"></span></div>
        </article>
        <article class="motion-stat motion-stat--amber">
            <div class="motion-stat-top"><span>04 / Quyền quản trị</span><i class="bi bi-key"></i></div>
            <div class="motion-stat-value">@Model.AdminAccounts</div>
            <div class="motion-stat-label">Quản trị viên</div>
            <div class="motion-stat-track"><span style="width: @(Model.TotalAccounts > 0 ? Math.Round(Model.AdminAccounts * 100d / Model.TotalAccounts) : 0)%"></span></div>
        </article>
    </section>

    <section class="account-editor-grid account-reveal">
        <aside class="account-outline-panel">
            <div class="account-panel-heading">
                <div><span>Bộ lọc</span><strong>Bộ lọc truy cập</strong></div>
                <i class="bi bi-sliders2"></i>
            </div>
            <form method="get" asp-action="Index" class="account-filter-form" data-account-filter-form>
                <input type="hidden" name="auditFrom" value="@(Model.AuditFrom?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="auditTo" value="@(Model.AuditTo?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="page" value="@Model.PageNumber" data-account-page-input />
                <div class="account-field">
                    <label asp-for="Keyword"><span>Tìm kiếm</span><small>⌘ K</small></label>
                    <div class="account-input-wrap">
                        <i class="bi bi-search"></i>
                        <input asp-for="Keyword" placeholder="Tên, email, tài khoản..." autocomplete="off" data-account-search-input />
                    </div>
                </div>
                <div class="account-field">
                    <label asp-for="RoleId"><span>Vai trò</span><small>RBAC</small></label>
                    <div class="account-select-wrap">
                        <select asp-for="RoleId" asp-items="Model.RoleOptions" data-account-role-select>
                            <option value="">Tất cả vai trò</option>
                        </select>
                        <i class="bi bi-chevron-expand"></i>
                    </div>
                </div>
                <div class="account-field">
                    <label asp-for="IsActive"><span>Trạng thái</span><small>Trạng thái</small></label>
                    <div class="account-select-wrap">
                        <select asp-for="IsActive" data-account-status-select>
                            <option value="">Tất cả trạng thái</option>
                            <option value="true">Đang hoạt động</option>
                            <option value="false">Đã khóa</option>
                        </select>
                        <i class="bi bi-chevron-expand"></i>
                    </div>
                </div>
                <div class="account-filter-actions">
                    <button type="submit"><i class="bi bi-funnel-fill"></i> Áp dụng</button>
                    <a asp-action="Index" title="Đặt lại bộ lọc" data-account-filter-reset><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>

            <section class="account-role-legend" role="list" aria-labelledby="roleAccessTitle">
                <div class="account-panel-heading account-panel-heading--compact">
                    <div><span>RBAC</span><strong id="roleAccessTitle">Phạm vi quyền truy cập</strong></div>
                </div>
                <div class="role-legend-item" role="listitem"><span class="role-swatch role-swatch--admin"></span><span>Quản trị viên</span><small>Toàn quyền hệ thống</small></div>
                <div class="role-legend-item" role="listitem"><span class="role-swatch role-swatch--hr"></span><span>Nhân sự</span><small>Hồ sơ &amp; chính sách</small></div>
                <div class="role-legend-item" role="listitem"><span class="role-swatch role-swatch--manager"></span><span>Quản lý</span><small>Phê duyệt vận hành</small></div>
                <div class="role-legend-item" role="listitem"><span class="role-swatch role-swatch--employee"></span><span>Nhân viên</span><small>Tự phục vụ cá nhân</small></div>
            </section>
        </aside>

        <div class="account-sequence-panel position-relative" id="accountSequenceWrapper">
            <!-- Loading overlay cục bộ đồng bộ chuẩn từ trang Phân Ca -->
            <div id="accountLoadingOverlay" class="in-place-loading-overlay d-none">
                <div class="spinner-border text-primary mb-2" role="status" style="width: 2.3rem; height: 2.3rem;">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <div class="fw-bold text-dark small font-serif">Đang cập nhật danh sách tài khoản...</div>
                <span class="text-muted small" style="font-size: 0.72rem;">Không tải lại toàn trang (In-Place Transition)</span>
            </div>

            <div id="accountTableContainer" class="in-place-enter in-place-container">
                <partial name="_AccountTable" model="Model" />
            </div>
        </div>
    </section>

    <section class="account-audit-panel account-reveal position-relative" aria-labelledby="auditLogTitle">
        <!-- Loading overlay cho khung nhật ký quản trị -->
        <div id="auditLoadingOverlay" class="in-place-loading-overlay d-none">
            <div class="spinner-border text-primary mb-2" role="status" style="width: 2rem; height: 2rem;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <div class="fw-bold text-dark small font-serif">Đang lọc nhật ký quản trị...</div>
            <span class="text-muted small" style="font-size: 0.72rem;">Không tải lại toàn trang (In-Place Transition)</span>
        </div>

        <div class="account-audit-heading">
            <div class="account-audit-title">
                <span class="account-audit-mark"><i class="bi bi-journal-check"></i></span>
                <div>
                    <small>Nhật ký thao tác</small>
                    <div class="account-audit-title-line">
                        <h2 id="auditLogTitle">Nhật ký quản trị gần đây</h2>
                        <span class="account-audit-count account-audit-count--badge"><i class="bi bi-clock-history"></i><b data-account-audit-count>@Model.TotalAuditLogs</b> hoạt động</span>
                    </div>
                </div>
            </div>
            <div class="account-audit-tools">
                <form method="get" asp-action="Index" class="account-audit-filter" data-account-audit-filter data-audit-endpoint="@Url.Action("AuditLogs")" aria-label="Lọc nhật ký theo ngày">
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <input type="hidden" name="roleId" value="@Model.RoleId" />
                    <input type="hidden" name="isActive" value="@Model.IsActive" />
                    <input type="hidden" name="auditPage" value="@Model.AuditPageNumber" data-account-audit-page-input />
                    <div class="account-range-picker" data-account-range-picker>
                        <button type="button" class="account-range-trigger" data-account-range-trigger aria-expanded="false" aria-controls="auditRangePopover">
                            <i class="bi bi-calendar3"></i>
                            <span data-account-range-label>Chọn khoảng ngày</span>
                            <i class="bi bi-chevron-down account-range-chevron"></i>
                        </button>
                        <div id="auditRangePopover" class="account-range-popover" data-account-range-popover role="dialog" aria-label="Chọn khoảng ngày nhật ký">
                            <div class="account-range-popover-heading">
                                <span>Thời gian</span>
                                <small>Chọn nhanh hoặc khoảng tùy chỉnh</small>
                            </div>
                            <div class="account-range-presets" aria-label="Khoảng ngày gợi ý">
                                <button type="button" data-account-audit-preset="today">Hôm nay</button>
                                <button type="button" data-account-audit-preset="yesterday">Hôm qua</button>
                                <button type="button" data-account-audit-preset="last-week">Tuần trước</button>
                            </div>
                            <div class="account-range-fields">
                                <label><span>Từ</span><input type="date" name="auditFrom" value="@(Model.AuditFrom?.ToString("yyyy-MM-dd"))" max="@(Model.AuditTo?.ToString("yyyy-MM-dd"))" /></label>
                                <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                <label><span>Đến</span><input type="date" name="auditTo" value="@(Model.AuditTo?.ToString("yyyy-MM-dd"))" min="@(Model.AuditFrom?.ToString("yyyy-MM-dd"))" /></label>
                            </div>
                            <button type="submit" class="account-range-apply"><i class="bi bi-check2"></i><span>Áp dụng</span></button>
                        </div>
                    </div>
                    <button type="button" data-account-audit-clear class="@(!(Model.AuditFrom.HasValue || Model.AuditTo.HasValue) ? "is-disabled" : null)" aria-disabled="@(!(Model.AuditFrom.HasValue || Model.AuditTo.HasValue) ? "true" : "false")" title="Xóa lọc ngày"><i class="bi bi-x-lg"></i><span>Xóa ngày</span></button>
                </form>
            </div>
        </div>

        <div data-account-audit-content class="in-place-enter in-place-container">
            <partial name="_AuditLogList" model="Model" />
        </div>
    </section>
</div>

<dialog class="account-confirm-dialog" data-account-confirm>
    <div class="account-confirm-card">
        <button type="button" class="account-confirm-close" data-account-confirm-cancel aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
        <div class="account-confirm-icon"><i class="bi bi-person-lock"></i></div>
        <small>Xác nhận thao tác</small>
        <h2 data-account-confirm-title>Khóa tài khoản?</h2>
        <p data-account-confirm-message>Người dùng sẽ không thể đăng nhập cho đến khi tài khoản được mở khóa.</p>
        <div class="account-confirm-target"><i class="bi bi-person"></i><span data-account-confirm-name>Tài khoản</span></div>
        <label class="account-confirm-reason">
            <span>Lý do thực hiện <b>*</b></span>
            <textarea rows="3" maxlength="500" data-account-confirm-reason placeholder="Nhập lý do để lưu vào nhật ký quản trị"></textarea>
            <small data-account-confirm-reason-error>Vui lòng nhập lý do trước khi xác nhận.</small>
        </label>
        <div class="account-confirm-actions">
            <button type="button" data-account-confirm-cancel>Hủy bỏ</button>
            <button type="button" data-account-confirm-submit><i class="bi bi-check2"></i><span>Xác nhận</span></button>
        </div>
    </div>
</dialog>
