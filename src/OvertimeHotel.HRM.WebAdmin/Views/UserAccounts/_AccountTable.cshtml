@model AccountIndexViewModel
@using System.Security.Claims
@{
    var currentAccountId = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var parsedId)
        ? parsedId
        : 0;
    string VietnameseRoleName(string roleName) => roleName switch
    {
        "Admin" => "Quản trị viên",
        "HR" => "Nhân sự",
        "Manager" => "Quản lý",
        "Employee" => "Nhân viên",
        _ => roleName
    };
    var firstAccount = Model.TotalFilteredAccounts == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var lastAccount = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalFilteredAccounts);
    var firstPage = Math.Max(1, Model.PageNumber - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

<div class="account-sequence-toolbar">
    <div class="sequence-title">
        <span class="sequence-play"><i class="bi bi-play-fill"></i></span>
        <div>
            <small>Luồng quản lý truy cập</small>
            <div class="sequence-title-line">
                <strong>Danh sách tài khoản</strong>
                <span class="sequence-result-badge"><i class="bi bi-record-circle"></i> <b data-account-result-count>@Model.TotalFilteredAccounts</b> kết quả</span>
            </div>
        </div>
    </div>
    <div class="sequence-meta">
        <span class="sequence-time">00:@Model.TotalAccounts.ToString("00")</span>
    </div>
</div>

<div class="account-table-wrap">
    <table class="account-table">
        <thead>
            <tr>
                <th>Tài khoản</th>
                <th>Tên đăng nhập</th>
                <th>Đơn vị công tác</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th><span class="visually-hidden">Thao tác</span></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Accounts.Count == 0)
            {
                <tr data-account-empty-row>
                    <td colspan="6">
                        <div class="account-empty-state">
                            <div><i class="bi bi-person-x"></i></div>
                            <strong>Không có tài khoản phù hợp</strong>
                            <span>Thử thay đổi bộ lọc hoặc tạo một tài khoản mới.</span>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                var rowIndex = 0;
                @foreach (var account in Model.Accounts)
                {
                    rowIndex++;
                    var roleClass = account.RoleName switch
                    {
                        "Admin" => "role-chip--admin",
                        "HR" => "role-chip--hr",
                        "Manager" => "role-chip--manager",
                        _ => "role-chip--employee"
                    };
                    var roleDisplayName = VietnameseRoleName(account.RoleName);
                    var isCurrentAccount = account.AccountId == currentAccountId;
                    <tr class="@(!account.IsActive ? "is-locked" : null)" style="--row-delay: @(rowIndex * 35)ms" data-account-row="@account.AccountId">
                        <td>
                            <div class="account-identity">
                                <div class="account-avatar">@(account.EmployeeName.Length > 0 ? account.EmployeeName[..1].ToUpperInvariant() : "N")</div>
                                <div>
                                    <strong>@account.EmployeeName</strong>
                                    <span>@account.Email</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="account-username"><i class="bi bi-code-slash"></i>@account.Username</div>
                            @if (isCurrentAccount)
                            {
                                <span class="account-you-chip">Hiện tại</span>
                            }
                        </td>
                        <td>
                            <div class="account-work-unit"><strong>@account.Position</strong><span>@account.Department</span></div>
                        </td>
                        <td><span class="role-chip @roleClass"><i></i>@roleDisplayName</span></td>
                        <td>
                            <span class="state-chip @(account.IsActive ? "state-chip--active" : "state-chip--locked")" data-account-state>
                                <i></i>@(account.IsActive ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td>
                            <div class="account-row-actions">
                                <a asp-action="Edit" asp-route-id="@account.AccountId" title="Chỉnh sửa"><i class="bi bi-sliders"></i></a>
                                <form asp-action="ToggleStatus" asp-route-id="@account.AccountId" method="post"
                                      class="account-toggle-form"
                                      data-account-id="@account.AccountId"
                                      data-account-name="@account.EmployeeName"
                                      data-account-mode="@(account.IsActive ? "lock" : "unlock")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reason" value="" data-account-reason-value />
                                    <button type="submit" title="@(account.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")" disabled="@isCurrentAccount">
                                        <i class="bi @(account.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="account-pagination" aria-label="Phân trang danh sách tài khoản">
        <span class="account-pagination-summary">Hiển thị @firstAccount–@lastAccount / @Model.TotalFilteredAccounts tài khoản</span>
        <div class="account-pagination-actions">
            <button type="button" data-account-page="@(Model.PageNumber - 1)" disabled="@(Model.PageNumber == 1)" aria-label="Trang trước"><i class="bi bi-chevron-left"></i></button>
            @if (firstPage > 1)
            {
                <button type="button" data-account-page="1">1</button>
                @if (firstPage > 2)
                {
                    <span aria-hidden="true">…</span>
                }
            }
            @for (var pageIndex = firstPage; pageIndex <= lastPage; pageIndex++)
            {
                <button type="button" data-account-page="@pageIndex" class="@(pageIndex == Model.PageNumber ? "is-current" : null)" aria-current="@(pageIndex == Model.PageNumber ? "page" : null)">@pageIndex</button>
            }
            @if (lastPage < Model.TotalPages)
            {
                @if (lastPage < Model.TotalPages - 1)
                {
                    <span aria-hidden="true">…</span>
                }
                <button type="button" data-account-page="@Model.TotalPages">@Model.TotalPages</button>
            }
            <button type="button" data-account-page="@(Model.PageNumber + 1)" disabled="@(Model.PageNumber == Model.TotalPages)" aria-label="Trang sau"><i class="bi bi-chevron-right"></i></button>
        </div>
    </nav>
}
