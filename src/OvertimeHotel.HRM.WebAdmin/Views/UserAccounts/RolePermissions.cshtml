@model RolePermissionsViewModel
@{
    ViewData["Title"] = "Phân quyền vai trò RBAC";
}

<div class="account-workspace account-workspace--bleed">
    <!-- THANH THAO TÁC HỆ THỐNG -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold hover-lift d-flex align-items-center gap-1.5" style="font-size: 0.82rem;">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
        <div class="d-flex align-items-center gap-2 ms-auto">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold hover-lift" style="font-size: 0.82rem;">
                <i class="bi bi-people me-1"></i> Danh Sách Tài Khoản
            </a>
        </div>
    </div>

    <!-- THÔNG BÁO FLASH MESSAGE -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between p-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <span class="small fw-semibold text-dark">@successMessage</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-center justify-content-between p-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <span class="small fw-semibold text-dark">@errorMessage</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- FORM PHÂN QUYỀN VAI TRÒ -->
    <form asp-action="SaveRolePermissions" method="post" id="rolePermissionsForm">
        @Html.AntiForgeryToken()

        <!-- CARD CHỌN VAI TRÒ & PHẠM VI ÁP DỤNG -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="row align-items-center g-3">
                    <div class="col-lg-6 col-md-12">
                        <label class="form-label text-uppercase text-secondary fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="bi bi-person-badge-fill me-1 text-primary"></i> Vai trò cần phân quyền
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                                <i class="bi bi-award"></i>
                            </span>
                            <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select border-start-0 py-2 fw-bold text-dark rounded-end-3"
                                    onchange="this.form.method='get';this.form.action='@Url.Action("RolePermissions")';this.form.submit()">
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-12">
                        <div class="p-3 rounded-3 bg-primary bg-opacity-10 border border-primary-subtle d-flex align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <span class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                                    <i class="bi bi-people-fill"></i>
                                </span>
                                <div>
                                    <div class="small fw-bold text-dark">Phạm vi tác động: <b>@Model.RoleName</b></div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Có <b>@Model.AffectedAccountCount</b> tài khoản sẽ áp dụng cấu hình quyền mới</div>
                                </div>
                            </div>
                            <span class="badge bg-primary text-white rounded-pill px-3 py-1.5" style="font-size: 0.75rem;">
                                Đồng bộ tức thì
                            </span>
                        </div>
                    </div>
                </div>

                <div class="mt-3 pt-3 border-top d-flex align-items-center gap-2 text-muted" style="font-size: 0.78rem;">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <span><b>Lưu ý:</b> Quản trị viên (Admin) mặc định có toàn bộ quyền hệ thống nên không cấu hình quyền tại màn hình này.</span>
                </div>
            </div>
        </div>

        <!-- CARD LƯỚI QUYỀN HẠN CHI TIẾT -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle bg-warning bg-opacity-10 text-warning-emphasis d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-key-fill" style="color: #b45309;"></i>
                    </span>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark font-serif" style="font-size: 0.95rem;">Danh Mục Quyền Hạn Cho Phép</h6>
                        <small class="text-muted" style="font-size: 0.72rem;">Đánh dấu tích để cấp quyền hoặc bỏ tích để thu hồi quyền của vai trò</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold" id="selectAllPermissionsBtn" style="font-size: 0.75rem;">
                        <i class="bi bi-check-all me-1 text-primary"></i> Chọn tất cả
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold" id="deselectAllPermissionsBtn" style="font-size: 0.75rem;">
                        <i class="bi bi-dash-circle me-1 text-danger"></i> Bỏ chọn
                    </button>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-3">
                    @foreach (var permission in Model.PermissionOptions)
                    {
                        var isChecked = permission.Granted;
                        <div class="col-lg-6 col-md-12">
                            <label class="p-3 rounded-4 border w-100 h-100 d-flex align-items-start gap-3 transition-all cursor-pointer @(isChecked ? "bg-primary-subtle border-primary-subtle" : "bg-light bg-opacity-50 border-light-subtle")"
                                   style="transition: all 0.2s ease; cursor: pointer;"
                                   onmouseover="this.classList.add('shadow-sm')"
                                   onmouseout="this.classList.remove('shadow-sm')">
                                <div class="form-check form-switch pt-1 flex-shrink-0">
                                    <input class="form-check-input permission-checkbox" type="checkbox" name="PermissionIds" value="@permission.PermissionId" @(isChecked ? "checked" : "") style="width: 2.2rem; height: 1.2rem; cursor: pointer;">
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                        <div class="fw-bold text-dark" style="font-size: 0.88rem;">@permission.Name</div>
                                        <code class="text-primary bg-primary bg-opacity-10 px-2 py-0.5 rounded-2 font-monospace" style="font-size: 0.7rem;">@permission.Code</code>
                                    </div>
                                    <p class="mb-0 text-muted small" style="font-size: 0.78rem; line-height: 1.4;">
                                        @(string.IsNullOrWhiteSpace(permission.Description) ? "Cho phép thực thi tác vụ tương ứng trong phân hệ này." : permission.Description)
                                    </p>
                                </div>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CARD XÁC NHẬN & LÝ DO THAY ĐỔI QUYỀN -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-lg-8 col-md-12">
                        <label asp-for="ChangeReason" class="form-label text-uppercase text-secondary fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                            <i class="bi bi-pencil-square me-1 text-primary"></i> Lý do thay đổi quyền hạn <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="ChangeReason" rows="2" class="form-control rounded-3" required
                                  placeholder="Ví dụ: Bổ sung quyền duyệt nghỉ phép cho Quản lý ca trực theo quyết định số 12/QĐ-KS..."></textarea>
                        <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">
                            <i class="bi bi-shield-check text-success me-1"></i>Hệ thống tự động ghi nhật ký kiểm toán (Audit Trail) cho mọi lần điều chỉnh quyền.
                        </small>
                    </div>
                    <div class="col-lg-4 col-md-12 d-flex flex-column justify-content-end">
                        <div class="p-3 bg-light rounded-3 mb-2 small text-muted" style="font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-1 text-primary"></i>Nhân sự thuộc vai trò cần <b>đăng xuất và đăng nhập lại</b> để token quyền mới có hiệu lực.
                        </div>
                        <button type="submit" class="btn btn-hotel-primary rounded-3 py-2.5 fw-bold w-100 hover-lift shadow-sm">
                            <i class="bi bi-check2-circle me-1.5 fs-6"></i> Lưu Cấu Hình Quyền Vai Trò
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const selectAllBtn = document.getElementById("selectAllPermissionsBtn");
            const deselectAllBtn = document.getElementById("deselectAllPermissionsBtn");
            const checkboxes = document.querySelectorAll(".permission-checkbox");

            selectAllBtn?.addEventListener("click", () => {
                checkboxes.forEach(cb => {
                    cb.checked = true;
                    const card = cb.closest("label");
                    if (card) {
                        card.classList.add("bg-primary-subtle", "border-primary-subtle");
                        card.classList.remove("bg-light", "bg-opacity-50", "border-light-subtle");
                    }
                });
            });

            deselectAllBtn?.addEventListener("click", () => {
                checkboxes.forEach(cb => {
                    cb.checked = false;
                    const card = cb.closest("label");
                    if (card) {
                        card.classList.remove("bg-primary-subtle", "border-primary-subtle");
                        card.classList.add("bg-light", "bg-opacity-50", "border-light-subtle");
                    }
                });
            });

            checkboxes.forEach(cb => {
                cb.addEventListener("change", () => {
                    const card = cb.closest("label");
                    if (!card) return;
                    if (cb.checked) {
                        card.classList.add("bg-primary-subtle", "border-primary-subtle");
                        card.classList.remove("bg-light", "bg-opacity-50", "border-light-subtle");
                    } else {
                        card.classList.remove("bg-primary-subtle", "border-primary-subtle");
                        card.classList.add("bg-light", "bg-opacity-50", "border-light-subtle");
                    }
                });
            });
        });
    </script>
}
