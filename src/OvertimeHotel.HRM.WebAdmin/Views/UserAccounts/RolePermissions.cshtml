@model RolePermissionsViewModel
@{
    ViewData["Title"] = "Phân quyền vai trò RBAC";
}

<div class="account-workspace account-workspace--bleed">
    <!-- THANH THAO TÁC HỆ THỐNG -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold hover-lift d-flex align-items-center gap-1.5" style="font-size: 0.82rem;">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
        <div class="d-flex align-items-center gap-2 ms-auto">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold hover-lift" style="font-size: 0.82rem;">
                <i class="bi bi-people me-1"></i> Danh Sách Tài Khoản
            </a>
        </div>
    </div>

    <partial name="_RolePermissionsForm" model="Model" />
</div>

@section Scripts {
    <script src="~/js/role-permissions.js" asp-append-version="true"></script>
}
