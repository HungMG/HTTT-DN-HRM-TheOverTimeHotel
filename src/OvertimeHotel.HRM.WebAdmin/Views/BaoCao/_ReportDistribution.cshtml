@model IReadOnlyList<OvertimeHotel.HRM.WebAdmin.Models.PhanBoItem>
@if (Model.Count == 0)
{
    <p>Không phát sinh dữ liệu trong phạm vi đã chọn.</p>
}
else
{
    <table class="table table-bordered table-sm">
        <thead><tr><th>Nhóm</th><th>Số lượng</th><th>Tỷ lệ (%)</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr><td>@item.Nhan</td><td>@item.GiaTri</td><td>@item.TyLe.ToString("0.#")</td></tr>
            }
        </tbody>
    </table>
}
