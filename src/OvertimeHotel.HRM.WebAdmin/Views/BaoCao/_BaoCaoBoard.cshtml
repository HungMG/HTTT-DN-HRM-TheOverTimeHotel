@using OvertimeHotel.HRM.WebAdmin.Security
@model OvertimeHotel.HRM.WebAdmin.Models.BaoCaoViewModel
@{
    // Vùng dữ liệu được nạp lại tại chỗ khi đổi kỳ / phòng ban / tab. Toàn bộ dữ liệu
    // biểu đồ đi kèm trong một khối JSON bên dưới, nên sau khi hoán đổi HTML thì JS
    // không phải gọi thêm endpoint nào khác.
    var tab = Model.Tab;
    var isMonthly = Model.KyBaoCao == "THANG";
    const string Money = "N0";
}

<div class="in-place-container" data-baocao-board
     data-ky="@Model.KyBaoCao" data-nam="@Model.Nam" data-thang="@Model.Thang"
     data-quy="@Model.Quy" data-phong-ban="@Model.PhongBanId" data-tab="@Model.Tab">
    @* Payload cho ECharts. Controller serialize bằng encoder mặc định của System.Text.Json
       nên ký tự '<' đã thành < — tên phòng ban / tên sự kiện do người dùng nhập
       không thể đóng thẻ script này. *@
    <script type="application/json" data-baocao-chart-data>@Html.Raw(Model.ChartJson)</script>

    <div class="baocao-status @(Model.IsDatabaseOnline ? string.Empty : "is-offline")">
        <span class="baocao-status-chip"><i class="bi bi-calendar3"></i> @Model.NhanKy</span>
        <span class="baocao-status-chip"><i class="bi bi-diagram-3"></i> @Model.PhamViLabel</span>
        <span class="baocao-status-chip"><i class="bi bi-person-badge"></i> @Model.RoleLabel</span>
        @if (Model.IsDatabaseOnline)
        {
            <span class="baocao-status-note">
                Cập nhật lúc @Model.GeneratedAt.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm")
            </span>
        }
        else
        {
            <span class="baocao-status-note is-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> Chưa đọc được dữ liệu từ Supabase.
            </span>
        }
    </div>

    @* ══════════════════════ 10.1 — BIẾN ĐỘNG NHÂN SỰ ══════════════════════ *@
    <section class="baocao-panel" data-baocao-panel="bien-dong" hidden="@(tab != "bien-dong")">
        @if (Model.BienDong.SoHoSoThieuNgayThoiViec > 0)
        {
            <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3">
                <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>
                Hệ thống ghi nhận <strong>@Model.BienDong.SoHoSoThieuNgayThoiViec</strong> hồ sơ đã thôi việc nhưng chưa cập nhật ngày thôi việc chính thức. Quân số quá khứ được bảo toàn và không tự động trừ trước ngày vào làm.
            </div>
        }
        <div class="baocao-kpi-grid">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tuyển mới trong kỳ</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.BienDong.TuyenMoi">@Model.BienDong.TuyenMoi</span> <small>người</small></h3>
                    <p class="catalog-kpi-desc">
                        @if (!string.IsNullOrEmpty(Model.BienDong.KyTruocLabel))
                        {
                            <span>So với @Model.BienDong.KyTruocLabel: <strong class="@(Model.BienDong.TuyenMoiThayDoi >= 0 ? "baocao-up" : "baocao-down")">@(Model.BienDong.TuyenMoiThayDoi >= 0 ? "+" : "")@Model.BienDong.TuyenMoiThayDoi</strong> &bull; </span>
                        }
                    </p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--deduction shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-box-arrow-right"></i></div>
                <div>
                    <span class="catalog-kpi-label">Thôi việc trong kỳ</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.BienDong.NghiViec">@Model.BienDong.NghiViec</span> <small>người</small></h3>
                    <p class="catalog-kpi-desc">
                        @if (!string.IsNullOrEmpty(Model.BienDong.KyTruocLabel))
                        {
                            <span>So với @Model.BienDong.KyTruocLabel: <strong class="@(Model.BienDong.NghiViecThayDoi <= 0 ? "baocao-up" : "baocao-down")">@(Model.BienDong.NghiViecThayDoi >= 0 ? "+" : "")@Model.BienDong.NghiViecThayDoi</strong> &bull; </span>
                        }
                    </p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-people-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">@(isMonthly ? "Nhân sự cuối tháng" : "Nhân sự cuối kỳ")</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.BienDong.CuoiKy">@Model.BienDong.CuoiKy</span> <small>người</small></h3>
                    <p class="catalog-kpi-desc">Đầu kỳ @Model.BienDong.DauKy · biến động ròng @(Model.BienDong.BienDongRong >= 0 ? "+" : "")@Model.BienDong.BienDongRong</p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-graph-down-arrow"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tỷ lệ thôi việc</span>
                    <h3 class="catalog-kpi-value">@Model.BienDong.TyLeThoiViec.ToString("0.#") <small>%</small></h3>
                    <p class="catalog-kpi-desc">Thôi việc trên quân số bình quân</p>
                </div>
            </div>
        </div>

        <div class="baocao-grid-2">
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Diễn biến 12 tháng năm @Model.Nam</h2></div>
                <div class="baocao-chart" data-chart="bien-dong-series" style="height:320px"></div>
            </section>
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Quân số theo phòng ban</h2></div>
                <div class="baocao-chart" data-chart="bien-dong-phongban" style="height:320px"></div>
            </section>
        </div>

        <section class="catalog-card shadow-sm">
            <div class="catalog-toolbar"><h2 class="baocao-card-title">Chi tiết theo phòng ban</h2></div>
            @if (Model.BienDong.TheoPhongBan.Count == 0)
            {
                <div class="baocao-empty"><i class="bi bi-inbox"></i> Không có phòng ban nào phát sinh biến động trong kỳ này.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table baocao-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Phòng ban</th>
                                <th class="text-end">Quân số</th>
                                <th class="text-end">Tuyển mới</th>
                                <th class="text-end">Thôi việc</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BienDong.TheoPhongBan)
                            {
                                <tr>
                                    <td>@item.PhongBan</td>
                                    <td class="text-end">@item.QuanSo</td>
                                    <td class="text-end baocao-up">@(item.TuyenMoi > 0 ? "+" + item.TuyenMoi : "0")</td>
                                    <td class="text-end baocao-down">@(item.NghiViec > 0 ? "-" + item.NghiViec : "0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>

    @* ══════════════════════ 10.2 — CƠ CẤU NHÂN LỰC ══════════════════════ *@
    <section class="baocao-panel" data-baocao-panel="co-cau" hidden="@(tab != "co-cau")">
        <p class="text-muted small">Người có nghỉ phép trong kỳ có thể đồng thời thuộc nhóm đang làm việc hoặc nghỉ việc. Trạng thái và phòng ban trong quá khứ có thể không còn đầy đủ.</p>
        @if (Model.BienDong.SoHoSoThieuNgayThoiViec > 0)
        {
            <div class="alert alert-warning">Có @Model.BienDong.SoHoSoThieuNgayThoiViec hồ sơ thôi việc thiếu ngày; quân số có thể chưa chính xác.</div>
        }
        <div class="baocao-kpi-grid">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-people-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">@(isMonthly ? "Nhân sự cuối tháng" : "Nhân sự cuối kỳ")</span>
                    <h3 class="catalog-kpi-value"><button type="button" class="baocao-kpi-drill" data-baocao-drill="cuoi-ky" aria-label="Danh sách nhân sự cuối kỳ"><span data-count-to="@Model.BienDong.CuoiKy">@Model.BienDong.CuoiKy</span> <small>người</small> <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button></h3>
                    <p class="catalog-kpi-desc">Gồm người đang nghỉ phép</p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-person-check-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Đang làm việc</span>
                    <h3 class="catalog-kpi-value"><button type="button" class="baocao-kpi-drill" data-baocao-drill="dang-lam" aria-label="Danh sách nhân sự đang làm việc"><span data-count-to="@Model.CoCau.DangLam">@Model.CoCau.DangLam</span> <small>người</small> <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button></h3>
                    <p class="catalog-kpi-desc">
                        <span>Trạng thái hồ sơ cuối kỳ</span>
                    </p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-airplane"></i></div>
                <div>
                    <span class="catalog-kpi-label">@(isMonthly ? "Có nghỉ phép trong tháng" : "Có nghỉ phép trong kỳ")</span>
                    <h3 class="catalog-kpi-value"><button type="button" class="baocao-kpi-drill" data-baocao-drill="nghi-phep-trong-ky" aria-label="Danh sách nhân viên nghỉ phép trong kỳ"><span data-count-to="@Model.CoCau.CoNghiPhepTrongKy">@Model.CoCau.CoNghiPhepTrongKy</span> <small>người</small> <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button></h3>
                    <p class="catalog-kpi-desc">
                        <span>Đơn đã duyệt</span>
                    </p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--deduction shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-person-dash"></i></div>
                <div>
                    <span class="catalog-kpi-label">@(isMonthly ? "Nghỉ việc trong tháng" : "Nghỉ việc trong kỳ")</span>
                    <h3 class="catalog-kpi-value"><button type="button" class="baocao-kpi-drill" data-baocao-drill="thoi-viec" aria-label="Danh sách nhân viên nghỉ việc trong kỳ"><span data-count-to="@Model.BienDong.NghiViec">@Model.BienDong.NghiViec</span> <small>người</small> <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button></h3>
                    <p class="catalog-kpi-desc">
                        <span>Theo ngày nghỉ việc</span>
                    </p>
                </div>
            </div>
        </div>

        @* Tỉ lệ cột 1.35 : 1.35 : 1 — hai biểu đồ đầu nhiều lát và tên tiếng Việt dài
           (9 phòng ban, 8 chức vụ) nên cần bề ngang rộng hơn hẳn ô giới tính chỉ có
           2 lát. Chia đều ba cột như trước thì chú giải phải cắt cụt chữ. *@
        <div class="baocao-grid-cocau">
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Theo phòng ban</h2></div>
                <div class="baocao-chart" data-chart="co-cau-phongban" style="height:320px"></div>
            </section>
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Theo chức vụ</h2></div>
                <div class="baocao-chart" data-chart="co-cau-chucvu" style="height:320px"></div>
            </section>
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Theo giới tính</h2></div>
                <div class="baocao-chart" data-chart="co-cau-gioitinh" style="height:320px"></div>
            </section>
        </div>

        <section class="catalog-card shadow-sm">
            <div class="catalog-toolbar"><h2 class="baocao-card-title">Cơ cấu theo trạng thái làm việc</h2></div>
            @if (Model.CoCau.TheoTrangThai.Count == 0)
            {
                <div class="baocao-empty"><i class="bi bi-inbox"></i> Chưa có dữ liệu nhân sự trong phạm vi này.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table baocao-table align-middle mb-0">
                        <thead>
                            <tr><th>Trạng thái</th><th class="text-end">Số người</th><th class="text-end">Tỷ lệ</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CoCau.TheoTrangThai)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Nhan</td>
                                    <td class="text-end">@item.GiaTri</td>
                                    <td class="text-end">@item.TyLe.ToString("0.#")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>

    @* ══════════════════════ 10.3 — HỌC VẤN, THÂM NIÊN & MỨC LƯƠNG ══════════════════════ *@
    <section class="baocao-panel" data-baocao-panel="hoc-van" hidden="@(tab != "hoc-van")">
        <div class="alert alert-light border mb-3">
            Thống kê nhân viên còn làm việc tại ngày @Model.DenNgay.ToString("dd/MM/yyyy").
            Phòng ban, chức vụ và trình độ dựa trên hồ sơ hiện tại; dữ liệu quá khứ có thể không đầy đủ.
        </div>
        <div class="baocao-kpi-grid">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-mortarboard-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Từ đại học trở lên</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.HocVanThamNien.SoDaiHocTroLen">@Model.HocVanThamNien.SoDaiHocTroLen</span> <small>người</small></h3>
                    <p class="catalog-kpi-desc">Gồm bậc Đại học và Sau Đại học (chuẩn PRD 10.3)</p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-percent"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tỷ lệ đại học trở lên</span>
                    <h3 class="catalog-kpi-value">@Model.HocVanThamNien.TyLeDaiHocTroLen.ToString("0.#") <small>%</small></h3>
                    <p class="catalog-kpi-desc">Chỉ số chất lượng nhân sự</p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <span class="catalog-kpi-label">Thâm niên trung bình</span>
                    <h3 class="catalog-kpi-value">@Model.HocVanThamNien.ThamNienTrungBinh.ToString("0.#") <small>năm</small></h3>
                    <p class="catalog-kpi-desc">Tính tại mốc @Model.DenNgay.ToString("dd/MM/yyyy")</p>
                </div>
            </div>
            @if (Model.HocVanThamNien.CanViewSalaryInfo)
            {
                <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                    <div class="catalog-kpi-icon"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <span class="catalog-kpi-label">Lương cơ bản TB</span>
                        <h3 class="catalog-kpi-value">@(Model.HocVanThamNien.SoNhanSuCoLuong > 0 ? Model.HocVanThamNien.LuongCoBanTrungBinh.ToString("N0") + " đ" : "Chưa có dữ liệu")</h3>
                        <p class="catalog-kpi-desc">
                            <span>Có lương: @Model.HocVanThamNien.SoNhanSuCoLuong người; chưa có: @Model.HocVanThamNien.SoNhanSuThieuLuong người</span>
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="baocao-grid-2">
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Phân bổ trình độ đào tạo</h2></div>
                <div class="baocao-chart" data-chart="hoc-van-trinhdo" style="height:340px"></div>
            </section>
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Phân bổ thâm niên</h2></div>
                <div class="baocao-chart" data-chart="hoc-van-thamnien" style="height:340px"></div>
            </section>
        </div>

        @if (Model.HocVanThamNien.CanViewSalaryInfo && Model.HocVanThamNien.TheoMucLuong.Count > 0)
        {
            <div class="baocao-grid-2 mt-3">
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar"><h2 class="baocao-card-title">Phân bổ theo dải mức lương cơ bản</h2></div>
                    <div class="baocao-chart" data-chart="hoc-van-mucluong" style="height:340px"></div>
                </section>
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar d-flex justify-content-between align-items-center">
                        <h2 class="baocao-card-title">Chi tiết dải mức lương</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table baocao-table align-middle mb-0">
                            <thead>
                                <tr><th>Dải mức lương</th><th class="text-end">Số người</th><th class="text-end">Tỷ lệ</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.HocVanThamNien.TheoMucLuong)
                                {
                                    <tr>
                                        <td>@item.Nhan</td>
                                        <td class="text-end fw-semibold">@item.GiaTri</td>
                                        <td class="text-end">@item.TyLe.ToString("0.#")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        }

        <section class="catalog-card shadow-sm">
            <div class="catalog-toolbar"><h2 class="baocao-card-title">Chi tiết trình độ</h2></div>
            @if (Model.HocVanThamNien.TheoTrinhDo.Count == 0)
            {
                <div class="baocao-empty"><i class="bi bi-inbox"></i> Chưa có dữ liệu trình độ đào tạo.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table baocao-table align-middle mb-0">
                        <thead>
                            <tr><th>Trình độ</th><th class="text-end">Số người</th><th class="text-end">Tỷ lệ</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HocVanThamNien.TheoTrinhDo)
                            {
                                <tr>
                                    <td>@item.Nhan</td>
                                    <td class="text-end">@item.GiaTri</td>
                                    <td class="text-end">@item.TyLe.ToString("0.#")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="catalog-card shadow-sm mt-3">
            <div class="catalog-toolbar"><h2 class="baocao-card-title">Chi tiết thâm niên</h2></div>
            <div class="table-responsive"><table class="table baocao-table align-middle mb-0">
                <thead><tr><th>Thâm niên</th><th class="text-end">Số người</th><th class="text-end">Tỷ lệ</th></tr></thead>
                <tbody>@foreach (var item in Model.HocVanThamNien.TheoThamNien)
                {
                    <tr><td>@item.Nhan</td><td class="text-end">@item.GiaTri</td><td class="text-end">@item.TyLe.ToString("0.#")%</td></tr>
                }</tbody>
            </table></div>
        </section>

    </section>

    @* ══════════════════════ 10.4 — ĐỐI SOÁT QUỸ LƯƠNG ══════════════════════
       Báo cáo chỉ xem thông tin đối soát quỹ lương và ngân sách. *@
    @if (Model.CanViewPayrollFund)
    {
        <section class="baocao-panel" data-baocao-panel="quy-luong" hidden="@(tab != "quy-luong")">
            <div class="baocao-kpi-grid">
                <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                    <div class="catalog-kpi-icon"><i class="bi bi-wallet2"></i></div>
                    <div>
                        <span class="catalog-kpi-label">Tổng lương đã tính</span>
                        <h3 class="catalog-kpi-value">@Model.QuyLuong.ThucChiGross.ToString(Money) <small>đ</small></h3>
                        <p class="catalog-kpi-desc">Lương công + tăng ca + phụ cấp + thưởng</p>
                    </div>
                </div>
                <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                    <div class="catalog-kpi-icon"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <span class="catalog-kpi-label">Thực nhận đã tính</span>
                        <h3 class="catalog-kpi-value">@Model.QuyLuong.ThucChi.ToString(Money) <small>đ</small></h3>
                        <p class="catalog-kpi-desc">
                            Sau khấu trừ, gồm cả phiếu nháp · @Model.QuyLuong.SoPhieuLuong phiếu &bull;
                            <a href="javascript:void(0)" class="text-decoration-none fw-semibold" data-baocao-drill="phieu-luong"><i class="bi bi-zoom-in"></i> Chi tiết</a>
                        </p>
                    </div>
                </div>
                <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                    <div class="catalog-kpi-icon"><i class="bi bi-bullseye"></i></div>
                    <div>
                        <span class="catalog-kpi-label">@Model.QuyLuong.NhanDinhMucThamChieu</span>
                        <h3 class="catalog-kpi-value">@Model.QuyLuong.NganSachThamChieu.ToString(Money) <small>đ</small></h3>
                        <p class="catalog-kpi-desc">@Model.QuyLuong.SoHopDong hợp đồng hiệu lực trong @Model.QuyLuong.SoThangTrongKy tháng</p>
                    </div>
                </div>
                <div class="catalog-kpi-card @(Model.QuyLuong.VuotNguong ? "catalog-kpi-card--deduction" : "catalog-kpi-card--bonus") shadow-sm">
                    <div class="catalog-kpi-icon"><i class="bi bi-speedometer2"></i></div>
                    <div>
                        <span class="catalog-kpi-label">Tỷ lệ so với định mức</span>
                        <h3 class="catalog-kpi-value">@Model.QuyLuong.PhanTramGiaiNgan.ToString("0.#") <small>%</small></h3>
                        <p class="catalog-kpi-desc">
                            Chênh lệch @Model.QuyLuong.ChenhLech.ToString(Money) đ
                            @if (Model.QuyLuong.VuotNguong)
                            {
                                <text> · </text><strong class="baocao-danger">Vượt định mức</strong>
                            }
                        </p>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2">
                    <i class="bi bi-check-circle me-1"></i>@Model.QuyLuong.SoPhieuDaDuyet phiếu đã duyệt (@Model.QuyLuong.ThucChiGrossDaDuyet.ToString(Money) đ)
                </span>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle py-1 px-2">
                    <i class="bi bi-pencil-square me-1"></i>@Model.QuyLuong.SoPhieuNhap phiếu nháp/dự tính (@Model.QuyLuong.ThucChiGrossNhap.ToString(Money) đ)
                </span>
                @if (!string.IsNullOrEmpty(Model.QuyLuong.KyTruocLabel))
                {
                    <span class="badge bg-light text-dark border py-1 px-2">
                        Kỳ trước (@Model.QuyLuong.KyTruocLabel): @Model.QuyLuong.ThucChiGrossKyTruoc.ToString(Money) đ
                        (@(Model.QuyLuong.ThucChiGrossThayDoi >= 0 ? "+" : "")@Model.QuyLuong.ThucChiGrossThayDoi.ToString(Money) đ)
                    </span>
                }
            </div>

            <p class="small text-muted">Phiếu đánh dấu đã thanh toán: @Model.QuyLuong.SoPhieuDanhDauDaThanhToan phiếu, thực nhận @Model.QuyLuong.LuongDanhDauDaThanhToan.ToString(Money) đ. Trạng thái này cần đối chiếu chứng từ chuyển tiền thực tế.</p>
            @if (!string.IsNullOrEmpty(Model.QuyLuong.GhiChuPhuongPhap))
            {
                <div class="baocao-note @(Model.QuyLuong.SoNhanSuThieuCanCuLuong > 0 ? "alert alert-warning" : "")">
                    <i class="bi bi-info-circle-fill"></i> @Model.QuyLuong.GhiChuPhuongPhap
                </div>
            }

            <div class="baocao-grid-2">
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar"><h2 class="baocao-card-title">Định mức và lương đã tính theo tháng</h2></div>
                    <div class="baocao-chart" data-chart="quy-luong-series" style="height:340px"></div>
                </section>
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar"><h2 class="baocao-card-title">Chi phí lương theo phòng ban</h2></div>
                    <div class="baocao-chart" data-chart="quy-luong-phongban" style="height:340px"></div>
                </section>
            </div>

            @* ══════════ TÍNH NĂNG 1: PHÂN RÃ CƠ CẤU QUỸ LƯƠNG THEO TỪNG THÀNH PHẦN ══════════ *@
            <div class="baocao-grid-2">
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar">
                        <h2 class="baocao-card-title"><i class="bi bi-pie-chart me-1"></i> Cơ cấu thành phần quỹ lương</h2>
                    </div>
                    <div class="baocao-chart" data-chart="quy-luong-cocau" style="height:340px"></div>
                </section>
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar">
                        <h2 class="baocao-card-title"><i class="bi bi-list-columns-reverse me-1"></i> Bóc tách chi phí lương (Gross)</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table baocao-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Khoản mục chi</th>
                                    <th class="text-end">Số tiền</th>
                                    <th class="text-end">Tỷ trọng</th>
                                    <th>Ý nghĩa & Ghi chú</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.QuyLuong.CoCauThanhPhan.DanhSach)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <span class="d-inline-block rounded-circle me-1" style="width:10px;height:10px;background-color:@item.MauSac"></span>
                                            @item.TenThanhPhan
                                        </td>
                                        <td class="text-end fw-bold">@item.SoTien.ToString(Money) đ</td>
                                        <td class="text-end">
                                            <span class="badge bg-light text-dark border">@item.TyTrong.ToString("0.0") %</span>
                                        </td>
                                        <td class="small text-muted">@item.MoTa</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td>Tổng chi phí gộp (Gross)</td>
                                    <td class="text-end text-primary">@Model.QuyLuong.CoCauThanhPhan.TongGross.ToString(Money) đ</td>
                                    <td class="text-end"><span class="badge bg-primary text-white">100.0 %</span></td>
                                    <td class="small text-muted">Lương công + tăng ca + phụ cấp + thưởng</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>
            </div>

            @* ══════════ TÍNH NĂNG 2: TỰ ĐỘNG PHÂN TÍCH NGUYÊN NHÂN CHÊNH LỆCH ══════════ *@
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar d-flex justify-content-between align-items-center">
                    <h2 class="baocao-card-title mb-0">
                        <i class="bi bi-cpu me-1 text-primary"></i> Tự động phân tích nguyên nhân chênh lệch (Root Cause Analysis)
                    </h2>
                    <span class="badge @(Model.QuyLuong.PhanTichChenhLech.CoVuotDinhMuc ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle") px-3 py-1">
                        <i class="bi @(Model.QuyLuong.PhanTichChenhLech.CoVuotDinhMuc ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") me-1"></i>
                        @(Model.QuyLuong.PhanTichChenhLech.CoVuotDinhMuc ? "Vượt định mức" : "Trong tầm kiểm soát")
                    </span>
                </div>

                <div class="p-3">
                    @* Khối nhận định tự động & Biểu đồ đóng góp yếu tố *@
                    <div class="row g-3 mb-4">
                        <div class="col-lg-6">
                            <div class="card border-0 bg-light-subtle shadow-sm h-100">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-lightbulb-fill text-warning me-1"></i> Nhận định & Nguyên nhân cốt lõi</h6>
                                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                        @foreach (var kl in Model.QuyLuong.PhanTichChenhLech.KetLuanTuDong)
                                        {
                                            <li class="small d-flex align-items-start gap-2">
                                                <span>@Html.Raw(kl)</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card border-0 bg-light-subtle shadow-sm h-100">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-bar-chart-steps text-info me-1"></i> Đóng góp vào chênh lệch ngân sách (+/-)</h6>
                                    <div class="baocao-chart" data-chart="quy-luong-biendong" style="height:210px"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Bảng chi tiết 4 yếu tố tác động *@
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-layers me-1"></i> Bóc tách 4 yếu tố tác động chênh lệch:</h6>
                    <div class="table-responsive mb-4">
                        <table class="table baocao-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Yếu tố tác động</th>
                                    <th class="text-end">Số tiền thực tế</th>
                                    <th class="text-end">Mức chênh lệch</th>
                                    <th class="text-end">Tỷ lệ đóng góp</th>
                                    <th class="text-center">Chiều hướng</th>
                                    <th class="text-center">Mức tác động</th>
                                    <th>Phân tích chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.QuyLuong.PhanTichChenhLech.YeuToBienDong)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.TenYeuTo</td>
                                        <td class="text-end">@item.SoTien.ToString(Money) đ</td>
                                        <td class="text-end fw-bold @(item.ChenhLech > 0 ? "baocao-danger" : item.ChenhLech < 0 ? "baocao-up" : "")">
                                            @(item.ChenhLech > 0 ? "+" : "")@item.ChenhLech.ToString(Money) đ
                                        </td>
                                        <td class="text-end">@item.TyLeDongGop.ToString("0.0") %</td>
                                        <td class="text-center">
                                            @if (item.ChieuHuong == "TANG")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-arrow-up-right me-1"></i>Tăng chi phí</span>
                                            }
                                            else if (item.ChieuHuong == "GIAM")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-arrow-down-right me-1"></i>Tiết kiệm</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cân bằng</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (item.MucDoTacDong == "CAO")
                                            {
                                                <span class="badge bg-danger text-white">Cao</span>
                                            }
                                            else if (item.MucDoTacDong == "TRUNG_BINH")
                                            {
                                                <span class="badge bg-warning text-dark">Trung bình</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Thấp</span>
                                            }
                                        </td>
                                        <td class="small text-muted">@item.GiaiThich</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @* Bảng phân tích biến động theo phòng ban *@
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-building me-1"></i> Xếp hạng tác nhân biến động theo từng bộ phận:</h6>
                    <div class="table-responsive">
                        <table class="table baocao-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Phòng ban</th>
                                    <th class="text-end">Định mức</th>
                                    <th class="text-end">Thực chi</th>
                                    <th class="text-end">Chênh lệch</th>
                                    <th class="text-end">% Vượt/Hụt</th>
                                    <th>Nguyên nhân cốt lõi tại bộ phận</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pb in Model.QuyLuong.PhanTichChenhLech.PhongBanBienDong)
                                {
                                    <tr>
                                        <td class="fw-semibold">@pb.TenPhongBan</td>
                                        <td class="text-end">@pb.NganSach.ToString(Money) đ</td>
                                        <td class="text-end">@pb.ThucChi.ToString(Money) đ</td>
                                        <td class="text-end fw-bold @(pb.ChenhLech > 0 ? "baocao-danger" : pb.ChenhLech < 0 ? "baocao-up" : "")">
                                            @(pb.ChenhLech > 0 ? "+" : "")@pb.ChenhLech.ToString(Money) đ
                                        </td>
                                        <td class="text-end">
                                            <span class="badge @(pb.PhanTramVuot > 0 ? "bg-danger-subtle text-danger border border-danger-subtle" : pb.PhanTramVuot < 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-light text-muted border")">
                                                @(pb.PhanTramVuot > 0 ? "+" : "")@pb.PhanTramVuot.ToString("0.0") %
                                            </span>
                                        </td>
                                        <td class="small">
                                            <i class="bi bi-info-circle text-primary me-1"></i>@pb.NguyenNhanChinh
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Đối soát theo phòng ban</h2></div>
                @if (Model.QuyLuong.TheoPhongBan.Count == 0)
                {
                    <div class="baocao-empty"><i class="bi bi-inbox"></i> Chưa có phiếu lương nào trong kỳ này.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table baocao-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Phòng ban</th>
                                    <th class="text-end">Định mức</th>
                                    <th class="text-end">Lương đã tính (gộp)</th>
                                    <th class="text-end">Chênh lệch</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.QuyLuong.TheoPhongBan)
                                {
                                    <tr>
                                        <td>@item.PhongBan</td>
                                        <td class="text-end">@item.NganSach.ToString(Money)</td>
                                        <td class="text-end">@item.ThucChi.ToString(Money)</td>
                                        <td class="text-end @(item.ChenhLech > 0 ? "baocao-danger" : "baocao-up")">@item.ChenhLech.ToString(Money)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </section>
    }

    @* ══════════════════════ 10.5 — CHUYÊN CẦN & VI PHẠM ══════════════════════ *@
    <section class="baocao-panel" data-baocao-panel="chuyen-can" hidden="@(tab != "chuyen-can")">
        <p class="baocao-note">Chỉ xét ca đã công bố và kết thúc. Nghỉ được duyệt: @Model.ChuyenCan.SoCaNghiDuocDuyet ca;
            thiếu quẹt cần đối soát: @Model.ChuyenCan.SoCaThieuQuet ca. Hai nhóm này không tính vào mẫu số chuyên cần.</p>
        <div class="baocao-kpi-grid">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-fingerprint"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tỷ lệ chuyên cần</span>
                    <h3 class="catalog-kpi-value">@Model.ChuyenCan.TyLeChuyenCan.ToString("0.#") <small>%</small></h3>
                    <p class="catalog-kpi-desc">Đúng giờ trên tổng lượt chấm công</p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-check2-circle"></i></div>
                <div>
                    <span class="catalog-kpi-label">Lượt đúng giờ</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.ChuyenCan.DungGio">@Model.ChuyenCan.DungGio</span> <small>lượt</small></h3>
                    <p class="catalog-kpi-desc">Trên tổng @Model.ChuyenCan.TongBanGhi lượt trong kỳ</p>
                </div>
            </div>
            @{ var viPham = Model.ChuyenCan.DiTre + Model.ChuyenCan.VeSom + Model.ChuyenCan.TreVaSom; }
            <div class="catalog-kpi-card catalog-kpi-card--deduction shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <span class="catalog-kpi-label">Lượt vi phạm</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@viPham">@viPham</span> <small>lượt</small></h3>
                    <p class="catalog-kpi-desc">
                        Trễ @Model.ChuyenCan.DiTre · sớm @Model.ChuyenCan.VeSom &bull;
                        <a href="javascript:void(0)" class="text-decoration-none fw-semibold" data-baocao-drill="vi-pham"><i class="bi bi-zoom-in"></i> Chi tiết</a>
                    </p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-clock-history"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tổng giờ tăng ca</span>
                    <h3 class="catalog-kpi-value">@Model.ChuyenCan.TongGioOt.ToString("0.#") <small>giờ</small></h3>
                    <p class="catalog-kpi-desc">Trễ @Model.ChuyenCan.TongPhutTre phút · sớm @Model.ChuyenCan.TongPhutVeSom phút</p>
                </div>
            </div>
        </div>

        <div class="baocao-grid-2">
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Chuyên cần và vi phạm theo tháng</h2></div>
                @if (Model.ChuyenCan.Series.Count == 0)
                {
                    <div class="baocao-empty"><i class="bi bi-inbox"></i> Kỳ này chưa có lượt chấm công nào.</div>
                }
                else
                {
                    <div class="baocao-chart" data-chart="chuyen-can-series" style="height:320px"></div>
                }
            </section>
            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Tỷ lệ chuyên cần theo phòng ban</h2></div>
                @if (Model.ChuyenCan.TheoPhongBan.Count == 0)
                {
                    <div class="baocao-empty"><i class="bi bi-inbox"></i> Chưa có dữ liệu chấm công theo phòng ban.</div>
                }
                else
                {
                    <div class="baocao-chart" data-chart="chuyen-can-phongban" style="height:320px"></div>
                }
            </section>
        </div>

        <section class="catalog-card shadow-sm">
            <div class="catalog-toolbar"><h2 class="baocao-card-title">Xếp hạng vi phạm kỷ luật (top 10)</h2></div>
            @if (Model.ChuyenCan.XepHangViPham.Count == 0)
            {
                <div class="baocao-empty"><i class="bi bi-emoji-smile"></i> Không có lượt vi phạm nào trong kỳ.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table baocao-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nhân viên</th>
                                <th>Phòng ban</th>
                                <th class="text-end">Số lần</th>
                                <th class="text-end">Phút trễ</th>
                                <th class="text-end">Phút sớm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var rank = 1; }
                            @foreach (var item in Model.ChuyenCan.XepHangViPham)
                            {
                                <tr>
                                    <td class="baocao-rank">@rank</td>
                                    <td>@item.HoTen</td>
                                    <td>@item.PhongBan</td>
                                    <td class="text-end"><span class="baocao-pill baocao-pill--danger">@item.SoLanViPham</span></td>
                                    <td class="text-end">@item.TongPhutTre</td>
                                    <td class="text-end">@item.TongPhutVeSom</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>

    @* ══════════════════════ 10.6 — HIỆU QUẢ NHÂN SỰ SỰ KIỆN ══════════════════════ *@
    <section class="baocao-panel" data-baocao-panel="su-kien" hidden="@(tab != "su-kien")">
        @if (!string.IsNullOrEmpty(Model.SuKien.GhiChuPhamVi))
        {
            <div class="alert alert-info py-2 px-3 small rounded-3 mb-3">
                <i class="bi bi-info-circle-fill me-1 text-info"></i>
                @Model.SuKien.GhiChuPhamVi
            </div>
        }
        <div class="baocao-kpi-grid">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-calendar-event"></i></div>
                <div>
                    <span class="catalog-kpi-label">Sự kiện trong kỳ</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.SuKien.TongSuKien">@Model.SuKien.TongSuKien</span> <small>sự kiện</small></h3>
                    <p class="catalog-kpi-desc">Đang diễn ra @Model.SuKien.DangDienRa · hoàn thành @Model.SuKien.DaHoanThanh · hủy @Model.SuKien.DaHuy</p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-person-workspace"></i></div>
                <div>
                    <span class="catalog-kpi-label">Lượt điều động nhân sự</span>
                    <h3 class="catalog-kpi-value"><span data-count-to="@Model.SuKien.TongLuotPhanCong">@Model.SuKien.TongLuotPhanCong</span> <small>lượt</small></h3>
                    <p class="catalog-kpi-desc">
                        Tổng số phân công &bull;
                        <a href="javascript:void(0)" class="text-decoration-none fw-semibold" data-baocao-drill="su-kien"><i class="bi bi-zoom-in"></i> Chi tiết</a>
                    </p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-cash-coin"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tiền sự kiện phát sinh trong kỳ</span>
                    <h3 class="catalog-kpi-value">@Model.SuKien.TongPhuCapDaPhanBo.ToString(Money) <small>đ</small></h3>
                    <p class="catalog-kpi-desc">Trên ngân sách dự kiến @Model.SuKien.TongNganSach.ToString(Money) đ</p>
                </div>
            </div>
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-star-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tỷ lệ xuất sắc</span>
                    <h3 class="catalog-kpi-value">@Model.SuKien.TyLeXuatSac.ToString("0.#") <small>%</small></h3>
                    <p class="catalog-kpi-desc">Đạt hoàn thành trở lên: @Model.SuKien.TyLeHoanThanh.ToString("0.#")%</p>
                </div>
            </div>
        </div>

        @if (Model.SuKien.TongSuKien == 0)
        {
            <section class="catalog-card shadow-sm">
                <div class="baocao-empty">
                    <i class="bi bi-calendar-x"></i>
                    Kỳ @Model.NhanKy chưa có sự kiện nào được lên kế hoạch.
                    Hãy chọn kỳ khác, hoặc tạo sự kiện tại mục <strong>Sự kiện khách sạn</strong>.
                </div>
            </section>
        }
        else
        {
            <div class="baocao-grid-2">
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar"><h2 class="baocao-card-title">Cơ cấu theo loại sự kiện</h2></div>
                    <div class="baocao-chart" data-chart="su-kien-loai" style="height:320px"></div>
                </section>
                <section class="catalog-card shadow-sm">
                    <div class="catalog-toolbar"><h2 class="baocao-card-title">Đánh giá nhân sự tham gia</h2></div>
                    <div class="baocao-chart" data-chart="su-kien-danhgia" style="height:320px"></div>
                </section>
            </div>

            <section class="catalog-card shadow-sm">
                <div class="catalog-toolbar"><h2 class="baocao-card-title">Danh sách sự kiện</h2></div>
                <div class="table-responsive">
                    <table class="table baocao-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Sự kiện</th>
                                <th>Loại</th>
                                <th>Trạng thái</th>
                                <th>Thời gian</th>
                                <th class="text-end">Nhân sự</th>
                                <th class="text-end">Ngân sách</th>
                                <th class="text-end">Đã phân bổ</th>
                                <th class="text-end">Sử dụng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SuKien.DanhSach)
                            {
                                <tr>
                                    <td class="baocao-strong">@item.TenDuAn</td>
                                    <td>@item.LoaiLabel</td>
                                    <td><span class="baocao-pill">@item.TrangThaiLabel</span></td>
                                    <td>@item.TuNgay.ToString("dd/MM") → @item.DenNgay.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@item.SoNhanSu</td>
                                    <td class="text-end">@item.NganSach.ToString(Money)</td>
                                    <td class="text-end">@item.PhuCapDaPhanBo.ToString(Money)</td>
                                    <td class="text-end">@item.TyLeSuDungNganSach.ToString("0.#")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </section>

    @if (Model.IsDatabaseOnline) { <partial name="_ReportComparisons" model="Model" /> }
</div>
