@model OvertimeHotel.HRM.WebAdmin.Models.BaoCaoChiTietViewModel
@{
    var hasMoney = Model.DanhSach.Any(x => x.SoTien.HasValue);
    var hasQuantity = Model.DanhSach.Any(x => x.SoLuong.HasValue);
    var canSwitch = Model.LoaiChiTiet is "thong-tin-nhan-su" or "thong-tin-tat-ca";
}
<div class="modal-header baocao-detail-header">
    <div class="baocao-detail-heading">
        <span class="baocao-detail-heading-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
        <div>
            <div class="baocao-detail-eyebrow">BÁO CÁO NHÂN SỰ</div>
            <h2 class="modal-title baocao-detail-title" id="baocaoDetailsTitle">@Model.TieuDe</h2>
            <div class="baocao-detail-meta">
                <span><i class="bi bi-calendar3" aria-hidden="true"></i> @Model.NhanKy</span>
                <span><i class="bi bi-building" aria-hidden="true"></i> @Model.PhamViLabel</span>
            </div>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>
<div class="modal-body baocao-detail-body">
    <div class="baocao-detail-toolbar">
        <div>
            <h3>Danh sách chi tiết</h3>
            <p><strong data-baocao-detail-visible>@Model.TongSoDong</strong> / @Model.TongSoDong bản ghi
                @if (Model.TongTien.HasValue && Model.TongTien.Value > 0)
                { <span> · Tổng tiền: @Model.TongTien.Value.ToString("N0") đ</span> }
            </p>
        </div>
        @if (Model.DanhSach.Count > 0)
        {
            <label class="baocao-detail-search" for="baocaoDetailsSearch">
                <i class="bi bi-search" aria-hidden="true"></i>
                <span class="visually-hidden">Tìm trong danh sách</span>
                <input id="baocaoDetailsSearch" type="search" placeholder="Tìm trong danh sách..." autocomplete="off" data-baocao-details-search />
            </label>
        }
    </div>
    @if (canSwitch)
    {
        <button type="button" class="baocao-detail-switch" data-baocao-details-switch="@(Model.LoaiChiTiet == "thong-tin-nhan-su" ? "thong-tin-tat-ca" : "thong-tin-nhan-su")">
            <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
            @(Model.LoaiChiTiet == "thong-tin-nhan-su" ? "Bao gồm người đã nghỉ việc" : "Chỉ nhân sự còn làm việc")
        </button>
    }
    @if (Model.DanhSach.Count == 0)
    {
        <div class="baocao-detail-empty"><i class="bi bi-inbox" aria-hidden="true"></i><strong>Chưa có dữ liệu</strong><span>Không tìm thấy bản ghi trong kỳ và phạm vi đã chọn.</span></div>
    }
    else
    {
        <div class="baocao-detail-table-wrap" tabindex="0" aria-label="Danh sách chi tiết, có thể cuộn ngang">
            <table class="baocao-detail-table">
                <thead><tr>
                    <th scope="col">Mã</th><th scope="col">Họ tên / Đối tượng</th><th scope="col">Phòng ban</th><th scope="col">Chức vụ / Loại</th><th scope="col">Ngày</th>
                    @if (hasMoney) { <th scope="col" class="text-end">Số tiền</th> }
                    @if (hasQuantity) { <th scope="col" class="text-end">Số lượng</th> }
                    <th scope="col">Trạng thái</th><th scope="col">Ghi chú</th>
                </tr></thead>
                <tbody>
                    @foreach (var item in Model.DanhSach)
                    {
                        <tr>
                            <td><span class="baocao-detail-code">@item.MaDinhDanh</span></td>
                            <td class="baocao-detail-name">@item.TenDoiTuong</td>
                            <td>@item.BoPhan</td><td>@item.ChucVuHoacLoai</td>
                            <td class="text-nowrap">@(item.NgayThang.HasValue ? item.NgayThang.Value.ToString("dd/MM/yyyy") : "—")</td>
                            @if (hasMoney) { <td class="text-end text-nowrap">@(item.SoTien.HasValue ? item.SoTien.Value.ToString("N0") + " đ" : "—")</td> }
                            @if (hasQuantity) { <td class="text-end">@(item.SoLuong.HasValue ? item.SoLuong.Value.ToString() : "—")</td> }
                            <td><span class="baocao-detail-status">@item.TrangThai</span></td>
                            <td class="baocao-detail-note">@item.GhiChu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="baocao-detail-no-match" data-baocao-detail-no-match hidden>Không tìm thấy bản ghi phù hợp.</p>
    }
</div>
<div class="modal-footer baocao-detail-footer">
    <span>Thông tin theo kỳ và phòng ban đã chọn</span>
    <button type="button" class="btn btn-hotel-primary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
</div>
