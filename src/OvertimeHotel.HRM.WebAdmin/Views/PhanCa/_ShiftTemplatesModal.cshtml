@model IReadOnlyList<OvertimeHotel.HRM.Core.Models.CaLamViec>

<div class="modal fade" id="modalShiftTemplates" tabindex="-1" aria-labelledby="modalShiftTemplatesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
            <!-- MODAL HEADER -->
            <div class="modal-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 44px; height: 44px; background: linear-gradient(135deg, #0f172a, #1e3a8a); color: #d4af37; box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2);">
                        <i class="bi bi-clock-history fs-5"></i>
                    </div>
                    <div>
                        <div class="text-uppercase small fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px; color: #b45309;">
                            <i class="bi bi-stars text-warning me-1"></i>Vận hành khách sạn 24/7
                        </div>
                        <h2 class="modal-title h5 mb-0 font-serif fw-bold text-dark" id="modalShiftTemplatesLabel">
                            Danh Mục Mẫu Ca Trực 24/7
                        </h2>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <!-- MODAL BODY -->
            <div class="modal-body p-4 bg-light bg-opacity-50">
                <!-- KHỐI FORM THÊM MẪU CA MỚI (ACCORDION / COLLAPSIBLE CARD) -->
                <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden" style="border: 1px solid #e2e8f0 !important;">
                    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center cursor-pointer"
                         data-bs-toggle="collapse" data-bs-target="#collapseNewShiftForm" aria-expanded="false" style="cursor: pointer;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle-fill text-primary"></i>
                            <span class="fw-bold text-dark" style="font-size: 0.92rem;">Thêm Mẫu Ca Làm Việc Mới</span>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-1">
                            <i class="bi bi-chevron-down"></i> Mở biểu mẫu
                        </span>
                    </div>
                    <div class="collapse" id="collapseNewShiftForm">
                        <div class="card-body p-4 bg-light">
                            <form asp-controller="CaLamViec" asp-action="Create" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="/PhanCa?openShiftModal=true" />
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold text-dark small">Tên ca làm việc <span class="text-danger">*</span></label>
                                        <input type="text" name="TenCa" class="form-control rounded-3" placeholder="Ví dụ: Ca Sáng, Ca Chiều, Ca Đêm..." required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold text-dark small">Giờ bắt đầu <span class="text-danger">*</span></label>
                                        <input type="time" name="GioBatDau" class="form-control rounded-3" value="06:00" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold text-dark small">Giờ kết thúc <span class="text-danger">*</span></label>
                                        <input type="time" name="GioKetThuc" class="form-control rounded-3" value="14:00" required />
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check form-switch p-2 bg-white rounded-3 border ps-5">
                                            <input class="form-check-input" type="checkbox" name="QuaDem" value="true" id="switchQuaDemNew" />
                                            <input type="hidden" name="QuaDem" value="false" />
                                            <label class="form-check-label fw-semibold text-dark small" for="switchQuaDemNew">
                                                <i class="bi bi-moon-stars-fill text-warning me-1"></i> Ca trực qua đêm (Tự động cộng +30% phụ cấp lương ca đêm theo Bộ luật Lao động)
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-hotel-primary rounded-pill px-4 fw-semibold shadow-sm">
                                            <i class="bi bi-check2 me-1"></i> Thêm mẫu ca
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- BẢNG DANH SÁCH CÁC CA TRỰC HIỆN HÀNH -->
                <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden" style="border: 1px solid #e2e8f0 !important;">
                    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark" style="font-size: 0.92rem;">
                            <i class="bi bi-list-check text-primary me-2"></i>Các Khung Ca Đang Áp Dụng (@Model.Count mẫu ca)
                        </span>
                        <span class="badge bg-light text-muted border rounded-pill px-3 py-1 small">
                            Cấu hình 24/7
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr style="font-size: 0.8rem; color: #475569; text-transform: uppercase; letter-spacing: 0.5px;">
                                    <th class="ps-4" style="width: 70px;">Mã</th>
                                    <th>Tên ca trực</th>
                                    <th style="width: 140px;">Khung giờ</th>
                                    <th style="width: 110px;">Thời lượng</th>
                                    <th>Đặc điểm &amp; Phụ cấp</th>
                                    <th class="text-end pe-4" style="width: 90px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="bi bi-clock-slash fs-2 text-secondary opacity-50 d-block mb-2"></i>
                                        Chưa có mẫu ca trực nào trong hệ thống.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var ca in Model)
                                {
                                    var isNight = ca.QuaDem || ca.TenCa.Contains("Đêm", StringComparison.OrdinalIgnoreCase);
                                    var isAfternoon = ca.TenCa.Contains("Chiều", StringComparison.OrdinalIgnoreCase);
                                    var shiftIcon = isNight ? "bi-moon-stars-fill text-warning" : isAfternoon ? "bi-cloud-sun-fill text-warning" : "bi-brightness-high-fill text-primary";

                                    double durationHours;
                                    if (ca.QuaDem || ca.GioKetThuc < ca.GioBatDau)
                                    {
                                        durationHours = (24 - ca.GioBatDau.Hour - ca.GioBatDau.Minute / 60.0) + (ca.GioKetThuc.Hour + ca.GioKetThuc.Minute / 60.0);
                                    }
                                    else
                                    {
                                        durationHours = (ca.GioKetThuc.Hour + ca.GioKetThuc.Minute / 60.0) - (ca.GioBatDau.Hour + ca.GioBatDau.Minute / 60.0);
                                    }

                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-light text-secondary border font-monospace">#@ca.MaCa</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi @shiftIcon fs-6"></i>
                                                <strong class="text-dark font-serif" style="font-size: 0.9rem;">@ca.TenCa</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="font-monospace fw-semibold text-dark small bg-light px-2 py-1 rounded border">
                                                @ca.GioBatDau.ToString("HH:mm") &rarr; @ca.GioKetThuc.ToString("HH:mm")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border rounded-pill px-2 py-1 small">
                                                @durationHours.ToString("0.#") giờ
                                            </span>
                                        </td>
                                        <td>
                                            @if (isNight)
                                            {
                                                <span class="badge rounded-pill px-3 py-1 small"
                                                      style="background: #0f172a; color: #fde047; border: 1px solid #eab308; box-shadow: 0 2px 6px rgba(15, 23, 42, 0.15);">
                                                    <i class="bi bi-star-fill text-warning me-1"></i> Ca đêm +30% phụ cấp
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border rounded-pill px-3 py-1 small">
                                                    Ca tiêu chuẩn (1.0x)
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <form asp-controller="CaLamViec" asp-action="Delete" asp-route-id="@ca.MaCa" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa mẫu ca “@ca.TenCa”?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="/PhanCa?openShiftModal=true" />
                                                <button type="submit" class="btn btn-sm btn-light border text-danger rounded-circle"
                                                        style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;"
                                                        title="Xóa mẫu ca này">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MODAL FOOTER -->
            <div class="modal-footer bg-light border-top py-3 px-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</div>
