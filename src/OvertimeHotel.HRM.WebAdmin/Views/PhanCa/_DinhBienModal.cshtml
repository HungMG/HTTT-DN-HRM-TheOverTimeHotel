@using System.Globalization
@model OvertimeHotel.HRM.WebAdmin.Models.DinhBienModalViewModel

@{
    var groupedRows = Model.Rows
        .GroupBy(r => new { r.MaPhongBan, TenPhongBan = r.TenPhongBan ?? "Khách sạn / Dùng chung" })
        .OrderBy(g => g.Key.TenPhongBan)
        .ToList();
}

<div class="modal fade" id="modalDinhBien" tabindex="-1" aria-labelledby="modalDinhBienLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <form method="post" asp-action="SaveDinhBien" id="formDinhBien"
              class="modal-content border-0 rounded-4 shadow-lg overflow-hidden"
              data-ngay="@Model.Ngay.ToString("yyyy-MM-dd")"
              onsubmit="return submitDinhBien(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ReturnWeek" value="@Model.ReturnWeek" />
            <input type="hidden" name="Ngay" id="inputDinhBienNgay" value="" />
            <div id="dinhBienCellsContainer"></div>

            <!-- MODAL HEADER -->
            <div class="modal-header bg-white border-bottom py-2.5 px-3">
                <div class="d-flex align-items-center gap-2.5">
                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0"
                         style="width: 38px; height: 38px; background: linear-gradient(135deg, #0f172a, #1e3a8a); color: #d4af37;">
                        <i class="bi bi-people-fill fs-6"></i>
                    </div>
                    <div>
                        <h2 class="modal-title fs-6 fw-bold text-dark mb-0 font-serif" id="modalDinhBienLabel">
                            Cấu Hình Định Biên Ca Trực
                        </h2>
                        <div class="text-muted" style="font-size: 0.72rem;">
                            Thiết lập số lượng nhân sự tối thiểu theo ca và chức vụ · Mức nền chuẩn hoặc mức riêng theo ngày
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <!-- MODAL BODY -->
            <div class="modal-body p-3 bg-light bg-opacity-50" style="overflow-y: auto; max-height: calc(85vh - 120px);">
                <!-- 1. BẢNG ĐIỀU KHIỂN PHẠM VI (MỨC CHUẨN MỌI NGÀY 🔁 MỨC RIÊNG THEO NGÀY TRONG TUẦN) -->
                <div class="card border-0 rounded-3 shadow-sm bg-white mb-2.5 p-2.5" style="border: 1px solid #e2e8f0 !important;">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <!-- NÚT CHUYỂN CHẾ ĐỘ -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="small fw-bold text-dark" style="font-size: 0.78rem;">
                                <i class="bi bi-sliders2 text-primary me-1"></i>Chế độ áp dụng:
                            </span>
                            <div class="btn-group btn-group-sm rounded-pill p-0.5 bg-light border" role="group">
                                <button type="button" class="btn btn-xs rounded-pill px-3 py-1 fw-bold dinh-bien-mode-btn active"
                                        data-mode="nen" onclick="switchDinhBienMode('nen', this)" style="font-size: 0.75rem;">
                                    <i class="bi bi-calendar-range me-1 text-primary"></i>🌟 Mọi ngày (Mức chuẩn)
                                </button>
                                <button type="button" class="btn btn-xs rounded-pill px-3 py-1 fw-bold dinh-bien-mode-btn btn-light"
                                        data-mode="ngay" onclick="switchDinhBienMode('ngay', this)" style="font-size: 0.75rem;">
                                    <i class="bi bi-calendar-day me-1 text-warning"></i>📅 Mức riêng theo ngày
                                </button>
                            </div>
                        </div>

                        <!-- THÔNG ĐIỆP HƯỚNG DẪN -->
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted" id="dinhBienModeHint" style="font-size: 0.74rem;">
                                <i class="bi bi-info-circle text-primary me-1"></i>Mức chuẩn áp dụng cho tất cả các ngày trong tuần (nhập 0 để bỏ).
                            </span>
                        </div>
                    </div>

                    <!-- THANH CHỌN NGÀY TRONG TUẦN (HIỆN KHI CHỌN CHẾ ĐỘ "MỨC RIÊNG THEO NGÀY") -->
                    <div id="dinhBienWeekDaysContainer" class="d-none pt-2 border-top">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="d-flex flex-wrap align-items-center gap-1.5" id="dinhBienDayPills">
                                <span class="small fw-semibold text-secondary me-1" style="font-size: 0.74rem;">
                                    <i class="bi bi-calendar-week me-1"></i>Chọn ngày:
                                </span>
                                @if (Model.WeekDays.Count > 0)
                                {
                                    @foreach (var day in Model.WeekDays)
                                    {
                                        var isCurrentDay = day.Date == Model.Ngay;
                                        <button type="button"
                                                class="btn btn-xs rounded-pill px-2.5 py-1 fw-semibold dinh-bien-day-btn @(isCurrentDay ? "btn-primary active shadow-xs" : "btn-outline-secondary")"
                                                data-date="@day.Date.ToString("yyyy-MM-dd")"
                                                onclick="selectDinhBienDate('@day.Date.ToString("yyyy-MM-dd")', this)"
                                                style="font-size: 0.72rem;">
                                            @day.DayName (@day.FormattedDate)
                                            @if (day.HasCustomQuota)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill ms-1 px-1 py-0" style="font-size: 0.58rem;" title="Ngày này đã có định biên riêng">
                                                    riêng
                                                </span>
                                            }
                                        </button>
                                    }
                                }
                                else
                                {
                                    <button type="button" class="btn btn-xs btn-primary rounded-pill px-2.5 py-1 fw-semibold active"
                                            data-date="@Model.Ngay.ToString("yyyy-MM-dd")">
                                        @Model.Ngay.ToString("dd/MM/yyyy")
                                    </button>
                                }
                            </div>

                            <!-- DATE PICKER TÙY CHỌN CHO NGÀY BẤT KỲ -->
                            <div class="d-flex align-items-center gap-1.5">
                                <label for="dinhBienCustomDateInput" class="small text-muted mb-0" style="font-size: 0.72rem;">
                                    Ngày khác:
                                </label>
                                <input type="date" id="dinhBienCustomDateInput"
                                       class="form-control form-control-sm rounded-pill px-2 py-0.5 text-center"
                                       style="width: 125px; font-size: 0.72rem; height: 26px;"
                                       value="@Model.Ngay.ToString("yyyy-MM-dd")"
                                       onchange="selectDinhBienDate(this.value, null)" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. BỘ LỌC THEO PHÒNG BAN (GỌN GÀNG, TRÁNH RỐI MẮT NHƯ PHẢN HỒI) -->
                @if (groupedRows.Count > 1)
                {
                    <div class="d-flex flex-wrap align-items-center gap-1.5 mb-2 px-1" id="dinhBienDeptFilterPills">
                        <span class="small fw-semibold text-secondary me-1" style="font-size: 0.74rem;">
                            <i class="bi bi-filter me-1"></i>Lọc bộ phận:
                        </span>
                        <button type="button" class="btn btn-xs rounded-pill px-2.5 py-0.5 fw-bold dinh-bien-dept-btn btn-primary active shadow-xs"
                                data-dept-id="all" onclick="filterDinhBienDepartment('all', this)" style="font-size: 0.72rem;">
                            Tất cả (@Model.Rows.Count)
                        </button>
                        @foreach (var g in groupedRows)
                        {
                            var deptIdStr = g.Key.MaPhongBan.HasValue ? g.Key.MaPhongBan.Value.ToString() : "null";
                            <button type="button" class="btn btn-xs rounded-pill px-2.5 py-0.5 fw-semibold dinh-bien-dept-btn btn-outline-secondary"
                                    data-dept-id="@deptIdStr" onclick="filterDinhBienDepartment('@deptIdStr', this)" style="font-size: 0.72rem;">
                                @g.Key.TenPhongBan (@g.Count())
                            </button>
                        }
                    </div>
                }

                <!-- 3. LƯỚI ĐỊNH BIÊN: GOM NHÓM THEO BỘ PHẬN RÕ RÀNG -->
                <div class="card border-0 rounded-3 shadow-sm bg-white overflow-hidden" style="border: 1px solid #e2e8f0 !important;">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 dinh-bien-table" id="tableDinhBienMatrix">
                            <thead class="bg-light sticky-top" style="z-index: 2;">
                                <tr style="font-size: 0.74rem; color: #475569; text-transform: uppercase; letter-spacing: 0.4px; background: #f8fafc;">
                                    <th class="ps-3 bg-light" style="width: 32%;">Chức vụ / Vị trí</th>
                                    @foreach (var ca in Model.DanhSachCa)
                                    {
                                        <th class="text-center bg-light" style="width: 125px;">
                                            <div class="d-flex flex-column align-items-center">
                                                <span class="fw-bold">@ca.TenCa</span>
                                                <span class="font-monospace text-muted" style="font-size: 0.66rem; font-weight: 400;">
                                                    @ca.GioBatDau.ToString("HH:mm") - @ca.GioKetThuc.ToString("HH:mm")
                                                </span>
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.Rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(Model.DanhSachCa.Count + 1)" class="text-center py-4 text-muted">
                                        <i class="bi bi-person-x fs-2 text-secondary opacity-50 d-block mb-1"></i>
                                        Chưa có chức vụ nào để cấu hình định biên.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var group in groupedRows)
                                {
                                    var deptIdStr = group.Key.MaPhongBan.HasValue ? group.Key.MaPhongBan.Value.ToString() : "null";
                                    <tr class="table-group-divider dinh-bien-dept-header-row" data-dept-id="@deptIdStr" style="background: #f1f5f9;">
                                        <td colspan="@(Model.DanhSachCa.Count + 1)" class="py-1 px-3 fw-bold text-dark" style="font-size: 0.76rem;">
                                            <i class="bi bi-diagram-3-fill text-primary me-1.5"></i>@group.Key.TenPhongBan
                                            <span class="badge bg-light text-secondary border rounded-pill ms-2 px-2 py-0.5" style="font-size: 0.65rem;">
                                                @group.Count() chức danh
                                            </span>
                                        </td>
                                    </tr>
                                    @foreach (var row in group)
                                    {
                                        <tr class="dinh-bien-row" data-dept-id="@deptIdStr">
                                            <td class="ps-3 py-2">
                                                <div class="fw-semibold text-dark" style="font-size: 0.84rem;">@row.TenChucVu</div>
                                                <div class="text-muted" style="font-size: 0.7rem;">
                                                    @(row.MaPhongBan.HasValue ? row.TenPhongBan : "Dùng chung mọi bộ phận")
                                                </div>
                                            </td>
                                            @foreach (var ca in Model.DanhSachCa)
                                            {
                                                var mucNen = row.MucNenTheoCa.TryGetValue(ca.MaCa, out var n) ? n : 0;
                                                var mucNgay = row.MucNgayTheoCa.TryGetValue(ca.MaCa, out var d) ? d : 0;
                                                var hienCo = row.HienCoTheoCa.TryGetValue(ca.MaCa, out var h) ? h : 0;
                                                var coRiengNgay = mucNgay > 0;
                                                var chiDoc = !Model.CoQuyenSua;

                                                <td class="text-center py-2">
                                                    <div class="d-flex flex-column align-items-center gap-0.5">
                                                        <input type="number"
                                                               class="form-control form-control-sm text-center rounded-2 dinh-bien-input @(coRiengNgay ? "has-day-override" : "")"
                                                               style="width: 64px; height: 30px; font-size: 0.84rem; font-weight: 600; font-variant-numeric: tabular-nums;"
                                                               min="0" max="99" step="1" inputmode="numeric"
                                                               data-ma-ca="@ca.MaCa"
                                                               data-ma-chuc-vu="@row.MaChucVu"
                                                               data-ma-phong-ban="@(row.MaPhongBan?.ToString() ?? "")"
                                                               data-muc-nen="@mucNen"
                                                               data-muc-ngay="@mucNgay"
                                                               data-co-rieng-ngay="@(coRiengNgay ? "1" : "0")"
                                                               title="Hiện có @hienCo người trực"
                                                               disabled="@chiDoc" />
                                                        <div class="d-flex align-items-center gap-1 mt-0.5">
                                                            <span class="badge rounded-pill px-1 py-0 dinh-bien-day-badge @(coRiengNgay ? "" : "d-none")"
                                                                  style="font-size: 0.58rem; background: #fef3c7; color: #92400e; border: 1px solid #fcd34d;">
                                                                riêng
                                                            </span>
                                                            <span class="dinh-bien-hien-co text-muted" style="font-size: 0.65rem; font-variant-numeric: tabular-nums;">
                                                                có @hienCo
                                                            </span>
                                                        </div>
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MODAL FOOTER -->
            <div class="modal-footer bg-light border-top py-2.5 px-3 d-flex align-items-center justify-content-between">
                <div class="text-muted small" style="font-size: 0.74rem;" id="dinhBienFooterSummary">
                    <i class="bi bi-check-circle text-success me-1"></i>Nhập số lượng &gt;= 1 hoặc nhập 0 để xóa định biên.
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Đóng
                    </button>
                    @if (Model.CoQuyenSua)
                    {
                        <button type="submit" class="btn btn-sm btn-hotel-primary rounded-pill px-3.5 fw-bold shadow-sm" id="btnSaveDinhBien">
                            <i class="bi bi-check2-circle me-1"></i> <span id="btnSaveDinhBienText">Lưu định biên chung</span>
                        </button>
                    }
                    else
                    {
                        <span class="small text-muted ms-2">
                            <i class="bi bi-lock me-1"></i>Tài khoản chỉ xem.
                        </span>
                    }
                </div>
            </div>
        </form>
    </div>
</div>
