        border-bottom: 1.5px solid #e2e8f0 !important;
    }
    .event-compact-table th {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        color: #475569;
        background: #f8fafc;
        padding: 0.65rem 0.85rem;
        border-bottom: 1.5px solid #e2e8f0;
        white-space: nowrap;
    }
    .event-compact-table td {
        padding: 0.65rem 0.85rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.83rem;
    }
    .event-dept-section {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        overflow: hidden;
        margin-bottom: 0.85rem;
    }
    .event-dept-header {
        background: #f8fafc;
        padding: 0.6rem 0.9rem;
        border-bottom: 1px solid #e2e8f0;
    }
</style>

@if (Model.EventDemandUnavailable)
{
    <div class="alert alert-warning rounded-4 shadow-xs border-warning-subtle d-flex align-items-center gap-2 mb-3" role="status">
        <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
        <div>Chưa tải được nhu cầu sự kiện và trạng thái công bố tuần. Vui lòng thử lại hoặc liên hệ quản trị viên hệ thống.</div>
    </div>
}

@if (Model.CanViewEventDemand)
{
    <section class="shift-workspace-card shadow-sm p-3 p-lg-4 mb-4 event-demand-hub" aria-labelledby="event-week-heading">
        <!-- HEADER TRUNG TÂM ĐIỀU PHỐI SỰ KIỆN -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2.5 mb-3 pb-2.5 border-bottom">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h2 id="event-week-heading" class="h6 fw-bold text-dark font-serif mb-0 d-flex align-items-center gap-1.5">
                    <i class="bi bi-calendar-event text-primary"></i>
                    <span>Nhu Cầu Sự Kiện Trong Tuần</span>
                </h2>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 small">
                    Tuần @Model.WeekStart.ToString("dd/MM") – @Model.WeekEnd.ToString("dd/MM/yyyy")
                </span>
            </div>

            <!-- CỤM NÚT THAO TÁC -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-hotel-primary btn-sm rounded-pill px-3 py-1 fw-bold shadow-xs catalog-action-btn"
                        data-bs-toggle="modal" data-bs-target="#modalCreatePhanCa" title="Mở lưới lập lịch phân ca chi tiết">
                    <i class="bi bi-calendar-plus-fill me-1"></i> + Lập Ca
                </button>
                <a class="btn btn-hotel-secondary btn-sm rounded-pill px-3 py-1 fw-semibold shadow-xs"
                   asp-controller="SuKien" asp-action="Index" title="Chuyển đến Phân hệ Quản Lý Sự Kiện">
                    <i class="bi bi-box-arrow-up-right text-primary me-1"></i> Quản Lý Sự Kiện
                </a>
            </div>
        </div>

        <!-- DẢI BENTO KPI TỔNG HỢP NHU CẦU SỰ KIỆN TRONG TUẦN -->
        <div class="row g-2.5 mb-3.5">
            <div class="col-6 col-md-3">
                <div class="event-kpi-card shadow-xs">
                    <span class="text-uppercase small text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                        <i class="bi bi-calendar-check text-primary me-1"></i>Sự Kiện Trong Tuần
                    </span>
                    <div class="d-flex align-items-baseline gap-1.5 mt-1">
                        <span class="fs-4 fw-bold text-dark">@totalEvents</span>
                        <span class="small text-muted">sự kiện</span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="event-kpi-card shadow-xs">
                    <span class="text-uppercase small text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                        <i class="bi bi-diagram-3 text-info me-1"></i>Vị Trí Cần Bố Trí
                    </span>
                    <div class="d-flex align-items-baseline gap-1.5 mt-1">
                        <span class="fs-4 fw-bold text-dark">@totalNeeds</span>
                        <span class="small text-muted">vị trí</span>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="event-kpi-card shadow-xs">
                    <span class="text-uppercase small text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                        <i class="bi bi-people-fill text-success me-1"></i>Tiến Độ Nhân Lực
                    </span>
                    <div class="d-flex align-items-baseline gap-1.5 mt-1">
                        <span class="fs-4 fw-bold text-dark">@totalConfirmedStaff</span>
                        <span class="small text-muted">/ @totalTargetStaff người</span>
                        @if (totalMissingStaff > 0)
                        {
                            <span class="badge bg-danger-subtle text-danger rounded-pill ms-auto" style="font-size: 0.68rem;">
                                Thiếu @totalMissingStaff
                            </span>
                        }
                        else if (totalTargetStaff > 0)
                        {
                            <span class="badge bg-success-subtle text-success rounded-pill ms-auto" style="font-size: 0.68rem;">
                                Đủ 100%
                            </span>
                        }
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="event-kpi-card shadow-xs">
                    <span class="text-uppercase small text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                        <i class="bi bi-clock-history text-warning me-1"></i>Dự Báo Ca Sẵn Sàng
                    </span>
                    <div class="d-flex align-items-baseline gap-1.5 mt-1">
                        <span class="fs-4 fw-bold text-dark">@totalForecastShifts</span>
                        <span class="small text-muted">ca trùng giờ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- DANH SÁCH SỰ KIỆN DẠNG BẢNG RÕ RÀNG -->
        @if (Model.EventDemand.Count == 0)
        {
            <div class="text-center py-5 bg-light rounded-4 border border-dashed my-3">
                <i class="bi bi-calendar-x text-muted fs-1 mb-2 d-block"></i>
                <h5 class="fw-bold text-secondary mb-1">Chưa có sự kiện nào trong tuần này</h5>
                <p class="text-muted small mb-0">Không có sự kiện hoặc nhu cầu nhân lực phát sinh trong tuần được chọn.</p>
            </div>
        }
        else
        {
            <div class="table-responsive rounded-3 border bg-white shadow-xs mb-4">
                <table class="table table-hover align-middle mb-0 event-list-table">
                    <thead>
                        <tr>
                            <th scope="col" style="min-width: 280px;">Sự Kiện &amp; Mã</th>
                            <th scope="col" style="min-width: 200px;">Khung Giờ Dự Kiến</th>
                            <th scope="col" style="min-width: 180px;">Địa Điểm</th>
                            <th scope="col" style="min-width: 160px;">Nhu Cầu Nhân Lực</th>
                            <th scope="col" style="width: 130px;">Trạng Thái</th>
                            <th scope="col" class="text-end" style="width: 160px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.EventDemand)
                        {
                            var eventLocalDate = HotelEventRules.Local(item.NgayBatDau);
                            var eventEndDate = HotelEventRules.Local(item.KetThucThucTe ?? item.NgayKetThuc);

                            // Tính chỉ tiêu & thiếu hụt
                            var eventTarget = item.NhuCaus.Sum(n => n.SoNguoi);
                            var eventConfirmed = 0;
                            var eventMissing = 0;
                            foreach (var n in item.NhuCaus)
                            {
                                var from = item.NgayBatDau > weekFrom ? item.NgayBatDau : weekFrom;
                                var eventEnd = item.KetThucThucTe is { } actualEnd && actualEnd < item.NgayKetThuc ? actualEnd : item.NgayKetThuc;
                                var to = eventEnd < weekTo ? eventEnd : weekTo;
                                var asgns = item.PhanCongs.Where(p => p.TrangThaiThamGia is not ("HUY_PHAN_CONG" or "DA_HUY")
                                    && (p.MaPhongBanSuKien ?? HotelEventRules.ResolveDepartmentCode(p.NhanVien)) == n.MaPhongBan
                                    && HotelEventRoleRules.Matches(n.VaiTro, p.VaiTroDuAn)).ToList();
                                var conf = HotelEventRoleRules.MinimumConcurrentCount(asgns, from, to);
                                eventConfirmed += conf;
                                eventMissing += Math.Max(0, n.SoNguoi - conf);
                            }

                            <tr class="event-row-clickable"
                                onclick="openEventDemandModal(@item.MaDuAn)"
                                title="Nhấp vào để xem chi tiết ca trùng và phân công nhân sự">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 fw-bold" style="font-size: 0.72rem;">
                                            #@item.MaDuAn
                                        </span>
                                        <div>
                                            <div class="fw-bold text-dark font-serif" style="font-size: 0.95rem;">
                                                @item.TenDuAn
                                            </div>
                                            <small class="text-muted">
                                                <i class="bi bi-diagram-3 me-1"></i>@item.NhuCaus.Count vị trí định mức
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-dark fw-semibold">
                                        <i class="bi bi-clock-history text-primary me-1"></i>@eventLocalDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    <div class="small text-muted">
                                        đến @eventEndDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-dark">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>@HotelEventRules.VenueLabel(item.DiaDiem)
                                    </div>
                                </td>
                                <td>
                                    @if (item.TrangThai == "HOAN_THANH")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1 fw-bold">
                                            <i class="bi bi-check-all me-1"></i>Đã xong (@eventConfirmed/@eventTarget)
                                        </span>
                                    }
                                    else if (eventMissing > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1 fw-bold">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Thiếu @eventMissing/@eventTarget người
                                        </span>
                                    }
                                    else if (eventTarget > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 fw-bold">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đủ @eventConfirmed/@eventTarget
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-0.5">0 chỉ tiêu</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TrangThai == "HOAN_THANH")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1 small">
                                            Đã xong
                                        </span>
                                    }
                                    else if (item.TrangThai == "DANG_DIEN_RA")
                                    {
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 small fw-bold">
                                            <i class="bi bi-play-circle-fill me-1"></i>Đang diễn ra
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2.5 py-1 small">
                                            Kế hoạch
                                        </span>
                                    }
                                </td>
                                <td class="text-end" onclick="event.stopPropagation();">
                                    <button type="button" class="btn btn-sm btn-hotel-primary rounded-pill px-3 py-1 fw-bold shadow-xs d-inline-flex align-items-center gap-1.5"
                                            onclick="openEventDemandModal(@item.MaDuAn); event.stopPropagation();">
                                        <i class="bi bi-people-fill text-warning"></i>
                                        <span>Xem Ca Trực</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- CÁC POPUP MODAL CHI TIẾT NHÂN SỰ & RÀ SOÁT CA GỌN GÀNG, ÍT CHỮ (TELEPORT RA BODY ĐỂ CHỐNG LỖI MỜ ĐEN) -->
    @foreach (var item in Model.EventDemand)
    {
        var eventStart = item.NgayBatDau;
        var eventEnd = item.KetThucThucTe is { } actualEnd && actualEnd < item.NgayKetThuc ? actualEnd : item.NgayKetThuc;
        var eventLocalDate = HotelEventRules.Local(eventStart);
        var eventEndDate = HotelEventRules.Local(eventEnd);
        var eventDateStr = eventLocalDate.ToString("yyyy-MM-dd");
        var eventDateFormatted = eventLocalDate.ToString("dd/MM/yyyy");
        var eventTotalHours = Math.Max(0.5, (eventEnd - eventStart).TotalHours);

        var activeAssignments = item.PhanCongs.Where(p => p.TrangThaiThamGia != "HUY_PHAN_CONG" && p.TrangThaiThamGia != "DA_HUY").ToList();
        var activeCount = activeAssignments.Count;

        var eventTarget = item.NhuCaus.Sum(n => n.SoNguoi);
        var eventConfirmed = 0;
        var eventMissing = 0;
        foreach (var n in item.NhuCaus)
        {
            var from = item.NgayBatDau > weekFrom ? item.NgayBatDau : weekFrom;
            var to = eventEnd < weekTo ? eventEnd : weekTo;
            var asgns = item.PhanCongs.Where(p => p.TrangThaiThamGia is not ("HUY_PHAN_CONG" or "DA_HUY")
                && (p.MaPhongBanSuKien ?? HotelEventRules.ResolveDepartmentCode(p.NhanVien)) == n.MaPhongBan
                && HotelEventRoleRules.Matches(n.VaiTro, p.VaiTroDuAn)).ToList();
            var conf = HotelEventRoleRules.MinimumConcurrentCount(asgns, from, to);
            eventConfirmed += conf;
            eventMissing += Math.Max(0, n.SoNguoi - conf);
        }

        // Gom nhóm theo Bộ phận để tránh lặp lại nhân sự
        var deptGroups = item.NhuCaus.GroupBy(n => n.MaPhongBan).ToList();

        <div class="modal fade event-demand-modal" id="modalEventDemand_@item.MaDuAn" tabindex="-1" aria-labelledby="modalLabel_@item.MaDuAn" aria-hidden="true" data-event-demand-modal="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content event-modal-content">
                    <!-- HEADER MODAL POPUP SIÊU GỌN CHUẨN TRẮNG SANG TRỌNG -->
                    <div class="modal-header event-modal-header d-flex align-items-center justify-content-between">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold" style="font-size: 0.72rem;">#@item.MaDuAn</span>
                                <h3 class="modal-title h6 fw-bold text-dark mb-0 font-serif" id="modalLabel_@item.MaDuAn">
                                    @item.TenDuAn
                                </h3>
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-clock text-primary me-1"></i>@eventLocalDate.ToString("dd/MM/yyyy HH:mm") – @eventEndDate.ToString("HH:mm") (@eventTotalHours.ToString("0.#")h)
                                <span class="mx-1 text-secondary">·</span>
                                <i class="bi bi-geo-alt-fill text-danger me-0.5"></i>@HotelEventRules.VenueLabel(item.DiaDiem)
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>

                    <!-- BODY MODAL POPUP -->
                    <div class="modal-body p-3 bg-light bg-opacity-40">
                        <!-- THANH TIẾN ĐỘ GỌN GÀNG 1 DÒNG -->
                        <div class="bg-white p-2.5 rounded-3 border mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-xs">
                            <div class="d-flex align-items-center gap-2">
                                <span class="small fw-bold text-dark">Tiến độ nhân lực:</span>
                                <span class="fs-6 fw-bold @(eventMissing > 0 ? "text-danger" : "text-success")">
                                    @eventConfirmed / @eventTarget người
                                </span>
                                @if (eventMissing > 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-0.5 small">
                                        Thiếu @eventMissing
                                    </span>
                                }
                                else if (eventTarget > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5 small">
                                        Đủ 100%
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <ul class="nav nav-pills p-0.5 bg-light rounded-pill border" id="eventModalTabs_@item.MaDuAn" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link active rounded-pill px-3 py-1 fw-bold small"
                                                id="tab-shifts-check-@item.MaDuAn"
                                                data-bs-toggle="pill"
                                                data-bs-target="#content-shifts-check-@item.MaDuAn"
                                                type="button" role="tab">
                                            <i class="bi bi-clock-history me-1"></i>Ca Trùng &amp; Nối Ca
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link rounded-pill px-3 py-1 fw-bold small"
                                                id="tab-assigned-staff-@item.MaDuAn"
                                                data-bs-toggle="pill"
                                                data-bs-target="#content-assigned-staff-@item.MaDuAn"
                                                type="button" role="tab">
                                            <i class="bi bi-people-fill me-1"></i>Đã Gán (@activeCount)
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- NỘI DUNG TABS -->
                        <div class="tab-content" id="eventModalTabsContent_@item.MaDuAn">
                            <!-- =========================================================================
                                 TAB 1: CA TRÙNG & NỐI CA - BỐ CỤC BẢNG GỌN GÀNG, ÍT CHỮ, RÕ NGHĨA
                                 ========================================================================= -->
                            <div class="tab-pane fade show active" id="content-shifts-check-@item.MaDuAn" role="tabpanel">
                                @if (deptGroups.Count == 0)
                                {
                                    <div class="p-3 bg-white rounded-3 border text-muted small text-center">
                                        Chưa khai báo vị trí định mức nhân sự cho sự kiện này.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var group in deptGroups)
                                    {
                                        var deptCode = group.Key;
                                        var matchingDept = Model.DanhSachPhongBan.FirstOrDefault(p =>
                                            HotelEventRules.ResolveDepartmentCode(p.MaPhongBan, p.TenPhongBan) == deptCode);
                                        var deptId = matchingDept?.MaPhongBan;
                                        var deptName = matchingDept?.TenPhongBan ?? HotelEventRules.DepartmentLabels.GetValueOrDefault(deptCode, deptCode);

                                        var deptTarget = group.Sum(n => n.SoNguoi);
                                        var rolesSummary = string.Join(" · ", group.Select(n => $"{n.VaiTro} ({n.SoNguoi})"));

                                        // 1. Tìm nhân sự bộ phận có ca trùng sự kiện
                                        var deptShiftsInEvent = Model.DanhSachPhanCa
                                            .Where(s => s.TrangThai != "DA_HUY" && s.TrangThai != "VANG_MAT" && s.NhanVien != null
                                                && (HotelEventRules.ResolveDepartmentCode(s.NhanVien) == deptCode
                                                    || (deptId.HasValue && s.NhanVien.MaPhongBan == deptId))
                                                && HotelEventRules.Overlaps(s.BatDauDuKien, s.KetThucDuKien, eventStart, eventEnd))
                                            .OrderBy(s => s.BatDauDuKien)
                                            .ToList();

                                        <div class="event-dept-section shadow-xs">
                                            <!-- HEADER BỘ PHẬN GỌN -->
                                            <div class="event-dept-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge @GetDeptBadgeClass(deptCode) rounded-pill px-2.5 py-1">
                                                        <i class="bi @GetDeptIcon(deptCode) me-1"></i>@deptName
                                                    </span>
                                                    <span class="small text-muted">@rolesSummary</span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-dark rounded-pill px-2 py-0.5 small">Cần @deptTarget người</span>
                                                    <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-0.5 fw-bold"
                                                            onclick="handleEventDemandAddShift('modalEventDemand_@item.MaDuAn', @(deptId.HasValue ? deptId.Value.ToString() : "null"), '@eventDateStr', '', '@item.TenDuAn.Replace("'", "\\'")', '@deptName.Replace("'", "\\'")')"
                                                            title="Lập ca làm việc mới cho bộ phận @deptName">
                                                        <i class="bi bi-calendar-plus me-1"></i>+ Lập ca
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- DANH SÁCH NHÂN SỰ DẠNG BẢNG GỌN (1 DÒNG / NHÂN VIÊN) -->
                                            @if (deptShiftsInEvent.Count == 0)
                                            {
                                                <div class="p-3 text-center bg-white">
                                                    <span class="text-danger small fw-semibold">
                                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Chưa có ca trực nào trùng giờ (@eventLocalDate.ToString("HH:mm") – @eventEndDate.ToString("HH:mm")).
                                                    </span>
                                                    <button type="button" class="btn btn-xs btn-danger rounded-pill px-2.5 py-0.5 ms-2 fw-bold"
                                                            onclick="handleEventDemandAddShift('modalEventDemand_@item.MaDuAn', @(deptId.HasValue ? deptId.Value.ToString() : "null"), '@eventDateStr', '', '@item.TenDuAn.Replace("'", "\\'")', '@deptName.Replace("'", "\\'")')">
                                                        + Phân ca ngay
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="table-responsive bg-white">
                                                    <table class="table table-hover align-middle mb-0 event-compact-table">
                                                        <thead>
                                                            <tr>
                                                                <th scope="col" style="width: 200px;">Nhân Viên</th>
                                                                <th scope="col" style="width: 150px;">Ca Làm Việc</th>
                                                                <th scope="col" style="width: 190px;">Thời Gian Trực</th>
                                                                <th scope="col" style="min-width: 260px;">Bàn Giao Nối Ca</th>
                                                                <th scope="col" class="text-center" style="width: 100px;">Thao Tác</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var shift in deptShiftsInEvent)
                                                            {
                                                                var shiftStart = shift.BatDauDuKien;
                                                                var shiftEnd = shift.KetThucDuKien;
                                                                var overlapStart = shiftStart > eventStart ? shiftStart : eventStart;
                                                                var overlapEnd = shiftEnd < eventEnd ? shiftEnd : eventEnd;
                                                                var overlapHours = Math.Max(0.1, (overlapEnd - overlapStart).TotalHours);
                                                                var isFull = overlapStart <= eventStart && overlapEnd >= eventEnd;
                                                                var hasLateGap = overlapEnd < eventEnd;
                                                                var gapHours = Math.Max(0, (eventEnd - overlapEnd).TotalHours);

                                                                var isAssigned = item.PhanCongs.Any(p => p.MaNhanVien == shift.MaNhanVien
                                                                    && p.TrangThaiThamGia is not ("HUY_PHAN_CONG" or "DA_HUY")
                                                                    && HotelEventRules.Overlaps(p.BatDau, p.KetThuc, overlapStart, overlapEnd));

                                                                // Quét tìm ca tiếp theo
                                                                var nextCandidates = Model.DanhSachPhanCa
                                                                    .Where(s => s.TrangThai != "DA_HUY" && s.TrangThai != "VANG_MAT" && s.NhanVien != null
                                                                        && s.MaNhanVien != shift.MaNhanVien
                                                                        && (HotelEventRules.ResolveDepartmentCode(s.NhanVien) == deptCode
                                                                            || (deptId.HasValue && s.NhanVien.MaPhongBan == deptId))
                                                                        && HotelEventRules.Overlaps(s.BatDauDuKien, s.KetThucDuKien, overlapEnd, eventEnd))
                                                                    .OrderBy(s => s.BatDauDuKien)
                                                                    .ToList();

                                                                <tr>
                                                                    <!-- CỘT 1: NHÂN VIÊN -->
                                                                    <td>
                                                                        <div class="d-flex align-items-center gap-2">
                                                                            <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.7rem;">
                                                                                @GetInitials(shift.NhanVien?.HoTen)
                                                                            </div>
                                                                            <div>
                                                                                <div class="fw-bold text-dark">@(shift.NhanVien?.HoTen ?? $"NV #{shift.MaNhanVien}")</div>
                                                                                <div class="text-muted" style="font-size: 0.7rem;">#@shift.MaNhanVien</div>
                                                                            </div>
                                                                        </div>
                                                                    </td>

                                                                    <!-- CỘT 2: CA TRỰC -->
                                                                    <td>
                                                                        <div class="fw-semibold text-dark">@(shift.CaLamViec?.TenCa ?? "Ca trực")</div>
                                                                        <div class="text-muted" style="font-size: 0.72rem;">
                                                                            @HotelEventRules.Local(shiftStart).ToString("HH:mm")–@HotelEventRules.Local(shiftEnd).ToString("HH:mm")
                                                                        </div>
                                                                    </td>

                                                                    <!-- CỘT 3: ĐỘ PHỦ GIỜ TRỰC SỰ KIỆN -->
                                                                    <td>
                                                                        @if (isFull)
                                                                        {
                                                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                                                                <i class="bi bi-check-circle-fill me-1"></i>Đủ @overlapHours.ToString("0.#")h
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div>
                                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1">
                                                                                    Trực @overlapHours.ToString("0.#")h (@HotelEventRules.Local(overlapStart).ToString("HH:mm")–@HotelEventRules.Local(overlapEnd).ToString("HH:mm"))
                                                                                </span>
                                                                                @if (hasLateGap)
                                                                                {
                                                                                    <div class="text-danger mt-1 small">
                                                                                        <i class="bi bi-exclamation-circle me-1"></i>Thiếu @gapHours.ToString("0.#")h cuối (@HotelEventRules.Local(overlapEnd).ToString("HH:mm")–@HotelEventRules.Local(eventEnd).ToString("HH:mm"))
                                                                                    </div>
                                                                                }
                                                                                else if (overlapStart > eventStart)
                                                                                {
                                                                                    <div class="text-secondary mt-1 small">
                                                                                        Vào ca từ @HotelEventRules.Local(overlapStart).ToString("HH:mm")
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </td>

                                                                    <!-- CỘT 4: BÀN GIAO NỐI CA -->
                                                                    <td>
                                                                        @if (!hasLateGap)
                                                                        {
                                                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small">
                                                                                <i class="bi bi-check2 me-1"></i>Trực đến hết sự kiện
                                                                            </span>
                                                                        }
                                                                        else if (nextCandidates.Count > 0)
                                                                        {
                                                                            var nextStaff = nextCandidates.First();
                                                                            <div class="d-flex align-items-center gap-2 flex-nowrap">
                                                                                <span class="badge bg-info-subtle text-dark border rounded-pill px-2.5 py-1" style="font-size: 0.76rem;">
                                                                                    <i class="bi bi-arrow-right text-primary me-1"></i>Nối: <strong>@(nextStaff.NhanVien?.HoTen ?? $"NV #{nextStaff.MaNhanVien}")</strong>
                                                                                    <span class="text-secondary ms-1">(@HotelEventRules.Local(nextStaff.BatDauDuKien).ToString("HH:mm")–@HotelEventRules.Local(nextStaff.KetThucDuKien).ToString("HH:mm"))</span>
                                                                                </span>
                                                                                <a asp-controller="SuKien" asp-action="Details" asp-route-id="@item.MaDuAn" asp-route-tab="staff"
                                                                                   class="btn btn-xs btn-outline-success rounded-pill px-2.5 py-0.5 fw-bold text-nowrap"
                                                                                   title="Gán nhân sự nối ca này vào sự kiện">
                                                                                    Nối ca
                                                                                </a>
                                                                            </div>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="d-flex align-items-center gap-2 flex-nowrap">
                                                                                <span class="text-danger small fw-semibold text-nowrap">
                                                                                    <i class="bi bi-exclamation-circle me-1"></i>Chưa có ca nối
                                                                                </span>
                                                                                <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2.5 py-0.5 fw-bold text-nowrap"
                                                                                        onclick="handleEventDemandAddShift('modalEventDemand_@item.MaDuAn', @(deptId.HasValue ? deptId.Value.ToString() : "null"), '@eventDateStr', '', '@item.TenDuAn.Replace("'", "\\'")', '@deptName.Replace("'", "\\'")')"
                                                                                        title="Lập ca làm việc tiếp theo">
                                                                                    + Tạo ca
                                                                                </button>
                                                                            </div>
                                                                        }
                                                                    </td>

                                                                    <!-- CỘT 5: THAO TÁC -->
                                                                    <td class="text-center">
                                                                        @if (isAssigned)
                                                                        {
                                                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small text-nowrap">
                                                                                <i class="bi bi-check2"></i> Đã gán
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <a asp-controller="SuKien" asp-action="Details" asp-route-id="@item.MaDuAn" asp-route-tab="staff"
                                                                               class="btn btn-xs btn-primary rounded-pill px-3 py-1 fw-bold shadow-xs text-nowrap d-inline-flex align-items-center gap-1"
                                                                               title="Gán nhân viên này vào sự kiện">
                                                                                <i class="bi bi-plus-lg"></i>
                                                                                <span>Gán SK</span>
                                                                            </a>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>

                            <!-- =========================================================================
                                 TAB 2: DANH SÁCH NHÂN SỰ ĐÃ GÁN
                                 ========================================================================= -->
                            <div class="tab-pane fade" id="content-assigned-staff-@item.MaDuAn" role="tabpanel">
                                @if (activeCount == 0)
                                {
                                    <div class="p-4 bg-white rounded-3 border text-muted small text-center">
                                        <i class="bi bi-person-x fs-3 text-secondary mb-1 d-block"></i>
                                        Chưa có nhân sự nào được phân công chính thức vào sự kiện này.
                                        <div class="mt-2">
                                            <a asp-controller="SuKien" asp-action="Details" asp-route-id="@item.MaDuAn" asp-route-tab="staff"
                                               class="btn btn-sm btn-hotel-primary rounded-pill px-3 py-1 fw-bold">
                                                <i class="bi bi-person-plus-fill me-1 text-warning"></i> Mở Form Phân Công Sự Kiện
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive rounded-3 border bg-white" style="max-height: 380px; overflow-y: auto;">
                                        <table class="table table-hover align-middle mb-0 event-compact-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Nhân Viên</th>
                                                    <th scope="col">Vai Trò</th>
                                                    <th scope="col">Thời Gian</th>
                                                    <th scope="col">Thời Lượng</th>
                                                    <th scope="col">Trạng Thái</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in activeAssignments.OrderBy(a => a.BatDau).ThenBy(a => a.NhanVien?.HoTen))
                                                {
                                                    var pDuration = Math.Max(0.1, (p.KetThuc - p.BatDau).TotalHours);
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.7rem;">
                                                                    @GetInitials(p.NhanVien?.HoTen)
                                                                </div>
                                                                <div>
                                                                    <div class="fw-bold text-dark">@(p.NhanVien?.HoTen ?? $"NV #{p.MaNhanVien}")</div>
                                                                    <div class="text-muted" style="font-size: 0.7rem;">#@p.MaNhanVien</div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-light text-dark border rounded-pill px-2 py-0.5">
                                                                @p.VaiTroDuAn
                                                            </span>
                                                        </td>
                                                        <td>
                                                            @HotelEventRules.Local(p.BatDau).ToString("dd/MM HH:mm") – @HotelEventRules.Local(p.KetThuc).ToString("HH:mm")
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2 py-0.5">
                                                                @pDuration.ToString("0.#")h
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5">
                                                                @(p.TrangThaiThamGia == "DA_PHAN" ? "Đang gán" : p.TrangThaiThamGia)
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- FOOTER MODAL POPUP -->
                    <div class="modal-footer bg-white border-top p-2.5 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <button type="button" class="btn btn-light btn-sm rounded-pill px-3 border" data-bs-dismiss="modal">
                            Đóng
                        </button>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-hotel-secondary btn-sm rounded-pill px-3 py-1.5 fw-bold shadow-xs"
                                    onclick="handleEventDemandAddShift('modalEventDemand_@item.MaDuAn', null, '@eventDateStr', '', '@item.TenDuAn.Replace("'", "\\'")', '')">
                                <i class="bi bi-calendar-plus me-1 text-primary"></i> Lập Ca Ngày @eventDateFormatted
                            </button>
                            <a class="btn btn-hotel-primary btn-sm rounded-pill px-3.5 py-1.5 fw-bold shadow-xs d-inline-flex align-items-center gap-1.5"
                               asp-controller="SuKien" asp-action="Details" asp-route-id="@item.MaDuAn" asp-route-tab="staff">
                                <i class="bi bi-box-arrow-up-right text-warning"></i>
                                <span>Phân Hệ Sự Kiện</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

<!-- JAVASCRIPT ĐIỀU KHIỂN & TỰ ĐỘNG CHUYỂN MODAL RA DOCUMENT.BODY ĐỂ TRIỆT TIÊU LỖI MỜ ĐEN (STACKING CONTEXT) -->
<script>
    (function () {
        // Hàm chuyển toàn bộ Modal sự kiện ra ngoài document.body để không bị kẹt sau backdrop
        function teleportEventModalsToBody() {
            const modals = document.querySelectorAll('[data-event-demand-modal="true"]');
            modals.forEach(function (m) {
                if (m.parentElement !== document.body) {
                    const id = m.id;
                    if (id) {
                        const existing = document.querySelector('body > #' + id);
                        if (existing && existing !== m) {
                            existing.remove();
                        }
                    }
                    document.body.appendChild(m);
                }
            });
        }

        teleportEventModalsToBody();
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', teleportEventModalsToBody);
        }

        window.openEventDemandModal = function (eventId) {
            teleportEventModalsToBody();
            const modalEl = document.getElementById('modalEventDemand_' + eventId);
            if (!modalEl) {
                console.warn('Không tìm thấy modal sự kiện #' + eventId);
                return;
            }
            if (modalEl.parentElement !== document.body) {
                document.body.appendChild(modalEl);
            }
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();
        };

        window.handleEventDemandAddShift = function (modalId, deptId, dateStr, roleName, eventTitle, deptName) {
            const modalEl = document.getElementById(modalId);
            if (modalEl) {
                const inst = bootstrap.Modal.getInstance(modalEl);
                if (inst) inst.hide();
            }
            setTimeout(function () {
                if (typeof openCreateShiftForEventDemand === 'function') {
                    openCreateShiftForEventDemand(deptId, dateStr, roleName, eventTitle, deptName);
                }
            }, 250);
        };
    })();
</script>
