    .event-list-table td {
        padding: 0.85rem 0.95rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }
    .event-list-table tr.event-row-clickable {
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .event-list-table tr.event-row-clickable:hover {
        background-color: rgba(30, 58, 138, 0.04) !important;
    }

    /* ĐẢM BẢO MODAL SỰ KIỆN LUÔN NẰM TRÊN LỚP MỜ BACKDROP (CHỐNG TREO MỜ ĐEN) */
