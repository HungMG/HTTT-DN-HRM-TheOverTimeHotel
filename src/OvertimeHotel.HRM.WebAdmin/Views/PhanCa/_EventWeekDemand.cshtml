@model PhanCaIndexViewModel
@using OvertimeHotel.HRM.Core.Policies
@{
    var weekFrom = HotelEventRules.ToUtc(Model.WeekStart.ToDateTime(TimeOnly.MinValue));
    var weekTo = HotelEventRules.ToUtc(Model.WeekStart.AddDays(7).ToDateTime(TimeOnly.MinValue));

    // Thống kê KPI tổng hợp toàn tuần
    var totalEvents = Model.EventDemand.Count;
    var totalNeeds = Model.EventDemand.Sum(e => e.NhuCaus.Count);
    var totalTargetStaff = Model.EventDemand.Sum(e => e.NhuCaus.Sum(n => n.SoNguoi));

    var totalConfirmedStaff = 0;
    var totalMissingStaff = 0;
    var totalForecastShifts = 0;

    foreach (var ev in Model.EventDemand)
    {
        var eFrom = ev.NgayBatDau > weekFrom ? ev.NgayBatDau : weekFrom;
        var eventEnd = ev.KetThucThucTe is { } actualEnd && actualEnd < ev.NgayKetThuc ? actualEnd : ev.NgayKetThuc;
        var eTo = eventEnd < weekTo ? eventEnd : weekTo;
        foreach (var n in ev.NhuCaus)
        {
            var asgns = ev.PhanCongs.Where(p => p.TrangThaiThamGia is not ("HUY_PHAN_CONG" or "DA_HUY")
                && (p.MaPhongBanSuKien ?? HotelEventRules.ResolveDepartmentCode(p.NhanVien)) == n.MaPhongBan
                && HotelEventRoleRules.Matches(n.VaiTro, p.VaiTroDuAn)).ToList();
            var conf = HotelEventRoleRules.MinimumConcurrentCount(asgns, eFrom, eTo);
            totalConfirmedStaff += conf;
            totalMissingStaff += Math.Max(0, n.SoNguoi - conf);

            var dShifts = Model.DanhSachPhanCa.Where(s => s.TrangThai != "DA_HUY" && s.TrangThai != "VANG_MAT" && s.NhanVien != null && HotelEventRules.ResolveDepartmentCode(s.NhanVien) == n.MaPhongBan)
                .Select(s => new OvertimeHotel.HRM.Core.Models.PhanCongDuAn { MaNhanVien = s.MaNhanVien, BatDau = s.BatDauDuKien, KetThuc = s.KetThucDuKien });
            totalForecastShifts += HotelEventRoleRules.MinimumConcurrentCount(dShifts, eFrom, eTo);
        }
    }

    string GetDeptIcon(string code) => code switch
    {
        "TIEN_SANH" => "bi-building",
        "AM_THUC" => "bi-cup-straw",
        "BEP" => "bi-fire",
        "BUONG_PHONG" => "bi-door-closed",
        "KY_THUAT" => "bi-gear-wide-connected",
        "AN_NINH" => "bi-shield-check",
        "IT" => "bi-pc-display",
        _ => "bi-people"
    };

    string GetDeptBadgeClass(string code) => code switch
    {
        "TIEN_SANH" => "bg-primary-subtle text-primary border border-primary-subtle",
        "AM_THUC" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "BEP" => "bg-danger-subtle text-danger border border-danger-subtle",
        "BUONG_PHONG" => "bg-info-subtle text-info-emphasis border border-info-subtle",
        "KY_THUAT" => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
        "AN_NINH" => "bg-dark-subtle text-dark border border-dark-subtle",
        "IT" => "bg-primary-subtle text-purple border border-purple-subtle",
        _ => "bg-light text-dark border"
    };

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NV";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpper() : parts[0].ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
}

<style>
    .event-demand-hub {
        border-radius: 1.15rem;
    }
    .event-kpi-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
