                                    <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3" style="width: 40px;">#</th>
                                                <th>Họ & Tên</th>
                                                <th>Mã NV</th>
                                                <th>Phòng Ban</th>
                                                <th>Chức Vụ</th>
                                                <th class="text-end pe-3">Trạng Thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                    `;

                    g.items.forEach((item, idx) => {
                        html += `
                            <tr>
                                <td class="ps-3 text-muted fw-semibold">${idx + 1}</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                            ${(item.empName ? item.empName.charAt(0) : 'N')}
                                        </div>
                                        <strong class="text-dark">${item.empName || ('NV #' + item.empId)}</strong>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border font-monospace">${item.empCode || ('#' + item.empId)}</span></td>
                                <td><span class="text-secondary">${item.deptName || '—'}</span></td>
                                <td><span class="text-muted">${item.chucVu || '—'}</span></td>
                                <td class="text-end pe-3">
                                    <span class="badge bg-success-subtle text-success border rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i>Đã phân ca
                                    </span>
                                </td>
                            </tr>
                        `;
                    });

                    html += `
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    `;
                });

                shiftsListEl.innerHTML = html;
            }
        }

        const modalEl = document.getElementById('modalDayRoster');
        if (modalEl) {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function openCreateShiftForDate() {
        const rosterModalEl = document.getElementById('modalDayRoster');
        if (rosterModalEl) {
            const rosterModal = bootstrap.Modal.getInstance(rosterModalEl);
            if (rosterModal) rosterModal.hide();
        }

        if (currentRosterDate) {
            selectModalDateSingle(currentRosterDate);
        }

        const createModalEl = document.getElementById('modalCreatePhanCa');
        if (createModalEl) {
            const createModal = new bootstrap.Modal(createModalEl);
            createModal.show();
        }
    }

    // Mở modal xếp ca nhanh khi click vào ô trống trong Ma trận
    function openQuickAssignModal(maNhanVien, dateStr, maCa) {
        selectModalDateSingle(dateStr);

        if (maCa) {
            selectModalShift(maCa);
        }

        document.querySelectorAll('.modal-emp-chk').forEach(chk => chk.checked = false);
        if (maNhanVien) {
            const targetChk = document.querySelector('.modal-emp-chk[value="' + maNhanVien + '"]');
            if (targetChk) targetChk.checked = true;
        }

        updateModalSelectedCount();

        const modal = bootstrap.Modal.getInstance(document.getElementById('modalCreatePhanCa'))
            || new bootstrap.Modal(document.getElementById('modalCreatePhanCa'));
        modal.show();
    }

    // Mở modal lập lịch chi tiết để phân ca đáp ứng Nhu cầu sự kiện
    function openCreateShiftForEventDemand(deptId, dateStr, roleName, eventTitle, deptName) {
        if (!dateStr) {
            dateStr = TODAY_STR;
        }

        if (dateStr < TODAY_STR) {
            showQuickToast('⚠️ Sự kiện đã diễn ra trong quá khứ (' + dateStr + '). Vui lòng chọn ngày hiện tại hoặc tương lai để xếp ca.');
            return;
        }

        // 1. Chuyển tháng bộ lịch modal nếu sự kiện nằm ở tháng khác
        const parts = dateStr.split('-');
        if (parts.length === 3) {
            const yr = parseInt(parts[0], 10);
            const mo = parseInt(parts[1], 10);
            if (!isNaN(yr) && !isNaN(mo) && (yr !== modalCalYear || mo !== modalCalMonth)) {
                modalCalYear = yr;
                modalCalMonth = mo;
                renderModalCalendar();
            }
        }

        // 2. Chọn ngày sự kiện
        selectModalDateSingle(dateStr);

        // 3. Lọc theo phòng ban tương ứng
        const deptSelect = document.getElementById('modalDeptFilter');
        if (deptSelect) {
            deptSelect.value = deptId ? deptId.toString() : '';
        }

        // 4. Lọc nhân sự chưa có ca để ưu tiên hiển thị nhân sự sẵn sàng
        filterModalEmpByShiftStatus('free');

        // 5. Gợi ý lý do/công việc trong ghi chú OT nếu có
        const ghiChuOt = document.getElementById('modalGhiChuOt');
        if (ghiChuOt && eventTitle) {
            ghiChuOt.value = 'Sự kiện: ' + eventTitle + (roleName ? (' - ' + roleName) : '');
        }

        // 6. Mở modal phân ca
        const modalEl = document.getElementById('modalCreatePhanCa');
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.show();
        }

        const msg = '✨ Đã mở lưới phân ca ngày ' + dateStr + (deptName ? (' cho ' + deptName) : '') + (eventTitle ? (' phục vụ sự kiện "' + eventTitle + '"') : '');
        showQuickToast(msg);
    }
    window.openCreateShiftForEventDemand = openCreateShiftForEventDemand;

    // =========================================================================
    // ⚡ CỤM CÔNG CỤ THÊM NHANH CÁC CA TRỰC TIẾP TRÊN LỊCH MA TRẬN (IN-PLACE AJAX)
    // =========================================================================
    let currentQuickShiftId = null; // null: Chế độ xem an toàn, 1: Sáng, 2: Chiều, 3: Đêm, 0: Xóa ca
    let currentQuickShiftName = '';
    let currentQuickShiftHours = '';

    function setQuickShiftMode(caId, btnElement) {
        // Cơ chế Toggle: nếu bấm lại vào chính ca đang chọn thì tắt về Chế độ Xem An Toàn (null)
        if (caId !== null && currentQuickShiftId === caId) {
            caId = null;
            btnElement = document.getElementById('btnQuickModeSafe');
        }

        currentQuickShiftId = caId;

        document.querySelectorAll('.quick-palette-btn').forEach(btn => {
            btn.classList.remove('active-palette-btn', 'btn-primary');
            btn.classList.add('btn-light');
        });

        if (btnElement) {
            btnElement.classList.remove('btn-light');
            btnElement.classList.add('active-palette-btn');
            currentQuickShiftName = btnElement.getAttribute('data-ten-ca') || '';
            currentQuickShiftHours = btnElement.getAttribute('data-gio') || '';
        } else if (caId === null) {
            const safeBtn = document.getElementById('btnQuickModeSafe');
            if (safeBtn) {
                safeBtn.classList.remove('btn-light');
                safeBtn.classList.add('active-palette-btn');
            }
        }

        const badge = document.getElementById('quickModeStatusBadge');
        if (badge) {
            if (caId === null) {
                badge.className = 'badge bg-light text-secondary border rounded-pill px-3 py-1 small';
                badge.innerHTML = '<i class="bi bi-shield-check text-success me-1"></i> Đang ở Chế độ xem &bull; Chọn một ca nếu muốn gán nhanh';
            } else if (caId === 0) {
                badge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 small';
                badge.innerHTML = '<i class="bi bi-eraser-fill me-1"></i> Chế độ: <strong>Xóa ca</strong> &bull; Nhấp vào ô ngày để hủy ca (Bấm lại để tắt)';
            } else {
                badge.className = 'badge bg-primary-subtle text-primary border rounded-pill px-3 py-1 small';
                badge.innerHTML = `<i class="bi bi-lightning-charge-fill text-warning me-1"></i> Đang chọn: <strong>${currentQuickShiftName}</strong> &bull; Nhấp vào ô lịch để gán (Bấm lại để tắt)`;
            }
        }
    }

    function handleCellClick(e, maNhanVien, ngayLamViec, hoTen, cellId) {
        if (e) {
            e.stopPropagation();
        }

        const cellEl = document.getElementById(cellId);
        if (cellEl && cellEl.getAttribute('data-can-assign') === 'false') {
            const reason = cellEl.getAttribute('data-disabled-reason') || 'Nhân viên không có hợp đồng lao động có hiệu lực vào ngày này.';
            showQuickToast('⚠️ ' + reason);
            return;
        }

        if (ngayLamViec < TODAY_STR) {
            showQuickToast('⚠️ Không thể phân ca hoặc sửa ca cho ngày trong quá khứ (' + ngayLamViec + ').');
            return;
        }

        // Chống bấm nhầm: Nếu đang ở Chế độ xem an toàn (chưa kích hoạt ca nào)
        if (currentQuickShiftId === null) {
            // Không liệt kê tên ca cụ thể: danh mục ca thêm/bớt được, câu nhắc
            // cố định "Sáng/Chiều/Đêm" sẽ sai ngay khi có ca mới.
            showQuickToast(`💡 Đang ở Chế độ xem an toàn. Vui lòng chọn một ca ở thanh trên nếu muốn gán nhanh.`);
            return;
        }

        executeQuickAssign(maNhanVien, ngayLamViec, currentQuickShiftId, cellId, hoTen);
    }

    function confirmShiftCancellation(form) {
        const reason = prompt('Lý do hủy ca (tối đa 500 ký tự). Phân công sự kiện từ ca này cần xác nhận lại:');
        if (!reason?.trim() || reason.trim().length > 500) return false;
        form.elements.changeReason.value = reason.trim();
        return true;
    }

    function executeQuickAssign(maNhanVien, ngayLamViec, maCa, cellId, hoTen) {
        if (ngayLamViec < TODAY_STR) {
            showQuickToast('⚠️ Không thể phân ca hoặc sửa ca cho ngày trong quá khứ (' + ngayLamViec + ').');
            return;
        }

        const targetCell = document.getElementById(cellId);
        if (!targetCell) return;

        let changeReason = '';
        if (maCa <= 0 || WEEK_SHIFTS_DATA.some(s => s.empId === maNhanVien && s.date === ngayLamViec)) {
            changeReason = prompt('Lý do hủy / đổi ca (tối đa 500 ký tự). Phân công sự kiện từ ca này cần xác nhận lại:');
            if (!changeReason?.trim()) return;
            changeReason = changeReason.trim();
            if (changeReason.length > 500) { showQuickToast('Lý do tối đa 500 ký tự.'); return; }
        }
        const originalContent = targetCell.innerHTML;
        targetCell.innerHTML = `
            <div class="d-flex align-items-center justify-content-center py-3">
                <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
            </div>`;

        fetch('/PhanCa/QuickAssignAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({
                maNhanVien: maNhanVien,
                ngayLamViec: ngayLamViec,
                maCa: maCa,
                changeReason: changeReason
            })
        })
        .then(res => res.json())
        .then(data => {
            if (!data.success) {
                showQuickToast('⚠️ ' + (data.message || 'Lỗi khi cập nhật ca trực.'));
                targetCell.innerHTML = originalContent;
                return;
            }

            const publicationWarning = document.querySelector('[data-week-publication-warning]');
            if (publicationWarning) publicationWarning.hidden = false;
            if (data.action === 'removed') {
                targetCell.innerHTML = `
                    <button type="button" class="btn-quick-slot"
                            onclick="event.stopPropagation(); handleCellClick(event, ${maNhanVien}, '${ngayLamViec}', '${hoTen}', '${cellId}')"
                            title="Bấm để gán ca nhanh cho ${hoTen}">
                        <i class="bi bi-plus-lg"></i>
                    </button>`;

                const idx = WEEK_SHIFTS_DATA.findIndex(s => s.empId === maNhanVien && s.date === ngayLamViec);
                if (idx >= 0) WEEK_SHIFTS_DATA.splice(idx, 1);
                syncModalShiftCache(maNhanVien, ngayLamViec, null);
                showQuickToast(`Đã xóa ca trực của ${hoTen} ngày ${ngayLamViec}`);
            } else {
                const kind = data.sacThai || 'morning';
                const isNight = kind === 'night';
                const pillClass = kind === 'office' ? 'shift-pill-office'
                    : isNight ? 'shift-pill-night'
                    : (kind === 'afternoon' ? 'shift-pill-afternoon' : 'shift-pill-morning');
                // Chỉ lấy tên icon: màu đã do .shift-pill-* quyết định, thêm
                // text-warning/text-primary vào đây sẽ đè màu chữ của cả ô.
                const iconClass = kind === 'office' ? 'bi-briefcase-fill'
                    : isNight ? 'bi-moon-stars-fill'
                    : (kind === 'afternoon' ? 'bi-cloud-sun-fill' : 'bi-brightness-high-fill');
                const shortTenCa = (data.tenCa && data.tenCa.includes('(')) ? data.tenCa.split('(')[0].trim() : data.tenCa;

                targetCell.innerHTML = `
                    <div class="shift-pill ${pillClass} mb-1 position-relative text-start shadow-sm in-place-enter kpi-pulse-active"
                         data-ca-id="${data.maCa}">
                        <div class="d-flex align-items-center justify-content-between mb-1 gap-1">
                            <strong class="d-inline-flex align-items-center gap-1 text-truncate" style="min-width: 0; font-size: 0.72rem;" title="${data.tenCa}">
                                <i class="bi ${iconClass} flex-shrink-0"></i>
                                <span class="text-truncate">${shortTenCa}</span>
                            </strong>
                            <button type="button" class="btn btn-link text-muted p-0 border-0 flex-shrink-0 shift-delete-btn"
                                    onclick="event.stopPropagation(); executeQuickAssign(${maNhanVien}, '${ngayLamViec}', 0, '${cellId}', '${hoTen}')"
                                    title="Xóa ca này">
                                <i class="bi bi-x-circle-fill text-danger text-opacity-75"></i>
                            </button>
                        </div>
                        <div class="small opacity-85 font-monospace" style="font-size: 0.65rem;">
                            ${data.gioBatDau} - ${data.gioKetThuc}
                        </div>
                        ${isNight ? '<span class="badge bg-warning text-dark px-1 mt-1" style="font-size: 0.55rem;">+30% đêm</span>' : ''}
                        ${data.coTangCa ? `<span class="badge bg-danger text-white border border-danger px-1.5 py-0.5 mt-1 ms-1 fw-bold" style="font-size: 0.7rem; line-height: 1.1;" title="Tăng ca: +${data.gioTangCaDuKien}h. ${data.ghiChuOt || ''}"><i class="bi bi-clock-history"></i> +${data.gioTangCaDuKien}h OT</span>` : ''}
                    </div>`;

                const existingIdx = WEEK_SHIFTS_DATA.findIndex(s => s.empId === maNhanVien && s.date === ngayLamViec);
                const shiftObj = {
                    empId: maNhanVien,
                    date: ngayLamViec,
                    maCa: data.maCa,
                    tenCa: data.tenCa,
                    time: `${data.gioBatDau} - ${data.gioKetThuc}`,
                    gioBatDau: data.gioBatDau,
                    gioKetThuc: data.gioKetThuc,
                    // quaDem là dữ liệu của ca, không phải kết luận "có phụ cấp đêm
                    // hay không". Trước đây gán bằng isNight nên ca qua đêm không
                    // tên "Đêm" bị mất cờ này.
                    quaDem: !!data.quaDem,
                    sacThai: kind,
                    empName: hoTen,
                    empCode: 'NV-' + maNhanVien
                };
                if (existingIdx >= 0) {
                    WEEK_SHIFTS_DATA[existingIdx] = shiftObj;
                } else {
                    WEEK_SHIFTS_DATA.push(shiftObj);
                }
                syncModalShiftCache(maNhanVien, ngayLamViec, shiftObj);

                setTimeout(() => {
                    const p = targetCell.querySelector('.kpi-pulse-active');
                    if (p) p.classList.remove('kpi-pulse-active');
                }, 600);

                showQuickToast(`✓ Đã gán ${shortTenCa} cho ${hoTen} ngày ${ngayLamViec}`);
            }

            updateUnassignedCountBadge();
        })
        .catch(err => {
            console.error('Lỗi khi gán ca trực tiếp:', err);
            targetCell.innerHTML = originalContent;
            alert('Lỗi kết nối khi gán ca: ' + err.message);
        });
    }

    function updateUnassignedCountBadge() {
        const badge = document.getElementById('unassignedWarningBadge');
        if (!badge) return;

        const totalEmp = @Model.TongNhanVien;
        const totalRequiredSlots = totalEmp * 7;
        const currentAssigned = WEEK_SHIFTS_DATA.length;
        const remaining = totalRequiredSlots - currentAssigned;

        if (remaining > 0) {
            badge.innerHTML = `
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill fw-semibold" style="font-size: 0.72rem;">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> ${remaining} vị trí chưa xếp
                </span>`;
        } else {
            badge.innerHTML = `
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-semibold" style="font-size: 0.72rem;">
                    <i class="bi bi-check-circle-fill text-success me-1"></i> Đã phủ kín 100%
                </span>`;
        }
    }

    function showQuickToast(msg) {
        let toast = document.getElementById('quickShiftToast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'quickShiftToast';
            toast.className = 'position-fixed top-0 end-0 p-3';
            toast.style.zIndex = '1090';
            toast.style.marginTop = '72px';
            toast.style.minWidth = '460px';
            toast.style.maxWidth = '560px';
            toast.innerHTML = `
                <div id="quickToastCard" class="toast align-items-center text-white bg-dark border-0 shadow-lg rounded-4" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body fw-semibold d-flex align-items-center gap-3" style="font-size: 1rem; line-height: 1.45; padding: 1.1rem 1.2rem;">
                            <i class="bi bi-check2-circle text-warning" style="font-size: 1.6rem;"></i>
                            <span id="quickToastMsg"></span>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-3 ms-2 m-auto" data-bs-dismiss="toast" aria-label="Close" style="font-size: 1.1rem;"></button>
                    </div>
                </div>`;
            document.body.appendChild(toast);
        }
        document.getElementById('quickToastMsg').textContent = msg;
        const toastEl = document.getElementById('quickToastCard');
        if (window.bootstrap && bootstrap.Toast) {
            const bsToast = new bootstrap.Toast(toastEl, { delay: 3500 });
            bsToast.show();
        }
    }

    /* =========================================================================
       CẤU HÌNH ĐỊNH BIÊN CA (PRD 3.5)
       Hai chế độ trên cùng một lưới:
         * "nen"  — mức chung mọi ngày, ghi vào dinh_bien_ca
         * "ngay" — mức riêng của ngày đang xem, ghi vào dinh_bien_ngay
       Lưới chỉ hiển thị một chế độ tại một thời điểm, và chỉ những ô người dùng
       thực sự sửa mới được gửi lên — nếu gửi cả lưới ở chế độ "ngay" thì mọi ô
       kế thừa từ mức nền sẽ bị biến thành dòng đè, làm mất tính "chỉ ghi phần lệch".
       ========================================================================= */
    let dinhBienMode = 'nen';
    let currentDinhBienDate = '@Model.DinhBien.Ngay.ToString("yyyy-MM-dd")';

    function dinhBienOriginalValue(input) {
        // Ở chế độ ngày, ô chưa có dòng riêng hiển thị số của mức nền — đó là giá
        // trị gốc để so sánh, không phải 0.
        const mucNen = parseInt(input.dataset.mucNen || '0', 10);
        const mucNgay = parseInt(input.dataset.mucNgay || '0', 10);
        return dinhBienMode === 'nen' ? mucNen : (mucNgay > 0 ? mucNgay : mucNen);
    }

    function renderDinhBienGrid() {
        document.querySelectorAll('.dinh-bien-input').forEach(function (input) {
            input.value = dinhBienOriginalValue(input) || '';
        });
        updateDinhBienFooter();
    }

    function updateDinhBienFooter() {
        const btnSaveText = document.getElementById('btnSaveDinhBienText');
        const footerSummary = document.getElementById('dinhBienFooterSummary');
        const form = document.getElementById('formDinhBien');
        const dateStr = form ? form.dataset.ngay : currentDinhBienDate;

        if (dinhBienMode === 'nen') {
            if (btnSaveText) btnSaveText.textContent = 'Lưu định biên chung (Mọi ngày)';
            if (footerSummary) footerSummary.innerHTML = '<i class="bi bi-info-circle text-primary me-1"></i>Đang ở chế độ <strong>Mức Chuẩn Chung</strong> — áp dụng cho tất cả các ngày bình thường.';
        } else {
            const formattedDate = dateStr ? dateStr.split('-').reverse().join('/') : '';
            if (btnSaveText) btnSaveText.textContent = 'Lưu định biên ngày ' + formattedDate;
            if (footerSummary) footerSummary.innerHTML = '<i class="bi bi-calendar-check text-warning me-1"></i>Đang ở chế độ <strong>Mức Riêng Ngày ' + formattedDate + '</strong> — chỉ lưu phần chênh lệch so với mức chuẩn.';
        }
    }

    function switchDinhBienMode(mode, btn) {
        dinhBienMode = mode;
        document.querySelectorAll('.dinh-bien-mode-btn').forEach(function (b) {
            const isActive = b.dataset.mode === mode;
            b.classList.toggle('active', isActive);
            b.classList.toggle('btn-light', !isActive);
        });

        const weekContainer = document.getElementById('dinhBienWeekDaysContainer');
        if (weekContainer) {
            if (mode === 'ngay') {
                weekContainer.classList.remove('d-none');
            } else {
                weekContainer.classList.add('d-none');
            }
        }

        const hint = document.getElementById('dinhBienModeHint');
        if (hint) {
            hint.innerHTML = mode === 'nen'
                ? '<i class="bi bi-info-circle text-primary me-1"></i>Mức chuẩn áp dụng cho tất cả các ngày trong tuần (nhập 0 để bỏ).'
                : '<i class="bi bi-calendar-day text-warning me-1"></i>Áp riêng cho ngày được chọn bên dưới. Các ngày khác giữ mức chuẩn.';
        }

        renderDinhBienGrid();
    }

    async function selectDinhBienDate(dateStr, btnEl) {
        if (!dateStr) return;
        currentDinhBienDate = dateStr;

        const form = document.getElementById('formDinhBien');
        if (form) form.dataset.ngay = dateStr;

        const ngayInput = document.getElementById('inputDinhBienNgay');
        if (ngayInput) ngayInput.value = dateStr;

        const datePicker = document.getElementById('dinhBienCustomDateInput');
        if (datePicker && datePicker.value !== dateStr) datePicker.value = dateStr;

        // Cập nhật active button
        document.querySelectorAll('.dinh-bien-day-btn').forEach(function (btn) {
            const isMatch = btn.dataset.date === dateStr;
            btn.classList.toggle('btn-primary', isMatch);
            btn.classList.toggle('active', isMatch);
            btn.classList.toggle('shadow-xs', isMatch);
            btn.classList.toggle('btn-outline-secondary', !isMatch);
        });

        // Hiệu ứng mờ nhẹ trong lúc nạp AJAX
        const table = document.getElementById('tableDinhBienMatrix');
        if (table) table.style.opacity = '0.45';

        try {
            const response = await fetch('/PhanCa/GetDinhBienNgayAjax?ngay=' + encodeURIComponent(dateStr));
            if (!response.ok) throw new Error('Network error');
            const data = await response.json();

            if (data && data.success) {
                const dayOverridesMap = new Map();
                (data.dinhBienNgay || []).forEach(item => {
                    const key = `${item.maCa}_${item.maChucVu}_${item.maPhongBan ?? ''}`;
                    dayOverridesMap.set(key, item.mucNgay);
                });

                const hienCoMap = new Map();
                (data.hienCo || []).forEach(item => {
                    const key = `${item.maCa}_${item.maChucVu}_${item.maPhongBan ?? ''}`;
                    hienCoMap.set(key, item.soLuong);
                });

                document.querySelectorAll('.dinh-bien-input').forEach(function (input) {
                    const key = `${input.dataset.maCa}_${input.dataset.maChucVu}_${input.dataset.maPhongBan ?? ''}`;
                    const mucNgay = dayOverridesMap.has(key) ? dayOverridesMap.get(key) : 0;
                    const hienCo = hienCoMap.has(key) ? hienCoMap.get(key) : 0;

                    input.dataset.mucNgay = mucNgay;
                    input.dataset.coRiengNgay = mucNgay > 0 ? '1' : '0';
                    input.classList.toggle('has-day-override', mucNgay > 0);

                    // Cập nhật badge riêng
                    const container = input.closest('td');
                    if (container) {
                        const badge = container.querySelector('.dinh-bien-day-badge');
                        if (badge) badge.classList.toggle('d-none', mucNgay <= 0);
                        const countSpan = container.querySelector('.dinh-bien-hien-co');
                        if (countSpan) countSpan.textContent = 'có ' + hienCo;
                    }
                });
            }
        } catch (err) {
            console.error('Lỗi khi tải định biên ngày:', err);
        } finally {
            if (table) table.style.opacity = '1';
            renderDinhBienGrid();
        }
    }

    function filterDinhBienDepartment(deptId, btnEl) {
        document.querySelectorAll('.dinh-bien-dept-btn').forEach(function (b) {
            const isMatch = b.dataset.deptId === deptId;
            b.classList.toggle('btn-primary', isMatch);
            b.classList.toggle('active', isMatch);
            b.classList.toggle('shadow-xs', isMatch);
            b.classList.toggle('btn-outline-secondary', !isMatch);
        });

        document.querySelectorAll('.dinh-bien-dept-header-row, .dinh-bien-row').forEach(function (row) {
            const rowDept = row.dataset.deptId;
            if (deptId === 'all' || rowDept === deptId) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function submitDinhBien(event) {
        const container = document.getElementById('dinhBienCellsContainer');
        const form = document.getElementById('formDinhBien');
        if (!container || !form) { return; }

        container.innerHTML = '';
        const ngayInput = document.getElementById('inputDinhBienNgay');
        ngayInput.value = dinhBienMode === 'ngay'
            ? (form.dataset.ngay || currentDinhBienDate || '')
            : '';

        let soOCoThayDoi = 0;
        const maCaHopLe = new Set();
        let chiSo = 0;

        document.querySelectorAll('.dinh-bien-input').forEach(function (input) {
            const giaTriMoi = parseInt(input.value || '0', 10) || 0;
            const giaTriGoc = dinhBienOriginalValue(input);
            if (giaTriMoi === giaTriGoc) { return; }

            const maCa = parseInt(input.dataset.maCa, 10);
            const maChucVu = parseInt(input.dataset.maChucVu, 10);
            // Bộ phận là chiều thứ ba của khoá định biên; rỗng nghĩa là dòng dùng
            // chung mọi bộ phận. Thiếu trường này thì mọi chức danh trải nhiều bộ
            // phận sẽ ghi đè lên nhau ở cùng một dòng.
            const maPhongBan = input.dataset.maPhongBan || '';
            const coRiengNgay = input.dataset.coRiengNgay === '1';
            const mucNen = parseInt(input.dataset.mucNen || '0', 10);

            // Ở chế độ ngày: gõ đúng bằng mức nền nghĩa là "trả ô này về mặc định",
            // tức xoá dòng đè. Gửi 0 để tầng máy chủ xoá thay vì lưu một dòng thừa.
            let soGui = giaTriMoi;
            if (dinhBienMode === 'ngay' && coRiengNgay && giaTriMoi === mucNen) {
                soGui = 0;
            }

            maCaHopLe.add(maCa);
            const prefix = 'Cells[' + chiSo + '].';
            container.insertAdjacentHTML('beforeend',
                '<input type="hidden" name="' + prefix + 'MaCa" value="' + maCa + '" />' +
                '<input type="hidden" name="' + prefix + 'MaChucVu" value="' + maChucVu + '" />' +
                '<input type="hidden" name="' + prefix + 'MaPhongBan" value="' + maPhongBan + '" />' +
                '<input type="hidden" name="' + prefix + 'SoNguoi" value="' + soGui + '" />');
            chiSo++;
            soOCoThayDoi++;
        });

        if (soOCoThayDoi === 0) {
            event.preventDefault();
            showQuickToast('Không có ô nào thay đổi để lưu.');
            return;
        }
    }

    // Khởi tạo & Kích hoạt lần đầu tải trang
    document.addEventListener('DOMContentLoaded', function () {
        const savedMode = localStorage.getItem('overtime_phanca_active_tab') || 'calendar';
        switchViewMode(savedMode);

        // Render bộ lịch tháng tương tác trong modal
        renderModalCalendar();

        // Nạp sẵn lưới định biên ở chế độ mức chung, để lần mở đầu tiên đã đúng số.
        renderDinhBienGrid();

        // Tự động mở popup Quản lý mẫu ca nếu có query openShiftModal=true
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('openShiftModal') === 'true') {
            const shiftModalEl = document.getElementById('modalShiftTemplates');
            if (shiftModalEl) {
                const shiftModal = new bootstrap.Modal(shiftModalEl);
                shiftModal.show();
            }
        }

        // Mở lại popup định biên sau khi lưu (SaveDinhBien chuyển hướng kèm cờ).
        if (urlParams.get('openDinhBienModal') === 'true') {
            const dinhBienModalEl = document.getElementById('modalDinhBien');
            if (dinhBienModalEl) {
                // Chế độ mặc định vẫn là "mức chung"; nếu người dùng vừa lưu mức
                // riêng ngày thì máy chủ đã đưa cờ, nhưng không phân biệt được ở URL
                // nên mở lại ở "mức chung" là lựa chọn an toàn (không sửa nhầm ngày).
                new bootstrap.Modal(dinhBienModalEl).show();
            }
        }

        // Khởi tạo trạng thái ca ngày và số đếm trong modal
        onModalDateChanged();
        updateModalSelectedCount();
    });
</script>

<script id="phancaCalendarDataScript">
    window.phancaCalendarData = {
        year: @Model.Year,
        month: @Model.Month,
        selectedDate: '@Model.SelectedDate.ToString("yyyy-MM-dd")',
        days: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CalendarDays.Select(d => new {
            date = d.Date.ToString("yyyy-MM-dd"),
            // Từ điển MaCa -> số lượt. Giữ khoá số để JS tra thẳng bằng maCa.
            soLuotTheoCa = d.SoLuotTheoCa,
            tong = d.Tong,
            isOtherMonth = d.IsOtherMonth,
            isToday = d.IsToday,
            isWeekend = d.IsWeekend,
            isPast = d.IsPast,
            isSelected = d.IsSelected,
            hasContractIssue = d.HasContractIssue,
            expiredContractCount = d.ExpiredContractCount
        }))),
        shifts: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AllGridPhanCa.Select(p => {
            var avatarColorPalette = new[] { "#1E3A8A", "#D97706", "#059669", "#7C3AED", "#DB2777", "#2563EB", "#0891B2" };
            var color = avatarColorPalette[Math.Abs(p.MaNhanVien.GetHashCode()) % avatarColorPalette.Length];
            var isValidContract = p.NhanVien != null && OvertimeHotel.HRM.Core.Policies.ContractAttendancePolicy.HasValidContractOn(p.NhanVien, p.NgayLamViec);
            return new {
                maPhanCa = p.MaPhanCa,
                maNhanVien = p.MaNhanVien,
                hoTen = p.NhanVien?.HoTen ?? ("NV #" + p.MaNhanVien),
                maNhanVienHienThi = "NV-" + p.MaNhanVien,
                maChucVu = p.NhanVien?.MaChucVu,
                tenChucVu = p.NhanVien?.ChucVu?.TenChucVu ?? "",
                maPhongBan = p.NhanVien?.MaPhongBan ?? p.NhanVien?.ChucVu?.MaPhongBan,
                tenPhongBan = p.NhanVien?.PhongBan?.TenPhongBan ?? p.NhanVien?.ChucVu?.PhongBan?.TenPhongBan ?? "",
                maCa = p.MaCa,
                tenCa = p.CaLamViec?.TenCa ?? ("Ca " + p.MaCa),
                gioBatDau = p.CaLamViec != null ? p.CaLamViec.GioBatDau.ToString("HH:mm") : "",
                gioKetThuc = p.CaLamViec != null ? p.CaLamViec.GioKetThuc.ToString("HH:mm") : "",
                quaDem = p.CaLamViec != null && p.CaLamViec.QuaDem,
                // Sắc thái đi kèm từng lượt ca để modal/nhật ký khỏi dò lại tên ca.
                sacThai = p.CaLamViec != null ? p.CaLamViec.SacThaiCa : "morning",
                ngayLamViec = p.NgayLamViec.ToString("yyyy-MM-dd"),
                avatarColor = color,
                trangThai = p.TrangThai,
                coTangCa = p.CoTangCa,
                gioTangCaDuKien = p.GioTangCaDuKien,
                ghiChuOt = p.GhiChuOt ?? "",
                hasActiveContract = isValidContract,
                disabledReason = !isValidContract ? $"Nhân viên {p.NhanVien?.HoTen} có hợp đồng hết hạn / chưa có hiệu lực vào ngày {p.NgayLamViec:dd/MM/yyyy}." : (string?)null
            };
        }))),
        caList: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachCa.Select(c => new {
            maCa = c.MaCa,
            tenCa = c.TenCa,
            gio = c.GioBatDau.ToString("HH:mm") + " - " + c.GioKetThuc.ToString("HH:mm"),
            // Sắc thái do máy chủ quyết định từ LoaiCa, JS không phải đoán lại
            // từ tên ca (tên do người dùng đặt, đổi được bất cứ lúc nào).
            sacThai = c.SacThaiCa,
            loaiCa = c.LoaiCa,
            quaDem = c.QuaDem,
            gioLamChuan = c.GioLamChuan
        }))),
        dinhBienRules: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DinhBien.Rows
            .Where(r => r.MucNenTheoCa.Any(kv => kv.Value > 0) || r.MucNgayTheoCa.Any(kv => kv.Value > 0))
            .Select(r => new {
                maChucVu = r.MaChucVu,
                tenChucVu = r.TenChucVu,
                maPhongBan = r.MaPhongBan,
                tenPhongBan = r.TenPhongBan,
                mucNenTheoCa = r.MucNenTheoCa,
                mucNgayTheoCa = r.MucNgayTheoCa
            })))
    };
</script>
<script src="~/js/phanca-calendar.js" asp-append-version="true"></script>
}
