<!-- MODAL: CÔNG BỐ LỊCH TUẦN CHÍNH THỨC (HR & ADMIN ONLY) -->
<div class="modal fade" id="modalPublishWeek" tabindex="-1" aria-labelledby="modalPublishWeekLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden modal-luxury-card">
            <form asp-controller="PhanCa" asp-action="PublishWeek" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="version" value="@((Model.PublishedWeek?.Version ?? 0) + 1)" />

                <div class="modal-header bg-white border-bottom py-3 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                             style="width: 44px; height: 44px; font-size: 1.1rem; background: linear-gradient(135deg, #16a34a, #15803d);">
                            <i class="bi bi-send-check-fill text-white"></i>
                        </div>
                        <div>
                            <div class="text-uppercase small fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px; color: #16a34a;">
                                <i class="bi bi-shield-check me-1"></i>Quyền Hạn Phòng Nhân Sự & Quản Trị Viên
                            </div>
                            <h3 class="modal-title h5 mb-0 font-serif fw-bold text-dark" id="modalPublishWeekLabel">
                                @(Model.PublishedWeek != null ? "Cập Nhật Công Bố Lịch Tuần" : "Công Bố Lịch Tuần Chính Thức")
                            </h3>
                            <div class="small text-muted">
                                Tuần: @Model.WeekStart.ToString("dd/MM/yyyy") &mdash; @Model.WeekEnd.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body p-4 bg-light bg-opacity-50">
                    @if (Model.PublishedWeek != null)
                    {
                        <div class="alert alert-info border-0 rounded-3 p-3 mb-3 d-flex align-items-start gap-2 shadow-xs" style="font-size: 0.82rem;">
                            <i class="bi bi-info-circle-fill text-primary fs-6 mt-0.5"></i>
                            <div>
                                <div>Tuần này đã được công bố <strong>Phiên bản @Model.PublishedWeek.Version</strong> vào lúc <strong>@Model.PublishedWeek.NgayCongBo.ToOffset(TimeSpan.FromHours(7)).ToString("HH:mm dd/MM/yyyy")</strong>.</div>
                                <div class="mt-1 text-muted">Công bố lại sẽ nâng lên <strong>Phiên bản @((Model.PublishedWeek.Version) + 1)</strong> và ghi nhận vào nhật ký điều hành ca trực.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success border-0 rounded-3 p-3 mb-3 d-flex align-items-start gap-2 shadow-xs" style="font-size: 0.82rem;">
                            <i class="bi bi-check-circle-fill text-success fs-6 mt-0.5"></i>
                            <div>
