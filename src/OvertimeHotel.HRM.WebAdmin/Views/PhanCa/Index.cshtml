@section Scripts {
<script>
    // =========================================================================
    // ✨ REACT-BITS MOTION & IN-PLACE STATE TRANSITIONS CHO PHÂN CA 24/7
    // =========================================================================

    // 1. Hiệu ứng đếm số CountUp (từ react-bits) khi số liệu KPI cập nhật (hỗ trợ cả tăng và giảm)
    function animateCountUp(element, startValue, targetValue, duration = 450) {
        if (!element) return;
        if (startValue === targetValue) {
            element.textContent = targetValue;
            return;
        }

        const startTime = performance.now();
        element.setAttribute('data-count', targetValue);

        function updateCount(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Easing: easeOutCubic
            const easeProgress = 1 - Math.pow(1 - progress, 3);
            const currentCount = Math.round(startValue + (targetValue - startValue) * easeProgress);

            element.textContent = currentCount;

            if (progress < 1) {
                requestAnimationFrame(updateCount);
            } else {
                element.textContent = targetValue;
            }
        }

        requestAnimationFrame(updateCount);
    }

    // 2. Hiệu ứng phát quang vàng kim (Pulse) lướt nhẹ qua thẻ KPI
    function pulseKpiCards() {
        const items = document.querySelectorAll('.kpi-card-item');
        items.forEach((item, idx) => {
            setTimeout(() => {
                item.classList.add('kpi-pulse-active');
                setTimeout(() => {
                    item.classList.remove('kpi-pulse-active');
                }, 380);
            }, idx * 60);
        });
    }

    // 3. Chuyển đổi giữa 4 chế độ xem với hiệu ứng In-Place Cross-Fade
    function switchViewMode(mode) {
        const matrixContainer = document.getElementById('viewMatrixContainer');
        const timelineContainer = document.getElementById('viewTimelineContainer');
        const todayContainer = document.getElementById('viewTodayContainer');
        const listContainer = document.getElementById('viewListContainer');

        const containers = {
            matrix: matrixContainer,
            timeline: timelineContainer,
            today: todayContainer,
            list: listContainer
        };

        const buttons = {
            matrix: document.getElementById('btnViewMatrix'),
            timeline: document.getElementById('btnViewTimeline'),
            today: document.getElementById('btnViewToday'),
            list: document.getElementById('btnViewList')
        };

        // Cập nhật trạng thái nút bấm
        Object.keys(buttons).forEach(key => {
            const btn = buttons[key];
            if (!btn) return;
            if (key === mode) {
                if (key === 'today') {
                    btn.className = 'btn btn-warning btn-sm rounded-pill fw-bold text-dark px-3 py-1 view-switcher-btn shadow-sm';
                } else {
                    btn.className = 'btn btn-primary btn-sm rounded-pill fw-bold px-3 py-1 view-switcher-btn shadow-sm';
                }
            } else {
                btn.className = 'btn btn-light btn-sm rounded-pill fw-bold px-3 py-1 view-switcher-btn';
            }
        });

        // Kích hoạt hiệu ứng in-place-enter cho khung mục tiêu
        Object.keys(containers).forEach(key => {
            const c = containers[key];
            if (!c) return;
            if (key === mode) {
                c.classList.remove('d-none');
                c.classList.remove('in-place-enter');
                void c.offsetWidth; // Force reflow
                c.classList.add('in-place-enter');
            } else {
                c.classList.add('d-none');
            }
        });

        localStorage.setItem('overtime_phanca_view_mode', mode);
    }

    // 4. Nạp tuần tại chỗ qua AJAX - TUYỆT ĐỐI KHÔNG RELOAD TOÀN TRANG
    function loadWeekInPlace(targetWeekDate) {
        const workspace = document.getElementById('scheduleContentWrapper');
        const kpiSidebar = document.getElementById('kpiSidebarContainer');
        const overlay = document.getElementById('workspaceLoadingOverlay');

        if (overlay) overlay.classList.remove('d-none');

        fetch('/PhanCa?week=' + targetWeekDate, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => {
            if (!response.ok) throw new Error('Không thể nạp dữ liệu');
            return response.text();
        })
        .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            // 1. Cập nhật khung lịch với hiệu ứng in-place-enter
            const newWorkspace = doc.getElementById('scheduleContentWrapper');
            if (newWorkspace && workspace) {
                workspace.innerHTML = newWorkspace.innerHTML;
                workspace.classList.remove('in-place-enter');
                void workspace.offsetWidth; // Force reflow
                workspace.classList.add('in-place-enter');
            }

            // 2. Cập nhật thanh điều hướng tuần
            const newWeekNav = doc.getElementById('weekNavigationWrapper');
            const currWeekNav = document.getElementById('weekNavigationWrapper');
            if (newWeekNav && currWeekNav) {
                currWeekNav.innerHTML = newWeekNav.innerHTML;
            }

            // 3. Cập nhật các con số trong KPI kèm hiệu ứng CountUp & Pulse
            const elTotal = document.getElementById('valTongCa');
            const elSang = document.getElementById('valCaSang');
            const elChieu = document.getElementById('valCaChieu');
            const elDem = document.getElementById('valCaDem');

            const prevTotal = parseInt(elTotal?.textContent) || 0;
            const prevSang = parseInt(elSang?.textContent) || 0;
            const prevChieu = parseInt(elChieu?.textContent) || 0;
            const prevDem = parseInt(elDem?.textContent) || 0;

            const newTotal = parseInt(doc.getElementById('valTongCa')?.textContent) || 0;
            const newSang = parseInt(doc.getElementById('valCaSang')?.textContent) || 0;
            const newChieu = parseInt(doc.getElementById('valCaChieu')?.textContent) || 0;
            const newDem = parseInt(doc.getElementById('valCaDem')?.textContent) || 0;

            if (elTotal) animateCountUp(elTotal, prevTotal, newTotal);
            if (elSang) animateCountUp(elSang, prevSang, newSang);
            if (elChieu) animateCountUp(elChieu, prevChieu, newChieu);
            if (elDem) animateCountUp(elDem, prevDem, newDem);
            pulseKpiCards();

            // 4. Cập nhật URL trình duyệt
            window.history.pushState(null, '', '/PhanCa?week=' + targetWeekDate);

            // 5. Khôi phục chế độ xem và áp dụng bộ lọc
            const currentMode = localStorage.getItem('overtime_phanca_view_mode') || 'matrix';
            switchViewMode(currentMode);
            applyFiltersInPlace();
        })
        .catch(err => {
            console.error('Lỗi nạp tuần tại chỗ:', err);
            window.location.href = '/PhanCa?week=' + targetWeekDate;
        })
        .finally(() => {
            const currentOverlay = document.getElementById('workspaceLoadingOverlay');
            if (currentOverlay) currentOverlay.classList.add('d-none');
        });
    }

    // 5. Chọn ngày trong chế độ xem Timeline 24H với hiệu ứng trượt êm
    function selectTimelineDay(dayIdx, dateStr, dayOfWeekName) {
        document.querySelectorAll('.timeline-day-btn').forEach(btn => {
            btn.className = 'btn btn-sm rounded-pill px-3 timeline-day-btn btn-outline-secondary';
        });

        const activeBtn = document.getElementById('btnTimelineDay-' + dayIdx);
        if (activeBtn) {
            activeBtn.className = 'btn btn-sm rounded-pill px-3 timeline-day-btn btn-primary fw-bold text-white shadow-sm';
        }

        document.querySelectorAll('.timeline-day-panel').forEach(panel => {
            panel.classList.add('d-none');
        });

        const targetPanel = document.getElementById('timelineDayPanel-' + dayIdx);
        if (targetPanel) {
            targetPanel.classList.remove('d-none');
            targetPanel.classList.remove('in-place-enter');
            void targetPanel.offsetWidth; // Force reflow
            targetPanel.classList.add('in-place-enter');
        }

        const label = document.getElementById('timelineSelectedDateLabel');
        if (label) {
            label.textContent = 'Đang xem ngày: ' + dayOfWeekName + ', ' + dateStr + ' (Trục 24 giờ chi tiết)';
        }
    }

    // 6. Thu gọn / Mở rộng nhóm Phòng Ban trong Ma Trận
    function toggleDeptCollapse(deptId) {
        const rows = document.querySelectorAll('.dept-child-' + deptId);
        const icon = document.getElementById('chevron-dept-' + deptId);

        let isCollapsed = false;
        rows.forEach(r => {
            if (r.classList.contains('d-none')) {
                r.classList.remove('d-none');
            } else {
                r.classList.add('d-none');
                isCollapsed = true;
            }
        });

        if (icon) {
            if (isCollapsed) {
                icon.className = 'bi bi-chevron-right text-muted';
            } else {
                icon.className = 'bi bi-chevron-down text-primary';
            }
        }
    }

    // 6b. Thu gọn / Mở rộng nhóm Phòng Ban trong Timeline 24H
    function toggleTimelineDeptCollapse(dayIdx, deptId) {
        const rows = document.querySelectorAll(`.tl-child-${dayIdx}-${deptId}`);
        const icon = document.getElementById(`chevron-tl-${dayIdx}-${deptId}`);

        let isCollapsed = false;
        rows.forEach(r => {
            if (r.classList.contains('d-none')) {
                r.classList.remove('d-none');
            } else {
                r.classList.add('d-none');
                isCollapsed = true;
            }
        });

        if (icon) {
            if (isCollapsed) {
                icon.className = 'bi bi-chevron-right text-muted';
            } else {
                icon.className = 'bi bi-chevron-down text-primary';
            }
        }
    }

    // 7. Lọc tức thì trên CẢ 4 CỤM (Ma Trận, Timeline 24H, Ca Trực Hôm Nay, Danh Sách Chi Tiết)
    function applyFiltersInPlace() {
        const keyword = (document.getElementById('filterKeyword')?.value || '').trim().toLowerCase();
        const pbVal = document.getElementById('filterPhongBan')?.value || '';
        const caVal = document.getElementById('filterCa')?.value || '';

        // ==========================================
        // CỤM 1: MA TRẬN PHÂN CA TUẦN
        // ==========================================
        const matrixRows = document.querySelectorAll('.matrix-emp-row');
        let visibleMatrixEmpCount = 0;
        matrixRows.forEach(row => {
            const rowPb = row.getAttribute('data-phongban-id') || '';
            const rowName = row.getAttribute('data-emp-name') || '';
            const rowId = row.getAttribute('data-emp-id') || '';

            const matchPb = !pbVal || rowPb === pbVal;
            const matchKw = !keyword || rowName.includes(keyword) || rowId.includes(keyword);

            if (matchPb && matchKw) {
                row.classList.remove('d-none');
                visibleMatrixEmpCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        // Ẩn/hiện tiêu đề phòng ban trong Ma Trận nếu tất cả nhân viên bị ẩn
        document.querySelectorAll('.dept-group-header').forEach(header => {
            const deptId = header.getAttribute('data-phongban-id') || '';
            if (deptId) {
                const childRows = document.querySelectorAll('.matrix-emp-row.dept-child-' + deptId);
                const hasVisible = Array.from(childRows).some(r => !r.classList.contains('d-none'));
                header.style.display = hasVisible ? '' : 'none';
            }
        });

        // Lọc thẻ ca trong Ma trận
        const shiftPills = document.querySelectorAll('.shift-pill');
        shiftPills.forEach(pill => {
            const cardCa = pill.getAttribute('data-ca-id');
            const matchCa = !caVal || cardCa === caVal;
            pill.style.display = matchCa ? 'block' : 'none';
        });

        // Hiển thị thông báo rỗng cho Ma Trận nếu không tìm thấy nhân viên
        const matrixEmpty = document.getElementById('matrixEmptyFilterRow');
        if (matrixEmpty) {
            matrixEmpty.classList.toggle('d-none', visibleMatrixEmpCount > 0);
        }

        // ==========================================
        // CỤM 2: TIMELINE 24H
        // ==========================================
        const timelineRows = document.querySelectorAll('.timeline-row');
        timelineRows.forEach(row => {
            const rowPb = row.getAttribute('data-phongban-id') || '';
            const rowName = row.getAttribute('data-emp-name') || '';
            const rowId = row.getAttribute('data-emp-id') || '';

            const matchPb = !pbVal || rowPb === pbVal;
            const matchKw = !keyword || rowName.includes(keyword) || rowId.includes(keyword);

            if (matchPb && matchKw) {
                row.classList.remove('d-none');
            } else {
                row.classList.add('d-none');
            }
        });

        // Ẩn/hiện tiêu đề phòng ban trong Timeline nếu toàn bộ nhân viên bị ẩn
        document.querySelectorAll('.timeline-dept-header').forEach(header => {
            const deptId = header.getAttribute('data-phongban-id') || '';
            if (deptId) {
                const parentPanel = header.closest('.timeline-day-panel');
                if (parentPanel) {
                    const childRows = parentPanel.querySelectorAll(`.timeline-row[data-phongban-id="${deptId}"]`);
                    const hasVisible = Array.from(childRows).some(r => !r.classList.contains('d-none'));
                    header.style.display = hasVisible ? '' : 'none';
                }
            }
        });

        // Lọc thanh ca trực trong Timeline
        const tlShiftBars = document.querySelectorAll('.timeline-shift-bar');
        tlShiftBars.forEach(bar => {
            const barCa = bar.getAttribute('data-ca-id');
            const matchCa = !caVal || !barCa || barCa === caVal;
            bar.style.display = matchCa ? 'flex' : 'none';
        });

        // Hiển thị thông báo rỗng trong Timeline cho từng ngày nếu không có ai
        document.querySelectorAll('.timeline-day-panel').forEach(panel => {
            const visibleRows = panel.querySelectorAll('.timeline-row:not(.d-none)');
            const emptyAlert = panel.querySelector('.timeline-empty-filter');
            if (emptyAlert) {
                emptyAlert.classList.toggle('d-none', visibleRows.length > 0);
            }
        });

        // ==========================================
        // CỤM 3: CA TRỰC HÔM NAY (3 CỘT SÁNG, CHIỀU, ĐÊM)
        // ==========================================
        ['1', '2', '3'].forEach(colCaId => {
            const col = document.querySelector(`.today-col-ca[data-ca-id="${colCaId}"]`);
            if (!col) return;

            // Nếu người dùng chọn lọc 1 ca cụ thể thì làm mờ các ca khác
            const matchColCa = !caVal || caVal === colCaId;
            if (!matchColCa) {
                col.classList.add('opacity-25');
            } else {
                col.classList.remove('opacity-25');
            }

            const items = col.querySelectorAll('.today-shift-item');
            let visibleItemCount = 0;
            items.forEach(item => {
                const itemPb = item.getAttribute('data-phongban-id') || '';
                const itemName = item.getAttribute('data-emp-name') || '';

                const matchPb = !pbVal || itemPb === pbVal;
                const matchKw = !keyword || itemName.includes(keyword);

                if (matchPb && matchKw) {
                    item.classList.remove('d-none');
                    visibleItemCount++;
                } else {
                    item.classList.add('d-none');
                }
            });

            // Hiển thị thông báo rỗng cho từng ca
            const emptyDb = col.querySelector('.today-empty-db');
            const emptyFilter = col.querySelector('.today-empty-filter');

            if (items.length > 0) {
                if (emptyFilter) emptyFilter.classList.toggle('d-none', visibleItemCount > 0);
            } else {
                if (emptyDb) emptyDb.classList.remove('d-none');
                if (emptyFilter) emptyFilter.classList.add('d-none');
            }
        });

        // ==========================================
        // CỤM 4: DANH SÁCH CHI TIẾT
        // ==========================================
        const listRows = document.querySelectorAll('.list-phanca-row');
        let visibleListCount = 0;
        listRows.forEach(row => {
            const rowPb = row.getAttribute('data-phongban-id') || '';
            const rowCa = row.getAttribute('data-ca-id') || '';
            const rowName = row.getAttribute('data-emp-name') || '';

            const matchPb = !pbVal || rowPb === pbVal;
            const matchCa = !caVal || rowCa === caVal;
            const matchKw = !keyword || rowName.includes(keyword);

            if (matchPb && matchCa && matchKw) {
                row.classList.remove('d-none');
                visibleListCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        const listEmpty = document.getElementById('listEmptyFilterRow');
        if (listEmpty) {
            listEmpty.classList.toggle('d-none', visibleListCount > 0 || listRows.length === 0);
        }

        // Cập nhật số đếm badge tức thì
        const badgeMatrix = document.getElementById('badgeMatrixCount');
        if (badgeMatrix) badgeMatrix.textContent = visibleMatrixEmpCount + ' nhân sự';

        const badgeList = document.getElementById('badgeListCount');
        if (badgeList) badgeList.textContent = visibleListCount + ' lượt';
    }

    // 8. Mở modal xếp ca nhanh khi click vào ô trống trong Ma trận
    function openQuickAssignModal(maNhanVien, dateStr) {
        document.getElementById('selectNhanVienModal').value = maNhanVien;
        document.getElementById('inputNgayLamViecModal').value = dateStr;
        const modal = new bootstrap.Modal(document.getElementById('modalCreatePhanCa'));
        modal.show();
    }

    // Khởi tạo & Kích hoạt CountUp lần đầu tải trang
    document.addEventListener('DOMContentLoaded', function () {
        const savedMode = localStorage.getItem('overtime_phanca_view_mode') || 'matrix';
        switchViewMode(savedMode);

        // Kích hoạt CountUp lần đầu cho các chỉ số
        const elTotal = document.getElementById('valTongCa');
        const elSang = document.getElementById('valCaSang');
        const elChieu = document.getElementById('valCaChieu');
        const elDem = document.getElementById('valCaDem');

        if (elTotal) animateCountUp(elTotal, 0, parseInt(elTotal.textContent) || 0);
        if (elSang) animateCountUp(elSang, 0, parseInt(elSang.textContent) || 0);
        if (elChieu) animateCountUp(elChieu, 0, parseInt(elChieu.textContent) || 0);
        if (elDem) animateCountUp(elDem, 0, parseInt(elDem.textContent) || 0);
        pulseKpiCards();
    });
</script>
}
