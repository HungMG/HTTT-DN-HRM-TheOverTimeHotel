@model OvertimeHotel.HRM.WebAdmin.Models.PhanCaIndexViewModel
@{
    ViewData["Title"] = "Lập Lịch Phân Ca 24/7 & Điều Hành Lịch Trực";
    var currentWeek = ViewBag.CurrentWeek as string ?? Model.WeekStart.ToString("yyyy-MM-dd");
    var prevWeek = ViewBag.PrevWeek as string;
    var nextWeek = ViewBag.NextWeek as string;
    var todayWeek = ViewBag.TodayWeek as string;

    var todayDate = DateOnly.FromDateTime(DateTime.Today);
    var todayShifts = Model.CaTrucHomNay;

    var groupedRows = Model.Rows
        .GroupBy(r => new { r.MaPhongBan, r.TenPhongBan })
        .OrderBy(g => g.Key.TenPhongBan)
        .ToList();

    // Tính toán dữ liệu cho Mini Calendar (Hiển thị tháng của Model.WeekStart chuẩn SaaS)
    var calMonthStart = new DateOnly(Model.WeekStart.Year, Model.WeekStart.Month, 1);
    int daysInMonth = DateTime.DaysInMonth(calMonthStart.Year, calMonthStart.Month);
    var calMonthEnd = new DateOnly(calMonthStart.Year, calMonthStart.Month, daysInMonth);
    int offsetFromMonday = ((int)calMonthStart.DayOfWeek + 6) % 7;
    var calGridStart = calMonthStart.AddDays(-offsetFromMonday);
    var prevMonthDate = calMonthStart.AddMonths(-1);
    var nextMonthDate = calMonthStart.AddMonths(1);
    int totalCalCells = (calGridStart.AddDays(34) < calMonthEnd) ? 42 : 35;
}

<link rel="stylesheet" href="~/css/phanca-calendar.css" asp-append-version="true" />

<style>
    /* ==========================================================================
       ENTERPRISE SHIFT SCHEDULER & 24H TIMELINE STYLES (THE OVERTIME HOTEL)
       ========================================================================== */
    .btn-hotel-secondary {
        background-color: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        color: #1e293b !important;
        transition: all 0.2s ease;
    }
    .btn-hotel-secondary:hover,
    .btn-hotel-secondary:focus,
    .btn-hotel-secondary:active {
        background-color: #f1f5f9 !important;
        border-color: #94a3b8 !important;
        color: #0f172a !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08) !important;
    }

    .shift-workspace-card {
        border: 1px solid #e2e8f0;
        border-top: 3.5px solid #1e3a8a;
        background: #ffffff;
        border-radius: 1.15rem;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05);
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .shift-workspace-card:hover {
        box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
    }

    /* ==========================================================================
       MINI CALENDAR WIDGET (CHÍNH XÁC THEO MẪU THAM KHẢO NEXHRM)
       ========================================================================== */
    .mini-cal-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.15rem;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }
    .mini-cal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid #f1f5f9;
        background: #f8fafc;
    }
    .mini-cal-month-title {
        font-weight: 700;
        font-size: 0.84rem;
        color: #1e293b;
        letter-spacing: 0.3px;
    }
    .mini-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
        padding: 0.55rem 0.65rem;
        text-align: center;
    }
    .mini-cal-day-header {
        font-size: 0.67rem;
        font-weight: 700;
        color: #64748b;
        padding: 3px 0;
        text-transform: uppercase;
    }
    .mini-cal-day-cell {
        font-size: 0.74rem;
        font-weight: 500;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.15s ease;
        color: #334155;
        position: relative;
        user-select: none;
    }
    .mini-cal-day-cell:hover {
        background: #e2e8f0;
        color: #0f172a;
    }
    .mini-cal-day-cell.out-month {
        color: #cbd5e1;
    }
    .mini-cal-day-cell.is-in-selected-week {
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: 700;
        border-radius: 0;
    }
    .mini-cal-day-cell.week-start-cell {
        border-top-left-radius: 14px;
        border-bottom-left-radius: 14px;
    }
    .mini-cal-day-cell.week-end-cell {
        border-top-right-radius: 14px;
        border-bottom-right-radius: 14px;
    }
    .mini-cal-day-cell.is-today-marker {
        box-shadow: inset 0 0 0 1.5px #1e3a8a;
        font-weight: 800;
    }
    .mini-cal-day-cell.is-today-marker::after {
        content: '';
        position: absolute;
        bottom: 2px;
        width: 3.5px;
        height: 3.5px;
        background: #eab308;
        border-radius: 50%;
    }
    .mini-cal-stats {
        display: flex;
        border-top: 1px solid #f1f5f9;
        padding: 0.6rem 0.75rem;
        background: #f8fafc;
    }
    .mini-cal-stat-item {
        flex: 1;
        text-align: center;
        line-height: 1.2;
    }
    .mini-cal-stat-num {
        font-size: 1.05rem;
        font-weight: 800;
    }
    .mini-cal-stat-label {
        font-size: 0.68rem;
        color: #64748b;
        font-weight: 500;
    }

    /* Thanh "Xếp nhanh" (Quick Shift Assignment Palette) */
    .quick-shift-palette {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.85rem;
        padding: 0.5rem 0.75rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
    }
