@section Scripts {
<script>
    // =========================================================================
    // ✨ REACT-BITS MOTION & IN-PLACE STATE TRANSITIONS CHO PHÂN CA 24/7
    // =========================================================================

    // 1. Hiệu ứng đếm số CountUp (từ react-bits) khi số liệu KPI cập nhật (hỗ trợ cả tăng và giảm)
    function animateCountUp(element, startValue, targetValue, duration = 450) {
        if (!element) return;
        if (startValue === targetValue) {
            element.textContent = targetValue;
            return;
        }

        const startTime = performance.now();
        element.setAttribute('data-count', targetValue);

        function updateCount(currentTime) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Easing: easeOutCubic
            const easeProgress = 1 - Math.pow(1 - progress, 3);
            const currentCount = Math.round(startValue + (targetValue - startValue) * easeProgress);

            element.textContent = currentCount;

            if (progress < 1) {
                requestAnimationFrame(updateCount);
            } else {
                element.textContent = targetValue;
            }
        }

        requestAnimationFrame(updateCount);
    }

    // 2. Hiệu ứng phát quang vàng kim (Pulse) lướt nhẹ qua thẻ KPI
    function pulseKpiCards() {
        const items = document.querySelectorAll('.kpi-card-item');
        items.forEach((item, idx) => {
            setTimeout(() => {
                item.classList.add('kpi-pulse-active');
                setTimeout(() => {
                    item.classList.remove('kpi-pulse-active');
                }, 380);
            }, idx * 60);
        });
    }

    // 3. Chuyển đổi giữa các chế độ xem với hiệu ứng In-Place Cross-Fade (Mặc định: Cuốn Lịch Tháng 5★)
    function switchViewMode(mode) {
        if (!mode || mode === 'timeline') mode = 'calendar';

        const calendarContainer = document.getElementById('viewCalendarContainer');
        const matrixContainer = document.getElementById('viewMatrixContainer');
        const todayContainer = document.getElementById('viewTodayContainer');
        const listContainer = document.getElementById('viewListContainer');
        const eventDemandContainer = document.getElementById('viewEventDemandContainer');

        const containers = {
            calendar: calendarContainer,
            matrix: matrixContainer,
            today: todayContainer,
            list: listContainer,
            eventDemand: eventDemandContainer
        };

        const tabCalendar = document.getElementById('tabViewCalendar');
        const tabMatrix = document.getElementById('tabViewMatrix');
        const tabList = document.getElementById('tabViewList');
        const tabEventDemand = document.getElementById('tabViewEventDemand');

        const tabs = {
            calendar: tabCalendar,
            matrix: tabMatrix,
            list: tabList,
            eventDemand: tabEventDemand
        };

        Object.keys(tabs).forEach(key => {
            const tab = tabs[key];
            if (tab) {
                if (key === mode) tab.classList.add('active');
                else tab.classList.remove('active');
            }
        });

        // Kích hoạt hiệu ứng in-place-enter cho khung mục tiêu
        Object.keys(containers).forEach(key => {
            const c = containers[key];
            if (!c) return;
            if (key === mode) {
                c.classList.remove('d-none');
                c.classList.remove('in-place-enter');
                void c.offsetWidth; // Force reflow
                c.classList.add('in-place-enter');
            } else {
                c.classList.add('d-none');
            }
        });

        localStorage.setItem('overtime_phanca_active_tab', mode);
        localStorage.setItem('overtime_phanca_view_mode', mode);
    }
    window.switchCalendarViewTab = switchViewMode;

    // 4. Nạp tuần tại chỗ qua AJAX - TUYỆT ĐỐI KHÔNG RELOAD TOÀN TRANG
    function loadWeekInPlace(targetWeekDate) {
        const workspace = document.getElementById('scheduleContentWrapper');
        const kpiSidebar = document.getElementById('kpiSidebarContainer');
        const overlay = document.getElementById('workspaceLoadingOverlay');

        if (overlay) overlay.classList.remove('d-none');

        fetch('/PhanCa?week=' + targetWeekDate, {
            headers: { 'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
        })
        .then(response => {
            if (!response.ok) throw new Error('Không thể nạp dữ liệu');
            return response.text();
        })
        .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            // 1. Cập nhật khung lịch với hiệu ứng in-place-enter
            const newWorkspace = doc.getElementById('scheduleContentWrapper');
            if (newWorkspace && workspace) {
                workspace.innerHTML = newWorkspace.innerHTML;
                workspace.classList.remove('in-place-enter');
                void workspace.offsetWidth; // Force reflow
                workspace.classList.add('in-place-enter');
            }

            // 2. Cập nhật thanh điều hướng tuần
            const newWeekNav = doc.getElementById('weekNavigationWrapper');
            const currWeekNav = document.getElementById('weekNavigationWrapper');
            if (newWeekNav && currWeekNav) {
                currWeekNav.innerHTML = newWeekNav.innerHTML;
            }

            // 2b. Cập nhật Mini-Calendar Widget (Cuốn lịch nhỏ tháng)
            const newMiniCal = doc.getElementById('miniCalendarWrapper');
            const currMiniCal = document.getElementById('miniCalendarWrapper');
            if (newMiniCal && currMiniCal) {
                currMiniCal.innerHTML = newMiniCal.innerHTML;
            }

            // 2c. Cập nhật Warning Badge
            const newWarn = doc.getElementById('unassignedWarningBadge');
            const currWarn = document.getElementById('unassignedWarningBadge');
            if (newWarn && currWarn) {
                currWarn.innerHTML = newWarn.innerHTML;
            }

            // 3. Cập nhật cảnh báo & trạng thái modal
            onModalDateChanged();

            // 4. Cập nhật URL trình duyệt
            window.history.pushState(null, '', '/PhanCa?week=' + targetWeekDate);

            // 5. Khôi phục chế độ xem và áp dụng bộ lọc
            const currentMode = localStorage.getItem('overtime_phanca_view_mode') || 'matrix';
            switchViewMode(currentMode);
            applyFiltersInPlace();
        })
        .catch(err => {
            console.error('Lỗi nạp tuần tại chỗ:', err);
            window.location.href = '/PhanCa?week=' + targetWeekDate;
        })
        .finally(() => {
            const currentOverlay = document.getElementById('workspaceLoadingOverlay');
            if (currentOverlay) currentOverlay.classList.add('d-none');
        });
    }

    // 4. Thu gọn / Mở rộng nhóm Phòng Ban trong Ma Trận
    function toggleDeptCollapse(deptId) {
        const rows = document.querySelectorAll('.dept-child-' + deptId);
        const icon = document.getElementById('chevron-dept-' + deptId);

        let isCollapsed = false;
        rows.forEach(r => {
            if (r.classList.contains('d-none')) {
                r.classList.remove('d-none');
            } else {
                r.classList.add('d-none');
                isCollapsed = true;
            }
        });

        if (icon) {
            if (isCollapsed) {
                icon.className = 'bi bi-chevron-right text-muted';
            } else {
                icon.className = 'bi bi-chevron-down text-primary';
            }
        }
    }

    // 5. Lọc tức thì trên CẢ 3 CỤM (Ma Trận, Ca Trực Hôm Nay, Danh Sách Chi Tiết)
    function applyFiltersInPlace() {
        const keyword = (document.getElementById('filterKeyword')?.value || '').trim().toLowerCase();
        const pbVal = document.getElementById('filterPhongBan')?.value || '';
        const caVal = document.getElementById('filterCa')?.value || '';

        // ==========================================
        // CỤM 1: MA TRẬN PHÂN CA TUẦN
        // ==========================================
        const matrixRows = document.querySelectorAll('.matrix-emp-row');
        let visibleMatrixEmpCount = 0;
        matrixRows.forEach(row => {
            const rowPb = row.getAttribute('data-phongban-id') || '';
            const rowName = row.getAttribute('data-emp-name') || '';
            const rowId = row.getAttribute('data-emp-id') || '';

            const matchPb = !pbVal || rowPb === pbVal;
            const matchKw = !keyword || rowName.includes(keyword) || rowId.includes(keyword);

            if (matchPb && matchKw) {
                row.classList.remove('d-none');
                visibleMatrixEmpCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        // Ẩn/hiện tiêu đề phòng ban trong Ma Trận nếu tất cả nhân viên bị ẩn
        document.querySelectorAll('.dept-group-header').forEach(header => {
            const deptId = header.getAttribute('data-phongban-id') || '';
            if (deptId) {
                const childRows = document.querySelectorAll('.matrix-emp-row.dept-child-' + deptId);
                const hasVisible = Array.from(childRows).some(r => !r.classList.contains('d-none'));
                header.style.display = hasVisible ? '' : 'none';
            }
        });

        // Lọc thẻ ca trong Ma trận
        const shiftPills = document.querySelectorAll('.shift-pill');
        shiftPills.forEach(pill => {
            const cardCa = pill.getAttribute('data-ca-id');
            const matchCa = !caVal || cardCa === caVal;
            pill.style.display = matchCa ? 'block' : 'none';
        });

        // Hiển thị thông báo rỗng cho Ma Trận nếu không tìm thấy nhân viên
        const matrixEmpty = document.getElementById('matrixEmptyFilterRow');
        if (matrixEmpty) {
            matrixEmpty.classList.toggle('d-none', visibleMatrixEmpCount > 0);
        }

        // ==========================================
        // CỤM 2: CA TRỰC HÔM NAY (3 CỘT SÁNG, CHIỀU, ĐÊM)
        // ==========================================
        // Duyệt theo DOM thay vì danh sách mã ca cố định: danh mục ca có thể có
        // thêm ca (Ca Hành Chính), lặp cứng ['1','2','3'] sẽ bỏ sót cột thứ tư.
        document.querySelectorAll('.today-col-ca').forEach(col => {
            const colCaId = col.getAttribute('data-ca-id') || '';

            // Nếu người dùng chọn lọc 1 ca cụ thể thì làm mờ các ca khác
            const matchColCa = !caVal || caVal === colCaId;
            if (!matchColCa) {
                col.classList.add('opacity-25');
            } else {
                col.classList.remove('opacity-25');
            }

            const items = col.querySelectorAll('.today-shift-item');
            let visibleItemCount = 0;
            items.forEach(item => {
                const itemPb = item.getAttribute('data-phongban-id') || '';
                const itemName = item.getAttribute('data-emp-name') || '';

                const matchPb = !pbVal || itemPb === pbVal;
                const matchKw = !keyword || itemName.includes(keyword);

                if (matchPb && matchKw) {
                    item.classList.remove('d-none');
                    visibleItemCount++;
                } else {
                    item.classList.add('d-none');
                }
            });

            // Hiển thị thông báo rỗng cho từng ca
            const emptyDb = col.querySelector('.today-empty-db');
            const emptyFilter = col.querySelector('.today-empty-filter');

            if (items.length > 0) {
                if (emptyFilter) emptyFilter.classList.toggle('d-none', visibleItemCount > 0);
            } else {
                if (emptyDb) emptyDb.classList.remove('d-none');
                if (emptyFilter) emptyFilter.classList.add('d-none');
            }
        });

        // ==========================================
        // CỤM 3: DANH SÁCH CHI TIẾT
        // ==========================================
        const listRows = document.querySelectorAll('.list-phanca-row');
        let visibleListCount = 0;
        listRows.forEach(row => {
            const rowPb = row.getAttribute('data-phongban-id') || '';
            const rowCa = row.getAttribute('data-ca-id') || '';
            const rowName = row.getAttribute('data-emp-name') || '';

            const matchPb = !pbVal || rowPb === pbVal;
            const matchCa = !caVal || rowCa === caVal;
            const matchKw = !keyword || rowName.includes(keyword);

            if (matchPb && matchCa && matchKw) {
                row.classList.remove('d-none');
                visibleListCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        const listEmpty = document.getElementById('listEmptyFilterRow');
        if (listEmpty) {
            listEmpty.classList.toggle('d-none', visibleListCount > 0 || listRows.length === 0);
        }

        // Cập nhật số đếm badge tức thì
        const badgeMatrix = document.getElementById('badgeMatrixCount');
        if (badgeMatrix) badgeMatrix.textContent = visibleMatrixEmpCount + ' nhân sự';

        const badgeList = document.getElementById('badgeListCount');
        if (badgeList) badgeList.textContent = visibleListCount + ' lượt';
    }

    // =========================================================================
    // ⚙️ HỆ THỐNG PHÂN CA ĐA NHÂN SỰ & CONFLICT CHECK TRỰC TUYẾN
    // =========================================================================
    const WEEK_SHIFTS_DATA = [
        @foreach (var p in Model.DanhSachPhanCa)
        {
            <text>{ empId: @p.MaNhanVien, date: '@p.NgayLamViec.ToString("yyyy-MM-dd")', maCa: @p.MaCa, tenCa: '@Html.Raw(p.CaLamViec?.TenCa ?? "Ca trực")', time: '@(p.CaLamViec?.GioBatDau.ToString("HH:mm")) - @(p.CaLamViec?.GioKetThuc.ToString("HH:mm"))', sacThai: '@(p.CaLamViec?.SacThaiCa ?? "morning")', empName: '@Html.Raw(p.NhanVien?.HoTen ?? "")', empCode: 'NV-@p.MaNhanVien', deptName: '@Html.Raw(p.NhanVien?.PhongBan?.TenPhongBan ?? "")', chucVu: '@Html.Raw(p.NhanVien?.ChucVu?.TenChucVu ?? "")' },</text>
        }
    ];

    // =========================================================================
    // 📅 BỘ LỊCH THÁNG TƯƠNG TÁC TRỰC QUAN TRONG MODAL PHÂN CA
    // =========================================================================
    let modalCalYear = @calMonthStart.Year;
    let modalCalMonth = @calMonthStart.Month; // 1-12
    const modalSelectedDates = new Set(['@Model.WeekStart.ToString("yyyy-MM-dd")']);
    const TODAY_STR = '@todayDate.ToString("yyyy-MM-dd")';
    const WEEK_START_STR = '@Model.WeekStart.ToString("yyyy-MM-dd")';
    const WEEK_END_STR = '@Model.WeekEnd.ToString("yyyy-MM-dd")';

    function changeModalCalMonth(delta) {
        modalCalMonth += delta;
        if (modalCalMonth > 12) {
            modalCalMonth = 1;
            modalCalYear++;
        } else if (modalCalMonth < 1) {
            modalCalMonth = 12;
            modalCalYear--;
        }
        renderModalCalendar();
    }

    function renderModalCalendar() {
        const monthLabel = document.getElementById('modalCalMonthLabel');
        if (monthLabel) {
            const mStr = modalCalMonth < 10 ? '0' + modalCalMonth : modalCalMonth;
            monthLabel.textContent = `Tháng ${mStr} / ${modalCalYear}`;
        }

        const grid = document.getElementById('modalCalGridContainer');
        if (!grid) return;
        grid.innerHTML = '';

        const firstDay = new Date(modalCalYear, modalCalMonth - 1, 1);
        let startDayOfWeek = firstDay.getDay(); // 0: Sun, 1: Mon...
        let mondayOffset = (startDayOfWeek === 0) ? 6 : (startDayOfWeek - 1);

        const daysInMonth = new Date(modalCalYear, modalCalMonth, 0).getDate();
        const daysInPrevMonth = new Date(modalCalYear, modalCalMonth - 1, 0).getDate();

        // 1. Ngày của tháng trước (lót đệm)
        for (let i = mondayOffset - 1; i >= 0; i--) {
            const prevDay = daysInPrevMonth - i;
            const prevMonth = modalCalMonth === 1 ? 12 : modalCalMonth - 1;
            const prevYear = modalCalMonth === 1 ? modalCalYear - 1 : modalCalYear;
            const prevDateStr = formatDateStr(prevYear, prevMonth, prevDay);

            const cell = createCalCell(prevDay, prevDateStr, true);
            grid.appendChild(cell);
        }

        // 2. Ngày của tháng hiện tại
        for (let d = 1; d <= daysInMonth; d++) {
            const dateStr = formatDateStr(modalCalYear, modalCalMonth, d);
            const cell = createCalCell(d, dateStr, false);
            grid.appendChild(cell);
        }

        // 3. Ngày của tháng kế tiếp (lót đệm cho đủ tuần)
        const totalRendered = mondayOffset + daysInMonth;
        const remainder = totalRendered % 7 === 0 ? 0 : 7 - (totalRendered % 7);
        for (let n = 1; n <= remainder; n++) {
            const nextMonth = modalCalMonth === 12 ? 1 : modalCalMonth + 1;
            const nextYear = modalCalMonth === 12 ? modalCalYear + 1 : modalCalYear;
            const nextDateStr = formatDateStr(nextYear, nextMonth, n);

            const cell = createCalCell(n, nextDateStr, true);
            grid.appendChild(cell);
        }

        syncModalSelectedDatesUI();
    }

    function formatDateStr(y, m, d) {
        const mStr = m < 10 ? '0' + m : '' + m;
        const dStr = d < 10 ? '0' + d : '' + d;
        return `${y}-${mStr}-${dStr}`;
    }

    function createCalCell(dayNum, dateStr, isOtherMonth) {
        const cell = document.createElement('div');
        cell.className = 'modal-cal-day-cell';
        if (isOtherMonth) cell.classList.add('is-other-month');
        if (dateStr === TODAY_STR) cell.classList.add('is-today');
        if (modalSelectedDates.has(dateStr)) cell.classList.add('is-selected');

        const isPast = dateStr < TODAY_STR;
        if (isPast) {
            cell.classList.add('is-past');
            cell.style.opacity = '0.35';
            cell.style.cursor = 'not-allowed';
            cell.title = 'Ngày quá khứ (không thể chọn)';
        }

        // Đèn báo ca: tra theo lưới 42 ngày (phancaCalendarData.shifts), không dùng
        // WEEK_SHIFTS_DATA vì dữ liệu đó chỉ chứa 1 tuần.
        const monthShifts = getModalMonthShifts(dateStr);
        if (monthShifts.length > 0) {
            const dot = document.createElement('span');
            dot.className = 'cal-dot';
            cell.appendChild(dot);
            if (!isPast) {
                cell.title = `${monthShifts.length} ca trực ngày ${dateStr}`;
            }
        }

        const text = document.createElement('span');
        text.textContent = dayNum;
        cell.appendChild(text);

        if (!isPast) {
            cell.onclick = function () {
                toggleModalDate(dateStr);
            };
        }

        return cell;
    }

    function toggleModalDate(dateStr) {
        if (dateStr < TODAY_STR) {
            showQuickToast('⚠️ Không thể chọn ngày trong quá khứ (' + dateStr + ').');
            return;
        }

        if (modalSelectedDates.has(dateStr)) {
            modalSelectedDates.delete(dateStr);
        } else {
            modalSelectedDates.add(dateStr);
        }
        const firstDate = Array.from(modalSelectedDates)[0] || '';
        const inputNgay = document.getElementById('inputNgayLamViecModal');
        if (inputNgay) inputNgay.value = firstDate;

        renderModalCalendar();
        onModalDateChanged();
    }

    function clearModalSelectedDates() {
        modalSelectedDates.clear();
        const inputNgay = document.getElementById('inputNgayLamViecModal');
        if (inputNgay) inputNgay.value = '';

        renderModalCalendar();
        onModalDateChanged();
    }

    function selectModalDateSingle(dateStr) {
        if (dateStr < TODAY_STR) {
            showQuickToast('⚠️ Không thể chọn ngày trong quá khứ (' + dateStr + ').');
            return;
        }

        modalSelectedDates.clear();
        modalSelectedDates.add(dateStr);
        document.getElementById('inputNgayLamViecModal').value = dateStr;

        const parts = dateStr.split('-').map(Number);
        modalCalYear = parts[0];
        modalCalMonth = parts[1];

        renderModalCalendar();
        onModalDateChanged();
    }

    function selectModalWeekdaysRange() {
        modalSelectedDates.clear();
        const start = new Date(WEEK_START_STR);
        for (let i = 0; i < 5; i++) {
            const cur = new Date(start);
            cur.setDate(start.getDate() + i);
            const dStr = formatDateStr(cur.getFullYear(), cur.getMonth() + 1, cur.getDate());
            if (dStr >= TODAY_STR) {
                modalSelectedDates.add(dStr);
            }
        }
        const first = Array.from(modalSelectedDates)[0] || '';
        document.getElementById('inputNgayLamViecModal').value = first;
        renderModalCalendar();
        onModalDateChanged();
    }

    function selectModalFullWeekRange() {
        modalSelectedDates.clear();
        const start = new Date(WEEK_START_STR);
        for (let i = 0; i < 7; i++) {
            const cur = new Date(start);
            cur.setDate(start.getDate() + i);
            const dStr = formatDateStr(cur.getFullYear(), cur.getMonth() + 1, cur.getDate());
            if (dStr >= TODAY_STR) {
                modalSelectedDates.add(dStr);
            }
        }
        const first = Array.from(modalSelectedDates)[0] || '';
        document.getElementById('inputNgayLamViecModal').value = first;
        renderModalCalendar();
        onModalDateChanged();
    }

    // Tra ca trực của 1 ngày theo lưới 42 ngày (không giới hạn ở tuần hiện tại)
    function getModalMonthShifts(dateStr) {
        const all = (window.phancaCalendarData && window.phancaCalendarData.shifts) || [];
        return all.filter(s => s.ngayLamViec === dateStr);
    }

    // "Ca Sáng (Morning Shift)" -> "Ca Sáng" cho gọn badge trong bảng nhân sự
    function shortShiftName(tenCa) {
        if (!tenCa) return '';
        return tenCa.includes('(') ? tenCa.split('(')[0].trim() : tenCa;
    }

    // Sắc thái của ca ('morning' | 'afternoon' | 'night' | 'office') do MÁY CHỦ
    // gửi xuống trong trường `sacThai`, lấy từ CaLamViec.SacThaiCa — nơi duy nhất
    // đọc LoaiCa. Cố ý không suy lại từ tên ca: tên ca là dữ liệu người dùng đặt
    // và sửa được, dò chữ Hán-Việt trong đó là đoán mò. Ca thứ tư trở đi (Ca Hành
    // Chính) từng bị đoán nhầm thành ca đêm / ca sáng vì lý do đó.
    function getShiftBadgeClassByKind(kind) {
        if (kind === 'office') return 'phanca-shift-badge-hanhchinh';
        if (kind === 'night') return 'phanca-shift-badge-dem';
        if (kind === 'afternoon') return 'phanca-shift-badge-chieu';
        return 'phanca-shift-badge-sang';
    }

    // Icon đặc trưng của từng ca, tô đúng sắc thái thay vì dùng chung text-primary
    function getShiftIconClassByKind(kind) {
        if (kind === 'office') return 'bi-briefcase-fill text-teal';
        if (kind === 'night') return 'bi-moon-stars-fill text-warning';
        if (kind === 'afternoon') return 'bi-cloud-sun-fill text-warning';
        return 'bi-brightness-high-fill text-primary';
    }

    const MODAL_DAY_NAMES = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];

    function formatModalDateLabel(dateStr, short) {
        const parts = dateStr.split('-').map(Number);
        const dt = new Date(parts[0], parts[1] - 1, parts[2]);
        const dmy = `${parts[2] < 10 ? '0' + parts[2] : parts[2]}/${parts[1] < 10 ? '0' + parts[1] : parts[1]}`;
        return short ? `${MODAL_DAY_NAMES[dt.getDay()]} ${dmy}` : `${MODAL_DAY_NAMES[dt.getDay()]}, ${dmy}/${parts[0]}`;
    }

    function syncModalSelectedDatesUI() {
        const hiddenContainer = document.getElementById('modalHiddenDatesContainer');
        if (hiddenContainer) {
            hiddenContainer.innerHTML = '';
            modalSelectedDates.forEach(d => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'DanhSachNgayLamViec';
                input.value = d;
                hiddenContainer.appendChild(input);
            });
        }

        const datesArr = Array.from(modalSelectedDates).sort();

        // Chip ngày đã chọn — hiển thị trực tiếp nơi chọn, có nút bỏ ngày
        const chips = document.getElementById('modalSelectedDateChips');
        if (chips) {
            chips.innerHTML = '';
            if (datesArr.length === 0) {
                const empty = document.createElement('span');
                empty.className = 'phanca-date-chip-empty';
                empty.textContent = 'Chưa chọn ngày nào — bấm vào lịch để chọn';
                chips.appendChild(empty);
            } else {
                datesArr.forEach(d => {
                    const chip = document.createElement('span');
                    chip.className = 'phanca-date-chip';
                    chip.title = formatModalDateLabel(d, false);

                    const label = document.createElement('span');
                    label.textContent = formatModalDateLabel(d, true);
                    chip.appendChild(label);

                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'phanca-date-chip-remove';
                    removeBtn.innerHTML = '<i class="bi bi-x-lg"></i>';
                    removeBtn.title = 'Bỏ ngày ' + formatModalDateLabel(d, false);
                    removeBtn.onclick = function (ev) {
                        ev.stopPropagation();
                        toggleModalDate(d);
                    };
                    chip.appendChild(removeBtn);

                    chips.appendChild(chip);
                });
            }
        }

        // Tóm tắt ngày ngay trên thanh cấu hình
        const dateText = document.getElementById('modalSelectedDateText');
        if (dateText) {
            if (datesArr.length === 0) {
                dateText.textContent = 'Chưa chọn ngày nào';
            } else if (datesArr.length === 1) {
                dateText.textContent = 'Đang chọn: ' + formatModalDateLabel(datesArr[0], false);
            } else {
                const first = datesArr[0].split('-').slice(1).reverse().join('/');
                const last = datesArr[datesArr.length - 1].split('-').slice(1).reverse().join('/');
                dateText.textContent = `${datesArr.length} ngày (${first} → ${last})`;
            }
        }
    }

    // =========================================================================
    // 👤 XEM CHI TIẾT LỊCH CA CÁ NHÂN (INDIVIDUAL EMPLOYEE SCHEDULE MODAL)
    // =========================================================================
    function viewEmployeeSchedule(empId, empName, deptRole, avatarText) {
        const nameEl = document.getElementById('empModalName');
        const deptRoleEl = document.getElementById('empModalDeptRole');
        const avatarEl = document.getElementById('empModalAvatar');
        const listEl = document.getElementById('empModalScheduleList');
        const countBadge = document.getElementById('empModalShiftCount');

        if (nameEl) nameEl.textContent = empName;
        if (deptRoleEl) deptRoleEl.textContent = deptRole;
        if (avatarEl) avatarEl.textContent = avatarText || 'N';

        if (listEl) {
            listEl.innerHTML = '';
            const empShifts = WEEK_SHIFTS_DATA.filter(s => s.empId === empId);
            if (countBadge) countBadge.textContent = empShifts.length + ' ca trực tuần này';

            if (empShifts.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-x fs-2 text-warning d-block mb-2"></i>
                        <span>Nhân sự chưa được phân ca trực nào trong tuần này.</span>
                    </div>`;
            } else {
                empShifts.sort((a, b) => a.date.localeCompare(b.date));
                empShifts.forEach(s => {
                    const parts = s.date.split('-').map(Number);
                    const dt = new Date(parts[0], parts[1] - 1, parts[2]);
                    const days = ['Chủ nhật', 'Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7'];
                    const dayName = days[dt.getDay()];
                    // Ca đêm mới được hưởng phụ cấp +30%; đọc sacThai của ca thay vì
                    // dò tên để ca hành chính không bị gắn nhầm phụ cấp đêm.
                    const isNight = s.sacThai === 'night';

                    const item = document.createElement('div');
                    item.className = 'p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between';
                    item.innerHTML = `
                        <div class="d-flex align-items-center gap-3">
                            <div class="badge ${getShiftBadgeClassByKind(s.sacThai)} rounded-pill px-3 py-2">
                                <i class="bi ${getShiftIconClassByKind(s.sacThai)} me-1"></i> ${dayName}
                            </div>
                            <div>
                                <div class="fw-bold text-dark font-serif">${s.tenCa}</div>
                                <div class="small text-muted font-monospace">${s.time} &bull; Ngày ${parts[2] < 10 ? '0' + parts[2] : parts[2]}/${parts[1] < 10 ? '0' + parts[1] : parts[1]}/${parts[0]}</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            ${isNight ? '<span class="badge bg-danger-subtle text-danger border rounded-pill">+30% Lương Đêm</span>' : '<span class="badge bg-light text-muted border rounded-pill">1.0x</span>'}
                            <span class="badge bg-success-subtle text-success border rounded-pill"><i class="bi bi-check-circle me-1"></i>Đã phân</span>
                        </div>
                    `;
                    listEl.appendChild(item);
                });
            }
        }

        const modalEl = document.getElementById('modalEmployeeSchedule');
        if (modalEl) {
            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    }

    function selectModalShift(maCa) {
        document.getElementById('inputMaCaModal').value = maCa;
        document.querySelectorAll('.modal-shift-option-card').forEach(card => {
            const cardCa = parseInt(card.getAttribute('data-ca-id'));
            if (cardCa === maCa) {
                card.classList.add('active-shift-card');
            } else {
                card.classList.remove('active-shift-card');
            }
        });
    }

    let currentModalShiftFilter = 'all';

    function filterModalEmpByShiftStatus(status) {
        currentModalShiftFilter = status;

        document.querySelectorAll('.modal-filter-shift-btn').forEach(btn => {
            btn.classList.remove('active-filter-pill', 'btn-primary');
            btn.classList.add('btn-light', 'border', 'text-dark');
        });

        const activeBtn = status === 'all' ? document.getElementById('btnFilterAll') :
                          status === 'free' ? document.getElementById('btnFilterFree') :
                          document.getElementById('btnFilterBusy');
        if (activeBtn) {
            activeBtn.classList.remove('btn-light', 'border', 'text-dark');
            activeBtn.classList.add('active-filter-pill');
        }

        const hint = document.getElementById('modalFilterHintText');
        if (hint) {
            if (status === 'free') hint.textContent = 'Đang lọc: Nhân sự chưa có ca ngày này';
            else if (status === 'busy') hint.textContent = 'Đang lọc: Nhân sự đã có ca ngày này';
            else hint.textContent = 'Đang hiển thị tất cả nhân sự';
        }

        filterModalEmployees();
    }

    // Ca trực của 1 nhân sự trong 1 ngày — tra theo lưới 42 ngày
    function findModalEmpShift(empId, dateStr) {
        return getModalMonthShifts(dateStr).find(s => s.maNhanVien === empId) || null;
    }

    // Đồng bộ cache lưới 42 ngày sau thao tác gán/xóa ca nhanh trên ma trận,
    // để lịch tháng + roster trong modal phản ánh đúng dữ liệu.
    function syncModalShiftCache(empId, dateStr, shiftObj) {
        if (!window.phancaCalendarData || !Array.isArray(window.phancaCalendarData.shifts)) return;

        const list = window.phancaCalendarData.shifts;
        const idx = list.findIndex(s => s.maNhanVien === empId && s.ngayLamViec === dateStr);

        if (shiftObj) {
            const entry = {
                maPhanCa: 0,
                maNhanVien: empId,
                hoTen: shiftObj.empName || ('NV #' + empId),
                maNhanVienHienThi: shiftObj.empCode || ('NV-' + empId),
                tenChucVu: '',
                tenPhongBan: '',
                maCa: shiftObj.maCa,
                tenCa: shiftObj.tenCa,
                gioBatDau: shiftObj.gioBatDau || '',
                gioKetThuc: shiftObj.gioKetThuc || '',
                quaDem: !!shiftObj.quaDem,
                // Giữ sắc thái ca trong cache để lịch tháng/roster vừa cập nhật
                // không rơi về màu mặc định khi tên ca không chứa "Sáng/Chiều/Đêm".
                sacThai: shiftObj.sacThai || 'morning',
                ngayLamViec: dateStr,
                avatarColor: '#1e3a8a',
                coTangCa: !!shiftObj.coTangCa,
                gioTangCaDuKien: shiftObj.gioTangCaDuKien || 0,
                ghiChuOt: shiftObj.ghiChuOt || ''
            };
            if (idx >= 0) list[idx] = entry;
            else list.push(entry);
        } else if (idx >= 0) {
            list.splice(idx, 1);
        }
    }

    function toggleRosterShiftAccordion(maCa) {
        const card = document.getElementById('rosterShiftCard_' + maCa);
        if (!card) return;
        card.classList.toggle('is-collapsed');
        updateToggleAllRosterButtonText();
    }

    function toggleAllRosterAccordions() {
        const cards = document.querySelectorAll('.roster-shift-card');
        if (!cards || cards.length === 0) return;
        const hasOpen = Array.from(cards).some(c => !c.classList.contains('is-collapsed'));
        cards.forEach(c => {
            if (hasOpen) c.classList.add('is-collapsed');
            else c.classList.remove('is-collapsed');
        });
        updateToggleAllRosterButtonText();
    }

    function updateToggleAllRosterButtonText() {
        const btn = document.getElementById('btnToggleAllRoster');
        if (!btn) return;
        const cards = document.querySelectorAll('.roster-shift-card');
        if (!cards || cards.length === 0) return;
        const hasOpen = Array.from(cards).some(c => !c.classList.contains('is-collapsed'));
        btn.innerHTML = hasOpen
            ? '<i class="bi bi-arrows-collapse me-1"></i>Thu gọn tất cả'
            : '<i class="bi bi-arrows-expand me-1"></i>Mở tất cả';
    }

    function renderModalDayRoster(chosenDate) {
        const container = document.getElementById('modalDayRosterContent');
        const badge = document.getElementById('modalDayRosterTotalBadge');
        if (!container) return;

        if (!chosenDate) {
            if (badge) badge.textContent = '0 người trực';
            container.innerHTML = '<div class="text-center py-2 text-muted small"><i class="bi bi-calendar-x me-1"></i>Chưa chọn ngày nào trên lịch.</div>';
            return;
        }

        const shiftsOnDate = getModalMonthShifts(chosenDate);
        if (badge) badge.textContent = shiftsOnDate.length + ' người trực';

        // Lấy danh sách ca từ caList (hoặc mặc định 3 ca xoay chuẩn 24/7: Ca Sáng, Ca Chiều, Ca Đêm)
        const allCaList = (window.phancaCalendarData && window.phancaCalendarData.caList && window.phancaCalendarData.caList.length > 0)
            ? window.phancaCalendarData.caList
            : [
                { maCa: 1, tenCa: 'Ca Sáng (06:00 - 14:00)', gio: '06:00 - 14:00', sacThai: 'morning', quaDem: false },
                { maCa: 2, tenCa: 'Ca Chiều (14:00 - 22:00)', gio: '14:00 - 22:00', sacThai: 'afternoon', quaDem: false },
                { maCa: 3, tenCa: 'Ca Đêm (22:00 - 06:00)', gio: '22:00 - 06:00', sacThai: 'night', quaDem: true }
            ];

        // Ưu tiên 3 ca xoay chuẩn 24/7 của khách sạn (Ca Sáng, Ca Chiều, Ca Đêm); ca khác chỉ hiện khi có người trực
        const displayCaList = allCaList.filter(ca => ca.sacThai !== 'office' || shiftsOnDate.some(s => s.maCa === ca.maCa));

        // Lấy mã ca hiện đang được chọn trên thanh cấu hình để ưu tiên mở sẵn
        const selectedRadio = document.querySelector('input[name="MaCa"]:checked');
        const currentActiveMaCa = selectedRadio ? parseInt(selectedRadio.value) : 0;

        let html = '';
        displayCaList.forEach(ca => {
            const caShifts = shiftsOnDate.filter(s => s.maCa === ca.maCa);
            const badgeClass = getShiftBadgeClassByKind(ca.sacThai);
            const iconClass = getShiftIconClassByKind(ca.sacThai);
            // Mặc định luôn thu gọn các thẻ ca theo yêu cầu người dùng
            const collapsedClass = 'is-collapsed';

            html += `
                <div class="roster-shift-card ${collapsedClass}" id="rosterShiftCard_${ca.maCa}">
                    <div class="roster-shift-header" onclick="toggleRosterShiftAccordion(${ca.maCa})">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge ${badgeClass} rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">
                                <i class="bi ${iconClass} me-1"></i>${shortShiftName(ca.tenCa)}
                            </span>
                            <span class="text-muted small font-monospace">${ca.gio || ''}</span>
                            ${ca.quaDem ? '<span class="badge bg-warning text-dark border border-warning" style="font-size: 0.62rem;">+30% đêm</span>' : ''}
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge ${caShifts.length > 0 ? 'bg-secondary-subtle text-secondary border' : 'bg-light text-muted border'}" style="font-size: 0.68rem;">
                                ${caShifts.length} nhân sự
                            </span>
                            <i class="bi bi-chevron-down roster-chevron"></i>
                        </div>
                    </div>
                    <div class="roster-shift-body" id="rosterShiftBody_${ca.maCa}">
            `;

            if (caShifts.length === 0) {
                html += `
                    <div class="text-muted text-center py-2 small fst-italic">
                        <i class="bi bi-dash-circle me-1"></i>Chưa có nhân sự trực ca này.
                    </div>
                `;
            } else {
                html += '<div class="d-flex flex-column gap-1">';
                caShifts.forEach(s => {
                    const hasOt = (s.coTangCa || (parseFloat(s.gioTangCaDuKien) > 0));
                    const otHours = parseFloat(s.gioTangCaDuKien || 0);
                    html += `
                        <div class="roster-emp-item p-1.5 px-2 rounded-2 border d-flex align-items-center justify-content-between bg-white" style="font-size: 0.76rem;">
                            <div class="d-flex align-items-center gap-1.5 overflow-hidden">
                                <span class="roster-avatar-dot" style="background-color: ${s.avatarColor || '#1e3a8a'};"></span>
                                <strong class="text-dark text-truncate">${s.hoTen}</strong>
                                <span class="text-muted small">(${s.maNhanVienHienThi || s.tenPhongBan || ''})</span>
                            </div>
                            <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                ${hasOt ? `
                                    <span class="badge bg-danger text-white border border-danger fw-bold" style="font-size: 0.72rem;" title="${s.ghiChuOt || 'Tăng ca'}">
                                        <i class="bi bi-clock-history me-1"></i>+${otHours.toFixed(1)}h OT
                                    </span>` : ''}
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
            }

            html += `
                    </div>
                </div>
            `;
        });

        container.innerHTML = html;
        updateToggleAllRosterButtonText();
    }

    function onModalDateChanged() {
        const dateInput = document.getElementById('inputNgayLamViecModal');
        const chosenDate = dateInput ? dateInput.value : '';

        let freeCount = 0;
        let busyCount = 0;
        const allEmpRows = document.querySelectorAll('.modal-emp-row');
        allEmpRows.forEach(row => {
            const empId = parseInt(row.getAttribute('data-emp-id'));
            const statusEl = document.getElementById('shiftStatus-' + empId);

            const existingShift = chosenDate ? findModalEmpShift(empId, chosenDate) : null;
            if (existingShift) {
                busyCount++;
                if (statusEl) statusEl.innerHTML = '<span class="badge bg-warning-subtle text-warning-emphasis border py-0.5 px-1.5" style="font-size: 0.68rem;" title="' + existingShift.tenCa + '">'
                    + '<i class="bi bi-clock-fill me-1"></i>' + shortShiftName(existingShift.tenCa)
                    + ' (' + existingShift.gioBatDau + '-' + existingShift.gioKetThuc + ')</span>';
            } else {
                freeCount++;
                if (statusEl) statusEl.innerHTML = '<span class="badge bg-light text-muted border py-0.5 px-1.5" style="font-size: 0.68rem;"><i class="bi bi-dash-circle me-1"></i>Trống ca</span>';
            }
        });

        const cntAll = document.getElementById('countFilterAll');
        const cntFree = document.getElementById('countFilterFree');
        const cntBusy = document.getElementById('countFilterBusy');
        if (cntAll) cntAll.textContent = allEmpRows.length;
        if (cntFree) cntFree.textContent = freeCount;
        if (cntBusy) cntBusy.textContent = busyCount;

        renderModalDayRoster(chosenDate);
        filterModalEmployees();
    }

    function filterModalEmployees() {
        const kw = (document.getElementById('modalEmpSearchInput')?.value || '').trim().toLowerCase();
        const dept = document.getElementById('modalDeptFilter')?.value || '';
        const chosenDate = document.getElementById('inputNgayLamViecModal')?.value || '';
        let visibleCount = 0;

        document.querySelectorAll('.modal-emp-row').forEach(row => {
            const name = row.getAttribute('data-emp-name') || '';
            const code = row.getAttribute('data-emp-code') || '';
            const rowDept = row.getAttribute('data-dept-id') || '';
            const empId = parseInt(row.getAttribute('data-emp-id'));

            const matchKw = !kw || name.includes(kw) || code.includes(kw);
            const matchDept = !dept || rowDept === dept;

            let matchStatus = true;
            if (chosenDate && currentModalShiftFilter !== 'all') {
                const hasShift = !!findModalEmpShift(empId, chosenDate);
                if (currentModalShiftFilter === 'free' && hasShift) matchStatus = false;
                if (currentModalShiftFilter === 'busy' && !hasShift) matchStatus = false;
            }

            if (matchKw && matchDept && matchStatus) {
                row.classList.remove('d-none');
                visibleCount++;
            } else {
                row.classList.add('d-none');
            }
        });

        const emptyAlert = document.getElementById('modalEmpEmptyFilterRow');
        if (emptyAlert) {
            emptyAlert.classList.toggle('d-none', visibleCount > 0);
        }
    }

    function selectAllModalEmployees(checked) {
        document.querySelectorAll('.modal-emp-row:not(.d-none) .modal-emp-chk').forEach(chk => {
            chk.checked = checked;
        });
        updateModalSelectedCount();
    }

    function toggleModalMasterCheckbox(master) {
        selectAllModalEmployees(master.checked);
    }

    function setModalOtHours(hours) {
        const el = document.getElementById('modalGioTangCa');
        if (el) {
            el.value = Number(hours).toFixed(1);
            syncOtPresetButtons(hours);
            updateModalSelectedCount();
        }
    }

    function syncOtPresetButtons(hours) {
        const val = parseFloat(hours) || 0;
        const buttons = document.querySelectorAll('.btn-modal-ot-preset');
        buttons.forEach(btn => {
            const btnHours = parseFloat(btn.getAttribute('data-ot-hours')) || 0;
            if (Math.abs(btnHours - val) < 0.05) {
                btn.classList.add('active', 'btn-danger', 'text-white');
                btn.classList.remove('btn-outline-danger');
            } else {
                btn.classList.remove('active', 'btn-danger', 'text-white');
                btn.classList.add('btn-outline-danger');
            }
        });
    }

    function updateModalSelectedCount() {
        const count = document.querySelectorAll('.modal-emp-chk:checked').length;
        const submitLabel = document.getElementById('submitCountLabel');
        if (submitLabel) submitLabel.textContent = count;

        // Tóm tắt ngay trên thanh cấu hình (thay cho badge rời rạc trước đây)
        const summary = document.getElementById('modalSchedulingSummaryBadge');
        if (summary) {
            const soNgay = modalSelectedDates.size;
            const otEl = document.getElementById('modalGioTangCa');
            const otVal = otEl ? parseFloat(otEl.value) : 0;
            const otBadge = (otVal > 0) ? ` (+${otVal.toFixed(1)}h OT)` : '';
            if (count === 0) {
                summary.innerHTML = '<i class="bi bi-check2-all"></i> Chưa chọn nhân sự';
            } else {
                summary.innerHTML = '<i class="bi bi-check2-all"></i> ' + count + ' nhân sự × ' + soNgay + ' ngày' + otBadge;
            }
        }
    }

    function validatePhanCaSubmit(e) {
        const huy = () => {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
        };

        if (modalSelectedDates.size === 0) {
            huy();
            showQuickToast('⚠️ Vui lòng chọn ít nhất một ngày làm việc trên lịch trước khi lưu phân ca.');
            return false;
        }
        if (document.querySelectorAll('.modal-emp-chk:checked').length === 0) {
            huy();
            showQuickToast('⚠️ Vui lòng chọn ít nhất một nhân viên trong danh sách trước khi lưu phân ca.');
            return false;
        }

        const otEl = document.getElementById('modalGioTangCa');
        const otVal = otEl ? parseFloat(otEl.value) : 0;
        if (isNaN(otVal) || otVal < 0 || otVal > 4.0) {
            huy();
            showQuickToast('⚠️ Số giờ tăng ca (OT) phải từ 0.0 đến 4.0 giờ/ngày theo Điều 107 Bộ luật Lao động 2019.');
            return false;
        }

        return true;
    }

    // =========================================================================
    // 👥 POPUP XEM TOÀN BỘ NHÂN SỰ ĐI LÀM TRONG NGÀY (DAY ROSTER MODAL)
    // =========================================================================
    let currentRosterDate = '';

    function openDayRosterModal(dateStr, dateLabel) {
        currentRosterDate = dateStr;
        const titleEl = document.getElementById('modalDayRosterTitle');
        const subEl = document.getElementById('modalDayRosterSubtitle');
        const shiftsListEl = document.getElementById('dayRosterShiftsList');
        const totalSummaryEl = document.getElementById('dayRosterTotalSummary');

        if (titleEl) titleEl.textContent = 'Nhân Sự Trực ' + (dateLabel || dateStr);
