                                        @if (nightShifts.Any())
                                        {
                                            @foreach (var s in nightShifts)
                                            {
                                                <div class="today-shift-item p-2 mb-2 bg-white rounded-3 shadow-sm border d-flex align-items-center justify-content-between"
                                                     data-phongban-id="@s.NhanVien?.MaPhongBan" 
                                                     data-ca-id="@s.MaCa" 
                                                     data-emp-name="@(s.NhanVien != null ? (s.NhanVien.Ho + " " + s.NhanVien.Ten).ToLowerInvariant() : "")">
                                                    <div>
                                                        <div class="fw-bold text-dark small">@s.NhanVien?.Ho @s.NhanVien?.Ten</div>
                                                        <div class="small text-muted" style="font-size: 0.7rem;">@s.NhanVien?.PhongBan?.TenPhongBan &bull; @s.NhanVien?.ChucVu?.TenChucVu</div>
                                                    </div>
                                                    <span class="badge bg-danger-subtle text-danger border">+30% Lương</span>
                                                </div>
                                            }
                                        }
                                        <div class="today-empty-db text-center py-4 text-muted small @(nightShifts.Any() ? "d-none" : "")">
                                            <i class="bi bi-person-x fs-4 d-block mb-1 text-secondary"></i>
                                            Chưa có nhân viên nào được xếp ca đêm hôm nay.
                                        </div>
                                        <div class="today-empty-filter text-center py-4 text-muted small d-none">
                                            <i class="bi bi-funnel text-warning fs-4 d-block mb-1"></i>
                                            Không có nhân viên nào của bộ phận này trong ca đêm hôm nay.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- CHẾ ĐỘ 4: DANH SÁCH CHI TIẾT -->
                <div id="viewListContainer" class="d-none mb-4">
                    <div class="shift-workspace-card shadow-sm overflow-hidden">
                        <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-list-check text-primary fs-5"></i>
