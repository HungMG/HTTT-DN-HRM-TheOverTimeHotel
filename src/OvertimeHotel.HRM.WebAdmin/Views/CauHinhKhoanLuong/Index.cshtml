@model IReadOnlyList<OvertimeHotel.HRM.Core.Models.CauHinhKhoanLuong>
@{
    ViewData["Title"] = "Cấu hình khoản lương · The OverTime Hotel";
}

<div class="catalog-page">
    <!-- HERO COMMAND BANNER -->
    <section class="catalog-hero catalog-command-bar mb-4 position-relative">
        <div class="catalog-art-deco-pattern" aria-hidden="true"></div>
        <div class="position-relative" style="z-index: 2;">
            <nav aria-label="Điều hướng">
                <ol class="catalog-breadcrumb catalog-breadcrumb--dark">
                    <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Dashboard</a></li>
                    <li><a asp-controller="SystemCatalog" asp-action="Index">Danh mục hệ thống</a></li>
                    <li aria-current="page">Khoản lương</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark fw-bold px-2 py-1 rounded-pill" style="font-size: 0.65rem;">
                    <i class="bi bi-stars"></i> THE OVERTIME HOTEL
                </span>
                <span class="catalog-eyebrow mb-0"><i class="bi bi-wallet2 me-1"></i> Chính sách tiền lương</span>
            </div>
            <h1 class="catalog-title h2 mb-1 text-white">Cấu Hình Khoản Lương & Đãi Ngộ</h1>
            <p class="text-white-50 mb-0">Quản lý định mức phụ cấp chuyên cần, xăng xe, thưởng doanh thu và các khoản giảm trừ.</p>
        </div>
        <div class="catalog-command-actions position-relative" style="z-index: 2;">
            <button type="button" class="btn btn-light fw-bold rounded-3 px-3 position-relative shadow-sm hover-lift" data-bs-toggle="modal" data-bs-target="#createCauHinhKhoanLuongModal">
                <i class="bi bi-plus-lg me-1 text-primary"></i> Thêm khoản lương
            </button>
        </div>
    </section>

    <!-- 4 TABS LIÊN THÔNG DANH MỤC -->
    <partial name="_CatalogNavTabs" />

    <partial name="_CatalogAlerts" />

    <!-- 3 BENTO MINI KPI SUMMARY STATS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-wallet2"></i></div>
                <div>
                    <span class="catalog-kpi-label">Phụ cấp định kỳ</span>
                    <h3 class="catalog-kpi-value">@(ViewBag.PhuCapCount ?? 0) <small>khoản</small></h3>
                    <p class="catalog-kpi-desc">Trách nhiệm, xăng xe, độc hại, ca đêm</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-gift-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Khoản thưởng khuyến khích</span>
                    <h3 class="catalog-kpi-value">@(ViewBag.ThuongCount ?? 0) <small>khoản</small></h3>
                    <p class="catalog-kpi-desc">Thưởng KPI, dịch vụ khách hàng 5 sao</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--deduction shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-dash-circle-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Khấu trừ & Phạt kỷ luật</span>
                    <h3 class="catalog-kpi-value">@(ViewBag.KhauTruCount ?? 0) <small>khoản</small></h3>
                    <p class="catalog-kpi-desc">Đi trễ, vi phạm đồng phục, kỷ luật</p>
                </div>
            </div>
        </div>
    </div>

    <!-- PRINT ONLY HEADER (A4) -->
    <div class="catalog-print-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 style="font-size: 16pt; font-weight: 800; margin: 0; color: #0f172a;">THE OVERTIME HOTEL</h2>
                <small style="color: #64748b; text-transform: uppercase; letter-spacing: 1px;">Hệ Thống Quản Trị Nhân Sự &amp; Tiền Lương 24/7</small>
            </div>
            <div style="text-align: right;">
                <h3 style="font-size: 13pt; font-weight: 700; margin: 0; color: #1e3a8a;">BẢNG CẤU HÌNH KHOẢN LƯƠNG &amp; ĐÃI NGỘ</h3>
                <small style="color: #64748b;">Thời điểm xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
        </div>
    </div>

    <!-- TABLE WORKSPACE CARD -->
    <section class="catalog-card shadow-sm">
        <div class="catalog-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
            <form method="get" class="catalog-filter-form d-flex flex-wrap gap-2 flex-grow-1 align-items-center">
                <div class="catalog-search-wrapper flex-grow-1" style="min-width: 220px;">
                    <i class="bi bi-search catalog-search-icon" aria-hidden="true"></i>
                    <input name="keyword" value="@ViewBag.Keyword" class="form-control catalog-search" placeholder="Tìm theo tên khoản hoặc mô tả..." aria-label="Tìm kiếm khoản lương" />
                    <kbd class="catalog-search-shortcut" title="Phím tắt tìm kiếm">Ctrl K</kbd>
                </div>
                <div style="min-width: 170px;">
                    <select name="type" class="form-select catalog-search" aria-label="Lọc theo loại khoản">
                        <option value="">-- Tất cả loại khoản --</option>
                        <option value="PHU_CAP" selected="@(ViewBag.Type == "PHU_CAP")">Phụ cấp (+)</option>
                        <option value="THUONG" selected="@(ViewBag.Type == "THUONG")">Thưởng (+)</option>
                        <option value="KHAU_TRU" selected="@(ViewBag.Type == "KHAU_TRU")">Khấu trừ / Phạt (-)</option>
                    </select>
                </div>
                <button type="button" class="btn btn-outline-danger rounded-3 px-3 text-nowrap @(string.IsNullOrWhiteSpace(ViewBag.Keyword as string) && string.IsNullOrWhiteSpace(ViewBag.Type as string) ? "d-none" : "")" data-catalog-reset title="Xóa nhanh từ khóa & đặt lại" aria-label="Xóa bộ lọc">
                    <i class="bi bi-x-lg me-1"></i>Xóa
                </button>
            </form>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-export="KhoanLuong" title="Xuất danh sách khoản lương ra file CSV" aria-label="Xuất CSV">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Xuất CSV
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-print title="In danh sách khoản lương chuẩn A4" aria-label="In danh mục">
                    <i class="bi bi-printer text-primary me-1"></i> In danh mục
                </button>
                <span class="catalog-badge text-nowrap" data-catalog-count title="Số lượng khoản lương">
                    <i class="bi bi-wallet2 me-1"></i>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Keyword as string) || !string.IsNullOrWhiteSpace(ViewBag.Type as string))
                    {
                        <span>@Model.Count / @ViewBag.Total</span> <span class="d-none d-sm-inline">khoản</span>
                    }
                    else
                    {
                        <span>@ViewBag.Total</span> <span class="d-none d-sm-inline">khoản</span>
                    }
                </span>
            </div>
        </div>

        <div class="catalog-loading" data-catalog-loading>
            <span class="spinner-border spinner-border-sm text-primary"></span>
            <strong>Đang cập nhật danh mục khoản lương...</strong>
        </div>

        <div class="table-responsive" data-catalog-results>
            <table class="table catalog-table" data-export-table="Danh_Sach_Khoan_Luong">
                <thead>
                    <tr>
                        <th style="width: 80px" class="text-center">Mã</th>
                        <th>Tên khoản lương</th>
                        <th style="width: 160px">Phân loại</th>
                        <th style="width: 190px">Định mức mặc định</th>
                        <th>Điều kiện áp dụng & Ghi chú</th>
                        <th class="text-end" style="width: 140px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="catalog-empty">
                            <div class="catalog-empty-state">
                                <div class="catalog-empty-icon"><i class="bi bi-wallet2"></i></div>
                                <h4>Không tìm thấy khoản lương</h4>
                                <p class="text-muted">Không có cấu hình khoản phụ cấp/thưởng/phạt nào khớp với bộ lọc.</p>
                                <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-catalog-reset>
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
                                    </button>
                                    <button type="button" class="btn btn-hotel-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createCauHinhKhoanLuongModal">
                                        <i class="bi bi-plus-lg me-1"></i> Thêm khoản lương mới
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var isBonus = item.LoaiKhoan == "THUONG";
                        var isDeduction = item.LoaiKhoan == "KHAU_TRU";

                        var badgeClass = isBonus ? "bg-success-subtle text-success border border-success-subtle" : isDeduction ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-primary-subtle text-primary border border-primary-subtle";
                        var typeLabel = isBonus ? "Thưởng khích lệ" : isDeduction ? "Khấu trừ / Kỷ luật" : "Phụ cấp công việc";
                        var payIcon = isBonus ? "bi-gift-fill" : isDeduction ? "bi-dash-circle-fill" : "bi-wallet2";
                        var payIconClass = isBonus ? "catalog-icon--bonus" : isDeduction ? "catalog-icon--deduction" : "catalog-icon--allowance";
                        var sign = isDeduction ? "-" : "+";
                        var amountColor = isBonus ? "text-success" : isDeduction ? "text-danger" : "text-primary";

                        var usageCount = item.ChiTietPhieuLuongs?.Count ?? 0;

                        <tr>
                            <td class="text-center text-muted fw-semibold">#@item.MaKhoan</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="catalog-icon @payIconClass shadow-sm">
                                        <i class="bi @payIcon"></i>
                                    </span>
                                    <div>
                                        <strong class="d-block text-dark fs-6 font-serif">@item.TenKhoan</strong>
                                        <small class="text-muted">Mã chính sách lương OverTime</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @badgeClass fw-bold px-2 py-1">
                                    <i class="bi @payIcon me-1"></i>@typeLabel
                                </span>
                            </td>
                            <td>
                                <div class="catalog-amount-box @amountColor">
                                    <span class="catalog-amount-sign">@sign</span>
                                    <strong class="catalog-amount-number">@item.GiaTriMacDinh.ToString("N0")</strong>
                                    <small class="catalog-amount-currency">₫</small>
                                </div>
                            </td>
                            <td class="text-muted" style="max-width: 320px;">
                                <span class="d-inline-block text-truncate" style="max-width: 300px;" title="@item.MoTa">
                                    @(item.MoTa ?? "Áp dụng định kỳ theo quy chế khách sạn.")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.MaKhoan" class="btn btn-sm btn-outline-primary rounded-3 me-1" title="Chỉnh sửa khoản lương" data-catalog-modal data-catalog-modal-title="Chỉnh sửa khoản lương">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                @if (usageCount > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 opacity-50" disabled title="Không thể xóa: khoản này đã được áp dụng trong @usageCount phiếu lương.">
                                        <i class="bi bi-lock-fill"></i>
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Delete" asp-route-id="@item.MaKhoan" method="post" class="d-inline catalog-delete-form" data-catalog-name="@item.TenKhoan">
                                        <button class="btn btn-sm btn-outline-danger rounded-3" title="Xóa khoản lương"><i class="bi bi-trash3"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<!-- MODAL THÊM KHOẢN LƯƠNG MỚI -->
<div class="modal fade" id="createCauHinhKhoanLuongModal" tabindex="-1" aria-labelledby="createCauHinhKhoanLuongModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="catalog-icon shadow-sm"><i class="bi bi-cash-coin"></i></span>
                    <div>
                        <div class="text-uppercase small text-primary fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Chính sách tiền lương khách sạn</div>
                        <h2 class="modal-title h5 mb-0 font-serif" id="createCauHinhKhoanLuongModalLabel">Thêm Khoản Lương Mới</h2>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-floating mb-3">
                        <input name="TenKhoan" class="form-control" placeholder="Tên khoản" maxlength="150" required />
                        <label>Tên khoản lương <span class="text-danger">*</span></label>
                    </div>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select name="LoaiKhoan" class="form-select">
                                    <option value="PHU_CAP">Phụ cấp (+)</option>
                                    <option value="THUONG">Thưởng khích lệ (+)</option>
                                    <option value="KHAU_TRU">Khấu trừ / Phạt (-)</option>
                                </select>
                                <label>Loại khoản</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input id="modalGiaTriMacDinhInput" name="GiaTriMacDinh" type="number" min="0" step="1000" class="form-control" value="500000" placeholder="Giá trị mặc định" required />
                                <label>Giá trị mặc định (VNĐ)</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 ps-1">
                        <small class="text-muted d-block mb-1 fw-semibold"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Chọn nhanh định mức phổ biến:</small>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-1 px-2" style="font-size: 0.75rem;" onclick="document.getElementById('modalGiaTriMacDinhInput').value = 100000">100.000 ₫</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-1 px-2" style="font-size: 0.75rem;" onclick="document.getElementById('modalGiaTriMacDinhInput').value = 200000">200.000 ₫</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary rounded-pill py-1 px-2" style="font-size: 0.75rem;" onclick="document.getElementById('modalGiaTriMacDinhInput').value = 500000">500.000 ₫</button>
                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill py-1 px-2 fw-semibold" style="font-size: 0.75rem;" onclick="document.getElementById('modalGiaTriMacDinhInput').value = 1000000">1.000.000 ₫</button>
                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill py-1 px-2 fw-semibold" style="font-size: 0.75rem;" onclick="document.getElementById('modalGiaTriMacDinhInput').value = 2000000">2.000.000 ₫</button>
                            <button type="button" class="btn btn-xs btn-outline-success rounded-pill py-1 px-2 fw-bold" style="font-size: 0.75rem;" onclick="document.getElementById('modalGiaTriMacDinhInput').value = 5000000">5.000.000 ₫</button>
                        </div>
                    </div>
                    <div class="form-floating mb-2">
                        <textarea name="MoTa" class="form-control" placeholder="Mô tả" maxlength="255" style="height:100px"></textarea>
                        <label>Mô tả / Điều kiện áp dụng chính sách</label>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-hotel-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i>Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>