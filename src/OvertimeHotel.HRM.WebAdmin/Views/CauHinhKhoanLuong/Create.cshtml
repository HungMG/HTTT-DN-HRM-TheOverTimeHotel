@model OvertimeHotel.HRM.Core.Models.CauHinhKhoanLuong
@{ ViewData["Title"] = "Thêm khoản lương"; }
<div class="catalog-page">
    <section class="catalog-hero mb-4"><div class="catalog-eyebrow">Danh mục hệ thống</div><h1 class="catalog-title h2 mb-1">Thêm khoản lương</h1><p class="text-white-50 mb-0">Khai báo phụ cấp, thưởng hoặc khoản khấu trừ mới.</p></section>
    <form asp-action="Create" method="post" class="catalog-card catalog-form-card">
        <div class="d-flex align-items-center gap-3 mb-4"><span class="catalog-icon"><i class="bi bi-cash-coin"></i></span><div><h2 class="h5 fw-bold mb-1">Thông tin khoản lương</h2><small class="text-muted">Giá trị này sẽ là mức mặc định khi tính lương.</small></div></div>
        <partial name="_Form" model="Model" />
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }