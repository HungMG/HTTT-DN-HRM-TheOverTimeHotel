@model OvertimeHotel.HRM.Core.Models.CauHinhKhoanLuong
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="form-floating mb-3">
    <input asp-for="TenKhoan" class="form-control" placeholder="Tên khoản" maxlength="150" />
    <label asp-for="TenKhoan">Tên khoản lương <span class="text-danger">*</span></label>
    <span asp-validation-for="TenKhoan" class="text-danger small"></span>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="form-floating"><select asp-for="LoaiKhoan" class="form-select"><option value="PHU_CAP">Phụ cấp</option><option value="THUONG">Thưởng</option><option value="KHAU_TRU">Khấu trừ / Phạt</option></select><label asp-for="LoaiKhoan">Loại khoản</label></div>
        <span asp-validation-for="LoaiKhoan" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <div class="form-floating"><input asp-for="GiaTriMacDinh" type="number" min="0" step="1000" class="form-control" placeholder="Giá trị mặc định" /><label asp-for="GiaTriMacDinh">Giá trị mặc định (VNĐ)</label></div>
        <span asp-validation-for="GiaTriMacDinh" class="text-danger small"></span>
    </div>
</div>
<div class="form-floating mb-4">
    <textarea asp-for="MoTa" class="form-control" placeholder="Mô tả" maxlength="255" style="height:120px"></textarea><label asp-for="MoTa">Mô tả / Điều kiện áp dụng</label>
    <span asp-validation-for="MoTa" class="text-danger small"></span>
</div>
<div class="d-flex justify-content-end gap-2">
    <a asp-action="Index" class="btn btn-light border rounded-3 px-4"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    <button class="btn btn-hotel-primary px-4"><i class="bi bi-check2-circle me-1"></i> Lưu thông tin</button>
</div>