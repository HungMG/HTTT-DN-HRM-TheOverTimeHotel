@model OvertimeHotel.HRM.Core.Models.PhongBan
@{
    ViewData["Title"] = "Thêm phòng ban";
}
<div class="catalog-page">
    <form asp-action="Create" method="post" class="catalog-card catalog-form-card">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="catalog-icon"><i class="bi bi-building-add"></i></span>
            <div><h2 class="h5 fw-bold mb-1">Thông tin phòng ban</h2><small class="text-muted">Các trường có dấu * là bắt buộc.</small></div>
        </div>
        <partial name="_Form" model="Model" />
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }