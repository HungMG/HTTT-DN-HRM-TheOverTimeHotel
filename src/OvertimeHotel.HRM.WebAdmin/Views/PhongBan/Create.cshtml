@model OvertimeHotel.HRM.Core.Models.PhongBan
@{
    ViewData["Title"] = "Thêm phòng ban";
}
<div class="catalog-page">
    <section class="catalog-hero mb-4">
        <div class="catalog-eyebrow">Danh mục hệ thống</div>
        <h1 class="catalog-title h2 mb-1">Thêm phòng ban</h1>
        <p class="text-white-50 mb-0">Khai báo đơn vị mới trong cơ cấu tổ chức khách sạn.</p>
    </section>
    <form asp-action="Create" method="post" class="catalog-card catalog-form-card">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="catalog-icon"><i class="bi bi-building-add"></i></span>
            <div><h2 class="h5 fw-bold mb-1">Thông tin phòng ban</h2><small class="text-muted">Các trường có dấu * là bắt buộc.</small></div>
        </div>
        <partial name="_Form" model="Model" />
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }