@using OvertimeHotel.HRM.WebAdmin.Security
@model OvertimeHotel.HRM.WebAdmin.Models.DepartmentDetailsViewModel
@{
    var canViewEmployees = User.HasPermission(PermissionCodes.ManageEmployees);
}

<section data-department-content>
    <div class="d-flex align-items-center gap-3 mb-3">
        <span class="catalog-icon catalog-icon--department" aria-hidden="true"><i class="bi bi-building-fill"></i></span>
        <div>
            <h3 class="h5 font-serif mb-1">@Model.Department.TenPhongBan</h3>
            <span class="text-muted small">Mã phòng ban: #@Model.Department.MaPhongBan</span>
        </div>
    </div>
    <p class="text-muted text-break">@(string.IsNullOrWhiteSpace(Model.Department.MoTa) ? "Chưa có mô tả chức năng và nhiệm vụ." : Model.Department.MoTa)</p>

    <h3 class="h6 mt-4">Chức vụ trong phòng ban (@Model.Positions.Count)</h3>
    <p class="small text-muted">Mở từng chức vụ để xem nhân viên đang làm việc tại phòng ban này. Chức vụ dùng chung được áp dụng cho mọi phòng ban.</p>
    @if (!canViewEmployees)
    {
        <p class="alert alert-secondary small">Bạn không có quyền xem danh sách nhân viên.</p>
    }
    @if (Model.Positions.Count == 0)
    {
        <p class="text-muted border rounded-3 p-3 mb-0">Phòng ban chưa có chức vụ riêng hoặc chức vụ dùng chung.</p>
    }
    @foreach (var position in Model.Positions)
    {
        var panelId = $"department-{Model.Department.MaPhongBan}-position-{position.MaChucVu}";
        <div class="border rounded-3 mb-2 overflow-hidden">
            <h4 class="h6 mb-0">
                <button type="button" class="btn btn-light w-100 text-start d-flex align-items-center justify-content-between gap-2 p-3"
                        data-position-toggle aria-expanded="false" aria-controls="@panelId">
                    <span>@position.TenChucVu @if (position.MaPhongBan == null) { <small class="text-muted">(Dùng chung)</small> }</span>
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </button>
            </h4>
            <div id="@panelId" class="p-3 border-top" hidden data-position-employees
                 data-employees-url="@Url.Action("PositionEmployees", new { id = Model.Department.MaPhongBan, positionId = position.MaChucVu })"
                 data-can-view-employees="@(canViewEmployees ? "true" : "false")">
                @if (!string.IsNullOrWhiteSpace(position.MoTa))
                {
                    <p class="small text-muted text-break">@position.MoTa</p>
                }
                <div data-employee-list aria-live="polite"></div>
            </div>
        </div>
    }
</section>
