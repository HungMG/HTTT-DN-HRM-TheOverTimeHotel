<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · The OverTime Hotel</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OvertimeHotel.HRM.WebAdmin.styles.css" asp-append-version="true" />
    <style>
        .user-header-pill {
            background: linear-gradient(135deg, #FFFFFF 0%, #F8FAFC 100%);
            border: 1.5px solid #CBD5E1;
            border-radius: 999px;
            padding: 4px 14px 4px 6px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
        }
        .user-header-pill:hover, .user-header-pill:focus {
            border-color: #D4AF37;
            background: #FFFFFF;
            box-shadow: 0 6px 18px rgba(212, 175, 55, 0.25);
            transform: translateY(-1px);
        }
        .user-avatar-badge {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #1E3A8A 0%, #2563EB 100%);
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
            border: 2px solid #FDE047;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
            flex-shrink: 0;
        }
        .user-login-cta {
            background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%);
            border: 1.5px solid #D4AF37;
            color: #FFFFFF !important;
            border-radius: 999px;
            padding: 6px 18px 6px 8px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
            font-size: 0.88rem;
            text-decoration: none;
            transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
        }
        .user-login-cta:hover {
            transform: translateY(-2px);
            border-color: #FDE047;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.35);
            background: linear-gradient(135deg, #1E293B 0%, #2563EB 100%);
        }
        .user-login-icon-box {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(253, 224, 71, 0.2);
            border: 1px solid #FDE047;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #FDE047;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 py-2">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand hotel-nav-brand ps-2 ps-lg-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="hotel-nav-logo"><img src="~/images/the-overtime-hotels-logo.png" asp-append-version="true" alt="The OverTime Hotels" /></span>
                    <span>The OverTime Hotels</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1 text-primary"></i> Dashboard
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.HasClaim("Permission", "QL_TAI_KHOAN")))
                        {
                        }
                        @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.HasClaim("Permission", "SAO_LUU_CSDL")))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-semibold px-3" asp-area="" asp-controller="UserAccounts" asp-action="Index">
                                    <i class="bi bi-person-gear me-1 text-danger"></i> Tài Khoản
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-semibold px-3" asp-area="" asp-controller="Backup" asp-action="Index">
                                    <i class="bi bi-database-check me-1 text-warning"></i> Sao Lưu CSDL
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold px-3" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check me-1 text-secondary"></i> Chính Sách
                            </a>
                        </li>
                    </ul>

                    <!-- KHU VỰC THÔNG TIN TÀI KHOẢN ĐĂNG NHẬP -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
                            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
                            <li class="nav-item dropdown">
                                <a class="user-header-pill dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar-badge">
                                        @(fullName != null && fullName.Length > 0 ? fullName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <div class="text-start d-none d-md-block" style="line-height: 1.2;">
                                        <div class="fw-bold small text-dark">@fullName</div>
                                        <span class="badge @(role == "Admin" ? "bg-danger" : role == "HR" ? "bg-primary" : "bg-warning text-dark")" style="font-size: 0.65rem; border-radius: 999px; padding: 2px 8px;">@role</span>
                                    </div>
                                    <i class="bi bi-chevron-down text-muted ms-1" style="font-size: 0.72rem;"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2" style="min-width: 250px;">
                                    <li><h6 class="dropdown-header">Tài khoản: @User.Identity.Name (@role)</h6></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2 fw-semibold" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-circle text-primary"></i> Thông Tin Cá Nhân &amp; Đổi MK
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                                            <i class="bi bi-speedometer2 text-muted"></i> Bàn Làm Việc Quản Trị
                                        </a>
                                    </li>
                                    @if (role == "Admin" || User.HasClaim("Permission", "QL_TAI_KHOAN"))
                                    {
                                    }
                                    @if (role == "Admin" || User.HasClaim("Permission", "SAO_LUU_CSDL"))
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="UserAccounts" asp-action="Index">
                                                <i class="bi bi-person-gear text-danger"></i> Quản Trị Tài Khoản
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center gap-2" asp-controller="Backup" asp-action="Index">
                                                <i class="bi bi-shield-check text-warning"></i> Sao Lưu &amp; Phục Hồi CSDL
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger d-flex align-items-center gap-2" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Đăng Xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="user-login-cta" asp-controller="Account" asp-action="Login">
                                    <span class="user-login-icon-box"><i class="bi bi-box-arrow-in-right"></i></span>
                                    <span>Đăng Nhập Quản Trị</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - The OverTime Hotel - <a asp-area="" asp-controller="Home" asp-action="Privacy">Chính Sách</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/accounts.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
