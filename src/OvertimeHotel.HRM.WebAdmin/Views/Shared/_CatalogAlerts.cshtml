@if (TempData["Success"] is string success)
{
    <div class="d-none" data-catalog-toast="success">
        <span data-catalog-toast-message>@success</span>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="d-none" data-catalog-toast="danger">
        <span data-catalog-toast-message>@error</span>
    </div>
}