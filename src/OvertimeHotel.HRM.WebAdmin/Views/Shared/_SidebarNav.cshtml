@using OvertimeHotel.HRM.Core.Enums
@using OvertimeHotel.HRM.WebAdmin.Security
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    bool IsCurrent(string controller) =>
        currentController.Equals(controller, StringComparison.OrdinalIgnoreCase);

    bool IsCurrentAction(string controller, string action) =>
        IsCurrent(controller) && currentAction.Equals(action, StringComparison.OrdinalIgnoreCase);

    // Mỗi nhóm sidebar chỉ hiện khi người dùng có ít nhất một quyền trong nhóm đó.
    var canViewPeople = User.HasPermission(PermissionCodes.ManageEmployees)
                        || User.HasPermission(PermissionCodes.ManageContracts)
                        || User.HasPermission(PermissionCodes.ManageCatalog);
    var canViewShift = User.HasPermission(PermissionCodes.AssignShifts)
                       || User.HasPermission(PermissionCodes.ManageCatalog)
                       || User.HasPermission(PermissionCodes.ViewDepartmentAttendance);
    var canViewPayroll = User.HasPermission(PermissionCodes.CalculatePayroll)
                         || User.HasPermission(PermissionCodes.ExportPayslipPdf);
    var canViewApproval = User.HasPermission(PermissionCodes.ApproveLeave)
                          || User.HasPermission(PermissionCodes.ApproveResignation)
                          || User.HasPermission(PermissionCodes.ApproveOvertime);
    var canViewAccounts = User.HasPermission(PermissionCodes.ManageAccounts)
                          || User.HasPermission(PermissionCodes.ManagePermissions)
                          || User.HasPermission(PermissionCodes.ProvisionMobileAccount);
    var canViewSystem = User.HasPermission(PermissionCodes.BackupDatabase)
                        || User.HasPermission(PermissionCodes.ManageCatalog);

    var hasAnyGroup = canViewPeople || canViewShift || canViewPayroll || canViewApproval
                      || canViewAccounts || canViewSystem;

    var topRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
    var topName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Quản trị viên";
    var initial = !string.IsNullOrEmpty(topName) ? topName.Substring(0, 1).ToUpperInvariant() : "A";
}

<aside class="app-sidebar">
    <a class="app-sidebar-brand" asp-controller="Home" asp-action="Index">
        <span class="app-sidebar-logo">
            <img src="~/images/the-overtime-hotels-logo.png" asp-append-version="true" alt="The OverTime Hotels" />
        </span>
        <span class="app-sidebar-brand-text">
            <span class="app-sidebar-brand-name">The OverTime</span>
            <span class="app-sidebar-brand-sub">Hotels Management</span>
        </span>
    </a>

    <nav class="app-sidebar-nav" aria-label="Điều hướng chính">
        <!-- 1. TỔNG QUAN -->
        <div class="app-sidebar-section-label">Tổng quan</div>
        <a class="app-nav-item@(IsCurrent("Home") && !IsCurrentAction("Home", "Privacy") ? " is-active" : "")"
           asp-controller="Home" asp-action="Index">
            <i class="bi bi-speedometer2"></i><span>Bàn làm việc</span>
        </a>

        @if (hasAnyGroup)
        {
            <!-- 2. NHÂN SỰ & HỢP ĐỒNG -->
            @if (canViewPeople)
            {
                <div class="app-sidebar-section-label">Nhân sự &amp; HĐLĐ</div>
                <a class="app-nav-item@(IsCurrent("NhanVien") ? " is-active" : "")"
                   asp-controller="NhanVien" asp-action="Index">
                    <i class="bi bi-people-fill"></i><span>Hồ sơ nhân viên</span>
                </a>
                <a class="app-nav-item@(IsCurrent("HopDong") ? " is-active" : "")"
                   asp-controller="HopDong" asp-action="Index">
                    <i class="bi bi-file-earmark-text-fill"></i><span>Hợp đồng lao động</span>
                </a>
                <a class="app-nav-item@(IsCurrent("PhongBan") || IsCurrent("ChucVu") ? " is-active" : "")"
                   asp-controller="PhongBan" asp-action="Index">
                    <i class="bi bi-building"></i><span>Phòng ban &amp; Chức vụ</span>
                </a>
            }

            <!-- 3. CA LÀM & CHẤM CÔNG 24/7 -->
            @if (canViewShift)
            {
                <div class="app-sidebar-section-label">Chấm công 24/7</div>
                <a class="app-nav-item@(IsCurrent("PhanCa") ? " is-active" : "")"
                   asp-controller="PhanCa" asp-action="Index">
                    <i class="bi bi-calendar-week-fill"></i><span>Ca &amp; Lịch làm việc</span>
                </a>
                <a class="app-nav-item@(IsCurrent("ChamCong") ? " is-active" : "")"
                   asp-controller="ChamCong" asp-action="Index">
                    <i class="bi bi-fingerprint"></i><span>Nhật ký chấm công</span>
                </a>
            }

            @if (canViewApproval)
            {
                <span class="app-nav-item is-disabled d-flex align-items-center justify-content-between" aria-disabled="true" title="Đang đồng bộ với Mobile App">
                    <span class="d-flex align-items-center gap-2"><i class="bi bi-file-earmark-check"></i><span>Đơn từ trực tuyến</span></span>
                    <span class="app-nav-badge">7</span>
                </span>
            }

            <!-- 4. LƯƠNG & BÁO CÁO -->
            @if (canViewPayroll)
            {
                <div class="app-sidebar-section-label">Lương &amp; Báo cáo</div>
                <a class="app-nav-item@(IsCurrent("CauHinhLuong") ? " is-active" : "")"
                   asp-controller="CauHinhLuong" asp-action="Index">
                    <i class="bi bi-wallet2"></i><span>Bảng tính lương</span>
                </a>
                <a class="app-nav-item@(IsCurrent("CauHinhKhoanLuong") ? " is-active" : "")"
                   asp-controller="CauHinhKhoanLuong" asp-action="Index">
                    <i class="bi bi-sliders"></i><span>Khoản lương &amp; Phụ cấp</span>
                </a>
            }

            <!-- 5. HỆ THỐNG & TÀI KHOẢN -->
            @if (canViewAccounts || canViewSystem)
            {
                <div class="app-sidebar-section-label">Hệ thống</div>
                @if (canViewAccounts)
                {
                    <a class="app-nav-item@(IsCurrent("UserAccounts") ? " is-active" : "")"
                       asp-controller="UserAccounts" asp-action="Index">
                        <i class="bi bi-person-gear"></i><span>Tài khoản &amp; RBAC</span>
                    </a>
                }

                @if (User.HasPermission(PermissionCodes.ManageAccounts) ||
                     User.HasPermission(PermissionCodes.ProvisionMobileAccount))
                {
                    <a class="app-nav-item@(IsCurrent("YeuCauTaiKhoan") ? " is-active" : "")"
                       asp-controller="YeuCauTaiKhoan" asp-action="Index">
                        <i class="bi bi-inboxes"></i><span>Hàng đợi cấp tài khoản</span>
                    </a>
                }

                @if (canViewSystem)
                {
                    <a class="app-nav-item@(IsCurrent("Backup") ? " is-active" : "")"
                       asp-controller="Backup" asp-action="Index">
                        <i class="bi bi-shield-check"></i><span>Sao lưu CSDL</span>
                    </a>
                }
            }
        }
    </nav>

    <!-- THẺ TRẠNG THÁI VẬN HÀNH KHÁCH SẠN GÓC DƯỚI -->
    <div class="app-sidebar-presence-card">
        <div class="app-presence-header">
            <span>Hôm nay, @DateTime.Today.ToString("dd/MM/yyyy")</span>
            <span class="app-presence-pulse" title="Hệ thống 24/7 đang hoạt động"></span>
        </div>
        <div class="app-presence-stat">
            <span>24/7 Vận hành</span>
        </div>
        <div class="app-presence-sub">The OverTime Hotel 5★</div>
    </div>

    <!-- THẺ USER FOOTER SIDEBAR -->
    <div class="app-sidebar-footer">
        <div class="app-sidebar-user-card">
            <span class="app-sidebar-user-avatar">@initial</span>
            <div class="app-sidebar-user-info">
                <div class="app-sidebar-user-name" title="@topName">@topName</div>
                <div class="app-sidebar-user-role">@topRole</div>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="app-sidebar-logout-btn" asp-controller="Account" asp-action="Logout" title="Đăng xuất">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            }
        </div>
    </div>
</aside>
