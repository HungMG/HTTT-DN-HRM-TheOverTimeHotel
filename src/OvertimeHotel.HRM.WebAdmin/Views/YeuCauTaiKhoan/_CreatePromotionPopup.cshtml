@model CreatePromotionRequestViewModel

@if (ViewData["PromotionAmendmentWarning"] is string amendmentWarning)
{
    <div class="text-center py-3" role="alertdialog" aria-labelledby="promotionDeniedTitle" aria-describedby="promotionDeniedMessage" data-promotion-denied>
        <i class="bi bi-exclamation-circle text-warning" style="font-size: 3rem;" aria-hidden="true"></i>
        <h3 class="h5 fw-bold mt-3" id="promotionDeniedTitle">Chưa thể đề xuất thăng chức</h3>
        <p class="text-muted mb-4" id="promotionDeniedMessage">@amendmentWarning</p>
        <button type="button" class="btn btn-hotel-primary rounded-pill px-4" data-promotion-denied-back>Đã hiểu</button>
    </div>
}
else
{
<form asp-action="CreatePromotion" asp-route-popup="true" method="post" data-promotion-form>
    @Html.AntiForgeryToken()
    <div class="alert alert-info rounded-3">
        Cần lập phụ lục đổi chức vụ sang Quản lý và chờ phụ lục có hiệu lực trước khi gửi đề xuất sang IT.
    </div>
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    <div class="mb-3">
        <label asp-for="EmployeeId" class="form-label fw-semibold">Nhân viên đề xuất <span class="text-danger">*</span></label>
        <select asp-for="EmployeeId" asp-items="Model.EligibleEmployees" class="form-select" data-promotion-employee>
            <option value="">-- Chọn nhân viên --</option>
        </select>
        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ContractId" class="form-label fw-semibold">Hợp đồng làm căn cứ <span class="text-danger">*</span></label>
        <select asp-for="ContractId" class="form-select" data-promotion-contract>
            <option value="">-- Chọn hợp đồng --</option>
            @foreach (var contract in Model.ActiveContracts)
            {
                <option value="@contract.ContractId" data-employee-id="@contract.EmployeeId">@contract.Label</option>
            }
        </select>
        <span asp-validation-for="ContractId" class="text-danger small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Reason" class="form-label fw-semibold">Lý do đề xuất <span class="text-danger">*</span></label>
        <textarea asp-for="Reason" class="form-control" rows="3" required></textarea>
        <span asp-validation-for="Reason" class="text-danger small"></span>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-promotion-cancel>Quay lại</button>
        <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">Gửi yêu cầu thăng chức</button>
    </div>
</form>

}
