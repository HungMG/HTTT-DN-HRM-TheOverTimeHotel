@model YeuCauTaiKhoanIndexViewModel
@using System.Security.Claims
@using OvertimeHotel.HRM.Core.Policies
@using OvertimeHotel.HRM.WebAdmin.Security
@{
    ViewData["Title"] = "Hàng đợi cấp tài khoản";
    var currentRole = User.FindFirstValue(ClaimTypes.Role);
    var canProcess = LeaveApprovalPolicy.CanProcessAccountRequest(currentRole);
}

<div class="account-workspace account-workspace--bleed" data-request-workspace>
    <!-- THANH THAO TÁC HỆ THỐNG -->
    <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 mb-4">
        <a asp-controller="UserAccounts" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 fw-semibold hover-lift" style="font-size: 0.82rem;">
            <i class="bi bi-people me-1"></i> Danh Sách Tài Khoản
        </a>
        @if (Model.CanSubmitRequest)
        {
            <a asp-action="Create" class="btn btn-sm btn-hotel-primary rounded-pill px-3.5 py-1.5 fw-bold hover-lift shadow-sm text-white" style="font-size: 0.82rem;">
                <i class="bi bi-plus-circle-fill me-1"></i> Gửi Yêu Cầu Cấp Tài Khoản
            </a>
        }
    </div>

    <!-- TOAST NOTIFICATION STACK -->
    <div class="account-popup-stack" aria-live="polite" aria-atomic="true">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="account-popup account-popup--success" data-account-toast role="status">
                <div class="account-popup-icon"><i class="bi bi-check2"></i></div>
                <div class="account-popup-copy"><small>Thao tác thành công</small><strong>@successMessage</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="account-popup account-popup--danger" data-account-toast role="alert">
                <div class="account-popup-icon"><i class="bi bi-exclamation-lg"></i></div>
                <div class="account-popup-copy"><small>Không thể thực hiện</small><strong>@errorMessage</strong></div>
                <button type="button" data-account-toast-close aria-label="Đóng thông báo"><i class="bi bi-x-lg"></i></button>
                <span class="account-popup-progress"></span>
            </div>
        }
    </div>

    <!-- WORKFLOW STEPPER BANNER: QUY TRÌNH PHỐI HỢP HR - CNTT - NHÂN VIÊN -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1" style="font-size: 0.72rem;">
                        <i class="bi bi-diagram-3-fill me-1"></i> Quy trình 4 bước
                    </span>
                    <span class="fw-bold text-dark font-serif" style="font-size: 0.88rem;">Phối Hợp Nghiệp Vụ Cấp Tài Khoản</span>
                </div>
                <small class="text-muted d-none d-md-inline" style="font-size: 0.72rem;">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>Chỉ CNTT/Admin có quyền <b>CAP_TAI_KHOAN_MOBILE</b> mới mở được tài khoản Supabase Auth
                </small>
            </div>

            <div class="row g-2 align-items-center">
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-light border border-light-subtle d-flex align-items-center gap-2">
                        <span class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.75rem;">1</span>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.78rem;">Nhân Sự (HR)</div>
                            <small class="text-muted d-block" style="font-size: 0.68rem; line-height: 1.2;">Duyệt HĐLĐ &amp; tạo yêu cầu</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-light border border-light-subtle d-flex align-items-center gap-2">
                        <span class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.75rem;">2</span>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.78rem;">Hàng Đợi Tiếp Nhận</div>
                            <small class="text-muted d-block" style="font-size: 0.68rem; line-height: 1.2;">Đưa vào hàng chờ xử lý</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-light border border-light-subtle d-flex align-items-center gap-2">
                        <span class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.75rem;">3</span>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.78rem;">Bộ Phận CNTT</div>
                            <small class="text-muted d-block" style="font-size: 0.68rem; line-height: 1.2;">Nhận việc &amp; kích hoạt Auth</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="p-2.5 rounded-3 bg-light border border-light-subtle d-flex align-items-center gap-2">
                        <span class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.75rem;">4</span>
                        <div>
                            <div class="fw-bold text-dark" style="font-size: 0.78rem;">Nhân Viên</div>
                            <small class="text-muted d-block" style="font-size: 0.68rem; line-height: 1.2;">Đăng nhập Mobile App</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BENTO 5 THẺ KPI DÀN ĐỀU TRÊN 1 HÀNG -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3 mb-4">
        <!-- 01: TỔNG YÊU CẦU -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 motion-stat position-relative overflow-hidden p-3" style="border-left: 4px solid #1e3a8a !important;">
                <div class="d-flex align-items-center justify-content-between text-muted mb-1">
                    <span class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.8px;">01 / Tổng Yêu Cầu</span>
                    <i class="bi bi-inboxes text-primary" style="font-size: 1.1rem;"></i>
                </div>
                <div class="h2 fw-bold text-dark mb-1 font-serif" data-request-total>@Model.TotalRequests</div>
                <div class="text-muted small" style="font-size: 0.72rem;">Tổng lượt phát sinh</div>
                <div class="motion-stat-track mt-2"><span style="width: 100%; background: #1e3a8a;"></span></div>
            </div>
        </div>

        <!-- 02: CHỜ CNTT -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 motion-stat motion-stat--amber position-relative overflow-hidden p-3" style="border-left: 4px solid #d4af37 !important;">
                <div class="d-flex align-items-center justify-content-between text-muted mb-1">
                    <span class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.8px;">02 / Chờ CNTT</span>
                    <i class="bi bi-hourglass-split" style="color: #d4af37; font-size: 1.1rem;"></i>
                </div>
                <div class="h2 fw-bold text-dark mb-1 font-serif" style="color: #b45309 !important;" data-request-pending>@Model.PendingRequests</div>
                <div class="text-muted small" style="font-size: 0.72rem;">Đang chờ nhận việc</div>
                <div class="motion-stat-track mt-2">
                    <span data-request-pending-track style="width: @(Model.TotalRequests > 0 ? Math.Round(Model.PendingRequests * 100d / Model.TotalRequests) : 0)%; background: #d4af37;"></span>
                </div>
            </div>
        </div>

        <!-- 03: ĐANG XỬ LÝ -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 motion-stat position-relative overflow-hidden p-3" style="border-left: 4px solid #8b5cf6 !important;">
                <div class="d-flex align-items-center justify-content-between text-muted mb-1">
                    <span class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.8px;">03 / Đang Xử Lý</span>
                    <i class="bi bi-person-workspace text-purple" style="font-size: 1.1rem; color: #8b5cf6;"></i>
                </div>
                <div class="h2 fw-bold text-dark mb-1 font-serif" style="color: #7c3aed !important;" data-request-processing>@Model.ProcessingRequests</div>
                <div class="text-muted small" style="font-size: 0.72rem;">CNTT đã nhận việc</div>
                <div class="motion-stat-track mt-2">
                    <span data-request-processing-track style="width: @(Model.TotalRequests > 0 ? Math.Round(Model.ProcessingRequests * 100d / Model.TotalRequests) : 0)%; background: #8b5cf6;"></span>
                </div>
            </div>
        </div>

        <!-- 04: ĐÃ CẤP -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 motion-stat motion-stat--green position-relative overflow-hidden p-3" style="border-left: 4px solid #10b981 !important;">
                <div class="d-flex align-items-center justify-content-between text-muted mb-1">
                    <span class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.8px;">04 / Đã Cấp</span>
                    <i class="bi bi-person-check text-success" style="font-size: 1.1rem;"></i>
                </div>
                <div class="h2 fw-bold text-success mb-1 font-serif" data-request-granted>@Model.GrantedRequests</div>
                <div class="text-muted small" style="font-size: 0.72rem;">Đã mở Auth thành công</div>
                <div class="motion-stat-track mt-2">
                    <span data-request-granted-track style="width: @(Model.TotalRequests > 0 ? Math.Round(Model.GrantedRequests * 100d / Model.TotalRequests) : 0)%; background: #10b981;"></span>
                </div>
            </div>
        </div>

        <!-- 05: TỪ CHỐI -->
        <div class="col">
            <div class="card border-0 shadow-sm rounded-4 h-100 motion-stat motion-stat--red position-relative overflow-hidden p-3" style="border-left: 4px solid #ef4444 !important;">
                <div class="d-flex align-items-center justify-content-between text-muted mb-1">
                    <span class="text-uppercase fw-bold" style="font-size: 0.65rem; letter-spacing: 0.8px;">05 / Từ Chối</span>
                    <i class="bi bi-slash-circle text-danger" style="font-size: 1.1rem;"></i>
                </div>
                <div class="h2 fw-bold text-danger mb-1 font-serif" data-request-rejected>@Model.RejectedRequests</div>
                <div class="text-muted small" style="font-size: 0.72rem;">Không hợp lệ / Trả lại</div>
                <div class="motion-stat-track mt-2">
                    <span data-request-rejected-track style="width: @(Model.TotalRequests > 0 ? Math.Round(Model.RejectedRequests * 100d / Model.TotalRequests) : 0)%; background: #ef4444;"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- THANH BỘ LỌC TOÀN DIỆN (FULL-WIDTH FILTER CARD) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3.5">
            <form method="get" asp-action="Index" class="row g-3 align-items-center" data-request-filter-form>
                <input type="hidden" name="page" value="@Model.PageNumber" data-request-page-input />

                <!-- TÌM KIẾM NHANH -->
                <div class="col-lg-5 col-md-6 col-12">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input asp-for="Keyword" class="form-control border-start-0 bg-light"
                               placeholder="Tìm tên đăng nhập, họ tên nhân viên, hợp đồng..."
                               autocomplete="off" data-request-search-input />
                    </div>
                </div>

                <!-- LỌC THEO TRẠNG THÁI -->
                <div class="col-lg-4 col-md-4 col-12">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                            <i class="bi bi-funnel"></i>
                        </span>
                        <select asp-for="TrangThai" asp-items="Model.StatusOptions"
                                class="form-select border-start-0 bg-light text-dark fw-semibold"
                                data-request-status-select>
                        </select>
                    </div>
                </div>

                <!-- CÁC NÚT THAO TÁC BỘ LỌC -->
                <div class="col-lg-3 col-md-2 col-12 d-flex align-items-center justify-content-end gap-2">
                    <button type="submit" class="btn btn-hotel-primary rounded-3 px-3 py-2 fw-bold text-nowrap hover-lift">
                        <i class="bi bi-funnel-fill me-1"></i> Áp dụng
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-3 py-2 text-nowrap hover-lift" title="Đặt lại bộ lọc" data-request-filter-reset>
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- KHUNG BẢNG DỮ LIỆU HÀNG ĐỢI (IN-PLACE TARGETED CONTAINER) -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
        <!-- OVERLAY LOADING TẠI CHỖ (ZERO FULL-PAGE RELOAD) -->
        <div id="requestLoadingOverlay" class="in-place-loading-overlay d-none">
            <div class="spinner-border text-primary mb-2" role="status" style="width: 2.3rem; height: 2.3rem;">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <div class="fw-bold text-dark small font-serif">Đang cập nhật danh sách yêu cầu...</div>
            <span class="text-muted small" style="font-size: 0.72rem;">Cập nhật cục bộ không chớp giật (In-Place Transition)</span>
        </div>

        <div id="requestTableContainer" class="in-place-enter in-place-container">
            <partial name="_YeuCauTaiKhoanTable" model="Model" />
        </div>
    </div>
</div>

<!-- MODAL XÁC NHẬN TỪ CHỐI YÊU CẦU -->
<dialog class="account-confirm-dialog" data-request-reject-dialog>
    <div class="account-confirm-card">
        <button type="button" class="account-confirm-close" data-request-reject-cancel aria-label="Đóng"><i class="bi bi-x-lg"></i></button>
        <div class="account-confirm-icon"><i class="bi bi-slash-circle"></i></div>
        <small>Xác nhận từ chối</small>
        <h2 data-request-reject-title>Từ chối yêu cầu?</h2>
        <p>Nhân sự sẽ thấy lý do này và có thể sửa rồi gửi lại. Vui lòng nêu rõ lý do để bộ phận nhân sự điều chỉnh hồ sơ.</p>
        <form asp-action="Reject" method="post" data-request-reject-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" data-request-reject-id />
            <label class="account-confirm-reason">
                <span>Lý do từ chối <b>*</b></span>
                <textarea rows="3" maxlength="500" name="lyDo" data-request-reject-reason placeholder="Nhập lý do từ chối yêu cầu (ví dụ: Thiếu thông tin số điện thoại, email trùng lặp...)"></textarea>
                <small data-request-reject-reason-error>Vui lòng nhập lý do trước khi xác nhận.</small>
            </label>
            <div class="account-confirm-actions">
                <button type="button" data-request-reject-cancel>Hủy bỏ</button>
                <button type="submit"><i class="bi bi-check2"></i><span>Xác nhận từ chối</span></button>
            </div>
        </form>
    </div>
</dialog>

@section Scripts {
    <script>
        (() => {
            "use strict";

            const workspace = document.querySelector("[data-request-workspace]");
            if (!workspace) return;

            const filterForm = document.querySelector("[data-request-filter-form]");
            const tableContainer = document.getElementById("requestTableContainer");
            const overlay = document.getElementById("requestLoadingOverlay");
            const toastStack = document.querySelector(".account-popup-stack");
            const rejectDialog = document.querySelector("[data-request-reject-dialog]");
            const rejectForm = document.querySelector("[data-request-reject-form]");
            const rejectIdInput = document.querySelector("[data-request-reject-id]");
            const rejectReason = document.querySelector("[data-request-reject-reason]");
            const rejectReasonError = document.querySelector("[data-request-reject-reason-error]");
            const rejectTitle = document.querySelector("[data-request-reject-title]");

            const animateCountUp = (element, startValue, targetValue, duration = 450) => {
                if (!element) return;
                const startTime = performance.now();
                const updateCount = (currentTime) => {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const easeProgress = 1 - Math.pow(1 - progress, 3);
                    element.textContent = String(Math.round(startValue + (targetValue - startValue) * easeProgress));
                    if (progress < 1) requestAnimationFrame(updateCount);
                };
                requestAnimationFrame(updateCount);
            };

            const showToast = (message, type = "success") => {
                if (!toastStack) return;
                const toast = document.createElement("div");
                toast.className = `account-popup account-popup--${type === "success" ? "success" : "danger"}`;
                toast.dataset.accountToast = "";
                toast.setAttribute("role", type === "success" ? "status" : "alert");

                const iconWrap = document.createElement("div");
                iconWrap.className = "account-popup-icon";
                const icon = document.createElement("i");
                icon.className = type === "success" ? "bi bi-check2" : "bi bi-exclamation-lg";
                iconWrap.append(icon);

                const copy = document.createElement("div");
                copy.className = "account-popup-copy";
                const label = document.createElement("small");
                label.textContent = type === "success" ? "Thao tác thành công" : "Không thể thực hiện";
                const text = document.createElement("strong");
                text.textContent = message;
                copy.append(label, text);

                const close = document.createElement("button");
                close.type = "button";
                close.dataset.accountToastClose = "";
                close.setAttribute("aria-label", "Đóng thông báo");
                const closeIcon = document.createElement("i");
                closeIcon.className = "bi bi-x-lg";
                close.append(closeIcon);

                const progress = document.createElement("span");
                progress.className = "account-popup-progress";
                toast.append(iconWrap, copy, close, progress);
                toastStack.prepend(toast);

                requestAnimationFrame(() => toast.classList.add("is-visible"));
                const closeToast = () => {
                    toast.classList.remove("is-visible");
                    toast.classList.add("is-leaving");
                    setTimeout(() => toast.remove(), 260);
                };
                toast.querySelector("[data-account-toast-close]")?.addEventListener("click", closeToast);
                setTimeout(closeToast, 5200);
            };

            const updateStatistics = (data) => {
                const pairs = [
                    ["[data-request-total]", data.totalRequests],
                    ["[data-request-pending]", data.pendingRequests],
                    ["[data-request-processing]", data.processingRequests],
                    ["[data-request-granted]", data.grantedRequests],
                    ["[data-request-rejected]", data.rejectedRequests]
                ];
                pairs.forEach(([selector, value]) => {
                    const node = document.querySelector(selector);
                    if (!node || value === undefined || value === null) return;
                    animateCountUp(node, Number(node.textContent || 0), Number(value));
                });

                const total = Number(data.totalRequests || 0);
                const tracks = [
                    ["[data-request-pending-track]", data.pendingRequests],
                    ["[data-request-processing-track]", data.processingRequests],
                    ["[data-request-granted-track]", data.grantedRequests],
                    ["[data-request-rejected-track]", data.rejectedRequests]
                ];
                tracks.forEach(([selector, value]) => {
                    const node = document.querySelector(selector);
                    if (!node || value === undefined || value === null) return;
                    node.style.width = `${total > 0 ? Math.round((Number(value) * 100) / total) : 0}%`;
                });

                const resultCount = document.querySelector("[data-request-result-count]");
                if (resultCount && data.totalFilteredRequests !== undefined) {
                    resultCount.textContent = String(data.totalFilteredRequests);
                }

                document.querySelectorAll(".motion-stat").forEach((card, index) => {
                    card.classList.add("kpi-pulse-active");
                    setTimeout(() => card.classList.remove("kpi-pulse-active"), 520 + index * 70);
                });
            };

            const loadRequests = async (overrideUrl = null) => {
                if (!tableContainer) return;

                let requestUrl;
                if (overrideUrl) {
                    requestUrl = new URL(overrideUrl, window.location.origin);
                } else if (filterForm) {
                    requestUrl = new URL(filterForm.action || window.location.href, window.location.origin);
                    const formData = new FormData(filterForm);
                    for (const [key, val] of formData.entries()) {
                        const text = String(val).trim();
                        if (text) requestUrl.searchParams.set(key, text);
                        else requestUrl.searchParams.delete(key);
                    }
                } else {
                    return;
                }

                overlay?.classList.remove("d-none");
                try {
                    const response = await fetch(requestUrl.toString(), {
                        headers: { "Accept": "text/html", "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (response.redirected) {
                        throw new Error("Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.");
                    }
                    if (!response.ok) {
                        throw new Error("Không thể tải danh sách yêu cầu cấp tài khoản.");
                    }

                    tableContainer.innerHTML = await response.text();
                    tableContainer.classList.remove("in-place-enter");
                    void tableContainer.offsetWidth;
                    tableContainer.classList.add("in-place-enter");
                    bindActionForms();

                    const headers = response.headers;
                    updateStatistics({
                        totalRequests: Number(headers.get("X-Total-Requests") || 0),
                        pendingRequests: Number(headers.get("X-Pending-Requests") || 0),
                        processingRequests: Number(headers.get("X-Processing-Requests") || 0),
                        grantedRequests: Number(headers.get("X-Granted-Requests") || 0),
                        rejectedRequests: Number(headers.get("X-Rejected-Requests") || 0),
                        totalFilteredRequests: Number(headers.get("X-Result-Count") || 0)
                    });

                    window.history.replaceState({}, "", requestUrl.toString());

                    window.HotelMotion?.applyEntrance?.(tableContainer);
                    window.HotelMotion?.applyBlurText?.(tableContainer);
                } catch (error) {
                    showToast(error instanceof Error ? error.message : "Lỗi khi lọc yêu cầu.", "danger");
                } finally {
                    overlay?.classList.add("d-none");
                }
            };

            filterForm?.addEventListener("submit", (event) => {
                event.preventDefault();
                const pageInput = filterForm.querySelector("[data-request-page-input]");
                if (pageInput) pageInput.value = "1";
                void loadRequests();
            });

            document.querySelector("[data-request-filter-reset]")?.addEventListener("click", (event) => {
                event.preventDefault();
                if (filterForm) {
                    filterForm.querySelectorAll("input[type='text'], select").forEach((control) => { control.value = ""; });
                    const pageInput = filterForm.querySelector("[data-request-page-input]");
                    if (pageInput) pageInput.value = "1";
                }
                void loadRequests();
            });

            const submitActionForm = async (form) => {
                const button = form.querySelector("button[type='submit']");
                if (button) button.disabled = true;
                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        headers: { "Accept": "application/json", "X-Requested-With": "XMLHttpRequest" },
                        body: new FormData(form)
                    });

                    const contentType = response.headers.get("content-type") || "";
                    const payload = contentType.includes("application/json") ? await response.json() : null;

                    if (!response.ok || !payload?.success) {
                        throw new Error(payload?.message || "Không thể thực hiện thao tác này.");
                    }

                    showToast(payload.message || "Đã cập nhật yêu cầu.");
                    if (payload.data) updateStatistics(payload.data);
                    await loadRequests();
                } catch (error) {
                    showToast(error instanceof Error ? error.message : "Lỗi khi xử lý yêu cầu.", "danger");
                    if (button) button.disabled = false;
                }
            };

            const bindActionForms = () => {
                tableContainer?.querySelectorAll("[data-request-action-form]").forEach((form) => {
                    form.addEventListener("submit", (event) => {
                        event.preventDefault();
                        void submitActionForm(form);
                    });
                });

                tableContainer?.querySelectorAll("[data-request-page]").forEach((button) => {
                    button.addEventListener("click", (e) => {
                        e.preventDefault();
                        const page = button.dataset.requestPage;
                        if (!page) return;
                        const pageInput = filterForm?.querySelector("[data-request-page-input]");
                        if (pageInput) pageInput.value = page;
                        void loadRequests();
                    });
                });
            };

            bindActionForms();

            const closeRejectDialog = () => {
                if (rejectDialog?.open) rejectDialog.close();
                if (rejectReasonError) rejectReasonError.hidden = true;
            };

            document.addEventListener("click", (event) => {
                const trigger = event.target.closest("[data-request-reject]");
                if (!trigger) return;
                const requestId = trigger.dataset.requestReject;
                if (rejectIdInput) rejectIdInput.value = requestId;
                if (rejectTitle) {
                    rejectTitle.textContent = `Từ chối yêu cầu "${trigger.dataset.requestRejectUsername || requestId}"?`;
                }
                if (rejectReason) rejectReason.value = "";
                if (rejectReasonError) rejectReasonError.hidden = true;
                if (rejectDialog?.showModal) rejectDialog.showModal();
            });

            document.querySelectorAll("[data-request-reject-cancel]").forEach((button) => {
                button.addEventListener("click", closeRejectDialog);
            });

            rejectDialog?.addEventListener("click", (event) => {
                if (event.target === rejectDialog) closeRejectDialog();
            });

            rejectForm?.addEventListener("submit", (event) => {
                event.preventDefault();
                const reason = rejectReason?.value.trim() || "";
                if (!reason) {
                    if (rejectReasonError) rejectReasonError.hidden = false;
                    rejectReason?.focus();
                    return;
                }
                closeRejectDialog();
                void submitActionForm(rejectForm);
            });
        })();
    </script>
}
