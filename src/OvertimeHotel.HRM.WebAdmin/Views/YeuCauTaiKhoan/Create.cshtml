@model CreateYeuCauTaiKhoanViewModel
@{
    ViewData["Title"] = "Gửi yêu cầu cấp tài khoản";
}

<div class="account-workspace account-workspace--bleed py-2">
    <!-- THANH ĐIỀU HƯỚNG & TIÊU ĐỀ TRANG -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3.5 py-2 fw-semibold hover-lift d-flex align-items-center gap-2" style="font-size: 0.82rem;">
                <i class="bi bi-arrow-left fs-6"></i> Quay lại danh sách
            </a>
            <div>
                <h4 class="mb-0 fw-bold font-serif text-dark" style="font-size: 1.15rem;">Gửi Yêu Cầu Cấp Tài Khoản</h4>
                <small class="text-muted" style="font-size: 0.75rem;">Nhân sự khởi tạo yêu cầu cấp tài khoản người dùng chuyển tiếp bộ phận CNTT xử lý</small>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex align-items-start gap-3 p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0 mt-0.5"></i>
            <div class="flex-grow-1">
                <div class="fw-bold text-dark small mb-1">Chưa thể gửi yêu cầu</div>
                <div asp-validation-summary="ModelOnly" class="small text-danger"></div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Create" method="post" id="createRequestForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- CỘT CHÍNH: FORM NHẬP LIỆU -->
            <div class="col-lg-8 col-md-12">
                <!-- KHỐI 1: ĐỐI TƯỢNG CẤP & CĂN CỨ PHÁP LÝ -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom luxury-card-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <span class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0 me-1" style="width: 42px; height: 42px; font-size: 1.2rem;">
                                <i class="bi bi-person-badge-fill"></i>
                            </span>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark font-serif" style="font-size: 0.96rem;">01. Nhân Sự &amp; Căn Cứ Hợp Đồng Lao Động</h6>
                                <small class="text-muted" style="font-size: 0.74rem;">Chỉ định nhân viên cần cấp tài khoản và vai trò RBAC đề xuất</small>
                            </div>
                        </div>
                        <span class="badge bg-light text-secondary border rounded-pill px-3 py-1.5" style="font-size: 0.72rem;">Bước 1/2</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-7 col-12">
                                <label asp-for="EmployeeId" class="form-label text-uppercase text-secondary fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    Nhân viên đề xuất <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3 px-3">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="form-select border-start-0 py-2 ps-3 rounded-end-3" id="EmployeeId">
                                        <option value="">-- Chọn nhân viên chưa có tài khoản --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="EmployeeId" class="text-danger small d-block mt-1" style="font-size: 0.75rem;"></span>
                                @if (Model.EmployeeOptions.Count == 0)
                                {
                                    <div class="p-2.5 mt-2 rounded-3 bg-warning bg-opacity-10 border border-warning-subtle text-warning-emphasis small d-flex align-items-center gap-2" style="font-size: 0.75rem;">
                                        <i class="bi bi-info-circle-fill flex-shrink-0 me-1"></i>
                                        <span>Không còn nhân viên nào đang làm việc, chưa có tài khoản và có email công vụ.</span>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">
                                        <i class="bi bi-info-circle text-primary me-2"></i> Chỉ hiện nhân viên đang làm việc, chưa có tài khoản và đã có email công vụ.
                                    </small>
                                }
                            </div>
                            <div class="col-md-5 col-12">
                                <label asp-for="RoleId" class="form-label text-uppercase text-secondary fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    Vai trò đề xuất (RBAC) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3 px-3">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <select asp-for="RoleId" asp-items="Model.RoleOptions" class="form-select border-start-0 py-2 ps-3 rounded-end-3" id="RoleId">
                                        <option value="">-- Chọn vai trò --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="RoleId" class="text-danger small d-block mt-1" style="font-size: 0.75rem;"></span>
                            </div>

                            <div class="col-12 mt-3">
                                <label asp-for="ContractId" class="form-label text-uppercase text-secondary fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                    Hợp đồng làm căn cứ pháp lý <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3 px-3">
                                        <i class="bi bi-file-earmark-text-fill"></i>
                                    </span>
                                    <select asp-for="ContractId" data-contract-select class="form-select border-start-0 py-2 ps-3 rounded-end-3" disabled>
                                        <option value="">-- Chọn hợp đồng lao động làm căn cứ --</option>
                                        @foreach (var contract in Model.ActiveContracts)
                                        {
                                            <option value="@contract.ContractId"
                                                    data-employee-id="@contract.EmployeeId"
                                                    selected="@(Model.ContractId == contract.ContractId)">@contract.Label</option>
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="ContractId" class="text-danger small d-block mt-1" style="font-size: 0.75rem;"></span>
                                <div id="noContractAlert" class="p-2.5 mt-2 rounded-3 bg-danger bg-opacity-10 border border-danger-subtle text-danger small d-none align-items-center gap-2" style="font-size: 0.75rem;">
                                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-1"></i>
                                    <span>Nhân viên này không có hợp đồng lao động hợp lệ (chưa bắt đầu, đã hết hạn hoặc không tồn tại). Không thể gửi yêu cầu cấp tài khoản.</span>
                                </div>
                                <small class="text-muted d-block mt-1" id="contractHelpText" style="font-size: 0.72rem;">
                                    <i class="bi bi-info-circle text-primary me-2"></i> Bắt buộc chọn hợp đồng của đúng nhân viên, trạng thái Hiệu lực, đã bắt đầu và chưa hết hạn.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KHỐI 2: TÊN ĐĂNG NHẬP DỰ KIẾN CẤP -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom luxury-card-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <span class="rounded-circle bg-warning bg-opacity-10 text-warning-emphasis d-flex align-items-center justify-content-center flex-shrink-0 me-1" style="width: 42px; height: 42px; font-size: 1.2rem;">
                                <i class="bi bi-key-fill" style="color: #b45309;"></i>
                            </span>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark font-serif" style="font-size: 0.96rem;">02. Thông Tin Tên Đăng Nhập Dự Kiến</h6>
                                <small class="text-muted" style="font-size: 0.74rem;">Gợi ý tự động từ họ tên nhân sự, có thể điều chỉnh theo quy chuẩn</small>
                            </div>
                        </div>
                        <span class="badge bg-light text-secondary border rounded-pill px-3 py-1.5" style="font-size: 0.72rem;">Bước 2/2</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-1">
                            <label asp-for="Username" class="form-label text-uppercase text-secondary fw-bold small mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">
                                Tên đăng nhập dự kiến <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3 font-monospace fw-bold px-3">@@</span>
                                <input asp-for="Username" class="form-control border-start-0 py-2 ps-3 rounded-end-3" placeholder="Ví dụ: nv.nguyenvana" autocomplete="off" id="Username" data-username-input />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small d-block mt-1" style="font-size: 0.75rem;"></span>
                            <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">
                                <i class="bi bi-magic text-warning me-2"></i> Hệ thống tự động sinh tên gợi ý khi bạn chọn nhân viên; bạn có thể chỉnh sửa lại trước khi gửi.
                            </small>
                        </div>
                    </div>
                </div>

                <!-- CỤM NÚT THAO TÁC CUỐI FORM -->
                <div class="d-flex align-items-center justify-content-between gap-3 pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-semibold hover-lift d-inline-flex align-items-center gap-2" style="font-size: 0.85rem;">
                        <i class="bi bi-x-circle fs-6"></i> Hủy bỏ
                    </a>
                    <button type="submit" id="btnSubmitRequest" class="btn btn-hotel-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm hover-lift d-flex align-items-center gap-2" disabled="@(Model.EmployeeOptions.Count == 0)" style="font-size: 0.85rem;">
                        <i class="bi bi-send-fill fs-6"></i> Gửi Yêu Cầu Cấp Tài Khoản
                    </button>
                </div>
            </div>

            <!-- CỘT PHỤ: QUY TRÌNH DUYỆT & CẤP PHÁT -->
            <div class="col-lg-4 col-md-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-sticky" style="top: 20px;">
                    <!-- HEADER CARD QUY TRÌNH -->
                    <div class="luxury-preview-header text-white d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-diagram-3-fill fs-6 me-1" style="color: #fde047;"></i>
                            <span class="small fw-bold font-serif text-uppercase" style="letter-spacing: 0.5px; font-size: 0.75rem;">Quy Trình 3 Bước</span>
                        </div>
                        <span class="badge rounded-pill px-3 py-1.5" style="background: rgba(255,255,255,0.18); color: #ffffff !important; font-size: 0.72rem; font-weight: 600;">Khép kín</span>
                    </div>

                    <!-- THÂN THẺ QUY TRÌNH -->
                    <div class="card-body p-4">
                        <div class="d-flex flex-column gap-3">
                            <!-- BƯỚC 1 -->
                            <div class="p-3 rounded-3 bg-primary bg-opacity-10 border border-primary-subtle">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge bg-primary text-white rounded-pill px-2.5 py-0.5" style="font-size: 0.68rem;">Bước 1</span>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-0.5" style="font-size: 0.68rem;">CHỜ_IT</span>
                                </div>
                                <div class="fw-bold text-dark small">Nhân sự khởi tạo yêu cầu</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Kiểm tra HĐLĐ và đề xuất vai trò, gửi vào hàng đợi tiếp nhận.</div>
                            </div>

                            <!-- BƯỚC 2 -->
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge bg-secondary text-white rounded-pill px-2.5 py-0.5" style="font-size: 0.68rem;">Bước 2</span>
                                    <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-0.5" style="font-size: 0.68rem;">ĐANG_XỬ_LÝ</span>
                                </div>
                                <div class="fw-bold text-dark small">CNTT nhận xử lý</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Chuyên viên CNTT nhận việc và đối chiếu thông tin công vụ.</div>
                            </div>

                            <!-- BƯỚC 3 -->
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <span class="badge bg-secondary text-white rounded-pill px-2.5 py-0.5" style="font-size: 0.68rem;">Bước 3</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-0.5" style="font-size: 0.68rem;">ĐÃ_CẤP</span>
                                </div>
                                <div class="fw-bold text-dark small">Mở tài khoản Supabase</div>
                                <div class="text-muted" style="font-size: 0.72rem;">Khởi tạo tài khoản Supabase Auth và thông báo thông tin đăng nhập.</div>
                            </div>
                        </div>

                        <hr class="opacity-10 my-3" />

                        <!-- GHI CHÚ BẢO MẬT -->
                        <div class="p-3 rounded-3 bg-light text-muted d-flex align-items-start gap-2" style="font-size: 0.72rem; line-height: 1.4;">
                            <i class="bi bi-shield-lock-fill text-warning flex-shrink-0 mt-0.5 me-1"></i>
                            <span>Mật khẩu khởi tạo do bộ phận CNTT đặt khi cấp phát; nhân sự nên đổi mật khẩu ngay trong lần đăng nhập đầu tiên.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            "use strict";

            const employee = document.getElementById("EmployeeId");
            const username = document.getElementById("Username");
            const contractSelect = document.querySelector("[data-contract-select]");
            const submitBtn = document.getElementById("btnSubmitRequest") || document.querySelector("button[type='submit']");
            const noContractAlert = document.getElementById("noContractAlert");
            const contractHelpText = document.getElementById("contractHelpText");

            const stripDiacritics = (value) =>
                value
                    .normalize("NFD")
                    .replace(/[̀-ͯ]/g, "")
                    .replace(/đ/g, "d")
                    .replace(/Đ/g, "D");

            const suggestUsername = () => {
                if (!employee || !username || username.value.trim()) return;
                const option = employee.selectedOptions[0];
                if (!option || !option.value) return;

                const fullName = option.text.split("·")[0].trim();
                const parts = fullName.split(/\s+/).filter(Boolean);
                if (parts.length === 0) return;
                const last = parts[parts.length - 1];
                const first = parts[0];
                const initial = stripDiacritics(first).charAt(0).toLowerCase();
                username.value = `${initial}.${stripDiacritics(last).toLowerCase().replace(/\s+/g, "")}`;
            };

            const filterContracts = () => {
                if (!contractSelect) return;
                const employeeId = employee?.value || "";
                let visibleCount = 0;
                let firstValidOption = null;

                Array.from(contractSelect.options).forEach((option) => {
                    if (!option.value) return;
                    const matches = !!employeeId && option.dataset.employeeId === employeeId;
                    option.hidden = !matches;
                    option.disabled = !matches;
                    if (matches) {
                        visibleCount++;
                        if (!firstValidOption) firstValidOption = option;
                    }
                });

                if (!employeeId) {
                    contractSelect.disabled = true;
                    contractSelect.selectedIndex = 0;
                    if (noContractAlert) {
                        noContractAlert.classList.add("d-none");
                        noContractAlert.classList.remove("d-flex");
                    }
                    if (contractHelpText) contractHelpText.classList.remove("d-none");
                    if (submitBtn) submitBtn.disabled = true;
                    return;
                }

                if (visibleCount === 0) {
                    // Không có hợp đồng phù hợp -> hiện lý do và khóa nút gửi
                    contractSelect.disabled = true;
                    contractSelect.selectedIndex = 0;
                    if (noContractAlert) {
                        noContractAlert.classList.remove("d-none");
                        noContractAlert.classList.add("d-flex");
                    }
                    if (contractHelpText) contractHelpText.classList.add("d-none");
                    if (submitBtn) submitBtn.disabled = true;
                } else {
                    contractSelect.disabled = false;
                    if (noContractAlert) {
                        noContractAlert.classList.add("d-none");
                        noContractAlert.classList.remove("d-flex");
                    }
                    if (contractHelpText) contractHelpText.classList.remove("d-none");

                    if (visibleCount === 1) {
                        // Có một hợp đồng hợp lệ thì tự chọn
                        if (firstValidOption) {
                            contractSelect.value = firstValidOption.value;
                        }
                        if (submitBtn) submitBtn.disabled = false;
                    } else {
                        // Có nhiều thì người gửi chọn
                        const currentlySelected = contractSelect.selectedOptions[0];
                        if (!currentlySelected || currentlySelected.dataset.employeeId !== employeeId) {
                            contractSelect.selectedIndex = 0;
                        }
                        if (submitBtn) {
                            submitBtn.disabled = !contractSelect.value;
                        }
                    }
                }
            };

            employee?.addEventListener("change", () => {
                suggestUsername();
                filterContracts();
            });

            contractSelect?.addEventListener("change", () => {
                if (submitBtn && employee?.value) {
                    submitBtn.disabled = !contractSelect.value;
                }
            });

            suggestUsername();
            filterContracts();
        })();
    </script>
}