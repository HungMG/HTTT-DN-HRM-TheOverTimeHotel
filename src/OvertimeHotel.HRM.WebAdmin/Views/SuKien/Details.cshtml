@model EventDetailsViewModel
@{ ViewData["Title"] = Model.Event.TenDuAn + " · Quản trị Sự kiện"; }
<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
<div class="events-page event-standalone-container">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a class="event-back-link d-inline-flex align-items-center gap-2 text-decoration-none text-navy fw-semibold" asp-action="Index" asp-route-year="@Model.ReturnYear" asp-route-month="@Model.ReturnMonth" asp-route-date="@Model.ReturnDate.ToString("yyyy-MM-dd")">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Trở về lịch sự kiện khách sạn
        </a>
    </div>
    <div data-event-standalone class="event-standalone-card bg-white p-4 rounded-4 shadow-sm border">
        <partial name="_EventDetailsContent" model="Model" />
    </div>
</div>
<partial name="_EventDialogs" />
<div class="hotel-toast-stack" aria-live="polite"></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/events.js" asp-append-version="true"></script>
    <script src="~/js/event-details.js" asp-append-version="true"></script>
}
