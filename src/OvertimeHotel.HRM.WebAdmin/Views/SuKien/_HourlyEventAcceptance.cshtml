@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
@using System.Globalization
@{
    var item = Model.Event;
    var canRecord = Model.CanManage && item.TrangThai is "DANG_DIEN_RA" or "CHO_NGHIEM_THU";
    var canReview = Model.CanManage && item.TrangThai == "CHO_NGHIEM_THU";
    var preview = Model.PayPreview;
    var periods = Model.EligiblePaymentPeriods;
    var completed = item.TrangThai == "HOAN_THANH";
    var verifiedZero = completed && item.NgayNghiemThu.HasValue && item.MaNguoiNghiemThu.HasValue
        && item.NganSachPhuCap == 0 && preview?.Rows.Count == 0
        && Model.AcceptanceStaffCount > 0 && Model.AbsentStaffCount == Model.AcceptanceStaffCount;
    var hasSettlement = preview?.Rows.Count > 0 || verifiedZero;
    var needsReconciliation = completed && (Model.UnreviewedStaffCount > 0 || Model.MissingWorkStaffCount > 0
        || (preview != null && preview.Rows.Count == 0 && !verifiedZero));
    string Money(decimal value) => value.ToString("#,##0.##", CultureInfo.GetCultureInfo("vi-VN")) + " đ";
}
<div class="event-panel">
    <h3>1. @(completed ? "Nhân sự và giờ tham gia đã lưu" : "Giờ tham gia và kết quả")</h3>
    @if (completed)
    {
        <p class="event-muted" data-acceptance-closed>Sự kiện đã hoàn thành. Danh sách dưới đây chỉ để đối chiếu, không yêu cầu nhân viên xác nhận lại.</p>
        <div class="event-budget-grid mb-3">
            <div class="event-budget-card"><span>Nhân sự sự kiện</span><strong>@Model.AcceptanceStaffCount người</strong></div>
            <div class="event-budget-card"><span>Có kết quả được lưu</span><strong>@Model.ConfirmedStaffCount người</strong></div>
            <div class="event-budget-card"><span>Không tham gia</span><strong>@Model.AbsentStaffCount người</strong></div>
        </div>
        @if (needsReconciliation)
        {
            <p class="alert alert-warning" role="alert" data-acceptance-reconciliation>Trạng thái sự kiện là Hoàn thành nhưng hồ sơ đánh giá hoặc quyết toán chưa đầy đủ. HR cần đối soát dữ liệu gốc; hệ thống không tự xác nhận nhân viên hoặc coi đây là khoản nghiệm thu 0 đ.</p>
        }
    }
    else
    {
    <p class="event-muted">Giờ tham gia được tính từ giờ chấm công vào/ra, trong giới hạn giờ phân công và ca nguồn. Người có quyền xác nhận tham gia hoặc không tham gia.</p>
    <div class="event-budget-grid mb-3" data-acceptance-staff="@Model.AcceptanceStaffCount" data-acceptance-ready="@Model.ConfirmedStaffCount" data-acceptance-missing-work="@Model.MissingWorkStaffCount" data-acceptance-unreviewed="@Model.UnreviewedStaffCount">
        <div class="event-budget-card"><span>Nhân viên cần xác nhận</span><strong>@Model.AcceptanceStaffCount người</strong></div>
        <div class="event-budget-card"><span>Đã xác nhận đầy đủ</span><strong>@Model.ConfirmedStaffCount người</strong></div>
        <div class="event-budget-card"><span>Còn thiếu giờ</span><strong>@Model.MissingWorkStaffCount người</strong></div>
        <div class="event-budget-card"><span>Chưa đánh giá</span><strong>@Model.UnreviewedStaffCount người</strong></div>
    </div>
    <p class="event-muted">Đếm theo nhân viên khác nhau. Một người chỉ được tính xác nhận đầy đủ khi tất cả phân công liên quan đã được xử lý.</p>
    }
    @if (preview?.Warnings.Count > 0)
    {
        /* Cảnh báo gốc dạng "Tên: lý do." — gộp theo lý do kèm số người và danh
           sách tên, thay vì liệt kê N dòng giống hệt nhau làm khối vàng phình to. */
        var groupedWarnings = preview.Warnings.Distinct()
            .Select(w =>
            {
                var separator = w.IndexOf(": ", StringComparison.Ordinal);
                return separator > 0
                    ? (Name: w[..separator], Reason: w[(separator + 2)..].TrimEnd('.'))
                    : (Name: "", Reason: w.TrimEnd('.'));
            })
            .GroupBy(w => w.Reason)
            .ToList();
        <div class="event-attention-note" role="alert">
            <strong><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Cần xử lý trước khi nghiệm thu</strong>
            @foreach (var group in groupedWarnings)
            {
                <div class="event-attention-row">
                    <span class="event-attention-reason">@group.Key</span>
                    <span class="event-attention-count">@group.Count() người</span>
                    <span class="event-attention-names">@string.Join(" · ", group.Where(w => w.Name != "").Select(w => w.Name))</span>
                </div>
            }
        </div>
    }
    @if (!item.PhanCongs.Any(p => p.TrangThaiThamGia is not ("HUY_PHAN_CONG" or "DA_HUY")))
    {
        <p class="alert alert-info" role="status">@(completed ? "Không có phân công hiệu lực trong hồ sơ sự kiện." : "Chưa sắp xếp sự kiện. Cần có phân công từ Lịch làm việc trước khi ghi công thực tế.")</p>
    }
    @foreach (var person in item.PhanCongs.GroupBy(p => p.MaNhanVien).OrderBy(g => g.First().NhanVien?.HoTen).ThenBy(g => g.Key))
    {
        var employee = person.Select(p => p.NhanVien).FirstOrDefault(n => n != null);
        var employeeName = employee?.HoTen ?? $"Nhân viên #{person.Key}";
        <section class="event-participation-person mt-3" data-participation-person="@person.Key" aria-labelledby="participation-person-@person.Key">
            <div class="event-participation-heading"><h4 id="participation-person-@person.Key" class="h6 mb-0">@employeeName</h4><span class="event-muted">NV #@person.Key · @person.Count() phân công</span></div>
            <div class="table-responsive">
                <table class="table event-table event-participation-table mb-0" data-participation-table>
                    <caption class="visually-hidden">Giờ tham gia và kết quả của @employeeName</caption>
                    <colgroup><col class="participation-source" /><col class="participation-plan" /><col class="participation-work" /><col class="participation-result" /></colgroup>
                    <thead><tr><th scope="col">Vai trò / ca nguồn</th><th scope="col">Giờ phân công (UTC+7)</th><th scope="col">Giờ thực tế (UTC+7)</th><th scope="col">Kết quả</th></tr></thead>
                    <tbody>
                    @foreach (var assignment in person.OrderBy(p => p.BatDau).ThenBy(p => p.MaPhanCong))
                    {
                        var canceled = assignment.TrangThaiThamGia is "HUY_PHAN_CONG" or "DA_HUY";
                        var actualWindow = HourlyEventRules.AttendanceWindow(item, assignment, DateTimeOffset.UtcNow);
                        var rating = !completed && !canceled && assignment.DanhGia != "KHONG_THAM_GIA"
                            ? HourlyEventRules.AutomaticRating(assignment) : assignment.DanhGia;
                        var resultLabel = canceled ? "Đã gỡ (lịch sử)" : rating == null ? "Thiếu dữ liệu giờ thực tế" : completed && (!assignment.NgayDanhGia.HasValue || rating == "CHUA_DANH_GIA")
                            ? "Chưa có kết quả được lưu" : rating == "XUAT_SAC" ? "Hoàn thành xuất sắc" : HotelEventRules.RatingLabels.GetValueOrDefault(rating, rating);
                        <tr data-participation-assignment="@assignment.MaPhanCong">
                            <td><strong>@assignment.VaiTroDuAn</strong><div class="mt-2">Ca #@assignment.MaPhanCa</div>
                                @if (assignment.PhanCa is { } source)
                                { <small class="event-muted">@source.CaLamViec?.TenCa<br />@HotelEventRules.Local(source.BatDauDuKien).ToString("dd/MM HH:mm") – @HotelEventRules.Local(source.KetThucDuKien).ToString("dd/MM HH:mm")</small> }
                                @if (canceled) { <small class="d-block text-muted mt-2">Phân công đã hủy · chỉ xem</small> }
                            </td>
                            <td>@HotelEventRules.Local(assignment.BatDau).ToString("dd/MM HH:mm")<br />– @HotelEventRules.Local(assignment.KetThuc).ToString("dd/MM HH:mm")</td>
                            <td>
                                @if (canceled && assignment.CongThucTes.Count > 0)
                                { <p class="alert alert-warning" role="alert">Phân công đã hủy còn giờ tham gia thực tế. HR/Admin cần đối soát; công đã làm không bị tự xóa.</p> }
                                @if (assignment.CongThucTes.Count == 0) { <span class="event-muted">Không có giờ được lưu.</span> }
                                @foreach (var work in assignment.CongThucTes.OrderBy(c => c.BatDau))
                                {
                                    <div class="border-top pt-2 mt-2">
                                        <p>@HotelEventRules.Local(work.BatDau).ToString("dd/MM/yyyy HH:mm") – @HotelEventRules.Local(work.KetThuc).ToString("dd/MM/yyyy HH:mm") · @((work.KetThuc - work.BatDau).TotalMinutes.ToString("0.##")) phút</p>
                                        <p class="event-muted">Người xác nhận #@work.MaNguoiXacNhan · @HotelEventRules.Local(work.NgayXacNhan).ToString("dd/MM/yyyy HH:mm")</p>
                                        @if (Model.IsOffice && canRecord && !canceled)
                                        {
                                            var preserveEdit = Model.Work.AssignmentId == assignment.MaPhanCong && Model.Work.WorkId == work.MaCong;
                                            var editStart = preserveEdit ? Model.Work.Start : HotelEventRules.Local(work.BatDau);
                                            var editEnd = preserveEdit ? Model.Work.End : HotelEventRules.Local(work.KetThuc);
                                            <details open="@(preserveEdit && !ViewData.ModelState.IsValid)"><summary>Sửa giờ tham gia</summary>
                                                <form asp-action="RecordWork" asp-route-id="@item.MaDuAn" method="post" data-event-time-form class="mt-2">
                                                    <partial name="_EventContext" model="Model" />
                                                    <input name="Work.Version" value="@item.Version" type="hidden" />
                                                    <input name="Work.AssignmentId" value="@assignment.MaPhanCong" type="hidden" />
                                                    <input name="Work.WorkId" value="@work.MaCong" type="hidden" />
                                                    <label for="edit-work-start-@work.MaCong" class="form-label">Tham gia từ (UTC+7)</label>
                                                    <input id="edit-work-start-@work.MaCong" name="Work.Start" value="@editStart.ToString("yyyy-MM-ddTHH:mm")" type="datetime-local" class="form-control mb-2" data-event-start required />
                                                    <label for="edit-work-end-@work.MaCong" class="form-label">Đến (UTC+7)</label>
                                                    <input id="edit-work-end-@work.MaCong" name="Work.End" value="@editEnd.ToString("yyyy-MM-ddTHH:mm")" type="datetime-local" class="form-control mb-2" data-event-end required />
                                                    <label for="edit-work-reason-@work.MaCong" class="form-label">Lý do sửa công</label>
                                                    <textarea id="edit-work-reason-@work.MaCong" name="Work.Reason" class="form-control mb-2" maxlength="500" required>@(preserveEdit ? Model.Work.Reason : null)</textarea>
                                                    <button type="submit" class="event-secondary-button">Lưu sửa giờ</button>
                                                </form>
                                            </details>
                                            <details><summary>Thu hồi giờ tham gia ghi sai</summary><form asp-action="DeleteWork" asp-route-id="@item.MaDuAn" method="post">
                                                <partial name="_EventContext" model="Model" /><input name="version" value="@item.Version" type="hidden" /><input name="workId" value="@work.MaCong" type="hidden" />
                                                <label for="delete-work-@work.MaCong" class="form-label">Lý do thu hồi</label><input id="delete-work-@work.MaCong" name="reason" class="form-control" maxlength="500" required /><button type="submit" class="btn btn-sm btn-outline-danger mt-2">Thu hồi giờ tham gia</button>
                                            </form></details>
                                        }
                                    </div>
                                }
                                @if (!completed && !canceled && assignment.CongThucTes.Count == 0 && assignment.DanhGia != "KHONG_THAM_GIA")
                                {
                                    if (actualWindow.HasValue)
                                    { <p class="event-muted mt-2">Theo chấm công: @HotelEventRules.Local(actualWindow.Value.Start).ToString("dd/MM/yyyy HH:mm") – @HotelEventRules.Local(actualWindow.Value.End).ToString("dd/MM/yyyy HH:mm")</p> }
                                    else
                                    { <p class="event-muted mt-2">Chưa đủ giờ check-in/check-out hợp lệ trong ca và phân công.</p> }
                                }
                            </td>
                            <td>
                                <span>@resultLabel</span>
                                @if (canReview && !canceled && assignment.CongThucTes.Count == 0)
                                {
                                    <form asp-action="Review" asp-route-id="@item.MaDuAn" method="post" class="mt-3" data-preserve-scroll>
                                        <partial name="_EventContext" model="Model" /><input name="Review.Version" value="@item.Version" type="hidden" /><input name="Review.AssignmentId" value="@assignment.MaPhanCong" type="hidden" />
                                        <button type="submit" name="Review.Rating" value="HOAN_THANH" class="event-secondary-button mt-2" disabled="@(!actualWindow.HasValue)">Xác nhận tham gia</button>
                                        @if (assignment.DanhGia != "KHONG_THAM_GIA")
                                        { <button type="submit" name="Review.Rating" value="KHONG_THAM_GIA" class="event-secondary-button mt-2">Xác nhận không tham gia</button> }
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
<div class="event-panel mt-4">
    <h3>2. @(completed ? hasSettlement ? "Quyết toán đã khóa" : "Hồ sơ quyết toán cần đối soát" : "Xem trước tiền sự kiện")</h3>
    @if (item.TrangThai == "HOAN_THANH")
    {
        @if (hasSettlement)
        { <p>Tiền sự kiện đã chốt theo giờ tham gia và hệ số được lưu trong căn cứ từng khoản. Thay đổi cấu hình sau nghiệm thu không làm thay đổi quyết toán.</p> }
        else
        { <p>Chưa có đủ hồ sơ xác nhận quyết toán. Không tự tính lại khoản sự kiện bằng lương hoặc hệ số hiện tại.</p> }
    }
    else
    {
        <p>Tiền cộng thêm = Lương cơ bản tháng / 26 / 8 × hệ số @Model.HourlyEventRate.ToString("0.00") × thời lượng từ giờ bắt đầu đến giờ kết thúc tham gia. Lương ca thông thường vẫn tính riêng. Tiền được tổng hợp theo tháng phát sinh và trả vào kỳ HR chọn.</p>
    }
    @if (preview != null)
    {
        @if (!completed || hasSettlement)
        {
        <div class="table-responsive"><table class="table event-table"><thead><tr><th scope="col">Nhân viên</th><th scope="col">Tháng phát sinh</th><th scope="col">Phút</th><th scope="col">Thu nhập thêm</th><th scope="col">Căn cứ</th></tr></thead><tbody>
            @foreach (var row in preview.Rows)
            {
                <tr><td>@row.EmployeeName</td><td>@row.WorkMonth.ToString("MM/yyyy")</td><td>@row.Minutes.ToString("0.##")</td><td>@Money(row.Amount)</td><td><details><summary>Chi tiết giờ và lương</summary>@foreach (var basis in row.Basis) { <p>@HotelEventRules.Local(basis.Start).ToString("dd/MM HH:mm") – @HotelEventRules.Local(basis.End).ToString("dd/MM HH:mm")<br />HĐ #@basis.ContractId · Lương tháng @Money(basis.MonthlySalary) / 26 / 8 × @basis.Rate.ToString("0.00") = @Money(basis.HourlyRate)/giờ · @basis.Minutes.ToString("0.##") phút</p> }</details></td></tr>
            }
        </tbody><tfoot><tr><th scope="row" colspan="3">Tổng cộng</th><td colspan="2"><strong>@Money(preview.Total)</strong></td></tr></tfoot></table></div>
        }
    }
    else
    { <p class="alert alert-warning" role="alert">Chưa tải được bảng tiền để kiểm tra. Vui lòng tải lại trước khi nghiệm thu.</p> }
</div>
<div class="event-panel mt-4">
    <h3>3. Nghiệm thu và kỳ chi trả</h3>
    @if (preview != null)
    {
        @if (Model.CanAccept && Model.IsOffice && item.TrangThai == "CHO_NGHIEM_THU" && (item.KetThucThucTe ?? item.NgayKetThuc) <= DateTimeOffset.UtcNow)
        {
            @if (periods.Count == 0)
            { <p class="alert alert-warning" role="status">Chưa có kỳ lương mở hợp lệ. Kỳ trả phải từ tháng phát sinh công muộn nhất trở đi, chưa gửi duyệt, chưa được duyệt và chưa khóa sổ.</p> }
            <partial name="_EventPaymentPeriod" model="Model" />
            <form asp-action="AcceptHourly" asp-route-id="@item.MaDuAn" method="post" data-event-acceptance-form>
                <partial name="_EventContext" model="Model" /><input name="version" value="@preview.Version" type="hidden" /><input name="previewToken" value="@preview.Token" type="hidden" />
                <label for="event-payment-period" class="form-label">Kỳ lương chi trả</label><select id="event-payment-period" name="paymentPeriodId" class="form-select" required><option value="">Chọn kỳ chi trả</option>@foreach (var period in periods) { <option value="@period.MaKyLuong" selected="@(Model.PaymentPeriodId == period.MaKyLuong)">@period.Thang.ToString("D2")/@period.Nam · @period.TrangThai</option> }</select>
                <p class="form-text">Nghiệm thu xác nhận đúng bảng xem trước và khóa công sự kiện. Nếu dữ liệu thay đổi, hãy xem lại bảng trước khi xác nhận.</p>
                <p>Nghiệm thu chưa đồng nghĩa đã vào phiếu lương hoặc đã chuyển khoản. HR cần tính hoặc tính lại lương của kỳ đã chọn để kết chuyển.</p>
                <button type="submit" class="event-primary-button" disabled="@(!Model.CanFinalizeAcceptance)">Kiểm tra và nghiệm thu</button>
                <dialog data-acceptance-dialog class="event-acceptance-dialog" aria-labelledby="acceptance-confirm-title">
                    <h4 id="acceptance-confirm-title">Xác nhận nghiệm thu và khóa</h4>
                    <dl><dt>Sự kiện</dt><dd>@item.TenDuAn</dd>
                        <dt>Nhân viên có tiền sự kiện</dt><dd>@preview.Rows.Where(r => r.Amount > 0).Select(r => r.EmployeeId).Distinct().Count() người</dd>
                        <dt>Không tham gia</dt><dd>@Model.AbsentStaffCount người</dd>
                        <dt>Tổng tiền cộng thêm</dt><dd><strong>@Money(preview.Total)</strong></dd>
                        <dt>Kỳ lương nhận tiền</dt><dd data-acceptance-period></dd></dl>
                    @if (preview.Total == 0) { <p>Tổng tiền 0 đ. Không phát sinh khoản tiền sự kiện cần kết chuyển.</p> }
                    <p>Sau xác nhận, sự kiện, giờ tham gia và căn cứ tính tiền được khóa. Khoản đã chốt giữ nguyên khi thay đổi hệ số hoặc lương.</p>
                    <div class="d-flex gap-2 justify-content-end"><button type="button" class="event-secondary-button" data-acceptance-cancel>Quay lại kiểm tra</button><button type="button" class="event-primary-button" data-acceptance-confirm>Xác nhận nghiệm thu</button></div>
                </dialog>
            </form>
        }
        else { <p class="event-muted">@(completed ? hasSettlement ? "Đã nghiệm thu. Căn cứ tính và kỳ chi trả được lưu theo quyết toán." : "Sự kiện đã được đánh dấu hoàn thành; hồ sơ nghiệm thu cần được đối soát." : "HR/Admin nghiệm thu sau khi sự kiện kết thúc và chuyển sang chờ nghiệm thu.")</p> }
        @if (item.TrangThai == "HOAN_THANH")
        {
            @if (item.NgayNghiemThu is { } acceptedAt)
            { <p>Nghiệm thu bởi nhân viên #@item.MaNguoiNghiemThu · @HotelEventRules.Local(acceptedAt).ToString("dd/MM/yyyy HH:mm") (UTC+7).</p> }
            @if (verifiedZero)
            { <p class="alert alert-info" role="status" data-zero-settlement>Tổng tiền nghiệm thu 0 đ. Không có khoản tiền sự kiện cần kết chuyển vào phiếu lương.</p> }
            else
            {
                <p>Kết chuyển vào phiếu lương và khóa kỳ là các mốc xử lý lương; các mốc này không xác nhận đã chuyển khoản cho nhân viên.</p>
                <div class="table-responsive"><table class="table event-table"><thead><tr><th scope="col">Nhân viên / tháng phát sinh</th><th scope="col">Tiền đã chốt</th><th scope="col">Kỳ chi trả</th><th scope="col">Trạng thái kết chuyển</th><th scope="col">Phiếu lương</th></tr></thead><tbody>
                @foreach (var row in preview.Rows)
                {
                    var transfer = row.Transfer;
                    var linked = transfer?.PayslipId.HasValue == true;
                    var locked = linked && transfer!.PeriodStatus == "KHOA_SO";
                    <tr><td>@row.EmployeeName · @row.WorkMonth.ToString("MM/yyyy")</td><td>@Money(row.Amount)</td>
                        <td>@(transfer == null ? "Chưa tải được kỳ chi trả" : $"{transfer.Month:D2}/{transfer.Year}")</td>
                        <td data-transfer-status="@(locked ? "locked" : linked ? "linked" : "pending")">
                            @(locked ? "Kỳ lương đã khóa" : linked ? "Đã kết chuyển vào phiếu lương" : "Đã nghiệm thu — chưa kết chuyển")
                            @if (!linked && transfer?.PeriodStatus == "KHOA_SO") { <small class="d-block text-danger">Kỳ đã khóa nhưng chưa có liên kết phiếu lương. HR cần đối soát.</small> }
                            @if (!linked && transfer?.DetailId.HasValue == true) { <small class="d-block text-danger">Liên kết chi tiết phiếu lương không còn hợp lệ. HR cần đối soát.</small> }
                        </td><td>
                            @if (Model.IsOffice && transfer?.PayslipId is int payslipId)
                            { <a asp-controller="BangLuong" asp-action="Detail" asp-route-id="@payslipId" data-payslip-id="@payslipId">Phiếu #@payslipId</a> }
                            else { <span>@(linked ? $"Phiếu #{transfer!.PayslipId}" : "Chưa có phiếu lương")</span> }
                        </td></tr>
                }
                </tbody></table></div>
                @if (Model.IsOffice && preview.Rows.Any(r => r.Transfer is { PayslipId: null, PeriodStatus: not "KHOA_SO" }))
                { <p>HR cần tính hoặc tính lại lương của kỳ đã chọn để nhận các quyết toán còn chờ. Hệ thống sẽ chặn gửi duyệt khi còn quyết toán chưa kết chuyển.</p> }
                @if (preview.Rows.Count == 0) { <p class="alert alert-danger" role="alert">Thiếu quyết toán cho khoản tiền đã chốt. HR cần kiểm tra dữ liệu.</p> }
            }
        }
    }
</div>
