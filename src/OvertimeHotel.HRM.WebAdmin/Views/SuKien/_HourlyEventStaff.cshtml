@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
@{
    var item = Model.Event;
    var canStaff = Model.CanManage && item.TrangThai is "LEN_KE_HOACH" or "DANG_DIEN_RA";
    var active = item.PhanCongs.Where(p => p.TrangThaiThamGia != "HUY_PHAN_CONG").ToList();
    var distinctEmployees = active.Select(p => p.MaNhanVien).Distinct().Count();

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NV";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpper() : parts[0].ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    string GetDepartmentIcon(string code) => code switch
    {
        "TIEN_SANH" => "bi-building",
        "AM_THUC" => "bi-cup-straw",
        "BEP" => "bi-fire",
        "BUONG_PHONG" => "bi-door-closed",
        "KY_THUAT" => "bi-gear-wide-connected",
        "AN_NINH" => "bi-shield-check",
        "IT" => "bi-pc-display",
        _ => "bi-people"
    };
}

<div class="event-staff-toolbar mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="event-eyebrow mb-0">ĐỘI NGŨ SỰ KIỆN THEO CA</span>
                <span class="event-badge event-badge--gold"><i class="bi bi-stars"></i> 5★ OverTime Standard</span>
            </div>
            <h3 class="event-staff-title mb-0">@distinctEmployees nhân sự tham gia theo ca trực chính thức</h3>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="event-secondary-button">
                <i class="bi bi-calendar3" aria-hidden="true"></i> Xem ca &amp; phân ca tuần
            </a>
            @if (canStaff && Model.RequiredDepartments.Count > 0)
            {
                <button type="button" class="event-primary-button" data-top-quick-assign>
                    <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Phân công nhân sự
                </button>
            }
        </div>
    </div>
</div>

@if (Model.RequiredDepartments.Count == 0)
{
    <div class="event-info-notice p-4 text-center mb-4">
        <i class="bi bi-calendar-x display-5 text-gold d-block mb-2"></i>
        <h5 class="fw-semibold text-navy">Chưa xác định phòng ban yêu cầu theo ca</h5>
        <p class="text-muted mb-3">Sự kiện này chưa có định mức nhu cầu nhân sự. Vui lòng thiết lập nhu cầu phân ca tuần hoặc khai báo nhu cầu bộ phận trước khi phân công.</p>
        <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="event-primary-button">
            <i class="bi bi-calendar3 me-1"></i> Đến phân ca tuần
        </a>
    </div>
}
else
{
    <div class="event-department-list">
    @foreach (var code in Model.RequiredDepartments)
    {
        var deptName = HotelEventRules.DepartmentLabels.GetValueOrDefault(code, code);
        var deptIcon = GetDepartmentIcon(code);
        var deptMembers = item.PhanCongs.Where(p => (p.MaPhongBanSuKien ?? HotelEventRules.ResolveDepartmentCode(p.NhanVien)) == code).OrderBy(p => p.BatDau).ToList();
        var activeMembers = deptMembers.Where(p => p.TrangThaiThamGia != "HUY_PHAN_CONG").ToList();
        var canceledMembers = deptMembers.Where(p => p.TrangThaiThamGia == "HUY_PHAN_CONG").ToList();
        var available = Model.Employees
            .Where(n => HotelEventRules.ResolveDepartmentCode(n) == code && Model.Shifts.Any(s => s.MaNhanVien == n.MaNhanVien))
            .OrderBy(n => n.HoTen)
            .ToList();

        <section class="event-department-card" data-department-card="@code">
            <header class="event-department-card__header">
                <div class="d-flex align-items-center gap-3 min-w-0">
                    <div class="department-icon-badge">
                        <i class="bi @deptIcon"></i>
                    </div>
                    <div>
                        <h4 class="mb-1 text-navy">@deptName</h4>
                        <span class="event-muted small">
                            <strong class="text-navy">@activeMembers.Count</strong> nhân sự đang trực
                            @if (available.Count > 0)
                            {
                                <span>· <span class="text-gold-dark fw-semibold">@available.Count</span> nhân sự có ca sẵn sàng</span>
                            }
                        </span>
                    </div>
                </div>
                @if (canStaff)
                {
                    <button type="button" class="event-primary-button event-primary-button--sm" data-add-member aria-haspopup="dialog" title="Phân công nhân viên bộ phận @deptName">
                        <i class="bi bi-person-plus-fill" aria-hidden="true"></i> Phân công
                    </button>
                }
            </header>

            @if (activeMembers.Count == 0)
            {
                <div class="event-empty-box text-center py-4 my-2">
                    <i class="bi bi-person-dash text-muted opacity-50 display-6 d-block mb-2"></i>
                    <p class="text-muted mb-2">Chưa có nhân viên trực sự kiện thuộc bộ phận này.</p>
                    @if (canStaff)
                    {
                        <button type="button" class="event-secondary-button event-secondary-button--sm" data-add-member>
                            <i class="bi bi-plus-lg me-1"></i> Thêm nhân viên ngay
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="event-assigned-grid mt-3">
                    @foreach (var member in activeMembers)
                    {
                        var isEnded = member.TrangThaiThamGia == "DA_KET_THUC";
                        var srcShift = Model.Shifts.FirstOrDefault(s => s.MaPhanCa == member.MaPhanCa);
                        var shiftName = srcShift?.CaLamViec?.TenCa ?? (member.MaPhanCa.HasValue ? $"Ca #{member.MaPhanCa}" : "Chưa gắn ca");
                        var canRemoveMember = canStaff && !isEnded && HotelEventRoleRules.CanRemove(item, member.MaPhanCong, DateTimeOffset.UtcNow);

                        <div class="event-assigned-member-card" data-assigned-member data-employee-id="@member.MaNhanVien" data-assignment-id="@member.MaPhanCong">
                            <div class="member-card-body">
                                <div class="member-avatar">
                                    <span class="avatar-initials">@GetInitials(member.NhanVien?.HoTen)</span>
                                </div>
                                <div class="member-info">
                                    <div class="member-header-row">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <strong class="member-name text-navy">@member.NhanVien?.HoTen</strong>
                                            <span class="member-code">#@member.MaNhanVien</span>
                                        </div>
                                        @if (isEnded)
                                        {
                                            <span class="event-badge event-badge--ended"><i class="bi bi-check2-circle"></i> Đã kết thúc</span>
                                        }
                                        else
                                        {
                                            <span class="event-badge event-badge--active"><i class="bi bi-check-circle-fill"></i> Đang phân công</span>
                                        }
                                    </div>

                                    <div class="member-meta-row mt-2">
                                        <span class="event-role-pill"><i class="bi bi-person-badge"></i> @member.VaiTroDuAn</span>
                                        <span class="event-shift-pill" title="Ca làm việc chính thức làm nguồn">
                                            <i class="bi bi-clock-history"></i> @shiftName
                                        </span>
                                    </div>

                                    <div class="member-time-row mt-2">
                                        <i class="bi bi-clock text-gold"></i>
                                        <span>@HotelEventRules.Local(member.BatDau).ToString("dd/MM HH:mm") – @HotelEventRules.Local(member.KetThuc).ToString("dd/MM HH:mm")</span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(member.LyDoKetThuc))
                                    {
                                        <div class="member-note-row mt-2">
                                            <i class="bi bi-info-circle text-muted"></i>
                                            <span class="text-muted small">@member.LyDoKetThuc</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (canStaff && !isEnded)
                            {
                                <div class="member-card-footer pt-3 mt-3 border-top d-flex justify-content-end align-items-center gap-2">
                                    <button type="button" class="event-action-btn event-action-btn--secondary" data-change-role data-assignment-id="@member.MaPhanCong" data-employee-id="@member.MaNhanVien" data-employee-name="@member.NhanVien?.HoTen" data-department="@code" data-version="@item.Version" title="Đổi vai trò nhân sự">
                                        <i class="bi bi-arrow-repeat"></i> Đổi vai trò
                                    </button>
                                    @if (canRemoveMember)
                                    {
                                        <form asp-action="RemoveAssignment" asp-route-id="@item.MaDuAn" method="post" class="d-inline" data-remove-assignment-form>
                                            <partial name="_EventContext" model="Model" />
                                            <input name="version" value="@item.Version" type="hidden" />
                                            <input name="assignmentId" value="@member.MaPhanCong" type="hidden" />
                                            <button type="button" class="event-action-btn event-action-btn--danger" data-confirm-remove data-employee-name="@member.NhanVien?.HoTen" title="Gỡ nhân viên khỏi sự kiện">
                                                <i class="bi bi-trash3"></i> Gỡ
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (canceledMembers.Count > 0)
            {
                <details class="event-history-details mt-3">
                    <summary class="text-muted small fw-semibold py-1">
                        <i class="bi bi-clock-history"></i> Lịch sử đã gỡ / hủy (@canceledMembers.Count nhân sự)
                    </summary>
                    <div class="event-history-list mt-2">
                        @foreach (var member in canceledMembers)
                        {
                            <div class="event-assigned-member-card event-assigned-member-card--muted" data-assigned-member data-employee-id="@member.MaNhanVien">
                                <div class="member-card-body">
                                    <div class="member-avatar member-avatar--muted">
                                        <span class="avatar-initials">@GetInitials(member.NhanVien?.HoTen)</span>
                                    </div>
                                    <div class="member-info">
                                        <div class="member-header-row">
                                            <span class="member-name text-muted">@member.NhanVien?.HoTen <small class="text-muted">#@member.MaNhanVien</small></span>
                                            <span class="event-badge event-badge--canceled"><i class="bi bi-x-circle"></i> Đã gỡ</span>
                                        </div>
                                        <div class="member-meta-row mt-1">
                                            <span class="event-role-pill">@member.VaiTroDuAn</span>
                                            <span class="event-shift-pill">Ca #@member.MaPhanCa</span>
                                            <small class="text-muted">@HotelEventRules.Local(member.BatDau).ToString("dd/MM HH:mm") – @HotelEventRules.Local(member.KetThuc).ToString("dd/MM HH:mm")</small>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(member.LyDoKetThuc))
                                        {
                                            <small class="text-muted fst-italic mt-1 d-block"><i class="bi bi-info-circle"></i> @member.LyDoKetThuc</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }

            @if (canStaff)
            {
                <div class="event-member-picker" data-member-picker id="picker-@item.MaDuAn-@code" data-department-code="@code" data-department-name="@deptName" data-assignment-url="@Url.Action("Assignment", new { id = item.MaDuAn, department = code, returnYear = Model.ReturnYear, returnMonth = Model.ReturnMonth, returnDate = Model.ReturnDate.ToString("yyyy-MM-dd") })" hidden>
                    <div class="picker-search-bar mb-3">
                        <label for="search-@item.MaDuAn-@code" class="form-label fw-semibold text-navy">
                            <i class="bi bi-search text-gold me-1"></i> Chọn nhân viên @deptName
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input id="search-@item.MaDuAn-@code" type="search" class="form-control border-start-0 ps-0" data-member-search placeholder="Tìm theo tên hoặc mã nhân viên..." />
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small">Khả dụng: <strong>@available.Count</strong> nhân sự có ca</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-gold-dark fw-semibold" data-picker-select-all>Chọn tất cả</button>
                            <span class="text-muted small">·</span>
                            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" data-picker-deselect-all>Bỏ chọn</button>
                        </div>
                    </div>
                    <div class="event-member-options">
                        @foreach (var employee in available)
                        {
                            var empShifts = Model.Shifts.Where(s => s.MaNhanVien == employee.MaNhanVien).ToList();
                            var eligible = HotelEventRules.ContractCovers(employee, item.NgayBatDau, item.NgayKetThuc);
                            <label class="event-member-option" data-member-name="@employee.HoTen" data-member-id="@employee.MaNhanVien">
                                <div class="d-flex align-items-center gap-3 w-100 min-w-0">
                                    <div class="member-avatar member-avatar--sm">
                                        <span class="avatar-initials">@GetInitials(employee.HoTen)</span>
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <strong class="member-name text-navy">@employee.HoTen</strong>
                                            <span class="badge bg-slate-subtle text-slate-dark border">#@employee.MaNhanVien</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                            <span class="badge bg-blue-subtle text-blue-dark">
                                                <i class="bi bi-calendar2-check"></i> @empShifts.Count ca trực phù hợp
                                            </span>
                                            @if (!eligible)
                                            {
                                                <span class="badge bg-amber-subtle text-amber-dark">
                                                    <i class="bi bi-exclamation-circle"></i> Kiểm tra hạn HĐ
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <input type="checkbox" class="event-member-toggle" value="@employee.MaNhanVien" data-choose-member="@employee.MaNhanVien" aria-label="Chọn @employee.HoTen" />
                                </div>
                            </label>
                        }
                    </div>
                    <p class="event-empty-search text-center py-4 my-2 text-muted" data-member-empty hidden="@(available.Count > 0)">
                        <i class="bi bi-people display-6 d-block mb-2 text-muted opacity-50"></i>
                        @(available.Count == 0 ? "Không có nhân viên nào có ca trực đã công bố trong tuần này." : "Không tìm thấy nhân viên phù hợp.")
                    </p>
                    <div class="event-form-actions d-flex justify-content-end gap-2 pt-3 border-top mt-3">
                        <button type="button" class="event-secondary-button" data-assignment-close>Hủy</button>
                        <button type="button" class="event-primary-button" data-continue-assignment disabled>
                            Tiếp tục thiết lập <span data-selected-count>(0)</span> <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
        </section>
    }
    </div>
}
