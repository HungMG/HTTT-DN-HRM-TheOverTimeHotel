@model EventFormViewModel
@{ ViewData["Title"] = "Tạo sự kiện"; }
<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />
<div class="events-page event-create-page"><a class="event-back-link" asp-action="Index" asp-route-year="@Model.ReturnYear" asp-route-month="@Model.ReturnMonth" asp-route-date="@Model.ReturnDate.ToString("yyyy-MM-dd")"><i class="bi bi-arrow-left" aria-hidden="true"></i> Trở về lịch sự kiện</a><div class="event-page-heading"><div><span class="event-eyebrow">MỘT KẾ HOẠCH MỚI</span><h2>Tạo sự kiện</h2><p>Ghi lại ý tưởng hôm nay, cùng đội ngũ tạo nên trải nghiệm ngày mai.</p></div></div><form asp-action="Create" method="post" data-event-time-form><partial name="_EventForm" model="Model" /></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/events.js" asp-append-version="true"></script> }
