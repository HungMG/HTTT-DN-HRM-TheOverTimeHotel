@model EventFormViewModel
@{ ViewData["Title"] = "Địa điểm sự kiện"; }
<div class="container py-4">
    <h1 class="h3">Địa điểm sự kiện</h1>
    <p>Thêm địa điểm và sức chứa trước khi đặt sự kiện.</p>
    <form asp-action="SaveVenue" method="post" class="card card-body">
        <input asp-for="ReturnYear" type="hidden" /><input asp-for="ReturnMonth" type="hidden" /><input asp-for="ReturnDate" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <label asp-for="VenueName" class="form-label">Tên địa điểm</label>
        <input asp-for="VenueName" class="form-control mb-3" required maxlength="255" />
        <label asp-for="VenueCapacity" class="form-label">Sức chứa (khách)</label>
        <input asp-for="VenueCapacity" type="number" class="form-control mb-3" min="1" step="1" required />
        <button type="submit" class="btn btn-primary align-self-start">Lưu và tạo sự kiện</button>
    </form>
    <ul class="mt-3">@foreach (var venue in Model.Venues) { <li>@venue.TenDiaDiem · @venue.SucChua khách</li> }</ul>
    <a asp-action="Create" asp-route-date="@Model.ReturnDate.ToString("yyyy-MM-dd")">Trở về tạo sự kiện</a>
</div>
