@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
@{
    var item = Model.Event;
    var statusLabel = HotelEventRules.StatusLabels.GetValueOrDefault(item.TrangThai, item.TrangThai);
}
<div class="events-page event-details-content p-0" data-event-details data-event-id="@item.MaDuAn" data-event-count="@item.PhanCongs.Count" data-event-status="@item.TrangThai" data-event-status-label="@statusLabel" data-active-section="@Model.Tab">
    <div class="event-page-heading">
        <div>
            <span class="event-eyebrow">SK-@item.MaDuAn.ToString("D4") · @HotelEventRules.TypeLabels.GetValueOrDefault(item.LoaiDuAn, item.LoaiDuAn)</span>
            <h2>@item.TenDuAn</h2>
            <p><i class="bi bi-geo-alt" aria-hidden="true"></i> @item.DiaDiem · @HotelEventRules.Local(item.NgayBatDau).ToString("dd/MM/yyyy HH:mm") – @HotelEventRules.Local(item.NgayKetThuc).ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="event-status event-status-@item.TrangThai">@statusLabel</span>
            @if (Model.CanEdit)
            {
                <a class="event-secondary-button" asp-action="Edit" asp-route-id="@item.MaDuAn" asp-route-returnYear="@Model.ReturnYear" asp-route-returnMonth="@Model.ReturnMonth" asp-route-returnDate="@Model.ReturnDate.ToString("yyyy-MM-dd")"><i class="bi bi-pencil" aria-hidden="true"></i> Chỉnh sửa</a>
            }
        </div>
    </div>
    @if ((ViewData["EventSuccess"] ?? TempData["Success"]) is string message)
    {
        <div class="alert alert-success" role="status">@message</div>
    }
    <div asp-validation-summary="All" class="text-danger event-validation" role="alert"></div>
    @if (item.TrangThai is "HOAN_THANH" or "HUY")
    {
        <div class="event-info-note mb-3">@(item.TrangThai == "HOAN_THANH" ? "Sự kiện đã nghiệm thu. Thông tin và phụ cấp đã được khóa." : "Sự kiện đã hủy. " + item.LyDoHuy)</div>
    }
    <nav class="event-details-navigation" aria-label="Nội dung sự kiện">
        <button type="button" class="event-secondary-button" data-details-section="overview" aria-pressed="@(Model.Tab == "overview" ? "true" : "false")"><i class="bi bi-arrow-left" aria-hidden="true"></i> Thông tin sự kiện</button>
        <button type="button" class="event-secondary-button" data-details-section="staff" aria-pressed="@(Model.Tab == "staff" ? "true" : "false")"><i class="bi bi-people" aria-hidden="true"></i> Nhân sự · @item.PhanCongs.Count</button>
        <button type="button" class="event-secondary-button" data-details-section="acceptance" aria-pressed="@(Model.Tab == "acceptance" ? "true" : "false")"><i class="bi bi-patch-check" aria-hidden="true"></i> Đánh giá &amp; nghiệm thu</button>
    </nav>
    <section data-details-pane="overview" hidden="@(Model.Tab != "overview")"><partial name="_EventOverview" model="Model" /></section>
    <section data-details-pane="staff" hidden="@(Model.Tab != "staff")"><partial name="_EventStaff" model="Model" /></section>
    <section data-details-pane="acceptance" hidden="@(Model.Tab != "acceptance")"><partial name="_EventAcceptance" model="Model" /></section>
</div>
