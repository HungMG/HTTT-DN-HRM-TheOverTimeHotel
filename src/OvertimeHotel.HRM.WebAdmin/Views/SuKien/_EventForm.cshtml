@model EventFormViewModel
@using OvertimeHotel.HRM.Core.Policies
@{ var minDate = Model.Input.Id == 0 ? HotelEventRules.Local(DateTimeOffset.UtcNow).ToString("yyyy-MM-dd") + "T00:00" : null; }
<input asp-for="IsPopup" type="hidden" />
<input asp-for="Input.CalculateBudgetAtAcceptance" type="hidden" />
<input asp-for="Input.HourlyCompensation" type="hidden" />
<input asp-for="Input.Id" type="hidden" /><input asp-for="Input.Version" type="hidden" />
<input asp-for="ReturnYear" type="hidden" /><input asp-for="ReturnMonth" type="hidden" /><input asp-for="ReturnDate" type="hidden" />
<div asp-validation-summary="All" class="text-danger event-validation" role="alert"></div>
<div class="event-form-grid">
    <section class="event-panel">
        <span class="event-eyebrow">01 · TỔ CHỨC</span><h3>Thông tin tổ chức</h3>
        <div class="mb-3"><label asp-for="Input.Name" class="form-label">Tên sự kiện <span aria-hidden="true">*</span></label><input asp-for="Input.Name" class="form-control" placeholder="Ví dụ: Hội nghị khách hàng cuối năm" required maxlength="200" /><span asp-validation-for="Input.Name" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.Type" class="form-label">Loại sự kiện</label><select asp-for="Input.Type" class="form-select">@foreach (var type in HotelEventRules.TypeLabels) { <option value="@type.Key">@type.Value</option> }</select><span asp-validation-for="Input.Type" class="text-danger"></span></div>
        <div class="mb-3"><span class="form-label d-block">Địa điểm</span><p class="form-control-plaintext mb-0">@HotelEventRules.HotelVenueName</p></div>
        <div class="mb-3"><label asp-for="Input.Start" class="form-label">Bắt đầu <span aria-hidden="true">*</span></label><input asp-for="Input.Start" data-event-start asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" min="@minDate" class="form-control" required /><span asp-validation-for="Input.Start" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Input.End" class="form-label">Kết thúc <span aria-hidden="true">*</span></label><input asp-for="Input.End" data-event-end asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" min="@minDate" class="form-control" required /><span asp-validation-for="Input.End" class="text-danger"></span><div class="form-text">Theo giờ Việt Nam (UTC+7). Chỉ tạo từ hôm nay trở đi, có thể tổ chức qua nhiều ngày.</div></div>
    </section>
    <section class="event-panel">
        <span class="event-eyebrow">02 · ĐIỀU PHỐI</span><h3>Thông tin điều phối</h3>
        <div class="mb-3"><label asp-for="Input.ManagerId" class="form-label">Người quản lý <span aria-hidden="true">*</span></label><select asp-for="Input.ManagerId" asp-items="Model.Managers" class="form-select" required><option value="">Chọn quản lý sự kiện</option></select><span asp-validation-for="Input.ManagerId" class="text-danger"></span></div>
        <div class="row"><div class="col-sm-6 mb-3"><label asp-for="Input.ExpectedGuests" class="form-label">Khách dự kiến</label><input asp-for="Input.ExpectedGuests" class="form-control" type="number" min="0" step="1" required /><span asp-validation-for="Input.ExpectedGuests" class="text-danger"></span></div>@if (Model.Input.Id != 0 && !Model.Input.CalculateBudgetAtAcceptance) { <div class="col-sm-6 mb-3"><label asp-for="Input.Budget" class="form-label">Ngân sách phụ cấp (đ)</label><input asp-for="Input.Budget" class="form-control" type="number" min="0" step="0.01" required /><span asp-validation-for="Input.Budget" class="text-danger"></span></div> }</div>
        <div class="mb-3"><label asp-for="Input.Description" class="form-label">Mô tả &amp; ghi chú</label><textarea asp-for="Input.Description" class="form-control" rows="5" placeholder="Nội dung, yêu cầu phục vụ và các lưu ý cho đội ngũ…" maxlength="10000"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div>
        <div class="event-info-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>@(Model.Input.HourlyCompensation ? "Thu nhập sự kiện cộng thêm = lương cơ bản tháng / 26 / 8 × giờ thực tế được xác nhận trong ca chính thức. Lương ca thường vẫn giữ nguyên. Khai báo nhu cầu trước, xếp và công bố lịch tuần rồi phân công từ các ca đó." : Model.Input.CalculateBudgetAtAcceptance ? "Ngân sách trả nhân viên được tính theo kết quả hoàn thành khi nghiệm thu sự kiện." : "Phân công nhân sự và đánh giá phụ cấp sau khi lưu sự kiện.")</span></div>
    </section>
</div>
<div class="event-form-actions">
    @if (Model.IsPopup) { <button class="event-secondary-button" type="button" data-bs-dismiss="modal">Hủy</button> }
    else { <a class="event-secondary-button" asp-action="Index" asp-route-year="@Model.ReturnYear" asp-route-month="@Model.ReturnMonth" asp-route-date="@Model.ReturnDate.ToString("yyyy-MM-dd")">Hủy</a> }
    <button class="event-primary-button" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Lưu sự kiện</button>
</div>
