@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
@using System.Globalization
@{
    var item = Model.Event;
    var active = item.PhanCongs.Where(p => p.TrangThaiThamGia != "HUY_PHAN_CONG" && p.TrangThaiThamGia != "DA_HUY").ToList();
    var distinctEmployees = HotelEventRules.CountEffectiveStaff(item.PhanCongs);
    var closed = item.TrangThai is "HOAN_THANH" or "HUY";
    var summary = Model.StaffingSummary;

    // Lấy danh sách các phòng ban (chuẩn hóa theo sự kiện + các phòng ban có phân công)
    var departments = summary.Departments.ToList();
    var groupedIds = departments.SelectMany(d => d.Assignments).Select(p => p.MaPhanCong).ToHashSet();
    var otherAssignments = active.Where(p => !groupedIds.Contains(p.MaPhanCong)).ToList();
    if (otherAssignments.Count > 0)
    {
        departments.Add(new EventDepartmentStatus("OTHER", "Phòng ban khác", otherAssignments.Select(p => p.MaNhanVien).Distinct().Count(), true, otherAssignments));
    }

    // Nếu sự kiện chưa có định mức phòng ban nào (VD: loại sự kiện tự do)
    if (departments.Count == 0)
    {
        var groupedByDept = active.GroupBy(p => p.MaPhongBanSuKien ?? HotelEventRules.ResolveDepartmentCode(p.NhanVien) ?? "OTHER").ToList();
        foreach (var grp in groupedByDept)
        {
            var deptName = HotelEventRules.DepartmentLabels.GetValueOrDefault(grp.Key, grp.Key == "OTHER" ? "Phòng ban khác" : grp.Key);
            departments.Add(new EventDepartmentStatus(grp.Key, deptName, grp.Select(p => p.MaNhanVien).Distinct().Count(), true, grp.ToList()));
        }
        if (departments.Count == 0)
        {
            foreach (var kv in HotelEventRules.DepartmentLabels)
            {
                departments.Add(new EventDepartmentStatus(kv.Key, kv.Value, 0, false,
                    Array.Empty<OvertimeHotel.HRM.Core.Models.PhanCongDuAn>()));
            }
        }
    }

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "NV";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2].ToUpper() : parts[0].ToUpper();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }

    string GetDepartmentIcon(string code) => code switch
    {
        "TIEN_SANH" => "bi-building",
        "AM_THUC" => "bi-cup-straw",
        "BEP" => "bi-fire",
        "BUONG_PHONG" => "bi-door-closed",
        "KY_THUAT" => "bi-gear-wide-connected",
        "AN_NINH" => "bi-shield-check",
        "IT" => "bi-pc-display",
        _ => "bi-people"
    };
}

<div class="event-staff-directory" data-event-staff>
<div class="event-staff-heading d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <span class="event-eyebrow">ĐỘI NGŨ SỰ KIỆN THEO PHÒNG BAN</span>
        <h3 class="mb-0">@(Model.StaffLoadFailed ? "Danh sách nhân sự" : $"{distinctEmployees} nhân sự tham gia · {departments.Count(d => d.Assignments.Any(p => p.TrangThaiThamGia != "HUY_PHAN_CONG" && p.TrangThaiThamGia != "DA_HUY"))} phòng ban đã bố trí")</h3>
    </div>
    <div>
        <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="event-secondary-button">
            <i class="bi bi-calendar3" aria-hidden="true"></i> Mở Lịch làm việc
        </a>
    </div>
</div>

@if (Model.StaffLoadFailed)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2" aria-hidden="true"></i>
        <strong>Không tải được danh sách nhân sự.</strong> Vui lòng tải lại trang hoặc kiểm tra kết nối hệ thống.
    </div>
}
else
{
    @if (active.Count == 0)
    {
        <div class="alert alert-info" role="status">
            <strong>Chưa sắp xếp sự kiện.</strong>
            <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")">Bố trí ca bên Lịch làm việc</a>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(summary.SummaryText))
    {
        <div class="alert @(closed || summary.IsFullyStaffed ? "alert-success" : "alert-warning") d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3" role="status">
            <div>
                <i class="bi @(closed || summary.IsFullyStaffed ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2" aria-hidden="true"></i>
                <strong>@(closed ? "Đã khóa nhân sự sự kiện" : summary.IsFullyStaffed ? "Đã bố trí đủ phòng ban" : "Kế hoạch nhân sự")</strong>:
                @(closed ? "Dữ liệu sự kiện đã được khóa; giữ nguyên vai trò và phụ cấp đã ghi nhận." : summary.SummaryText)
            </div>
            <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-dark">
                <i class="bi bi-calendar3 me-1"></i> Điều phối trên Lịch làm việc
            </a>
        </div>
    }

    <div class="event-staff-filters" role="group" aria-label="Lọc nhân sự theo phòng ban">
        <button type="button" class="event-staff-filter" data-staff-department-filter="all" aria-pressed="true" aria-controls="event-staff-departments-@item.MaDuAn">
            <i class="bi bi-people" aria-hidden="true"></i><span>Tất cả</span><span class="event-staff-filter__count">@distinctEmployees</span>
        </button>
        @foreach (var dept in departments)
        {
            var deptActiveCount = dept.Assignments.Where(p => p.TrangThaiThamGia is not ("HUY_PHAN_CONG" or "DA_HUY")).Select(p => p.MaNhanVien).Distinct().Count();
            <button type="button" class="event-staff-filter" data-staff-department-filter="@dept.Code" aria-pressed="false" aria-controls="event-staff-departments-@item.MaDuAn">
                <i class="bi @GetDepartmentIcon(dept.Code)" aria-hidden="true"></i>
                <span>@dept.Name</span>
                <span class="event-staff-filter__count">@deptActiveCount</span>
            </button>
        }
    </div>

    <!-- Danh sách nhân sự chia theo từng phòng ban -->
    <div class="event-department-list" id="event-staff-departments-@item.MaDuAn">
        @foreach (var department in departments)
        {
            var deptActive = department.Assignments.Where(p => p.TrangThaiThamGia != "HUY_PHAN_CONG" && p.TrangThaiThamGia != "DA_HUY").ToList();
            <section class="event-department-card" id="dept-@department.Code" data-department-card="@department.Code">
                <header class="event-department-card__header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="department-icon-badge">
                            <i class="bi @GetDepartmentIcon(department.Code)" aria-hidden="true"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold text-navy">@department.Name</h4>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="text-muted small">@deptActive.Select(p => p.MaNhanVien).Distinct().Count() nhân sự phân công</span>
                                @if (deptActive.Count > 0)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã bố trí
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Chưa có nhân sự
                                    </span>
                                }
                                @if (department.RequiredCount > 0)
                                {
                                    <span class="badge bg-light text-secondary border">Định mức: @department.RequiredCount người</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div>
                        <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary" title="Bố trí ca trong Lịch làm việc">
                            <i class="bi bi-calendar-plus me-1"></i> Bố trí ca
                        </a>
                    </div>
                </header>

                @if (deptActive.Count > 0)
                {
                    <div class="event-assigned-grid event-staff-member-grid mt-3">
                        @foreach (var member in deptActive.OrderBy(p => p.BatDau).ThenBy(p => p.NhanVien?.HoTen))
                        {
                            var statusLabel = member.TrangThaiThamGia switch
                            {
                                "DA_KET_THUC" => "Đã kết thúc",
                                "DA_PHAN" => "Đang phân công",
                                _ => member.TrangThaiThamGia
                            };
                            <article class="event-assigned-member-card event-staff-member-card" data-assigned-member data-employee-id="@member.MaNhanVien">
                                <header class="event-staff-person-card">
                                    <span class="avatar-initials event-staff-person-avatar" aria-hidden="true">@GetInitials(member.NhanVien?.HoTen)</span>
                                    <div>
                                        <strong>@(member.NhanVien?.HoTen ?? $"NV #{member.MaNhanVien}")</strong>
                                        <small>Mã nhân viên #@member.MaNhanVien</small>
                                    </div>
                                </header>
                                <dl class="event-staff-member-details">
                                    <div class="event-staff-member-details__wide">
                                        <dt>Vai trò / Nhiệm vụ</dt>
                                        <dd><strong>@member.VaiTroDuAn</strong>
                                            @if (!string.IsNullOrWhiteSpace(member.NhiemVuCuThe))
                                            {
                                                <span class="d-block mt-1 text-secondary">@member.NhiemVuCuThe</span>
                                            }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>Ca nguồn</dt>
                                        <dd>
                                            @if (member.MaPhanCa.HasValue)
                                            {
                                                <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(member.BatDau)).ToString("yyyy-MM-dd")" class="event-staff-source-link" title="Xem ca làm việc">
                                                    <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Ca #@member.MaPhanCa
                                                </a>
                                            }
                                            else { <span class="text-muted">Chưa có ca nguồn</span> }
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>Trạng thái</dt>
                                        <dd><span class="badge @(member.TrangThaiThamGia == "DA_PHAN" ? "bg-success" : "bg-secondary")">@statusLabel</span></dd>
                                    </div>
                                    <div class="event-staff-member-details__wide">
                                        <dt>Thời gian tham gia</dt>
                                        <dd class="event-staff-time-range">
                                            <time datetime="@member.BatDau.ToString("O")">@HotelEventRules.Local(member.BatDau).ToString("dd/MM HH:mm")</time>
                                            <span>–</span>
                                            <time datetime="@member.KetThuc.ToString("O")">@HotelEventRules.Local(member.KetThuc).ToString("dd/MM HH:mm")</time>
                                        </dd>
                                    </div>
                                </dl>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="p-3 mt-3 bg-light rounded-3 text-muted small d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-info-circle text-secondary"></i>
                            <span>Chưa có nhân sự nào từ bộ phận này được phân công vào sự kiện.</span>
                        </div>
                        <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-calendar-plus me-1"></i> Bố trí ca
                        </a>
                    </div>
                }
            </section>
        }
    </div>
}

</div>
