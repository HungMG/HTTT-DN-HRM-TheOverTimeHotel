@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
@{
    var item = Model.Event;
    var active = item.PhanCongs.Where(p => p.TrangThaiThamGia != "HUY_PHAN_CONG" && p.TrangThaiThamGia != "DA_HUY").ToList();
    var distinctEmployees = HotelEventRules.CountEffectiveStaff(item.PhanCongs);
    var historyAssignments = item.PhanCongs.Where(p => p.TrangThaiThamGia is "HUY_PHAN_CONG" or "DA_HUY" or "DA_KET_THUC").ToList();
}

<div class="event-staff-heading d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <span class="event-eyebrow">ĐỘI NGŨ SỰ KIỆN THEO LỊCH LÀM VIỆC</span>
        <h3 class="mb-0">@(Model.StaffLoadFailed ? "Danh sách nhân sự" : $"{distinctEmployees} nhân sự tham gia")</h3>
    </div>
    <div>
        <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="event-secondary-button">
            <i class="bi bi-calendar3" aria-hidden="true"></i> Mở Lịch làm việc
        </a>
    </div>
</div>

@if (Model.StaffLoadFailed)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2" aria-hidden="true"></i>
        <strong>Không tải được danh sách nhân sự.</strong> Vui lòng tải lại trang hoặc kiểm tra kết nối hệ thống.
    </div>
}
else if (active.Count == 0)
{
    <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
        <div>
            <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>
            <strong>Chưa sắp xếp sự kiện.</strong> Sự kiện chưa có nhân sự nào được phân công từ bên Lịch làm việc.
        </div>
        <a asp-controller="PhanCa" asp-action="Index" asp-route-week="@DateOnly.FromDateTime(HotelEventRules.Local(item.NgayBatDau)).ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-calendar3 me-1"></i> Bố trí ca bên Lịch làm việc
        </a>
    </div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle event-table">
            <thead class="table-light">
                <tr>
                    <th>Nhân sự</th>
                    <th>Phòng ban</th>
                    <th>Vai trò / Nhiệm vụ</th>
                    <th>Ca nguồn</th>
                    <th>Thời gian tham gia</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in active.OrderBy(p => p.BatDau).ThenBy(p => p.NhanVien?.HoTen))
                {
                    var deptCode = member.MaPhongBanSuKien ?? HotelEventRules.ResolveDepartmentCode(member.NhanVien);
                    var statusLabel = member.TrangThaiThamGia switch
                    {
                        "DA_KET_THUC" => "Đã kết thúc",
                        "DA_PHAN" => "Đang phân công",
                        _ => member.TrangThaiThamGia
                    };
                    <tr data-assigned-member data-employee-id="@member.MaNhanVien">
                        <td>
                            <strong>@(member.NhanVien?.HoTen ?? $"NV #{member.MaNhanVien}")</strong>
                        </td>
                        <td>
                            @HotelEventRules.DepartmentLabels.GetValueOrDefault(deptCode ?? "", deptCode ?? "Khác")
                        </td>
                        <td>
                            <span>@member.VaiTroDuAn</span>
                            @if (!string.IsNullOrWhiteSpace(member.NhiemVuCuThe))
                            {
                                <small class="text-muted d-block">@member.NhiemVuCuThe</small>
                            }
                        </td>
                        <td>
                            @if (member.MaPhanCa.HasValue)
                            {
                                <span class="badge bg-light text-dark border">Ca #@member.MaPhanCa</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <small>@HotelEventRules.Local(member.BatDau).ToString("dd/MM HH:mm") – @HotelEventRules.Local(member.KetThuc).ToString("dd/MM HH:mm")</small>
                        </td>
                        <td>
                            <span class="badge @(member.TrangThaiThamGia == "DA_PHAN" ? "bg-success" : "bg-secondary")">@statusLabel</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (historyAssignments.Count > 0)
{
    <details class="event-panel mt-3">
        <summary class="fw-semibold text-secondary">Lịch sử phân công (@historyAssignments.Count bản ghi đã hủy / kết thúc)</summary>
        <div class="table-responsive mt-2">
            <table class="table table-sm text-muted align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nhân sự</th>
                        <th>Vai trò</th>
                        <th>Khung giờ</th>
                        <th>Trạng thái</th>
                        <th>Lý do</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in historyAssignments.OrderByDescending(p => p.KetThuc))
                    {
                        <tr>
                            <td>@(h.NhanVien?.HoTen ?? $"NV #{h.MaNhanVien}")</td>
                            <td>@h.VaiTroDuAn</td>
                            <td><small>@HotelEventRules.Local(h.BatDau).ToString("dd/MM HH:mm") – @HotelEventRules.Local(h.KetThuc).ToString("dd/MM HH:mm")</small></td>
                            <td>
                                <span class="badge bg-secondary">@(h.TrangThaiThamGia is "HUY_PHAN_CONG" or "DA_HUY" ? "Đã hủy" : "Đã kết thúc")</span>
                            </td>
                            <td><small>@(h.LyDoKetThuc ?? "—")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}
