@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
@{
    var employee = Model.Employees.SingleOrDefault(n => n.MaNhanVien == Model.Assignment.EmployeeId);
}
<form asp-action="Assign" asp-route-id="@Model.Event.MaDuAn" method="post" data-assignment-popup-form data-event-time-form>
    <partial name="_EventContext" model="Model" />
    <input asp-for="Assignment.Version" type="hidden" />
    <input asp-for="Assignment.EmployeeId" type="hidden" />
    <input asp-for="SelectedDepartment" type="hidden" />
    <div asp-validation-summary="All" class="text-danger event-validation" role="alert"></div>
    <p class="event-assignment-person"><strong>@(employee?.HoTen ?? "Nhân viên không còn khả dụng")</strong><span>@HotelEventRules.DepartmentLabels.GetValueOrDefault(Model.SelectedDepartment ?? "", "Chưa xác định phòng ban")</span></p>
    <div class="mb-3">
        <label asp-for="Assignment.Role" class="form-label">Vai trò trong sự kiện <span aria-hidden="true">*</span></label>
        <select asp-for="Assignment.Role" class="form-select" required autofocus data-assignment-role>
            <option value="">Chọn vai trò</option>
            @foreach (var role in Model.AssignmentRoles)
            {
                <option value="@role.Name">@role.Name — @(role.IsRequired ? $"Cần {role.RequiredCount}, đã có {role.MinimumConcurrentCount}" : "Vai trò bổ sung")</option>
            }
            <option value="@HotelEventRoleRules.OtherRoleValue" data-custom-role>Vai trò khác</option>
        </select>
        <span asp-validation-for="Assignment.Role" class="text-danger"></span>
    </div>
    <div class="mb-3" data-custom-role-fields hidden="@(Model.Assignment.Role != HotelEventRoleRules.OtherRoleValue)">
        <label asp-for="Assignment.OtherRole" class="form-label">Tên vai trò khác <span aria-hidden="true">*</span></label>
        <input asp-for="Assignment.OtherRole" class="form-control" maxlength="@(100 - HotelEventRoleRules.OtherRolePrefix.Length)" data-custom-role-name required="@(Model.Assignment.Role == HotelEventRoleRules.OtherRoleValue)" disabled="@(Model.Assignment.Role != HotelEventRoleRules.OtherRoleValue)" />
        <span asp-validation-for="Assignment.OtherRole" class="text-danger"></span>
        <small class="form-text">Vai trò khác là bổ sung, không thay thế vai trò bắt buộc.</small>
    </div>
    <details class="event-assignment-options" open="@(!ViewData.ModelState.IsValid)">
        <summary>Thời gian tham gia và phụ cấp</summary>
        <div class="mt-3 mb-3">
            <label asp-for="Assignment.Start" class="form-label">Bắt đầu tham gia (UTC+7)</label>
            <input asp-for="Assignment.Start" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" required data-event-start />
            <span asp-validation-for="Assignment.Start" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Assignment.End" class="form-label">Kết thúc tham gia (UTC+7)</label>
            <input asp-for="Assignment.End" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" required data-event-end />
            <span asp-validation-for="Assignment.End" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Assignment.Allowance" class="form-label">Phụ cấp dự kiến (đ)</label>
            <input asp-for="Assignment.Allowance" type="number" class="form-control" min="0" step="0.01" required />
            <span asp-validation-for="Assignment.Allowance" class="text-danger"></span>
        </div>
    </details>
    <div class="event-form-actions">
        <button class="event-secondary-button" type="button" data-bs-dismiss="modal">Hủy</button>
        <button class="event-primary-button" type="submit">Lưu phân công</button>
    </div>
</form>
