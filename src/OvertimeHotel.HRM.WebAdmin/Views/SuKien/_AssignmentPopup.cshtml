@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
<form asp-action="AssignMany" asp-route-id="@Model.Event.MaDuAn" method="post" data-assignment-popup-form data-event-time-form>
    <partial name="_EventContext" model="Model" />
    <input asp-for="Assignment.Version" type="hidden" />
    <input asp-for="SelectedDepartment" type="hidden" />
    <div asp-validation-summary="All" class="text-danger event-validation" role="alert"></div>
    <p class="event-muted">@Model.Assignments.Count nhân viên · @HotelEventRules.DepartmentLabels.GetValueOrDefault(Model.SelectedDepartment ?? "", "Chưa xác định phòng ban")</p>
    @for (var i = 0; i < Model.Assignments.Count; i++)
    {
        var employee = Model.Employees.SingleOrDefault(n => n.MaNhanVien == Model.Assignments[i].EmployeeId);
    <section class="event-assignment-person" data-assignment-person>
        <input asp-for="Assignments[i].EmployeeId" type="hidden" />
        <h3 class="h6">@(employee?.HoTen ?? "Nhân viên không còn khả dụng")</h3>
        @if (Model.Event.TinhTheoGio)
        {
            <label asp-for="Assignments[i].ShiftId" class="form-label">Ca chính thức làm nguồn</label>
            <select asp-for="Assignments[i].ShiftId" class="form-select mb-3" required>
                <option value="">Chọn ca đã công bố</option>
                @foreach (var shift in Model.Shifts.Where(s => s.MaNhanVien == Model.Assignments[i].EmployeeId))
                { <option value="@shift.MaPhanCa">@shift.CaLamViec?.TenCa · @HotelEventRules.Local(shift.BatDauDuKien).ToString("dd/MM HH:mm") – @HotelEventRules.Local(shift.KetThucDuKien).ToString("dd/MM HH:mm")</option> }
            </select>
            <span asp-validation-for="Assignments[i].ShiftId" class="text-danger"></span>
            <small class="form-text">Thời gian chung bên dưới được giới hạn theo ca nguồn của từng người. Có thể phân công thêm các đoạn không trùng giờ.</small>
        }

        <label asp-for="Assignments[i].Role" class="form-label">Vai trò trong sự kiện <span aria-hidden="true">*</span></label>
        <select asp-for="Assignments[i].Role" class="form-select" required data-assignment-role>
            <option value="">Chọn vai trò</option>
            @if (Model.Event.TinhTheoGio)
            {
                @foreach (var role in HotelEventRoleRules.GetRoles(Model.Event.LoaiDuAn, Model.SelectedDepartment ?? "", Model.Event.SoKhachDuKien))
                { <option value="@role.Name">@role.Name</option> }
            }
            else
            {
            @foreach (var role in HotelEventRoleRules.GetRoles(Model.Event.LoaiDuAn, Model.SelectedDepartment ?? "", Model.Event.SoKhachDuKien))
            {
                var staffing = Model.AssignmentRoles.FirstOrDefault(r => HotelEventRoleRules.Matches(role.Name, r.Name));
                <option value="@role.Name">@role.Name — @(staffing is { IsRequired: true } ? $"Cần {staffing.RequiredCount}, đã có {staffing.MinimumConcurrentCount}" : "Vai trò bổ sung")</option>
            }
            }
            <option value="@HotelEventRoleRules.OtherRoleValue" data-custom-role>Vai trò khác</option>
        </select>
        <span asp-validation-for="Assignments[i].Role" class="text-danger"></span>
    <div class="mt-3" data-custom-role-fields hidden="@(Model.Assignments[i].Role != HotelEventRoleRules.OtherRoleValue)">
        <label asp-for="Assignments[i].OtherRole" class="form-label">Tên vai trò khác <span aria-hidden="true">*</span></label>
        <input asp-for="Assignments[i].OtherRole" class="form-control" maxlength="@(100 - HotelEventRoleRules.OtherRolePrefix.Length)" data-custom-role-name required="@(Model.Assignments[i].Role == HotelEventRoleRules.OtherRoleValue)" disabled="@(Model.Assignments[i].Role != HotelEventRoleRules.OtherRoleValue)" />
        <span asp-validation-for="Assignments[i].OtherRole" class="text-danger"></span>
        <small class="form-text">Vai trò khác là bổ sung, không thay thế vai trò bắt buộc.</small>
    </div>
    </section>
    }
    <details class="event-assignment-options" open="@(!ViewData.ModelState.IsValid)">
        <summary>@(Model.Event.TinhPhuCapKhiNghiemThu ? "Thời gian tham gia chung" : "Thời gian tham gia chung và phụ cấp mỗi người")</summary>
        <div class="mt-3 mb-3">
            <label asp-for="Assignment.Start" class="form-label">Bắt đầu tham gia (UTC+7)</label>
            <input asp-for="Assignment.Start" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" required data-event-start />
            <span asp-validation-for="Assignment.Start" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Assignment.End" class="form-label">Kết thúc tham gia (UTC+7)</label>
            <input asp-for="Assignment.End" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" required data-event-end />
            <span asp-validation-for="Assignment.End" class="text-danger"></span>
        </div>
        @if (!Model.Event.TinhTheoGio && !Model.Event.TinhPhuCapKhiNghiemThu)
        {
            <div class="mb-3">
                <label asp-for="Assignment.Allowance" class="form-label">Phụ cấp dự kiến mỗi người (đ)</label>
                <input asp-for="Assignment.Allowance" type="number" class="form-control" min="0" step="0.01" required />
                <span asp-validation-for="Assignment.Allowance" class="text-danger"></span>
            </div>
        }
    </details>
    <div class="event-form-actions">
        <button class="event-secondary-button" type="button" data-assignment-close>Hủy</button>
        <button class="event-primary-button" type="submit">Lưu phân công</button>
    </div>
</form>
