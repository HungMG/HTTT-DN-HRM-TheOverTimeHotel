@model EventDetailsViewModel
@using OvertimeHotel.HRM.Core.Policies
@using System.Globalization
@{
    var item = Model.Event;
    var start = HotelEventRules.Local(item.NgayBatDau);
    var end = HotelEventRules.Local(item.NgayKetThuc);
    string Money(decimal value) => value.ToString("#,##0.##", CultureInfo.GetCultureInfo("vi-VN")) + " đ";
    var eventRate = Model.HourlyEventRate.ToString("0.00");
    var needDepartments = HotelEventRules.GetAllowedDepartments(item.LoaiDuAn);
    var needDepartment = needDepartments.Contains(Model.Need.Department) ? Model.Need.Department : needDepartments.FirstOrDefault();
}
@if (Model.NeedsLateConfirmationWarning)
{
    <div class="alert alert-warning mb-3 d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4" aria-hidden="true"></i>
        <div>
            @if (item.NgayKetThuc <= DateTimeOffset.UtcNow)
            {
                <strong>Cần đối soát thực hiện:</strong><span> Sự kiện đã quá giờ kết thúc nhưng vẫn đang ở trạng thái Lên kế hoạch. HR/Admin cần kiểm tra thực tế và đối soát hồ sơ.</span>
            }
            else
            {
                <strong>Đang chờ tự bắt đầu:</strong><span> Sự kiện đã đến giờ bắt đầu dự kiến (@start.ToString("dd/MM/yyyy HH:mm")). Kiểm tra số khách, nhân sự và ca nguồn; hệ thống sẽ tự bắt đầu khi đủ điều kiện.</span>
            }
        </div>
    </div>
}
<div class="event-form-grid">
                <div class="event-panel">
                    <span class="event-eyebrow">THÔNG TIN CHUNG</span>
                    <h3>Bức tranh tổng thể</h3>
                    <dl class="event-description-list">
                        <div><dt>Người quản lý</dt><dd>@(item.NguoiQuanLy?.HoTen ?? "Chưa cập nhật")</dd></div>
                        <div><dt>Khách dự kiến</dt><dd>@item.SoKhachDuKien người</dd></div>
                        <div><dt>@(item.TinhTheoGio ? "Thu nhập cộng thêm" : item.TinhPhuCapKhiNghiemThu ? "Ngân sách trả nhân viên" : "Ngân sách phụ cấp")</dt><dd>@(item.TinhTheoGio && item.TrangThai != "HOAN_THANH" ? "Lương cơ bản / 26 / 8 × hệ số " + eventRate + " × giờ thực tế được xác nhận" : item.TinhPhuCapKhiNghiemThu && item.TrangThai != "HOAN_THANH" ? "Tính khi nghiệm thu" : Money(item.NganSachPhuCap))</dd></div>
                        <div><dt>Thời gian</dt><dd>@start.ToString("dd/MM/yyyy HH:mm")<br />@end.ToString("dd/MM/yyyy HH:mm") <small>(UTC+7)</small></dd></div>
                    </dl>
                    <hr />
                    <h4 class="h6">Mô tả &amp; ghi chú</h4>
                    <p class="event-preserve-lines">@(string.IsNullOrWhiteSpace(item.MoTa) ? "Chưa có ghi chú cho sự kiện này." : item.MoTa)</p>
                </div>
                <div class="event-panel">
                    <span class="event-eyebrow">ĐIỀU PHỐI SỰ KIỆN</span>
                    <h3>Theo sát từng chặng</h3>
                    <ol class="event-progress-list">
                        <li class="@(item.TrangThai == "LEN_KE_HOACH" ? "is-current" : "")">Lên kế hoạch <small>Chuẩn bị và phân công đội ngũ</small></li>
                        <li class="@(item.TrangThai == "DANG_DIEN_RA" ? "is-current" : "")">Đang diễn ra <small>Điều phối hoạt động tại sự kiện</small></li>
                        <li class="@(item.TrangThai == "CHO_NGHIEM_THU" ? "is-current" : "")">Chờ nghiệm thu <small>Đánh giá nhân sự, xác nhận phụ cấp</small></li>
                        <li class="@(item.TrangThai == "HOAN_THANH" ? "is-current" : "")">Hoàn thành <small>HR/Admin nghiệm thu và khóa dữ liệu</small></li>
                    </ol>
                    @if (item.TrangThai == "LEN_KE_HOACH")
                    {
                        var summary = Model.StaffingSummary;
                        <p data-event-auto-start>Hệ thống tự bắt đầu sự kiện khi đến giờ và đã đủ thông tin, nhân sự hợp lệ.</p>
                        @if (!summary.IsFullyStaffed)
                        {
                            <div class="alert alert-warning mb-3"><strong>Cần bổ sung nhân sự.</strong> @summary.SummaryText</div>
                        }
                        @if (item.TinhTheoGio)
                        {
                            <p class="form-text">Cần có số khách lớn hơn 0 và đủ vai trò bắt buộc. Phân công phải gắn ca nguồn đã công bố, nhân viên có hợp đồng hiệu lực, không trùng lịch hoặc nghỉ đã duyệt và bảo đảm định biên bộ phận nguồn.</p>
                        }
                        <p class="form-text">Tải lại trang để cập nhật trạng thái mới nhất.</p>
                    }
                    else if (Model.CanManage && item.TrangThai == "DANG_DIEN_RA")
                    {
                        <form asp-action="Status" asp-route-id="@item.MaDuAn" method="post">
                            <partial name="_EventContext" model="Model" />
                            <input name="version" type="hidden" value="@item.Version" />
                            <input name="status" type="hidden" value="CHO_NGHIEM_THU" />
                            <button class="event-primary-button" type="submit">Chuyển chờ nghiệm thu <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                            <p class="form-text">Chuyển chờ nghiệm thu sau khi đến giờ kết thúc dự kiến.</p>
                        </form>
                    }
                </div>
            </div>
            <div class="event-panel mt-4" id="staffing-requirements">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <span class="event-eyebrow">ĐỊNH MỨC &amp; YÊU CẦU NHÂN SỰ</span>
                        <h3 class="mb-0">Yêu cầu phòng ban &amp; vai trò bắt buộc</h3>
                    </div>
                    @if (Model.CanEdit && item.TrangThai == "LEN_KE_HOACH")
                    {
                        <button type="button" class="btn btn-sm btn-outline-primary" data-new-need aria-controls="addCustomNeedForm" aria-expanded="@(Model.Need.NeedId > 0 || !ViewData.ModelState.IsValid ? "true" : "false")">
                            <i class="bi bi-plus-circle me-1"></i> Điều chỉnh / Thêm yêu cầu
                        </button>
                    }
                </div>
                <p class="event-muted mb-3">Định mức nhân sự được sinh tự động theo loại sự kiện và số khách, áp dụng cho toàn sự kiện. HR/Admin được điều chỉnh số lượng hoặc bổ sung vai trò kèm lý do.</p>

                @if (Model.CanEdit && item.TrangThai == "LEN_KE_HOACH")
                {
                    <div class="collapse mb-4 @(Model.Need.NeedId > 0 || !ViewData.ModelState.IsValid ? "show" : "")" id="addCustomNeedForm" data-need-editor>
                        <div class="card card-body bg-light">
                            <h5 class="card-title h6 mb-3">Biểu mẫu điều chỉnh yêu cầu nhân sự</h5>
                            <form asp-action="SaveNeed" asp-route-id="@item.MaDuAn" method="post" data-need-form>
                                <partial name="_EventContext" model="Model" />
                                <input type="hidden" name="Need.Version" value="@item.Version" />
                                <input asp-for="Need.NeedId" type="hidden" />
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label asp-for="Need.Department" class="form-label">Phòng ban <span class="text-danger">*</span></label>
                                        <select asp-for="Need.Department" class="form-select form-select-sm" required>
                                            @foreach (var dept in needDepartments)
                                            {
                                                <option value="@dept">@HotelEventRules.DepartmentLabels.GetValueOrDefault(dept, dept)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="Need.Role" class="form-label">Vai trò <span class="text-danger">*</span></label>
                                        <input asp-for="Need.Role" list="@($"event-need-roles-{item.MaDuAn}-{needDepartment}")" class="form-control form-control-sm" placeholder="Chọn vai trò gợi ý của phòng ban" required maxlength="100" />
                                        @foreach (var dept in needDepartments)
                                        {
                                            <datalist id="@($"event-need-roles-{item.MaDuAn}-{dept}")" data-need-role-department="@dept">
                                                @foreach (var role in HotelEventRoleRules.GetRoles(item.LoaiDuAn, dept, 0))
                                                {
                                                    <option value="@role.Name"></option>
                                                }
                                            </datalist>
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        <label asp-for="Need.Count" class="form-label">Số người cần <span class="text-danger">*</span></label>
                                        <input asp-for="Need.Count" class="form-control form-control-sm" min="0" max="100000" required />
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Need.Reason" class="form-label">Lý do điều chỉnh <span class="text-danger">*</span></label>
                                        <input asp-for="Need.Reason" class="form-control form-control-sm" placeholder="Nhập lý do điều chỉnh hoặc bổ sung vai trò..." required maxlength="500" />
                                    </div>
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu yêu cầu</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                @if (item.NhuCaus.Count == 0)
                {
                    <div class="alert alert-secondary mb-0">Chưa có khai báo định mức yêu cầu nhân sự cho sự kiện này.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Phòng ban</th>
                                    <th>Vai trò bắt buộc</th>
                                    <th class="text-center">Số người cần</th>
                                    <th>Loại yêu cầu</th>
                                    @if (Model.CanEdit && item.TrangThai == "LEN_KE_HOACH")
                                    {
                                        <th class="text-end">Thao tác</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var need in item.NhuCaus.OrderBy(n => n.MaPhongBan).ThenBy(n => n.VaiTro))
                                {
                                    <tr>
                                        <td>
                                            <strong>@HotelEventRules.DepartmentLabels.GetValueOrDefault(need.MaPhongBan, need.MaPhongBan)</strong>
                                        </td>
                                        <td>@need.VaiTro</td>
                                        <td class="text-center">
                                            <span class="badge bg-secondary fs-6">@need.SoNguoi</span>
                                        </td>
                                        <td>
                                            @if (need.LaMau)
                                            {
                                                <span class="badge bg-info text-dark">Theo định mức mẫu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Đã điều chỉnh riêng</span>
                                            }
                                        </td>
                                        @if (Model.CanEdit && item.TrangThai == "LEN_KE_HOACH")
                                        {
                                            <td class="text-end">
                                                <button type="button" class="btn btn-xs btn-outline-secondary me-1" data-edit-need="@need.MaNhuCau"
                                                        data-need-department="@need.MaPhongBan" data-need-role="@need.VaiTro" data-need-count="@need.SoNguoi">
                                                    Sửa
                                                </button>
                                                @if (!need.LaMau)
                                                {
                                                    <form asp-action="DeleteNeed" asp-route-id="@item.MaDuAn" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa yêu cầu này?');">
                                                        <partial name="_EventContext" model="Model" />
                                                        <input type="hidden" name="needId" value="@need.MaNhuCau" />
                                                        <input type="hidden" name="version" value="@item.Version" />
                                                        <input type="hidden" name="reason" value="Xóa yêu cầu điều chỉnh riêng" />
                                                        <button type="submit" class="btn btn-xs btn-outline-danger">Xóa</button>
                                                    </form>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @if (Model.CanManage)
            {
                <details class="event-cancel-panel">
                    <summary>Hủy sự kiện</summary>
                    <p class="event-muted">Lịch địa điểm và nhân sự sẽ được giải phóng. Vui lòng ghi rõ lý do.</p>
                    <form asp-action="Status" asp-route-id="@item.MaDuAn" method="post">
                        <partial name="_EventContext" model="Model" />
                        <input name="version" type="hidden" value="@item.Version" />
                        <input name="status" type="hidden" value="HUY" />
                        <label for="cancellationReason" class="form-label">Lý do hủy <span aria-hidden="true">*</span></label>
                        <textarea id="cancellationReason" name="reason" class="form-control mb-3" rows="2" required maxlength="500">@ViewData.ModelState["reason"]?.AttemptedValue</textarea>
                        <span class="text-danger">@Html.ValidationMessage("reason")</span>
                        <button type="submit" class="btn btn-outline-danger">Xác nhận hủy sự kiện</button>
                    </form>
                </details>
            }


@if (item.TinhTheoGio && item.KetThucThucTe.HasValue)
{
    <div class="event-panel mt-3"><h3>Thời gian kết thúc thực tế</h3><p>@HotelEventRules.Local(item.KetThucThucTe.Value).ToString("dd/MM/yyyy HH:mm") (UTC+7)</p><p class="event-preserve-lines">@item.LyDoDung</p></div>
}
@if (item.TinhTheoGio && Model.CanManage && item.TrangThai == "DANG_DIEN_RA")
{
    <details class="event-panel mt-3"><summary>Dừng sự kiện và giữ công đã làm</summary>
        <p>Nhân sự được giải phóng sau giờ dừng. Công đã xác nhận được giữ lại để nghiệm thu.</p>
        <form asp-action="Stop" asp-route-id="@item.MaDuAn" method="post">
            <partial name="_EventContext" model="Model" /><input name="version" value="@item.Version" type="hidden" />
            <label for="event-stop-end" class="form-label">Giờ dừng thực tế (UTC+7)</label><input id="event-stop-end" name="end" type="datetime-local" class="form-control mb-3" required />
            <label for="event-stop-reason" class="form-label">Lý do dừng</label><textarea id="event-stop-reason" name="reason" maxlength="500" class="form-control mb-3" required></textarea>
            <button type="submit" class="btn btn-outline-danger">Dừng và chuyển chờ nghiệm thu</button>
        </form>
    </details>
}
