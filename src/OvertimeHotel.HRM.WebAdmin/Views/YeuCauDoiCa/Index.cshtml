@model OvertimeHotel.HRM.WebAdmin.Models.YeuCauDoiCaIndexViewModel
@{
    ViewData["Title"] = "Yêu Cầu Đổi Ca";
}

<div class="container-fluid px-3 px-md-4 py-3">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="h4 mb-1 fw-bold text-dark font-serif hotel-blur-text">Yêu cầu đổi ca</h1>
            <p class="text-muted mb-0" style="font-size: 0.85rem;">
                Duyệt xong là lịch phân ca của hai nhân viên hoán đổi ngay — hệ thống chỉ cho duyệt khi
                cả hai người vẫn đủ khoảng nghỉ 8 giờ và không chồng ca.
            </p>
        </div>
        <a asp-action="Create" class="btn btn-hotel-primary rounded-pill px-4 py-2 fw-bold shadow-sm hover-lift"
           style="font-size: 0.85rem;">
            <i class="bi bi-plus-circle-fill me-1"></i> Tạo yêu cầu đổi ca
        </a>
    </div>

    <partial name="_CatalogAlerts" />

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100 kpi-card-item" style="border-top: 3px solid #b45309 !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Chờ duyệt</span>
                <h3 class="h3 mb-0 fw-bold text-warning-emphasis font-serif kpi-count-up" data-target="@Model.ChoDuyet">@Model.ChoDuyet</h3>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100 kpi-card-item" style="border-top: 3px solid #059669 !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Đã duyệt</span>
                <h3 class="h3 mb-0 fw-bold text-success font-serif kpi-count-up" data-target="@Model.DaDuyet">@Model.DaDuyet</h3>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100 kpi-card-item" style="border-top: 3px solid #dc2626 !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Từ chối</span>
                <h3 class="h3 mb-0 fw-bold text-danger font-serif kpi-count-up" data-target="@Model.TuChoi">@Model.TuChoi</h3>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100 kpi-card-item" style="border-top: 3px solid #1e3a8a !important;">
                <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Tổng yêu cầu</span>
                <h3 class="h3 mb-0 fw-bold text-dark font-serif kpi-count-up" data-target="@Model.TongYeuCau">@Model.TongYeuCau</h3>
            </div>
        </div>
    </div>

    <form class="card border-0 shadow-sm rounded-4 mb-3" id="requestFilterForm" data-request-filter>
        @* Thẻ ẩn này vừa là nguồn token cho các lệnh fetch bên dưới, vừa để
           form lọc có token sẵn nếu trình duyệt gửi submit thường. *@
        @Html.AntiForgeryToken()
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1" for="filterStatus">Trạng thái</label>
                    <select class="form-select form-select-sm rounded-3" id="filterStatus" name="trangThai">
                        @foreach (var option in Model.TrangThaiOptions)
                        {
                            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold text-muted mb-1" for="filterKeyword">Tìm kiếm</label>
                    <input type="search" class="form-control form-control-sm rounded-3" id="filterKeyword"
                           name="keyword" value="@Model.Keyword" placeholder="Tên nhân viên hoặc lý do đổi ca…" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-hotel-primary rounded-pill px-3 fw-semibold flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold"
                            data-request-reset>
                        Xoá lọc
                    </button>
                </div>
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div id="yeuCauDoiCaTable" data-request-table>
            <partial name="_YeuCauDoiCaTable" model="Model" />
        </div>
    </div>
</div>

<!-- HỘP THOẠI XÁC NHẬN DUYỆT / TỪ CHỐI -->
<div class="modal fade" id="requestActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold font-serif" id="requestActionTitle">Xác nhận</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3" id="requestActionHint"></p>
                <label class="form-label small fw-semibold text-muted mb-1" for="requestActionNote">Ý kiến xử lý</label>
                <textarea class="form-control rounded-3" id="requestActionNote" rows="3" maxlength="500"
                          placeholder="Ghi chú gửi tới nhân viên…"></textarea>
                <div class="text-danger small mt-2 d-none" id="requestActionError"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Huỷ</button>
                <button type="button" class="btn rounded-pill px-4 fw-bold" id="requestActionConfirm">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tableHost = document.querySelector('[data-request-table]');
            const filterForm = document.querySelector('[data-request-filter]');
            const modalEl = document.getElementById('requestActionModal');
            const modal = modalEl ? new bootstrap.Modal(modalEl) : null;
            const noteEl = document.getElementById('requestActionNote');
            const errorEl = document.getElementById('requestActionError');
            const confirmBtn = document.getElementById('requestActionConfirm');
            let pending = null;

            function buildParams(page) {
                const params = new URLSearchParams();
                const status = document.getElementById('filterStatus')?.value;
                const keyword = document.getElementById('filterKeyword')?.value?.trim();
                if (status) { params.set('trangThai', status); }
                if (keyword) { params.set('keyword', keyword); }
                if (page && page > 1) { params.set('page', page); }
                return params;
            }

            // Nạp lại đúng khung bảng, giữ nguyên header, bộ lọc và vị trí cuộn.
            async function reload(page) {
                const params = buildParams(page);
                const url = '/YeuCauDoiCa/Index?' + params.toString();
                const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!response.ok) { return; }
                tableHost.innerHTML = await response.text();
                history.pushState(null, '', params.toString() ? url : '/YeuCauDoiCa');
            }

            filterForm?.addEventListener('submit', function (event) {
                event.preventDefault();
                reload(1);
            });

            document.querySelector('[data-request-reset]')?.addEventListener('click', function () {
                const status = document.getElementById('filterStatus');
                const keyword = document.getElementById('filterKeyword');
                if (status) { status.value = ''; }
                if (keyword) { keyword.value = ''; }
                reload(1);
            });

            tableHost?.addEventListener('click', function (event) {
                const pageLink = event.target.closest('[data-request-page]');
                if (pageLink) {
                    event.preventDefault();
                    reload(parseInt(pageLink.dataset.requestPage, 10) || 1);
                    return;
                }

                const approve = event.target.closest('[data-request-approve]');
                if (approve) {
                    openDialog(approve.dataset.requestApprove, true, approve.dataset.requestLabel);
                    return;
                }

                const reject = event.target.closest('[data-request-reject]');
                if (reject) {
                    openDialog(reject.dataset.requestReject, false, reject.dataset.requestLabel);
                }
            });

            function openDialog(id, isApprove, label) {
                pending = { id: id, approve: isApprove };
                document.getElementById('requestActionTitle').textContent =
                    (isApprove ? 'Duyệt yêu cầu ' : 'Từ chối yêu cầu ') + label;
                document.getElementById('requestActionHint').textContent = isApprove
                    ? 'Hai ca sẽ hoán đổi người trực ngay sau khi duyệt và không hoàn tác được.'
                    : 'Nhân viên sẽ thấy lý do từ chối trong ứng dụng.';
                confirmBtn.className = 'btn rounded-pill px-4 fw-bold ' + (isApprove ? 'btn-success' : 'btn-danger');
                confirmBtn.textContent = isApprove ? 'Duyệt' : 'Từ chối';
                noteEl.value = '';
                noteEl.required = !isApprove;
                errorEl.classList.add('d-none');
                modal?.show();
            }

            confirmBtn?.addEventListener('click', async function () {
                if (!pending) { return; }

                const body = new URLSearchParams();
                body.set('id', pending.id);
                if (pending.approve) {
                    body.set('phanHoi', noteEl.value.trim());
                } else {
                    body.set('lyDo', noteEl.value.trim());
                }

                confirmBtn.disabled = true;
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const response = await fetch('/YeuCauDoiCa/' + (pending.approve ? 'Approve' : 'Reject'), {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token,
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: body.toString()
                    });

                    const result = await response.json().catch(() => ({ success: false, message: 'Máy chủ trả về dữ liệu không đọc được.' }));

                    if (!response.ok || !result.success) {
                        errorEl.textContent = result.message || 'Không xử lý được yêu cầu.';
                        errorEl.classList.remove('d-none');
                        return;
                    }

                    modal?.hide();
                    reload(1);
                } catch (e) {
                    errorEl.textContent = 'Không kết nối được máy chủ: ' + e.message;
                    errorEl.classList.remove('d-none');
                } finally {
                    confirmBtn.disabled = false;
                }
            });
        })();
    </script>
}
