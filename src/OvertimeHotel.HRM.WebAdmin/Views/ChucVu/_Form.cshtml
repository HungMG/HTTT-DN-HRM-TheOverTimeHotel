@model OvertimeHotel.HRM.Core.Models.ChucVu
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="form-floating mb-3">
    <input asp-for="TenChucVu" class="form-control" placeholder="Tên chức vụ" maxlength="100" />
    <label asp-for="TenChucVu">Tên chức vụ <span class="text-danger">*</span></label>
    <span asp-validation-for="TenChucVu" class="text-danger small"></span>
</div>
<div class="form-floating mb-4">
    <textarea asp-for="MoTa" class="form-control" placeholder="Mô tả" maxlength="255" style="height:120px"></textarea>
    <label asp-for="MoTa">Mô tả nhiệm vụ</label>
    <span asp-validation-for="MoTa" class="text-danger small"></span>
</div>
<div class="d-flex justify-content-end gap-2">
    <a asp-action="Index" class="btn btn-light border rounded-3 px-4"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    <button class="btn btn-hotel-primary px-4"><i class="bi bi-check2-circle me-1"></i> Lưu thông tin</button>
</div>