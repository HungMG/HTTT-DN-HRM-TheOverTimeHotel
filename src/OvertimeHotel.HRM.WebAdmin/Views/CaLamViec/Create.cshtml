@model OvertimeHotel.HRM.Core.Models.CaLamViec
@{ ViewData["Title"] = "Thêm ca làm việc"; }
<div class="catalog-page">
    <section class="catalog-hero mb-4"><div class="catalog-eyebrow">Danh mục hệ thống</div><h1 class="catalog-title h2 mb-1">Thêm ca làm việc</h1><p class="text-white-50 mb-0">Thiết lập khung giờ mới cho hoạt động 24/7.</p></section>
    <form asp-action="Create" method="post" class="catalog-card catalog-form-card">
        <div class="d-flex align-items-center gap-3 mb-4"><span class="catalog-icon"><i class="bi bi-clock-history"></i></span><div><h2 class="h5 fw-bold mb-1">Thông tin ca làm việc</h2><small class="text-muted">Đánh dấu chính xác các ca đi qua ngày mới.</small></div></div>
        <partial name="_Form" model="Model" />
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }