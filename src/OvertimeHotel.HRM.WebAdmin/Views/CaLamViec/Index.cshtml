@model IReadOnlyList<OvertimeHotel.HRM.Core.Models.CaLamViec>
@{
    ViewData["Title"] = "Quản lý ca làm việc 24/7 · The OverTime Hotel";
}

<div class="catalog-page">
    <!-- HERO COMMAND BANNER -->
    <section class="catalog-hero catalog-command-bar mb-4 position-relative">
        <div class="catalog-art-deco-pattern" aria-hidden="true"></div>
        <div class="position-relative" style="z-index: 2;">
            <nav aria-label="Điều hướng">
                <ol class="catalog-breadcrumb catalog-breadcrumb--dark">
                    <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Dashboard</a></li>
                    <li><a asp-controller="SystemCatalog" asp-action="Index">Danh mục hệ thống</a></li>
                    <li aria-current="page">Ca làm việc</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark fw-bold px-2 py-1 rounded-pill" style="font-size: 0.65rem;">
                    <i class="bi bi-stars"></i> THE OVERTIME HOTEL
                </span>
                <span class="catalog-eyebrow mb-0"><i class="bi bi-clock-history me-1"></i> Vận hành 24/7</span>
            </div>
            <h1 class="catalog-title h2 mb-1 text-white">Quản lý Ca Làm Việc 24/7</h1>
            <p class="text-white-50 mb-0">Thiết lập các khung giờ trực ca Sáng, Chiều, Đêm đảm bảo dịch vụ khách sạn liên tục.</p>
        </div>
        <div class="catalog-command-actions position-relative" style="z-index: 2;">
            <button type="button" class="btn btn-light fw-bold rounded-3 px-3 position-relative shadow-sm hover-lift" data-bs-toggle="modal" data-bs-target="#createCaLamViecModal">
                <i class="bi bi-plus-lg me-1 text-primary"></i> Thêm ca làm việc
            </button>
        </div>
    </section>

    <!-- 4 TABS LIÊN THÔNG DANH MỤC -->
    <partial name="_CatalogNavTabs" />

    <partial name="_CatalogAlerts" />

    <!-- PRINT ONLY HEADER (A4) -->
    <div class="catalog-print-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 style="font-size: 16pt; font-weight: 800; margin: 0; color: #0f172a;">THE OVERTIME HOTEL</h2>
                <small style="color: #64748b; text-transform: uppercase; letter-spacing: 1px;">Hệ Thống Quản Trị Nhân Sự &amp; Tiền Lương 24/7</small>
            </div>
            <div style="text-align: right;">
                <h3 style="font-size: 13pt; font-weight: 700; margin: 0; color: #1e3a8a;">BẢNG DANH MỤC CA LÀM VIỆC 24/7</h3>
                <small style="color: #64748b;">Thời điểm xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
        </div>
    </div>

    <!-- TABLE WORKSPACE CARD -->
    <section class="catalog-card shadow-sm">
        <div class="catalog-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
            <form method="get" class="catalog-filter-form d-flex gap-2 flex-grow-1">
                <div class="catalog-search-wrapper flex-grow-1">
                    <i class="bi bi-search catalog-search-icon" aria-hidden="true"></i>
                    <input name="keyword" value="@ViewBag.Keyword" class="form-control catalog-search" placeholder="Tìm theo tên ca làm việc..." aria-label="Tìm kiếm ca làm việc" />
                    <kbd class="catalog-search-shortcut" title="Phím tắt tìm kiếm">Ctrl K</kbd>
                </div>
                <button type="button" class="btn btn-outline-danger rounded-3 px-3 text-nowrap @(string.IsNullOrWhiteSpace(ViewBag.Keyword as string) ? "d-none" : "")" data-catalog-reset title="Xóa nhanh từ khóa" aria-label="Xóa từ khóa">
                    <i class="bi bi-x-lg me-1"></i>Xóa
                </button>
            </form>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-export="CaLamViec" title="Xuất danh sách ca ra file CSV" aria-label="Xuất CSV">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Xuất CSV
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-print title="In danh sách ca làm việc chuẩn A4" aria-label="In danh mục">
                    <i class="bi bi-printer text-primary me-1"></i> In danh mục
                </button>
                <span class="catalog-badge" data-catalog-count title="Số lượng ca làm việc">
                    <i class="bi bi-clock me-1"></i>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.Keyword as string))
                    {
                        <span>@Model.Count / @ViewBag.Total</span> <span class="d-none d-sm-inline">ca vận hành</span>
                    }
                    else
                    {
                        <span>@ViewBag.Total</span> <span class="d-none d-sm-inline">ca vận hành</span>
                    }
                </span>
            </div>
        </div>

        <div class="catalog-loading" data-catalog-loading>
            <span class="spinner-border spinner-border-sm text-primary"></span>
            <strong>Đang cập nhật danh mục ca trực...</strong>
        </div>

        <div class="table-responsive" data-catalog-results>
            <table class="table catalog-table" data-export-table="Danh_Sach_Ca_Lam_Viec">
                <thead>
                    <tr>
                        <th style="width: 80px" class="text-center">Mã</th>
                        <th>Tên ca làm việc</th>
                        <th style="width: 130px">Giờ bắt đầu</th>
                        <th style="width: 130px">Giờ kết thúc</th>
                        <th style="width: 140px">Thời lượng</th>
                        <th>Đặc điểm & Phụ cấp</th>
                        <th class="text-end" style="width: 140px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="catalog-empty">
                            <div class="catalog-empty-state">
                                <div class="catalog-empty-icon"><i class="bi bi-clock-slash"></i></div>
                                <h4>Không tìm thấy ca làm việc</h4>
                                <p class="text-muted">Không có khung giờ trực ca nào khớp với từ khóa tìm kiếm.</p>
                                <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-catalog-reset>
                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại bộ lọc
                                    </button>
                                    <button type="button" class="btn btn-hotel-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#createCaLamViecModal">
                                        <i class="bi bi-plus-lg me-1"></i> Thêm ca làm việc mới
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var isNight = item.QuaDem || item.TenCa.Contains("Đêm", StringComparison.OrdinalIgnoreCase);
                        var isAfternoon = item.TenCa.Contains("Chiều", StringComparison.OrdinalIgnoreCase);
                        var shiftIcon = isNight ? "bi-moon-stars-fill" : isAfternoon ? "bi-sunset-fill" : "bi-sunrise-fill";
                        var shiftClass = isNight ? "catalog-icon--night" : isAfternoon ? "catalog-icon--afternoon" : "catalog-icon--morning";

                        // Tính thời lượng ca
                        double durationHours;
                        if (item.QuaDem || item.GioKetThuc < item.GioBatDau)
                        {
                            durationHours = (24 - item.GioBatDau.Hour - item.GioBatDau.Minute / 60.0) + (item.GioKetThuc.Hour + item.GioKetThuc.Minute / 60.0);
                        }
                        else
                        {
                            durationHours = (item.GioKetThuc.Hour + item.GioKetThuc.Minute / 60.0) - (item.GioBatDau.Hour + item.GioBatDau.Minute / 60.0);
                        }

                        var scheduleCount = item.PhanCas?.Count ?? 0;

                        <tr>
                            <td class="text-center text-muted fw-semibold">#@item.MaCa</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <span class="catalog-icon @shiftClass shadow-sm">
                                        <i class="bi @shiftIcon"></i>
                                    </span>
                                    <div>
                                        <strong class="d-block text-dark fs-6 font-serif">@item.TenCa</strong>
                                        <small class="text-muted">
                                            @(isNight ? "Trực ban đêm (Chống buồn ngủ, bảo vệ an ninh)" : isAfternoon ? "Ca chiều - phục vụ bữa tối & check-in" : "Ca sáng - phục vụ ăn sáng & check-out")
                                        </small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 text-primary fw-bold">
                                    <i class="bi bi-play-circle-fill text-success"></i>
                                    <span>@item.GioBatDau.ToString("HH:mm")</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 text-danger fw-bold">
                                    <i class="bi bi-stop-circle-fill text-danger"></i>
                                    <span>@item.GioKetThuc.ToString("HH:mm")</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle fw-semibold px-2 py-1">
                                    <i class="bi bi-hourglass-split me-1"></i>@durationHours.ToString("0.#") giờ
                                </span>
                            </td>
                            <td>
                                @if (item.QuaDem)
                                {
                                    <span class="badge bg-dark text-warning border border-warning px-2 py-1 shadow-sm">
                                        <i class="bi bi-moon-stars-fill me-1 text-warning"></i>Qua đêm · +30% Phụ cấp
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="bi bi-sun-fill me-1 text-warning"></i>Trong ngày (Tiêu chuẩn)
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.MaCa" class="btn btn-sm btn-outline-primary rounded-3 me-1" title="Chỉnh sửa ca" data-catalog-modal data-catalog-modal-title="Chỉnh sửa ca làm việc">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                @if (scheduleCount > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 opacity-50" disabled title="Không thể xóa: ca này đã có @scheduleCount lượt phân ca lịch trực 24/7.">
                                        <i class="bi bi-lock-fill"></i>
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="Delete" asp-route-id="@item.MaCa" method="post" class="d-inline catalog-delete-form" data-catalog-name="@item.TenCa">
                                        <button class="btn btn-sm btn-outline-danger rounded-3" title="Xóa ca"><i class="bi bi-trash3"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<!-- MODAL THÊM CA LÀM VIỆC MỚI -->
<div class="modal fade" id="createCaLamViecModal" tabindex="-1" aria-labelledby="createCaLamViecModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="catalog-icon shadow-sm"><i class="bi bi-clock-history"></i></span>
                    <div>
                        <div class="text-uppercase small text-primary fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Vận hành trực ca 24/7</div>
                        <h2 class="modal-title h5 mb-0 font-serif" id="createCaLamViecModalLabel">Thêm Ca Làm Việc Mới</h2>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="form-floating mb-3">
                        <input name="TenCa" class="form-control" placeholder="Tên ca" maxlength="50" required />
                        <label>Tên ca làm việc <span class="text-danger">*</span></label>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="form-floating">
                                <input name="GioBatDau" type="time" class="form-control" value="06:00" required />
                                <label>Giờ bắt đầu <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating">
                                <input name="GioKetThuc" type="time" class="form-control" value="14:00" required />
                                <label>Giờ kết thúc <span class="text-danger">*</span></label>
                            </div>
                        </div>
                    </div>
                    <div class="form-check form-switch bg-light border rounded-3 p-3 ps-5 mb-2">
                        <input name="QuaDem" value="true" class="form-check-input" type="checkbox" id="modalQuaDemSwitch" />
                        <label class="form-check-label fw-semibold" for="modalQuaDemSwitch">Ca làm việc qua đêm (Crosses Midnight)</label>
                        <div class="small text-muted">Kích hoạt nếu ca làm kết thúc vào sáng hôm sau (tự động tính phụ cấp ca đêm 30%).</div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-hotel-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i>Lưu thông tin
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>