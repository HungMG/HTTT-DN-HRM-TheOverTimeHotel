@model OvertimeHotel.HRM.Core.Models.CaLamViec
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="form-floating mb-3">
    <input asp-for="TenCa" class="form-control" placeholder="Tên ca" maxlength="50" />
    <label asp-for="TenCa">Tên ca <span class="text-danger">*</span></label>
    <span asp-validation-for="TenCa" class="text-danger small"></span>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-6"><div class="form-floating"><input asp-for="GioBatDau" type="time" class="form-control" /><label asp-for="GioBatDau">Giờ bắt đầu</label></div><span asp-validation-for="GioBatDau" class="text-danger small"></span></div>
    <div class="col-md-6"><div class="form-floating"><input asp-for="GioKetThuc" type="time" class="form-control" /><label asp-for="GioKetThuc">Giờ kết thúc</label></div><span asp-validation-for="GioKetThuc" class="text-danger small"></span></div>
</div>
<div class="form-check form-switch bg-light border rounded-3 p-3 ps-5 mb-4">
    <input asp-for="QuaDem" class="form-check-input" />
    <label asp-for="QuaDem" class="form-check-label fw-semibold">Ca làm việc qua đêm</label>
    <div class="small text-muted">Bật nếu giờ kết thúc thuộc ngày kế tiếp (ví dụ: 22:00–06:00).</div>
    <span asp-validation-for="QuaDem" class="text-danger small"></span>
</div>
<div class="d-flex justify-content-end gap-2">
    <a asp-action="Index" class="btn btn-light border rounded-3 px-4"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    <button class="btn btn-hotel-primary px-4"><i class="bi bi-check2-circle me-1"></i> Lưu thông tin</button>
</div>