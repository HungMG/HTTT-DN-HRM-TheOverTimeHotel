@model OvertimeHotel.HRM.WebAdmin.Models.AttendanceLocationViewModel
@{
    ViewData["Title"] = "Cấu Hình Vị Trí Chấm Công (Geofence 5★)";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill bg-dark text-warning px-3 py-1.5 fw-semibold" style="letter-spacing: .5px;">
                    <i class="bi bi-shield-lock-fill text-warning me-1"></i>ĐẶC QUYỀN CNTT (IT EXCLUSIVE)
                </span>
                <span class="badge rounded-pill bg-primary text-white px-2.5 py-1">
                    <i class="bi bi-geo-alt-fill me-1"></i>PRD 4.1 Geofence Engine
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-0 font-serif" style="font-size: var(--page-title-size);">
                Định Vị Doanh Nghiệp &amp; Bán Kính Chấm Công
            </h2>
            <p class="text-muted small mb-0">
                Thiết lập toạ độ GPS mặt bằng khách sạn, bán kính quét và tên Wi-Fi nội bộ cho ứng dụng di động (.NET MAUI)
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold shadow-xs" id="btnGetCurrentGps">
                <i class="bi bi-crosshair me-1.5 text-danger"></i>Lấy toạ độ GPS hiện tại
            </button>
            <a href="https://www.google.com/maps/search/?api=1&query=@Model.HotelLatitude,@Model.HotelLongitude"
               target="_blank" rel="noopener noreferrer"
               id="btnViewGoogleMaps"
               class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold shadow-xs">
                <i class="bi bi-map me-1.5 text-primary"></i>Kiểm tra trên Google Maps
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                <div>
                    <h6 class="fw-bold mb-0">Thành công!</h6>
                    <span class="small">@TempData["Success"]</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Index" method="post" id="geofenceConfigForm" class="needs-validation">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Cột trái: Form nhập liệu chính -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="fw-bold text-dark fs-6">
                                <i class="bi bi-sliders text-primary me-2"></i>Thông số cơ sở &amp; Định vị
                            </span>
                            <span class="badge bg-light text-muted border">
                                Lớp 1: GPS · Lớp 2: Wi-Fi
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

                        <!-- 1. Tên cơ sở & Địa chỉ -->
                        <div class="mb-3">
                            <label asp-for="HotelName" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-building"></i></span>
                                <input asp-for="HotelName" class="form-control border-start-0" placeholder="The OverTime Hotel &amp; Resort" />
                            </div>
                            <span asp-validation-for="HotelName" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-geo"></i></span>
                                <input asp-for="Address" class="form-control border-start-0" placeholder="123 Đường Lê Lợi, Phường Bến Nghé, Quận 1, TP.HCM" />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted opacity-25 my-4" />

                        <!-- 2. Toạ độ GPS -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="HotelLatitude" class="form-label fw-semibold text-dark small">
                                    Vĩ độ (Latitude) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-compass"></i></span>
                                    <input asp-for="HotelLatitude" id="inputLatitude" type="number" step="any" class="form-control border-start-0 tabular-nums" placeholder="10.778848" />
                                </div>
                                <span asp-validation-for="HotelLatitude" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="HotelLongitude" class="form-label fw-semibold text-dark small">
                                    Kinh độ (Longitude) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-compass"></i></span>
                                    <input asp-for="HotelLongitude" id="inputLongitude" type="number" step="any" class="form-control border-start-0 tabular-nums" placeholder="106.687421" />
                                </div>
                                <span asp-validation-for="HotelLongitude" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 3. Bán kính quét (Radius) & Wi-Fi SSID -->
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="RadiusMeters" class="form-label fw-semibold text-dark small">
                                    Bán kính cho phép (Mét) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-broadcast-pin"></i></span>
                                    <input asp-for="RadiusMeters" id="inputRadius" type="number" min="20" max="5000" step="10" class="form-control border-start-0 tabular-nums" placeholder="250" />
                                    <span class="input-group-text bg-light">mét</span>
                                </div>
                                <span asp-validation-for="RadiusMeters" class="text-danger small"></span>
                                <div class="form-text small">Khuyến nghị từ 100m - 300m bao phủ trọn khuôn viên khách sạn.</div>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="WifiSsid" class="form-label fw-semibold text-dark small">
                                    Wi-Fi nội bộ khách sạn (SSID)
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-wifi"></i></span>
                                    <input asp-for="WifiSsid" class="form-control border-start-0" placeholder="OverTimeHotel_Staff" />
                                </div>
                                <span asp-validation-for="WifiSsid" class="text-danger small"></span>
                                <div class="form-text small">Lớp xác thực dự phòng khi nhân viên ở tầng hầm/khu vực khuất GPS.</div>
                            </div>
                        </div>

                        <!-- Submit button -->
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                            <div class="text-muted small">
                                <i class="bi bi-info-circle me-1"></i>Cấu hình có hiệu lực tức thời đối với mọi lượt chấm công.
                            </div>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i>Lưu Cấu Hình Vị Trí
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Thông tin an ninh & Trực quan hoá Geofence -->
            <div class="col-lg-5">
                <div class="d-flex flex-column gap-4 h-100">
                    <!-- Card 1: Nguyên tắc An ninh Phân quyền -->
                    <div class="card border-0 shadow-sm rounded-4 bg-gradient text-white" style="background: linear-gradient(135deg, #0b1325 0%, #1e3a8a 100%); border-left: 4px solid var(--hotel-gold) !important;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; background: rgba(212, 175, 55, 0.2); color: #fde047;">
                                    <i class="bi bi-shield-shaded fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0 text-white">Chính Sách Tách Bạch An Ninh</h6>
                                    <span class="text-white-50 small">Zero Trust Geofencing Architecture</span>
                                </div>
                            </div>
                            <p class="small text-white-50 mb-3">
                                Khách sạn The OverTime Hotel áp dụng cơ chế phân quyền bảo mật nghiêm ngặt theo chuẩn PRD 4.1:
                            </p>
                            <ul class="small text-white-50 ps-3 mb-3">
                                <li class="mb-1.5"><strong class="text-warning">Chỉ Bộ phận CNTT (IT):</strong> Nắm toàn quyền cấu hình, điều chỉnh toạ độ GPS và tên Wi-Fi nội bộ.</li>
                                <li class="mb-1.5"><strong class="text-light">Quản trị viên (Admin) &amp; Quản lý:</strong> Bị chặn quyền can thiệp vào vị trí định vị để tránh tình trạng chỉnh toạ độ khống hoặc gian lận chấm công.</li>
                                <li><strong class="text-light">Mobile App:</strong> Tự động xác thực toạ độ thiết bị bằng thuật toán khoảng cách mặt cầu Haversine so với tâm điểm này.</li>
                            </ul>
                            <div class="border-top border-white border-opacity-10 pt-2 text-white-50 small">
                                Lần cập nhật gần nhất: <span class="text-warning fw-semibold">@(Model.LastUpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Mặc định hệ thống")</span>
                                @if (!string.IsNullOrEmpty(Model.LastUpdatedBy))
                                {
                                    <span>bởi <strong class="text-white">@Model.LastUpdatedBy</strong></span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Hộp công cụ kiểm tra toạ độ nhanh -->
                    <div class="card border-0 shadow-sm rounded-4 flex-grow-1">
                        <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                            <span class="fw-bold text-dark fs-6">
                                <i class="bi bi-calculator text-primary me-2"></i>Máy Tính Thử Khoảng Cách Haversine
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <p class="small text-muted mb-3">
                                Nhập toạ độ nhân viên giả định để kiểm tra xem hệ thống sẽ <strong>Cho phép</strong> hay <strong>Chặn</strong>:
                            </p>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Vĩ độ kiểm thử</label>
                                    <input type="number" id="testLat" step="any" class="form-control form-control-sm tabular-nums" placeholder="10.779000" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted mb-1">Kinh độ kiểm thử</label>
                                    <input type="number" id="testLng" step="any" class="form-control form-control-sm tabular-nums" placeholder="106.687500" />
                                </div>
                            </div>
                            <div class="d-grid mb-3">
                                <button type="button" class="btn btn-sm btn-dark rounded-pill fw-semibold" id="btnTestDistance">
                                    <i class="bi bi-play-fill me-1"></i>Tính toán khoảng cách
                                </button>
                            </div>
                            <div id="testResultBox" class="p-3 rounded-3 bg-light border d-none">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="small text-muted">Khoảng cách tới tâm:</span>
                                    <strong id="resultDistance" class="tabular-nums">0 m</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small text-muted">Kết luận:</span>
                                    <span id="resultBadge" class="badge"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- Luxury Floating Toast Notification (Thay thế hoàn toàn alert thô) -->
    <div id="hotelGpsToastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1090; pointer-events: none;">
        <div id="hotelGpsToast" class="toast align-items-center border-0 shadow-lg rounded-4 overflow-hidden" role="alert" aria-live="assertive" aria-atomic="true" style="display: none; min-width: 360px; max-width: 440px; pointer-events: auto; background: #0f172a; color: #fff; border: 1.5px solid rgba(212, 175, 55, 0.7) !important; box-shadow: 0 16px 36px rgba(15, 23, 42, 0.35) !important; transition: opacity 0.25s ease;">
            <div class="d-flex align-items-center p-3">
                <div id="toastIconBox" class="me-3 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; background: rgba(212, 175, 55, 0.2); color: #fde047;">
                    <i id="toastIcon" class="bi bi-geo-alt-fill fs-5"></i>
                </div>
                <div class="flex-grow-1">
                    <h6 id="toastTitle" class="mb-0 fw-bold text-white fs-6">Đã lấy toạ độ GPS</h6>
                    <div id="toastMessage" class="small text-white-50 mt-1" style="line-height: 1.4;">Thông tin toạ độ</div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-2 flex-shrink-0" onclick="hideLuxuryToast()"></button>
            </div>
            <div id="toastProgressBar" style="height: 3px; background: linear-gradient(90deg, #d4af37, #fde047); width: 100%; transition: width 4s linear;"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var toastTimer = null;
        function showLuxuryToast(title, message, type = 'success') {
            var container = document.getElementById('hotelGpsToast');
            var titleEl = document.getElementById('toastTitle');
            var msgEl = document.getElementById('toastMessage');
            var iconBox = document.getElementById('toastIconBox');
            var icon = document.getElementById('toastIcon');
            var prog = document.getElementById('toastProgressBar');
            if (!container) return;

            clearTimeout(toastTimer);

            titleEl.textContent = title;
            msgEl.innerHTML = message;

            if (type === 'success') {
                iconBox.style.background = 'rgba(16, 185, 129, 0.2)';
                iconBox.style.color = '#10b981';
                icon.className = 'bi bi-check-circle-fill fs-5';
                prog.style.background = 'linear-gradient(90deg, #10b981, #34d399)';
            } else if (type === 'error') {
                iconBox.style.background = 'rgba(239, 68, 68, 0.2)';
                iconBox.style.color = '#ef4444';
                icon.className = 'bi bi-exclamation-triangle-fill fs-5';
                prog.style.background = 'linear-gradient(90deg, #ef4444, #f87171)';
            } else {
                iconBox.style.background = 'rgba(212, 175, 55, 0.2)';
                iconBox.style.color = '#fde047';
                icon.className = 'bi bi-geo-alt-fill fs-5';
                prog.style.background = 'linear-gradient(90deg, #d4af37, #fde047)';
            }

            container.style.display = 'block';
            container.style.opacity = '1';
            prog.style.width = '100%';

            setTimeout(function () {
                prog.style.width = '0%';
            }, 50);

            toastTimer = setTimeout(function () {
                hideLuxuryToast();
            }, 4200);
        }

        function hideLuxuryToast() {
            var container = document.getElementById('hotelGpsToast');
            if (container) {
                container.style.opacity = '0';
                setTimeout(function () {
                    container.style.display = 'none';
                }, 250);
            }
        }

        // Cập nhật link Google Maps khi toạ độ thay đổi
        function updateGoogleMapsLink() {
            var lat = document.getElementById('inputLatitude').value;
            var lng = document.getElementById('inputLongitude').value;
            var link = document.getElementById('btnViewGoogleMaps');
            if (lat && lng && link) {
                link.href = 'https://www.google.com/maps/search/?api=1&query=' + lat + ',' + lng;
            }
        }

        document.getElementById('inputLatitude')?.addEventListener('input', updateGoogleMapsLink);
        document.getElementById('inputLongitude')?.addEventListener('input', updateGoogleMapsLink);

        // Lấy toạ độ GPS hiện tại qua trình duyệt HTML5 Geolocation API
        document.getElementById('btnGetCurrentGps')?.addEventListener('click', function () {
            if (!navigator.geolocation) {
                showLuxuryToast('Không hỗ trợ GPS', 'Trình duyệt hiện tại không hỗ trợ định vị vị trí.', 'error');
                return;
            }

            var btn = this;
            var originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang lấy GPS...';

            navigator.geolocation.getCurrentPosition(
                function (position) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    var lat = position.coords.latitude.toFixed(6);
                    var lng = position.coords.longitude.toFixed(6);

                    document.getElementById('inputLatitude').value = lat;
                    document.getElementById('inputLongitude').value = lng;
                    updateGoogleMapsLink();

                    showLuxuryToast(
                        'Lấy Toạ Độ Thành Công!',
                        'Vĩ độ: <strong class="text-warning">' + lat + '</strong> &nbsp;·&nbsp; Kinh độ: <strong class="text-warning">' + lng + '</strong>',
                        'success'
                    );
                },
                function (error) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    var msg = 'Không thể lấy toạ độ GPS: ';
                    switch (error.code) {
                        case error.PERMISSION_DENIED: msg = 'Bạn đã từ chối cấp quyền truy cập vị trí trên trình duyệt.'; break;
                        case error.POSITION_UNAVAILABLE: msg = 'Tín hiệu GPS hiện không khả dụng. Vui lòng kiểm tra lại thiết bị.'; break;
                        case error.TIMEOUT: msg = 'Hết thời gian chờ phản hồi GPS từ thiết bị.'; break;
                        default: msg = error.message; break;
                    }
                    showLuxuryToast('Lỗi Định Vị GPS', msg, 'error');
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        });

        // Công thức tính khoảng cách mặt cầu Haversine (chuẩn C# GeofencePolicy)
        function calculateHaversine(lat1, lon1, lat2, lon2) {
            var R = 6371000; // mét
            var toRad = function(x) { return x * Math.PI / 180; };
            var dLat = toRad(lat2 - lat1);
            var dLon = toRad(lon2 - lon1);
            var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
                    Math.sin(dLon / 2) * Math.sin(dLon / 2);
            var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        document.getElementById('btnTestDistance')?.addEventListener('click', function () {
            var hotelLat = parseFloat(document.getElementById('inputLatitude').value);
            var hotelLng = parseFloat(document.getElementById('inputLongitude').value);
            var radius = parseFloat(document.getElementById('inputRadius').value) || 250;

            var testLat = parseFloat(document.getElementById('testLat').value);
            var testLng = parseFloat(document.getElementById('testLng').value);

            if (isNaN(testLat) || isNaN(testLng)) {
                showLuxuryToast('Thiếu Thông Tin', 'Vui lòng nhập đầy đủ Vĩ độ và Kinh độ cần kiểm thử.', 'error');
                return;
            }

            var distance = calculateHaversine(hotelLat, hotelLng, testLat, testLng);
            var box = document.getElementById('testResultBox');
            var distText = document.getElementById('resultDistance');
            var badge = document.getElementById('resultBadge');

            box.classList.remove('d-none');
            distText.innerText = distance.toFixed(1) + ' m';

            if (distance <= radius) {
                badge.className = 'badge bg-success';
                badge.innerText = 'HỢP LỆ (Trong bán kính ' + radius + 'm)';
            } else {
                badge.className = 'badge bg-danger';
                badge.innerText = 'BỊ CHẶN (Vượt quá bán kính ' + (distance - radius).toFixed(1) + 'm)';
            }
        });
    </script>
}
