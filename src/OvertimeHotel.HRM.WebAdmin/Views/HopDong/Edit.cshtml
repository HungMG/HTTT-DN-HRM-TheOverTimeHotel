@model OvertimeHotel.HRM.WebAdmin.Models.HopDongFormViewModel
@{
    ViewData["Title"] = "Sửa hợp đồng lao động";
}
<div class="container py-4"><div class="mb-4"><a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Danh sách hợp đồng</a><h1 class="h2 fw-bold mt-3">Sửa hợp đồng lao động</h1></div><form asp-action="Edit" asp-route-id="@Model.Contract.MaHopDong" method="post" class="card border-0 shadow-sm"><div class="card-body p-4"><input type="hidden" asp-for="Contract.MaHopDong" /><partial name="_Form" model="Model" /></div><div class="card-footer bg-white border-0 p-4 pt-0"><button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Lưu thay đổi</button> <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div></form><form asp-action="Delete" asp-route-id="@Model.Contract.MaHopDong" method="post" class="mt-3" onsubmit="return confirm('Xóa hợp đồng này?');"><button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Xóa hợp đồng</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
