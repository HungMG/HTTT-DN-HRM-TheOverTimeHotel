@model IReadOnlyList<OvertimeHotel.HRM.WebAdmin.Controllers.HopDongController.SalaryReviewItem>
@{ var moneyCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
@if (Model.Count == 0)
{
    <div class="salary-review-state text-center" data-reviews-empty>
        <i class="bi bi-check2-circle fs-2 text-success d-block mb-3" aria-hidden="true"></i>
        <h3 class="h6">Chưa có nhân viên nào cần xét lương</h3>
        <p class="text-muted small mb-0">Nhân viên sẽ xuất hiện khi đến mốc 1 năm hoặc 3 năm và chưa được xét lương theo khung mới.</p>
    </div>
}
else
{
    <div class="salary-review-summary"><span class="fw-semibold">@Model.Count hồ sơ cần xem xét</span><span class="text-muted small">Thông tin được đối chiếu theo ngày hiện tại</span></div>
    <ul class="salary-review-list list-unstyled mb-0">
        @foreach (var item in Model)
        {
            <li class="salary-review-row">
                <dl class="salary-review-fields mb-0">
                    <div class="salary-review-person"><dt>Nhân viên</dt><dd><span class="fw-semibold">@item.Name</span><span class="d-block small text-muted">Hợp đồng #@item.ContractId</span></dd></div>
                    <div><dt>Thâm niên</dt><dd>@(item.Months / 12) năm @(item.Months % 12) tháng</dd></div>
                    <div><dt>Lương hiện tại</dt><dd class="salary-review-money">@(item.Salary.HasValue ? item.Salary.Value.ToString("N0", moneyCulture) + " đ" : "Cần xác minh")</dd></div>
                    <div><dt>Khung tham chiếu</dt><dd class="salary-review-money">@(item.Minimum.HasValue ? item.Minimum.Value.ToString("N0", moneyCulture) + "–" + item.Maximum.GetValueOrDefault().ToString("N0", moneyCulture) + " đ" : "Chưa xác định")</dd></div>
                </dl>
                <p class="salary-review-reason mb-0"><i class="bi bi-info-circle me-2" aria-hidden="true"></i>@item.Reason</p>
            </li>
        }
    </ul>
}
