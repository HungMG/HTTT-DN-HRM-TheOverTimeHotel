@model OvertimeHotel.HRM.WebAdmin.Models.HopDongFormViewModel
@{ ViewData["IsContractModal"] = true; }
<div class="modal-header border-bottom py-3 px-4">
    <div>
        <h2 class="modal-title h5 font-serif mb-1" id="editContractModalLabel">Chỉnh sửa hợp đồng</h2>
        <p class="text-muted small mb-0">@Model.Contract.SoHopDong · @Model.EmployeeName</p>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>
<form action="@Url.Content($"~/HopDong/Edit/{Model.Contract.MaHopDong}")" method="post" data-contract-edit-form class="d-flex flex-column overflow-hidden">
    <div class="modal-body overflow-auto p-4">
        <div class="alert alert-danger d-none" role="alert" data-contract-form-error></div>
        <input type="hidden" asp-for="Contract.MaHopDong" id="editContractId" />
        <partial name="_Form" model="Model" />
    </div>
    <div class="modal-footer flex-shrink-0 bg-light py-3 px-4">
        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-hotel-primary rounded-pill px-4 fw-semibold">
            <i class="bi bi-check2 me-1" aria-hidden="true"></i>Lưu thay đổi
        </button>
    </div>
</form>
