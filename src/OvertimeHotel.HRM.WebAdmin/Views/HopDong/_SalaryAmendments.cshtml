@model HopDongSalaryAmendmentsViewModel
@{ var prefix = $"amendment_{Model.ContractId}_"; }
<div class="d-flex align-items-center justify-content-between mb-2">
    <h3 class="h5 fw-semibold mb-0">Phụ lục điều chỉnh lương</h3>
    @if (Model.CurrentSalary.HasValue && Model.CurrentSalary.Value > 0)
    {
        <span class="badge bg-light text-dark border px-2 py-1">
            <span class="text-muted fw-normal">Lương hiện tại:</span>
            <strong class="text-success font-monospace">@Model.CurrentSalary.Value.ToString("N0") VNĐ/tháng</strong>
        </span>
    }
</div>
<p class="text-muted small">Mỗi phụ lục thay thế mức lương từ ngày hiệu lực. Lương gốc hợp đồng và phiếu lương đã khóa được giữ nguyên.</p>
@if (Model.Items.Count == 0)
{
    <p class="small text-muted mb-3">Chưa có phụ lục. Lương gốc hợp đồng được dùng khi chưa có điều chỉnh có hiệu lực.</p>
}
else
{
    <div class="table-responsive mb-3">
        <table class="table table-sm align-middle">
            <caption class="visually-hidden">Lịch sử điều chỉnh lương hợp đồng @Model.ContractNumber</caption>
            <thead><tr><th scope="col">Hiệu lực từ</th><th scope="col" class="text-end">Lương mới (VNĐ/tháng)</th><th scope="col">Chức vụ</th><th scope="col">Lý do</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><td class="text-nowrap">@item.EffectiveDate.ToString("dd/MM/yyyy")</td><td class="text-end text-nowrap font-monospace fw-semibold">@item.Salary.ToString("N0")</td><td>@item.PositionName</td><td>@item.Reason</td></tr>
                }
            </tbody>
        </table>
    </div>
}
@if (Model.NextMonthOutsideContract)
{
    <div class="alert alert-warning mt-3" role="status">
        Hợp đồng không có hiệu lực vào ngày @Model.DefaultEffectiveDate.ToString("dd/MM/yyyy"). Vui lòng kiểm tra thời hạn hoặc lập hợp đồng mới trước khi điều chỉnh lương.
    </div>
}
@if (Model.CanAdd)
{
    <details class="mt-3">
        <summary class="text-primary fw-semibold cursor-pointer">Thêm phụ lục điều chỉnh lương</summary>
        <form action="@Url.Content("~/HopDong/AddSalaryAmendment")" method="post" class="mt-3" data-salary-amendment-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="contractId" value="@Model.ContractId" />
            <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
            <input type="hidden" name="education" value="@Model.Education" />
            <div class="alert alert-danger d-none" role="alert" tabindex="-1" data-amendment-error></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="@(prefix + "date")" class="form-label fw-semibold">Ngày hiệu lực *</label>
                    <input id="@(prefix + "date")" name="effectiveDate" type="date" class="form-control" value="@Model.DefaultEffectiveDate.ToString("yyyy-MM-dd")" required />
                    <div class="form-text">Mặc định ngày 01 của tháng tiếp theo để đồng bộ kỳ tính lương. Không được ảnh hưởng kỳ lương đã duyệt hoặc khóa.</div>
                </div>
                <div class="col-md-6">
                    <label for="@(prefix + "salary")" class="form-label fw-semibold">Lương mới (VNĐ/tháng) *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-cash-stack text-success"></i></span>
                        <input id="@(prefix + "salary")"
                               name="salary"
                               type="text"
                               inputmode="numeric"
                               autocomplete="off"
                               class="form-control border-start-0 font-monospace fw-bold text-success"
                               placeholder="Ví dụ: 8,000,000"
                               required
                               aria-describedby="@(prefix + "band")" />
                    </div>
                    <div id="@(prefix + "band")" class="form-text mt-1" role="status" aria-live="polite" data-salary-band>Chọn ngày hiệu lực để xem khung lương.</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input id="@(prefix + "changePosition")" name="changePosition" type="checkbox" value="true" class="form-check-input" data-amendment-change-position />
                        <label for="@(prefix + "changePosition")" class="form-check-label">Đổi chức vụ hoặc phòng ban cùng phụ lục</label>
                    </div>
                    <div class="form-text">Nếu không chọn, giữ chức vụ và phòng ban có hiệu lực tại ngày điều chỉnh, kể cả thay đổi đã được lên lịch.</div>
                </div>
                <div class="col-md-6">
                    <label for="@(prefix + "department")" class="form-label">Phòng ban sau điều chỉnh</label>
                    <select id="@(prefix + "department")" name="departmentId" class="form-select" disabled>
                        @foreach (var option in Model.DepartmentOptions)
                        { <option value="@option.Value" selected="@(option.Value == Model.DepartmentId?.ToString())">@option.Text</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="@(prefix + "position")" class="form-label">Chức vụ sau điều chỉnh</label>
                    <select id="@(prefix + "position")" name="positionId" class="form-select" disabled>
                        @foreach (var option in Model.PositionOptions)
                        { <option value="@option.Value" selected="@(option.Value == Model.PositionId?.ToString())">@option.Text</option> }
                    </select>
                    <div class="form-text">Đổi chức vụ có hiệu lực cùng ngày với phụ lục.</div>
                </div>
                <div class="col-12">
                    <label for="@(prefix + "reason")" class="form-label">Lý do điều chỉnh *</label>
                    <textarea id="@(prefix + "reason")" name="reason" class="form-control" rows="2" maxlength="1000" required></textarea>
                </div>
                @if (Model.RequiresBaselineConfirmation)
                {
                    <div class="col-12">
                        <div class="form-check">
                            <input id="@(prefix + "baseline")" name="confirmBaseline" value="true" type="checkbox" class="form-check-input" />
                            <label for="@(prefix + "baseline")" class="form-check-label">Tôi đã đối chiếu chức vụ và phòng ban gốc của hợp đồng với hồ sơ hiện tại</label>
                        </div>
                        <div class="form-text">Cần xác nhận khi đổi chức vụ hoặc phòng ban của hợp đồng cũ chưa lưu thông tin gốc.</div>
                    </div>
                }
                <div class="col-12"><button type="submit" class="btn btn-hotel-primary">Lưu phụ lục</button></div>
            </div>
        </form>
    </details>
}
