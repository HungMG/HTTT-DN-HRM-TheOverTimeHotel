@model OvertimeHotel.HRM.WebAdmin.Models.HopDongDetailsModalViewModel
@{
    var contract = Model.Contract;
    var emp = Model.Employee;
    var initials = !string.IsNullOrEmpty(emp.Ten) ? emp.Ten.Substring(0, 1).ToUpper() : "N";
}

<style>
.contract-prop-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px dashed #e2e8f0;
}
.contract-prop-row:last-child {
    border-bottom: 0;
}
.contract-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 18px 20px;
    height: 100%;
    transition: all 0.2s ease;
}
.contract-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
}
</style>

<div class="p-4">
    <!-- HEADER HERO BANNER -->
    <div class="p-4 rounded-4 mb-4 position-relative overflow-hidden shadow-sm"
         style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #172554 100%); color: #fff;">
        <div class="position-absolute end-0 top-0 p-4 opacity-10 pe-none" style="font-size: 7.5rem; line-height: 1;">
            <i class="bi bi-file-earmark-text"></i>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-3 position-relative z-1">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow flex-shrink-0"
                 style="width: 70px; height: 70px; font-size: 1.8rem; background: linear-gradient(135deg, #1e40af, #3b82f6); border: 2.5px solid #d4af37; color: #fff;">
                @initials
            </div>
            <div class="flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="badge bg-light text-dark font-monospace fw-bold px-2 py-1 shadow-sm">
                        @contract.SoHopDong
                    </span>
                    @if (contract.TrangThai == "DA_CHAM_DUT")
                    {
                        <span class="badge bg-secondary rounded-pill px-3 py-1">
                            <i class="bi bi-archive-fill me-1"></i>Đã thanh lý
                        </span>
                    }
                    else if (contract.TrangThai == "HET_HAN" || (Model.DaysRemaining.HasValue && Model.DaysRemaining.Value < 0))
                    {
                        <span class="badge bg-danger rounded-pill px-3 py-1">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Hết hạn
                        </span>
                    }
                    else if (Model.DaysRemaining.HasValue && Model.DaysRemaining.Value <= 30)
                    {
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1">
                            <i class="bi bi-hourglass-split me-1"></i>Sắp hết hạn (còn @Model.DaysRemaining ngày)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-75 text-white rounded-pill px-3 py-1">
                            <i class="bi bi-check-circle-fill me-1"></i>Đang có hiệu lực
                        </span>
                    }

                    @if (Model.IsRenewed)
                    {
                        <span class="badge bg-info-subtle text-info border border-info rounded-pill px-2 py-1">
                            <i class="bi bi-check2-all me-1"></i>Đã gia hạn
                        </span>
                    }
                </div>
                <h3 class="h4 mb-0 fw-bold font-serif text-white">@emp.HoTen</h3>
                <div class="text-white-50 small mt-1 d-flex flex-wrap align-items-center gap-2">
                    <span><i class="bi bi-person-badge me-1"></i>NV-@emp.MaNhanVien.ToString("D3")</span>
                    <span>&bull;</span>
                    <span><i class="bi bi-building me-1"></i>@Model.DepartmentName</span>
                    <span>&bull;</span>
                    <span><i class="bi bi-briefcase me-1"></i>@Model.PositionName</span>
                </div>
            </div>
        </div>
    </div>

    <!-- NỘI DUNG CHI TIẾT HỢP ĐỒNG -->
    <div class="row g-3">
        <!-- KHỐI 1: THÔNG TIN HỢP ĐỒNG & THỜI HẠN -->
        <div class="col-md-6">
            <div class="contract-card">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <h6 class="mb-0 fw-bold text-dark font-serif">Thời Hạn & Loại Hợp Đồng</h6>
                </div>

                <div class="contract-prop-row">
                    <span class="text-muted small">Số hiệu hợp đồng:</span>
                    <strong class="font-monospace text-primary">@contract.SoHopDong</strong>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Loại hợp đồng:</span>
                    <span class="badge bg-light text-dark border">@ContractTypes.ToDisplayName(contract.LoaiHopDong)</span>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Hình thức hợp đồng:</span>
                    @if (contract.HinhThucHopDong == "THU_VIEC")
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border">Thử việc</span>
                    }
                    else
                    {
                        <span class="badge bg-info-subtle text-info-emphasis border">Chính thức</span>
                    }
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Ngày bắt đầu hiệu lực:</span>
                    <strong class="font-monospace text-dark">@contract.NgayBatDau.ToString("dd/MM/yyyy")</strong>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Ngày kết thúc hợp đồng:</span>
                    <strong class="font-monospace text-dark">@(contract.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "Không xác định thời hạn")</strong>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Thời hạn còn lại:</span>
                    @if (Model.DaysRemaining.HasValue)
                    {
                        if (Model.DaysRemaining < 0)
                        {
                            <span class="text-danger fw-bold small"><i class="bi bi-x-circle me-1"></i>Đã quá hạn @(-Model.DaysRemaining) ngày</span>
                        }
                        else if (Model.DaysRemaining == 0)
                        {
                            <span class="text-warning fw-bold small"><i class="bi bi-clock me-1"></i>Hết hạn hôm nay</span>
                        }
                        else
                        {
                            <span class="text-success fw-bold small"><i class="bi bi-check-circle me-1"></i>Còn @Model.DaysRemaining ngày</span>
                        }
                    }
                    else
                    {
                        <span class="text-secondary small">Vô thời hạn</span>
                    }
                </div>
            </div>
        </div>

        <!-- KHỐI 2: CHẾ ĐỘ TIỀN LƯƠNG & ĐÃI NGỘ -->
        <div class="col-md-6">
            <div class="contract-card">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                    <h6 class="mb-0 fw-bold text-dark font-serif">Tiền Lương & Chế Độ Đãi Ngộ</h6>
                </div>

                <div class="contract-prop-row">
                    <span class="text-muted small">Mức lương cơ bản:</span>
                    <strong class="text-primary fs-5 font-monospace">@contract.LuongCoBan.ToString("N0") VNĐ</strong>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Kỳ hạn chi trả:</span>
                    <span class="text-dark small fw-semibold">Định kỳ hàng tháng</span>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Hình thức trả lương:</span>
                    <span class="text-dark small fw-semibold">Chuyển khoản qua ngân hàng</span>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Phụ cấp làm ca đêm:</span>
                    <span class="badge bg-light text-dark border small">+30% (Điều 98 BLLĐ)</span>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Trích nộp BHXH, YT, TN:</span>
                    <span class="badge bg-light text-dark border small">10.5% lương tham gia</span>
                </div>
                <div class="contract-prop-row">
                    <span class="text-muted small">Chế độ nghỉ mát/nghỉ phép:</span>
                    <span class="text-success small fw-semibold">Theo quy chế Khách sạn 5 sao</span>
                </div>
            </div>
        </div>

        <!-- KHỐI 3: THÔNG TIN NHÂN SỰ KÝ KẾT -->
        <div class="col-md-12">
            <div class="contract-card">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-person-lines-fill"></i>
                    </div>
                    <h6 class="mb-0 fw-bold text-dark font-serif">Thông Tin Nhân Sự Ký Hợp Đồng</h6>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="text-muted small">Họ và tên:</div>
                        <div class="fw-bold text-dark">@emp.HoTen</div>
                        <div class="text-muted small mt-2">Mã nhân sự:</div>
                        <div class="font-monospace text-secondary fw-semibold">NV-@emp.MaNhanVien.ToString("D3")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Phòng ban công tác:</div>
                        <div class="fw-bold text-dark">@Model.DepartmentName</div>
                        <div class="text-muted small mt-2">Chức vụ / Vị trí:</div>
                        <div class="fw-bold text-primary">@Model.PositionName</div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-muted small">Email cá nhân nhận HĐ:</div>
                        <div class="small text-dark font-monospace">@(emp.EmailCaNhan ?? "Chưa cung cấp")</div>
                        <div class="text-muted small mt-2">Số điện thoại liên hệ:</div>
                        <div class="small text-dark font-monospace">@emp.DienThoai</div>
                    </div>
                </div>

                @if (Model.PreviousContract != null || Model.NextContract != null)
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="text-muted small fw-bold mb-1"><i class="bi bi-clock-history me-1"></i>Chuỗi lịch sử hợp đồng liên quan:</div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.PreviousContract != null)
                            {
                                <span class="badge bg-light text-secondary border px-2 py-1">
                                    <i class="bi bi-arrow-left me-1"></i>HĐ trước đó: @Model.PreviousContract.SoHopDong (@ContractTypes.ToDisplayName(Model.PreviousContract.LoaiHopDong))
                                </span>
                            }
                            @if (Model.NextContract != null)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-arrow-right me-1"></i>Đã gia hạn tiếp theo: @Model.NextContract.SoHopDong (@ContractTypes.ToDisplayName(Model.NextContract.LoaiHopDong))
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- THANH THAO TÁC (CHỈ CÓ NÚT IN MẪU HỢP ĐỒNG A4 VÀ ĐÓNG) -->
    <div class="d-flex align-items-center justify-content-between pt-4 mt-4 border-top">
        <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i> Đóng
        </button>

        <button type="button" class="btn btn-hotel-primary px-4 py-2 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center gap-2"
                onclick="printContractA4(@contract.MaHopDong)">
            <i class="bi bi-printer-fill fs-5"></i> In mẫu hợp đồng A4
        </button>
    </div>
</div>
