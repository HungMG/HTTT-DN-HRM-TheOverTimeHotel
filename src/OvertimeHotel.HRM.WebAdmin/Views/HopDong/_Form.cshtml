@model OvertimeHotel.HRM.WebAdmin.Models.HopDongFormViewModel
@{
    var isEditMode = Model.Contract.MaHopDong > 0;
    var isModal = ViewData["IsContractModal"] is true;
    var formIdPrefix = isModal ? "edit_" : "";
    var isProbation = Model.Contract.HinhThucHopDong == "THU_VIEC";
    var employeeList = (ViewBag.EmployeeList as IEnumerable<HopDongEmployeeOptionItem>) ?? Model.EmployeeList ?? Enumerable.Empty<HopDongEmployeeOptionItem>();
    var departmentOptions = ViewBag.DepartmentOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var positionOptions = ViewBag.PositionOptions as IEnumerable<SelectListItem> ?? Model.PositionOptions ?? Enumerable.Empty<SelectListItem>();
}

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<!-- ========================================================================= -->
<!-- HÀNG 1: NHÂN SỰ * | PHÒNG BAN * | CHỨC VỤ *                               -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <!-- CỘT 1: NHÂN SỰ -->
    <div class="col-md-4">
        <label asp-for="EmployeeName" for="@(formIdPrefix + "contractEmployeeInput")" class="form-label fw-semibold text-dark">
            Nhân sự <span class="text-danger">*</span>
        </label>
        @if (isEditMode)
        {
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-badge-fill text-primary"></i></span>
                <input type="text" id="@(formIdPrefix + "contractEmployeeInput")" class="form-control bg-light border-start-0 fw-semibold text-dark" value="@Model.EmployeeName" readonly />
                <input type="hidden" asp-for="EmployeeId" />
                <input type="hidden" asp-for="EmployeeName" id="@(formIdPrefix + "employeeNameHidden")" />
            </div>
        }
        else
        {
            <!-- Chế độ Lập mới: Ô nhập tay tên nhân viên kèm danh sách gợi ý datalist -->
            <div id="@(formIdPrefix + "createEmployeeWrapper")">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person-fill text-primary"></i></span>
                    <input asp-for="EmployeeName" id="@(formIdPrefix + "contractEmployeeInput")" list="employeeDatalist" class="form-control border-start-0" placeholder="Nhập họ và tên..." autocomplete="off" />
                    <input type="hidden" asp-for="EmployeeId" id="@(formIdPrefix + "contractEmployeeIdHidden")" value="@Model.EmployeeId" />
                </div>
                <datalist id="@(formIdPrefix + "employeeDatalist")">
                    @foreach (var emp in employeeList)
                    {
                        <option value="@emp.Code — @emp.FullName" data-name="@emp.FullName" data-id="@emp.Id" data-dept-id="@emp.DepartmentId" data-dept-name="@emp.DepartmentName" data-pos-id="@emp.PositionId" data-pos-name="@emp.PositionName" data-email="@emp.PersonalEmail">
                            @emp.FullName (@emp.Code - @emp.DepartmentName - @emp.PositionName)
                        </option>
                    }
                </datalist>
                <div class="form-text small text-muted">Nhập tay hoặc chọn từ danh sách.</div>
            </div>

            <!-- Chế độ Gia hạn: Hiển thị cố định thông tin nhân viên -->
            <div id="@(formIdPrefix + "renewEmployeeDisplayWrapper")" class="d-none">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-check-fill text-success"></i></span>
                    <input type="text" id="@(formIdPrefix + "renewEmployeeNameDisplay")" class="form-control bg-light border-start-0 fw-semibold text-dark" readonly />
                </div>
            </div>
        }
        <span asp-validation-for="EmployeeName" class="text-danger small"></span>
    </div>

    <!-- CỘT 2: PHÒNG BAN -->
    <div class="col-md-4">
        <label for="@(formIdPrefix + "contractDepartmentSelect")" class="form-label fw-semibold text-dark">
            Phòng ban <span class="text-danger">*</span>
        </label>
        <div id="@(formIdPrefix + "createDepartmentWrapper")">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-building text-secondary"></i></span>
                <select asp-for="DepartmentId" id="@(formIdPrefix + "contractDepartmentSelect")" class="form-select border-start-0">
                    <option value="">-- Chọn phòng ban --</option>
                    @foreach (var dept in departmentOptions)
                    {
                        <option value="@dept.Value" selected="@(Model.DepartmentId?.ToString() == dept.Value)">@dept.Text</option>
                    }
                </select>
            </div>
            <div class="form-text small text-muted">Phòng ban công tác của nhân sự.</div>
        </div>

        <div id="@(formIdPrefix + "renewDepartmentWrapper")" class="d-none">
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-building-check text-success"></i></span>
                <input type="text" id="@(formIdPrefix + "renewDepartmentDisplay")" class="form-control bg-light border-start-0 text-dark fw-semibold" readonly />
            </div>
        </div>
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>

    <!-- CỘT 3: CHỨC VỤ -->
    <div class="col-md-4">
        <label for="@(formIdPrefix + "contractPositionSelect")" class="form-label fw-semibold text-dark">
            Chức vụ <span class="text-danger">*</span>
        </label>
        <div id="@(formIdPrefix + "createPositionWrapper")">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person-badge text-secondary"></i></span>
                <select asp-for="PositionId" id="@(formIdPrefix + "contractPositionSelect")" class="form-select border-start-0">
                    <option value="">-- Chọn chức vụ --</option>
                    @foreach (var pos in positionOptions)
                    {
                        <option value="@pos.Value" selected="@(Model.PositionId?.ToString() == pos.Value)">@pos.Text</option>
                    }
                </select>
            </div>
            <div class="form-text small text-muted">Vị trí việc làm tương ứng với phòng ban.</div>
        </div>

        <div id="@(formIdPrefix + "renewPositionWrapper")" class="d-none">
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-badge-fill text-success"></i></span>
                <input type="text" id="@(formIdPrefix + "renewPositionDisplay")" class="form-control bg-light border-start-0 text-dark fw-semibold" readonly />
            </div>
        </div>
        <span asp-validation-for="PositionId" class="text-danger small"></span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- GIAI ĐOẠN VÀ THỜI HẠN HỢP ĐỒNG -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Contract.LoaiHopDong" for="@(formIdPrefix + (isProbation ? "contractProbationDuration" : "contractLoaiHopDong"))" class="form-label fw-semibold text-dark" data-contract-duration-label>
            Thời hạn hợp đồng <span class="text-danger">*</span>
        </label>
        <select asp-for="Contract.LoaiHopDong" id="@(formIdPrefix + "contractLoaiHopDong")" class="form-select" required="@(!isProbation)" hidden="@isProbation">
            <option value="XAC_DINH_THOI_HAN_1_NAM">HĐ lao động 01 năm</option>
            <option value="XAC_DINH_THOI_HAN_3_NAM">HĐ lao động 03 năm</option>
            <option value="KHONG_XAC_DINH_THOI_HAN">HĐ lao động không xác định thời hạn</option>
            <option value="THU_VIEC" hidden>Thử việc theo ngày bắt đầu / kết thúc</option>
        </select>
        <input type="text" readonly class="form-control bg-light" id="@(formIdPrefix + "contractProbationDuration")" data-contract-probation-duration hidden="@(!isProbation)" value="Theo ngày bắt đầu và ngày kết thúc" />
        <span asp-validation-for="Contract.LoaiHopDong" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Contract.HinhThucHopDong" for="@(formIdPrefix + "contractHinhThucHopDong")" class="form-label fw-semibold text-dark">
            Giai đoạn hợp đồng <span class="text-danger">*</span>
        </label>
        <select asp-for="Contract.HinhThucHopDong" id="@(formIdPrefix + "contractHinhThucHopDong")" class="form-select" required>
            <option value="CHINH_THUC">Chính thức</option>
            <option value="THU_VIEC">Thử việc</option>
        </select>
        <div class="form-text small text-muted">Phân biệt rõ giai đoạn thử việc hoặc ký chính thức.</div>
        <span asp-validation-for="Contract.HinhThucHopDong" class="text-danger small"></span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 3: NGÀY BẮT ĐẦU * (TRÁI) | NGÀY KẾT THÚC (PHẢI)                     -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Contract.NgayBatDau" for="@(formIdPrefix + "contractNgayBatDau")" class="form-label fw-semibold text-dark">
            Ngày bắt đầu <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-calendar-event"></i></span>
            <input asp-for="Contract.NgayBatDau" id="@(formIdPrefix + "contractNgayBatDau")" type="date" class="form-control border-start-0" required />
        </div>
        <span asp-validation-for="Contract.NgayBatDau" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Contract.NgayKetThuc" for="@(formIdPrefix + "contractNgayKetThuc")" class="form-label fw-semibold text-dark">
            Ngày kết thúc <span class="text-danger" data-contract-end-required hidden="@(!isProbation)">*</span>
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-calendar-check"></i></span>
            <input asp-for="Contract.NgayKetThuc" id="@(formIdPrefix + "contractNgayKetThuc")" type="date" class="form-control border-start-0" required="@isProbation" />
        </div>
        <div class="form-text small text-muted" data-contract-end-hint>@(isProbation ? "Nhập ngày kết thúc thử việc; hệ thống giữ khoảng thời gian bạn chọn." : "Tự động tính theo thời hạn 1 năm, 3 năm; để trống nếu không xác định thời hạn.")</div>
        <span asp-validation-for="Contract.NgayKetThuc" class="text-danger small"></span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 4: MÃ HỢP ĐỒNG * (TRÁI) | LƯƠNG CƠ BẢN * (PHẢI)                     -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label asp-for="Contract.SoHopDong" for="@(formIdPrefix + "contractSoHopDong")" class="form-label fw-semibold text-dark mb-0">
                Mã hợp đồng <span class="text-danger">*</span>
            </label>
            <button type="button" class="btn btn-link p-0 text-decoration-none small text-primary fw-semibold" onclick="@(isModal ? null : "generateRandomContractNumber(true)")" data-contract-generate="@isModal.ToString().ToLowerInvariant()" title="Tạo mã hợp đồng ngẫu nhiên mới">
                <i class="bi bi-arrow-clockwise me-1"></i>Tạo mã mới
            </button>
        </div>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-file-earmark-code"></i></span>
            <input asp-for="Contract.SoHopDong" id="@(formIdPrefix + "contractSoHopDong")" class="form-control border-start-0 border-end-0 font-monospace text-uppercase fw-bold text-primary" placeholder="HDLD-@DateTime.Now.Year/01/OTH" required />
            <button type="button" class="btn btn-light border border-start-0 text-primary" onclick="@(isModal ? null : "generateRandomContractNumber(true)")" data-contract-generate="@isModal.ToString().ToLowerInvariant()" title="Sinh số ngẫu nhiên mới">
                <i class="bi bi-shuffle"></i>
            </button>
        </div>
        <div class="form-text small text-muted">Tự động sinh: HDLD (chính thức) hoặc HDTV (thử việc)-@DateTime.Now.Year/Số ngẫu nhiên/OTH.</div>
        <span asp-validation-for="Contract.SoHopDong" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Contract.LuongCoBan" for="@(formIdPrefix + "contractLuongCoBan")" class="form-label fw-semibold text-dark">
            Lương cơ bản (VNĐ) <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-cash-stack text-success"></i></span>
            <input asp-for="Contract.LuongCoBan" id="@(formIdPrefix + "contractLuongCoBan")" type="number" min="0" step="any" class="form-control border-start-0 font-monospace fw-bold text-success" placeholder="Nhập mức lương (VD: 10000000)" required />
            <span class="input-group-text bg-light text-muted">₫</span>
        </div>
        <div class="form-text small text-muted">Căn cứ pháp lý tính đơn giá ngày công và bảo hiểm bắt buộc.</div>
        <span asp-validation-for="Contract.LuongCoBan" class="text-danger small"></span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 5: TRẠNG THÁI HỢP ĐỒNG (TRÁI) | GỬI EMAIL THÔNG BÁO (PHẢI)           -->
<!-- ========================================================================= -->
<div class="row g-3 mb-2">
    <div class="col-md-6">
        <label asp-for="Contract.TrangThai" for="@(isEditMode ? formIdPrefix + "contractTrangThai" : "newContractStateDescription")" class="form-label fw-semibold text-dark">
            Trạng thái hợp đồng
        </label>
        @if (isEditMode)
        {
            <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-check2-circle text-primary"></i></span>
                <select asp-for="Contract.TrangThai" id="@(formIdPrefix + "contractTrangThai")" class="form-select border-start-0">
                    <option value="HIEU_LUC">Đã ký / Đang hiệu lực</option>
                    <option value="HET_HAN">Hết hạn</option>
                    <option value="DA_CHAM_DUT">Thanh lý / Chấm dứt</option>
                </select>
            </div>
        }
        else
        {
            <input type="hidden" name="Contract.TrangThai" id="@(formIdPrefix + "contractTrangThai")" value="HIEU_LUC" />
            <input type="text" readonly class="form-control bg-light text-secondary" id="newContractStateDescription" value="Tự động theo thời hạn hợp đồng" aria-describedby="newContractStateHint" />
            <div class="form-text small text-muted" id="newContractStateHint">Chưa tới ngày bắt đầu: Chưa hiệu lực. Hết thời hạn: Hết hạn. Thanh lý / chấm dứt được xử lý sau khi lập hợp đồng.</div>
        }
        <span asp-validation-for="Contract.TrangThai" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EmailNotificationOption" for="@(formIdPrefix + "contractEmailOption")" class="form-label fw-semibold text-dark">
            Gửi thông báo cho nhân viên qua email
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-send-fill text-info"></i></span>
            <select asp-for="EmailNotificationOption" id="@(formIdPrefix + "contractEmailOption")" class="form-select border-start-0">
                <option value="KHONG_GUI">Không gửi email</option>
                <option value="GUI_EMAIL">Gửi thông báo qua email cá nhân</option>
            </select>
        </div>
        <div class="form-text small text-muted">Kích hoạt gửi bản thông báo hợp đồng tới email cá nhân.</div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 5.5: EMAIL CÁ NHÂN (TỰ HIỆN NẾU CÓ, HOẶC NHẬP TAY NẾU CHƯA CÓ)       -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <label asp-for="PersonalEmail" for="@(formIdPrefix + "contractPersonalEmailInput")" class="form-label fw-semibold text-dark">
            <i class="bi bi-envelope-at text-primary me-1"></i>Email cá nhân nhận thông báo
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-at text-primary"></i></span>
            <input asp-for="PersonalEmail" id="@(formIdPrefix + "contractPersonalEmailInput")" type="email" class="form-control border-start-0 font-monospace" placeholder="Nhập email cá nhân của nhân viên (ví dụ: nhanvien@gmail.com)..." />
        </div>
        <div class="form-text small text-muted" id="@(formIdPrefix + "personalEmailHintText")">
            <i class="bi bi-info-circle me-1"></i>Hệ thống tự động điền email nếu nhân viên đã có trong hồ sơ; nếu chưa có, bạn có thể tự nhập tay vào ô này.
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 6: NÚT IN HỢP ĐỒNG (THAY THẾ HOÀN TOÀN XUẤT EXCEL & IN DANH SÁCH)   -->
<!-- ========================================================================= -->
<div class="p-3 bg-light rounded-3 border d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
    <div class="d-flex align-items-center text-secondary small">
        <i class="bi bi-file-earmark-medical-fill text-primary me-2 fs-5"></i>
        <div>
            <strong class="text-dark">Xuất & In văn bản Hợp đồng lao động:</strong>
            <div class="text-muted small">In mẫu hợp đồng pháp lý hoàn chỉnh trước khi ký kết và gửi email cho nhân viên.</div>
        </div>
    </div>
    <div>
        <button type="button" class="btn btn-hotel-primary rounded-pill px-4 fw-semibold shadow-sm" onclick="@(isModal ? null : "printContractDocument()")" data-contract-print="@(isModal ? Model.Contract.MaHopDong : null)">
            <i class="bi bi-printer-fill me-1"></i> In hợp đồng
        </button>
    </div>
</div>

@if (!isModal)
{
<script>
    (function () {
        function bindContractDeptAndPos() {
            var deptSelect = document.getElementById("contractDepartmentSelect");
            var posSelect = document.getElementById("contractPositionSelect");

            if (!deptSelect || !posSelect || deptSelect.dataset.cascadingBound) return;
            deptSelect.dataset.cascadingBound = "true";

            deptSelect.addEventListener("change", async function () {
                var deptId = this.value;
                var currentPosId = posSelect.value;
                posSelect.innerHTML = '<option value="">Đang tải danh sách chức vụ...</option>';

                try {
                    var res = await fetch('/ChucVu/GetByDepartment?departmentId=' + encodeURIComponent(deptId));
                    if (!res.ok) throw new Error("Fetch failed");
                    var data = await res.json();

                    posSelect.innerHTML = '<option value="">-- Chọn chức vụ --</option>';
                    var matched = false;
                    data.forEach(function (item) {
                        var opt = document.createElement("option");
                        opt.value = item.maChucVu;
                        opt.textContent = item.tenChucVu + (item.tenPhongBan ? ' (' + item.tenPhongBan + ')' : ' (Chung)');
                        if (String(item.maChucVu) === String(currentPosId)) {
                            opt.selected = true;
                            matched = true;
                        }
                        posSelect.appendChild(opt);
                    });

                    if (!matched && currentPosId && deptId) {
                        posSelect.value = "";
                    }
                } catch (e) {
                    posSelect.innerHTML = '<option value="">Không thể tải danh sách chức vụ</option>';
                }
            });
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", bindContractDeptAndPos);
        } else {
            bindContractDeptAndPos();
        }
        window.bindContractDeptAndPos = bindContractDeptAndPos;
    })();
</script>
}
