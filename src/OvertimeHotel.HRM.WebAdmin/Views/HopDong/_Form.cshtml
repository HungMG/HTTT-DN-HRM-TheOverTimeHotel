@model OvertimeHotel.HRM.WebAdmin.Models.HopDongFormViewModel
@{
    var isEditMode = Model.Contract.MaHopDong > 0;
    var employeeList = ViewBag.EmployeeList as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var departmentOptions = ViewBag.DepartmentOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<!-- ========================================================================= -->
<!-- HÀNG 1: NHÂN SỰ * (NHẬP TAY / GỢI Ý) | PHÒNG BAN (CHỌN PHÒNG BAN)         -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="EmployeeName" class="form-label fw-semibold text-dark">
            Nhân sự <span class="text-danger">*</span>
        </label>
        @if (isEditMode)
        {
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-badge-fill text-primary"></i></span>
                <input type="text" class="form-control bg-light border-start-0 fw-semibold text-dark" value="@Model.EmployeeName" readonly />
                <input type="hidden" asp-for="EmployeeId" />
                <input type="hidden" asp-for="EmployeeName" />
            </div>
        }
        else
        {
            <!-- Chế độ Lập mới: Ô nhập tay tên nhân viên kèm danh sách gợi ý datalist -->
            <div id="createEmployeeWrapper">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-person-fill text-primary"></i></span>
                    <input asp-for="EmployeeName" id="contractEmployeeInput" list="employeeDatalist" class="form-control border-start-0" placeholder="Nhập họ và tên nhân viên..." autocomplete="off" required />
                    <input type="hidden" asp-for="EmployeeId" id="contractEmployeeIdHidden" value="@Model.EmployeeId" />
                </div>
                <datalist id="employeeDatalist">
                    @foreach (var emp in employeeList)
                    {
                        <option value="@emp.FullName" data-id="@emp.Id" data-dept-id="@emp.DepartmentId" data-dept-name="@emp.DepartmentName" data-email="@emp.PersonalEmail">
                            @emp.FullName (@emp.Code - @emp.DepartmentName)
                        </option>
                    }
                </datalist>
                <div class="form-text small text-muted">Nhập tay tên nhân viên mới hoặc chọn từ danh sách đã tạo.</div>
            </div>

            <!-- Chế độ Gia hạn: Hiển thị cố định thông tin nhân viên -->
            <div id="renewEmployeeDisplayWrapper" class="d-none">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-person-check-fill text-success"></i></span>
                    <input type="text" id="renewEmployeeNameDisplay" class="form-control bg-light border-start-0 fw-semibold text-dark" readonly />
                </div>
            </div>
        }
        <span asp-validation-for="EmployeeName" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-semibold text-dark">Phòng ban</label>
        @if (isEditMode)
        {
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-building text-secondary"></i></span>
                <input type="text" class="form-control bg-light border-start-0 text-secondary" id="contractDepartmentDisplay" value="@(string.IsNullOrEmpty(Model.DepartmentName) ? "Chưa phân bổ" : Model.DepartmentName)" readonly />
                <input type="hidden" asp-for="DepartmentId" />
                <input type="hidden" asp-for="DepartmentName" />
            </div>
        }
        else
        {
            <!-- Chế độ Lập mới: Dropdown chọn phòng ban công tác -->
            <div id="createDepartmentWrapper">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-building text-secondary"></i></span>
                    <select asp-for="DepartmentId" id="contractDepartmentSelect" class="form-select border-start-0">
                        <option value="">-- Chọn phòng ban công tác --</option>
                        @foreach (var dept in departmentOptions)
                        {
                            <option value="@dept.Value" selected="@(Model.DepartmentId?.ToString() == dept.Value)">@dept.Text</option>
                        }
                    </select>
                </div>
                <div class="form-text small text-muted">Chọn phòng ban phân công cho nhân viên mới.</div>
            </div>

            <!-- Chế độ Gia hạn: Hiển thị phòng ban dạng readonly đã có sẵn -->
            <div id="renewDepartmentWrapper" class="d-none">
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-building-check text-success"></i></span>
                    <input type="text" id="renewDepartmentDisplay" class="form-control bg-light border-start-0 text-dark fw-semibold" readonly />
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 2: LOẠI HỢP ĐỒNG * (ĐÃ BỎ THỬ VIỆC) | HÌNH THỨC HỢP ĐỒNG *          -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Contract.LoaiHopDong" class="form-label fw-semibold text-dark">
            Loại hợp đồng <span class="text-danger">*</span>
        </label>
        <select asp-for="Contract.LoaiHopDong" id="contractLoaiHopDong" class="form-select" required>
            <option value="XAC_DINH_THOI_HAN_1_NAM">HĐ lao động 01 năm</option>
            <option value="XAC_DINH_THOI_HAN_3_NAM">HĐ lao động 03 năm</option>
            <option value="KHONG_XAC_DINH_THOI_HAN">HĐ lao động không xác định thời hạn</option>
        </select>
        <span asp-validation-for="Contract.LoaiHopDong" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Contract.HinhThucHopDong" class="form-label fw-semibold text-dark">
            Hình thức hợp đồng <span class="text-danger">*</span>
        </label>
        <select asp-for="Contract.HinhThucHopDong" id="contractHinhThucHopDong" class="form-select" required>
            <option value="CHINH_THUC">Chính thức (Hợp đồng tiêu chuẩn)</option>
            <option value="THU_VIEC">Thử việc (Hợp đồng thử việc)</option>
        </select>
        <div class="form-text small text-muted">Phân biệt rõ giai đoạn thử việc hoặc ký chính thức.</div>
        <span asp-validation-for="Contract.HinhThucHopDong" class="text-danger small"></span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 3: NGÀY BẮT ĐẦU * (TRÁI) | NGÀY KẾT THÚC (PHẢI)                     -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <label asp-for="Contract.NgayBatDau" class="form-label fw-semibold text-dark">
            Ngày bắt đầu <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-calendar-event"></i></span>
            <input asp-for="Contract.NgayBatDau" id="contractNgayBatDau" type="date" class="form-control border-start-0" required />
        </div>
        <span asp-validation-for="Contract.NgayBatDau" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Contract.NgayKetThuc" class="form-label fw-semibold text-dark">
            Ngày kết thúc
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-calendar-check"></i></span>
            <input asp-for="Contract.NgayKetThuc" id="contractNgayKetThuc" type="date" class="form-control border-start-0" placeholder="Ngày kết thúc, không bắt buộc" />
        </div>
        <div class="form-text small text-muted">Tự động tính theo Loại hợp đồng (1 năm, 3 năm) hoặc để trống nếu vô thời hạn.</div>
        <span asp-validation-for="Contract.NgayKetThuc" class="text-danger small"></span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 4: MÃ HỢP ĐỒNG * (TRÁI) | LƯƠNG CƠ BẢN * (PHẢI)                     -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label asp-for="Contract.SoHopDong" class="form-label fw-semibold text-dark mb-0">
                Mã hợp đồng <span class="text-danger">*</span>
            </label>
            <button type="button" class="btn btn-link p-0 text-decoration-none small text-primary fw-semibold" onclick="generateRandomContractNumber(true)" title="Tạo mã hợp đồng ngẫu nhiên mới">
                <i class="bi bi-arrow-clockwise me-1"></i>Tạo mã mới
            </button>
        </div>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-file-earmark-code"></i></span>
            <input asp-for="Contract.SoHopDong" id="contractSoHopDong" class="form-control border-start-0 border-end-0 font-monospace text-uppercase fw-bold text-primary" placeholder="HDLD-@DateTime.Now.Year/01/OTH" required />
            <button type="button" class="btn btn-light border border-start-0 text-primary" onclick="generateRandomContractNumber(true)" title="Sinh số ngẫu nhiên mới">
                <i class="bi bi-shuffle"></i>
            </button>
        </div>
        <div class="form-text small text-muted">Tự động sinh: HDLD (chính thức) hoặc HDTV (thử việc)-@DateTime.Now.Year/Số ngẫu nhiên/OTH.</div>
        <span asp-validation-for="Contract.SoHopDong" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Contract.LuongCoBan" class="form-label fw-semibold text-dark">
            Lương cơ bản (VNĐ) <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-cash-stack text-success"></i></span>
            <input asp-for="Contract.LuongCoBan" id="contractLuongCoBan" type="number" min="0" step="100000" class="form-control border-start-0 font-monospace fw-bold text-success" placeholder="Nhập mức lương (VD: 10000000)" required />
            <span class="input-group-text bg-light text-muted">₫</span>
        </div>
        <div class="form-text small text-muted">Căn cứ pháp lý tính đơn giá ngày công và bảo hiểm bắt buộc.</div>
        <span asp-validation-for="Contract.LuongCoBan" class="text-danger small"></span>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 5: TRẠNG THÁI HỢP ĐỒNG (TRÁI) | GỬI EMAIL THÔNG BÁO (PHẢI)           -->
<!-- ========================================================================= -->
<div class="row g-3 mb-2">
    <div class="col-md-6">
        <label asp-for="Contract.TrangThai" class="form-label fw-semibold text-dark">
            Trạng thái hợp đồng
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-check2-circle text-primary"></i></span>
            <select asp-for="Contract.TrangThai" id="contractTrangThai" class="form-select border-start-0">
                <option value="HIEU_LUC">Đã ký / Đang hiệu lực</option>
                <option value="HET_HAN">Hết hạn</option>
                <option value="DA_CHAM_DUT">Thanh lý / Chấm dứt</option>
            </select>
        </div>
        <span asp-validation-for="Contract.TrangThai" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EmailNotificationOption" class="form-label fw-semibold text-dark">
            Gửi thông báo cho nhân viên qua email
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-send-fill text-info"></i></span>
            <select asp-for="EmailNotificationOption" id="contractEmailOption" class="form-select border-start-0">
                <option value="KHONG_GUI">Không gửi email</option>
                <option value="GUI_EMAIL">Gửi thông báo qua email cá nhân</option>
            </select>
        </div>
        <div class="form-text small text-muted">Kích hoạt gửi bản thông báo hợp đồng tới email cá nhân.</div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 5.5: EMAIL CÁ NHÂN (TỰ HIỆN NẾU CÓ, HOẶC NHẬP TAY NẾU CHƯA CÓ)       -->
<!-- ========================================================================= -->
<div class="row g-3 mb-3">
    <div class="col-12">
        <label asp-for="PersonalEmail" class="form-label fw-semibold text-dark">
            <i class="bi bi-envelope-at text-primary me-1"></i>Email cá nhân nhận thông báo
        </label>
        <div class="input-group">
            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-at text-primary"></i></span>
            <input asp-for="PersonalEmail" id="contractPersonalEmailInput" type="email" class="form-control border-start-0 font-monospace" placeholder="Nhập email cá nhân của nhân viên (ví dụ: nhanvien@gmail.com)..." />
        </div>
        <div class="form-text small text-muted" id="personalEmailHintText">
            <i class="bi bi-info-circle me-1"></i>Hệ thống tự động điền email nếu nhân viên đã có trong hồ sơ; nếu chưa có, bạn có thể tự nhập tay vào ô này.
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- HÀNG 6: NÚT IN HỢP ĐỒNG (THAY THẾ HOÀN TOÀN XUẤT EXCEL & IN DANH SÁCH)   -->
<!-- ========================================================================= -->
<div class="p-3 bg-light rounded-3 border d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
    <div class="d-flex align-items-center text-secondary small">
        <i class="bi bi-file-earmark-medical-fill text-primary me-2 fs-5"></i>
        <div>
            <strong class="text-dark">Xuất & In văn bản Hợp đồng lao động:</strong>
            <div class="text-muted small">In mẫu hợp đồng pháp lý hoàn chỉnh trước khi ký kết và gửi email cho nhân viên.</div>
        </div>
    </div>
    <div>
        <button type="button" class="btn btn-hotel-primary rounded-pill px-4 fw-semibold shadow-sm" onclick="printContractDocument()">
            <i class="bi bi-printer-fill me-1"></i> In hợp đồng
        </button>
    </div>
</div>
