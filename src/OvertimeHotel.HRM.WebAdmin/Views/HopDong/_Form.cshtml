@model OvertimeHotel.HRM.WebAdmin.Models.HopDongFormViewModel
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="EmployeeId" class="form-label">Nhân viên *</label><select asp-for="EmployeeId" asp-items="ViewBag.EmployeeOptions" class="form-select"><option value="">Chọn nhân viên</option></select><span asp-validation-for="EmployeeId" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Contract.SoHopDong" class="form-label">Số hợp đồng *</label><input asp-for="Contract.SoHopDong" class="form-control" placeholder="HĐ-2026-001" /><span asp-validation-for="Contract.SoHopDong" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="Contract.LoaiHopDong" class="form-label">Loại hợp đồng *</label><select asp-for="Contract.LoaiHopDong" class="form-select"><option value="THU_VIEC">Thử việc</option><option value="XAC_DINH_THOI_HAN_1_NAM">HĐLĐ Xác định thời hạn (1 năm)</option><option value="XAC_DINH_THOI_HAN_3_NAM">HĐLĐ Xác định thời hạn (3 năm)</option><option value="KHONG_XAC_DINH_THOI_HAN">HĐLĐ Không xác định thời hạn</option></select><span asp-validation-for="Contract.LoaiHopDong" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Contract.NgayBatDau" class="form-label">Ngày bắt đầu *</label><input asp-for="Contract.NgayBatDau" type="date" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Contract.NgayKetThuc" class="form-label">Ngày kết thúc</label><input asp-for="Contract.NgayKetThuc" type="date" class="form-control" /><span asp-validation-for="Contract.NgayKetThuc" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Contract.LuongCoBan" class="form-label">Lương cơ bản</label><input asp-for="Contract.LuongCoBan" type="number" min="0" step="1000" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Contract.TrangThai" class="form-label">Trạng thái</label><select asp-for="Contract.TrangThai" class="form-select"><option value="HIEU_LUC">Hiệu lực</option><option value="HET_HAN">Hết hạn</option><option value="DA_CHAM_DUT">Thanh lý</option></select></div>
</div>
