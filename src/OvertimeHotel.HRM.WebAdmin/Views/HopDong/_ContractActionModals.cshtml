@using OvertimeHotel.HRM.Core.Constants
@{
    var promptEmpId = TempData["PromotionPrompt_EmployeeId"]?.ToString();
    var promptContractId = TempData["PromotionPrompt_ContractId"]?.ToString();
    var promptEmpName = TempData["PromotionPrompt_EmployeeName"]?.ToString();
    var promptContractNo = TempData["PromotionPrompt_ContractNo"]?.ToString();
    var promptPosName = TempData["PromotionPrompt_PositionName"]?.ToString();
}
<div class="modal fade" id="terminateContractModal" tabindex="-1" aria-labelledby="terminateContractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 px-4 pt-4 pb-2">
                <h2 class="modal-title h5 font-serif" id="terminateContractModalLabel">Chấm dứt hợp đồng</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form method="post" data-contract-terminate-form>
                @Html.AntiForgeryToken()
                <div class="modal-body px-4 pt-2 pb-4">
                    <div class="alert alert-warning small" role="note" data-terminate-note></div>
                    <div class="bg-light border rounded-3 p-3 d-flex align-items-start gap-3 mb-3">
                        <i class="bi bi-file-earmark-x fs-4 text-danger" aria-hidden="true"></i>
                        <div class="overflow-hidden">
                            <strong class="d-block text-break" data-terminate-number></strong>
                            <span class="d-block small text-secondary text-break" data-terminate-employee></span>
                            <span class="d-block small text-secondary" data-terminate-period></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="terminateDate" class="form-label fw-semibold">Ngày chấm dứt <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="terminateDate" name="NgayChamDut" required />
                        <div class="form-text" data-terminate-date-hint></div>
                    </div>
                    <div class="mb-3">
                        <label for="terminateType" class="form-label fw-semibold">Loại chấm dứt <span class="text-danger">*</span></label>
                        <select class="form-select" id="terminateType" name="LoaiChamDut" required>
                            <option value="">-- Chọn loại --</option>
                            @foreach (var type in ContractTerminationTypes.All)
                            {
                                <option value="@type.Code">@type.Label</option>
                            }
                        </select>
                    </div>
                    <div class="mb-1">
                        <label for="terminateReason" class="form-label fw-semibold">Ghi chú <span class="text-danger d-none" data-terminate-reason-required>*</span></label>
                        <textarea class="form-control" id="terminateReason" name="LyDoChamDut" rows="3" maxlength="500" placeholder="Bắt buộc nếu chọn loại &quot;Khác&quot;"></textarea>
                    </div>
                    <div class="alert alert-danger mt-3 mb-0 d-none" role="alert" data-contract-form-error></div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                        <i class="bi bi-person-x me-1" aria-hidden="true"></i>Xác nhận chấm dứt
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="promotionPromptModal" tabindex="-1" aria-labelledby="promotionPromptModalLabel" aria-hidden="true" data-bs-backdrop="static"
     data-employee-id="@promptEmpId" data-contract-id="@promptContractId">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 bg-primary bg-opacity-10 px-4 pt-4 pb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary text-white p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div>
                        <h2 class="modal-title h5 font-serif text-primary mb-0" id="promotionPromptModalLabel">Đề xuất thăng chức sang IT</h2>
                        <small class="text-muted">Nhân sự vừa được ký hợp đồng cấp Quản lý</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <p class="text-dark mb-2">
                    Đã lập thành công hợp đồng <strong>@promptContractNo</strong> cho nhân sự <strong>@promptEmpName</strong> với chức danh <strong class="text-primary">@promptPosName</strong>.
                </p>
                <div class="bg-light border rounded-3 p-3 mb-3 small text-secondary">
                    <i class="bi bi-info-circle-fill text-info me-1"></i>
                    Nhân sự này hiện đang có tài khoản cấp <strong>Nhân viên (Employee)</strong>. Bạn có muốn gửi yêu cầu nâng quyền <strong>Quản lý (Manager)</strong> sang bộ phận IT ngay bây giờ không?
                </div>
                <div class="alert alert-danger d-none small mb-0" data-prompt-error></div>
            </div>
            <div class="modal-footer bg-light px-4 py-3 justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Để sau</button>
                <button type="button" class="btn btn-hotel-primary rounded-pill px-4 fw-semibold shadow-sm" id="btnSubmitPromotionPrompt">
                    <i class="bi bi-send-fill me-1"></i> Gửi yêu cầu sang IT ngay
                </button>
            </div>
        </div>
    </div>
</div>
