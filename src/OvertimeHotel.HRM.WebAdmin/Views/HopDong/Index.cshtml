@model OvertimeHotel.HRM.WebAdmin.Models.HopDongIndexViewModel
@{
    ViewData["Title"] = "Hợp đồng lao động · The OverTime Hotel";
    Func<int, string> pageUrl = page => Url.Action("Index", new
    {
        keyword = Model.Keyword,
        status = Model.Status,
        contractFilter = Model.ContractFilter,
        page,
        pageSize = Model.PageSize
    }) ?? "#";
    var firstPage = Math.Max(1, Model.PageNumber - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

<div class="catalog-page">
    <partial name="_CatalogAlerts" />

    <!-- 3 MINI KPI SUMMARY STATS -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--allowance shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Tổng hợp đồng</span>
                    <h3 class="catalog-kpi-value">@Model.TotalContracts <small>hợp đồng</small></h3>
                    <p class="catalog-kpi-desc">Tổng số hồ sơ lao động đang lưu trữ</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--bonus shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-file-earmark-check-fill"></i></div>
                <div>
                    <span class="catalog-kpi-label">Đang hiệu lực</span>
                    <h3 class="catalog-kpi-value">@Model.ActiveContracts <small>hợp đồng</small></h3>
                    <p class="catalog-kpi-desc">Đang còn giá trị thực thi theo quy định</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="catalog-kpi-card catalog-kpi-card--deduction shadow-sm">
                <div class="catalog-kpi-icon"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <span class="catalog-kpi-label">Cần theo dõi</span>
                    <h3 class="catalog-kpi-value">@(Model.ExpiringContracts + Model.ExpiredContracts) <small>hợp đồng</small></h3>
                    <p class="catalog-kpi-desc">Sắp hết hạn và đã hết hạn cần xử lý</p>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE WORKSPACE CARD -->
    <section class="catalog-card shadow-sm">
        <div class="catalog-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
            <form method="get" class="catalog-filter-form d-flex flex-wrap gap-2 flex-grow-1 align-items-center">
                <div class="catalog-search-wrapper" style="min-width: 240px; flex: 2;">
                    <i class="bi bi-search catalog-search-icon" aria-hidden="true"></i>
                    <input name="keyword" value="@Model.Keyword" class="form-control catalog-search" placeholder="Số hợp đồng, loại hoặc tên nhân viên..." aria-label="Tìm kiếm hợp đồng" />
                    <kbd class="catalog-search-shortcut" title="Phím tắt tìm kiếm">Ctrl K</kbd>
                </div>

                <div style="min-width: 150px; flex: 1;">
                    <select name="status" class="form-select">
                        <option value="">-- Trạng thái lưu --</option>
                        <option value="HIEU_LUC" selected="@(Model.Status == "HIEU_LUC")">Hiệu lực</option>
                        <option value="HET_HAN" selected="@(Model.Status == "HET_HAN")">Hết hạn</option>
                        <option value="DA_CHAM_DUT" selected="@(Model.Status == "DA_CHAM_DUT")">Thanh lý</option>
                    </select>
                </div>

                <div style="min-width: 170px; flex: 1;">
                    <select name="contractFilter" class="form-select">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(Model.ContractFilter))">-- Đang hiệu lực (Ẩn hết hạn) --</option>
                        <option value="DA_HET_HAN" selected="@(Model.ContractFilter == "DA_HET_HAN")">Đã hết hạn</option>
                        <option value="SAP_HET_HAN" selected="@(Model.ContractFilter == "SAP_HET_HAN")">Sắp hết hạn (&le; 30 ngày)</option>
                        <option value="HIEU_LUC" selected="@(Model.ContractFilter == "HIEU_LUC")">Còn hiệu lực</option>
                        <option value="TAT_CA" selected="@(Model.ContractFilter == "TAT_CA")">Tất cả hợp đồng</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-hotel-primary text-nowrap"><i class="bi bi-search me-1"></i>Lọc HĐ</button>
                @if (!string.IsNullOrWhiteSpace(Model.Keyword) || !string.IsNullOrWhiteSpace(Model.Status) || !string.IsNullOrWhiteSpace(Model.ContractFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                }
            </form>

            <div class="catalog-toolbar-actions d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-hotel-primary rounded-3 px-3 fw-semibold catalog-action-btn" data-bs-toggle="modal" data-bs-target="#createContractModal">
                    <i class="bi bi-plus-lg me-1"></i> Lập hợp đồng mới
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-export="HopDong" title="Xuất danh sách ra file CSV mở bằng Excel">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Xuất CSV
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 fw-semibold catalog-action-btn" data-catalog-print title="In danh sách hợp đồng chuẩn A4">
                    <i class="bi bi-printer text-primary me-1"></i> In danh sách
                </button>
                <span class="catalog-badge" data-catalog-count>
                    <i class="bi bi-file-earmark-text-fill me-1"></i> @Model.TotalFilteredContracts hợp đồng
                </span>
            </div>
        </div>

        <!-- CONTRACT DATA TABLE & IN-PLACE PAGINATION PARTIAL -->
        <partial name="_ContractTablePartial" model="Model" />
    </section>
</div>

<!-- MODAL LẬP HỢP ĐỒNG MỚI -->
<div class="modal fade" id="createContractModal" tabindex="-1" aria-labelledby="createContractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-white border-bottom py-3 px-4">
                <div>
                    <div class="text-uppercase small text-success fw-bold">Hồ sơ pháp lý lao động</div>
                    <h2 class="modal-title h5 mb-0 font-serif" id="createContractModalLabel">Lập Hợp Đồng Lao Động Mới</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form asp-action="Create" method="post" class="d-flex flex-column overflow-hidden">
                @Html.AntiForgeryToken()
                <div class="modal-body overflow-auto p-4">
                    <partial name="_Form" model="Model.CreateContractForm" />
                </div>
                <div class="modal-footer flex-shrink-0 bg-light border-top py-3 px-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i>Lưu hợp đồng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // =========================================================================
    // ZERO FULL-PAGE RELOAD IN-PLACE PAGINATION & FILTERING (TARGETED ISOLATION)
    // =========================================================================
    function loadContractTable(params = {}, shouldPushState = true) {
        const container = document.getElementById('contractTableContainer');
        if (!container) return;

        const url = new URL(window.location.href);
        const form = document.querySelector('.catalog-toolbar form[method="get"]');
        if (form) {
            const formData = new FormData(form);
            for (const [key, val] of formData.entries()) {
                const trimmed = (val || '').toString().trim();
                if (trimmed) {
                    url.searchParams.set(key, trimmed);
                } else {
                    url.searchParams.delete(key);
                }
            }
        }

        for (const [k, v] of Object.entries(params)) {
            if (v !== null && v !== undefined && v !== '') {
                url.searchParams.set(k, v);
            } else {
                url.searchParams.delete(k);
            }
        }

        container.style.transition = 'opacity 0.2s ease';
        container.style.opacity = '0.45';
        container.style.pointerEvents = 'none';

        const fetchUrl = new URL(url.toString());
        fetchUrl.searchParams.set('isPartial', 'true');

        fetch(fetchUrl.toString(), {
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'text/html'
            }
        })
        .then(res => {
            if (!res.ok) throw new Error('Lỗi cập nhật danh sách hợp đồng (Mã lỗi ' + res.status + ')');
            return res.text();
        })
        .then(html => {
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;
            const newContainer = tempDiv.querySelector('#contractTableContainer') || tempDiv.firstElementChild;
            if (newContainer && container) {
                container.outerHTML = newContainer.outerHTML;
            }

            if (shouldPushState) {
                window.history.pushState({ path: url.toString() }, '', url.toString());
            }

            const toolbarCount = document.querySelector('.catalog-toolbar [data-catalog-count]');
            const newBadge = document.querySelector('#contractTableContainer [data-catalog-count]');
            if (toolbarCount && newBadge) {
                toolbarCount.innerHTML = newBadge.innerHTML;
            }

            if (window.HotelMotion && window.HotelMotion.applyEntrance) {
                const updatedContainer = document.getElementById('contractTableContainer');
                if (updatedContainer) window.HotelMotion.applyEntrance(updatedContainer);
            }
        })
        .catch(err => {
            console.error('Lỗi nạp bảng hợp đồng:', err);
            const currentContainer = document.getElementById('contractTableContainer');
            if (currentContainer) {
                currentContainer.style.opacity = '1';
                currentContainer.style.pointerEvents = 'auto';
            }
        });
    }

    function goToContractPage(page, event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }
        loadContractTable({ page: page });
    }

    function changeContractPageSize(pageSize) {
        loadContractTable({ page: 1, pageSize: pageSize });
    }

    function resetContractFilters() {
        const form = document.querySelector('.catalog-toolbar form[method="get"]');
        if (form) {
            form.reset();
            form.querySelectorAll('input, select').forEach(c => c.value = '');
        }
        loadContractTable({ keyword: '', status: '', contractFilter: '', page: 1 });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const form = document.querySelector('.catalog-toolbar form[method="get"]');
        if (form) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                loadContractTable({ page: 1 });
            });
        }

        window.addEventListener('popstate', () => {
            loadContractTable({}, false);
        });
    });

    function openRenewContractModal(maNhanVien, tenNhanVien, loaiHopDongCu, luongCoBanCu, ngayKetThucCu) {
        const modalEl = document.getElementById('createContractModal');
        if (!modalEl) return;

        // 1. Cập nhật tiêu đề modal
        const titleEl = document.getElementById('createContractModalLabel');
        if (titleEl) {
            titleEl.innerHTML = `<span class="text-primary">Gia Hạn Hợp Đồng:</span> ${tenNhanVien}`;
        }

        // 2. Chọn sẵn nhân viên trong select
        const empSelect = modalEl.querySelector('select[name="EmployeeId"]') || modalEl.querySelector('#EmployeeId');
        if (empSelect) {
            empSelect.value = maNhanVien;
        }

        // 3. Chọn loại hợp đồng cũ nếu khớp
        const loaiHdSelect = modalEl.querySelector('select[name="Contract.LoaiHopDong"]') || modalEl.querySelector('#Contract_LoaiHopDong');
        if (loaiHdSelect && loaiHopDongCu) {
            for (let i = 0; i < loaiHdSelect.options.length; i++) {
                if (loaiHdSelect.options[i].value === loaiHopDongCu || loaiHdSelect.options[i].text.includes(loaiHopDongCu)) {
                    loaiHdSelect.selectedIndex = i;
                    break;
                }
            }
        }

        // 4. Tự động đề xuất ngày bắt đầu mới = ngày kết thúc cũ + 1 ngày
        const startInput = modalEl.querySelector('input[name="Contract.NgayBatDau"]') || modalEl.querySelector('#Contract_NgayBatDau');
        if (startInput && ngayKetThucCu) {
            const oldEnd = new Date(ngayKetThucCu);
            oldEnd.setDate(oldEnd.getDate() + 1);
            startInput.value = oldEnd.toISOString().split('T')[0];
        }

        // 5. Điền sẵn mức lương cơ bản
        const salaryInput = modalEl.querySelector('input[name="Contract.LuongCoBan"]') || modalEl.querySelector('#Contract_LuongCoBan');
        if (salaryInput && luongCoBanCu) {
            salaryInput.value = luongCoBanCu;
        }

        // 6. Đổi text nút Submit thành "Lưu gia hạn hợp đồng"
        const submitBtn = modalEl.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Lưu gia hạn hợp đồng';
        }

        // 7. Mở Modal
        const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        bsModal.show();
    }

    // Khôi phục lại trạng thái modal ban đầu khi đóng
    document.getElementById('createContractModal')?.addEventListener('hidden.bs.modal', function () {
        const titleEl = document.getElementById('createContractModalLabel');
        if (titleEl) titleEl.innerText = 'Lập Hợp Đồng Lao Động Mới';
        const submitBtn = this.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.innerHTML = '<i class="bi bi-check2 me-1"></i>Lưu hợp đồng';
        this.querySelector('form')?.reset();
    });
</script>
}


