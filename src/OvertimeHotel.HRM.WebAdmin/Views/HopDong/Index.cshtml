@model OvertimeHotel.HRM.WebAdmin.Models.HopDongIndexViewModel
@{
    ViewData["Title"] = "Quản lý hợp đồng lao động";
}
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><div class="text-uppercase small text-primary fw-bold">TSK-15 · Hợp đồng</div><h1 class="h2 fw-bold mb-1">Hợp đồng lao động</h1><p class="text-muted mb-0">Lập, cập nhật và theo dõi thời hạn hợp đồng theo từng nhân viên.</p></div><button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createContractModal"><i class="bi bi-file-earmark-plus me-1"></i>Lập hợp đồng</button></div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    <div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Tổng hợp đồng</div><div class="fs-3 fw-bold">@Model.TotalContracts</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Đang hiệu lực</div><div class="fs-3 fw-bold text-success">@Model.ActiveContracts</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Sắp hết hạn</div><div class="fs-3 fw-bold text-warning">@Model.ExpiringContracts</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-muted small">Đã hết hạn</div><div class="fs-3 fw-bold text-danger">@Model.ExpiredContracts</div></div></div></div></div>
    <div class="card border-0 shadow-sm mb-4"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-lg-5"><label class="form-label small fw-semibold">Tìm kiếm</label><input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Số hợp đồng, loại hoặc tên nhân viên" /></div><div class="col-md-4 col-lg-2"><label class="form-label small fw-semibold">Trạng thái lưu</label><select name="status" class="form-select"><option value="">Tất cả</option><option value="HIEU_LUC" selected="@(Model.Status == "HIEU_LUC")">Hiệu lực</option><option value="HET_HAN" selected="@(Model.Status == "HET_HAN")">Hết hạn</option><option value="THANH_LY" selected="@(Model.Status == "THANH_LY")">Thanh lý</option></select></div><div class="col-md-4 col-lg-3"><label class="form-label small fw-semibold">Theo dõi thời hạn</label><select name="contractFilter" class="form-select"><option value="">Tất cả</option><option value="HIEU_LUC" selected="@(Model.ContractFilter == "HIEU_LUC")">Còn hiệu lực</option><option value="SAP_HET_HAN" selected="@(Model.ContractFilter == "SAP_HET_HAN")">Sắp hết hạn</option><option value="DA_HET_HAN" selected="@(Model.ContractFilter == "DA_HET_HAN")">Đã hết hạn</option></select></div><div class="col-md-2 col-lg-1"><button class="btn btn-primary w-100" title="Lọc"><i class="bi bi-funnel"></i></button></div><div class="col-md-2 col-lg-1"><a asp-action="Index" class="btn btn-outline-secondary w-100" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a></div></form></div></div>
    <div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Số hợp đồng</th><th>Nhân viên</th><th>Loại</th><th>Thời hạn</th><th>Lương cơ bản</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @foreach (var item in Model.Contracts)
    {
        var badge = item.State == "DA_HET_HAN" ? "danger" : item.State == "SAP_HET_HAN" ? "warning" : item.State == "HIEU_LUC" ? "success" : "secondary";
        <tr><td class="fw-semibold">@item.Contract.SoHopDong</td><td>@item.EmployeeName</td><td>@item.Contract.LoaiHopDong</td><td><div>@item.Contract.NgayBatDau.ToString("dd/MM/yyyy") - @(item.Contract.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "Không thời hạn")</div>@if (item.DaysRemaining.HasValue) { <span class="badge text-bg-@badge">@(item.DaysRemaining < 0 ? $"Quá hạn {-item.DaysRemaining} ngày" : item.DaysRemaining == 0 ? "Hết hạn hôm nay" : $"Còn {item.DaysRemaining} ngày")</span> }</td><td>@item.Contract.LuongCoBan.ToString("N0") đ</td><td><span class="badge text-bg-@badge">@item.Contract.TrangThai</span></td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@item.Contract.MaHopDong" class="btn btn-sm btn-outline-primary" title="Sửa"><i class="bi bi-pencil"></i></a><form asp-action="Delete" asp-route-id="@item.Contract.MaHopDong" method="post" class="d-inline" onsubmit="return confirm('Xóa hợp đồng này?');"><button class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button></form></td></tr>
    }
    @if (Model.Contracts.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-5">Không tìm thấy hợp đồng phù hợp.</td></tr> }
    </tbody></table></div></div>
</div>

<div class="modal fade" id="createContractModal" tabindex="-1" aria-labelledby="createContractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><div><div class="text-uppercase small text-success fw-bold">Hồ sơ lao động</div><h2 class="modal-title h5 mb-0" id="createContractModalLabel">Lập hợp đồng lao động</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <form asp-action="Create" method="post" class="d-flex flex-column overflow-hidden">
                <div class="modal-body overflow-auto"><partial name="_Form" model="Model.CreateContractForm" /></div>
                <div class="modal-footer flex-shrink-0 bg-white"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Hủy</button><button type="submit" class="btn btn-success"><i class="bi bi-check2 me-1"></i>Lưu hợp đồng</button></div>
            </form>
        </div>
    </div>
</div>
