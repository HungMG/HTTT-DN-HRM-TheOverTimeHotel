@model Dictionary<string, int>
@{
    ViewData["Title"] = "An Toàn Dữ Liệu & Sao Lưu CSDL (30+ Bảng 3NF)";
    var totalTables = ViewBag.TotalTables as int? ?? Model?.Count ?? 0;
    var totalRecords = ViewBag.TotalRecords as int? ?? Model?.Values.Sum() ?? 0;
}

<div class="container-fluid py-4">
    <!-- Header Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge rounded-pill bg-dark text-warning px-3 py-1.5 fw-semibold">
                    <i class="bi bi-shield-check text-warning me-1"></i>HẠ TẦNG AN NINH DỮ LIỆU
                </span>
                <span class="badge rounded-pill bg-primary text-white px-2.5 py-1">
                    <i class="bi bi-database me-1"></i>Supabase Cloud 3NF (@totalTables Bảng)
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-0 font-serif" style="font-size: var(--page-title-size);">
                Sao Lưu &amp; Phục Hồi Cơ Sở Dữ Liệu Khách Sạn
            </h2>
            <p class="text-muted small mb-0">
                Trích xuất toàn diện snapshot 30+ bảng dữ liệu quan hệ, giám sát tính toàn vẹn và khôi phục khi có sự cố
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Export" class="btn btn-success rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                <i class="bi bi-cloud-arrow-down-fill me-1.5"></i>Tải Snapshot JSON (@totalTables Bảng)
            </a>
            <button type="button" class="btn btn-outline-warning text-dark rounded-pill px-3 py-2.5 fw-semibold shadow-xs" data-bs-toggle="modal" data-bs-target="#restoreModal">
                <i class="bi bi-arrow-counterclockwise text-danger me-1.5"></i>Nạp &amp; Khôi Phục File
            </button>
            <a asp-action="Index" asp-route-refresh="true" class="btn btn-outline-secondary rounded-pill px-3 py-2.5 fw-semibold shadow-xs" title="Xóa cache và lấy số liệu thời gian thực">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </a>
            <a href="@ViewBag.SupabaseProjectUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary rounded-pill px-3 py-2.5 fw-semibold shadow-xs">
                <i class="bi bi-box-arrow-up-right me-1"></i>Supabase Studio
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                <div>
                    <h6 class="fw-bold mb-0">Thao tác thành công!</h6>
                    <span class="small">@TempData["Success"]</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                <div>
                    <h6 class="fw-bold mb-0">Lỗi sao lưu / khôi phục!</h6>
                    <span class="small">@TempData["Error"]</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (ViewBag.DbWarning != null)
    {
        <div class="alert alert-warning alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-info-circle-fill text-warning fs-4 me-3"></i>
                <div>
                    <h6 class="fw-bold mb-0">Lưu ý kết nối</h6>
                    <span class="small">@ViewBag.DbWarning</span>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 3 Thẻ KPI tổng quan -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: .5px;">Tổng số bảng hệ thống</span>
                        <h3 class="fw-bold text-primary mb-0 mt-1 tabular-nums">@totalTables <span class="fs-6 text-muted fw-normal">bảng chuẩn 3NF</span></h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(30, 58, 138, 0.1); color: #1e3a8a;">
                        <i class="bi bi-grid-3x3-gap-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: .5px;">Tổng số bản ghi thực tế</span>
                        <h3 class="fw-bold text-success mb-0 mt-1 tabular-nums">@totalRecords.ToString("N0") <span class="fs-6 text-muted fw-normal">dòng dữ liệu</span></h3>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="bi bi-layers-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: .5px;">Cụm máy chủ CSDL</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">Singapore <span class="badge bg-success-subtle text-success border border-success-subtle fs-7">Active</span></h4>
                        <span class="small text-muted" style="font-size: .75rem;">ap-southeast-1 · Port 6543 SSL</span>
                    </div>
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background: rgba(212, 175, 55, 0.15); color: #b8860b;">
                        <i class="bi bi-hdd-network-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2 Khối hướng dẫn sao lưu & khôi phục -->
    <div class="row g-4 mb-4">
        <!-- Card 1: Cơ chế sao lưu tự động Supabase -->
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                    <span class="card-title mb-0 fw-bold text-dark fs-6">
                        <i class="bi bi-cloud-check text-primary me-2"></i>1. Sao Lưu Đám Mây Tự Động (Supabase Cloud)
                    </span>
                </div>
                <div class="card-body p-4">
                    <p class="card-text text-muted small">
                        Hệ thống CSDL được lưu trữ trực tuyến trên nền tảng đám mây Supabase PostgreSQL tại cụm máy chủ <strong>Singapore (ap-southeast-1)</strong>, đáp ứng tiêu chuẩn an toàn dữ liệu khách sạn quốc tế:
                    </p>
                    <ul class="list-group list-group-flush mb-3 small">
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-clock-history text-primary me-2"></i>Tự động sao lưu hàng ngày (Daily Backups):</span>
                            <span class="badge bg-success">Đang hoạt động</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-hdd-network text-info me-2"></i>Database Pooler Host:</span>
                            <code>@ViewBag.DbHost</code>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-shield-lock text-warning me-2"></i>Mã hóa kết nối (SSL/TLS Required):</span>
                            <span class="badge bg-primary">SSL Mode Enforced</span>
                        </li>
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-arrow-counterclockwise text-danger me-2"></i>Khôi phục vật lý (Physical Restore):</span>
                            <span class="text-muted">Hỗ trợ 1-click trong 90 ngày</span>
                        </li>
                    </ul>
                    <small class="text-muted fst-italic">
                        * Quản trị viên có thể tải toàn bộ file Dump dữ liệu trực tiếp từ Supabase Studio mục <em>Database -> Backups</em>.
                    </small>
                </div>
            </div>
        </div>

        <!-- Card 2: Sao lưu & Khôi phục thủ công qua Web Admin -->
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-bottom py-3 px-4 rounded-top-4">
                    <span class="card-title mb-0 fw-bold text-dark fs-6">
                        <i class="bi bi-file-earmark-arrow-up text-success me-2"></i>2. Trích Xuất Snapshot &amp; Phục Hồi Nhanh
                    </span>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <p class="card-text text-muted small mb-3">
                            Tính năng cho phép bộ phận CNTT và Quản trị viên trích xuất toàn bộ dữ liệu <strong>30+ bảng chuẩn 3NF</strong> dạng <strong>JSON Snapshot</strong> để lưu trữ cục bộ, kiểm toán an ninh hoặc di chuyển hệ thống:
                        </p>
                        <div class="d-grid mb-3">
                            <a asp-action="Export" class="btn btn-outline-success btn-lg rounded-pill fw-semibold py-2.5">
                                <i class="bi bi-download me-2"></i>Tải Snapshot Toàn Bộ CSDL (.JSON)
                            </a>
                        </div>
                        <div class="alert alert-light border rounded-3 p-3 mb-0 small text-muted">
                            <div class="d-flex align-items-center gap-2 mb-1 text-dark fw-semibold">
                                <i class="bi bi-info-circle text-primary"></i>Quy trình Khôi Phục 7 Bước An Toàn (FK Order):
                            </div>
                            <span>Phục hồi tự động theo đúng thứ tự phụ thuộc khóa ngoại từ Danh mục độc lập ➔ Chức vụ ➔ Nhân sự ➔ Hợp đồng &amp; Phân ca ➔ Chấm công ➔ Lương bổng &amp; Nhật ký kiểm toán.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng thống kê chi tiết toàn bộ các bảng CSDL -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white py-3 px-4 border-bottom rounded-top-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="card-title mb-0 fw-bold text-dark fs-6">
                        <i class="bi bi-table text-primary me-2"></i>Thống Kê Hiện Trạng Dữ Liệu (@totalTables Bảng CSDL)
                    </h5>
                    <span class="badge bg-secondary-subtle text-secondary border">Thời gian thực</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="width: 250px;">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" id="filterTableInput" class="form-control border-start-0" placeholder="Lọc theo tên bảng..." />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle" id="backupTablesList">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">STT</th>
                            <th>Tên Bảng CSDL (Mục Đích &amp; Nghiệp Vụ)</th>
                            <th class="text-end pe-4" style="width: 200px;">Số Lượng Bản Ghi</th>
                            <th class="text-center" style="width: 160px;">Trạng Thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            var idx = 1;
                            foreach (var item in Model)
                            {
                                <tr class="table-row-item">
                                    <td class="ps-4 fw-semibold text-muted tabular-nums">@idx</td>
                                    <td>
                                        <code class="text-primary fw-semibold fs-7">@item.Key</code>
                                    </td>
                                    <td class="text-end pe-4 fw-bold tabular-nums">@item.Value.ToString("N0")</td>
                                    <td class="text-center">
                                        @if (item.Value > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5">Có dữ liệu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-muted border border-secondary-subtle rounded-pill px-2.5">Trống</span>
                                        }
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <em>Chưa có dữ liệu thống kê bảng hoặc chưa kết nối trực tiếp đến PostgreSQL.</em>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Khôi Phục Dữ Liệu An Toàn -->
<div class="modal fade" id="restoreModal" tabindex="-1" aria-labelledby="restoreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <form asp-action="Restore" method="post" enctype="multipart/form-data" id="restoreForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white rounded-top-4 px-4 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-exclamation text-warning fs-4"></i>
                        <h5 class="modal-title fw-bold text-white fs-6 mb-0" id="restoreModalLabel">
                            Khôi Phục Cơ Sở Dữ Liệu Từ File Snapshot
                        </h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-warning border-0 rounded-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Cảnh báo an toàn dữ liệu:</strong>
                        Quá trình khôi phục sẽ nạp lại các bản ghi từ file JSON. Các bản ghi trùng khoá chính sẽ được giữ nguyên, các bản ghi còn thiếu sẽ được bù đắp vào hệ thống.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">Chọn file sao lưu (.JSON) <span class="text-danger">*</span></label>
                        <input type="file" name="backupFile" class="form-control" accept=".json" required id="backupFileInput" />
                        <div class="form-text small">Chỉ chọn file <code>.json</code> được xuất từ hệ thống The OverTime Hotel HRM.</div>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="confirmCheckbox" required />
                        <label class="form-check-label small text-muted" for="confirmCheckbox">
                            Tôi xác nhận file sao lưu này an toàn và muốn tiến hành khôi phục vào CSDL Supabase.
                        </label>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4 px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold" id="btnSubmitRestore">
                        <i class="bi bi-arrow-repeat me-1"></i>Tiến Hành Khôi Phục
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lọc danh sách bảng CSDL theo từ khóa
        document.getElementById('filterTableInput')?.addEventListener('input', function () {
            var filter = this.value.toLowerCase().trim();
            var rows = document.querySelectorAll('#backupTablesList tbody tr.table-row-item');
            rows.forEach(function (row) {
                var text = row.innerText.toLowerCase();
                row.style.display = text.indexOf(filter) > -1 ? '' : 'none';
            });
        });

        // Xác nhận checkbox trước khi submit
        document.getElementById('restoreForm')?.addEventListener('submit', function (e) {
            var check = document.getElementById('confirmCheckbox');
            if (!check.checked) {
                e.preventDefault();
                alert('Vui lòng tích chọn xác nhận trước khi tiến hành khôi phục.');
                return false;
            }
            var btn = document.getElementById('btnSubmitRestore');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang khôi phục...';
        });
    </script>
}
