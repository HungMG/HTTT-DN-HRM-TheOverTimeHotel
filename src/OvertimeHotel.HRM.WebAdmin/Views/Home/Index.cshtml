@model OvertimeHotel.HRM.WebAdmin.Models.HomeDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";

    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Quý khách";

    var tyLeDungGio = Model.BanGhiChamCongHomNay > 0
        ? Math.Round((decimal)Model.ChamCongDungGioHomNay / Model.BanGhiChamCongHomNay * 100, 1)
        : 0m;
    var chuyenDongNhanSu = Model.NhanVienDangLam - Model.NhanVienKyTruoc;
}

<!-- Bảng điều khiển chỉ dành cho tài khoản đã đăng nhập. HomeController đã gắn
     [Authorize] nên khách cookie trống bị chuyển thẳng sang /Account/Login. -->
<!-- ═══ CHÀO MỪNG ═══════════════════════════════════════════════════ -->
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h2 class="page-greeting mb-1">Xin chào, @fullName</h2>

            <p class="text-muted mb-0">
                Vai trò <strong>@role</strong> · Cập nhật lúc
                <span>@Model.GeneratedAt.ToLocalTime().ToString("HH:mm dd/MM/yyyy")</span>
            </p>
        </div>
        @if (Model.IsDatabaseOnline)
        {
            <span class="badge rounded-pill bg-success-subtle text-success border px-3 py-2">
                <i class="bi bi-database-check me-1"></i> Supabase Online
            </span>
        }
        else
        {
            <span class="badge rounded-pill bg-danger-subtle text-danger border px-3 py-2">
                <i class="bi bi-database-x me-1"></i> CSDL không phản hồi
            </span>
        }
    </div>

    <!-- ═══ CHỈ SỐ ĐIỀU HÀNH ═══════════════════════════════════════════ -->
    <h3 class="page-section-title">Chỉ số điều hành</h3>
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <a class="stat-card" asp-controller="NhanVien" asp-action="Index">
                <div>
                    <div class="stat-label">Nhân sự đang làm</div>
                    <div class="stat-figure">
                        @Model.NhanVienDangLam<span class="stat-figure-unit">người</span>
                    </div>
                </div>
                <div class="stat-meta">
                    @if (Model.NhanVienKyTruoc > 0)
                    {
                        <span class="@(chuyenDongNhanSu >= 0 ? "stat-delta-up" : "stat-delta-down")">
                            <i class="bi bi-arrow-@(chuyenDongNhanSu >= 0 ? "up" : "down") me-1"></i>
                            @Math.Abs(chuyenDongNhanSu) so với kỳ trước
                        </span>
                    }
                    else
                    {
                        <span>Chưa có dữ liệu kỳ trước</span>
                    }
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Đúng giờ hôm nay</div>
                    <div class="stat-figure">@tyLeDungGio<span class="stat-figure-unit">%</span></div>
                </div>
                <div class="stat-meta">
                    @Model.ChamCongDungGioHomNay / @Model.BanGhiChamCongHomNay lượt quẹt thẻ
                    @if (Model.ChamCongDiTreHomNay > 0)
                    {
                        <span class="stat-delta-down ms-1">· @Model.ChamCongDiTreHomNay trễ/về sớm</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <a class="stat-card" asp-controller="DonTu" asp-action="Index">
                <div>
                    <div class="stat-label">Đơn từ chờ duyệt</div>
                    <div class="stat-figure">@Model.DonTuChoDuyet<span class="stat-figure-unit">đơn</span></div>
                </div>
                <div class="stat-meta">
                    @if (Model.DonTuChoDuyet > 0)
                    {
                        <span class="stat-delta-down">Cần bạn phê duyệt</span>
                    }
                    else
                    {
                        <span class="stat-delta-up">Đã xử lý hết</span>
                    }
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Quỹ lương @Model.KyLuongHienTai</div>
                    <div class="stat-figure">@Model.QuyLuongKyHienTai.ToString("N0")<span class="stat-figure-unit">đ</span></div>
                </div>
                <div class="stat-meta">
                    @Model.SoPhieuLuongDaDuyet / @Model.SoPhieuLuongKyHienTai phiếu đã duyệt
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ CẦN BẠN XỬ LÝ ═════════════════════════════════════════════ -->
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h3 class="page-section-title mb-0">Cần bạn xử lý</h3>
        @if (Model.ChoXuLy.Count > 0)
        {
            <span class="badge rounded-pill bg-danger text-white">@Model.ChoXuLy.Count việc</span>
        }
    </div>

    <div class="queue-card mb-4">
        @if (Model.ChoXuLy.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-check-circle-fill"></i>
                <p class="empty-state-title">Không có việc chờ xử lý</p>
                <p class="mb-0 small">Toàn bộ đơn từ và hợp đồng đều đã được xử lý.</p>
            </div>
        }
        else
        {
            foreach (var item in Model.ChoXuLy)
            {
                <div class="queue-row">
                    <span class="queue-dot queue-dot-@item.Severity"></span>
                    <div class="queue-main">
                        <p class="queue-title">
                            @item.Title
                            <span class="badge rounded-pill bg-light text-secondary border ms-1">@item.CategoryLabel</span>
                        </p>
                        <p class="queue-sub">@item.Subtitle</p>
                    </div>
                    <div class="queue-actions">
                        @if (item.ActionUrl is not null)
                        {
                            <a class="btn btn-sm btn-outline-primary rounded-pill fw-semibold" href="@item.ActionUrl">
                                Xem
                            </a>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-light text-dark border">@item.Category</span>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <!-- ═══ ĐỘI HÌNH CA TRỰC ═══════════════════════════════════════════ -->
    <h3 class="page-section-title">Đội hình ca trực hôm nay · Đang là Ca @Model.CaDangChay</h3>
    <div class="row g-3 mb-4">
        @if (Model.CaTrucHomNay.Count == 0)
        {
            <div class="col-12">
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p class="empty-state-title">Hôm nay chưa có ca nào được xếp</p>
                    <p class="mb-0 small">Hãy mở ma trận phân ca để bố trí nhân sự.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var ca in Model.CaTrucHomNay)
            {
                <div class="col-sm-4">
                    <div class="stat-card">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="stat-label">@ca.TenCa</span>
                                @if (ca.IsCurrent)
                                {
                                    <span class="badge rounded-pill bg-warning text-dark">Đang trực</span>
                                }
                            </div>
                            <div class="stat-figure">
                                @ca.DaCheckIn<span style="color: #cbd5e1;">/</span>@ca.TongSo
                            </div>
                            <div class="shift-progress">
                                <div class="shift-progress-bar"
                                     style="width: @(ca.TongSo > 0 ? (decimal)ca.DaCheckIn / ca.TongSo * 100 : 0)%"></div>
                            </div>
                        </div>
                        <div class="stat-meta">@ca.Gio</div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- ═══ PHÂN HỆ ĐANG MỞ RỘNG ═══════════════════════════════════════ -->
    <h3 class="page-section-title">Phân hệ đang mở rộng</h3>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Chấm công quẹt thẻ</div>
                    <p class="queue-sub mt-2 mb-0">
                        Kiểm toán vị trí GPS và Wi-Fi đã chạy trên ứng dụng di động.
                        Màn hình tra cứu trên web đang được phát triển.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Phiếu lương &amp; báo cáo</div>
                    <p class="queue-sub mt-2 mb-0">
                        Công thức lương hai tầng Gross → Net đã hoàn thiện.
                        Xuất phiếu lương PDF bằng QuestPDF đang được phát triển.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Nhật ký quản trị</div>
                    <p class="queue-sub mt-2 mb-0">
                        Bảng kiểm toán đã ghi nhận thao tác của quản trị viên.
                        Màn hình tra cứu đang được phát triển.
                    </p>
                </div>
            </div>
        </div>
    </div>
