@model OvertimeHotel.HRM.WebAdmin.Models.HomeDashboardViewModel
@{
    ViewData["Title"] = "Trung Tâm Quản Trị";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Quý khách";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
    var isAdmin = role == "Admin";
    var isHR = role == "HR";
}

<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/accounts.css" asp-append-version="true" />

<style>
    :root {
        --dash-navy: #0F172A;
        --dash-navy-mid: #1E293B;
        --dash-navy-card: #1E3A8A;
        --dash-gold: #D4AF37;
        --dash-gold-light: #FDE047;
    }

    .hero-luxury-banner {
        background: radial-gradient(circle at 15% 20%, rgba(37, 99, 235, 0.4) 0%, transparent 50%),
                    radial-gradient(circle at 85% 80%, rgba(212, 175, 55, 0.2) 0%, transparent 45%),
                    linear-gradient(135deg, #090E1A 0%, #172554 50%, #0F172A 100%);
        border: 1px solid rgba(212, 175, 55, 0.3) !important;
        position: relative;
        overflow: hidden;
        box-shadow: 0 16px 36px -8px rgba(15, 23, 42, 0.35);
    }

    .hero-luxury-banner::before {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: radial-gradient(rgba(212, 175, 55, 0.08) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
        opacity: 0.5;
    }

    /* BENTO KPI CARDS */
    .kpi-link-card {
        text-decoration: none;
        display: block;
        height: 100%;
    }

    .kpi-card {
        background: #FFFFFF;
        border-radius: 18px;
        padding: 20px 22px;
        border: 1px solid #E2E8F0;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }

    .kpi-link-card:hover .kpi-card {
        transform: translateY(-4px);
        border-color: #3B82F6;
        box-shadow: 0 14px 26px -6px rgba(37, 99, 235, 0.15);
    }

    .kpi-card::after {
        content: "";
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: linear-gradient(90deg, #3B82F6, #D4AF37);
        opacity: 0;
        transition: opacity 0.25s ease;
    }

    .kpi-link-card:hover .kpi-card::after {
        opacity: 1;
    }

    .kpi-icon-wrapper {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    /* TIER CARD HIERARCHY */
    .tier-section-card {
        background: #FFFFFF;
        border: 1.5px solid #E2E8F0;
        border-radius: 20px;
        overflow: hidden;
        margin-bottom: 24px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
        transition: all 0.28s ease;
    }

    .tier-section-card--admin {
        border-color: rgba(220, 38, 38, 0.4);
        background: linear-gradient(180deg, #FFFFFF 0%, #FEF2F2 100%);
    }

    .tier-header {
        padding: 20px 24px;
        background: #FFFFFF;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        user-select: none;
        border-bottom: 1px solid #F1F5F9;
        transition: background 0.2s ease;
    }

    .tier-header:hover {
        background: #F8FAFC;
    }

    .tier-toggle-pill {
        background: #F1F5F9;
        color: #334155;
        border: 1px solid #E2E8F0;
        border-radius: 999px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    .tier-header:hover .tier-toggle-pill {
        background: #E2E8F0;
        color: #0F172A;
    }

    .chevron-icon {
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        font-size: 0.85rem;
    }

    .tier-header[aria-expanded="true"] .chevron-icon {
        transform: rotate(180deg);
    }

    .tier-body {
        padding: 24px;
    }

    /* SUB-TILES */
    .feature-tile {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        padding: 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.22s ease;
    }

    .feature-tile:hover {
        border-color: #93C5FD;
        transform: translateY(-3px);
        box-shadow: 0 10px 22px -4px rgba(15, 23, 42, 0.08);
    }

    .feature-tile-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .shift-timeline-item {
        padding: 12px 14px;
        border-radius: 12px;
        margin-bottom: 8px;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        transition: all 0.25s ease;
    }

    .shift-timeline-item.active {
        background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
        border-color: #3B82F6;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.15);
    }
</style>

<div class="container-fluid py-3">
    <!-- HERO EXECUTIVE BANNER -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white hero-luxury-banner">
        <div class="card-body p-4 p-lg-5 position-relative" style="z-index: 2;">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-stars me-1"></i> THE OVERTIME HOTEL 5★
                        </span>
                        <span class="live-clock-pill text-white d-inline-flex align-items-center gap-2">
                            <span class="shift-indicator-dot shift-dot-active"></span>
                            <span id="liveClockText">Đang tải đồng hồ...</span>
                        </span>
                        @if (Model.IsDatabaseOnline)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                <i class="bi bi-database-check me-1"></i> Supabase Cloud Online
                            </span>
                        }
                    </div>

                    <h1 class="display-6 fw-bold mb-2 font-serif text-white">
                        Trung Tâm Quản Trị Khách Sạn
                    </h1>

                    <p class="text-white-50 fs-6 mb-3" style="max-width: 680px; line-height: 1.6;">
                        Xin chào, <strong class="text-white">@fullName</strong>! 
                        @if (isAuthenticated)
                        {
                            <span>
                                Đang hoạt động với quyền 
                                <span class="badge @(isAdmin ? "bg-danger" : isHR ? "bg-primary" : "bg-warning text-dark") px-3 py-1 rounded-pill">
                                    <i class="bi @(isAdmin ? "bi-shield-shaded" : "bi-person-badge") me-1"></i>@role
                                </span>. Các khối chức năng đã được phân cấp theo thứ tự ưu tiên bên dưới:
                            </span>
                        }
                        else
                        {
                            <span>Hệ thống quản trị khách sạn The OverTime Hotel. Hãy đăng nhập để truy cập đầy đủ các phân hệ.</span>
                        }
                    </p>

                    @if (!isAuthenticated)
                    {
                        <div class="mt-3">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-warning fw-bold px-4 py-2 text-dark shadow-sm rounded-pill hover-lift">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập hệ thống
                            </a>
                        </div>
                    }
                </div>

                <div class="col-lg-4 d-none d-lg-block text-end">
                    <div class="p-4 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-20 text-start shadow-sm" style="backdrop-filter: blur(12px);">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="small text-white-50 fw-bold text-uppercase" style="letter-spacing: 0.5px;">Hạ Tầng Điện Toán</span>
                            <span class="badge bg-success text-white px-2 py-1 rounded-pill">TLS 1.3 Active</span>
                        </div>
                        <div class="fw-bold text-white fs-6 mb-2">
                            <i class="bi bi-database-fill-check me-2 text-warning"></i> Supabase PostgreSQL 17
                        </div>
                        <div class="small text-white-50 mb-1">
                            <i class="bi bi-geo-alt-fill me-2 text-danger"></i> Khu vực: Singapore (ap-southeast-1)
                        </div>
                        <div class="small text-white-50 mb-3">
                            <i class="bi bi-shield-lock-fill me-2 text-info"></i> Mã hóa SSL &amp; EF Core 10
                        </div>
                        <div class="pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center">
                            <span class="small text-white-50">Ca hiện tại:</span>
                            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill" id="currentShiftBadge">
                                Đang tính toán...
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 THẺ CHỈ SỐ TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <a asp-controller="NhanVien" asp-action="Index" class="kpi-link-card" title="Xem hồ sơ nhân sự">
                <div class="kpi-card shadow-sm h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Tổng Nhân Lực</div>
                            <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">
                                <span class="counter-val" data-target="@Model.TongNhanVien">@Model.TongNhanVien</span>
                                <span class="fs-6 fw-normal text-muted">Nhân sự</span>
                            </h2>
                        </div>
                        <div class="kpi-icon-wrapper bg-primary-subtle text-primary">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                    <div>
                        <div class="progress mb-2" style="height: 6px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: 100%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>@Model.TongPhongBan Phòng ban</span>
                            <span class="text-primary fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>Xem hồ sơ</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-xl-3">
            <a asp-controller="HopDong" asp-action="Index" class="kpi-link-card" title="Xem hợp đồng lao động">
                <div class="kpi-card shadow-sm h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Hợp Đồng Lao Động</div>
                            <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">
                                <span class="counter-val" data-target="@Model.TongHopDong">@Model.TongHopDong</span>
                                <span class="fs-6 fw-normal text-muted">Hợp đồng</span>
                            </h2>
                        </div>
                        <div class="kpi-icon-wrapper bg-success-subtle text-success">
                            <i class="bi bi-file-earmark-check-fill"></i>
                        </div>
                    </div>
                    <div>
                        <div class="progress mb-2" style="height: 6px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: 100%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>@Model.HopDongHieuLuc Hiệu lực</span>
                            <span class="text-success fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>Xem thời hạn</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-xl-3">
            <a asp-controller="PhongBan" asp-action="Index" class="kpi-link-card" title="Xem phòng ban và chức vụ">
                <div class="kpi-card shadow-sm h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Cơ Cấu Tổ Chức</div>
                            <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">
                                <span class="counter-val" data-target="@(Model.TongPhongBan + Model.TongChucVu)">@(Model.TongPhongBan + Model.TongChucVu)</span>
                                <span class="fs-6 fw-normal text-muted">Vị trí &amp; PB</span>
                            </h2>
                        </div>
                        <div class="kpi-icon-wrapper bg-warning-subtle text-warning-emphasis">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                    <div>
                        <div class="progress mb-2" style="height: 6px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: 100%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>@Model.TongPhongBan PB · @Model.TongChucVu CV</span>
                            <span class="text-warning-emphasis fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>Xem cơ cấu</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-sm-6 col-xl-3">
            <a asp-controller="PhanCa" asp-action="Index" class="kpi-link-card" title="Xem lịch phân ca 24/7">
                <div class="kpi-card shadow-sm h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div>
                            <div class="text-muted small fw-semibold text-uppercase">Ca Trực Vận Hành 24/7</div>
                            <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">
                                <span class="counter-val" data-target="@Model.TongCaLamViec">@Model.TongCaLamViec</span>
                                <span class="fs-6 fw-normal text-muted">Khung ca</span>
                            </h2>
                        </div>
                        <div class="kpi-icon-wrapper bg-info-subtle text-info">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                    <div>
                        <div class="progress mb-2" style="height: 6px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: 100%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Sáng · Chiều · Đêm</span>
                            <span class="text-info fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>Ma trận tuần</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- 3 BẬC CHỨC NĂNG CẤU TRÚC PHÂN CẤP RÕ RÀNG -->
    <div class="row g-4">
        <!-- CỘT TRÁI (8/12): CÁC BẬC QUẢN TRỊ CHÍNH -->
        <div class="col-lg-8">

            <!-- ======================================================== -->
            <!-- BẬC 1: QUẢN TRỊ BẢO MẬT & HẠ TẦNG HỆ THỐNG (CHỈ ADMIN CÓ) -->
            <!-- ======================================================== -->
            @if (isAdmin)
            {
                <div class="tier-section-card tier-section-card--admin">
                    <div class="tier-header" data-bs-toggle="collapse" data-bs-target="#tierSecurity" aria-expanded="true" aria-controls="tierSecurity">
                        <div class="d-flex align-items-center gap-3">
                            <div class="feature-tile-icon bg-danger text-white shadow-sm">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="fw-bold text-dark mb-0 font-serif">Bậc 1: Quản Trị Bảo Mật &amp; Hạ Tầng Hệ Thống</h5>
                                    <span class="badge bg-danger text-white rounded-pill small">Admin Only</span>
                                </div>
                                <small class="text-muted">Cấp quyền bảo mật cao nhất: Cấp phát tài khoản người dùng, phân quyền RBAC và sao lưu an toàn CSDL Supabase</small>
                            </div>
                        </div>
                        <div class="tier-toggle-pill">
                            <span>Thu gọn / Mở rộng</span>
                            <i class="bi bi-chevron-down chevron-icon"></i>
                        </div>
                    </div>

                    <div class="collapse show" id="tierSecurity">
                        <div class="tier-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="feature-tile">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="feature-tile-icon bg-primary-subtle text-primary">
                                                    <i class="bi bi-person-gear"></i>
                                                </div>
                                                <span class="badge bg-primary text-white rounded-pill">@Model.TongTaiKhoan Tài Khoản</span>
                                            </div>
                                            <h6 class="fw-bold mb-1 font-serif text-dark">Quản Trị Người Dùng &amp; Phân Quyền</h6>
                                            <p class="text-muted small mb-3">
                                                Tạo tài khoản mới, phân 4 vai trò RBAC, tạm khóa/mở khóa tài khoản và theo dõi nhật ký thao tác quản trị.
                                            </p>
                                        </div>
                                        <a asp-controller="UserAccounts" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill fw-bold w-100">
                                            <i class="bi bi-shield-check me-1"></i> Mở quản trị tài khoản
                                        </a>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="feature-tile">
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                <div class="feature-tile-icon bg-warning-subtle text-warning-emphasis">
                                                    <i class="bi bi-database-check"></i>
                                                </div>
                                                <span class="badge bg-success-subtle text-success rounded-pill">17 Bảng Dữ Liệu</span>
                                            </div>
                                            <h6 class="fw-bold mb-1 font-serif text-dark">Sao Lưu &amp; Phục Hồi CSDL</h6>
                                            <p class="text-muted small mb-3">
                                                Xuất file snapshot JSON an toàn cho 17 bảng dữ liệu Supabase PostgreSQL và khôi phục hệ thống khi cần thiết.
                                            </p>
                                        </div>
                                        <a asp-controller="Backup" asp-action="Index" class="btn btn-outline-warning btn-sm text-dark rounded-pill fw-bold w-100">
                                            <i class="bi bi-download me-1"></i> Mở trung tâm sao lưu
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (isHR)
            {
                <div class="p-3 bg-light border rounded-4 text-muted mb-4 d-flex align-items-center gap-3">
                    <i class="bi bi-shield-shaded fs-3 text-secondary"></i>
                    <div>
                        <strong class="d-block text-dark small">Phân cấp quyền hạn (HR):</strong>
                        <span class="small">Bậc 1 (Quản trị tài khoản &amp; Sao lưu CSDL) thuộc thẩm quyền Quản trị viên (Admin). Bạn đang quản lý Bậc 2 (Cơ cấu tổ chức &amp; Nhân sự) và Bậc 3 (Vận hành ca trực).</span>
                    </div>
                </div>
            }

            <!-- ======================================================== -->
            <!-- BẬC 2: QUẢN TRỊ CƠ CẤU TỔ CHỨC & HỒ SƠ NHÂN LỰC          -->
            <!-- (Gồm: Nhân viên + Hợp đồng + Phòng ban + Chức vụ)        -->
            <!-- ======================================================== -->
            <div class="tier-section-card">
                <div class="tier-header collapsed" data-bs-toggle="collapse" data-bs-target="#tierOrgHR" aria-expanded="false" aria-controls="tierOrgHR">
                    <div class="d-flex align-items-center gap-3">
                        <div class="feature-tile-icon bg-primary text-white shadow-sm">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h5 class="fw-bold text-dark mb-0 font-serif">Bậc 2: Quản Trị Cơ Cấu Tổ Chức &amp; Nhân Lực</h5>
                                <span class="badge bg-primary text-white rounded-pill small">Hợp nhất 4 Module</span>
                            </div>
                            <small class="text-muted">Quản lý đồng bộ từ cơ cấu tổ chức (Phòng ban, Chức vụ) đến con người (Hồ sơ nhân sự, Hợp đồng lao động)</small>
                        </div>
                    </div>
                    <div class="tier-toggle-pill">
                        <span>Thu gọn / Mở rộng</span>
                        <i class="bi bi-chevron-down chevron-icon"></i>
                    </div>
                </div>

                <div class="collapse" id="tierOrgHR">
                    <div class="tier-body">
                        <div class="row g-3">
                            <!-- NHÓM 1: HỒ SƠ NHÂN VIÊN & HỢP ĐỒNG LAO ĐỘNG -->
                            <div class="col-md-6">
                                <div class="feature-tile border-primary" style="background: linear-gradient(135deg, #F0FDF4 0%, #EFF6FF 100%);">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <span class="badge bg-primary text-white rounded-pill px-3 py-1">20 Nhân Sự Đang Làm</span>
                                            <i class="bi bi-person-lines-fill text-primary fs-4"></i>
                                        </div>
                                        <h6 class="fw-bold mb-1 font-serif text-dark">Hồ Sơ Nhân Viên</h6>
                                        <p class="text-muted small mb-3">
                                            Tiếp nhận nhân sự, quản lý thông tin liên hệ, trình độ và quá trình công tác của 20 nhân viên thuộc 8 phòng ban.
                                        </p>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="NhanVien" asp-action="Index" class="btn btn-primary btn-sm flex-fill rounded-pill fw-bold">
