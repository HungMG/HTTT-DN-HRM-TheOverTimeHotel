@{
    ViewData["Title"] = "Bàn Làm Việc Quản Trị · The OverTime Hotel";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Quý khách";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
}

<div class="container-fluid py-3">
    <!-- HERO EXECUTIVE BANNER -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 text-white hero-luxury-banner">
        <div class="card-body p-4 p-lg-5 position-relative">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-stars me-1"></i> THE OVERTIME HOTEL &amp; RESORT 5★
                        </span>
                        <span class="live-clock-pill text-white d-inline-flex align-items-center gap-2">
                            <span class="shift-indicator-dot shift-dot-active"></span>
                            <span id="liveClockText">Đang tải đồng hồ...</span>
                        </span>
                    </div>

                    <h1 class="display-6 fw-bold mb-2 font-serif">
                        Xin chào, <span style="color: var(--hotel-gold-light);">@fullName</span>!
                    </h1>

                    <p class="text-white-50 fs-6 mb-4" style="max-width: 620px; line-height: 1.6;">
                        Chào mừng bạn đến với Cổng điều hành Quản lý Nhân sự &amp; Tiền lương tự động 24/7.
                        @if (isAuthenticated)
                        {
                            <span>
                                Bạn đang đăng nhập với vai trò 
                                <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") px-3 py-1 rounded-pill">
                                    <i class="bi @(role == "Admin" ? "bi-shield-shaded" : "bi-person-badge") me-1"></i>@role
                                </span>.
                            </span>
                        }
                        else
                        {
                            <span>Hiện tại bạn đang ở chế độ xem Khách (Guest). Hãy đăng nhập để truy cập đầy đủ các phân hệ quản trị.</span>
                        }
                    </p>

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        @if (role == "Admin")
                        {
                            <a asp-controller="UserAccounts" asp-action="Index" class="btn btn-light fw-bold px-4 py-2 text-dark shadow-sm rounded-pill hover-lift">
                                <i class="bi bi-person-gear me-2 text-primary"></i>Quản trị tài khoản
                            </a>
                            <a asp-controller="Backup" asp-action="Index" class="btn btn-warning fw-semibold px-4 py-2 text-dark shadow-sm rounded-pill hover-lift">
                                <i class="bi bi-shield-check me-2"></i>Sao lưu &amp; Phục hồi
                            </a>
                        }
                        else if (!isAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-warning fw-bold px-4 py-2 text-dark shadow-sm rounded-pill hover-lift">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập quản trị
                            </a>
                        }
                        <a href="https://supabase.com/dashboard/project/soethtbttktnwtxyxjrj" target="_blank" rel="noopener noreferrer" 
                           class="btn btn-outline-light px-4 py-2 rounded-pill hover-lift">
                            <i class="bi bi-cloud-arrow-up-fill me-2 text-info"></i>Supabase Cloud
                        </a>
                    </div>
                </div>

                <div class="col-lg-4 d-none d-lg-block text-end">
                    <div class="p-3 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-20 text-start shadow-sm" style="backdrop-filter: blur(10px);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="small text-white-50 fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Hạ Tầng Cloud</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Online 24/7</span>
                        </div>
                        <div class="fw-bold text-white fs-6 mb-2">
                            <i class="bi bi-database-fill-check me-1 text-warning"></i> Supabase PostgreSQL 17
                        </div>
                        <div class="small text-white-50 mb-1">
                            <i class="bi bi-geo-alt-fill me-1 text-danger"></i> Khu vực: Singapore (ap-southeast-1)
                        </div>
                        <div class="small text-white-50 mb-2">
                            <i class="bi bi-lock-fill me-1 text-success"></i> Mã hóa SSL &amp; EF Core 10
                        </div>
                        <div class="pt-2 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center">
                            <span class="small text-white-50">Ca hiện tại:</span>
                            <span class="badge bg-primary text-white" id="currentShiftBadge">Đang tính toán...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 BENTO KPI CARDS -->
    <div class="row g-3 mb-4">
        <!-- KPI 1 -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm hover-lift h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Tổng Nhân Lực</div>
                        <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">20</h2>
                    </div>
                    <div class="kpi-icon-wrapper bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>8 Phòng ban</span>
                        <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>100% Hoạt động</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 2 -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm hover-lift h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Vận Hành Ca 24/7</div>
                        <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">3 <span class="fs-6 fw-normal text-muted">Khung ca</span></h2>
                    </div>
                    <div class="kpi-icon-wrapper bg-success-subtle text-success">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
                <div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Sáng · Chiều · Đêm</span>
                        <span class="text-primary fw-semibold"><i class="bi bi-moon-stars-fill me-1"></i>+30% Ca đêm</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 3 -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm hover-lift h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Hợp Đồng Lao Động</div>
                        <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">20</h2>
                    </div>
                    <div class="kpi-icon-wrapper bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-file-earmark-check-fill"></i>
                    </div>
                </div>
                <div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>BHXH, BHYT, BHTN 10.5%</span>
                        <span class="text-success fw-semibold"><i class="bi bi-shield-fill-check me-1"></i>Đã ký kết</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- KPI 4 -->
        <div class="col-sm-6 col-xl-3">
            <div class="kpi-card shadow-sm hover-lift h-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start justify-content-between mb-3">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Tính Lương 2 Tầng</div>
                        <h2 class="fw-bold mb-0 text-dark mt-1 font-serif">T09<span class="fs-6 fw-normal text-muted">/2026</span></h2>
                    </div>
                    <div class="kpi-icon-wrapper bg-info-subtle text-info-emphasis">
                        <i class="bi bi-calculator-fill"></i>
                    </div>
                </div>
                <div>
                    <div class="progress mb-2" style="height: 6px;">
                        <div class="progress-bar bg-info" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Gross &rarr; Net</span>
                        <span class="text-info-emphasis fw-semibold"><i class="bi bi-file-earmark-pdf-fill me-1"></i>QuestPDF</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN TWO-COLUMN DASHBOARD BODY -->
    <div class="row g-4">
        <!-- CỘT TRÁI: LỘ TRÌNH ĐỒ ÁN & CÁC MODULE CHỨC NĂNG (8/12) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                <div class="card-header bg-white py-3 px-4 border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-primary fw-bold small text-uppercase" style="letter-spacing: 0.5px;">Tiến độ phát triển</div>
                        <h5 class="fw-bold text-dark mb-0 font-serif">Phân Hệ Quản Trị Hệ Thống (Lộ Trình Đồ Án)</h5>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-check2-all me-1"></i> 13 / 30 Nhiệm vụ
                    </span>
                </div>
                <div class="card-body px-4 pt-1 pb-4">
                    <div class="row g-3">
                        <!-- TSK-10 -->
                        <div class="col-md-6">
                            <div class="module-card">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">TSK-10 · Hoàn thành</span>
                                        <i class="bi bi-shield-check text-primary fs-4"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1">Sao Lưu &amp; Phục Hồi CSDL</h6>
                                    <p class="text-muted small mb-3">Xuất snapshot JSON và khôi phục 17 bảng dữ liệu Supabase an toàn.</p>
                                </div>
                                <a asp-controller="Backup" asp-action="Index" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-semibold">
                                    <i class="bi bi-arrow-right-circle me-1"></i> Truy cập chức năng
                                </a>
                            </div>
                        </div>

                        <!-- TSK-12 -->
                        <div class="col-md-6">
                            <div class="module-card">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">TSK-12 · Hoàn thành</span>
                                        <i class="bi bi-key-fill text-warning fs-4"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1">Xác Thực &amp; Phân Quyền RBAC</h6>
                                    <p class="text-muted small mb-3">Trang đăng nhập sang trọng, băm SHA-256, phân định 4 vai trò rõ ràng.</p>
                                </div>
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm w-100 rounded-pill fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Xem trang Đăng nhập
                                </a>
                            </div>
                        </div>

                        <!-- TSK-13 (TÂM ĐIỂM) -->
                        <div class="col-md-6">
                            <div class="module-card border-primary" style="background: linear-gradient(180deg, #f8fafc 0%, #eff6ff 100%);">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-success text-white rounded-pill">TSK-13 · Hoàn thành</span>
                                        <i class="bi bi-person-gear text-primary fs-4"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-primary">Quản Trị Tài Khoản &amp; Phân Quyền</h6>
                                    <p class="text-muted small mb-3">Thêm mới, sửa thông tin, khóa tài khoản và cấp vai trò RBAC cho nhân sự.</p>
                                </div>
                                @if (role == "Admin")
                                {
                                    <a asp-controller="UserAccounts" asp-action="Index" class="btn btn-primary btn-sm w-100 rounded-pill fw-bold shadow-sm">
                                        <i class="bi bi-shield-fill-check me-1"></i> Vào Quản trị tài khoản
                                    </a>
                                }
                                else if (!isAuthenticated)
                                {
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/UserAccounts" class="btn btn-warning btn-sm w-100 text-dark fw-bold rounded-pill shadow-sm">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập Admin để mở
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-light btn-sm w-100 text-muted rounded-pill" disabled>
                                        <i class="bi bi-lock-fill me-1"></i> Chỉ dành cho Admin
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- TSK-14 -->
                        <div class="col-md-6">
                            <div class="module-card">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill">TSK-14 · Tuần 6</span>
                                        <i class="bi bi-sliders text-success fs-4"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1">Quản Trị Danh Mục Hệ Thống</h6>
                                    <p class="text-muted small mb-3">Quản lý 8 phòng ban, 10 chức vụ, 3 khung ca 24/7 và 7 khoản lương.</p>
                                </div>
                                <button class="btn btn-light btn-sm w-100 text-muted rounded-pill" disabled>
                                    <i class="bi bi-hourglass-split me-1"></i> Sẵn sàng triển khai
                                </button>
                            </div>
                        </div>

                        <!-- TSK-15 -->
                        <div class="col-md-6">
                            <div class="module-card">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill">TSK-15 · Tuần 6</span>
                                        <i class="bi bi-person-lines-fill text-info fs-4"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1">Quản Lý Nhân Viên &amp; HĐLĐ</h6>
                                    <p class="text-muted small mb-3">Hồ sơ 20 nhân viên, tìm kiếm, lọc theo phòng ban; lập và theo dõi HĐLĐ.</p>
                                </div>
                                <button class="btn btn-light btn-sm w-100 text-muted rounded-pill" disabled>
                                    <i class="bi bi-hourglass-split me-1"></i> Sẵn sàng triển khai
                                </button>
                            </div>
                        </div>

                        <!-- TSK-16 -->
                        <div class="col-md-6">
                            <div class="module-card">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="badge bg-secondary-subtle text-secondary border rounded-pill">TSK-16 · Tuần 7</span>
                                        <i class="bi bi-calendar2-range-fill text-danger fs-4"></i>
                                    </div>
                                    <h6 class="fw-bold mb-1">Phân Ca &amp; Chấm Công 24/7</h6>
                                    <p class="text-muted small mb-3">Lập lịch ca sáng/chiều/đêm, quẹt thẻ Check-in / Out tự động trên App.</p>
                                </div>
                                <button class="btn btn-light btn-sm w-100 text-muted rounded-pill" disabled>
                                    <i class="bi bi-hourglass-split me-1"></i> Sẵn sàng triển khai
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: BẢNG GIÁM SÁT CA 24/7 & THÔNG TIN HẠ TẦNG (4/12) -->
        <div class="col-lg-4">
            <!-- GIÁM SÁT 3 CA KHÁCH SẠN 24/7 -->
            <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                <div class="card-header bg-white py-3 px-4 border-0 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark font-serif">
                        <i class="bi bi-clock me-2 text-primary"></i>Lịch 3 Ca Làm Việc 24/7
                    </h6>
                    <span class="badge bg-primary-subtle text-primary rounded-pill small">Hôm nay</span>
                </div>
                <div class="card-body px-4 pt-0 pb-4">
                    <div class="shift-timeline-item" id="shiftMorning">
                        <div class="shift-timeline-dot"></div>
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold small text-dark">Ca Sáng (06:00 – 14:00)</div>
                                <div class="text-muted small">Phục vụ ăn sáng, buồng phòng sáng</div>
                            </div>
                            <span class="badge bg-light text-secondary border small" id="badgeMorning">Ca 1</span>
                        </div>
                    </div>

                    <div class="shift-timeline-item" id="shiftAfternoon">
                        <div class="shift-timeline-dot"></div>
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold small text-dark">Ca Chiều (14:00 – 22:00)</div>
                                <div class="text-muted small">Cao điểm Check-in/out, nhà hàng, tiệc</div>
                            </div>
                            <span class="badge bg-light text-secondary border small" id="badgeAfternoon">Ca 2</span>
                        </div>
                    </div>

                    <div class="shift-timeline-item" id="shiftNight">
                        <div class="shift-timeline-dot"></div>
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-bold small text-dark">Ca Đêm (22:00 – 06:00)</div>
                                <div class="text-muted small">Lễ tân đêm, an ninh tuần tra, kỹ thuật</div>
                            </div>
                            <span class="badge bg-light text-secondary border small" id="badgeNight">Ca 3 (+30%)</span>
                        </div>
                    </div>

                    <div class="mt-3 p-3 bg-light rounded-3 small">
                        <i class="bi bi-info-circle-fill text-primary me-1"></i>
                        Nhân viên ca đêm được hưởng <strong>thêm 30% lương</strong> tính theo giờ làm việc theo quy định Bộ luật Lao động.
                    </div>
                </div>
            </div>

            <!-- QUY TẮC PHÂN QUYỀN 4 VAI TRÒ -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white py-3 px-4 border-0">
                    <h6 class="fw-bold mb-0 text-dark font-serif">
                        <i class="bi bi-shield-lock me-2 text-warning"></i>Phân Định 4 Vai Trò RBAC
                    </h6>
                </div>
                <div class="card-body px-4 pt-0 pb-4">
                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 mb-2 bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-pill">Admin</span>
                            <span class="small fw-semibold">Quản trị viên</span>
                        </div>
                        <span class="small text-muted">Toàn quyền hệ thống</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 mb-2 bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-pill">HR</span>
                            <span class="small fw-semibold">Chuyên viên Nhân sự</span>
                        </div>
                        <span class="small text-muted">Hồ sơ, HĐLĐ, Tính lương</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 mb-2 bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark rounded-pill">Manager</span>
                            <span class="small fw-semibold">Quản lý bộ phận</span>
                        </div>
                        <span class="small text-muted">Xếp ca, Duyệt đơn trên App</span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary rounded-pill">Employee</span>
                            <span class="small fw-semibold">Nhân viên</span>
                        </div>
                        <span class="small text-muted">Quẹt thẻ chấm công App</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Cập nhật đồng hồ thời gian thực và tự động xác định ca trực hiện tại
    function updateLiveStatus() {
        const now = new Date();
        
        // Định dạng ngày giờ chuẩn Việt Nam
        const timeStr = now.toLocaleTimeString('vi-VN', { hour12: false });
        const dateStr = now.toLocaleDateString('vi-VN', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
        
        const clockElem = document.getElementById('liveClockText');
        if (clockElem) {
            clockElem.textContent = `${dateStr} · ${timeStr}`;
        }

        const hour = now.getHours();
        let currentShiftName = "";
        
        // Reset classes
        const sMorn = document.getElementById('shiftMorning');
        const sAft = document.getElementById('shiftAfternoon');
        const sNight = document.getElementById('shiftNight');
        const bMorn = document.getElementById('badgeMorning');
        const bAft = document.getElementById('badgeAfternoon');
        const bNight = document.getElementById('badgeNight');
        const badgeElem = document.getElementById('currentShiftBadge');

        [sMorn, sAft, sNight].forEach(el => el?.classList.remove('active'));
        if (bMorn) bMorn.className = "badge bg-light text-secondary border small";
        if (bAft) bAft.className = "badge bg-light text-secondary border small";
        if (bNight) bNight.className = "badge bg-light text-secondary border small";

        // Xác định ca
        if (hour >= 6 && hour < 14) {
            currentShiftName = "Ca Sáng (06:00 – 14:00)";
            sMorn?.classList.add('active');
            if (bMorn) bMorn.className = "badge bg-success text-white small";
        } else if (hour >= 14 && hour < 22) {
            currentShiftName = "Ca Chiều (14:00 – 22:00)";
            sAft?.classList.add('active');
            if (bAft) bAft.className = "badge bg-success text-white small";
        } else {
            currentShiftName = "Ca Đêm (22:00 – 06:00)";
            sNight?.classList.add('active');
            if (bNight) bNight.className = "badge bg-success text-white small";
        }

        if (badgeElem) {
            badgeElem.textContent = currentShiftName;
        }
    }

    updateLiveStatus();
    setInterval(updateLiveStatus, 1000);
</script>
}
